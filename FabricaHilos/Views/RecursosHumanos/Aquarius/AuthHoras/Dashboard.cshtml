@{
    ViewData["Title"] = "Aquarius — Inicio";
}

@section Styles {
<style>
    :root {
        --aq:       #C0622B;
        --aq-dk:    #9E4D20;
        --aq-lt:    #FEF3EB;
        --aq-mid:   #F5D5BC;
        --aq-ok:    #4E7E58;
        --aq-ok-lt: #EAF4EC;
        --aq-info:  #7A6E9E;
        --aq-ilt:   #F2EDF7;
    }

    .aq-hero {
        background: linear-gradient(135deg, var(--aq) 0%, var(--aq-dk) 100%);
        color: #fff;
        border-radius: .75rem;
        padding: 2rem 2.5rem;
        margin-bottom: 2rem;
    }
    .aq-hero .aq-logo {
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: .08em;
    }
    .aq-hero .aq-sub {
        font-size: .95rem;
        opacity: .85;
    }

    .aq-card {
        border: none;
        border-radius: .75rem;
        box-shadow: 0 2px 12px rgba(0,0,0,.08);
        transition: transform .15s, box-shadow .15s;
        cursor: pointer;
        height: 100%;
    }
    .aq-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 6px 24px rgba(0,0,0,.13);
    }
    .aq-card .card-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        margin-bottom: 1rem;
    }
    .aq-card-auth   .card-icon { background: var(--aq-lt);    color: var(--aq);     }
    .aq-card-consulta .card-icon { background: var(--aq-ilt); color: var(--aq-info); }
    .aq-card-auth   { border-top: 4px solid var(--aq);      }
    .aq-card-consulta { border-top: 4px solid var(--aq-info); }
    .aq-card .card-title    { font-size: 1.15rem; font-weight: 700; }
    .aq-card .card-text     { color: #6c757d; font-size: .9rem; }
    .aq-card .btn-ir {
        margin-top: auto;
        font-weight: 600;
        border-radius: .4rem;
    }
    .aq-card-auth     .btn-ir { background: var(--aq);       color: #fff; border-color: var(--aq);       }
    .aq-card-consulta .btn-ir { background: var(--aq-info);  color: #fff; border-color: var(--aq-info);  }
    .aq-card-auth     .btn-ir:hover { background: var(--aq-dk); border-color: var(--aq-dk); }
    .aq-card-consulta .btn-ir:hover { background: #6259a8;       border-color: #6259a8;      }
</style>
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a href="/RecursosHumanos">Recursos Humanos</a></li>
    <li class="breadcrumb-item active">Aquarius</li>
}

<!-- Hero -->
<div class="aq-hero d-flex justify-content-between align-items-center">
    <div>
        <div class="aq-logo"><i class="bi bi-shield-lock-fill me-2"></i>AQUARIUS</div>
        <div class="aq-sub">Sistema de Recursos Humanos — Horas Extras</div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge fs-6 bg-white text-dark" id="lblNomUsuario">Cargando…</span>
        <form method="post" action="/RecursosHumanos/Aquarius/AuthHoras/Logout" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-light">
                <i class="bi bi-box-arrow-right me-1"></i>Cerrar sesión
            </button>
        </form>
    </div>
</div>

<!-- Tarjetas -->
<div class="row g-4 justify-content-center">

    <!-- Tarjeta 1: Autorización de Horas -->
    <div class="col-md-5">
        <div class="card aq-card aq-card-auth p-4 d-flex flex-column">
            <div class="card-icon">
                <i class="bi bi-pencil-square"></i>
            </div>
            <h5 class="card-title">Autorización de Horas</h5>
            <p class="card-text">
                Revisa el tareo diario de tus empleados a cargo y autoriza o revoca
                las horas extras antes de entrada (HEA), después de salida (HED)
                y las horas dobles (HEO).
            </p>
            <div class="mt-auto pt-3">
                <a href="/RecursosHumanos/Aquarius/AuthHoras/Autorizar" class="btn btn-ir w-100">
                    <i class="bi bi-arrow-right-circle me-2"></i>Ir a Autorizar Horas
                </a>
            </div>
        </div>
    </div>

    <!-- Tarjeta 2: Consulta de Resumen -->
    <div class="col-md-5">
        <div class="card aq-card aq-card-consulta p-4 d-flex flex-column">
            <div class="card-icon">
                <i class="bi bi-bar-chart-line"></i>
            </div>
            <h5 class="card-title">Consulta de Horas Autorizadas</h5>
            <p class="card-text">
                Visualiza el resumen de horas extras del período para cada empleado:
                días con HE, días pendientes de autorización, días completamente
                autorizados y totales por tipo (HEA / HED / HEO).
            </p>
            <div class="mt-auto pt-3">
                <a href="/RecursosHumanos/Aquarius/AuthHoras/ConsultaResumen" class="btn btn-ir w-100">
                    <i class="bi bi-arrow-right-circle me-2"></i>Ir a Consulta de Resumen
                </a>
            </div>
        </div>
    </div>

</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', async () => {
    const r = await fetch('/RecursosHumanos/Aquarius/AuthHoras/SesionInfo');
    if (!r.ok) { window.location = '/RecursosHumanos/Aquarius/AuthHoras'; return; }
    const s = await r.json();
    document.getElementById('lblNomUsuario').textContent = '👤 ' + (s.nomUsuario || s.codUsuario);
});
</script>
}
