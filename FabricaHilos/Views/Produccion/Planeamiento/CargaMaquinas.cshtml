                                <span class="tt-cod">@maq.CodMaq</span>
                                <span class="ms-auto badge bg-secondary" style="font-size:.62rem;">LIBRE</span>
                            </div>
                            <div class="tt-body">
                                <div class="tt-row">
                                    <span class="text-muted" style="font-size:.78rem;">@maq.NombreMaqDisplay</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="alert alert-light border text-muted small py-2">
            <i class="bi bi-info-circle me-1"></i>No se encontraron máquinas de soporte activas en el catálogo.
        </div>
    }
</div>@*/ tab-otras *@

@*═══════════════════════════════════════════════════════════════════ TAB: HILANDERÍA *@
<div class="tab-pane fade pln-tab-panel" id="tab-hil" role="tabpanel" aria-labelledby="tab-hil-btn">

    @if (hilMaquinas.Any())
    {
        var hilPorTipo = hilMaquinas
            .GroupBy(m => m.TpMaq)
            .OrderBy(g => g.Any(m => m.EsActiva) ? 0 : 1)
            .ThenBy(g => g.Key)
            .ToList();

        <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
            <span class="text-muted small">Actividad últimas 24h ·</span>
            @foreach (var tipo in hilPorTipo.Take(6))
            {
                <span class="badge bg-light text-dark border" style="font-size:.63rem;">
                    @tipo.First().DescripcionTipo (@tipo.Count())
                </span>
            }
        </div>

        foreach (var tipoGrp in hilPorTipo)
        {
            var primera  = tipoGrp.First();
            var tipoId   = "hil_" + tipoGrp.Key;
            int tipoAct  = tipoGrp.Count(m => m.EsActiva);
            <div class="mb-3">
                <button class="pln-area-hdr" type="button"
                        data-bs-toggle="collapse" data-bs-target="#@tipoId"
                        aria-expanded="false" aria-controls="@tipoId">
                    <i class="bi bi-cpu me-1" style="color:@primera.ColorTipo;"></i>
                    @primera.DescripcionTipo
                    <span class="area-badge ms-1">@tipoGrp.Count() máq.</span>
                    @if (tipoAct > 0)
                    { <span class="badge bg-success ms-1" style="font-size:.62rem;">@tipoAct activas</span> }
                    <span class="pln-area-chevron"><i class="bi bi-chevron-down"></i></span>
                </button>
                <div class="collapse" id="@tipoId"
                     style="border:1px solid #e2e8f0; border-top:none; border-radius:0 0 6px 6px; overflow:hidden;">
                    <div class="table-responsive">
                        <table class="table table-hover tbl-hil mb-0">
                            <thead>
                                <tr>
                                    <th>Máquina</th><th>Lote</th><th>Título</th><th>Proceso</th>
                                    <th>Estado</th><th class="text-end">Husos</th>
                                    <th class="text-end">Velocidad</th><th class="text-end">Kg</th><th>Última actividad</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in tipoGrp.OrderBy(x => x.CodMaq))
                                {
                                    <tr class="@(m.EsActiva ? "table-success bg-opacity-25" : "")">
                                        <td><span class="maq-name">@m.CodMaq</span></td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(m.Lote))
                                            { <span class="badge bg-light text-dark border" style="font-size:.7rem;">@m.Lote</span> }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(m.Titulo))
                                            { <span class="fw-semibold">@m.Titulo</span> }
                                            else { <span class="text-muted">—</span> }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(m.Proceso))
                                            { <span class="proceso-tag">@m.NombreProceso</span> }
                                            else { <span class="text-muted">—</span> }
                                        </td>
                                        <td>
                                            <span class="badge @m.BadgeClase" style="font-size:.65rem;">
                                                @(m.EsActiva ? "EN PROCESO" : "COMPLETADO")
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            @(m.HusosMax > 0 ? m.HusosMax.ToString() : "—")
                                        </td>
                                        <td class="text-end">
                                            @if (m.Velocidad > 0)
                                            { <text>@m.Velocidad.ToString("N0") <small class="text-muted">rpm</small></text> }
                                            else { <span class="text-muted">—</span> }
                                        </td>
                                        <td class="text-end">
                                            @(m.KgTotal > 0 ? m.KgTotal.ToString("N1") : "—")
                                        </td>
                                        <td>
                                            @if (m.UltimaFechaIni.HasValue)
                                            {
                                                var diff = (DateTime.Now - m.UltimaFechaIni.Value).TotalHours;
                                                <span class="@(m.EsActiva ? "text-success fw-semibold" : "text-muted")"
                                                      title="@m.UltimaFechaIni.Value.ToString("dd/MM/yyyy HH:mm")">
                                                    @if (diff < 1)      { <text><i class="bi bi-dot text-success"></i>Hace @((int)(diff*60)) min</text> }
                                                    else if (diff < 24) { <text>Hace @((int)diff)h</text> }
                                                    else                { <text>@m.UltimaFechaIni.Value.ToString("dd/MM HH:mm")</text> }
                                                </span>
                                            }
                                            else { <span class="text-muted">—</span> }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-light border text-muted small py-2">
            <i class="bi bi-info-circle me-1"></i>No hay actividad de hilandería en las últimas 24h (H_RPRODUC vacío para el período).
        </div>
    }
</div>@*/ tab-hil *@

@*═══════════════════════════════════════════════════════════════════ TAB: COMPROMISOS PLN *@
<div class="tab-pane fade pln-tab-panel" id="tab-pln" role="tabpanel" aria-labelledby="tab-pln-btn">

    @{
        string[] ordenAreas = { "Tintorería", "Secado", "Devanado", "Hilandería", "Otros" };
        var comprPorArea = compromisos
            .GroupBy(x => x.CodMaq)
            .Select(g =>
            {
                var best = g.Any(x => x.EstadoMaq == "EN_PROCESO")   ? 0 :
                           g.Any(x => x.EstadoMaq == "COMPROMETIDA") ? 1 : 2;
                return (Maq: g.Key, Area: g.First().Area, Best: best, Items: g.ToList(), Primero: g.First());
            })
            .GroupBy(x => string.IsNullOrWhiteSpace(x.Area) ? "Otros" : x.Area)
            .OrderBy(g => { var idx = Array.IndexOf(ordenAreas, g.Key); return idx < 0 ? 99 : idx; })
            .ToList();
        int totalMaqCom    = compromisos.Select(x => x.CodMaq).Distinct().Count();
        int totalEnProceso = compromisos.Count(x => x.EstadoMaq == "EN_PROCESO");
        int totalComprom   = compromisos.Count(x => x.EstadoMaq == "COMPROMETIDA");
    }

    @if (comprPorArea.Any())
    {
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
            <div class="d-flex align-items-center gap-1">
                <i class="bi bi-diagram-3 text-primary me-1"></i>
                <span class="fw-bold" style="font-size:.9rem;">Compromisos PLN_SEGUIMIENTO</span>
                <span class="badge bg-light text-dark border ms-1" style="font-size:.7rem;">@totalMaqCom máqs.</span>
            </div>
            <div class="d-flex gap-2 flex-wrap align-items-center">
                @if (totalEnProceso > 0)
                { <span class="badge bg-success" style="font-size:.7rem;"><i class="bi bi-play-circle-fill me-1"></i>@totalEnProceso en proceso</span> }
                @if (totalComprom > 0)
                { <span class="badge bg-warning text-dark" style="font-size:.7rem;"><i class="bi bi-clock-history me-1"></i>@totalComprom comprometidas</span> }
            </div>
        </div>

        <div class="cm-filter-bar mb-3">
            <div class="input-group input-group-sm" style="max-width:260px;">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input id="cmFiltro" type="text" class="form-control border-start-0 ps-0"
                       placeholder="Buscar máquina o pedido…" autocomplete="off" />
            </div>
            <button class="btn btn-outline-secondary btn-sm" onclick="cmExpandAll(true)">
                <i class="bi bi-arrows-expand me-1"></i>Expandir
            </button>
            <button class="btn btn-outline-secondary btn-sm" onclick="cmExpandAll(false)">
                <i class="bi bi-arrows-collapse me-1"></i>Colapsar
            </button>
        </div>

        @foreach (var areaGrp in comprPorArea)
        {
            var areaId  = "area_" + System.Text.RegularExpressions.Regex.Replace(areaGrp.Key, @"[^a-zA-Z0-9]", "_");
            var areaMaqs = areaGrp.OrderBy(x => x.Best).ThenBy(x => x.Maq).ToList();
            int areaEnProc = areaGrp.Sum(x => x.Items.Count(i => i.EstadoMaq == "EN_PROCESO"));
            int areaCom    = areaGrp.Sum(x => x.Items.Count(i => i.EstadoMaq == "COMPROMETIDA"));

            <div class="mb-3" data-area-section="@areaGrp.Key">
                <button class="pln-area-hdr" type="button"
                        data-bs-toggle="collapse" data-bs-target="#@areaId"
                        aria-expanded="true" aria-controls="@areaId">
                    <i class="bi bi-grid-1x2 me-1"></i>@areaGrp.Key
                    <span class="area-badge ms-1">@areaMaqs.Count máq.</span>
                    @if (areaEnProc > 0)
                    { <span class="badge bg-success ms-1" style="font-size:.62rem;">@areaEnProc en proceso</span> }
                    @if (areaCom > 0)
                    { <span class="badge bg-warning text-dark ms-1" style="font-size:.62rem;">@areaCom comprometidas</span> }
                    <span class="pln-area-chevron"><i class="bi bi-chevron-down"></i></span>
                </button>
                <div class="collapse show" id="@areaId"
                     style="border:1px solid #e2e8f0; border-top:none; border-radius:0 0 6px 6px; padding:.75rem; background:#f8fafc;">
                    <div class="row g-2" id="@(areaId)_cards">
                        @foreach (var maqData in areaMaqs)
                        {
                            var enProc = maqData.Items.Where(x => x.EstadoMaq == "EN_PROCESO").ToList();
                            var compr  = maqData.Items.Where(x => x.EstadoMaq == "COMPROMETIDA").ToList();
                            var asign  = maqData.Items.Where(x => x.EstadoMaq == "ASIGNADA").ToList();
                            var prim   = maqData.Primero;
                            var bColor = enProc.Any() ? "#198754" : compr.Any() ? "#fd7e14" : "#6c757d";
                            var colId  = "cm_" + maqData.Maq.Replace(" ","_");
                            var vis3   = maqData.Items.Take(3).ToList();
                            var resto  = maqData.Items.Skip(3).ToList();

                            <div class="col-12 col-md-6 col-xl-4 cm-maq-col"
                                 data-maq="@maqData.Maq.ToUpper()"
                                 data-pedidos="@string.Join(" ", maqData.Items.Select(x => x.NumPed.ToString()).Distinct())">
                                <div class="maq-comp-card h-100" style="border-left:3px solid @bColor;">
                                    <div class="maq-head">
                                        <i class="bi bi-gear-fill" style="color:@bColor; font-size:.85rem;"></i>
                                        <span class="maq-cod">@maqData.Maq</span>
                                        <span class="maq-nom">@prim.NombreMaqDisplay</span>
                                        <span class="maq-area-tag" style="background:@(bColor)20; color:@bColor; border:1px solid @bColor;">
                                            @maqData.Area
                                        </span>
                                    </div>
                                    <div class="maq-badges">
                                        @if (enProc.Any())
                                        { <span class="badge bg-success" style="font-size:.65rem;">@enProc.Count EN PROCESO</span> }
                                        @if (compr.Any())
                                        { <span class="badge bg-warning text-dark" style="font-size:.65rem;">@compr.Count COMPROMETIDA@(compr.Count!=1?"S":"")</span> }
                                        @if (asign.Any())
                                        { <span class="badge bg-secondary" style="font-size:.65rem;">@asign.Count ASIGNADA@(asign.Count!=1?"S":"")</span> }
                                    </div>
                                    <div class="px-2 pb-2 pt-1">
                                        <table class="table tbl-compromisos">
                                            <thead><tr><th>Pedido</th><th>Paso</th><th>Estado</th><th>Entrega</th></tr></thead>
                                            <tbody>
                                                @foreach (var c in vis3)
                                                {
                                                    <tr class="@(c.EstaRetrasado ? "table-danger" : "")">
                                                        <td>
                                                            @if (c.SinSeguimiento)
                                                            {
                                                                <span class="text-muted fst-italic small">Sin PLN</span>
                                                                <span class="badge bg-secondary ms-1" style="font-size:.55rem;">@c.Fuente</span>
                                                            }
                                                            else
                                                            {
                                                                <a asp-action="Pedido" asp-route-numPed="@c.NumPed" asp-route-serie="@c.Serie"
                                                                   class="text-decoration-none fw-semibold">@c.NumPed/@c.Nro</a>
                                                            }
                                                        </td>
                                                        <td><span class="badge" style="background:@c.ColorUi; font-size:.6rem;">@c.NombrePaso</span></td>
                                                        <td>
                                                            <span class="badge @c.BadgeEstado" style="font-size:.6rem;">@c.EstadoMaq</span>
                                                            @if (c.Nota != null)
                                                            {
                                                                <div class="text-muted" style="font-size:.58rem;line-height:1.2;margin-top:2px;">
                                                                    <i class="bi bi-info-circle me-1"></i>@c.Nota
                                                                </div>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (c.FchEntregaComp.HasValue)
                                                            {
                                                                <span class="@(c.EstaRetrasado ? "text-danger fw-bold" : "")">
                                                                    @c.FchEntregaComp.Value.ToString("dd/MM")
                                                                    @if (c.DiasRetraso > 0)
                                                                    { <small class="text-danger ms-1">+@c.DiasRetraso d</small> }
                                                                </span>
                                                            }
                                                            else { <span class="text-muted">—</span> }
                                                        </td>
                                                    </tr>
                                                }
                                                @if (resto.Any())
                                                {
                                                    <tr class="collapse" id="@colId">
                                                        <td colspan="4" class="p-0">
                                                            <table class="table tbl-compromisos mb-0">
                                                                <tbody>
                                                                    @foreach (var c in resto)
                                                                    {
                                                                        <tr class="@(c.EstaRetrasado ? "table-danger" : "")">
                                                                            <td>
                                                                                @if (c.SinSeguimiento)
                                                                                { <span class="text-muted fst-italic small">Sin PLN</span> }
                                                                                else
                                                                                { <a asp-action="Pedido" asp-route-numPed="@c.NumPed" asp-route-serie="@c.Serie" class="text-decoration-none fw-semibold">@c.NumPed/@c.Nro</a> }
                                                                            </td>
                                                                            <td><span class="badge" style="background:@c.ColorUi; font-size:.6rem;">@c.NombrePaso</span></td>
                                                                            <td>
                                                                                <span class="badge @c.BadgeEstado" style="font-size:.6rem;">@c.EstadoMaq</span>
                                                                                @if (c.Nota != null)
                                                                                {
                                                                                    <div class="text-muted" style="font-size:.58rem;line-height:1.2;margin-top:2px;">
                                                                                        <i class="bi bi-info-circle me-1"></i>@c.Nota
                                                                                    </div>
                                                                                }
                                                                            </td>
                                                                            <td>
                                                                                @if (c.FchEntregaComp.HasValue)
                                                                                { <span class="@(c.EstaRetrasado ? "text-danger fw-bold" : "")">@c.FchEntregaComp.Value.ToString("dd/MM")</span> }
                                                                                else { <span class="text-muted">—</span> }
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        @if (resto.Any())
                                        {
                                            <a class="cm-ver-mas" data-bs-toggle="collapse" href="#@colId">
                                                <i class="bi bi-chevron-down me-1"></i>Ver @resto.Count más…
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-light border text-muted small py-2">
            <i class="bi bi-info-circle me-1"></i>No hay compromisos de máquinas en PLN_SEGUIMIENTO.
            Los compromisos se registran automáticamente cuando los pedidos avanzan a Secado (PASO 08) y Devanado (PASO 10).
        </div>
    }
</div>@*/ tab-pln *@

</div>@*/ tab-content *@

</div>@*/ container-fluid *@

@section Scripts {
<script>
// ── Filtros Tab Tintorería ────────────────────────────────────────────────────
(function () {
    var grpFilter = '', estFilter = '', searchQ = '';
    function apply() {
        var cols = document.querySelectorAll('.tt-col');
        var vis = 0;
        cols.forEach(function (col) {
            var g = (col.dataset.grupo  || '').toUpperCase();
            var e = (col.dataset.estado || '').toUpperCase();
            var m = (col.dataset.maq    || '').toUpperCase();
            var ok = (!grpFilter || g === grpFilter.toUpperCase())
                  && (!estFilter || e === estFilter.toUpperCase())
                  && (!searchQ   || m.includes(searchQ.toUpperCase()));
            col.classList.toggle('tt-hidden', !ok);
            if (ok) vis++;
        });
        var c = document.getElementById('ttVisibleCount');
        if (c) c.textContent = vis;
    }
    document.querySelectorAll('input[name="ttGrp"]').forEach(function (r) {
        r.addEventListener('change', function () { grpFilter = this.value === 'all' ? '' : this.value; apply(); });
    });
    document.querySelectorAll('input[name="ttEst"]').forEach(function (r) {
        r.addEventListener('change', function () { estFilter = this.value === 'all' ? '' : this.value; apply(); });
    });
    var s = document.getElementById('ttSearch');
    if (s) s.addEventListener('input', function () { searchQ = this.value.trim(); apply(); });
})();

// ── Filtro Tab Compromisos PLN ───────────────────────────────────────────────
(function () {
    var input = document.getElementById('cmFiltro');
    if (!input) return;
    input.addEventListener('input', function () {
        var q = this.value.trim().toUpperCase();
        document.querySelectorAll('.cm-maq-col').forEach(function (col) {
            var ok = !q || (col.dataset.maq || '').toUpperCase().includes(q)
                       || (col.dataset.pedidos || '').toUpperCase().includes(q);
            col.classList.toggle('cm-hidden', !ok);
        });
    });
})();

// ── Expandir/colapsar Compromisos PLN ────────────────────────────────────────
function cmExpandAll(open) {
    document.querySelectorAll('[data-area-section]').forEach(function (sec) {
        var btn = sec.querySelector('.pln-area-hdr');
        var id  = btn && btn.getAttribute('data-bs-target');
        var el  = id && document.querySelector(id);
        if (!el) return;
        var col = bootstrap.Collapse.getOrCreateInstance(el, { toggle: false });
        if (open) col.show(); else col.hide();
    });
}
</script>
}
