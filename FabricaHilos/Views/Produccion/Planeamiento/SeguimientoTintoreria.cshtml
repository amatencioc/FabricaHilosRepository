// Sobrescribir norm para mes (necesitamos usar mesActivo directamente en applyFilters)
// Para el filtro de mes usamos la variable mesActivo en lugar de data-cf
var _origApply = applyFilters;
applyFilters = function(){
    // inyectar filtro mes desde botón activo
    var mesFiltro = mesActivo;
    var cfMesEl = document.querySelector('[data-cf="mes"]');
    // si existe el select de mes (lo hay en el nuevo HTML), lo seteamos
    // si no, lo manejamos directo en el filter override
    if(!cfMesEl){
        // no hay select de mes, filtrar inline
        var orig = filtered;
        _origApply();
        if(mesFiltro){
            filtered = filtered.filter(function(r){ return norm(r.mes)===norm(mesFiltro); });
            if(cntEl) cntEl.textContent=filtered.length;
            renderPage(); updateKpis();
        }
        return;
    }
    // si hay select
    if(mesFiltro) cfMesEl.value=mesFiltro; else cfMesEl.value='';
    _origApply();
};
// Para botones de mes que ya están en HTML (sin select oculto) redefinimos applyFilters correctamente:
applyFilters = function(){
    // Al re-filtrar, los índices de filtered cambian → limpiar selección para evitar
    // que selected apunte a ítems incorrectos tras el rebuild de filtered.
    selected = {}; updateColorBar();
    var vals={}, inds={};
    cfInputs.forEach(function(el){ var v=el.value; if(v!=='') vals[el.dataset.cf]=norm(v); });
    cfInds.forEach(function(el){   var v=el.value; if(v!=='') inds[el.dataset.cfInd]=v; });
    var fDes = cfFchEntDes ? cfFchEntDes.value : '';
    var fHas = cfFchEntHas ? cfFchEntHas.value : '';

    filtered = allData.filter(function(r){
        // MES via botón
        if(mesActivo){
            if(mesActivo==='_sf'){
                // SF = ítems donde el SP devuelve MES='SF' (sin FCH_ENTREGA)
                if(r.mes !== 'SF') return false;
            } else {
                if(norm(r.mes)!==norm(mesActivo)) return false;
            }
        }
        // Est.Flujo multi-select (OR entre los seleccionados)
        if(flujoSelected.length>0){
            var ef=norm(r.estFlujo||'');
            if(!flujoSelected.some(function(v){ return norm(v)===ef; })) return false;
        }
        // Ev.Encon multi-select (OR entre los seleccionados)
        if(evEnconSelected.length>0){
            var ee=norm(r.evEncon||'');
            if(!evEnconSelected.some(function(v){ return norm(v)===ee; })) return false;
        }
        // filtros texto/select
        for(var key in vals){
            var fn=CF_MAP[key]; if(!fn) continue;
            var cell=fn(r);
            if(key==='colorhexa'){
                var vv=vals[key];
                if(vv==='_none'){ if(r.colorHexa) return false; }
                else { if(cell!==vv) return false; }
                continue;
            }
            if(EXACT_CF[key]){ if(cell!==vals[key]) return false; }
            else { if(!cell.includes(vals[key])) return false; }
        }
        for(var k2 in inds){ var fn2=IND_MAP[k2]; if(!fn2) continue; if(fn2(r)!==inds[k2]) return false; }
        if(fDes||fHas){
            var fe=r.fchEntrega; if(!fe) return false;
            var pp=fe.split('/'); var dd2=parseInt(pp[0]),mm2=parseInt(pp[1])-1,yy2=parseInt(pp[2]);
            var yr2=yy2<50?2000+yy2:1900+yy2;
            var feD2=new Date(yr2,mm2,dd2);
            if(fDes){ var fd2=new Date(fDes); fd2.setHours(0,0,0,0); if(feD2<fd2) return false; }
            if(fHas){ var fh2=new Date(fHas); fh2.setHours(23,59,59,999); if(feD2>fh2) return false; }
        }
        return true;
    });
    if(cntEl) cntEl.textContent=filtered.length;
    curPage=1; renderPage(); updateKpis();
};

