@model FabricaHilos.Models.Produccion.Planeamiento.PlnPedidoViewModel
@using FabricaHilos.Models.Produccion.Planeamiento

@{
    ViewData["Title"] = $"Gantt — Pedido {Model.Serie}-{Model.NumPed}";

    var primerItem = Model.Items.FirstOrDefault();

    // Rango de fechas del eje X
    var todasFechas = Model.Items
        .SelectMany(s => new DateTime?[]
        {
            s.FchPedido,
            s.FchEntregaComp,
            s.FchEstHilanderia, s.FchEstPartida, s.FchEstTinIni,
            s.FchEstTinFin, s.FchEstSecado, s.FchEstCalidad, s.FchEstDespacho,
            s.FchRealProgramado, s.FchRealProduccion, s.FchRealPartida,
            s.FchRealTinIni, s.FchRealTinFin, s.FchRealSecado,
            s.FchRealCcTinto, s.FchRealDevanado, s.FchRealCalidad,
            s.FchRealAlmPt, s.FchRealDespacho
        })
        .Where(d => d.HasValue)
        .Select(d => d!.Value)
        .ToList();

    var hoy       = DateTime.Today;
    var fechaMin  = todasFechas.Any() ? todasFechas.Min().AddDays(-2) : hoy.AddDays(-3);
    var fechaMax  = todasFechas.Any() ? todasFechas.Max().AddDays(3)  : hoy.AddDays(10);
    var totalDias = (fechaMax - fechaMin).TotalDays;

    // Helpers de posición
    Func<DateTime?, double> pctLeft  = d =>
        d.HasValue ? Math.Max(0, (d.Value - fechaMin).TotalDays / totalDias * 100) : 0;

    Func<DateTime?, DateTime?, double> pctWidth = (ini, fin) =>
    {
        if (!ini.HasValue || !fin.HasValue) return 0;
        return Math.Max(0.8, (fin.Value - ini.Value).TotalDays / totalDias * 100);
    };

    // Cada etapa es una tupla: (CodPaso, Nombre, Color, EstIni, EstFin, RealIni, RealFin)
    Func<PlnSeguimiento, List<(string Cod, string Nom, string Color,
         DateTime? EI, DateTime? EF, DateTime? RI, DateTime? RF)>> etapasDe = s =>
        new List<(string, string, string, DateTime?, DateTime?, DateTime?, DateTime?)>
        {
            ("01", "Pedido",     "#6c757d", s.FchPedido,         s.FchRealProgramado ?? s.FchEstHilanderia,
                                            s.FchPedido,         s.FchRealProgramado),
            ("02", "Programado", "#0d6efd", s.FchRealProgramado, s.FchEstHilanderia,
                                            s.FchRealProgramado, s.FchRealProduccion),
            ("03", "Hilandería", "#6f42c1", s.FchEstHilanderia,  s.FchEstPartida,
                                            s.FchRealProduccion, s.FchRealPartida),
            ("04", "Partida",    "#20c997", s.FchEstPartida,     s.FchEstTinIni,
                                            s.FchRealPartida,    s.FchRealTinIni),
            ("06", "Tintorería", "#fd7e14", s.FchEstTinIni,      s.FchEstTinFin,
                                            s.FchRealTinIni,     s.FchRealTinFin),
            ("08", "Secado",     "#17a2b8", s.FchEstTinFin,      s.FchEstSecado,
                                            s.FchRealTinFin,     s.FchRealSecado),
            ("09", "C.Calidad",  "#198754", s.FchEstSecado,      s.FchEstCalidad,
                                            s.FchRealSecado,     s.FchRealCcTinto ?? s.FchRealCalidad),
            ("10", "Devanado",   "#0dcaf0", s.FchEstCalidad,     s.FchEstDespacho,
                                            s.FchRealDevanado,   s.FchRealAlmPt),
            ("14", "Despacho",   "#dc3545", s.FchEstDespacho,    s.FchEntregaComp,
                                            s.FchRealAlmPt,      s.FchRealDespacho),
        };
}

@section Styles {
<style>
    .gantt-wrap      { overflow-x: auto; }
    .gantt-grid      { display: grid; grid-template-columns: 220px 1fr; min-width: 860px; }

    .gantt-hdr-label { background: #f8f9fa; border-right: 1px solid #dee2e6;
                       padding: .4rem .75rem; font-weight: 600; font-size: .8rem;
                       border-bottom: 2px solid #dee2e6; position: sticky; left: 0; z-index: 2; }
    .gantt-hdr-axis  { position: relative; border-bottom: 2px solid #dee2e6;
                       background: #f8f9fa; height: 36px; }
    .gantt-tick      { position: absolute; top: 0; height: 100%; border-left: 1px dashed #dee2e6;
                       font-size: .65rem; color: #adb5bd; padding-left: 2px; padding-top: .25rem;
                       white-space: nowrap; }
    .gantt-tick.hoy  { border-left: 2px solid #dc3545; color: #dc3545; font-weight: 700; }

    .gantt-row-label { background: #fff; border-right: 1px solid #dee2e6;
                       border-bottom: 1px solid #f0f0f0; padding: .3rem .75rem;
                       font-size: .78rem; display: flex; flex-direction: column;
                       justify-content: center; min-height: 52px;
                       position: sticky; left: 0; z-index: 1; }
    .gantt-row-body  { position: relative; border-bottom: 1px solid #f0f0f0;
                       background: #fff; min-height: 52px; }
    .gantt-row-body:hover { background: #f8fbff; }

    .gantt-bar       { position: absolute; height: 14px; border-radius: 4px;
                       cursor: help; transition: filter .15s; }
    .gantt-bar:hover { filter: brightness(.85); }
    .gantt-bar.est   { top: 8px;  opacity: .3; }
    .gantt-bar.real  { top: 28px; }
    .gantt-bar.borde-derecho { border-right: 3px dashed rgba(0,0,0,.25); }

    .gantt-hito      { position: absolute; width: 10px; height: 10px; border-radius: 50%;
                       border: 2px solid #fff; box-shadow: 0 0 0 1px #555; top: 21px; }
    .gantt-hoy-line  { position: absolute; top: 0; bottom: 0; width: 2px;
                       background: rgba(220,53,69,.35); pointer-events: none; z-index: 0; }

    .sublote-sep     { grid-column: 1 / -1; background: #f0f4ff;
                       padding: .25rem .75rem; font-size: .75rem; font-weight: 700;
                       color: #3d5a99; border-bottom: 1px solid #d0d9f0; }

    .leyenda-bar     { display: inline-block; width: 28px; height: 10px;
                       border-radius: 3px; vertical-align: middle; margin-right: 4px; }
</style>
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Produccion" asp-action="Index">Producción</a></li>
    <li class="breadcrumb-item"><a asp-controller="Planeamiento" asp-action="Index">Planeamiento</a></li>
    <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
    <li class="breadcrumb-item active">Gantt @Model.Serie-@Model.NumPed</li>
}

<!-- Encabezado -->
<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <h4 class="mb-0">
        <i class="bi bi-bar-chart-steps me-2 text-primary"></i>
        Gantt — Pedido <strong>@Model.Serie-@Model.NumPed</strong>
        @if (primerItem != null)
        {
            <small class="text-muted fs-6 ms-2">@primerItem.NombreCliente</small>
        }
    </h4>
    <div class="d-flex gap-2">
        <a asp-action="Pedido" asp-route-numPed="@Model.NumPed" asp-route-serie="@Model.Serie"
           class="btn btn-outline-primary btn-sm">
            <i class="bi bi-diagram-3 me-1"></i>Ver trazabilidad
        </a>
        <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>

<!-- Alertas -->
@if (Model.Alertas.Any())
{
    <div class="mb-3">
        @foreach (var a in Model.Alertas)
        {
            <div class="alert alert-@a.NivelColor py-2 d-flex align-items-center gap-2 mb-1">
                <i class="bi bi-bell-fill"></i>
                <div>
                    <strong>@a.TipoTexto</strong>
                    @if (a.Nro.HasValue)
                    {
                        <span class="badge bg-light text-dark border ms-1">Det.@a.Nro</span>
                    }
                    — @a.Titulo
                    @if (a.FchLimite.HasValue)
                    {
                        <span class="ms-2 small">Límite: @a.FchLimite.Value.ToString("dd/MM/yyyy")</span>
                    }
                    @if (a.DiasRetraso.HasValue && a.DiasRetraso > 0)
                    {
                        <span class="badge bg-danger ms-1">+@a.DiasRetraso d</span>
                    }
                    @if (a.HorasSinResolver.HasValue)
                    {
                        var h = (int)a.HorasSinResolver.Value;
                        <span class="ms-2 small text-muted"><i class="bi bi-clock me-1"></i>@(h >= 24 ? $"{h/24}d {h%24}h" : $"{h}h") sin resolver</span>
                    }
                </div>
            </div>
        }
    </div>
}

<!-- Leyenda -->
<div class="d-flex gap-4 mb-3 align-items-center flex-wrap small">
    <div><span class="leyenda-bar" style="background:#0d6efd;opacity:.3;"></span>Estimado</div>
    <div><span class="leyenda-bar" style="background:#0d6efd;"></span>Real</div>
    <div><i class="bi bi-circle-fill text-danger me-1" style="font-size:.6rem;"></i>Hoy</div>
    <div class="text-muted">Pasa el cursor sobre las barras para ver fechas</div>
</div>

<!-- Gantt -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-0 gantt-wrap">
        <div class="gantt-grid">

            <!-- Cabecera -->
            <div class="gantt-hdr-label">Etapa / Sublote</div>
            <div class="gantt-hdr-axis">
                @{
                    var tickDate = fechaMin.Date;
                }
                @while (tickDate <= fechaMax.Date)
                {
                    var left   = (tickDate - fechaMin).TotalDays / totalDias * 100;
                    var esHoy2 = tickDate == hoy;
                    var label  = esHoy2 ? "Hoy" : tickDate.ToString("dd/MM");
                    <div class="gantt-tick @(esHoy2 ? "hoy" : "")"
                         style="left:@left.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)%;">
                        @label
                    </div>
                    tickDate = tickDate.AddDays(3);
                }
            </div>

            <!-- Filas por sublote -->
            @foreach (var s in Model.Items.OrderBy(x => x.NumDet))
            {
                <!-- Separador -->
                <div class="sublote-sep">
                    Det. @s.NumDet — @s.CodArt
                    @if (!string.IsNullOrEmpty(s.Titulo))
                    {
                        <span class="fw-normal text-secondary ms-1">@s.Titulo @s.Color</span>
                    }
                    <span class="badge ms-2"
                          style="background-color:@s.ColorUi; font-size:.7rem;">
                        @s.CodPasoAct — @s.NombrePaso
                    </span>
                    @if (s.EstaEnReproceso)
                    {
                        <span class="badge bg-danger ms-1">Reproceso C.@s.NroCiclo</span>
                    }
                    @if (s.EsUrgente)
                    {
                        <span class="badge bg-danger ms-1">⚡ Urgente</span>
                    }
                </div>

                @foreach (var e in etapasDe(s))
                {
                    var tieneEst  = e.EI.HasValue && e.EF.HasValue;
                    var tieneReal = e.RI.HasValue;

                    if (!tieneEst && !tieneReal) { continue; }

                    var esActual = s.CodPasoAct == e.Cod;
                    var eIniL    = pctLeft(e.EI).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                    var eW       = pctWidth(e.EI, e.EF).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                    var rIniL    = pctLeft(e.RI).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                    var rW       = pctWidth(e.RI, e.RF).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                    var hoyL     = pctLeft(hoy).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

                    var ttEst  = tieneEst
                        ? $"{e.Nom} (Est): {e.EI!.Value:dd/MM/yy} → {e.EF!.Value:dd/MM/yy}"
                        : "";
                    var ttReal = tieneReal
                        ? $"{e.Nom} (Real): {e.RI!.Value:dd/MM/yy}" +
                          (e.RF.HasValue ? $" → {e.RF.Value:dd/MM/yy}" : " → en curso")
                        : "";

                    <div class="gantt-row-label @(esActual ? "fw-semibold" : "")">
                        <div style="color:@e.Color;">
                            @e.Nom
                            @if (esActual)
                            {
                                <span class="badge ms-1"
                                      style="background:@e.Color; font-size:.6rem;">actual</span>
                            }
                        </div>
                        @if (tieneReal && !e.RF.HasValue)
                        {
                            <small class="text-primary" style="font-size:.65rem;">⚙ en curso</small>
                        }
                    </div>
                    <div class="gantt-row-body">
                        <div class="gantt-hoy-line" style="left:@hoyL%;"></div>

                        @if (tieneEst)
                        {
                            <div class="gantt-bar est"
                                 style="left:@eIniL%;width:@eW%;background:@e.Color;"
                                 title="@ttEst">
                            </div>
                        }
                        @if (tieneReal)
                        {
                            <div class="gantt-bar real @(!e.RF.HasValue ? "borde-derecho" : "")"
                                 style="left:@rIniL%;width:@(e.RF.HasValue ? rW + "%" : "1.2%");background:@e.Color;"
                                 title="@ttReal">
                            </div>
                        }
                    </div>
                }

                <!-- Hito: entrega comprometida -->
                @if (s.FchEntregaComp.HasValue)
                {
                    var hitoL     = pctLeft(s.FchEntregaComp).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                    var hoyHitoL  = pctLeft(hoy).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                    var hitoColor = s.EstaRetrasado ? "#dc3545" : "#198754";

                    <div class="gantt-row-label" style="font-size:.72rem;color:@hitoColor;font-weight:600;">
                        Entrega comp.
                    </div>
                    <div class="gantt-row-body">
                        <div class="gantt-hoy-line" style="left:@hoyHitoL%;"></div>
                        <div class="gantt-hito"
                             style="left:calc(@hitoL% - 5px);background:@hitoColor;"
                             title="Entrega comprometida: @s.FchEntregaComp.Value.ToString("dd/MM/yyyy")">
                        </div>
                        @if (s.EstaRetrasado)
                        {
                            <span style="position:absolute;top:16px;left:calc(@hitoL% + 8px);
                                         font-size:.65rem;color:#dc3545;font-weight:700;white-space:nowrap;">
                                +@s.DiasRetraso d
                            </span>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Historial de eventos -->
@if (Model.Eventos.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white fw-semibold py-2">
            <i class="bi bi-clock-history me-1"></i> Historial de eventos
        </div>
        <div class="card-body p-0" style="max-height:260px;overflow-y:auto;">
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th>Etapa</th>
                            <th>Det.</th>
                            <th class="text-end">Kg</th>
                            <th>Obs.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in Model.Eventos)
                        {
                            <tr>
                                <td class="text-nowrap">@ev.FchEvento.ToString("dd/MM/yy HH:mm")</td>
                                <td>
                                    <span class="badge @(ev.TipoEvento == "RE" ? "bg-danger" : "bg-success")"
                                          style="font-size:.7rem;">
                                        @(ev.TipoEvento == "RE" ? "Reproceso" : "Avance")
                                    </span>
                                </td>
                                <td class="small">@ev.NombrePaso</td>
                                <td class="small text-muted">@ev.NumDet</td>
                                <td class="text-end small">
                                    @(ev.KgCantidad.HasValue ? ev.KgCantidad.Value.ToString("N0") : "—")
                                </td>
                                <td class="small text-muted text-truncate" style="max-width:180px;">
                                    @ev.Observacion
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
