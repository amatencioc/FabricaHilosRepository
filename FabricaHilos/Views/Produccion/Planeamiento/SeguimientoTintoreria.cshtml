if(cfAnoEl && cfAnoEl.value==='') {
    var opt2026 = cfAnoEl.querySelector('option[value="2026"]');
    if(opt2026) { cfAnoEl.value='2026'; }
}

// ── Arrancar ──────────────────────────────────────────────────────────────────
applyFilters();

// ── Popovers Bootstrap (columna EST) ─────────────────────────────────────────
document.querySelectorAll('[data-bs-toggle="popover"]').forEach(function(el){
    new bootstrap.Popover(el, { sanitize: false });
});
})();
</script>
