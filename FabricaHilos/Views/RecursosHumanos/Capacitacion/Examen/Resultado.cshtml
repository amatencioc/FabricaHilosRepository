@model FabricaHilos.Models.Capacitacion.ExamenResultadoVm
@{
    ViewData["Title"] = "Resultado del Examen";
    var aprobado = Model.Aprobado;
}

@section Styles {
<style>
/* ── LMS · Resultado Examen ─────────────────────── */
body { background:#f0f4f8; }
.confetti-wrap { position:fixed; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:9999; }
.lms-card { background:#fff; border:1px solid #dde3ec; border-radius:12px; box-shadow:0 2px 12px rgba(15,23,42,.07); }
.lms-btn { display:inline-flex; align-items:center; justify-content:center; gap:.35rem; border-radius:7px; padding:.5rem 1.2rem; font-size:.85rem; font-weight:500; text-decoration:none; transition:all .12s; cursor:pointer; border:none; width:100%; }
.lms-btn-primary { background:#1d4ed8; color:#fff; }
.lms-btn-primary:hover { background:#1e40af; color:#fff; }
.lms-btn-teal { background:#0f766e; color:#fff; }
.lms-btn-teal:hover { background:#0d6561; color:#fff; }
.lms-btn-outline { background:#fff; border:1px solid #dde3ec !important; color:#334155; }
.lms-btn-outline:hover { background:#f8fafc; border-color:#94a3b8 !important; color:#0f172a; }
.lms-btn-danger-outline { background:#fff; border:1px solid #fecdd3 !important; color:#9f1239; }
.lms-btn-danger-outline:hover { background:#fff1f2; }
.score-num-pass { font-size:3.5rem; font-weight:800; color:#0f766e; line-height:1; }
.score-num-fail { font-size:3.5rem; font-weight:800; color:#9f1239; line-height:1; }
.progress-lms { height:10px; border-radius:5px; background:#e8edf3; overflow:hidden; max-width:280px; margin:0 auto; }
.progress-lms-bar-pass { height:100%; background:linear-gradient(90deg,#0f766e,#0284c7); border-radius:5px; }
.progress-lms-bar-fail { height:100%; background:linear-gradient(90deg,#9f1239,#b45309); border-radius:5px; }
</style>
}

@if (aprobado)
{
    <div class="confetti-wrap" id="confettiWrap"></div>
}

<div class="container-sm py-4" style="max-width:580px">
    <div class="lms-card text-center p-5">
        <!-- Ícono resultado -->
        <div class="mb-3">
            @if (aprobado)
            {
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-1"
                     style="width:90px;height:90px;background:#f0fdfa;border:2px solid #99f6e4">
                    <i class="bi bi-check-lg" style="font-size:2.8rem;color:#0f766e"></i>
                </div>
            }
            else
            {
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-1"
                     style="width:90px;height:90px;background:#fff1f2;border:2px solid #fecdd3">
                    <i class="bi bi-x-lg" style="font-size:2.8rem;color:#9f1239"></i>
                </div>
            }
        </div>

        <h4 class="fw-bold mb-1" style="color:@(aprobado ? "#0f766e" : "#9f1239")">
            @(aprobado ? "¡Felicitaciones, aprobaste!" : "No aprobado")
        </h4>
        <div class="mb-4" style="font-size:.82rem;color:#64748b">@Model.TituloExamen · @Model.TituloCurso</div>

        <!-- Puntaje -->
        <div class="mb-4">
            <div class="@(aprobado ? "score-num-pass" : "score-num-fail")">@Model.PuntajeObt.ToString("F1")</div>
            <div style="font-size:.75rem;color:#94a3b8;margin-top:.2rem">sobre 100</div>
            <div class="progress-lms mt-3">
                <div class="@(aprobado ? "progress-lms-bar-pass" : "progress-lms-bar-fail")" style="width:@Model.PuntajeObt%"></div>
            </div>
            <div style="font-size:.72rem;color:#94a3b8;margin-top:.4rem">Nota mínima para aprobar: @Model.NotaAprobacion</div>
        </div>

        <div style="font-size:.76rem;color:#64748b;margin-bottom:1.25rem">Intento @Model.NroIntento de @Model.MaxIntentos</div>

        <!-- Acciones -->
        <div class="d-flex flex-column gap-2">
            @if (aprobado && Model.TieneCertificado)
            {
                <a asp-controller="Capacitacion" asp-action="MiPanel" class="lms-btn lms-btn-teal">
                    <i class="bi bi-patch-check-fill"></i> Ver mi certificado
                </a>
            }
            <a asp-controller="Curso" asp-action="Ver" asp-route-idCurso="@Model.IdCurso"
               class="lms-btn @(aprobado ? "lms-btn-outline" : "lms-btn-primary")">
                <i class="bi bi-collection-play"></i> Volver al curso
            </a>
            @if (Model.PuedeReintentar)
            {
                <a asp-controller="Examen" asp-action="IniciarExamen"
                   asp-route-idExamen="@Model.IdExamen"
                   asp-route-idInscripcion="@Model.IdInscripcion"
                   class="lms-btn lms-btn-danger-outline">
                    <i class="bi bi-arrow-repeat"></i> Intentar nuevamente
                    <span class="bdg bdg-venc ms-1">@(Model.MaxIntentos - Model.NroIntento) restantes</span>
                </a>
            }
            else if (!aprobado)
            {
                <div style="background:#fff1f2;border:1px solid #fecdd3;border-radius:8px;padding:.75rem 1rem;font-size:.82rem;color:#9f1239">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Has agotado todos los intentos. Contacta al administrador.
                </div>
            }
        </div>
    </div>
</div>

@if (aprobado)
{
    @section Scripts {
    <script>
    // Confetti simple con canvas
    (function() {
        const canvas = document.createElement('canvas');
        canvas.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9999';
        document.body.appendChild(canvas);
        const ctx = canvas.getContext('2d');
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        const pieces = Array.from({length:120}, () => ({
            x: Math.random() * canvas.width,
            y: Math.random() * canvas.height - canvas.height,
            w: Math.random()*10+5, h: Math.random()*10+5,
            color: ['#0d6efd','#198754','#ffd700','#fd7e14','#dc3545'][Math.floor(Math.random()*5)],
            vx: (Math.random()-0.5)*3, vy: Math.random()*4+2,
            rot: Math.random()*360, rv: (Math.random()-0.5)*6
        }));
        let frame = 0;
        function draw() {
            ctx.clearRect(0,0,canvas.width,canvas.height);
            pieces.forEach(p => {
                ctx.save();
                ctx.translate(p.x+p.w/2, p.y+p.h/2);
                ctx.rotate(p.rot*Math.PI/180);
                ctx.fillStyle = p.color;
                ctx.fillRect(-p.w/2,-p.h/2,p.w,p.h);
                ctx.restore();
                p.x += p.vx; p.y += p.vy; p.rot += p.rv;
                if (p.y > canvas.height) { p.y = -20; p.x = Math.random()*canvas.width; }
            });
            frame++;
            if (frame < 180) requestAnimationFrame(draw);
            else { ctx.clearRect(0,0,canvas.width,canvas.height); canvas.remove(); }
        }
        draw();
    })();
    </script>
    }
}
