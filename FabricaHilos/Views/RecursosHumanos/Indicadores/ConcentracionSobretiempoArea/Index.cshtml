@*
    ════════════════════════════════════════════════════════════════════════
    ARCHIVO: Index.cshtml
    MÓDULO:  RecursosHumanos / Indicadores / ComparativoCostoLaboral
    PROPÓSITO:
        Vista principal (shell) del dashboard "Comparativo Costo Laboral".
        Compara el costo laboral total (básico × 1.4232) entre DOS períodos
        configurables: Año 1 (referencia) vs Año 2 (comparación).

    FILTROS:
        El usuario elige DOS rangos:
          • Año 1 + (Mes Desde – Mes Hasta)   → período de REFERENCIA
          • Año 2 + (Mes Desde – Mes Hasta)   → período de COMPARACIÓN
        Cada rango es INDEPENDIENTE: puede comparar enero–dic 2025
        contra solo enero–mayo 2026 (año en curso), por ejemplo.

    FLUJO EN EL NAVEGADOR:
        1. Razor renderiza filtros + acordeón + contenedor vacío.
        2. cargarKpi() hace fetch a /Kpi con los 6 parámetros.
        3. El servidor devuelve el partial _KpiDashboard.cshtml.
        4. Se inyecta el HTML dentro de #kpi-container.
    ════════════════════════════════════════════════════════════════════════
*@
@{
    ViewData["Title"] = "KPI Comparativo de Costo Laboral";
    // Valores por defecto vienen del Controller:
    //   Año 1 = año anterior completo (enero–diciembre)
    //   Año 2 = año actual hasta el mes en curso (enero–mes actual)
    int ano1       = ViewBag.Ano1;
    int mesIniAno1 = ViewBag.MesIniAno1;  // Mes "Desde" del Año 1
    int mesFinAno1 = ViewBag.MesFinAno1;  // Mes "Hasta" del Año 1
    int ano2       = ViewBag.Ano2;
    int mesIniAno2 = ViewBag.MesIniAno2;  // Mes "Desde" del Año 2
    int mesFinAno2 = ViewBag.MesFinAno2;  // Mes "Hasta" del Año 2
}

@section Styles {
<style>
    .filter-bar {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,.07);
        padding: .85rem 1.25rem;
        margin-bottom: 1.4rem;
    }
    /* Bloque visual de un período (Año + meses Desde/Hasta) */
    .filter-period {
        background: #f8faf8;
        border: 1px solid #e3e8e3;
        border-radius: 10px;
        padding: .65rem .85rem .75rem;
    }
    .filter-period.is-ref      { border-left: 4px solid #1565C0; }  /* Año 1 (azul) */
    .filter-period.is-cmp      { border-left: 4px solid #1B4D3E; }  /* Año 2 (verde) */
    .filter-period.is-basic    { border-left: 4px solid #b8860b; }  /* Básico manual (dorado) */
    .filter-period.is-tipo     { border-left: 4px solid #6f42c1; }  /* Tipo empleado (púrpura) */
    .filter-period .period-title {
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: .35rem;
    }
    .filter-period.is-ref .period-title { color: #1565C0; }
    .filter-period.is-cmp .period-title { color: #1B4D3E; }
    .filter-period.is-basic .period-title { color: #b8860b; }
    .filter-period.is-tipo .period-title { color: #6f42c1; }
    .filter-period .mes-sep {
        font-size: .75rem;
        color: #6c757d;
        font-weight: 600;
        align-self: end;
        padding-bottom: .35rem;
    }
    .filter-hint {
