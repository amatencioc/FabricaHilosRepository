<!-- ── Proyección de Bolsa de HE por Área ──────────────────────────── -->
<div class="section-title"><i class="bi bi-piggy-bank me-1"></i>Proyección de Bolsa de HE por Área <span class="text-muted fw-normal" style="font-size:.72rem;">(promedio mensual del período consultado)</span></div>
<p class="text-muted mb-2" style="font-size:.78rem;">
    <strong>HE por Necesidad</strong>: sobretiempo de producción pura, sin ausencias ese día — referencia de bolsa mensual asignable al encargado de área.
    <strong>HE por Evento</strong>: sobretiempo usado para cubrir a un compañero ausente (falta, vacaciones, descanso médico, etc.) — no es proyectable como bolsa fija, depende de cuántas ausencias haya cada mes.
</p>
<div class="table-responsive mb-4">
    <table class="table table-sm table-hover table-corporate align-middle mb-0">
        <thead>
            <tr>
                <th>Área</th>
                <th class="text-center">Meses considerados</th>
                <th class="text-end hdr-grp-necesidad">HE Necesidad prom. (h/mes)</th>
                <th class="text-end hdr-grp-necesidad">HE Necesidad prom. (S/. /mes)</th>
                <th class="text-end hdr-grp-evento">HE Evento prom. (h/mes)</th>
                <th class="text-end hdr-grp-evento">HE Evento prom. (S/. /mes)</th>
                <th class="text-end fw-bold">Bolsa Mensual Sugerida (h)</th>
                <th class="text-end fw-bold">Bolsa Mensual Sugerida (S/.)</th>
            </tr>
        </thead>
        <tbody>
            @{
                // Solo Áreas con datos reales (mismo criterio/lista que "Detalle por Área" arriba)
                // — antes se listaban TODAS las Áreas del catálogo (incluso "SIN ÁREA" u otras
                // en 0.0 en todo, cuando el usuario filtró por un Gran Centro de Costo puntual
                // y esa Área ni siquiera aplica al filtro).
                var proyeccion = Model.ProyeccionBolsaHe.Where(pb => areas.Contains(pb.Area)).ToList();
            }
            @if (proyeccion.Count == 0)
            {
                <tr><td colspan="8" class="text-center text-muted">Sin datos suficientes (AQUARIUS) para proyectar</td></tr>
            }
            else
            {
                @foreach (var pb in proyeccion)
                {
                    <tr>
                        <td class="fw-semibold">@pb.Area</td>
                        <td class="text-center">@pb.MesesConsiderados</td>
                        <td class="text-end hdr-grp-necesidad">@pb.HorasHeNecesidadProm.ToString("N1")</td>
                        <td class="text-end hdr-grp-necesidad">@pb.MontoHeNecesidadProm.ToString("N1")</td>
                        <td class="text-end hdr-grp-evento">@pb.HorasHeEventoProm.ToString("N1")</td>
                        <td class="text-end hdr-grp-evento">@pb.MontoHeEventoProm.ToString("N1")</td>
                        <td class="text-end fw-bold">@pb.HorasHeNecesidadProm.ToString("N1") h</td>
                        <td class="text-end fw-bold">S/. @pb.MontoHeNecesidadProm.ToString("N1")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- ── Proyección de Bolsa de HE por Centro de Costo (v2.5) ────────────── -->
<div class="section-title"><i class="bi bi-piggy-bank me-1"></i>Proyección de Bolsa de HE por Centro de Costo <span class="text-muted fw-normal" style="font-size:.72rem;">(promedio mensual del período consultado)</span></div>
<div class="table-responsive mb-4">
    <table class="table table-sm table-hover table-corporate align-middle mb-0">
        <thead>
            <tr>
                <th>Centro de Costo</th>
                <th class="text-center">Meses considerados</th>
                <th class="text-end hdr-grp-necesidad">HE Necesidad prom. (h/mes)</th>
                <th class="text-end hdr-grp-necesidad">HE Necesidad prom. (S/. /mes)</th>
                <th class="text-end hdr-grp-evento">HE Evento prom. (h/mes)</th>
                <th class="text-end hdr-grp-evento">HE Evento prom. (S/. /mes)</th>
                <th class="text-end fw-bold">Bolsa Mensual Sugerida (h)</th>
                <th class="text-end fw-bold">Bolsa Mensual Sugerida (S/.)</th>
            </tr>
        </thead>
        <tbody>
            @{
                // Restringido a los mismos Gran Centro de Costo que "Detalle por Área" /
                // "Proyección de Bolsa de HE por Área" (lista "areas": solo los que tienen HE
                // real, no solo headcount) — antes un Centro de Costo con trabajadores
                // asignados pero SIN sobretiempo (ej. ADMINISTRACION > COBRANZA) igual pasaba
                // el filtro de "centrosConDatos" (que solo exige TotalTrabajadores != 0),
                // mostrando decenas de filas en 0.0 de Gran Centro de Costo sin bolsa alguna.
                var proyeccionCc = Model.ProyeccionBolsaHeCentroCosto
                    .Where(pb => areas.Contains(pb.GranCcosto) && centrosConDatos.Contains((pb.GranCcosto, pb.CentroCosto)))
                    .ToList();
                // Agrupado por Gran Centro de Costo (fila de sección con el nombre del Gran
                // Centro de Costo, como título del grupo, en vez de repetirlo en cada fila) —
                // grupos ordenados por bolsa total del grupo (desc.), filas dentro del grupo
                // por bolsa individual (desc.), mismo orden que antes.
                var gruposProyeccionCc = proyeccionCc
                    .GroupBy(pb => pb.GranCcosto)
                    .OrderByDescending(g => g.Sum(pb => pb.HorasHeNecesidadProm))
                    .ToList();
            }
            @if (proyeccionCc.Count == 0)
            {
                <tr><td colspan="8" class="text-center text-muted">Sin datos suficientes (AQUARIUS) para proyectar</td></tr>
            }
            else
            {
                @foreach (var grupo in gruposProyeccionCc)
                {
                    <tr class="table-active">
                        <td colspan="8" class="fw-bold text-uppercase" style="background:#e8f0e9; color:#1B4D3E;">@grupo.Key</td>
                    </tr>
                    @foreach (var pb in grupo.OrderByDescending(pb => pb.HorasHeNecesidadProm))
                    {
                        <tr>
                            <td class="ps-4">@pb.CentroCosto</td>
                            <td class="text-center">@pb.MesesConsiderados</td>
                            <td class="text-end hdr-grp-necesidad">@pb.HorasHeNecesidadProm.ToString("N1")</td>
                            <td class="text-end hdr-grp-necesidad">@pb.MontoHeNecesidadProm.ToString("N1")</td>
                            <td class="text-end hdr-grp-evento">@pb.HorasHeEventoProm.ToString("N1")</td>
                            <td class="text-end hdr-grp-evento">@pb.MontoHeEventoProm.ToString("N1")</td>
                            <td class="text-end fw-bold">@pb.HorasHeNecesidadProm.ToString("N1") h</td>
                            <td class="text-end fw-bold">S/. @pb.MontoHeNecesidadProm.ToString("N1")</td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>

