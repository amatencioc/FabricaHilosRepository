@model FabricaHilos.Models.Capacitacion.MiPanelVm
@{
    ViewData["Title"] = "Mi Panel de Capacitación";
}

@section Styles {
<style>
    :root {
        --lms-primary: #0d6efd;
        --lms-surface: #f8f9fa;
        --lms-border: #dee2e6;
    }
    .kpi-card { border: none; box-shadow: 0 2px 8px rgba(0,0,0,.08); }
    .course-card { transition: transform .15s, box-shadow .15s; border: none; box-shadow: 0 2px 6px rgba(0,0,0,.07); }
    .course-card:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.13) !important; }
    .progress { height: 6px; }
    .badge-nivel-B { background: #198754; }
    .badge-nivel-I { background: #fd7e14; }
    .badge-nivel-A { background: #dc3545; }
</style>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-mortarboard-fill text-primary me-2"></i>Mi Panel de Capacitación</h2>
    <div class="d-flex gap-2">
        @if (ViewBag.EsAdmin == true)
        {
            <a asp-controller="CapacitacionAdmin" asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-gear-fill me-1"></i>Administrar LMS
            </a>
        }
        <a asp-controller="Capacitacion" asp-action="Catalogo" class="btn btn-outline-primary">
            <i class="bi bi-grid me-1"></i>Ver Catálogo
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card kpi-card text-center p-3">
            <div class="display-6 fw-bold text-primary">@Model.CursosEnCurso</div>
            <div class="text-muted small mt-1"><i class="bi bi-play-circle me-1"></i>En Progreso</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card kpi-card text-center p-3">
            <div class="display-6 fw-bold text-success">@Model.CursosCompletados</div>
            <div class="text-muted small mt-1"><i class="bi bi-check-circle me-1"></i>Completados</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card kpi-card text-center p-3">
            <div class="display-6 fw-bold text-warning">@Model.Certificados</div>
            <div class="text-muted small mt-1"><i class="bi bi-patch-check me-1"></i>Certificados</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card kpi-card text-center p-3">
            <div class="display-6 fw-bold text-info">@Model.HorasCapacitacion</div>
            <div class="text-muted small mt-1"><i class="bi bi-clock me-1"></i>Horas Totales</div>
        </div>
    </div>
</div>

<!-- Mis cursos activos -->
@if (Model.CursosActivos.Any())
{
    <h5 class="fw-semibold mb-3"><i class="bi bi-play-circle-fill text-primary me-2"></i>Continuar aprendiendo</h5>
    <div class="row g-3 mb-5">
        @foreach (var c in Model.CursosActivos)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card course-card h-100">
                    @if (!string.IsNullOrEmpty(c.ImagenPortada))
                    {
                        <img src="/RecursosHumanos/Curso/ServirPortada/@c.IdCurso"
                             class="card-img-top object-fit-cover" style="height:160px" alt="@c.Titulo">
                    }
                    else
                    {
                        <div class="card-img-top d-flex align-items-center justify-content-center bg-light"
                             style="height:160px; border-bottom:1px solid var(--lms-border);">
                            <i class="bi @c.IconoCategoria" style="font-size:3rem;color:@c.ColorCategoria"></i>
                        </div>
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex gap-1 mb-2">
                            <span class="badge badge-nivel-@c.Nivel">@c.NivelTexto</span>
                            @if (c.EsObligatorio)
                            {
                                <span class="badge bg-danger">Obligatorio</span>
                            }
                        </div>
                        <h6 class="card-title fw-semibold flex-grow-1">@c.Titulo</h6>
                        <div class="text-muted small mb-2">@c.NombreCategoria</div>
                        <div class="mb-1 d-flex justify-content-between small">
                            <span>Progreso</span>
                            <span class="fw-semibold">@c.PctProgreso%</span>
                        </div>
                        <div class="progress mb-3">
                            <div class="progress-bar bg-primary" style="width:@c.PctProgreso%"></div>
                        </div>
                        <a asp-controller="Curso" asp-action="Ver"
                           asp-route-idCurso="@c.IdCurso"
                           class="btn btn-primary btn-sm">
                            <i class="bi bi-play-fill me-1"></i>Continuar
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info d-flex align-items-center mb-4">
        <i class="bi bi-info-circle-fill me-2 fs-5"></i>
        <span>No tienes cursos en progreso. ¡Explora el <a asp-controller="Capacitacion" asp-action="Catalogo">catálogo</a>!</span>
    </div>
}

<!-- Recomendados -->
@if (Model.CursosRecomendados.Any())
{
    <h5 class="fw-semibold mb-3"><i class="bi bi-stars text-warning me-2"></i>Cursos recomendados para ti</h5>
    <div class="row g-3">
        @foreach (var c in Model.CursosRecomendados)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card course-card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center mb-3">
                            <div class="rounded-2 p-2 me-3 d-flex"
                                 style="background-color:@(c.ColorCategoria)22">
                                <i class="bi @c.IconoCategoria fs-4" style="color:@c.ColorCategoria"></i>
                            </div>
                            <div>
                                <div class="small text-muted">@c.NombreCategoria</div>
                                <span class="badge badge-nivel-@c.Nivel">@c.NivelTexto</span>
                            </div>
                        </div>
                        <h6 class="card-title fw-semibold flex-grow-1">@c.Titulo</h6>
                        @if (!string.IsNullOrEmpty(c.Descripcion))
                        {
                            <p class="text-muted small">@(c.Descripcion!.Length > 80 ? c.Descripcion[..80] + "…" : c.Descripcion)</p>
                        }
                        <div class="d-flex justify-content-between align-items-center mt-auto pt-2">
                            @if (c.DuracionMin.HasValue)
                            {
                                <span class="text-muted small"><i class="bi bi-clock me-1"></i>@c.DuracionFormato</span>
                            }
                            <a asp-controller="Curso" asp-action="Detalle"
                               asp-route-idCurso="@c.IdCurso"
                               class="btn btn-outline-primary btn-sm ms-auto">Ver curso</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
