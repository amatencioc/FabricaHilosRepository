@model List<FabricaHilos.Models.Capacitacion.CapCurso>
@{
    ViewData["Title"] = "Administración de Capacitación";
    var categorias = ViewBag.Categorias as List<FabricaHilos.Models.Capacitacion.CapCategoria> ?? new List<FabricaHilos.Models.Capacitacion.CapCategoria>();
}

@section Styles {
<style>
/* ── LMS · Admin ───────────────────────────────── */
body { background:#f0f4f8; }
.lms-stat { background:#fff; border:1px solid #dde3ec; border-radius:10px; padding:.85rem 1rem; display:flex; align-items:center; gap:.85rem; }
.lms-stat-icon { width:38px; height:38px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:1.1rem; flex-shrink:0; }
.lms-stat-val { font-size:1.5rem; font-weight:700; color:#0f172a; line-height:1; font-variant-numeric:tabular-nums; }
.lms-stat-lbl { font-size:.68rem; color:#64748b; margin-top:3px; text-transform:uppercase; letter-spacing:.06em; }
.lms-card { background:#fff; border:1px solid #dde3ec; border-radius:10px; box-shadow:0 1px 4px rgba(15,23,42,.04); }
.sec-lbl { font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:#64748b; display:block; margin-bottom:.65rem; }
.bdg { display:inline-block; font-size:.67rem; font-weight:600; padding:.2em .55em; border-radius:4px; text-transform:uppercase; letter-spacing:.03em; }
.bdg-B { background:#eff6ff; color:#1d4ed8; }
.bdg-I { background:#f5f3ff; color:#6d28d9; }
.bdg-A { background:#fff1f2; color:#9f1239; }
.bdg-obl { background:#fff1f2; color:#9f1239; border:1px solid #fecdd3; }
.bdg-pub { background:#f0fdfa; color:#0f766e; }
.bdg-bor { background:#fefce8; color:#b45309; }
.bdg-arc { background:#f8fafc; color:#64748b; border:1px solid #e2e8f0; }
.cat-pill { display:inline-flex; align-items:center; gap:.3rem; border-radius:5px; padding:.2em .52em; font-size:.72rem; font-weight:600; }
.tbl-lms { font-size:.83rem; }
.tbl-lms thead th { font-size:.68rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:#64748b; border-bottom:2px solid #e8edf3; padding:.55rem .75rem; background:#fff; }
.tbl-lms tbody td { padding:.6rem .75rem; vertical-align:middle; border-bottom:1px solid #f1f5f9; color:#334155; }
.tbl-lms tbody tr:last-child td { border-bottom:none; }
.tbl-lms tbody tr:hover td { background:#f8fafc; }
.ico-btn { display:inline-flex; align-items:center; justify-content:center; width:30px; height:30px; border-radius:6px; border:1px solid #dde3ec; background:#fff; color:#475569; font-size:.85rem; text-decoration:none; transition:all .12s; }
.ico-btn:hover { background:#f1f5f9; border-color:#94a3b8; color:#1d4ed8; }
.lms-btn { display:inline-flex; align-items:center; gap:.35rem; border-radius:7px; padding:.38rem .9rem; font-size:.82rem; font-weight:500; text-decoration:none; transition:all .12s; cursor:pointer; border:none; }
.lms-btn-primary { background:#1d4ed8; color:#fff; }
.lms-btn-primary:hover { background:#1e40af; color:#fff; }
.lms-btn-outline { background:#fff; border:1px solid #dde3ec !important; color:#334155; }
.lms-btn-outline:hover { background:#f8fafc; border-color:#94a3b8 !important; color:#0f172a; }
</style>
}

<!-- ── Header ─────────────────────────────────────────────── -->
<div class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <span class="sec-lbl" style="margin-bottom:.25rem">Recursos Humanos · Capacitación</span>
    <h4 class="fw-bold mb-0" style="color:#0f172a">
      <i class="bi bi-sliders2 me-2" style="color:#1d4ed8;font-size:1.1rem"></i>Panel Administrador
    </h4>
  </div>
  <div class="d-flex gap-2">
    <a asp-controller="CapacitacionAdmin" asp-action="Reportes" class="lms-btn lms-btn-outline">
      <i class="bi bi-bar-chart"></i> Reportes
    </a>
    <a asp-controller="CapacitacionAdmin" asp-action="CursoForm" class="lms-btn lms-btn-primary">
      <i class="bi bi-plus-circle"></i> Nuevo Curso
    </a>
  </div>
</div>

<!-- ── Stats ───────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="lms-stat">
      <div class="lms-stat-icon" style="background:#eff6ff"><i class="bi bi-collection-fill" style="color:#1d4ed8"></i></div>
      <div><div class="lms-stat-val">@Model.Count</div><div class="lms-stat-lbl">Cursos publicados</div></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="lms-stat">
      <div class="lms-stat-icon" style="background:#fff1f2"><i class="bi bi-exclamation-circle-fill" style="color:#9f1239"></i></div>
      <div><div class="lms-stat-val">@Model.Count(c => c.Obligatorio=="S")</div><div class="lms-stat-lbl">Obligatorios</div></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="lms-stat">
      <div class="lms-stat-icon" style="background:#f0fdfa"><i class="bi bi-tags-fill" style="color:#0f766e"></i></div>
      <div><div class="lms-stat-val">@categorias.Count</div><div class="lms-stat-lbl">Categorías</div></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="lms-stat">
      <div class="lms-stat-icon" style="background:#ecfeff"><i class="bi bi-play-btn-fill" style="color:#0891b2"></i></div>
      <div><div class="lms-stat-val">@Model.Sum(c => c.TotalLecciones)</div><div class="lms-stat-lbl">Lecciones</div></div>
    </div>
  </div>
</div>

<!-- ── Course table ───────────────────────────────────────── -->
<div class="lms-card overflow-hidden">
  <div class="d-flex align-items-center justify-content-between px-3 py-2" style="border-bottom:1px solid #e8edf3">
    <span style="font-size:.78rem;font-weight:600;color:#334155">@Model.Count curso(s)</span>
    <div class="input-group input-group-sm" style="max-width:200px">
      <span class="input-group-text bg-white border-end-0" style="border-color:#dde3ec"><i class="bi bi-search" style="color:#94a3b8;font-size:.75rem"></i></span>
      <input class="form-control form-control-sm border-start-0" placeholder="Buscar…" id="searchCursos"
             style="border-color:#dde3ec;font-size:.8rem" />
    </div>
  </div>
  <div class="table-responsive">
    <table class="table tbl-lms mb-0" id="tablaCursos">
      <thead>
        <tr>
          <th style="min-width:200px">Curso</th>
          <th>Categoría</th>
          <th>Nivel</th>
          <th class="text-center">Lecc.</th>
          <th>Estado</th>
          <th class="text-end">Acciones</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var c in Model)
        {
          <tr>
            <td>
              <div class="fw-semibold" style="color:#0f172a;font-size:.85rem">@c.Titulo</div>
              @if (c.EsObligatorio)
              {
                <span class="bdg bdg-obl mt-1">Obligatorio</span>
              }
            </td>
            <td>
              <span class="cat-pill" style="background:@(c.ColorCategoria)1a;color:@c.ColorCategoria">
                <i class="bi @c.IconoCategoria"></i>@c.NombreCategoria
              </span>
            </td>
            <td><span class="bdg bdg-@c.Nivel">@c.NivelTexto</span></td>
            <td class="text-center">@c.TotalLecciones</td>
            <td>
              @{
                var bdgEstado = c.Estado == "A" ? "bdg-pub" : c.Estado == "I" ? "bdg-bor" : "bdg-arc";
              }
              <span class="bdg @bdgEstado">@c.EstadoTexto</span>
            </td>
            <td class="text-end">
              <div class="d-flex gap-1 justify-content-end">
                <a asp-controller="CapacitacionAdmin" asp-action="CursoForm" asp-route-id="@c.IdCurso"
                   class="ico-btn" title="Editar"><i class="bi bi-pencil"></i></a>
                <a asp-controller="CapacitacionAdmin" asp-action="Reportes" asp-route-idCurso="@c.IdCurso"
                   class="ico-btn" title="Inscriptos"><i class="bi bi-people"></i></a>
              </div>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

@section Scripts {
<script>
document.getElementById('searchCursos').addEventListener('input', function() {
    const q = this.value.toLowerCase();
    document.querySelectorAll('#tablaCursos tbody tr').forEach(tr => {
        tr.style.display = tr.textContent.toLowerCase().includes(q) ? '' : 'none';
    });
});
</script>
}
