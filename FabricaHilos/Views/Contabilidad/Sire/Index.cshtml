@model IReadOnlyList<FabricaHilos.Controllers.Contabilidad.SirePeriodoDashboardItem>
@{
    ViewData["Title"] = "SIRE — Gestión de Libros Electrónicos";

    string BadgeEstado(string estado) => estado switch
    {
        "PROPUESTA_DISPONIBLE" => "sire-badge-warn",
        "CERRADO"              => "sire-badge-ok",
        "EN_PROCESO"           => "sire-badge-process",
        _                      => "sire-badge-secondary"
    };

    string LabelEstado(string estado) => estado switch
    {
        "PROPUESTA_DISPONIBLE" => "Propuesta disponible",
        "CERRADO"              => "Cerrado",
        "EN_PROCESO"           => "En proceso",
        "SIN_INFORMACION"      => "Sin información",
        "-"                    => "—",
        _                      => estado
    };

    string IconEstado(string estado) => estado switch
    {
        "PROPUESTA_DISPONIBLE" => "bi-exclamation-circle",
        "CERRADO"              => "bi-check-circle",
        "EN_PROCESO"           => "bi-arrow-repeat",
        _                      => "bi-dash-circle"
    };

    int rvieDisponibles = Model.Count(x => x.EstadoRvie == "PROPUESTA_DISPONIBLE");
    int rvieEnProceso   = Model.Count(x => x.EstadoRvie == "EN_PROCESO");
    int rvieCerrados    = Model.Count(x => x.EstadoRvie == "CERRADO");
    int rceDisponibles  = Model.Count(x => x.EstadoRce  == "PROPUESTA_DISPONIBLE");
    int rceEnProceso    = Model.Count(x => x.EstadoRce  == "EN_PROCESO");
    int rceCerrados     = Model.Count(x => x.EstadoRce  == "CERRADO");
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Contabilidad" asp-action="Index">Contabilidad</a></li>
    <li class="breadcrumb-item active">SIRE</li>
}

@section Styles {
<link rel="stylesheet" href="~/css/sire.css" asp-append-version="true" />
}

@if (ViewBag.EsMock == true)
{
    <div class="sire-alert sire-alert-mock" role="alert">
        <i class="bi bi-cone-striped"></i>
        <div><strong>MODO MOCK ACTIVO</strong> — Los datos mostrados son de prueba. No se realizan llamadas reales a SUNAT.</div>
    </div>
}

@await Html.PartialAsync("~/Views/Contabilidad/Sire/_SireNavBar.cshtml")

<div class="sire-strip">
    <i class="bi bi-journal-text" style="color:#90cdf4;font-size:.95rem;flex-shrink:0;"></i>
    <span class="sire-strip-title">SIRE</span>
    <span class="sire-strip-sep"></span>
    <span class="sire-kpi" title="RVIE con propuesta disponible">
        <i class="bi bi-receipt-cutoff" style="color:#fbd38d;"></i>
        <span class="sire-kpi-val">@rvieDisponibles</span>
        <span style="opacity:.75">RVIE pendientes</span>
    </span>
    <span class="sire-kpi" title="RCE con propuesta disponible">
        <i class="bi bi-cart-check" style="color:#90cdf4;"></i>
        <span class="sire-kpi-val">@rceDisponibles</span>
        <span style="opacity:.75">RCE pendientes</span>
    </span>
    <span class="sire-kpi">
        <i class="bi bi-arrow-repeat" style="color:#76e4f7;"></i>
        <span class="sire-kpi-val">@(rvieEnProceso + rceEnProceso)</span>
        <span style="opacity:.75">en proceso</span>
    </span>
    <span class="sire-kpi">
        <i class="bi bi-check2-circle" style="color:#68d391;"></i>
        <span class="sire-kpi-val">@(rvieCerrados + rceCerrados)</span>
        <span style="opacity:.75">cerrados</span>
    </span>
    <span class="sire-kpi" style="margin-left:auto;">
        <i class="bi bi-calendar3"></i>
        <span style="opacity:.75">@Model.Count período(s)</span>
    </span>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="sire-kpi-card rvie">
            <div class="sire-kpi-card-icon rvie"><i class="bi bi-exclamation-circle"></i></div>
            <div>
                <div class="sire-kpi-card-label">RVIE pendientes</div>
                <div class="sire-kpi-card-value">@rvieDisponibles</div>
                <div class="sire-kpi-card-sub">Propuesta disponible</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="sire-kpi-card warn">
            <div class="sire-kpi-card-icon warn"><i class="bi bi-arrow-repeat"></i></div>
            <div>
                <div class="sire-kpi-card-label">En proceso</div>
                <div class="sire-kpi-card-value">@(rvieEnProceso + rceEnProceso)</div>
                <div class="sire-kpi-card-sub">RVIE + RCE en trámite</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="sire-kpi-card ok">
            <div class="sire-kpi-card-icon ok"><i class="bi bi-check-circle"></i></div>
            <div>
                <div class="sire-kpi-card-label">Cerrados</div>
                <div class="sire-kpi-card-value">@(rvieCerrados + rceCerrados)</div>
                <div class="sire-kpi-card-sub">RVIE + RCE completados</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="sire-module-card h-100">
            <div class="sire-module-card-header rvie">
                <i class="bi bi-receipt-cutoff"></i> RVIE — Registro de Ventas e Ingresos
                @if (rvieDisponibles > 0)
                {
                    <span class="ms-auto sire-badge sire-badge-warn">@rvieDisponibles pendiente(s)</span>
                }
            </div>
            <div class="sire-module-card-body">
                <p class="text-muted small mb-3">Consulta y gestiona propuestas de ventas electrónicas desde SUNAT.</p>
                <a asp-controller="Sire" asp-action="Ventas" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-right me-1"></i>Acceder a RVIE
                </a>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="sire-module-card h-100">
            <div class="sire-module-card-header rce">
                <i class="bi bi-cart-check"></i> RCE — Registro de Compras y Gastos
                @if (rceDisponibles > 0)
                {
                    <span class="ms-auto sire-badge sire-badge-warn">@rceDisponibles pendiente(s)</span>
                }
            </div>
            <div class="sire-module-card-body">
                <p class="text-muted small mb-3">Consulta y gestiona propuestas de compras electrónicas desde SUNAT.</p>
                <a asp-controller="Sire" asp-action="Compras" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-right me-1"></i>Acceder a RCE
                </a>
            </div>
        </div>
    </div>
</div>

@{
    // Años disponibles (del modelo, ordenados desc)
    var aniosDisp = Model
        .Where(x => x.Periodo.Length >= 4)
        .Select(x => x.Periodo[..4])
        .Distinct()
        .OrderByDescending(a => a)
        .ToList();
    var anioActual = DateTime.Now.Year.ToString();
}

<div class="sire-card">
    <div class="sire-card-header">
        <i class="bi bi-calendar3"></i>
        <span>Períodos registrados</span>
        @* ── Filtro de año ── *@
        <div class="ms-auto d-flex align-items-center gap-2">
            <i class="bi bi-funnel small" style="opacity:.6;"></i>
            <label for="filtroAnioTabla" class="mb-0 small text-nowrap" style="opacity:.75;">Año:</label>
            <select id="filtroAnioTabla" class="form-select form-select-sm" style="width:90px;"
                    onchange="filtrarTablaPeriodos(this.value)">
                @foreach (var a in aniosDisp)
                {
                    <option value="@a" selected="@(a == anioActual)">@a</option>
                }
                @if (!aniosDisp.Any())
                {
                    <option value="">@anioActual</option>
                }
            </select>
            <span id="contadorPeriodos" class="sire-badge sire-badge-secondary">@Model.Count</span>
        </div>
    </div>

    @* ── Leyenda de columnas ─────────────────────────────────────────────── *@
    <div class="px-3 py-2 border-bottom" style="background:#f8f9fa;font-size:.78rem;color:#6c757d;">
        <div class="d-flex gap-3 flex-wrap align-items-start">
            <div>
                <i class="bi bi-info-circle me-1 text-primary"></i>
                <strong>¿Qué significa cada columna?</strong>
            </div>
            <div>
                <span class="fw-semibold">Período:</span>
                Mes tributario en formato AAAA/MM (ej: 2026/08 = agosto 2026).
            </div>
            <div>
                <span class="fw-semibold">Descripción:</span>
                Estado de presentación del período según SUNAT.
                <em>"No Presentado"</em> = la declaración aún no fue enviada formalmente a SUNAT.
                Este texto proviene directamente de la API SUNAT (campo <code>desEstado</code>).
            </div>
            <div>
                <span class="fw-semibold text-primary">RVIE</span>
                (Registro de Ventas e Ingresos Electrónico):
                Estado de la propuesta de <strong>ventas</strong> que SUNAT tiene para ese período.
                Si muestra "Sin información" significa que SUNAT aún no generó la propuesta.
                Si muestra "Propuesta disponible" = hay registros listos para revisar y aceptar.
            </div>
            <div>
                <span class="fw-semibold" style="color:#0dcaf0;">RCE</span>
                (Registro de Compras y Gastos Electrónico):
                Igual que RVIE pero para el registro de <strong>compras</strong>.
                Los botones de acción llevan a cada módulo para gestionar la propuesta.
            </div>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table sire-table table-hover align-middle mb-0" id="tablaPeriodos">
                <thead>
                    <tr>
                        <th>Período</th>
                        <th>
                            Descripción
                            <i class="bi bi-info-circle ms-1 text-muted"
                               style="font-size:.75rem;cursor:help;"
                               title="Estado del período según SUNAT. Ej: 'No Presentado' = sin declaración formal."
                               data-bs-toggle="tooltip"></i>
                        </th>
                        <th class="text-center">
                            RVIE
                            <i class="bi bi-info-circle ms-1 text-muted"
                               style="font-size:.75rem;cursor:help;"
                               title="Estado del Registro de Ventas e Ingresos Electrónico (propuesta de ventas en SUNAT)"
                               data-bs-toggle="tooltip"></i>
                        </th>
                        <th class="text-center">
                            RCE
                            <i class="bi bi-info-circle ms-1 text-muted"
                               style="font-size:.75rem;cursor:help;"
                               title="Estado del Registro de Compras y Gastos Electrónico (propuesta de compras en SUNAT)"
                               data-bs-toggle="tooltip"></i>
                        </th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            <small>Sin períodos disponibles. Verifique la conexión con SUNAT.</small>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        var periodo = item.Periodo;
                        var yyyyMm  = periodo.Length == 6 ? $"{periodo[..4]}/{periodo[4..]}" : periodo;
                        var anioFila = periodo.Length >= 4 ? periodo[..4] : "";
                        <tr data-anio="@anioFila">
                            <td><span class="sire-badge sire-badge-period">@yyyyMm</span></td>
                            <td class="text-muted small">@item.Descripcion</td>
                            <td class="text-center">
                                @if (item.EstadoRvie == "-")
                                {
                                    <span class="text-muted small">—</span>
                                }
                                else
                                {
                                    <span class="sire-badge @BadgeEstado(item.EstadoRvie)"
                                          title="@item.DescRvie" data-bs-toggle="tooltip">
                                        <i class="bi @IconEstado(item.EstadoRvie)"></i>
                                        @LabelEstado(item.EstadoRvie)
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.EstadoRce == "-")
                                {
                                    <span class="text-muted small">—</span>
                                }
                                else
                                {
                                    <span class="sire-badge @BadgeEstado(item.EstadoRce)"
                                          title="@item.DescRce" data-bs-toggle="tooltip">
                                        <i class="bi @IconEstado(item.EstadoRce)"></i>
                                        @LabelEstado(item.EstadoRce)
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-controller="Sire" asp-action="Ventas" asp-route-periodo="@periodo"
                                       class="btn btn-outline-secondary btn-sm" title="Ver RVIE" data-bs-toggle="tooltip">
                                        <i class="bi bi-receipt"></i>
                                    </a>
                                    <a asp-controller="Sire" asp-action="Compras" asp-route-periodo="@periodo"
                                       class="btn btn-outline-secondary btn-sm" title="Ver RCE" data-bs-toggle="tooltip">
                                        <i class="bi bi-cart3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="sire-card mt-3">
    <div class="sire-card-header">
        <i class="bi bi-activity"></i>
        <span>Actividad reciente de exportaciones</span>
        <button class="btn btn-xs btn-outline-secondary ms-auto py-0 px-2" onclick="cargarPanelActividad()" title="Actualizar">
            <i class="bi bi-arrow-clockwise"></i>
        </button>
        <a asp-action="Monitoreo" class="btn btn-xs btn-outline-info py-0 px-2 ms-1" title="Ver log completo">
            <i class="bi bi-journal-code me-1"></i>Log completo
        </a>
    </div>
    <div class="card-body p-0">

        <!-- ══ Estado del procesador (visible solo cuando hay jobs activos) ══ -->
        <div id="estadoCola" style="display:none;" class="px-3 pt-3 pb-2 border-bottom">
            <div class="d-flex align-items-center gap-1 mb-2">
                <i class="bi bi-cpu text-secondary" style="font-size:.85rem;"></i>
                <span class="small text-muted fw-semibold">Cola de procesamiento SUNAT</span>
                <span class="badge bg-secondary ms-1" style="font-size:.65rem;">1 proceso a la vez</span>
            </div>
            <div id="estadoColaContenido" class="row g-2"></div>
        </div>

        <!-- ══ Dos columnas: RVIE | RCE ══ -->
        <div class="row g-0">
            <!-- Columna RVIE — Ventas -->
            <div class="col-md-6 border-end">
                <div class="px-3 py-2 border-bottom d-flex align-items-center gap-2" style="background:#f0f7ff;">
                    <span class="sire-badge sire-badge-rvie" style="font-size:.7rem;">RVIE</span>
                    <span class="small fw-semibold" style="color:#2b6cb0;">Ventas e Ingresos</span>
                </div>
                <div class="table-responsive">
                    <table class="table sire-table table-hover align-middle mb-0 small">
                        <thead>
                            <tr>
                                <th style="width:90px">Período</th>
                                <th>Estado</th>
                                <th style="width:130px">Iniciado</th>
                                <th style="width:70px"></th>
                            </tr>
                        </thead>
                        <tbody id="tbodyJobsRvie">
                            <tr><td colspan="4" class="text-center text-muted py-3 small">
                                <div class="spinner-border spinner-border-sm me-2" role="status"></div>Cargando…
                            </td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- Columna RCE — Compras -->
            <div class="col-md-6">
                <div class="px-3 py-2 border-bottom d-flex align-items-center gap-2" style="background:#f0fcff;">
                    <span class="sire-badge sire-badge-rce" style="font-size:.7rem;">RCE</span>
                    <span class="small fw-semibold" style="color:#086f83;">Compras y Gastos</span>
                </div>
                <div class="table-responsive">
                    <table class="table sire-table table-hover align-middle mb-0 small">
                        <thead>
                            <tr>
                                <th style="width:90px">Período</th>
                                <th>Estado</th>
                                <th style="width:130px">Iniciado</th>
                                <th style="width:70px"></th>
                            </tr>
                        </thead>
                        <tbody id="tbodyJobsRce">
                            <tr><td colspan="4" class="text-center text-muted py-3 small">
                                <div class="spinner-border spinner-border-sm me-2" role="status"></div>Cargando…
                            </td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ══ Log del proceso activo ══ -->
        <div class="px-3 py-2 border-top" id="seccionLogsActivos" style="display:none;">
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-journal-text text-info"></i>
                <span class="fw-semibold small">Actividad del proceso en curso</span>
            </div>
            <div id="logsActivosContainer" style="max-height:180px;overflow-y:auto;font-size:.8rem;"></div>
        </div>

    </div>
</div>

@section Scripts {

<!-- Modal: Ver proceso activo desde el Dashboard -->
<div class="modal fade" id="modalJobActivo" tabindex="-1" aria-labelledby="modalJobActivoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2" id="modalJobActivoHeader" style="background:#0dcaf0;color:#000;">
                <h6 class="modal-title" id="modalJobActivoLabel">
                    <i class="bi bi-cpu me-2"></i><span id="modalJobActivoTitulo">Proceso activo</span>
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div id="modalJobActivoEstado">
                    <div class="text-center py-3">
                        <div class="spinner-border text-info mb-2" role="status"></div>
                        <p class="text-muted small">Cargando estado…</p>
                    </div>
                </div>
                <div id="modalJobActivoLogs"
                     style="display:none;max-height:200px;overflow-y:auto;font-size:.8rem;
                            border-top:1px solid #dee2e6;margin-top:.75rem;padding-top:.5rem">
                </div>
            </div>
            <div class="modal-footer py-2 gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnIrVistaJob" onclick="_irAVistaJob()">
                    <i class="bi bi-box-arrow-up-right me-1"></i>Ir a vista completa
                </button>
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<script>
    // ── Filtro por año — tabla Períodos registrados ──────────────────────────
    function filtrarTablaPeriodos(anio) {
        const filas    = document.querySelectorAll('#tablaPeriodos tbody tr[data-anio]');
        let visible    = 0;
        filas.forEach(tr => {
            const mostrar = !anio || tr.dataset.anio === anio;
            tr.style.display = mostrar ? '' : 'none';
            if (mostrar) visible++;
        });
        const contador = document.getElementById('contadorPeriodos');
        if (contador) contador.textContent = visible;
    }

    document.addEventListener('DOMContentLoaded', () => {
        // Aplicar filtro inicial (año actual ya seleccionado en el select)
        const sel = document.getElementById('filtroAnioTabla');
        if (sel) filtrarTablaPeriodos(sel.value);

        document.querySelectorAll('[data-bs-toggle="tooltip"]')
            .forEach(el => new bootstrap.Tooltip(el));

        // Cargar panel de actividad al iniciar
        cargarPanelActividad();
    });

    // ── Panel de actividad: jobs recientes + logs del job activo ──────────────

    let _actividadTimer = null;

    async function cargarPanelActividad() {
        try {
            const resp = await fetch('@Url.Action("JobsRecientes", "Sire")', { method: 'GET' });
            const data = await resp.json();
            if (!data.exitoso) return;

            const jobs = data.jobs || [];
            renderizarEstadoCola(jobs);
            renderizarJobs(jobs);
            renderizarLogsActivos(data.logsRvie || null, data.logsRce || null);

            const hayActivo = jobs.some(j => j.estado === 'Pendiente' || j.estado === 'EnProceso' || j.estado === 'EsperandoTicket');
            clearTimeout(_actividadTimer);
            if (hayActivo) _actividadTimer = setTimeout(cargarPanelActividad, 5000);
        } catch (e) { /* silencioso */ }
    }

    // ── Estado de la cola: tarjetas RVIE + RCE ──────────────────────────────
    function renderizarEstadoCola(jobs) {
        const cont      = document.getElementById('estadoCola');
        const contenido = document.getElementById('estadoColaContenido');
        if (!cont || !contenido) return;

        const rvie = jobs.find(j => j.tipoRegistro === 'ventas'   && (j.estado === 'EnProceso' || j.estado === 'Pendiente' || j.estado === 'EsperandoTicket'));
        const rce  = jobs.find(j => j.tipoRegistro === 'compras'  && (j.estado === 'EnProceso' || j.estado === 'Pendiente' || j.estado === 'EsperandoTicket'));

        if (!rvie && !rce) { cont.style.display = 'none'; return; }
        cont.style.display = '';

        const rvieEnProceso = rvie?.estado === 'EnProceso';
        const rceEnProceso  = rce?.estado  === 'EnProceso';

        function tarjeta(tipo, job) {
            const label = tipo === 'ventas' ? 'RVIE — Ventas' : 'RCE — Compras';
            const jobId = job?.jobId; 
            const per   = job ? (job.periodo.length === 6
                ? `${job.periodo.slice(0,4)}/${job.periodo.slice(4)}`
                : job.periodo) : '';

            if (!job) {
                return `<div class="col-sm-6">
                    <div class="d-flex align-items-center gap-2 px-3 py-2 rounded" style="background:#f8f9fa;border:1px solid #dee2e6;">
                        <i class="bi bi-dash-circle text-muted"></i>
                        <span class="small text-muted">${label}: sin proceso activo</span>
                    </div>
                </div>`;
            }

            if (job.estado === 'EsperandoTicket') {
                const proxima = job.proximaConsulta ? ` &mdash; Próx. consulta: <strong>${job.proximaConsulta}</strong>` : '';
                return `<div class="col-sm-6">
                    <div class="d-flex align-items-center gap-2 px-3 py-2 rounded" style="border:1px solid #ffc107;background:#fffde7;">
                        <span style="font-size:1.1rem;flex-shrink:0;">⏳</span>
                        <div style="flex:1;min-width:0;">
                            <div><span class="badge bg-warning text-dark">${label}</span> <strong class="ms-1">${per}</strong></div>
                            <div class="text-muted" style="font-size:.75rem;">Esperando respuesta de SUNAT${proxima}</div>
                        </div>
                        <button class="btn btn-xs btn-outline-warning py-0 px-2 ms-1" style="white-space:nowrap;"
                                onclick="reconectarJobDesdeIndex('${jobId}','${job.periodo}','${job.tipoRegistro}')">
                            <i class="bi bi-eye me-1"></i>Ver
                        </button>
                    </div>
                </div>`;
            }

            if (job.estado === 'EnProceso') {
                return `<div class="col-sm-6">
                    <div class="d-flex align-items-center gap-2 px-3 py-2 rounded" style="border:1px solid #0dcaf0;background:#e8f7fc;">
                        <span class="spinner-border spinner-border-sm text-info" style="width:.85rem;height:.85rem;flex-shrink:0;"></span>
                        <div style="flex:1;min-width:0;">
                            <div><span class="badge bg-info text-dark">${label}</span> <strong class="ms-1">${per}</strong></div>
                            <div class="text-muted" style="font-size:.75rem;">Procesando en SUNAT…</div>
                        </div>
                        <button class="btn btn-xs btn-outline-info py-0 px-2 ms-1" style="white-space:nowrap;"
                                onclick="reconectarJobDesdeIndex('${jobId}','${job.periodo}','${job.tipoRegistro}')">
                            <i class="bi bi-eye me-1"></i>Ver
                        </button>
                    </div>
                </div>`;
            }

            // Pendiente
            const bloqueadoPor = (tipo === 'compras' && rvieEnProceso) ? 'RVIE (Ventas)'
                               : (tipo === 'ventas'  && rceEnProceso)  ? 'RCE (Compras)'
                               : null;
            const nota = bloqueadoPor
                ? `<i class="bi bi-hourglass-split text-warning me-1"></i>Esperando que termine <strong>${bloqueadoPor}</strong>. Se iniciará automáticamente.`
                : `<i class="bi bi-hourglass me-1"></i>En cola — el servidor la procesará en breve.`;

            return `<div class="col-sm-6">
                <div class="d-flex align-items-center gap-2 px-3 py-2 rounded" style="border:1px solid #ffc107;background:#fffde7;">
                    <i class="bi bi-hourglass-split text-warning" style="flex-shrink:0;font-size:1rem;"></i>
                    <div style="flex:1;min-width:0;">
                        <div><span class="badge bg-warning text-dark">${label}</span> <strong class="ms-1">${per}</strong></div>
                        <div class="text-muted" style="font-size:.75rem;">${nota}</div>
                    </div>
                    <button class="btn btn-xs btn-outline-warning py-0 px-2 ms-1" style="white-space:nowrap;"
                            onclick="reconectarJobDesdeIndex('${jobId}','${job.periodo}','${job.tipoRegistro}')">
                        <i class="bi bi-eye me-1"></i>Ver
                    </button>
                </div>
            </div>`;
        }

        contenido.innerHTML = `<div class="row g-2">${tarjeta('ventas', rvie)}${tarjeta('compras', rce)}</div>`;
    }

    // ── Tabla de jobs ────────────────────────────────────────────────────────
    function badgeJob(estado, mensajeError) {
        const errTip = mensajeError
            ? ` <i class="bi bi-info-circle text-danger ms-1" title="${mensajeError.replace(/"/g,'&quot;').slice(0,200)}" data-bs-toggle="tooltip"></i>`
            : '';
        switch (estado) {
            case 'Pendiente':        return `<span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>En cola</span>`;
            case 'EnProceso':        return `<span class="badge bg-info text-dark"><span class="spinner-border spinner-border-sm me-1" style="width:.65rem;height:.65rem;"></span>En proceso</span>`;
            case 'EsperandoTicket': return `<span class="badge bg-warning text-dark">⏳ Esperando SUNAT</span>`;
            case 'Completado':       return `<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Completado</span>`;
            case 'Error':            return `<span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Error</span>${errTip}`;
            default:                 return `<span class="badge bg-secondary">${estado}</span>`;
        }
    }

    function renderizarJobs(jobs) {
        const tbodyRvie = document.getElementById('tbodyJobsRvie');
        const tbodyRce  = document.getElementById('tbodyJobsRce');
        if (!tbodyRvie || !tbodyRce) return;

        const jobsRvie = jobs.filter(j => j.tipoRegistro === 'ventas');
        const jobsRce  = jobs.filter(j => j.tipoRegistro === 'compras');

        function filaJob(j) {
            const perFmt = j.periodo && j.periodo.length === 6
                ? `${j.periodo.slice(0,4)}/${j.periodo.slice(4)}`
                : (j.periodo || '—');

            let accion = '';
            if (j.estado === 'Pendiente' || j.estado === 'EnProceso' || j.estado === 'EsperandoTicket') {
                accion = `<button class="btn btn-xs btn-outline-info py-0 px-2"
                    onclick="reconectarJobDesdeIndex('${j.jobId}','${j.periodo}','${j.tipoRegistro}')">
                    <i class="bi bi-eye me-1"></i>Ver</button>`;
            } else if (j.puedeReintentar) {
                accion = `<button class="btn btn-xs btn-outline-warning py-0 px-2"
                    onclick="reconectarJobDesdeIndex('${j.jobId}','${j.periodo}','${j.tipoRegistro}')">
                    <i class="bi bi-arrow-clockwise me-1"></i></button>`;
            }

            const fechaCol = j.estado === 'EsperandoTicket' && j.proximaConsulta
                ? `<span title="Próx. consulta: ${j.proximaConsulta}">${j.fechaActualizacion} ⏳</span>`
                : j.fechaCreacion;

            return `<tr>
                <td><span class="sire-badge sire-badge-period">${perFmt}</span></td>
                <td>${badgeJob(j.estado, j.mensajeError)}</td>
                <td class="text-muted small" style="font-size:.75rem;">${fechaCol}</td>
                <td class="text-end">${accion}</td>
            </tr>`;
        }

        const VACÍO = (tipo) =>
            `<tr><td colspan="4" class="text-center text-muted py-3 small">
                <i class="bi bi-inbox me-1"></i>Sin actividad ${tipo}
             </td></tr>`;

        tbodyRvie.innerHTML = jobsRvie.length ? jobsRvie.map(filaJob).join('') : VACÍO('RVIE');
        tbodyRce.innerHTML  = jobsRce.length  ? jobsRce.map(filaJob).join('')  : VACÍO('RCE');

        [tbodyRvie, tbodyRce].forEach(t =>
            t.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => new bootstrap.Tooltip(el)));
    }

    // ── Logs de ambos procesos activos (RVIE + RCE) ─────────────────────────
    function renderizarLogsActivos(logsRvie, logsRce) {
        const cont    = document.getElementById('logsActivosContainer');
        const seccion = document.getElementById('seccionLogsActivos');
        if (!cont || !seccion) return;

        const hayLogs = (logsRvie && logsRvie.length) || (logsRce && logsRce.length);
        if (!hayLogs) { seccion.style.display = 'none'; return; }
        seccion.style.display = '';

        function renderPanel(logs, tipo) {
            if (!logs || !logs.length) return '';

            const label     = tipo === 'rvie' ? 'RVIE — Ventas' : 'RCE — Compras';
            const badgeCls  = tipo === 'rvie' ? 'sire-badge-rvie' : 'sire-badge-rce';
            const etiquetas = {
                AUTH:      'Autenticación con SUNAT',
                INICIAR:   'Job iniciado',
                EXPORTAR:  'Exportación solicitada a SUNAT',
                TICKET:    'Verificando respuesta de SUNAT',
                DESCARGAR: 'Descargando archivo ZIP',
                GUARDAR:   'Guardando archivo en servidor',
                CARGAR:    'Cargando registros en Oracle',
                COMPLETAR: 'Proceso completado',
                ERROR:     'Error',
                CANCEL:    'Cancelado manualmente',
            };

            const filas = logs.map(l => {
                const icono = l.exito
                    ? '<i class="bi bi-check-circle-fill text-success"></i>'
                    : '<i class="bi bi-x-circle-fill text-danger"></i>';
                const lab = etiquetas[l.operacion] || l.operacion;
                const dur = l.duracionMs > 0 ? `<span class="text-muted ms-1">(${l.duracionMs}ms)</span>` : '';
                const msg = l.mensaje
                    ? `<div class="${l.exito ? 'text-muted' : 'text-danger'} mt-1" style="font-size:.75rem;">${l.mensaje.slice(0,200)}</div>` : '';
                return `<div class="d-flex align-items-start gap-2 py-1 border-bottom">
                    <span style="min-width:1rem;margin-top:2px;flex-shrink:0;">${icono}</span>
                    <div style="flex:1;min-width:0;"><span class="small">${lab}</span>${dur}${msg}</div>
                    <span class="text-muted small text-nowrap">${l.fecha.slice(11,19)}</span>
                </div>`;
            }).join('');

            return `<div style="flex:1;min-width:0;">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="sire-badge ${badgeCls}" style="font-size:.65rem;">${label}</span>
                </div>
                <div style="max-height:160px;overflow-y:auto;font-size:.8rem;">${filas}</div>
            </div>`;
        }

        const panelRvie = renderPanel(logsRvie, 'rvie');
        const panelRce  = renderPanel(logsRce,  'rce');

        const ambos = panelRvie && panelRce;
        cont.innerHTML = ambos
            ? `<div class="d-flex gap-3">${panelRvie}<div style="width:1px;background:#dee2e6;"></div>${panelRce}</div>`
            : (panelRvie || panelRce);
    }

    // ── Navegar a la vista de Compras/Ventas y reconectar al job ────────────
    let _modalJobId   = null;
    let _modalPeriodo = null;
    let _modalTipo    = null;
    let _modalTimer   = null;

    async function reconectarJobDesdeIndex(jobId, periodo, tipo) {
        _modalJobId   = jobId;
        _modalPeriodo = periodo;
        _modalTipo    = tipo;

        // Título del modal según tipo
        const titulo = tipo === 'ventas' ? 'RVIE — Ventas' : 'RCE — Compras';
        const perFmt = periodo.length === 6
            ? `${periodo.slice(0,4)}/${periodo.slice(4)}` : periodo;
        document.getElementById('modalJobActivoTitulo').textContent =
            `${titulo} · ${perFmt}`;

        // Color del header según tipo
        const header = document.getElementById('modalJobActivoHeader');
        header.style.background = tipo === 'ventas' ? '#90cdf4' : '#0dcaf0';

        // Limpiar estado anterior
        document.getElementById('modalJobActivoEstado').innerHTML =
            `<div class="text-center py-3">
                <div class="spinner-border text-info mb-2" role="status"></div>
                <p class="text-muted small">Cargando estado…</p>
             </div>`;
        document.getElementById('modalJobActivoLogs').style.display = 'none';
        document.getElementById('modalJobActivoLogs').innerHTML = '';

        clearTimeout(_modalTimer);
        const modalEl = document.getElementById('modalJobActivo');
        const modal   = bootstrap.Modal.getOrCreateInstance(modalEl);

        // Bootstrap.show() es asíncrono (transición CSS ~150ms).
        // Si llamamos _actualizarModalJob antes de que termine la animación,
        // classList.contains('show') devuelve false y la función aborta.
        // Usamos el evento 'shown.bs.modal' para asegurar que el modal está visible.
        const onShown = () => {
            modalEl.removeEventListener('shown.bs.modal', onShown);
            _actualizarModalJob(jobId, periodo, tipo);
        };
        modalEl.addEventListener('shown.bs.modal', onShown);
        modal.show();
    }

    async function _actualizarModalJob(jobId, periodo, tipo) {
        // Detener si el job cambió (el usuario abrió otro job en otro llamado)
        if (_modalJobId !== jobId) return;

        try {
            const [respEstado, respLogs] = await Promise.all([
                fetch(`@Url.Action("EstadoExportacion", "Sire")?jobId=${encodeURIComponent(jobId)}`),
                fetch(`@Url.Action("LogsJob", "Sire")?jobId=${encodeURIComponent(jobId)}`)
            ]);
            const estado = await respEstado.json();
            const logs   = await respLogs.json();

            _renderEstadoModalJob(estado, jobId, periodo, tipo);
            _renderLogsModalJob(logs);

            // Seguir actualizando si no es estado final
            if (estado.exitoso && !estado.esFinal) {
                _modalTimer = setTimeout(() => _actualizarModalJob(jobId, periodo, tipo), 5000);
            }
        } catch { /* silencioso */ }
    }

    function _renderEstadoModalJob(result, jobId, periodo, tipo) {
        const div = document.getElementById('modalJobActivoEstado');
        if (!result.exitoso) {
            div.innerHTML = `<div class="alert alert-danger py-2 small">${result.error || 'Error al obtener estado.'}</div>`;
            return;
        }
        const estado = result.estado || 'EnProceso';
        const badgeColor = estado === 'EnProceso'        ? 'info'
            : estado === 'EsperandoTicket' ? 'warning'
            : estado === 'Completado'      ? 'success'
            : estado === 'Error'           ? 'danger' : 'secondary';
        const estadoLabel = {
            Pendiente: 'En cola', EnProceso: 'En proceso',
            EsperandoTicket: '⏳ Esperando SUNAT',
            Completado: 'Completado', Error: 'Error'
        }[estado] || estado;
        const spinner = (estado === 'EnProceso' || estado === 'Pendiente' || estado === 'EsperandoTicket')
            ? `<span class="spinner-border spinner-border-sm me-1" style="width:.7rem;height:.7rem;"></span>` : '';
        const proximaFila = estado === 'EsperandoTicket' && result.proximaConsulta
            ? `<tr><td class="text-muted small">Próxima consulta</td><td class="small fw-semibold">${result.proximaConsulta}</td></tr>` : '';
        const ticketFila = result.numTicket
            ? `<tr><td class="text-muted small">Ticket SUNAT</td><td><code class="small">${result.numTicket}</code></td></tr>` : '';
        const errorFila = estado === 'Error' && result.mensajeError
            ? `<tr><td colspan="2"><div class="alert alert-danger py-1 mb-0 small">${result.mensajeError}</div></td></tr>` : '';

        div.innerHTML = `
            <div class="text-center mb-3">
                <span class="badge bg-${badgeColor} text-dark p-2" style="font-size:.9rem;">
                    ${spinner}${estadoLabel}
                </span>
            </div>
            <table class="table table-sm table-borderless mb-0" style="font-size:.84rem">
                <tr><td class="text-muted small">Período</td><td class="small fw-semibold">${result.periodo || periodo}</td></tr>
                <tr><td class="text-muted small">Iniciado</td><td class="small">${result.fechaCreacion || ''}</td></tr>
                ${ticketFila}${proximaFila}${errorFila}
            </table>`;
    }

    function _renderLogsModalJob(data) {
        const cont = document.getElementById('modalJobActivoLogs');
        if (!data.exitoso || !data.logs?.length) return;
        cont.style.display = 'block';

        const etiquetas = {
            AUTH:      { icon: '🔑', label: 'Autenticación con SUNAT' },
            INICIAR:   { icon: '▶️',  label: 'Job iniciado' },
            EXPORTAR:  { icon: '📤', label: 'Exportación solicitada a SUNAT' },
            TICKET:    { icon: '🔄', label: 'Verificando respuesta de SUNAT' },
            DESCARGAR: { icon: '⬇️', label: 'Descargando archivo' },
            GUARDAR:   { icon: '💾', label: 'Guardando archivo' },
            CARGAR:    { icon: '📥', label: 'Cargando registros al sistema' },
            COMPLETAR: { icon: '✅', label: 'Proceso completado' },
            CANCEL:    { icon: '🚫', label: 'Cancelado' },
            ERROR:     { icon: '❌', label: 'Error' },
        };
        cont.innerHTML = `<div class="fw-semibold mb-1 text-muted" style="font-size:.75rem">ACTIVIDAD RECIENTE</div>` +
            data.logs.map(l => {
                const e   = etiquetas[l.operacion] || { icon: l.exito ? '✅' : '❌', label: l.operacion };
                const css = l.exito ? 'text-success-emphasis' : 'text-danger-emphasis';
                const dur = l.duracionMs > 0
                    ? `<span class="badge bg-secondary ms-1" style="font-size:.65rem;font-weight:400">${l.duracionMs}ms</span>` : '';
                const http = l.httpStatus
                    ? `<span class="badge ms-1" style="font-size:.65rem;font-weight:400;background:#6c757d">${l.metodo||''} ${l.httpStatus}</span>` : '';
                const msg = l.mensaje
                    ? `<div class="text-muted" style="font-size:.78rem;word-break:break-word">${l.mensaje}</div>` : '';
                return `<div class="d-flex gap-2 border-bottom py-1 align-items-start">
                    <span>${e.icon}</span>
                    <div style="flex:1">
                        <span class="${css} fw-semibold">${e.label}</span>${dur}${http}${msg}
                    </div>
                    <span class="text-muted text-nowrap" style="font-size:.75rem">${l.fecha.slice(11,19)}</span>
                </div>`;
            }).join('');
        // Scroll al final (último paso)
        cont.scrollTop = cont.scrollHeight;
    }

    function _irAVistaJob() {
        if (!_modalJobId || !_modalPeriodo || !_modalTipo) return;
        const url = _modalTipo === 'ventas'
            ? '@Url.Action("Ventas", "Sire")?periodo=' + _modalPeriodo
            : '@Url.Action("Compras", "Sire")?periodo=' + _modalPeriodo;
        sessionStorage.setItem('sireJobId',          _modalJobId);
        sessionStorage.setItem('periodoExportacion', _modalPeriodo);
        sessionStorage.setItem('tipoExportacion',    _modalTipo);
        sessionStorage.setItem('sireReconectar',     '1');
        window.location.href = url;
    }

    // Limpiar timer cuando se cierra el modal
    document.getElementById('modalJobActivo')
        .addEventListener('hidden.bs.modal', () => {
            clearTimeout(_modalTimer);
            _modalJobId = null;
        });
</script>
}
