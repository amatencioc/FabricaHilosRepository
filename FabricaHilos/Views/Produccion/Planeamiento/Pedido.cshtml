@* ── ZONA A: Strip industrial de información del pedido ─────── *@
@if (primerItem != null)
{
    <div class="pln-info-strip mb-3">
        <div class="d-flex align-items-stretch flex-wrap">
            <div class="pln-strip-cell">
                <div class="pln-strip-lbl">Cliente</div>
                <div class="pln-strip-val">@primerItem.NombreCliente</div>
                <div class="pln-strip-sub">@primerItem.CodCliente</div>
            </div>
            <div class="pln-strip-cell">
                <div class="pln-strip-lbl">Fecha pedido</div>
                <div class="pln-strip-val">@primerItem.FchPedido.ToString("dd/MM/yyyy")</div>
            </div>
            <div class="pln-strip-cell">
                <div class="pln-strip-lbl">Entrega comprometida</div>
                <div class="pln-strip-val @(primerItem.EstaRetrasado ? "text-warning" : "")">
                    @(primerItem.FchEntregaComp?.ToString("dd/MM/yyyy") ?? "—")
                    @if (primerItem.EstaRetrasado)
                    {
                        <span class="badge bg-danger ms-1" style="font-size:.68rem;">+@primerItem.DiasRetraso d</span>
                    }
                </div>
            </div>
            <div class="pln-strip-cell">
                <div class="pln-strip-lbl">Sublotes</div>
                <div class="pln-strip-val">@Model.Items.Count()</div>
                <div class="pln-strip-sub">@Model.Items.Sum(x => x.CantidadOrig).ToString("N0") kg en total</div>
            </div>
            <div class="pln-strip-cell">
                <div class="pln-strip-lbl">Días para entrega</div>
                @{
                    var fchComp = Model.Items.Select(x => x.FchEntregaComp).Where(f => f.HasValue).Min();
                    var diasRest = fchComp.HasValue ? (fchComp.Value - DateTime.Today).Days : (int?)null;
                }
                @if (diasRest.HasValue)
                {
                    var colorDias = diasRest.Value < 0 ? "#fc8181" : diasRest.Value <= 5 ? "#f6ad55" : "#e2e8f0";
                    <div class="pln-strip-val" style="color:@colorDias;">
                        @(diasRest.Value < 0 ? $"{Math.Abs(diasRest.Value)}d vencido" : $"{diasRest.Value}d restantes")
                    </div>
                    <div class="pln-strip-sub">@fchComp!.Value.ToString("dd/MM/yyyy")</div>
                }
                else
                {
                    <div class="pln-strip-val">—</div>
                }
            </div>
            @if (Model.Items.Any(x => x.EsUrgente))
            {
                <div class="pln-strip-cell" style="background:rgba(229,62,62,.15);">
                    <div class="pln-strip-lbl" style="color:#fc8181;">Estado</div>
                    <div class="pln-strip-val"><span class="badge bg-danger">⚡ URGENTE</span></div>
                </div>
            }
            else if (Model.Items.Any(x => x.EstaRetrasado))
            {
                <div class="pln-strip-cell" style="background:rgba(253,126,20,.12);">
                    <div class="pln-strip-lbl" style="color:#f6ad55;">Estado</div>
                    <div class="pln-strip-val" style="font-size:.82rem;color:#fed7aa;">⚠ Con retraso</div>
                </div>
            }
        </div>
    </div>
}

