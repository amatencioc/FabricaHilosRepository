// Descarga el Excel de la última búsqueda mostrada en pantalla (individual o
// masiva), reutilizando exactamente los mismos parámetros de esa búsqueda.
async function exportarExcel() {
    if (!ultimaBusqueda) {
        mostrarError('Realice una búsqueda antes de exportar a Excel.');
        return;
    }

    let url;
    if (ultimaBusqueda.modo === 'masivo') {
        url = `/RecursosHumanos/FindEmpleado/ExportarExcelMasivo?desde=${encodeURIComponent(ultimaBusqueda.desde)}&hasta=${encodeURIComponent(ultimaBusqueda.hasta)}&categoria=${encodeURIComponent(ultimaBusqueda.categoria)}`;
    } else {
        url = `/RecursosHumanos/FindEmpleado/ExportarExcel?q=${encodeURIComponent(ultimaBusqueda.q)}&tipo=${encodeURIComponent(ultimaBusqueda.tipo)}`;
        if (ultimaBusqueda.desde) url += `&desde=${encodeURIComponent(ultimaBusqueda.desde)}`;
        if (ultimaBusqueda.hasta) url += `&hasta=${encodeURIComponent(ultimaBusqueda.hasta)}`;
    }

    const btn = document.getElementById('btnExportarExcel');
    const htmlOriginal = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Exportando...';

    try {
        const resp = await fetch(url, { cache: 'no-store' });
        if (!resp.ok) {
            const mensaje = await resp.text();
            mostrarError(mensaje || 'No se pudo generar el archivo Excel.');
            return;
        }

        const blob = await resp.blob();
        const disposition = resp.headers.get('content-disposition') || '';
        const match = /filename="?([^";]+)"?/i.exec(disposition);
        const fileName = match ? match[1] : `Exportacion_${Date.now()}.xlsx`;

        const blobUrl = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = blobUrl;
        a.download = fileName;
        document.body.appendChild(a);
        a.click();
        a.remove();
        window.URL.revokeObjectURL(blobUrl);
    } catch (err) {
        mostrarError('Error de conexión al generar el archivo Excel.');
    } finally {
        btn.disabled = false;
        btn.innerHTML = htmlOriginal;
    }
}

async function buscar(tipoOverride, qOverride) {
    ocultarSugerencias();
    let q    = qOverride || document.getElementById('txtBuscar').value.trim();
    let tipo = tipoOverride || document.getElementById('selTipo').value;

    // Si no vino un override explícito y el texto actual coincide con el de una
    // sugerencia previamente seleccionada, reutilizamos la búsqueda determinística
    // por CODIGO (evita fallos al re-buscar por NOMBRE con el texto completo, por
    // ejemplo al aplicar el rango de fechas y volver a pulsar "Buscar").
    if (!tipoOverride && !qOverride && codigoSeleccionado && q === nombreSeleccionado) {
        tipo = 'CODIGO';
        q    = codigoSeleccionado;
    }

    const desde = document.getElementById('txtDesde').value;
    const hasta = document.getElementById('txtHasta').value;
    const categoria = document.getElementById('selCategoria').value;

    ocultarError();

    // v2.0 — Sin nombre + rango de fechas completo => búsqueda masiva (todos los
    // empleados/obreros con registro en SIG.SI_REGPERS dentro del rango).
    if (!q) {
        if (desde && hasta) {
            await buscarMasivo(desde, hasta, categoria);
        } else {
            mostrarError('Ingrese un valor de búsqueda, o un rango de fechas completo (Desde y Hasta) para traer todos los empleados/obreros.');
        }
        return;
    }

    document.getElementById('divResultado').style.display       = 'none';
    document.getElementById('divResultadoMasivo').style.display = 'none';
    document.getElementById('divAuditoria').style.display  = 'none';
    document.getElementById('divEmptyState').style.display = 'none';
    document.getElementById('loadingBar').style.display    = '';

    const btnBuscar = document.getElementById('btnBuscar');
    btnBuscar.disabled = true;
    mostrarOverlay('Buscando empleado, por favor espere...');

    try {
        let url = `/RecursosHumanos/FindEmpleado/Buscar?q=${encodeURIComponent(q)}&tipo=${encodeURIComponent(tipo)}`;
        if (desde) url += `&desde=${encodeURIComponent(desde)}`;
        if (hasta) url += `&hasta=${encodeURIComponent(hasta)}`;

        const resp = await fetch(url, { cache: 'no-store' });
        const data = await resp.json();

        document.getElementById('loadingBar').style.display = 'none';

        if (!resp.ok || !data.ok) {
            mostrarError(data.mensaje || 'Empleado no encontrado.');
            document.getElementById('divEmptyState').style.display = '';
            document.getElementById('btnExportarExcel').style.display = 'none';
            ultimaBusqueda = null;
            return;
        }

        ultimaBusqueda = { modo: 'individual', q, tipo, desde, hasta };
        document.getElementById('btnExportarExcel').style.display = '';
        mostrarResultado(data.data, !!(desde && hasta));
    } catch (err) {
        document.getElementById('loadingBar').style.display = 'none';
        mostrarError('Error de conexión al consultar el empleado.');
        document.getElementById('divEmptyState').style.display = '';
        document.getElementById('btnExportarExcel').style.display = 'none';
        ultimaBusqueda = null;
    } finally {
        btnBuscar.disabled = false;
        ocultarOverlay();
    }
}

// v2.0 — Búsqueda masiva: sin nombre, solo rango de fechas + categoría.
async function buscarMasivo(desde, hasta, categoria) {
    document.getElementById('divResultado').style.display       = 'none';
    document.getElementById('divResultadoMasivo').style.display = 'none';
    document.getElementById('divAuditoria').style.display  = 'none';
    document.getElementById('divEmptyState').style.display = 'none';
    document.getElementById('loadingBar').style.display    = '';

    const btnBuscar = document.getElementById('btnBuscar');
    btnBuscar.disabled = true;
    mostrarOverlay('Buscando empleados en el rango indicado, esto puede tardar unos segundos...');

    try {
        const url = `/RecursosHumanos/FindEmpleado/BuscarMasivo?desde=${encodeURIComponent(desde)}&hasta=${encodeURIComponent(hasta)}&categoria=${encodeURIComponent(categoria)}`;
        const resp = await fetch(url, { cache: 'no-store' });
        const data = await resp.json();

        document.getElementById('loadingBar').style.display = 'none';

        if (!resp.ok || !data.ok) {
            mostrarError(data.mensaje || 'No se pudo completar la búsqueda masiva.');
            document.getElementById('divEmptyState').style.display = '';
            document.getElementById('btnExportarExcel').style.display = 'none';
            ultimaBusqueda = null;
            return;
        }

        ultimaBusqueda = { modo: 'masivo', desde, hasta, categoria };
        document.getElementById('btnExportarExcel').style.display = '';
        mostrarResultadoMasivo(data.data || []);
    } catch (err) {
        document.getElementById('loadingBar').style.display = 'none';
        mostrarError('Error de conexión al consultar la búsqueda masiva.');
        document.getElementById('divEmptyState').style.display = '';
        document.getElementById('btnExportarExcel').style.display = 'none';
        ultimaBusqueda = null;
    } finally {
        btnBuscar.disabled = false;
        ocultarOverlay();
    }
}


function escapeHtml(v) {
    if (v === null || v === undefined || v === '') return '—';
    return String(v)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;');
}

// v1.4 — Badge uniforme para columnas de tipo flag (S/N -> SÍ verde / NO rojo)
function flagBadge(v) {
    if (v === null || v === undefined || v === '') return '<span class="badge badge-flag-nd">—</span>';
    const s = String(v).trim().toUpperCase();
    if (s === 'S' || s === 'SI' || s === 'SÍ') return '<span class="badge badge-flag-si">SÍ</span>';
    if (s === 'N' || s === 'NO') return '<span class="badge badge-flag-no">NO</span>';
    return escapeHtml(v);
}

// RESULTADO_ALCOHOL (SIG.SI_REGPERS) usa dominio 'P'=Positivo / 'N'=Negativo (no S/N).
function alcoholResultBadge(v) {
    if (v === null || v === undefined || v === '') return '<span class="badge badge-alc-nr">—</span>';
    const s = String(v).trim().toUpperCase();
    if (s === 'P') return '<span class="badge badge-alc-pos">POSITIVO</span>';
    if (s === 'N') return '<span class="badge badge-alc-neg">NEGATIVO</span>';
    return escapeHtml(v);
}

function mostrarResultado(emp, hasRango) {
    document.getElementById('lblNombre').textContent      = emp.nombreCompleto || '—';
    document.getElementById('lblCodAquarius').textContent  = emp.codAquarius || '—';
    document.getElementById('lblCodSig').textContent       = emp.codSig || '—';
    document.getElementById('lblDni').textContent          = emp.dni || '—';
    document.getElementById('lblEmpresa').textContent      = emp.empresa || '—';
    document.getElementById('lblHorario').textContent      = emp.horarioDescripcion || '—';
    document.getElementById('lblTurno').textContent        = emp.horarioTurno || '—';

    const iniciales = (emp.nombreCompleto || '?')
        .split(' ')
        .filter(Boolean)
        .slice(0, 2)
        .map(w => w[0].toUpperCase())
        .join('');
    document.getElementById('lblIniciales').textContent = iniciales || '?';

    // Vigilancia (SIG.SI_REGPERS EN VIVO)
    document.getElementById('lblFuenteVigilancia').textContent = emp.vigilanciaFuente || 'SIG.SI_REGPERS (VIGILANCIA - TIEMPO REAL)';

    // Rango efectivo (v1.3)
    document.getElementById('lblRangoVig').textContent =
        (emp.rangoVigilanciaDesde && emp.rangoVigilanciaHasta)
            ? `${emp.rangoVigilanciaDesde} — ${emp.rangoVigilanciaHasta}`
            : '—';
    document.getElementById('lblRangoEvt').textContent =
        (emp.rangoEventosDesde && emp.rangoEventosHasta)
            ? `${emp.rangoEventosDesde} — ${emp.rangoEventosHasta}`
            : '—';

    // Detalle completo Vigilancia (SIG.SI_REGPERS)
    const tblVig = document.getElementById('tblVigilanciaBody');
    const regs = emp.vigilanciaRegistros || [];
    document.getElementById('lblCountVig').textContent = regs.length ? `(${regs.length} registro${regs.length === 1 ? '' : 's'})` : '';
    if (regs.length === 0) {
        tblVig.innerHTML = '<tr><td colspan="15" class="no-data-row">Sin registros de Vigilancia en el rango seleccionado</td></tr>';
    } else {
        tblVig.innerHTML = regs.map(r => {
            const esPositivo = String(r.resultadoAlcohol || '').trim().toUpperCase() === 'P';
            return `
            <tr class="${esPositivo ? 'fila-alcohol-pos' : ''}">
                <td>${escapeHtml(r.tipo)}</td><td>${escapeHtml(r.codSig)}</td><td>${escapeHtml(r.docId)}</td>
                <td>${escapeHtml(r.nombre)}</td><td>${escapeHtml(r.dniRuc)}</td>
                <td>${escapeHtml(r.centroCosto)}</td><td>${escapeHtml(r.tipoCp)}</td>
                <td>${escapeHtml(r.fechaIngreso)}</td><td>${escapeHtml(r.fechaSalida)}</td>
                <td>${flagBadge(r.traeCelular)}</td><td>${flagBadge(r.guardaCelular)}</td><td>${escapeHtml(r.nroBlock)}</td>
                <td>${flagBadge(r.testAlcohol)}</td><td>${alcoholResultBadge(r.resultadoAlcohol)}</td>
                <td class="wrap-obs">${escapeHtml(r.observacion)}</td>
            </tr>`;
        }).join('');
    }

    // Resumen — Pruebas de Alcohol (derivado de vigilanciaRegistros, mismo rango que Detalle Vigilancia)
    const tblAlc = document.getElementById('tblAlcoholBody');
    const pruebasAlcohol = regs.filter(r => String(r.testAlcohol || '').trim().toUpperCase() === 'S');
    document.getElementById('lblRangoAlcohol').textContent = document.getElementById('lblRangoVig').textContent;
    document.getElementById('lblCountAlcohol').textContent = pruebasAlcohol.length ? `(${pruebasAlcohol.length} prueba${pruebasAlcohol.length === 1 ? '' : 's'})` : '';
    if (pruebasAlcohol.length === 0) {
        tblAlc.innerHTML = '<tr><td colspan="2" class="no-data-row">Sin pruebas de alcohol en el rango seleccionado</td></tr>';
    } else {
        tblAlc.innerHTML = pruebasAlcohol.map(r => {
            const fecha = (r.fechaIngreso || r.fechaSalida || '—').split(' ')[0];
            const esPositivo = String(r.resultadoAlcohol || '').trim().toUpperCase() === 'P';
            return `<tr class="${esPositivo ? 'fila-alcohol-pos' : ''}"><td>${escapeHtml(fecha)}</td><td>${alcoholResultBadge(r.resultadoAlcohol)}</td></tr>`;
        }).join('');
    }

    // Historial de Eventos SIG (RH_EVENTOS)
    const tblEvt = document.getElementById('tblEventosBody');
    const evts = emp.eventosHistorial || [];
    document.getElementById('lblCountEvt').textContent = evts.length ? `(${evts.length} evento${evts.length === 1 ? '' : 's'})` : '';
    if (evts.length === 0) {
        tblEvt.innerHTML = '<tr><td colspan="6" class="no-data-row">Sin eventos SIG en el rango seleccionado</td></tr>';
    } else {
        tblEvt.innerHTML = evts.map(e => `
            <tr>
                <td>${escapeHtml(e.tipoCodigo)}</td><td>${escapeHtml(e.descripcion)}</td>
                <td>${escapeHtml(e.fechaInicio)}</td><td>${escapeHtml(e.fechaFinal)}</td>
                <td class="wrap-obs">${escapeHtml(e.observacion)}</td>
                <td>${e.noSincroniza ? '<span class="badge badge-flag-no">NO</span>' : '<span class="badge badge-flag-si">SÍ</span>'}</td>
            </tr>`).join('');
    }

    document.getElementById('divResultado').style.display = '';
    document.getElementById('divAuditoria').style.display = '';
}

// v2.0 — Renderiza el bloque "Resumen + expandir detalle" para búsqueda masiva
// (sin nombre, solo rango de fechas). Un card colapsable por empleado/obrero.
function mostrarResultadoMasivo(lista) {
    document.getElementById('lblCountMasivo').textContent =
        lista.length ? `(${lista.length} empleado${lista.length === 1 ? '' : 's'})` : '(0 empleados)';

    const cont = document.getElementById('listaMasivo');

    if (!lista.length) {
        cont.innerHTML = '<div class="no-data-row">No se encontraron empleados/obreros con registros en el rango seleccionado.</div>';
        document.getElementById('divResultadoMasivo').style.display = '';
        return;
    }

    cont.innerHTML = lista.map((emp, idx) => {
        const vig = emp.vigilanciaRegistros || [];
        const pruebasAlcohol = vig.filter(r => String(r.testAlcohol || '').trim().toUpperCase() === 'S');
        const positivos = pruebasAlcohol.filter(r => String(r.resultadoAlcohol || '').trim().toUpperCase() === 'P').length;
        const evt = emp.eventosHistorial || [];
        const iniciales = (emp.nombreCompleto || '?')
            .split(' ').filter(Boolean).slice(0, 2).map(w => w[0].toUpperCase()).join('');
        const idBody = `masivo-body-${idx}`;

        return `
        <div class="card mb-2 ${positivos > 0 ? 'border-danger' : ''}">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2"
                 style="cursor:pointer;" onclick="toggleMasivoDetalle('${idBody}', this)">
                <div class="d-flex align-items-center gap-3">
                    <span class="avatar-lg" style="width:36px;height:36px;font-size:.8rem;">${escapeHtml(iniciales)}</span>
                    <div>
                        <strong>${escapeHtml(emp.nombreCompleto)}</strong>
                        <div class="text-muted small">
                            Cód. Aquarius: ${escapeHtml(emp.codAquarius)} · Cód. SIG: ${escapeHtml(emp.codSig)} · DNI: ${escapeHtml(emp.dni)}
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-secondary">${vig.length} vigilancia</span>
                    <span class="badge ${positivos > 0 ? 'bg-danger' : 'bg-light text-dark'}">${positivos} alcohol +</span>
                    <span class="badge bg-info text-dark">${evt.length} eventos</span>
                    <i class="bi bi-chevron-down"></i>
                </div>
            </div>
            <div id="${idBody}" class="card-body" style="display:none;">
                ${renderDetalleEmpleadoHtml(emp)}
            </div>
        </div>`;
    }).join('');

    document.getElementById('divResultadoMasivo').style.display = '';
}

function toggleMasivoDetalle(idBody, headerEl) {
    const body = document.getElementById(idBody);
    const abierto = body.style.display !== 'none';
    body.style.display = abierto ? 'none' : '';
    const icon = headerEl.querySelector('.bi-chevron-down, .bi-chevron-up');
    if (icon) icon.className = abierto ? 'bi bi-chevron-down' : 'bi bi-chevron-up';
}

