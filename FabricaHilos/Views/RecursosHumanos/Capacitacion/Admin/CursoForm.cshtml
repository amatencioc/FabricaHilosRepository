            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil me-2" style="color:#1d4ed8"></i>Editar contenido</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formEditarContenido" enctype="multipart/form-data">
