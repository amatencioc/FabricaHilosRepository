@model FabricaHilos.Models.Contabilidad.MemorandoDto
@{
    Layout = null;
    var meses = new[] { "enero","febrero","marzo","abril","mayo","junio",
                        "julio","agosto","septiembre","octubre","noviembre","diciembre" };
    var fechaLarga = $"{Model.Fecha.Day} de {meses[Model.Fecha.Month - 1]} de {Model.Fecha.Year}";
    bool tieneEmpresa = !string.IsNullOrWhiteSpace(Model.EmpresaNombre);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Memorando @Model.NumeroMemo</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: "Times New Roman", Times, serif;
            font-size: 11pt;
            background: #c8c8c8;
            color: #111;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        /* Barra de herramientas (solo pantalla) */
        .toolbar {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: .7rem 1rem;
            background: #2c3e50;
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .toolbar .tl-title {
            color: #ecf0f1;
            font-family: Arial, sans-serif;
            font-size: 10pt;
            opacity: .8;
            flex: 1;
            text-align: left;
            padding-left: .5rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .btn-tool {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: .4rem 1.1rem;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-family: Arial, sans-serif;
            font-size: 10pt;
            font-weight: 600;
            transition: opacity .15s;
        }
        .btn-tool:hover { opacity: .85; }
        .btn-back  { background: #7f8c8d; color: #fff; }
        .btn-print { background: #2980b9; color: #fff; }

        /* Hoja A4 */
        .page-wrap {
            padding: 1.5rem 0 2.5rem;
        }
        .memo-page {
            width: min(210mm, 100%);
            min-height: 297mm;
            margin: 0 auto;
            padding: 15mm 20mm 22mm 20mm;
            background: #fff;
            box-shadow: 0 4px 24px rgba(0,0,0,.25);
            position: relative;
        }

        /* Encabezado corporativo */
        .corp-header {
            display: flex;
            align-items: center;
            gap: 14px;
            padding-bottom: 8px;
            border-bottom: 3px solid #1a3a5c;
            margin-bottom: 14px;
        }
        .corp-logo {
            flex-shrink: 0;
            max-height: 52px;
            max-width: 120px;
        }
        .corp-info { flex: 1; }
        .corp-nombre {
            font-family: Arial, sans-serif;
            font-size: 12.5pt;
            font-weight: bold;
            color: #1a3a5c;
            text-transform: uppercase;
            letter-spacing: .03em;
            line-height: 1.2;
        }
        .corp-detalle {
            font-family: Arial, sans-serif;
            font-size: 8pt;
            color: #555;
            margin-top: 2px;
            line-height: 1.4;
        }
        .corp-ruc {
            font-family: Arial, sans-serif;
            font-size: 8pt;
            color: #888;
        }

        /* Titulo del memorando */
        .memo-titulo-wrap {
            text-align: center;
            margin: 14px 0 10px;
        }
        .memo-titulo {
            display: inline-block;
            font-family: Arial, sans-serif;
            font-size: 12pt;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: #1a3a5c;
            border-bottom: 2px solid #1a3a5c;
            padding-bottom: 3px;
        }
        .memo-numero {
            font-family: Arial, sans-serif;
            font-size: 11pt;
            font-weight: bold;
            color: #1a3a5c;
            text-align: center;
            margin-bottom: 12px;
        }

        /* Fecha */
        .memo-fecha {
            font-family: Arial, sans-serif;
            font-size: 10.5pt;
            color: #333;
            margin-bottom: 14px;
        }

        /* Tabla DE / A / REF */
        .memo-campos-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 0;
        }
        .memo-campos-table td {
            padding: 3px 4px;
            vertical-align: top;
            font-family: Arial, sans-serif;
            font-size: 10.5pt;
        }
        .memo-campos-table .lbl {
            font-weight: bold;
            color: #1a3a5c;
            white-space: nowrap;
            width: 38px;
        }
        .memo-campos-table .sep { width: 14px; color: #555; }
        .memo-campos-table .val { color: #111; }
        .memo-campos-table .val strong { font-size: 11pt; }
        .memo-ref-row td {
            border-bottom: 1.5px solid #1a3a5c;
            padding-bottom: 6px;
        }
        .memo-section-line {
            border: none;
            border-top: 1px solid #ccc;
            margin: 10px 0;
        }

        /* Cuerpo del mensaje */
        .memo-cuerpo {
            font-family: "Times New Roman", serif;
            font-size: 11pt;
            line-height: 1.65;
            text-align: justify;
            color: #111;
            margin-bottom: 6px;
        }
        .memo-motivo {
            font-family: "Times New Roman", serif;
            font-size: 10.5pt;
            color: #444;
            font-style: italic;
            margin-bottom: 14px;
            padding-left: 4px;
        }

        /* Tabla de activos */
        .memo-tabla {
            width: 100%;
            border-collapse: collapse;
            margin: 10px 0 2px;
            font-family: Arial, sans-serif;
            font-size: 9.5pt;
        }
        .memo-tabla thead tr { background: #1a3a5c; color: #fff; }
        .memo-tabla th {
            padding: 5px 7px;
            text-align: center;
            font-weight: bold;
            font-size: 8.5pt;
            line-height: 1.25;
            border: 1px solid #1a3a5c;
            letter-spacing: .02em;
        }
        .memo-tabla tbody tr:nth-child(even) { background: #f0f4f8; }
        .memo-tabla tbody tr:nth-child(odd)  { background: #fff; }
        .memo-tabla td {
            padding: 4px 7px;
            text-align: center;
            border: 1px solid #bfc9d4;
            color: #111;
        }
        .memo-tabla td.td-left  { text-align: left; }
        .memo-tabla td.td-right { text-align: right; }
        .memo-tabla td.td-mono  { font-family: "Courier New", monospace; font-size: 9pt; }

        /* Fila de total */
        .memo-total-row {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 8px;
            margin-top: 4px;
            margin-bottom: 10px;
            font-family: Arial, sans-serif;
        }
        .memo-total-row .total-label {
            font-weight: bold;
            font-size: 10.5pt;
            color: #1a3a5c;
            text-decoration: underline;
        }
        .memo-total-row .total-val {
            font-weight: bold;
            font-size: 10.5pt;
            color: #111;
            min-width: 90px;
            text-align: right;
        }

        /* Cierre y firma */
        .memo-atte {
            font-family: "Times New Roman", serif;
            font-size: 11pt;
            margin-top: 18px;
            margin-bottom: 48px;
            color: #111;
        }
        .memo-firma-area { display: inline-block; text-align: center; }
        .memo-firma-img {
            display: block;
            max-height: 68px;
            max-width: 210px;
            margin: 0 auto 0;
            object-fit: contain;
        }
        .memo-firma-linea {
            border-top: 1.5px solid #1a3a5c;
            width: 210px;
            margin: 0 auto 5px;
        }
        .memo-firma-nombre {
            font-family: Arial, sans-serif;
            font-weight: bold;
            font-size: 10.5pt;
            color: #1a3a5c;
            text-transform: uppercase;
        }
        .memo-firma-cargo {
            font-family: Arial, sans-serif;
            font-size: 9.5pt;
            color: #555;
        }

        /* Pie de pagina */
        .memo-footer {
            position: absolute;
            bottom: 10mm;
            left: 20mm;
            right: 20mm;
            border-top: 1px solid #ccc;
            padding-top: 4px;
            display: flex;
            justify-content: space-between;
            font-family: Arial, sans-serif;
            font-size: 7.5pt;
            color: #888;
        }

        @@media print {
            body       { background: #fff; }
            .toolbar   { display: none !important; }
            .page-wrap { padding: 0; }
            .memo-page {
                margin: 0; box-shadow: none;
                width: 210mm; min-height: 297mm;
                padding: 14mm 18mm 22mm 18mm;
            }
            @@page { size: A4 portrait; margin: 0; }
        }

        @@media (max-width: 600px) {
            body         { background: #fff; }
            .toolbar     { flex-wrap: wrap; gap: 8px; position: relative; }
            .tl-title    { display: none; }
            .page-wrap   { padding: 0; }
            .memo-page   { width: 100%; padding: 12px 14px 18px; box-shadow: none; }
            .corp-header { flex-direction: column; text-align: center; }
            .memo-firma-linea { width: 160px; }
        }
    </style>
</head>
<body>

<div class="toolbar no-print">
    <button class="btn-tool btn-back"  onclick="history.back()">&#8592; Volver</button>
    <button class="btn-tool btn-print" onclick="window.print()">&#128438; Imprimir / PDF</button>
    <span class="tl-title">Memorando N.&#176; @Model.NumeroMemo</span>
</div>

<div class="page-wrap">
<div class="memo-page">

    @if (tieneEmpresa)
    {
        <div class="corp-header">
            @if (!string.IsNullOrWhiteSpace(Model.EmpresaLogoPath))
            {
                <img class="corp-logo" src="/@Model.EmpresaLogoPath.TrimStart('/')" alt="@Model.EmpresaNombre" />
            }
            <div class="corp-info">
                <div class="corp-nombre">@Model.EmpresaNombre</div>
                <div class="corp-detalle">
                    @if (!string.IsNullOrWhiteSpace(Model.EmpresaDireccion)) { <span>@Model.EmpresaDireccion</span> }
                    @if (!string.IsNullOrWhiteSpace(Model.EmpresaTelefono))  { <span>&nbsp;&#183;&nbsp;Tel. @Model.EmpresaTelefono</span> }
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.EmpresaRuc))
                {
                    <div class="corp-ruc">RUC: @Model.EmpresaRuc</div>
                }
            </div>
        </div>
    }

    <div class="memo-titulo-wrap">
        <span class="memo-titulo">MEMORANDO INTERNO</span>
    </div>
    <div class="memo-numero">N.&#176; @Model.NumeroMemo</div>

    <div class="memo-fecha">
        @Model.Ciudad, @fechaLarga
    </div>

    <table class="memo-campos-table">
        <tr>
            <td class="lbl">DE</td>
            <td class="sep">:</td>
            <td class="val">@Model.De</td>
        </tr>
        <tr>
            <td class="lbl">A</td>
            <td class="sep">:</td>
            <td class="val">
                <strong>@Model.Para</strong>
                @if (!string.IsNullOrWhiteSpace(Model.CargoDestino))
                {
                    <br /><span style="font-size:10pt;color:#444;">@Model.CargoDestino</span>
                }
            </td>
        </tr>
        <tr class="memo-ref-row">
            <td class="lbl">REF</td>
            <td class="sep">:</td>
            <td class="val">@Model.Referencia</td>
        </tr>
    </table>

    <hr class="memo-section-line" />

    @if (!string.IsNullOrWhiteSpace(Model.CuerpoTexto))
    {
        <div class="memo-cuerpo">@Model.CuerpoTexto</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.MotivoEntre))
    {
        <div class="memo-motivo">(@Model.MotivoEntre)</div>
    }

    @if (Model.Items.Count > 0)
    {
        <table class="memo-tabla">
            <thead>
                <tr>
                    <th style="width:80px;">CODIGO</th>
                    <th style="width:90px;">FECHA DE<br />INGRESO</th>
                    <th>DESCRIPCION</th>
                    <th style="width:80px;">ANOS DE<br />ANTIGUEDAD</th>
                    <th style="width:100px;">PRECIO<br />REFERENCIAL S/</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="td-mono">@item.Codigo</td>
                        <td>@(item.FIngreso.HasValue ? item.FIngreso.Value.ToString("dd/MM/yyyy") : "&#8212;")</td>
                        <td class="td-left">@(item.Descripcion?.ToUpperInvariant() ?? "&#8212;")</td>
                        <td>@item.AniosAnt</td>
                        <td class="td-right">@item.PrecioRef.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="memo-total-row">
            <span class="total-label">TOTAL</span>
            <span class="total-val">S/ @Model.Total.ToString("N2")</span>
        </div>
    }

    <div class="memo-atte">Atentamente,</div>

    @{
        bool tieneFirma    = Model.FirmaEmisor != null;
        bool tieneImgFirma = tieneFirma
            && Model.FirmaEmisor!.Firma != null
            && Model.FirmaEmisor.Firma.Length > 0;
        string? mimeF = null;
        string? b64F  = null;
        if (tieneImgFirma)
        {
            mimeF = FabricaHilos.Services.Contabilidad.ActivoFijoService.DetectImageMimeType(Model.FirmaEmisor!.Firma!) ?? "image/png";
            b64F  = Convert.ToBase64String(Model.FirmaEmisor!.Firma!);
        }
    }
    <div class="memo-firma-area">
        @if (tieneImgFirma)
        {
            <img class="memo-firma-img" src="data:@mimeF;base64,@b64F" alt="Firma digital" />
        }
        <div class="memo-firma-linea"></div>
        @if (tieneFirma)
        {
            <div class="memo-firma-nombre">@Model.FirmaEmisor!.NombreCompleto</div>
            <div class="memo-firma-cargo">@Model.FirmaEmisor.Cargo</div>
        }
        else
        {
            <div class="memo-firma-nombre" style="color:#888;">____________________________</div>
            <div class="memo-firma-cargo" style="color:#aaa;">Firma y sello</div>
        }
    </div>

    <div class="memo-footer">
        <span>Documento generado por el Sistema Web &#8212; @Model.Fecha.ToString("dd/MM/yyyy HH:mm")</span>
        <span>Memorando N.&#176; @Model.NumeroMemo</span>
    </div>

</div><!-- /.memo-page -->
</div><!-- /.page-wrap -->

</body>
</html>
