    function mostrarErrorConReintentar(error, jobId, periodo, tipo) {
        const estadoDiv = document.getElementById('estadoExportacion');
        estadoDiv.innerHTML = `<div class="text-center">
            <div class="mb-2"><i class="bi bi-exclamation-circle fs-1 text-danger"></i></div>
            <p class="fw-semibold text-danger">Error transitorio (SUNAT 504)</p>
            <small class="text-muted d-block mb-3">${error}</small>
            <div class="d-flex gap-2 justify-content-center">
                <button class="btn btn-sm btn-warning" onclick="reintentarJob('${jobId}','${periodo}','${tipo}')">
                    <i class="bi bi-arrow-clockwise me-1"></i>Reintentar polling
                </button>
                <button class="btn btn-sm btn-danger" onclick="cancelarJob('${jobId}','${periodo}','${tipo}')">
                    <i class="bi bi-x-circle me-1"></i>Cancelar y reiniciar
                </button>
                <button class="btn btn-sm btn-outline-secondary" onclick="cancelarJobSolo('${jobId}')">
                    <i class="bi bi-x me-1"></i>Solo cancelar
                </button>
            </div></div>`;
        cargarLogsJob(jobId);
    }

    async function cancelarJob(jobId, periodo, tipo) {
        confirmarAccion(
            '¿Cancelar este proceso? Podrá iniciar una nueva exportación para el mismo período.',
            async () => {
                // Detener el poll activo inmediatamente
                _pollingJobId = null;

                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : '';
                try {
                    const resp = await fetch('@Url.Action("CancelarJob", "Sire")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                        body: JSON.stringify(jobId)
                    });
                    const data = await resp.json();
                    if (data.exitoso) {
                        sessionStorage.removeItem('sireJobId');
                        bootstrap.Modal.getInstance(document.getElementById('modalExportacion'))?.hide();
                        setTimeout(() => iniciarExportacion(periodo, tipo), 400);
                    } else {
                        mostrarErrorExportacion(data.error || 'No se pudo cancelar.');
                    }
                } catch (e) { mostrarErrorExportacion('Error al cancelar: ' + e.message); }
            }
        );
    }

    // Cancela el job sin iniciar una nueva exportación
    async function cancelarJobSolo(jobId) {
        confirmarAccion(
            '¿Cancelar este proceso? No se iniciará una nueva exportación automáticamente.',
            async () => {
                _pollingJobId = null;
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : '';
                try {
                    const resp = await fetch('@Url.Action("CancelarJob", "Sire")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                        body: JSON.stringify(jobId)
                    });
                    const data = await resp.json();
                    if (data.exitoso) {
                        sessionStorage.removeItem('sireJobId');
                        bootstrap.Modal.getInstance(document.getElementById('modalExportacion'))?.hide();
                    } else {
                        mostrarErrorExportacion(data.error || 'No se pudo cancelar.');
                    }
                } catch (e) { mostrarErrorExportacion('Error al cancelar: ' + e.message); }
            }
        );
    }

    async function reintentarJob(jobId, periodo, tipo) {
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : '';
        try {
            const response = await fetch('@Url.Action("ReintentarJob", "Sire")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(jobId)
            });
            const result = await response.json();
            if (!result.exitoso) { mostrarErrorExportacion(result.error || 'No se pudo reencolar.'); return; }
            actualizarModalExportacion('EnProceso', `Job reencolado. ${result.mensaje}`, jobId, 0);
            consultarEstadoJob(jobId, periodo, tipo);
        } catch (error) { mostrarErrorExportacion('Error al reintentar: ' + error.message); }
    }

    async function descargarArchivoExportado(periodo, tipo) {
        const ruc = '@(Model?.Ruc ?? "")';
        const codLibro = tipo === 'ventas' ? '140000' : '080000';
        const nomArchivo = `PP${ruc}${periodo}${codLibro}001111110.ZIP`;
        window.location.href = `@Url.Action("DescargarArchivoExportado", "Sire")?periodo=${encodeURIComponent(periodo)}&tipo=${encodeURIComponent(tipo)}&nomArchivo=${encodeURIComponent(nomArchivo)}`;
    }

    // ── Overlay global helpers ───────────────────────────────────────────────────
    function mostrarOverlayGlobal(mensaje, subMensaje) {
        // No mostrar si ya hay otro overlay activo (evita superposición)
        const ovCorreo = document.getElementById('sireOverlayCorreo');
        if (ovCorreo && ovCorreo.style.display === 'flex') return;
        const ov  = document.getElementById('sireOverlayGlobal');
        // No interferir si el overlay ya está en modo validacion (btnValidarSunat)
        if (ov && ov.dataset.modo === 'validacion') return;
        const msg = document.getElementById('sireOverlayMensaje');
        const sub = document.getElementById('sireOverlaySubMensaje');
        if (msg) msg.textContent = mensaje || 'Procesando...';
        if (sub) sub.textContent = subMensaje || '';
        if (ov)  ov.style.display = 'flex';
    }
    function ocultarOverlayGlobal() {
        const ov = document.getElementById('sireOverlayGlobal');
        if (ov) ov.style.display = 'none';
    }


    function sireOrdenarColumna(th) {
        const dir = th.dataset.sortDir === 'asc' ? 'desc' : 'asc';
        th.closest('table').querySelectorAll('th[data-sort-type]').forEach(t => {
            t.dataset.sortDir = '';
            const ic = t.querySelector('.sire-sort-icon');
            if (ic) { ic.textContent = '\u2195'; ic.style.opacity = '.5'; }
        });
        th.dataset.sortDir = dir;
        const ic = th.querySelector('.sire-sort-icon');
        if (ic) { ic.textContent = dir === 'asc' ? '\u2191' : '\u2193'; ic.style.opacity = '1'; }
        sireOrdenarColumnaAplicar(th);
    }

    // Aplica el ordenamiento del th activo sin cambiar la dirección (para re-aplicar al filtrar)
    function sireOrdenarColumnaAplicar(th) {
        const table = th.closest('table');
        const tbody = table.querySelector('tbody');
        if (!tbody) return;
        const idx  = Array.from(th.closest('tr').children).indexOf(th);
        const tipo = th.dataset.sortType || 'text';
        const dir  = th.dataset.sortDir || 'asc';
        function parseFecha(v) {
            const p = (v || '').trim().split('/');
            return p.length === 3 ? new Date(+p[2], +p[1] - 1, +p[0]).getTime() : 0;
        }
        const rows = Array.from(tbody.rows);
        rows.sort((a, b) => {
            const av = (a.cells[idx]?.textContent ?? '').trim();
            const bv = (b.cells[idx]?.textContent ?? '').trim();
            const cmp = tipo === 'date'
                ? parseFecha(av) - parseFecha(bv)
                : av.localeCompare(bv, 'es', { sensitivity: 'base' });
            return dir === 'asc' ? cmp : -cmp;
        });
        rows.forEach(r => tbody.appendChild(r));
    }
</script>
