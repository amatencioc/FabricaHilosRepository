    }
    .filter-hint .badge-ref { background:#1565C0; color:#fff; }
    .filter-hint .badge-cmp { background:#1B4D3E; color:#fff; }
    .cuadro-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 10px rgba(0,0,0,.08);
        background: #fff;
