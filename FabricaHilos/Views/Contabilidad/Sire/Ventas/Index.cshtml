            <div class="mb-3"><i class="bi bi-exclamation-circle fs-1" style="color:#e74c3c;"></i></div>
            <p class="fw-semibold text-danger">Error en la exportación</p>
            <small class="text-muted">${error}</small></div>`;
        document.getElementById('btnDescargarZip').style.display = 'none';
    }

