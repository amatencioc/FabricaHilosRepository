@{
    ViewData["Title"] = "Reporte de Reclamos";
}

@section Styles {
<link rel="stylesheet" href="~/css/sire.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/reclamos.css" asp-append-version="true" />
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Ventas" asp-action="Index">Ventas</a></li>
    <li class="breadcrumb-item active">Reporte de Reclamos</li>
}

<div class="sire-page-header">
    <div class="sire-page-icon reclamos"><i class="bi bi-exclamation-triangle"></i></div>
    <div>
        <h1 class="sire-page-title">Reporte de Reclamos</h1>
        <div class="sire-page-sub">Indicadores de gestión de reclamos — Gerencia de Ventas</div>
    </div>
</div>

<!-- ── Filtros ──────────────────────────────────────────── -->
<div class="sire-filter">
    <div>
        <label class="form-label mb-1 small fw-semibold">Fecha Inicio</label>
        <input type="date" id="fechaInicio" class="form-control form-control-sm" style="min-width:140px" onchange="sincronizarLimitesFecha()">
    </div>
    <div>
        <label class="form-label mb-1 small fw-semibold">Fecha Fin</label>
        <input type="date" id="fechaFin" class="form-control form-control-sm" style="min-width:140px" onchange="sincronizarLimitesFecha()">
    </div>
    <div>
        <label class="form-label mb-1 small fw-semibold">Cliente</label>
        <select id="cliente" class="form-select form-select-sm" style="min-width:200px">
            <option value="">Todos</option>
        </select>
    </div>
    <div>
        <label class="form-label mb-1 small fw-semibold">Asesor</label>
        <select id="vendedor" class="form-select form-select-sm" style="min-width:200px">
            <option value="">Todos</option>
        </select>
    </div>
    <div>
        <label class="form-label mb-1 small fw-semibold">Estado</label>
        <select id="estado" class="form-select form-select-sm" style="min-width:150px">
            <option value="">Todos</option>
        </select>
    </div>
    <button id="btnActualizar" class="btn btn-sm btn-success" onclick="loadAll()">
        <i class="bi bi-arrow-clockwise me-1"></i>Actualizar
    </button>
    <button class="btn btn-sm btn-outline-secondary" onclick="clearFilters()">
        <i class="bi bi-x-circle me-1"></i>Limpiar
    </button>
    <div id="filtrosError" class="text-danger small w-100 d-none"></div>
</div>

<!-- ── KPI Resumen ──────────────────────────────────────── -->
<div class="rec-kpi-grid" id="kpiRow">
    <div class="sire-kpi-card rec-total">
        <div class="sire-kpi-card-icon rec-total"><i class="bi bi-exclamation-triangle"></i></div>
        <div>
            <div class="sire-kpi-card-label">N° Reclamos</div>
            <div class="sire-kpi-card-value" id="kpiTotal">-</div>
        </div>
    </div>
    <div class="sire-kpi-card rec-kg">
        <div class="sire-kpi-card-icon rec-kg"><i class="bi bi-box-seam"></i></div>
        <div>
            <div class="sire-kpi-card-label">KG Reclamados</div>
            <div class="sire-kpi-card-value" id="kpiKg">-</div>
        </div>
    </div>
    <div class="sire-kpi-card rec-lead">
        <div class="sire-kpi-card-icon rec-lead"><i class="bi bi-clock-history"></i></div>
        <div>
            <div class="sire-kpi-card-label">Lead Time Prom.</div>
            <div class="sire-kpi-card-value" id="kpiLead">-</div>
        </div>
    </div>
    <div class="sire-kpi-card rec-pct">
        <div class="sire-kpi-card-icon rec-pct"><i class="bi bi-percent"></i></div>
        <div>
            <div class="sire-kpi-card-label">% Reclamos</div>
            <div class="sire-kpi-card-value" id="kpiPctReclamos">-</div>
        </div>
    </div>
    <div class="sire-kpi-card rec-repo">
        <div class="sire-kpi-card-icon rec-repo"><i class="bi bi-arrow-repeat"></i></div>
        <div>
            <div class="sire-kpi-card-label">% Reposición</div>
            <div class="sire-kpi-card-value" id="kpiRepo">-</div>
        </div>
    </div>
    <div class="sire-kpi-card rec-repro">
        <div class="sire-kpi-card-icon rec-repro"><i class="bi bi-gear"></i></div>
        <div>
            <div class="sire-kpi-card-label">% Reproceso</div>
            <div class="sire-kpi-card-value" id="kpiRepro">-</div>
        </div>
    </div>
    <div class="sire-kpi-card rec-pend">
        <div class="sire-kpi-card-icon rec-pend"><i class="bi bi-hourglass-split"></i></div>
        <div>
            <div class="sire-kpi-card-label">Pendientes</div>
            <div class="sire-kpi-card-value" id="kpiPendientes">-</div>
        </div>
    </div>
</div>

<!-- ── Gráficos: uno por fila, ancho completo ──────────────
     Tipo de gráfico elegido según naturaleza del dato:
       - Evolución en el tiempo        → línea
       - Distribución % por categoría  → barras horizontales (mejor legibilidad de etiquetas largas)
       - Ranking / ordenamiento        → barras horizontales
--------------------------------------------------------- -->
<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="sire-card rec-chart-card">
            <div class="sire-card-header reclamos-header"><i class="bi bi-graph-up"></i> Reclamos por Mes</div>
            <div class="sire-card-body"><div id="chartMeses"></div></div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="sire-card rec-chart-card">
            <div class="sire-card-header reclamos-header"><i class="bi bi-bar-chart-line"></i> Motivo de Reclamos (%)
                <i class="bi bi-info-circle ms-1" style="font-size:.8rem;cursor:help" title="Cantidad = N° de reclamos únicos (no de ítems/lotes). Un mismo reclamo con varios ítems del mismo motivo se cuenta 1 sola vez (si tiene ítems con motivos distintos, aporta a cada motivo)." data-bs-toggle="tooltip"></i>
            </div>
            <div class="sire-card-body">
                <div id="motivoResumen" class="rec-motivo-legend"></div>
                <div id="chartMotivos"></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="sire-card rec-chart-card">
            <div class="sire-card-header reclamos-header"><i class="bi bi-diagram-3"></i> Reclamos por Familia
                <i class="bi bi-info-circle ms-1" style="font-size:.8rem;cursor:help" title="Cantidad = N° de reclamos únicos (no de ítems/lotes). Un mismo reclamo con varios ítems de la misma familia se cuenta 1 sola vez." data-bs-toggle="tooltip"></i>
            </div>
            <div class="sire-card-body"><div id="chartFamilia"></div></div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="sire-card rec-chart-card">
            <div class="sire-card-header reclamos-header"><i class="bi bi-building"></i> Kilogramos Reclamados por Cliente
                <i class="bi bi-info-circle ms-1" style="font-size:.8rem;cursor:help" title="KG Reclamados = suma de kg a nivel de ítem/lote (todos los ítems del reclamo suman su peso real)." data-bs-toggle="tooltip"></i>
            </div>
            <div class="sire-card-body"><div id="chartClientesKg"></div></div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="sire-card rec-chart-card">
            <div class="sire-card-header reclamos-header"><i class="bi bi-building"></i> Cantidad de Reclamos por Cliente
                <i class="bi bi-info-circle ms-1" style="font-size:.8rem;cursor:help" title="Cantidad = N° de reclamos únicos (no de ítems/lotes). Un mismo reclamo con varios ítems del mismo cliente se cuenta 1 sola vez." data-bs-toggle="tooltip"></i>
            </div>
            <div class="sire-card-body"><div id="chartClientesCantidad"></div></div>
        </div>
    </div>
</div>

<!-- ── Grilla de detalle ────────────────────────────────── -->
<div class="sire-card">
    <div class="sire-card-header reclamos-header"><i class="bi bi-list-ul"></i> Listado de Reclamos</div>
    <div class="sire-card-body">
        <div class="table-responsive rec-tabla-scroll">
            <table class="table table-sm table-hover align-middle sire-table" id="tablaReclamos">
                <thead>
                    <tr>
                        <th>N°</th>
                        <th>N° Rec</th>
                        <th>Fecha</th>
                        <th>Cliente</th>
                        <th>Asesor</th>
                        <th>Artículo</th>
                        <th>Cantidad</th>
                        <th>Motivo</th>
                        <th>Procede</th>
                        <th>Atención Cliente</th>
                        <th>Decisión</th>
                        <th>Lead Time</th>
                    </tr>
                </thead>
                <tbody id="tablaReclamosBody"></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
<script>
    const urls = {
        porMes: '@Url.Action("DatosPorMes", "ReporteReclamos")',
        porFamilia: '@Url.Action("DatosPorFamilia", "ReporteReclamos")',
        porCliente: '@Url.Action("DatosPorCliente", "ReporteReclamos")',
        indicadores: '@Url.Action("DatosIndicadores", "ReporteReclamos")',
        motivos: '@Url.Action("DatosMotivos", "ReporteReclamos")',
        listado: '@Url.Action("DatosListado", "ReporteReclamos")',
        combo: '@Url.Action("DatosParametrosCombo", "ReporteReclamos")'
    };

    let chartMeses, chartMotivos, chartFamilia, chartClientesKg, chartClientesCantidad;

    // Fecha por defecto del filtro: 1-Ene del año en curso hasta hoy.
    function primerDiaAnioActual() {
        return `${new Date().getFullYear()}-01-01`;
    }

    function getFiltros() {
        return {
            fechaInicio: document.getElementById('fechaInicio').value || null,
            fechaFin: document.getElementById('fechaFin').value || null,
            cliente: document.getElementById('cliente').value || null,
            vendedor: document.getElementById('vendedor').value || null,
            estado: document.getElementById('estado').value || null
        };
    }

    function validarRangoFechas() {
        const errEl = document.getElementById('filtrosError');
        const f = getFiltros();
        if (f.fechaInicio && f.fechaFin && f.fechaInicio > f.fechaFin) {
            errEl.textContent = 'La Fecha Inicio no puede ser mayor que la Fecha Fin.';
            errEl.classList.remove('d-none');
            return false;
        }
        errEl.classList.add('d-none');
        errEl.textContent = '';
        return true;
    }

    function sincronizarLimitesFecha() {
        const ini = document.getElementById('fechaInicio');
        const fin = document.getElementById('fechaFin');
        if (ini.value) fin.min = ini.value;
        if (fin.value) ini.max = fin.value;
        validarRangoFechas();
    }

    function buildQuery(params) {
        const qs = new URLSearchParams();
        Object.entries(params).forEach(([k, v]) => { if (v) qs.append(k, v); });
        return qs.toString();
    }

    async function cargarCombos() {
        // v1.7: CLIENTE/VENDEDOR se acotan al mismo rango de fechas del
        // Listado (antes mostraban TODA la historia, sin relación con el
        // periodo activo — el combo Asesor llegó a ofrecer 21 nombres
        // cuando el Listado del año en curso solo tenía 4 reclamos reales).
        const f = getFiltros();
        const tipos = [
            { tipo: 'CLIENTE', select: 'cliente', porFecha: true },
            { tipo: 'VENDEDOR', select: 'vendedor', porFecha: true },
            { tipo: 'ESTADO', select: 'estado', porFecha: false }
        ];
        for (const t of tipos) {
            try {
                const query = t.porFecha
                    ? buildQuery({ tipo: t.tipo, fechaInicio: f.fechaInicio, fechaFin: f.fechaFin })
                    : buildQuery({ tipo: t.tipo });
                const res = await fetch(`${urls.combo}?${query}`);
                const data = await res.json();
                const select = document.getElementById(t.select);
                const valorPrevio = select.value;
                // Conserva solo la opción estática "Todos" y reconstruye el resto.
                select.querySelectorAll('option:not([value=""])').forEach(o => o.remove());
                data.forEach(item => {
                    const opt = document.createElement('option');
                    opt.value = item.codigo;
                    opt.textContent = item.descripcion;
                    select.appendChild(opt);
                });
                // Si la selección previa ya no existe en el nuevo rango, vuelve a "Todos".
                select.value = valorPrevio;
                if (select.value !== valorPrevio) select.value = '';
            } catch (e) {
                console.error('Error cargando combo', t.tipo, e);
            }
        }
    }

    async function cargarIndicadores() {
        const f = getFiltros();
        const res = await fetch(`${urls.indicadores}?${buildQuery(f)}`);
        if (!res.ok) throw new Error(`Error ${res.status} al obtener indicadores`);
        const d = await res.json();
        document.getElementById('kpiTotal').textContent = (d.totalReclamos ?? 0).toLocaleString('es-PE');
        document.getElementById('kpiKg').textContent = (d.totalKgReclamados ?? 0).toLocaleString('es-PE', { maximumFractionDigits: 1 });
        document.getElementById('kpiLead').textContent = `${d.leadTimePromedio ?? 0} días`;
        // pctReclamos: % Reclamos = KG Reclamados / KG Vendidos del año (vía
        // PKG_NO_FACTURADO, calculado 100% en la BD — v1.9). Solo queda null en
        // el caso extremo de que ese paquete no tenga ventas para el año.
        const pctEl = document.getElementById('kpiPctReclamos');
        pctEl.textContent = (d.pctReclamos === null || d.pctReclamos === undefined) ? '—' : `${d.pctReclamos.toFixed(2)}%`;
        document.getElementById('kpiRepo').textContent = `${(d.pctReposicion ?? 0).toFixed(2)}%`;
        document.getElementById('kpiRepro').textContent = `${(d.pctReproceso ?? 0).toFixed(2)}%`;
        document.getElementById('kpiPendientes').textContent = (d.reclamosPendientes ?? 0).toLocaleString('es-PE');
    }

    async function cargarChartMeses() {
        const f = getFiltros();
        const res = await fetch(`${urls.porMes}?${buildQuery(f)}`);
        const data = await res.json();
        const options = {
            // fontFamily explícito: 'inherit' hereda la fuente de íconos (bi bi-graph-up) del
            // encabezado de la tarjeta y hace que los dataLabels numéricos se rendericen con
            // glifos de ícono en vez de dígitos.
            chart: { type: 'line', height: 280, toolbar: { show: false }, fontFamily: 'Segoe UI, Arial, sans-serif', parentHeightOffset: 0 },
            series: [{ name: 'Reclamos', data: data.map(x => x.cantidad) }],
            xaxis: { categories: data.map(x => x.periodo), labels: { style: { fontSize: '11px' } } },
            yaxis: { labels: { style: { fontSize: '11px' } } },
            colors: ['#1B4D3E'],
            stroke: { curve: 'smooth', width: 3 },
            markers: { size: 4 },
            grid: { padding: { left: 8, right: 8, top: 20 } },
            // Imprime el valor de cada punto (antes solo visible en el tooltip al pasar el mouse).
            // background: deshabilitado para que no se dibuje el recuadro/borde blanco que
            // ApexCharts pone por defecto detrás de cada dataLabel (tapaba el número).
            dataLabels: {
                enabled: true,
                offsetY: -10,
                style: { fontSize: '11px', fontWeight: 700, fontFamily: 'Segoe UI, Arial, sans-serif', colors: ['#1B4D3E'] },
                background: { enabled: false }
            }
        };
        if (chartMeses) chartMeses.destroy();
        chartMeses = new ApexCharts(document.querySelector('#chartMeses'), options);
        chartMeses.render();
    }

    // Colores por categoría (motivo_reclamo) — mismo criterio visual del mockup:
    // PDTE DEF = rojo, PRODUCCIÓN = morado, VENTAS = naranja.
    const COLOR_CATEGORIA = {
        'PDTE DEF': '#e53935',
        'PRODUCCIÓN': '#8e24aa',
        'VENTAS': '#fb8c00'
    };
    const colorCategoria = (motivo) => COLOR_CATEGORIA[motivo] || '#78909c';

    async function cargarChartMotivos() {
        const f = getFiltros();
        const res = await fetch(`${urls.motivos}?${buildQuery(f)}`);
        const data = await res.json();

        // Cajita resumen de % por categoría (símil mockup: 68% PRODUCCIÓN, 24% VENTAS, 12% PDTE DEF).
        // Cada motivo individual trae su categoría (motivo) — se agrupan y suman antes de mostrar.
        const totalesPorCategoria = {};
        data.forEach(x => {
            totalesPorCategoria[x.motivo] = (totalesPorCategoria[x.motivo] || 0) + x.cantidad;
        });
        const totalGeneral = data.reduce((acc, x) => acc + x.cantidad, 0);
        const resumenEl = document.getElementById('motivoResumen');
        resumenEl.innerHTML = Object.entries(totalesPorCategoria)
            .sort((a, b) => b[1] - a[1])
            .map(([motivo, cant]) => {
                const pct = totalGeneral ? Math.round((cant / totalGeneral) * 100) : 0;
                return `<span class="rec-motivo-pill" style="background:${colorCategoria(motivo)}">` +
                       `<span class="rec-motivo-pct">${pct}%</span> ${motivo} (${cant})</span>`;
            })
            .join('');

        // Barras horizontales: una fila por motivo individual (PROBLEMA), coloreada según
        // su categoría (motivo_reclamo) — con 20+ motivos distintos, horizontal evita
        // etiquetas rotadas/ilegibles y permite leer el texto completo de cada motivo.
        const alturaChart = Math.max(420, data.length * 26 + 90);
        const options = {
            chart: { type: 'bar', height: alturaChart, toolbar: { show: false }, fontFamily: 'Segoe UI, Arial, sans-serif', parentHeightOffset: 0 },
            series: [{ name: 'Cantidad', data: data.map(x => x.cantidad) }],
            xaxis: {
                categories: data.map(x => x.problema),
                // max con margen (+25%): reserva espacio en blanco a la derecha de cada
                // barra para que el dataLabel se dibuje fuera de ella. Sin este margen,
                // las barras más largas llenan casi todo el ancho del gráfico y ApexCharts
                // empuja la etiqueta hacia adentro, quedando el texto oscuro sobre el color
                // saturado de la barra (ilegible).
                // Redondeado a entero + tickAmount: si max queda con decimales (ej. 8.75),
                // ApexCharts reparte ~10 ticks entre 0 y 8.75 sin forzar enteros, duplicando
                // etiquetas del eje (0 0 1 1 2 2...). Con max entero y tickAmount = max se
                // genera 1 tick por unidad, sin repeticiones.
                max: (function () { const m = Math.max(...data.map(x => x.cantidad)); return Math.max(1, Math.ceil(m * 1.25)); })(),
                tickAmount: (function () { const m = Math.max(...data.map(x => x.cantidad)); return Math.max(1, Math.ceil(m * 1.25)); })(),
                labels: { style: { fontSize: '11px' } }
            },
            yaxis: {
                labels: {
                    style: {
                        fontSize: '11px',
                        colors: data.map(x => colorCategoria(x.motivo))
                    },
                    maxWidth: 340
                }
            },
            plotOptions: {
                bar: {
                    horizontal: true,
                    distributed: true,
                    barHeight: '70%',
                    borderRadius: 3,
                    dataLabels: { position: 'top' }
                }
            },
            colors: data.map(x => colorCategoria(x.motivo)),
            legend: { show: false },
            dataLabels: {
                enabled: true,
                offsetX: 6,
                style: { fontSize: '10px', fontWeight: 700, colors: ['#212121'] },
                background: { enabled: false },
                formatter: (val, opts) => `${val} (${data[opts.dataPointIndex].porcentaje.toFixed(2)}%)`
            },
            tooltip: {
                y: { formatter: (val, opts) => `${val} reclamo(s) — ${data[opts.dataPointIndex].porcentaje.toFixed(2)}% del total` },
                x: { formatter: (val, opts) => `${data[opts.dataPointIndex].problema}  [${data[opts.dataPointIndex].motivo}]` }
            },
            grid: { padding: { left: 8, right: 24, top: 10 } }
        };
        if (chartMotivos) chartMotivos.destroy();
        chartMotivos = new ApexCharts(document.querySelector('#chartMotivos'), options);
        chartMotivos.render();
    }

    // Barras horizontales: nombres de familia/fibra largos (ej. "MEZCLA BLANCO TANGUIS
    // POLYESTER") se leen mejor así que en columnas verticales angostas y rotadas.
    async function cargarChartFamilia() {
        const f = getFiltros();
        const res = await fetch(`${urls.porFamilia}?${buildQuery(f)}`);
        const data = await res.json();
        const altura = Math.max(320, data.length * 28 + 40);
        const options = {
            chart: { type: 'bar', height: altura, toolbar: { show: false }, fontFamily: 'Segoe UI, Arial, sans-serif', parentHeightOffset: 0 },
            series: [{ name: 'Cantidad', data: data.map(x => x.cantidad) }],
            xaxis: {
                categories: data.map(x => x.codFamilia),
                // Margen del 25% redondeado a entero + tickAmount (ver nota en cargarChartMotivos)
                // para que el eje no repita valores (0 0 1 1 2 2...).
                max: (function () { const m = Math.max(...data.map(x => x.cantidad)); return Math.max(1, Math.ceil(m * 1.25)); })(),
                tickAmount: (function () { const m = Math.max(...data.map(x => x.cantidad)); return Math.max(1, Math.ceil(m * 1.25)); })(),
                labels: { style: { fontSize: '11px' } }
            },
            yaxis: { labels: { style: { fontSize: '11px' }, maxWidth: 260 } },
            plotOptions: { bar: { horizontal: true, barHeight: '65%', borderRadius: 3, dataLabels: { position: 'top' } } },
            dataLabels: {
                enabled: true,
                offsetX: 6,
                style: { fontSize: '11px', fontWeight: 700, colors: ['#212121'] },
                background: { enabled: false }
            },
            grid: { padding: { left: 8, right: 30, top: 10 } },
            colors: ['#1565c0']
        };
        if (chartFamilia) chartFamilia.destroy();
        chartFamilia = new ApexCharts(document.querySelector('#chartFamilia'), options);
        chartFamilia.render();
    }

    // Barras horizontales: óptimas para ranking de clientes con nombres largos (mejor legibilidad
    // que columnas verticales, evita rotar/truncar etiquetas del eje X).
    async function cargarChartClientes() {
        const f = getFiltros();
        const res = await fetch(`${urls.porCliente}?${buildQuery(f)}`);
        const data = await res.json();

        const porKg = data.slice().sort((a, b) => b.kgReclamados - a.kgReclamados);
        const alturaKg = Math.max(280, porKg.length * 26);
        const optionsKg = {
            chart: { type: 'bar', height: alturaKg, toolbar: { show: false }, fontFamily: 'Segoe UI, Arial, sans-serif', parentHeightOffset: 0 },
            series: [{ name: 'KG Reclamados', data: porKg.map(x => x.kgReclamados) }],
            xaxis: {
                categories: porKg.map(x => x.nombreCliente),
                // Margen del 25% para reservar espacio al dataLabel fuera de la barra (ver nota
                // en cargarChartMotivos). Este eje es de KG (decimales, rango amplio), por lo
                // que NO se usa tickAmount = max (eso generaría miles de ticks superpuestos,
                // pintando una franja negra ilegible); se fija un tickAmount bajo y fijo para
                // tener pocas marcas legibles (ApexCharts las formatea automáticamente).
                // min: 0 explícito es obligatorio aquí: sin él, al combinar max con tickAmount,
                // ApexCharts calcula un mínimo negativo automático para repartir los ticks
                // simétricamente, corriendo todas las barras hacia la derecha del eje.
                min: 0,
                max: (function () { const m = Math.max(...porKg.map(x => x.kgReclamados)); return m * 1.25; })(),
                tickAmount: 8,
                labels: { style: { fontSize: '11px' }, formatter: (val) => Number(val).toLocaleString('es-PE', { maximumFractionDigits: 0 }) }
            },
            yaxis: { labels: { style: { fontSize: '11px' }, maxWidth: 320 } },
            plotOptions: { bar: { horizontal: true, barHeight: '65%', borderRadius: 3, dataLabels: { position: 'top' } } },
            dataLabels: {
                enabled: true, offsetX: 6, style: { fontSize: '11px', fontWeight: 700, colors: ['#212121'] },
                background: { enabled: false },
                formatter: (val) => val.toLocaleString('es-PE', { maximumFractionDigits: 2 })
            },
            grid: { padding: { left: 8, right: 40 } },
            colors: ['#fb8c00']
        };
        if (chartClientesKg) chartClientesKg.destroy();
        chartClientesKg = new ApexCharts(document.querySelector('#chartClientesKg'), optionsKg);
        chartClientesKg.render();

        const porCantidad = data.slice().sort((a, b) => b.cantidad - a.cantidad);
        const alturaCant = Math.max(280, porCantidad.length * 26);
        const optionsCantidad = {
            chart: { type: 'bar', height: alturaCant, toolbar: { show: false }, fontFamily: 'Segoe UI, Arial, sans-serif', parentHeightOffset: 0 },
            series: [{ name: 'Cantidad', data: porCantidad.map(x => x.cantidad) }],
            xaxis: {
                categories: porCantidad.map(x => x.nombreCliente),
                // Margen del 25% redondeado a entero + tickAmount (ver nota en cargarChartMotivos)
                // para que el eje no repita valores (0 0 1 1 2 2...).
                max: (function () { const m = Math.max(...porCantidad.map(x => x.cantidad)); return Math.max(1, Math.ceil(m * 1.25)); })(),
                tickAmount: (function () { const m = Math.max(...porCantidad.map(x => x.cantidad)); return Math.max(1, Math.ceil(m * 1.25)); })(),
                labels: { style: { fontSize: '11px' } }
            },
            yaxis: { labels: { style: { fontSize: '11px' }, maxWidth: 320 } },
            plotOptions: { bar: { horizontal: true, barHeight: '65%', borderRadius: 3, dataLabels: { position: 'top' } } },
            dataLabels: {
                enabled: true, offsetX: 6, style: { fontSize: '11px', fontWeight: 700, colors: ['#212121'] },
                background: { enabled: false },
                formatter: (val) => val.toLocaleString('es-PE')
            },
            grid: { padding: { left: 8, right: 40 } },
            colors: ['#1565c0']
        };
        if (chartClientesCantidad) chartClientesCantidad.destroy();
        chartClientesCantidad = new ApexCharts(document.querySelector('#chartClientesCantidad'), optionsCantidad);
        chartClientesCantidad.render();
    }

    async function cargarListado() {
        const f = getFiltros();
        const res = await fetch(`${urls.listado}?${buildQuery(f)}`);
        if (!res.ok) throw new Error(`Error ${res.status} al obtener listado`);
        const data = await res.json();
        const body = document.getElementById('tablaReclamosBody');
        body.innerHTML = '';
        // Un mismo N° Rec puede repetirse en varias filas (varios ítems/lotes
        // del mismo reclamo) — el correlativo N° debe contar el reclamo 1 sola vez.
        let correlativo = 0;
        let nrorecAnterior = null;
        data.forEach((r) => {
            if (r.nrorec !== nrorecAnterior) {
                correlativo++;
                nrorecAnterior = r.nrorec;
            }
            const tr = document.createElement('tr');
            const fecha = r.fecrec ? new Date(r.fecrec).toLocaleDateString('es-PE') : '';
            tr.innerHTML = `
                <td class="rec-correlativo">${correlativo}</td>
                <td>${r.nrorec}</td>
                <td>${fecha}</td>
                <td>${r.descli ?? ''}</td>
                <td>${r.desven ?? ''}</td>
                <td>${r.desart ?? ''}</td>
                <td>${(r.cantidad ?? 0).toLocaleString('es-PE')}</td>
                <td>${(r.motivo && r.motivo !== '(en blanco)') ? r.motivo : 'Por definir'}</td>
                <td>${r.procede ?? ''}</td>
                <td>${r.atencionCli ?? ''}</td>
                <td>${r.estadoDesc ?? ''}</td>
                <td>${r.leadTime ?? ''}</td>`;
            body.appendChild(tr);
        });
    }

    async function loadAll() {
        if (!validarRangoFechas()) return;
        const btn = document.getElementById('btnActualizar');
        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Cargando...';
        try {
            const resultados = await Promise.allSettled([
                cargarCombos(),
                cargarIndicadores(),
                cargarChartMeses(),
                cargarChartMotivos(),
                cargarChartFamilia(),
                cargarChartClientes(),
                cargarListado()
            ]);
            resultados
                .filter(r => r.status === 'rejected')
                .forEach(r => console.error('Error cargando datos del reporte', r.reason));
            // Los charts se crean recién al resolver los fetch de arriba (async), por lo
            // que el ancho real del contenedor (tarjeta ya con su layout final) solo se
            // conoce con certeza en este punto. window.load no sirve porque puede
            // dispararse antes de que estos fetch terminen. windowResize() fuerza a
            // ApexCharts a remedir el contenedor y evita que "Reclamos por Mes" (u otro
            // chart) quede recortado.
            [chartMeses, chartMotivos, chartFamilia, chartClientesKg, chartClientesCantidad]
                .filter(c => c)
                .forEach(c => c.windowResize());
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        }
    }

    // Setea el valor de un input de fecha respetando la instancia de flatpickr
    // (creada por flatpickr-init.js con altInput:true). Asignar `.value` directo
    // al input original NO actualiza el altInput visible al usuario.
    function setFechaInput(id, value) {
        const el = document.getElementById(id);
        if (window.fpSetDate) {
            window.fpSetDate(el, value);
        } else {
            el.value = value;
        }
    }

    function clearFilters() {
        setFechaInput('fechaInicio', primerDiaAnioActual());
        setFechaInput('fechaFin', new Date().toISOString().slice(0, 10));
        document.getElementById('cliente').value = '';
        document.getElementById('vendedor').value = '';
        document.getElementById('estado').value = '';
        sincronizarLimitesFecha();
        loadAll();
    }

    function inicializarFechasPorDefecto() {
        const fechaInicio = document.getElementById('fechaInicio');
        const fechaFin = document.getElementById('fechaFin');
        if (!fechaInicio.value) setFechaInput('fechaInicio', primerDiaAnioActual());
        if (!fechaFin.value) setFechaInput('fechaFin', new Date().toISOString().slice(0, 10));
        sincronizarLimitesFecha();
    }

    // flatpickr-init.js inicializa los inputs en DOMContentLoaded (script cargado
    // antes en el layout). Se espera un tick (setTimeout 0) para garantizar que
    // window.fpSetDate y las instancias de flatpickr ya existan antes de setear valores.
    document.addEventListener('DOMContentLoaded', () => {
        // Tooltips Bootstrap de los íconos de ayuda en los headers de las tarjetas
        // (aclaran que "Cantidad" = reclamos únicos, no ítems/lotes).
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => new bootstrap.Tooltip(el));
        setTimeout(() => {
            inicializarFechasPorDefecto();
            loadAll();
        }, 0);
    });

    // "Reclamos por Mes" (u otros charts) al iniciar aparece cortado (el ancho real del
    // contenedor aún no está estable cuando ApexCharts lo renderiza en DOMContentLoaded:
    // fuentes/íconos Bootstrap y el layout de las tarjetas todavía no terminaron de
    // calcularse). El resize real ya se fuerza al final de loadAll() (ver arriba), una
    // vez que los charts ya existen. Aquí se agrega un resize adicional en 'load' por
    // si el navegador reflowea el layout luego (p.ej. fuentes web tardías, webfonts).
    window.addEventListener('load', () => {
        [chartMeses, chartMotivos, chartFamilia, chartClientesKg, chartClientesCantidad]
            .filter(c => c)
            .forEach(c => c.windowResize());
    });

    // Si la página se restaura desde el bfcache (navegación atrás/adelante),
    // DOMContentLoaded no vuelve a dispararse y los inputs de fecha quedan vacíos.
    window.addEventListener('pageshow', (event) => {
        if (event.persisted) {
            setTimeout(() => {
                inicializarFechasPorDefecto();
                loadAll();
            }, 0);
        }
    });
</script>
}
