@section Scripts {
<script src="~/lib/apexcharts/dist/apexcharts.min.js" asp-append-version="true"></script>
<script>
const inp = document.getElementById('searchReporte');
if (inp) {
    inp.addEventListener('input', function() {
        const q = this.value.toLowerCase();
        document.querySelectorAll('#tablaReporte tbody tr').forEach(tr => {
            tr.style.display = tr.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
    });
}

// ── Panel interactivo · datos planos enriquecidos con organigrama ──────────
// (CAP_INSCRIPCION ya trae DESC_AREA / DESC_CARGO / NOMBRE_SUPERVISOR — ver
//  06_CAP_ORG_EMPLEADO.sql — por eso no se requiere un endpoint adicional).
const dataReporte = @Json.Serialize(Model.Select(i => new {
    curso       = i.TituloCurso ?? ("Curso #" + i.IdCurso),
    categoria   = string.IsNullOrEmpty(i.NombreCategoria) ? "Sin categoría" : i.NombreCategoria,
    estado      = i.Estado,
    area        = string.IsNullOrEmpty(i.DescArea) ? "Sin gran centro de costo" : i.DescArea,
    centroCosto = string.IsNullOrEmpty(i.DescCentroCosto) ? "Sin centro de costo" : i.DescCentroCosto,
    cargo       = string.IsNullOrEmpty(i.DescCargo) ? "Sin cargo" : i.DescCargo,
    codigo      = i.CodUsuario,
    persona     = string.IsNullOrEmpty(i.NombreUsuario) ? i.CodUsuario : i.NombreUsuario,
    supervisor  = string.IsNullOrEmpty(i.NombreSupervisor) ? "Sin supervisor" : i.NombreSupervisor,
    obligatorio = i.Obligatorio,
    examen      = i.TieneExamen == "S" ? (i.ExamenAprobado == "S" ? "Aprobado" : (i.TotalIntentos > 0 ? "Desaprobado" : "Sin rendir")) : "N/A",
    certificado = i.TieneCertificado == "S" ? "S" : "N",
    mes         = i.FchInscripcion.ToString("yyyy-MM"),
    progreso    = i.PctProgreso,
    nota        = i.MejorNota
}))

function fmtVal(v, fmt) {
  if (v === null || v === undefined || isNaN(v)) return '—';
  if (fmt === '%') return v + '%';
  if (fmt === 'd') return v.toFixed(1);
  return Number(v).toLocaleString('es-PE');
}

function renderRankingList(containerId, items, fmt, maxItems) {
  const cont = document.getElementById(containerId);
  if (!cont) return;
  const ordenados = maxItems ? items.slice(0, maxItems) : items;
  if (!ordenados.length) { cont.innerHTML = '<div class="text-center text-muted small py-3">Sin datos</div>'; return; }
  const max = Math.max(...ordenados.map(a => a.valor), 1);
  cont.innerHTML = ordenados.map((a, idx) => `
    <div class="piv-rank-item">
      <div class="piv-rank-pos ${idx === 0 ? 'top1' : ''}">${idx + 1}</div>
      <div class="piv-rank-body">
        <div class="piv-rank-name" title="${a.cat}">${a.cat}</div>
        <div class="piv-rank-bar-bg"><div class="piv-rank-bar" style="width:${Math.max(4, a.valor / max * 100)}%"></div></div>
      </div>
      <div class="piv-rank-val">${fmtVal(a.valor, fmt)}</div>
    </div>`).join('');
}

// ── Rankings fijos (no dependen de los selectores del panel) ──
function topByCount(rows, keyFn, labelFn, n = 8) {
  const map = new Map();
  rows.forEach(r => {
    const k = keyFn(r);
    if (!map.has(k)) map.set(k, { cat: labelFn(r), valor: 0 });
    map.get(k).valor++;
  });
  return [...map.values()].sort((a, b) => b.valor - a.valor).slice(0, n);
}

function topByAvg(rows, keyFn, labelFn, valFn, n = 8) {
  const map = new Map();
  rows.forEach(r => {
    const k = keyFn(r);
    const v = valFn(r);
    if (v === null || v === undefined || isNaN(v)) return;
    if (!map.has(k)) map.set(k, { cat: labelFn(r), sum: 0, count: 0 });
    const o = map.get(k);
    o.sum += v; o.count++;
  });
  return [...map.values()]
    .map(o => ({ cat: o.cat, valor: Math.round(o.sum / o.count * 10) / 10 }))
    .sort((a, b) => b.valor - a.valor)
    .slice(0, n);
}

function renderRankingsExtra() {
  renderRankingList('rankCursos',               topByCount(dataReporte, r => r.curso, r => r.curso), 'n');
  renderRankingList('rankArea',                 topByCount(dataReporte, r => r.area, r => r.area), 'n');
  renderRankingList('rankCentroCosto',          topByCount(dataReporte, r => r.centroCosto, r => r.centroCosto), 'n');
  renderRankingList('rankCategoria',            topByCount(dataReporte, r => r.categoria, r => r.categoria), 'n');
  renderRankingList('rankPersonaCursos',        topByCount(dataReporte, r => r.codigo, r => r.persona), 'n');
  renderRankingList('rankPersonaNota',          topByAvg(dataReporte.filter(r => r.nota != null), r => r.codigo, r => r.persona, r => r.nota), 'd');
  renderRankingList('rankPersonaCertificados',  topByCount(dataReporte.filter(r => r.certificado === 'S'), r => r.codigo, r => r.persona), 'n');
}

// ── Gráficas fijas del Panel interactivo (cada una responde una pregunta puntual) ──
const pivCharts = {}; // guarda instancias ApexCharts por id para poder destruir/recrear

function mountChart(containerId, options) {
  if (pivCharts[containerId]) { pivCharts[containerId].destroy(); pivCharts[containerId] = null; }
  const el = document.getElementById(containerId);
  if (!el) return;
  const chart = new ApexCharts(el, options);
  chart.render();
  pivCharts[containerId] = chart;
}

function emptyChart(containerId, msg) {
  const el = document.getElementById(containerId);
  if (el) el.innerHTML = `<div class="text-center text-muted small py-4">${msg || 'Sin datos'}</div>`;
}

const ESTADO_LBL = { C: 'Completado', P: 'En progreso', V: 'Vencido', X: 'Anulado' };
const ESTADO_COLOR = { Completado: '#0f766e', 'En progreso': '#1d4ed8', Vencido: '#9f1239', Anulado: '#64748b' };

// 1) Evolución mensual de inscripciones (línea de tiempo — única dimensión donde tiene sentido)
function buildChartEvolucion() {
  if (!dataReporte.length) { emptyChart('chartEvolucion'); return; }
  const map = new Map();
  dataReporte.forEach(r => map.set(r.mes, (map.get(r.mes) || 0) + 1));
  const meses = [...map.keys()].sort();
  const data = meses.map(m => map.get(m));
  mountChart('chartEvolucion', {
    chart: { type: 'area', height: 280, toolbar: { show: true }, fontFamily: 'inherit' },
    series: [{ name: 'Inscripciones', data }],
    xaxis: { categories: meses },
    colors: ['#1d4ed8'],
    stroke: { curve: 'smooth', width: 2 },
    fill: { type: 'gradient', gradient: { opacityFrom: .35, opacityTo: 0 } },
    dataLabels: { enabled: false },
    tooltip: { y: { formatter: v => fmtVal(v, 'n') } }
  });
}

// 2) Distribución por Estado (dona — proporción de un total, ideal para dona)
function buildChartEstado() {
  if (!dataReporte.length) { emptyChart('chartEstado'); return; }
  const counts = {};
  dataReporte.forEach(r => { const l = ESTADO_LBL[r.estado] || r.estado; counts[l] = (counts[l] || 0) + 1; });
  const labels = Object.keys(counts);
  mountChart('chartEstado', {
    chart: { type: 'donut', height: 280, fontFamily: 'inherit' },
    series: labels.map(l => counts[l]),
    labels,
    colors: labels.map(l => ESTADO_COLOR[l] || '#64748b'),
    legend: { position: 'bottom' },
    dataLabels: { formatter: (val, o) => o.w.config.series[o.seriesIndex] }
  });
}

// 3) Cumplimiento de obligatorios (dona — solo cursos obligatorios, S/N cumplimiento)
function buildChartObligatorios() {
  const rows = dataReporte.filter(r => r.obligatorio === 'S');
  if (!rows.length) { emptyChart('chartObligatorios', 'Sin cursos obligatorios'); return; }
  const counts = {};
  rows.forEach(r => { const l = ESTADO_LBL[r.estado] || r.estado; counts[l] = (counts[l] || 0) + 1; });
  const labels = Object.keys(counts);
  mountChart('chartObligatorios', {
    chart: { type: 'donut', height: 280, fontFamily: 'inherit' },
    series: labels.map(l => counts[l]),
    labels,
    colors: labels.map(l => ESTADO_COLOR[l] || '#64748b'),
    legend: { position: 'bottom' },
    dataLabels: { formatter: (val, o) => o.w.config.series[o.seriesIndex] }
  });
}

// 4) Resultado de exámenes (barras — categorías discretas de un solo grupo, sin serie temporal)
function buildChartExamen() {
  const rows = dataReporte.filter(r => r.examen !== 'N/A');
  if (!rows.length) { emptyChart('chartExamen', 'Ningún curso con examen'); return; }
  const orden = ['Aprobado', 'Desaprobado', 'Sin rendir'];
  const counts = {}; orden.forEach(k => counts[k] = 0);
  rows.forEach(r => { if (counts[r.examen] !== undefined) counts[r.examen]++; });
  mountChart('chartExamen', {
    chart: { type: 'bar', height: 280, fontFamily: 'inherit', toolbar: { show: false } },
    series: [{ name: 'Inscripciones', data: orden.map(k => counts[k]) }],
    xaxis: { categories: orden },
    plotOptions: { bar: { borderRadius: 4, distributed: true, columnWidth: '55%' } },
    legend: { show: false },
    colors: ['#0f766e', '#9f1239', '#d97706'],
    dataLabels: { enabled: true, formatter: v => fmtVal(v, 'n') }
  });
}

// 5) Progreso promedio por Curso — barras horizontales (más legible con nombres largos), top 10
function buildChartProgresoCurso() {
  const top = topByAvg(dataReporte, r => r.curso, r => r.curso, r => r.progreso, 10);
  if (!top.length) { emptyChart('chartProgresoCurso'); return; }
  const ordenAsc = [...top].reverse(); // ApexCharts horizontal dibuja de abajo hacia arriba
  mountChart('chartProgresoCurso', {
    chart: { type: 'bar', height: 320, fontFamily: 'inherit', toolbar: { show: false } },
    series: [{ name: 'Progreso promedio', data: ordenAsc.map(o => o.valor) }],
    xaxis: { categories: ordenAsc.map(o => o.cat), labels: { formatter: v => Math.round(v) + '%' }, max: 100 },
    plotOptions: { bar: { horizontal: true, borderRadius: 3, distributed: true } },
    legend: { show: false },
    colors: ['#1d4ed8', '#0891b2', '#0f766e', '#92400e', '#9f1239', '#6d28d9', '#64748b', '#334155', '#0d9488', '#4338ca'],
    dataLabels: { enabled: true, formatter: v => Math.round(v) + '%' },
    tooltip: { y: { formatter: v => Math.round(v) + '%' } }
  });
}

// 6) Distribución de notas por rango (histograma — agrupa valores continuos en buckets)
function buildChartNotas() {
  const rows = dataReporte.filter(r => r.nota != null);
  if (!rows.length) { emptyChart('chartNotas', 'Sin exámenes rendidos'); return; }
  const buckets = [
    { label: '0-59', min: 0, max: 59 },
    { label: '60-69', min: 60, max: 69 },
    { label: '70-79', min: 70, max: 79 },
    { label: '80-89', min: 80, max: 89 },
    { label: '90-100', min: 90, max: 100 }
  ];
  const counts = buckets.map(b => rows.filter(r => r.nota >= b.min && r.nota <= b.max).length);
  mountChart('chartNotas', {
    chart: { type: 'bar', height: 320, fontFamily: 'inherit', toolbar: { show: false } },
    series: [{ name: 'Exámenes', data: counts }],
    xaxis: { categories: buckets.map(b => b.label) },
    plotOptions: { bar: { borderRadius: 4, columnWidth: '55%' } },
    legend: { show: false },
    colors: ['#9f1239'],
    dataLabels: { enabled: true, formatter: v => fmtVal(v, 'n') }
  });
}

function renderPanelFijo() {
  buildChartEvolucion();
  buildChartEstado();
  buildChartObligatorios();
  buildChartExamen();
  buildChartProgresoCurso();
  buildChartNotas();
}

// El panel vive en una pestaña oculta al cargar la página; ApexCharts necesita que el
// contenedor esté visible (ancho > 0) para calcular sus dimensiones, así que se renderiza
