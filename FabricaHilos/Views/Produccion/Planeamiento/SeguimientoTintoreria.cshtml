                        @* Cols 20-23: RECETA *@
                        <th colspan="4" class="col-sep th-grupo">RECETA</th>

                        @* Col 24: PROGRAMA *@
                        <th colspan="1" class="col-sep th-grupo">PROGRAMA</th>

                        @* Cols 25-28: TEÑIDO *@
                        <th colspan="4" class="col-sep th-grupo">TEÑIDO</th>

                        @* Cols 29-30: TINTORERÍA (fechas reales partida/receta) *@
                        <th colspan="2" class="col-sep th-grupo">TINTORERÍA</th>

                        @* Cols 31-34: SECADO *@
                        <th colspan="4" class="col-sep th-grupo">SECADO</th>

                        @* Cols 34-35: ENCONADO *@
                        <th colspan="2" class="col-sep th-grupo">ENCONADO</th>

                        @* Cols 36-37: REVISADO *@
                        <th colspan="2" class="col-sep th-grupo">REVISADO</th>

                        @* Cols 38-42: ALMACÉN *@
                        <th colspan="5" class="col-sep th-grupo">ALMACÉN</th>

                        @* Cols 43-46: KG *@
                        <th colspan="4" class="col-sep th-grupo">KG</th>

                        @* Cols 47-50: sin cabecera de grupo (estados + apoyo) *@
                        <th colspan="4" class="col-sep th-grupo"></th>

                        @* Cols 51-65: COLUMNAS ADICIONALES — NO EN DT EXCEL (comentadas, pendientes de activar) *@
                        @*
                        <th colspan="15" class="col-sep th-grupo-adicional">COLUMNAS ADICIONALES &mdash; NO EN DT EXCEL</th>
                        *@
                    </tr>

                    @* ── Fila 2: Cabeceras individuales de columna ───────────────────────── *@
                    <tr>
                        @* Cols 1-4: Dimensiones (tiempo) *@
                        <th class="fc-1">Mes</th>
                        <th class="fc-2">Mes.Tex</th>
                        <th class="fc-3">Año</th>
                        <th class="fc-4">Sem</th>

                        @* Cols 5-12: Identificación *@
                        <th class="col-sep fc-5">Partida</th>
                        <th class="fc-6">Cliente</th>
                        <th class="fc-7">Material</th>
                        <th class="fc-8">Est</th>
                        <th>Ne</th>
                        <th>Mat</th>
                        <th>Lote</th>
                        <th>F.Pedido</th>

                        @* Cols 13-15: 1er Rodete *@
                        <th class="col-sep">Estima.Rod</th>
                        <th>Entreg.Rod</th>
                        <th>D.Rod</th>

                        @* Cols 16-18: Mat.Hilanderia *@
                        <th class="col-sep">Estima.Mat</th>
                        <th>Entreg.Mat</th>
                        <th>D.MH</th>

                        @* Col 19: F.Guia *@
                        <th class="col-sep">F.Guía</th>

                        @* Cols 20-23: Receta TT *@
                        <th class="col-sep">Estima.Rec</th>
                        <th>Entreg.Rec</th>
                        <th>D.Rec</th>
                        <th>X</th>

                        @* Cols 24-28: Programa TT *@
                        <th class="col-sep">F.Prog</th>
                        <th>Maq</th>
                        <th>Est.Ten</th>
                        <th>Entr.Ten</th>
                        <th>D.Tenido</th>

                        @* Cols 29-34: Fechas reales *@
                        <th class="col-sep">F.Partida</th>
                        <th>F.Receta</th>
                        <th>F.Sec.Rod</th>
                        <th>F.Sec.Mad</th>
                        <th>F.Aprob.Cal</th>
                        <th>Time.Aprov</th>

                        @* Cols 34-37: Acabado/Revisado *@
                        <th class="col-sep">Tipo.Acab</th>
                        <th>F.Encon</th>
                        <th>F.Revis</th>
                        <th>Ev.Encon</th>

                        @* Cols 38-42: Entrega/Espera *@
                        <th class="col-sep">F.Entrega</th>
                        <th>Ing.AlmPT</th>
                        <th>D.Espera</th>
                        <th style="text-align:center">De</th>
                        <th>De.Copia</th>

                        @* Cols 43-46: Kilogramos *@
                        <th class="col-sep">Kg.Prog</th>
                        <th>Kg.Despa</th>
                        <th>Gap</th>
                        <th>%Tol.</th>

                        @* Cols 47-48: Estados *@
                        <th class="col-sep">Est.Flujo</th>
                        <th>Est.Desp</th>

                        @* Cols 49-50: Apoyo *@
                        <th class="col-sep">Area.Resp</th>
                        <th>Bp</th>

                        @* Cols 51-65: Adicionales (comentadas, pendientes de activar) *@
                        @*
                        <th class="col-sep" style="text-align:right">P.Neto</th>
                        <th>RMC</th>
                        <th>Nro.RMC</th>
                        <th>Título</th>
                        <th>Tit.Texto</th>
                        <th>Ref.</th>
                        <th>Proceso.TT</th>
                        <th>P.Matiz</th>
                        <th>Est.Eval</th>
                        <th>Defecto</th>
                        <th>Resultado</th>
                        <th>Lab.Val</th>
                        <th>F.Secado.Mad</th>
                        <th>Aca.Mad</th>
                        <th style="text-align:right">D.Retraso</th>
                        *@
                    </tr>
                </thead>
                <tbody id="stTbody"></tbody>
                <tfoot>
                    @if (buscado && items.Count > 0)
                    {
                        <tr class="table-secondary fw-bold" style="font-size:.7rem;border-top:2px solid #6c757d;">
                            @* Cols 1-8 fijas sticky *@
                            <td class="fc-1" style="text-align:right;white-space:nowrap;font-size:.65rem;color:#6c757d;"></td>
                            <td class="fc-2"></td>
                            <td class="fc-3"></td>
                            <td class="fc-4"></td>
                            <td class="fc-5"></td>
                            <td class="fc-6"></td>
                            <td class="fc-7"></td>
                            <td class="fc-8" style="text-align:right;padding-right:.5rem;white-space:nowrap;font-size:.65rem;color:#6c757d;">KPI</td>
                            @* Cols 9-12: Ne, Mat, Lote, F.Pedido (vacío) *@
                            <td colspan="4"></td>

                            @* Col 13-14: Estima/Entreg Rod (vacío) *@
                            <td colspan="2" class="col-sep"></td>
                            @* Col 15: D.Rod = PROMEDIO.SI(<0) *@
                            <td data-kpi="rod" style="text-align:right;white-space:nowrap;"></td>

                            @* Col 16-17: Estima/Entreg Mat (vacío) *@
                            <td colspan="2" class="col-sep"></td>
                            @* Col 18: D.MH = PROMEDIO.SI(<0) *@
                            <td data-kpi="mh" style="text-align:right;white-space:nowrap;"></td>

                            @* Col 19: F.Guía (vacío) *@
                            <td class="col-sep"></td>

                            @* Col 20-21: Estima/Entreg Receta (vacío) *@
                            <td colspan="2" class="col-sep"></td>
                            @* Col 22: D.Rec = SUBTOTALES(1) *@
                            <td data-kpi="rec" style="text-align:right;white-space:nowrap;"></td>
                            @* Col 23: X (sin KPI — solo ícono en DT) *@
                            <td></td>

                            @* Col 24-27: F.Prog + Maq + Est.Ten + Entr.Ten (vacío) *@
                            <td colspan="4" class="col-sep"></td>
                            @* Col 28: D.Tenido = SUBTOTALES(1) *@
                            <td data-kpi="diast" style="text-align:right;white-space:nowrap;"></td>

                            @* Col 29-32: F.Partida + F.Receta + F.Secado + F.Aprob.Cal (vacío) *@
                            <td colspan="4" class="col-sep"></td>
                            @* Col 33: TimeAprov = KpiDiasT (idéntico por fórmula Excel) *@
                            <td data-kpi="timeaprov" style="text-align:right;white-space:nowrap;"></td>

                            @* Cols 35-51: resto vacío (18 celdas); cols 52-66 comentadas *@
                            <td colspan="18"></td>
                        </tr>
                    }
                </tfoot>
            </table>
        </div>

        <div class="spt-footer">
            <div>
                <i class="bi bi-table me-1"></i>
                <strong>@items.Count</strong> registros encontrados
            </div>
            <div class="spt-legend">
                <span class="eb eb-ok"><i class="bi bi-check-lg"></i> Etapa completada</span>
                <span class="eb eb-sin">— Sin fecha</span>
                <span class="dias-ret" style="font-size:.68rem;">■</span><span style="font-size:.68rem;">Retrasado</span>
                <span class="dias-ok"  style="font-size:.68rem;">■</span><span style="font-size:.68rem;">En plazo</span>
            </div>
        </div>
    }

</div>@* /spt-card tabla *@
</div>@* /container-fluid *@

@section Scripts {
<script>
// ── Toggle fecha/pedido ──────────────────────────────────────────────────────
// ── Datos serializados desde el servidor ──────────────────────────────────
window.stData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(items.Select(r => new {
    mes        = r.Mes,
    mesTex     = r.MesTex,
    ano        = r.Ano,
