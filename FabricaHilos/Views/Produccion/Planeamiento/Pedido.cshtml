                                              <div><span class="tt-lbl">Duración</span><span class="tt-val">@(sec.DuracionHoras.HasValue ? $"{sec.DuracionHoras.Value:N1} h" : "—")</span></div>
                                              <div><span class="tt-lbl">Min. secado</span><span class="tt-val">@(sec.MinSecado.HasValue ? $"{sec.MinSecado.Value:N0} min" : "—")</span></div>
