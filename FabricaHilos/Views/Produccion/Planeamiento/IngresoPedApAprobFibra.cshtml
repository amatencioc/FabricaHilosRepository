@{
    var variantesCliente = ViewBag.VariantesCliente as FabricaHilos.Models.Produccion.Planeamiento.PlnIngresoPedidoAprobadoFibraVariantesViewModel
        ?? new FabricaHilos.Models.Produccion.Planeamiento.PlnIngresoPedidoAprobadoFibraVariantesViewModel { Todos = Model, Cliente = Model, Almacen = Model };
    Func<FabricaHilos.Models.Produccion.Planeamiento.PlnIngresoPedidoAprobadoFibraViewModel, object> serializarVariante = v => new
    {
        produccion   = v.Produccion.Select(x => new { grupo = x.Grupo, cliente = x.Cliente, tipo = x.Tipo, carga = x.CargaTrabajoEnconado, kg = x.Kg }),
        soloDespacho = v.SoloDespacho.Select(x => new { grupo = x.Grupo, cliente = x.Cliente, tipo = x.Tipo, carga = x.CargaTrabajoEnconado, kg = x.Kg }),
        servicios    = v.Servicios.Select(x => new { grupo = x.Grupo, cliente = x.Cliente, tipo = x.Tipo, carga = x.CargaTrabajoEnconado, kg = x.Kg })
    };
}

@section Scripts {
<script src="~/lib/chartjs-plugin-datalabels/dist/chartjs-plugin-datalabels.min.js" asp-append-version="true"></script>
<script>
    (function () {
        if (typeof ChartDataLabels !== 'undefined') {
            Chart.register(ChartDataLabels);
        }

        function agrupar(items, keySelector) {
            const map = new Map();
            for (const it of items) {
                const k = keySelector(it) || 'N/D';
                map.set(k, (map.get(k) || 0) + (it.kg || 0));
            }
            return map;
        }

        function paleta(n) {
            const colores = ['#0d6efd', '#198754', '#fd7e14', '#6f42c1', '#20c997', '#dc3545', '#0dcaf0', '#ffc107', '#6c757d', '#e83e8c'];
            const out = [];
            for (let i = 0; i < n; i++) out.push(colores[i % colores.length]);
            return out;
        }

        function nombreGrupoJs(g) {
            return (!g || g === '0') ? 'SERVICIOS' : g;
        }

        // Datasets con las 3 variantes (TODOS/CLIENTE/ALMACEN) precargadas desde el servidor.
        // Permiten que cada tarjeta/gráfico conmute su filtro Cliente sin recargar la página.
        const datasetsPorCliente = {
            TODOS:   @Html.Raw(Json.Serialize(serializarVariante(variantesCliente.Todos))),
            CLIENTE: @Html.Raw(Json.Serialize(serializarVariante(variantesCliente.Cliente))),
            ALMACEN: @Html.Raw(Json.Serialize(serializarVariante(variantesCliente.Almacen)))
        };

        function datasetPara(tipo) {
            return datasetsPorCliente[tipo] || datasetsPorCliente.TODOS;
        }

        function combinado(tipo) {
            const d = datasetPara(tipo);
            return d.produccion.concat(d.soloDespacho).concat(d.servicios);
        }

        function ordenarDesc(map) {
            return [...map.entries()].sort((a, b) => b[1] - a[1]);
        }

        // ── Producción / Solo Despacho / Servicios (tab Gráficos) ──
        let chartProduccion = null, chartSoloDespacho = null, chartServicios = null;

        function renderGraficosPrincipales(tipo) {
            const d = datasetPara(tipo);

            const prodMap = agrupar(d.produccion, x => x.grupo);
            if (chartProduccion) chartProduccion.destroy();
            chartProduccion = new Chart(document.getElementById('chartProduccion'), {
                type: 'bar',
                data: {
                    labels: [...prodMap.keys()],
                    datasets: [{
                        label: 'Kg Producción',
                        data: [...prodMap.values()],
                        backgroundColor: paleta(prodMap.size)
                    }]
                },
                options: {
                    responsive: true,
                    layout: { padding: { top: 24 } },
                    plugins: {
                        legend: { display: false },
                        datalabels: {
                            anchor: 'end',
                            align: 'top',
                            color: '#212529',
                            font: { weight: 'bold', size: 11 },
                            formatter: v => v.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                        }
                    },
                    scales: { y: { beginAtZero: true } }
                }
            });

            const desMap = agrupar(d.soloDespacho, x => x.grupo);
            if (chartSoloDespacho) chartSoloDespacho.destroy();
            chartSoloDespacho = new Chart(document.getElementById('chartSoloDespacho'), {
                type: 'bar',
                data: {
                    labels: [...desMap.keys()],
                    datasets: [{
                        label: 'Kg Solo Despacho',
                        data: [...desMap.values()],
                        backgroundColor: paleta(desMap.size)
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    layout: { padding: { right: 48 } },
                    plugins: {
                        legend: { display: false },
                        datalabels: {
                            anchor: 'end',
                            align: 'right',
                            color: '#212529',
                            font: { weight: 'bold', size: 11 },
                            formatter: v => v.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                        }
                    },
                    scales: { x: { beginAtZero: true } }
                }
            });

            const servMap = agrupar(d.servicios, x => x.cliente);
            const servTotal = [...servMap.values()].reduce((a, b) => a + b, 0);
            if (chartServicios) chartServicios.destroy();
            chartServicios = new Chart(document.getElementById('chartServicios'), {
                type: 'doughnut',
                data: {
                    labels: [...servMap.keys()],
                    datasets: [{
                        data: [...servMap.values()],
                        backgroundColor: paleta(servMap.size)
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' },
                        datalabels: {
                            color: '#fff',
                            font: { weight: 'bold', size: 11 },
                            formatter: v => servTotal > 0 ? (v / servTotal * 100).toFixed(1) + '%' : '0%'
                        }
                    }
                }
            });
        }

        document.getElementById('selClienteGraficos').addEventListener('change', e => renderGraficosPrincipales(e.target.value));
        renderGraficosPrincipales('TODOS');

        // ── Acumulado ALMACÉN vs CLIENTES ──
        let chartAcumuladoBarras = null, chartAcumuladoTorta = null;

        function renderAcumulado(tipo) {
            const items = combinado(tipo);
            const totalGeneral = items.reduce((a, b) => a + b.kg, 0);
            const almacen = items.filter(x => (x.cliente || '').toUpperCase().includes('ALMAC')).reduce((a, b) => a + b.kg, 0);
            const clientes = totalGeneral - almacen;
            const acumuladoLabels = ['ALMACÉN', 'CLIENTES'];
            const acumuladoValores = [almacen, clientes];
            const acumuladoColores = ['#4472C4', '#ED7D31'];

            if (chartAcumuladoBarras) chartAcumuladoBarras.destroy();
            chartAcumuladoBarras = new Chart(document.getElementById('chartAcumuladoBarras'), {
                type: 'bar',
                data: {
                    labels: acumuladoLabels,
                    datasets: [{
                        label: 'Total',
                        data: acumuladoValores,
                        backgroundColor: acumuladoColores
                    }]
                },
                options: {
                    responsive: true,
                    layout: { padding: { top: 24 } },
                    plugins: {
                        legend: { display: false },
                        datalabels: {
                            anchor: 'end',
                            align: 'top',
                            color: '#212529',
                            font: { weight: 'bold', size: 11 },
                            formatter: v => v.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                        }
                    },
                    scales: { y: { beginAtZero: true } }
                }
            });

            const acumuladoTotal = acumuladoValores.reduce((a, b) => a + b, 0);
            if (chartAcumuladoTorta) chartAcumuladoTorta.destroy();
            chartAcumuladoTorta = new Chart(document.getElementById('chartAcumuladoTorta'), {
                type: 'pie',
                data: {
                    labels: acumuladoLabels,
                    datasets: [{
                        data: acumuladoValores,
                        backgroundColor: acumuladoColores
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' },
                        datalabels: {
                            color: '#fff',
                            font: { weight: 'bold', size: 11 },
                            formatter: v => acumuladoTotal > 0 ? (v / acumuladoTotal * 100).toFixed(1) + '%' : '0%'
                        }
                    }
                }
            });
        }

        document.getElementById('selClienteAcumulado').addEventListener('change', e => renderAcumulado(e.target.value));
        renderAcumulado('TODOS');

        // ── Carga de Trabajo Sector Enconado (por Tipo) ──
        let chartCargaEnconadoBarras = null, chartCargaEnconadoTorta = null;

        function renderCargaEnconado(tipo) {
            const items = combinado(tipo);
            const entradas = ordenarDesc(agrupar(items, x => x.tipo));
            const labels = entradas.map(e => e[0]);
            const valores = entradas.map(e => e[1]);
            const colores = paleta(labels.length);

            if (chartCargaEnconadoBarras) chartCargaEnconadoBarras.destroy();
            chartCargaEnconadoBarras = new Chart(document.getElementById('chartCargaEnconadoBarras'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Total',
                        data: valores,
                        backgroundColor: colores
                    }]
                },
                options: {
                    responsive: true,
                    layout: { padding: { top: 24 } },
                    plugins: {
                        legend: { display: false },
                        datalabels: {
                            anchor: 'end',
                            align: 'top',
                            color: '#212529',
                            font: { weight: 'bold', size: 11 },
                            formatter: v => v.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                        }
                    },
                    scales: { y: { beginAtZero: true } }
                }
            });

            const total = valores.reduce((a, b) => a + b, 0);
            if (chartCargaEnconadoTorta) chartCargaEnconadoTorta.destroy();
            chartCargaEnconadoTorta = new Chart(document.getElementById('chartCargaEnconadoTorta'), {
                type: 'pie',
                data: {
                    labels: labels,
                    datasets: [{
                        data: valores,
                        backgroundColor: colores
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' },
                        datalabels: {
                            color: '#fff',
                            font: { weight: 'bold', size: 11 },
                            formatter: v => total > 0 ? (v / total * 100).toFixed(1) + '%' : '0%'
                        }
                    }
                }
            });
        }

        document.getElementById('selClienteCargaEnconado').addEventListener('change', e => renderCargaEnconado(e.target.value));
        renderCargaEnconado('TODOS');

        // ── Línea de Producción (por Grupo) ──
        let chartLineaProduccionBarras = null, chartLineaProduccionTorta = null;

        function renderLineaProduccion(tipo) {
            const items = combinado(tipo);
            const entradas = ordenarDesc(agrupar(items, x => nombreGrupoJs(x.grupo)));
            const labels = entradas.map(e => e[0]);
            const valores = entradas.map(e => e[1]);
            const colores = paleta(labels.length);

            if (chartLineaProduccionBarras) chartLineaProduccionBarras.destroy();
            chartLineaProduccionBarras = new Chart(document.getElementById('chartLineaProduccionBarras'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Total',
                        data: valores,
                        backgroundColor: colores
                    }]
                },
                options: {
                    responsive: true,
                    layout: { padding: { top: 24 } },
                    plugins: {
                        legend: { display: false },
                        datalabels: {
                            anchor: 'end',
                            align: 'top',
                            color: '#212529',
                            font: { weight: 'bold', size: 11 },
                            formatter: v => v.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                        }
                    },
                    scales: { y: { beginAtZero: true } }
                }
            });

            const total = valores.reduce((a, b) => a + b, 0);
            if (chartLineaProduccionTorta) chartLineaProduccionTorta.destroy();
            chartLineaProduccionTorta = new Chart(document.getElementById('chartLineaProduccionTorta'), {
                type: 'pie',
                data: {
                    labels: labels,
                    datasets: [{
                        data: valores,
                        backgroundColor: colores
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' },
                        datalabels: {
                            color: '#fff',
                            font: { weight: 'bold', size: 11 },
                            formatter: v => total > 0 ? (v / total * 100).toFixed(1) + '%' : '0%'
                        }
                    }
                }
            });
        }

        document.getElementById('selClienteLineaProduccion').addEventListener('change', e => renderLineaProduccion(e.target.value));
        renderLineaProduccion('TODOS');

        // ── Carga de Batán N° 1 y 2 (por Grupo, con filtro tipo slicer "LÍNEA") ──
        let chartCargaBatanBarras = null;
        let chartCargaBatanTorta = null;
        let cargaBatanTipoActual = 'TODOS';

        function cargaBatanTodosPara(tipo) {
            const items = combinado(tipo);
            return ordenarDesc(agrupar(items, x => nombreGrupoJs(x.grupo))).map(([grupo, kg]) => ({ grupo, kg }));
        }

        const cargaBatanOrdenTodos = cargaBatanTodosPara('TODOS').map(x => x.grupo);
        const cargaBatanColorMap = new Map(cargaBatanOrdenTodos.map((g, i) => [g, paleta(cargaBatanOrdenTodos.length)[i]]));

        function cargaBatanGruposSeleccionados() {
            return [...document.querySelectorAll('.carga-batan-linea-chk:checked')].map(c => c.value);
        }

        function renderCargaBatan() {
            const cargaBatanTodos = cargaBatanTodosPara(cargaBatanTipoActual);
            const seleccion = new Set(cargaBatanGruposSeleccionados());
            const datos = cargaBatanTodos.filter(it => seleccion.has(it.grupo));
            const labels = datos.map(it => it.grupo);
            const valores = datos.map(it => it.kg);
            const colores = labels.map(l => cargaBatanColorMap.get(l));
            const total = valores.reduce((a, b) => a + b, 0);

            const tbody = document.getElementById('tblCargaBatanBody');
            tbody.innerHTML = datos.length === 0
                ? '<tr><td colspan="2" class="text-center text-muted py-3"><i class="bi bi-info-circle me-1"></i>Sin datos seleccionados.</td></tr>'
                : datos.map(it => `<tr><td>${it.grupo}</td><td class="text-end">${it.kg.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td></tr>`).join('');
            document.getElementById('tblCargaBatanTotal').textContent = total.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            if (chartCargaBatanBarras) chartCargaBatanBarras.destroy();
            if (chartCargaBatanTorta) chartCargaBatanTorta.destroy();

            chartCargaBatanBarras = new Chart(document.getElementById('chartCargaBatanBarras'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Total',
                        data: valores,
                        backgroundColor: colores
                    }]
                },
                options: {
                    responsive: true,
                    layout: { padding: { top: 24 } },
                    plugins: {
                        legend: { display: false },
                        datalabels: {
                            anchor: 'end',
                            align: 'top',
                            color: '#212529',
                            font: { weight: 'bold', size: 11 },
                            formatter: v => v.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                        }
                    },
                    scales: { y: { beginAtZero: true } }
                }
            });

            chartCargaBatanTorta = new Chart(document.getElementById('chartCargaBatanTorta'), {
                type: 'pie',
                data: {
                    labels: labels,
                    datasets: [{
                        data: valores,
                        backgroundColor: colores
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' },
                        datalabels: {
                            color: '#fff',
                            font: { weight: 'bold', size: 11 },
                            formatter: v => total > 0 ? (v / total * 100).toFixed(1) + '%' : '0%'
                        }
                    }
                }
            });
        }

        document.querySelectorAll('.carga-batan-linea-chk').forEach(chk => chk.addEventListener('change', renderCargaBatan));
        document.getElementById('selClienteCargaBatan').addEventListener('change', e => { cargaBatanTipoActual = e.target.value; renderCargaBatan(); });
        renderCargaBatan();

        // ── Carga de Tintorería (por Grupo, filtrado por Tipo con slicer "TIPO") ──
        let chartCargaTintoreriaBarras = null;
        let chartCargaTintoreriaTorta = null;
        let cargaTintoreriaTipoActual = 'TODOS';

        function cargaTintoreriaFilasPara(tipo) {
            return combinado(tipo).map(x => ({ grupo: nombreGrupoJs(x.grupo), tipo: x.tipo, kg: x.kg }));
        }

        const cargaTintoreriaGruposOrden = [...new Set(cargaTintoreriaFilasPara('TODOS').map(f => f.grupo))];
        const cargaTintoreriaColorMap = new Map(cargaTintoreriaGruposOrden.map((g, i) => [g, paleta(cargaTintoreriaGruposOrden.length)[i]]));

        function cargaTintoreriaTiposSeleccionados() {
            return [...document.querySelectorAll('.carga-tintoreria-tipo-chk:checked')].map(c => c.value);
        }

        function renderCargaTintoreria() {
            const cargaTintoreriaFilas = cargaTintoreriaFilasPara(cargaTintoreriaTipoActual);
            const seleccion = new Set(cargaTintoreriaTiposSeleccionados());
            const filtradas = cargaTintoreriaFilas.filter(f => seleccion.has(f.tipo));
            const mapGrupo = agrupar(filtradas, f => f.grupo);
            const labels = [...mapGrupo.keys()];
            const valores = [...mapGrupo.values()];
            const colores = labels.map(l => cargaTintoreriaColorMap.get(l));
            const total = valores.reduce((a, b) => a + b, 0);

            const tbody = document.getElementById('tblCargaTintoreriaBody');
            tbody.innerHTML = labels.length === 0
                ? '<tr><td colspan="2" class="text-center text-muted py-3"><i class="bi bi-info-circle me-1"></i>Sin datos seleccionados.</td></tr>'
                : labels.map((l, i) => `<tr><td>${l}</td><td class="text-end">${valores[i].toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td></tr>`).join('');
            document.getElementById('tblCargaTintoreriaTotal').textContent = total.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            if (chartCargaTintoreriaBarras) chartCargaTintoreriaBarras.destroy();
            if (chartCargaTintoreriaTorta) chartCargaTintoreriaTorta.destroy();

            chartCargaTintoreriaBarras = new Chart(document.getElementById('chartCargaTintoreriaBarras'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Total',
                        data: valores,
                        backgroundColor: colores
                    }]
                },
                options: {
                    responsive: true,
                    layout: { padding: { top: 24 } },
                    plugins: {
                        legend: { display: false },
                        datalabels: {
                            anchor: 'end',
                            align: 'top',
                            color: '#212529',
                            font: { weight: 'bold', size: 11 },
                            formatter: v => v.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                        }
                    },
                    scales: { y: { beginAtZero: true } }
                }
            });

            chartCargaTintoreriaTorta = new Chart(document.getElementById('chartCargaTintoreriaTorta'), {
                type: 'pie',
                data: {
                    labels: labels,
                    datasets: [{
                        data: valores,
                        backgroundColor: colores
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' },
                        datalabels: {
                            color: '#fff',
                            font: { weight: 'bold', size: 11 },
                            formatter: v => total > 0 ? (v / total * 100).toFixed(1) + '%' : '0%'
                        }
                    }
                }
            });
        }

        document.querySelectorAll('.carga-tintoreria-tipo-chk').forEach(chk => chk.addEventListener('change', renderCargaTintoreria));
        document.getElementById('selClienteCargaTintoreria').addEventListener('change', e => { cargaTintoreriaTipoActual = e.target.value; renderCargaTintoreria(); });
        renderCargaTintoreria();

        // ── Teñido a Enconar (por CARGA_TRABAJO_ENCONADO del SP, filtrado por Tipo con slicer "TIPO") ──
        let chartTenidoEnconarBarras = null;
        let chartTenidoEnconarTorta = null;
        let tenidoEnconarTipoActual = 'TODOS';

        function tenidoEnconarFilasPara(tipo) {
            return combinado(tipo).map(x => ({ carga: x.carga, tipo: x.tipo, kg: x.kg }));
        }

        const tenidoEnconarGruposOrden = [...new Set(tenidoEnconarFilasPara('TODOS').map(f => f.carga || 'N/D'))];
        const tenidoEnconarColorMap = new Map(tenidoEnconarGruposOrden.map((g, i) => [g, paleta(tenidoEnconarGruposOrden.length)[i]]));

        function tenidoEnconarTiposSeleccionados() {
            return [...document.querySelectorAll('.tenido-enconar-tipo-chk:checked')].map(c => c.value);
        }

        function renderTenidoEnconar() {
            const tenidoEnconarFilas = tenidoEnconarFilasPara(tenidoEnconarTipoActual);
            const seleccion = new Set(tenidoEnconarTiposSeleccionados());
            const filtradas = tenidoEnconarFilas.filter(f => seleccion.has(f.tipo));
            const mapCarga = agrupar(filtradas, f => f.carga);
            const labels = [...mapCarga.keys()];
            const valores = [...mapCarga.values()];
            const colores = labels.map(l => tenidoEnconarColorMap.get(l));
            const total = valores.reduce((a, b) => a + b, 0);

            const tbody = document.getElementById('tblTenidoEnconarBody');
            tbody.innerHTML = labels.length === 0
                ? '<tr><td colspan="2" class="text-center text-muted py-3"><i class="bi bi-info-circle me-1"></i>Sin datos seleccionados.</td></tr>'
                : labels.map((l, i) => `<tr><td>${l}</td><td class="text-end">${valores[i].toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td></tr>`).join('');
            document.getElementById('tblTenidoEnconarTotal').textContent = total.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            if (chartTenidoEnconarBarras) chartTenidoEnconarBarras.destroy();
            if (chartTenidoEnconarTorta) chartTenidoEnconarTorta.destroy();

            chartTenidoEnconarBarras = new Chart(document.getElementById('chartTenidoEnconarBarras'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Total',
                        data: valores,
                        backgroundColor: colores
                    }]
                },
                options: {
                    responsive: true,
                    layout: { padding: { top: 24 } },
                    plugins: {
                        legend: { display: false },
                        datalabels: {
                            anchor: 'end',
                            align: 'top',
                            color: '#212529',
                            font: { weight: 'bold', size: 11 },
                            formatter: v => v.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                        }
                    },
                    scales: { y: { beginAtZero: true } }
                }
            });

            chartTenidoEnconarTorta = new Chart(document.getElementById('chartTenidoEnconarTorta'), {
                type: 'pie',
                data: {
                    labels: labels,
                    datasets: [{
                        data: valores,
                        backgroundColor: colores
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' },
                        datalabels: {
                            color: '#fff',
                            font: { weight: 'bold', size: 11 },
                            formatter: v => total > 0 ? (v / total * 100).toFixed(1) + '%' : '0%'
                        }
                    }
                }
            });
        }

        document.querySelectorAll('.tenido-enconar-tipo-chk').forEach(chk => chk.addEventListener('change', renderTenidoEnconar));
        document.getElementById('selClienteTenidoEnconar').addEventListener('change', e => { tenidoEnconarTipoActual = e.target.value; renderTenidoEnconar(); });
        renderTenidoEnconar();

        // ── Fix: los canvas dentro de pestañas ocultas (display:none) se crean con tamaño 0x0.
        // Al activar una pestaña, forzamos resize() de todos los charts existentes para que se dibujen bien.
        document.querySelectorAll('#ipafTabs button[data-bs-toggle="tab"]').forEach(btn => {
            btn.addEventListener('shown.bs.tab', () => {
                Object.values(Chart.instances || {}).forEach(chart => chart.resize());
            });
        });
    })();
</script>
}
