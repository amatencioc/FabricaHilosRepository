@{
    ViewData["Title"] = "Día Libre por Compensar (DDC) — Aquarius";
    var _hoy = DateTime.Today;
    var _dia = (int)_hoy.DayOfWeek;
    var _lun = _hoy.AddDays(_dia == 0 ? -6 : -(_dia - 1));
    var _dom = _lun.AddDays(6);
    var _desde = _lun.ToString("yyyy-MM-dd");
    var _hasta = _dom.ToString("yyyy-MM-dd");
    var _mesInicio = new DateTime(_hoy.Year, _hoy.Month, 1).ToString("yyyy-MM-dd");
    var _mesFin    = new DateTime(_hoy.Year, _hoy.Month, DateTime.DaysInMonth(_hoy.Year, _hoy.Month)).ToString("yyyy-MM-dd");
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="RecursosHumanos" asp-action="Index">Recursos Humanos</a></li>
    <li class="breadcrumb-item">Aquarius</li>
    <li class="breadcrumb-item active">Día Libre por Compensar</li>
}

@section Styles {
<style>
    :root {
        --aq:       #C0622B;
        --aq-dk:    #9E4D20;
        --aq-lt:    #FEF3EB;
        --aq-mid:   #F5D5BC;
        --aq-ok:    #4E7E58;
        --aq-ok-lt: #EAF4EC;
        --aq-warn:  #B8772C;
        --aq-wlt:   #FEF5E3;
        --aq-err:   #AE3F3C;
        --aq-elt:   #FDECEA;
        --aq-info:  #7A6E9E;
        --aq-ilt:   #F2EDF7;
    }

    .comp-header {
        background: linear-gradient(135deg, var(--aq) 0%, var(--aq-dk) 100%);
        color: #fff; border-radius: .5rem .5rem 0 0; padding: 1.1rem 1.4rem;
    }
    .comp-header h5 { margin: 0; font-weight: 600; }
    .comp-header p  { margin: 0; opacity: .8; font-size: .82rem; }

    .step-badge {
        display: inline-flex; align-items: center; justify-content: center;
        width: 26px; height: 26px; border-radius: 50%;
        background: var(--aq); color: #fff;
        font-weight: 700; font-size: .8rem; flex-shrink: 0;
    }

    .section-card { border: 1px solid #dee2e6; border-radius: .5rem; margin-bottom: 1.1rem; }
    .section-card-header {
        background: #f8f9fa; border-bottom: 1px solid #dee2e6;
        padding: .6rem 1rem; border-radius: .5rem .5rem 0 0;
        font-weight: 600; font-size: .87rem; color: #343a40;
        display: flex; align-items: center; gap: .5rem;
    }
    .section-card-body { padding: 1rem; }

    .table-comp thead th {
        background: #f1f3f5; color: #495057;
        font-size: .72rem; font-weight: 600;
        text-transform: uppercase; letter-spacing: .4px;
        border-bottom: 2px solid var(--aq-mid);
        white-space: nowrap; padding: .55rem .8rem;
    }
    .table-comp tbody td { vertical-align: middle; padding: .45rem .8rem; font-size: .86rem; }
    .table-comp tbody tr:hover { background: var(--aq-lt); }

    .badge-ok        { background: var(--aq-ok-lt); color: var(--aq-ok);   }
    .badge-sin       { background: var(--aq-wlt);   color: var(--aq-warn); }
    .badge-err       { background: var(--aq-elt);   color: var(--aq-err);  }
    .badge-parcial   { background: var(--aq-ilt);   color: var(--aq-info); }
    .badge-warn      { background: var(--aq-wlt);   color: var(--aq-warn); }
    .badge-he        { background: var(--aq-wlt);   color: var(--aq-warn); }
    .badge-ddc       { background: var(--aq-elt);   color: var(--aq-err);  }
    .badge-bloq      { background: #e9ecef;          color: #6c757d;        }
    .badge-aplicada  { background: var(--aq-lt);    color: var(--aq-dk);   }
    .badge-pendiente { background: #f3f4f6;          color: #374151;        }

    .aq-modal-header { background: var(--aq);    color: #fff; }
    .aq-modal-ok     { background: var(--aq-ok); color: #fff; }
    .aq-modal-err    { background: var(--aq-err);color: #fff; }

    .form-control:focus, .form-select:focus {
        border-color: var(--aq);
        box-shadow: 0 0 0 .2rem rgba(192,98,43,.15);
    }

    #areaRango      { display: none; }
    #areaPreview    { display: none; }
    #areaResultados { display: none; }
    #areaConsulta   { display: none; }
</style>
}

<div class="card shadow-sm border-0">
    <div class="comp-header d-flex justify-content-between align-items-center">
        <div>
            <h5><i class="bi bi-calendar2-x me-2"></i>Día Libre por Compensar (DDC)</h5>
            <p>Seleccione el rango (semana actual por defecto), elija los empleados con días DDC y registre la compensación con sus HE del período.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/RecursosHumanos" class="btn btn-sm btn-outline-light">
                <i class="bi bi-arrow-left me-1"></i>Recursos Humanos
            </a>
            <span class="badge bg-white text-dark fw-semibold px-3 py-2" style="font-size:.82rem;">
                <i class="bi bi-building me-1"></i>Aquarius
            </span>
        </div>
    </div>
    <div class="card-body p-3">

        <!-- ── PASO 1: Rango de fechas ── -->
        <div class="section-card">
            <div class="section-card-header">
                <span class="step-badge">1</span> Rango de búsqueda de días DDC
            </div>
            <div class="section-card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-sm-12 col-md-4">
                        <label class="form-label fw-semibold small mb-1">Nombre <small class="text-muted fw-normal">(opcional)</small></label>
                        <input type="text" id="rangoNombre" class="form-control form-control-sm" placeholder="García..." />
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label class="form-label fw-semibold small mb-1">Desde</label>
                        <input type="date" id="rangoDesde" class="form-control form-control-sm" value="@_desde" />
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label class="form-label fw-semibold small mb-1">Hasta</label>
                        <input type="date" id="rangoHasta" class="form-control form-control-sm" value="@_hasta" />
                    </div>
                    <div class="col-sm-6 col-md-2 d-flex align-items-end gap-2">
                        <button id="btnBuscarRango" class="btn btn-sm flex-grow-1" style="background:var(--aq);color:#fff;border-color:var(--aq);" onclick="buscarRango()">
                            <i class="bi bi-search me-1"></i>Buscar
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="limpiarTodo()" title="Limpiar">
                            <i class="bi bi-x-circle"></i>
                        </button>
                    </div>
                </div>
                <!-- Rango HE opcional -->
                <div class="row g-3 align-items-end mt-1">
                    <div class="col-sm-12 col-md-4">
                        <label class="form-label small text-muted mb-1"><i class="bi bi-clock-history me-1"></i>Rango HE <small class="fw-normal">(opcional, por defecto igual al rango)</small></label>
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <input type="date" id="rangoHeDesde" class="form-control form-control-sm" value="@_desde" />
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <input type="date" id="rangoHeHasta" class="form-control form-control-sm" value="@_hasta" />
                    </div>
                </div>
                <div class="rounded mt-3 py-2 px-3 small" style="background:var(--aq-ilt);color:var(--aq-info);border:1px solid #d8d0ef;">
                    <i class="bi bi-info-circle me-1"></i>
                    Se muestran los días con <strong>HE disponibles</strong> y los <strong>días DDC</strong> (falta total sin ausencia formal) para cada empleado en el rango.
                    Seleccione los empleados que desea compensar y haga clic en <em>Calcular Seleccionados</em>.
                </div>
            </div>
        </div>

        <!-- ── PASO 2: Días del rango con checkboxes ── -->
        <div id="areaRango" class="section-card">
            <div class="section-card-header">
                <span class="step-badge">2</span> Días del rango — HE disponibles y DDC candidatos
                <span id="lblRangoInfo" class="ms-auto text-muted fw-normal small"></span>
            </div>
            <div class="p-0">
                <div class="table-responsive">
                    <table class="table table-comp table-hover mb-0">
                        <thead>
                            <tr>
                                <th style="width:36px;">
                                    <input type="checkbox" id="chkTodosRango" class="form-check-input"
                                           title="Marcar/desmarcar todos los empleados DDC" onchange="toggleTodosRango(this)" />
                                </th>
                                <th id="thFotocheck" style="cursor:pointer;user-select:none;" onclick="sortRango('fotocheck')">Fotocheck <span id="sortIconFotocheck">⇅</span></th>
                                <th id="thNombre" style="cursor:pointer;user-select:none;" onclick="sortRango('nombre')">Nombre <span id="sortIconNombre">⇅</span></th>
                                <th>Fecha</th>
                                <th>Día</th>
                                <th>Tipo</th>
                                <th class="text-end">HH. Extra Disp.</th>
                                <th class="text-end">HH. Falta (DDC)</th>
                                <th class="text-center">Marc.</th>
                                <th>Ya Comp.</th>
                            </tr>
                        </thead>
                        <tbody id="bodyRango"></tbody>
                    </table>
                </div>
                <!-- paginación cliente -->
                <div id="areaPaginacionRango" class="d-flex align-items-center gap-2 px-3 py-2 border-top" style="display:none!important;">
                    <button class="btn btn-sm btn-outline-secondary" id="btnPagAnt" onclick="cambiarPagina(-1)" disabled>
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <span id="lblPaginacion" class="small text-muted"></span>
                    <button class="btn btn-sm btn-outline-secondary" id="btnPagSig" onclick="cambiarPagina(1)" disabled>
                        <i class="bi bi-chevron-right"></i>
                    </button>
                    <span class="ms-auto small text-muted">Filas por página:</span>
                    <select id="selTamPagina" class="form-select form-select-sm" style="width:70px;" onchange="cambiarTamPagina()">
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="0">Todos</option>
                    </select>
                </div>
                <div class="d-flex gap-2 align-items-center px-3 py-2 border-top">
                    <button id="btnCalcularSeleccion" class="btn btn-sm" style="color:var(--aq);border-color:var(--aq);" onclick="calcularSeleccion()" disabled>
                        <i class="bi bi-calculator me-1"></i>Calcular Seleccionados
                    </button>
                    <span id="lblSeleccionRango" class="small text-muted ms-2"></span>
                </div>
            </div>
        </div>

        <!-- ── PASO 3: Preview de compensación ── -->
        <div id="areaPreview" class="section-card">
            <div class="section-card-header">
                <span class="step-badge">3</span> Preview de compensación DDC — confirme y registre
                <span id="lblPreviewInfo" class="ms-auto text-muted fw-normal small"></span>
            </div>
            <div class="p-0">
                <div class="table-responsive">
                    <table class="table table-comp table-hover mb-0">
                        <thead>
                            <tr>
                                <th style="width:36px;">
                                    <input type="checkbox" id="chkTodos" class="form-check-input"
                                           title="Marcar/desmarcar todos" onchange="toggleTodos(this)" />
                                </th>
                                <th>Cód.</th>
                                <th>Nombre</th>
                                <th>Fecha DDC</th>
                                <th>Día</th>
                                <th class="text-end">H. Falta (DDC)</th>
                                <th class="text-end">HE a Asignar</th>
                                <th class="text-end">Falta Restante</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody id="bodyPreview"></tbody>
                    </table>
                </div>
                <div class="d-flex gap-2 align-items-center p-3 border-top">
                    <button id="btnRegistrar" class="btn btn-sm" style="background:var(--aq);color:#fff;border-color:var(--aq);" onclick="ejecutarRegistro()" disabled>
                        <i class="bi bi-check2-circle me-1"></i>Registrar Compensación DDC
                    </button>
                    <span id="lblSeleccion" class="small text-muted"></span>
                    <span class="small ms-2" style="color:var(--aq-warn);">
                        <i class="bi bi-exclamation-triangle me-1"></i>Solo se registrarán los empleados seleccionados.
                    </span>
                </div>
            </div>
        </div>

        <!-- ── PASO 4: Resultados ── -->
        <div id="areaResultados" class="section-card">
            <div class="section-card-header">
                <span class="step-badge">4</span> Resultados del registro DDC
                <span id="lblResultadosInfo" class="ms-auto text-muted fw-normal small"></span>
            </div>
            <div class="p-0">
                <div class="table-responsive">
                    <table class="table table-comp table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Cód.</th>
                                <th>Nombre</th>
                                <th>Fecha DDC</th>
                                <th>Día</th>
                                <th class="text-end">H. Falta Total</th>
                                <th class="text-end">HE Asignadas</th>
                                <th class="text-end">Falta Restante</th>
                                <th>Estado</th>
                                <th>Motivo</th>
                            </tr>
                        </thead>
                        <tbody id="bodyResultados"></tbody>
                    </table>
                </div>
                <div class="d-flex gap-2 p-3 border-top align-items-center">
                    <button id="btnCommit" class="btn btn-sm" style="background:var(--aq-ok);color:#fff;border-color:var(--aq-ok);" onclick="hacerCommit()">
                        <i class="bi bi-check-all me-1"></i>Confirmar (COMMIT)
                    </button>
                    <button id="btnRollback" class="btn btn-sm btn-outline-secondary" style="color:var(--aq-err);border-color:var(--aq-err);" onclick="hacerRollback()">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Cancelar (ROLLBACK)
                    </button>
                    <span class="small text-muted ms-2">
                        <i class="bi bi-exclamation-triangle text-warning me-1"></i>
                        La transacción quedará abierta hasta que confirme o cancele.
                    </span>
                </div>
            </div>
        </div>

        <!-- ── PASO 5: Historial / Consulta ── -->
        <div class="section-card">
            <div class="section-card-header" style="cursor:pointer;" data-bs-toggle="collapse" data-bs-target="#collapseConsulta" aria-expanded="false">
                <span class="step-badge" style="background:#6c757d;">5</span> Historial de compensaciones DDC
                <i class="bi bi-chevron-down ms-auto"></i>
            </div>
            <div id="collapseConsulta" class="collapse">
                <div class="section-card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-sm-6 col-md-3">
                            <label class="form-label fw-semibold small mb-1">Código personal <small class="text-muted fw-normal">(opcional)</small></label>
                            <input type="text" id="consPersonal" class="form-control form-control-sm" placeholder="00123..." />
                        </div>
                        <div class="col-sm-6 col-md-2">
                            <label class="form-label fw-semibold small mb-1">Desde</label>
                            <input type="date" id="consFechaIni" class="form-control form-control-sm" value="@_mesInicio" />
                        </div>
                        <div class="col-sm-6 col-md-2">
                            <label class="form-label fw-semibold small mb-1">Hasta</label>
                            <input type="date" id="consFechaFin" class="form-control form-control-sm" value="@_mesFin" />
                        </div>
                        <div class="col-sm-6 col-md-2 d-flex align-items-end">
                            <button id="btnConsultar" class="btn btn-sm w-100" style="background:var(--aq);color:#fff;border-color:var(--aq);" onclick="consultarRango()">
                                <i class="bi bi-search me-1"></i>Consultar
                            </button>
                        </div>
                    </div>
                </div>
                <div id="areaConsulta" class="p-0">
                    <div class="table-responsive">
                        <table class="table table-comp table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>ID Comp.</th>
                                    <th>Cód.</th>
                                    <th>Nombre</th>
                                    <th>Fecha DDC</th>
                                    <th>Fecha HE</th>
                                    <th class="text-end">Tiempo</th>
                                    <th>Estado</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="bodyConsulta"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- ── Modal genérico (alertas / confirmaciones) ──────────────────────── -->
<div class="modal fade" id="modalMsg" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title" id="modalMsgTitle"></h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body small" id="modalMsgBody"></div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal" id="btnMsgCancel" style="display:none">Cancelar</button>
                <button type="button" class="btn btn-sm" id="btnMsgOk" style="background:var(--aq);color:#fff;border-color:var(--aq);">Aceptar</button>
            </div>
        </div>
    </div>
</div>

<!-- ── Modal resumen post-COMMIT ──────────────────────────────────────── -->
<div class="modal fade" id="modalResumen" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-2 aq-modal-header">
                <h6 class="modal-title text-white"><i class="bi bi-list-check me-2"></i>Resumen de Compensaciones DDC Registradas</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalResumenBody"></div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm" style="background:var(--aq);color:#fff;border-color:var(--aq);" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- ── Modal detalle compensación DDC ─────────────────────────────────── -->
<div class="modal fade" id="modalEstado" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header aq-modal-header py-2">
                <h6 class="modal-title"><i class="bi bi-info-circle me-2"></i>Detalle de Compensación DDC</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalEstadoBody">
                <div class="text-center py-4"><div class="spinner-border" style="color:var(--aq-mid)"></div></div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const URL_BASE = '/RecursosHumanos/Aquarius/CompensacionDdc';

let rangoData     = [];   // todos los datos cargados del servidor
let rangoDataFilt = [];   // después de sort/filter
let previewData   = [];
let txAbierta     = false;
let seleccionCods = new Set();
let _lastIdEvento = null;

// paginación cliente
let _pagActual  = 1;
let _tamPagina  = 10;

// ordenamiento
let _sortBy  = 'nombre';
let _sortDir = 'asc';

// ── Utilidades ────────────────────────────────────────────────────────────

function isoADdMmYyyy(iso) {
    if (!iso) return '';
    const [y, m, d] = iso.split('-');
    return `${d}/${m}/${y}`;
}

function msgModal(title, body, { confirm = false } = {}) {
    return new Promise(resolve => {
        document.getElementById('modalMsgTitle').textContent = title;
        document.getElementById('modalMsgBody').innerHTML = body;
        const btnCancel = document.getElementById('btnMsgCancel');
        const btnOk     = document.getElementById('btnMsgOk');
        btnCancel.style.display = confirm ? '' : 'none';
        btnOk.textContent = confirm ? 'Confirmar' : 'Aceptar';
        btnOk.className   = `btn btn-sm ${confirm ? '' : 'btn-outline-secondary'}`;
        if (confirm) { btnOk.style.cssText = 'background:var(--aq);color:#fff;border-color:var(--aq);'; }
        else         { btnOk.style.cssText = ''; }
        const modal = new bootstrap.Modal(document.getElementById('modalMsg'));
        btnOk.onclick = () => { modal.hide(); resolve(true); };
        btnCancel.onclick = () => { modal.hide(); resolve(false); };
        modal.show();
    });
}

function badgeEstadoDdc(e) {
    const map = {
        OK:                   ['badge-ok',      '✓ OK'],
        PARCIAL:              ['badge-parcial',  '~ Parcial'],
        SIN_HE:               ['badge-sin',      '⚠ Sin HE'],
        ERR:                  ['badge-err',      '✗ Error'],
        ADVERTENCIA_REDONDEO: ['badge-warn',     '⚠ Redondeo'],
    };
    const [cls, txt] = map[e] ?? ['badge-sin', e];
    return `<span class="badge rounded-pill ${cls}">${txt}</span>`;
}

function badgeAplicacion(e) {
    return `<span class="badge rounded-pill ${e === 'APLICADA' ? 'badge-aplicada' : 'badge-pendiente'}">${e}</span>`;
}

function setBusy(id, busy, labelHtml) {
    const btn = document.getElementById(id);
    btn.disabled  = busy;
    btn.innerHTML = busy ? '<span class="spinner-border spinner-border-sm me-1"></span>Espere...' : labelHtml;
}

window.addEventListener('beforeunload', () => {
    if (txAbierta) navigator.sendBeacon(`${URL_BASE}/Rollback`);
});

// ── Ordenamiento cliente ──────────────────────────────────────────────────

function sortRango(col) {
    if (_sortBy === col) {
        _sortDir = _sortDir === 'asc' ? 'desc' : 'asc';
    } else {
        _sortBy  = col;
        _sortDir = 'asc';
    }
    actualizarIconosSort();
    aplicarSortYPaginar();
}

function actualizarIconosSort() {
    ['fotocheck', 'nombre'].forEach(c => {
        const el = document.getElementById('sortIcon' + c.charAt(0).toUpperCase() + c.slice(1));
        if (!el) return;
        el.textContent = _sortBy === c ? (_sortDir === 'asc' ? '↑' : '↓') : '⇅';
    });
}

function aplicarSortYPaginar() {
    rangoDataFilt = [...rangoData].sort((a, b) => {
        let va = '', vb = '';
        if (_sortBy === 'fotocheck') { va = a.numFotocheck ?? ''; vb = b.numFotocheck ?? ''; }
        else                         { va = a.nombreCompleto ?? ''; vb = b.nombreCompleto ?? ''; }
        return _sortDir === 'asc' ? va.localeCompare(vb) : vb.localeCompare(va);
    });
    _pagActual = 1;
    renderPagina();
    actualizarPaginacion();
}

// ── Paginación cliente ────────────────────────────────────────────────────

function cambiarPagina(delta) {
    const totalPags = _tamPagina === 0 ? 1 : Math.ceil(rangoDataFilt.length / _tamPagina);
    const nueva = _pagActual + delta;
    if (nueva < 1 || nueva > totalPags) return;
    _pagActual = nueva;
    renderPagina();
    actualizarPaginacion();
}

function cambiarTamPagina() {
    _tamPagina = parseInt(document.getElementById('selTamPagina').value) || 0;
    _pagActual = 1;
    renderPagina();
    actualizarPaginacion();
}

function actualizarPaginacion() {
    const total = rangoDataFilt.length;
    const totalPags = _tamPagina === 0 ? 1 : Math.ceil(total / _tamPagina) || 1;
    const area = document.getElementById('areaPaginacionRango');
    area.style.display = total > 0 ? 'flex' : 'none';
    document.getElementById('lblPaginacion').textContent =
        _tamPagina === 0
            ? `Todos (${total} filas)`
            : `Página ${_pagActual} de ${totalPags} (${total} filas)`;
    document.getElementById('btnPagAnt').disabled = _pagActual <= 1;
    document.getElementById('btnPagSig').disabled = _pagActual >= totalPags;
}

function renderPagina() {
    const pagina = _tamPagina === 0
        ? rangoDataFilt
        : rangoDataFilt.slice((_pagActual - 1) * _tamPagina, _pagActual * _tamPagina);
    renderRangoFilas(pagina);
}

// ── PASO 1: Buscar rango DDC ──────────────────────────────────────────────

async function buscarRango() {
    const desde      = document.getElementById('rangoDesde').value;
    const hasta      = document.getElementById('rangoHasta').value;
    const nombre     = document.getElementById('rangoNombre').value.trim();
    const heDesde    = document.getElementById('rangoHeDesde').value;
    const heHasta    = document.getElementById('rangoHeHasta').value;
    if (!desde || !hasta) { await msgModal('Aviso', '<p>Ingrese el rango de fechas.</p>'); return; }

    seleccionCods = new Set();
    setBusy('btnBuscarRango', true, 'Buscando...');

    try {
        const params = new URLSearchParams({
            fechaInicio: isoADdMmYyyy(desde),
            fechaFin:    isoADdMmYyyy(hasta),
            ...(nombre   && { nombre }),
            ...(heDesde  && { fechaHeInicio: isoADdMmYyyy(heDesde) }),
            ...(heHasta  && { fechaHeFin:    isoADdMmYyyy(heHasta) }),
        });
        const res  = await fetch(`${URL_BASE}/ListarDdcRango?${params}`);
        const json = await res.json();
        if (!json.ok) { await msgModal('Error', `<p>${json.error}</p>`); return; }
        rangoData = json.data ?? [];
        _sortBy = 'nombre'; _sortDir = 'asc';
        actualizarIconosSort();
        aplicarSortYPaginar();
        document.getElementById('areaRango').style.display = 'block';
        document.getElementById('areaPreview').style.display = 'none';
        document.getElementById('areaResultados').style.display = 'none';
    } catch (e) {
        await msgModal('Error de red', `<p>${e.message}</p>`);
    } finally {
        setBusy('btnBuscarRango', false, '<i class="bi bi-search me-1"></i>Buscar');
    }
}

function renderRango(data) {
    rangoData = data;
    aplicarSortYPaginar();
    document.getElementById('areaRango').style.display = 'block';
    document.getElementById('areaPreview').style.display = 'none';
    document.getElementById('areaResultados').style.display = 'none';
}

function renderRangoFilas(data) {
    const tbody = document.getElementById('bodyRango');
    tbody.innerHTML = '';

    if (!rangoDataFilt.length) {
        tbody.innerHTML = `<tr><td colspan="9" class="text-center text-muted py-3">
            Sin días DDC ni HE disponibles en el rango indicado.</td></tr>`;
        actualizarConteoRango();
        return;
    }

    data.forEach(r => {
        const esDdc  = r.tipoDia === 'DDC';
        const esHe   = r.tipoDia === 'HE';
        const esBloq = r.tipoDia === 'BLOQ_LOGIX';
        const yaComp = r.yaCompensado === 'S';

        const bloqTip = esBloq
            ? `Bloq. por LOGIX C_TIPO=07` +
              (r.logixDescMotivo ? ` · ${r.logixDescMotivo}`    : '') +
              (r.logixCmotivo    ? ` (cód: ${r.logixCmotivo})`  : '') +
              (r.logixDinicio    ? ` · Desde: ${r.logixDinicio}` : '') +
              (r.logixDfinal     ? ` · Hasta: ${r.logixDfinal}`  : '')
            : '';
        const tipoBadge = esDdc
            ? `<span class="badge rounded-pill badge-ddc">DDC</span>`
            : esHe
                ? `<span class="badge rounded-pill badge-he">HE</span>`
                : esBloq
                    ? `<span class="badge rounded-pill badge-bloq" title="${bloqTip}">&#x1F512; BLOQ</span>`
                    : `<span class="badge rounded-pill" style="background:#f1f3f5;color:#6c757d;">${r.tipoDia ?? ''}</span>`;

        const heCell    = r.minHe    > 0 ? `<span class="badge rounded-pill badge-he">${r.horasHe}</span>` : '<span class="text-muted">—</span>';
        const faltaCell = r.minFalta > 0 ? `<span class="badge rounded-pill badge-ddc">${r.horasFalta}</span>` : '<span class="text-muted">—</span>';
        const yaCell    = yaComp ? `<span class="badge rounded-pill badge-ok">✓ Sí</span>` : '<span class="text-muted">—</span>';
        const marcCell  = (r.numMarcaciones ?? 0) > 0
            ? `<span class="badge" style="background:#f1f3f5;color:#495057;">${r.numMarcaciones}</span>`
            : '<span class="text-muted">—</span>';

        const puedeMarcar = esDdc && !yaComp;
        const isChecked   = seleccionCods.has(r.codPersonal ?? '');
        tbody.insertAdjacentHTML('beforeend', `
          <tr class="${!puedeMarcar ? 'text-muted' : ''}">
            <td>
              <input type="checkbox" class="form-check-input chk-rango"
                     data-cod="${r.codPersonal ?? ''}"
                     ${!puedeMarcar ? 'disabled' : ''}
                     ${isChecked && puedeMarcar ? 'checked' : ''}
                     onchange="onCheckRango(this)" />
            </td>
            <td>${r.numFotocheck ?? ''}</td>
            <td class="text-truncate" style="max-width:220px;" title="${r.nombreCompleto ?? ''}">${r.nombreCompleto ?? ''}</td>
            <td><span class="badge" style="background:var(--aq-lt);color:var(--aq-dk);">${r.fechamarStr ?? ''}</span></td>
            <td><span class="badge" style="background:#f1f3f5;color:#495057;">${r.diaSemana ?? ''}</span></td>
            <td>${tipoBadge}</td>
            <td class="text-end">${heCell}</td>
            <td class="text-end">${faltaCell}</td>
            <td class="text-center">${marcCell}</td>
            <td>${yaCell}</td>
          </tr>`);
    });

    actualizarConteoRango();
}

function onCheckRango(chk) {
    if (chk.checked) seleccionCods.add(chk.dataset.cod);
    else             seleccionCods.delete(chk.dataset.cod);
    actualizarConteoRango();
    sincronizarChkTodosRango();
}

function toggleTodosRango(chk) {
    // Solo afecta la página visible
    document.querySelectorAll('.chk-rango:not(:disabled)').forEach(c => {
        c.checked = chk.checked;
        if (chk.checked) seleccionCods.add(c.dataset.cod);
        else             seleccionCods.delete(c.dataset.cod);
    });
    actualizarConteoRango();
}

function sincronizarChkTodosRango() {
    const todos    = document.querySelectorAll('.chk-rango:not(:disabled)').length;
    const marcados = document.querySelectorAll('.chk-rango:not(:disabled):checked').length;
    const chk = document.getElementById('chkTodosRango');
    chk.indeterminate = marcados > 0 && marcados < todos;
    chk.checked       = todos > 0 && marcados === todos;
}

function actualizarConteoRango() {
    const total    = document.querySelectorAll('.chk-rango').length;
    const marcados = seleccionCods.size;
    document.getElementById('lblRangoInfo').textContent = `${rangoDataFilt.length} fila(s)`;
    document.getElementById('lblSeleccionRango').textContent =
        marcados > 0 ? `${marcados} empleado(s) seleccionado(s)` : 'Seleccione al menos un empleado con DDC';
    document.getElementById('btnCalcularSeleccion').disabled = marcados === 0;
    sincronizarChkTodosRango();
}

// ── PASO 2: Calcular preview ──────────────────────────────────────────────

async function calcularSeleccion() {
    if (!seleccionCods.size) return;
    const desde = document.getElementById('rangoDesde').value;
    const hasta = document.getElementById('rangoHasta').value;

    setBusy('btnCalcularSeleccion', true, 'Calculando...');

    try {
        const params = new URLSearchParams({
            fechaInicio:   isoADdMmYyyy(desde),
            fechaFin:      isoADdMmYyyy(hasta),
            listaPersonal: [...seleccionCods].join(',')
        });
        const res  = await fetch(`${URL_BASE}/Calcular`, { method: 'POST', body: params });
        const json = await res.json();
        if (!json.ok) { await msgModal('Error', `<p>${json.error}</p>`); return; }
        previewData = json.data ?? [];
        renderPreview(previewData);
    } catch (e) {
        await msgModal('Error de red', `<p>${e.message}</p>`);
    } finally {
        setBusy('btnCalcularSeleccion', false, '<i class="bi bi-calculator me-1"></i>Calcular Seleccionados');
    }
}

function renderPreview(data) {
    const tbody = document.getElementById('bodyPreview');
    tbody.innerHTML = '';

    if (!data.length) {
        tbody.innerHTML = `<tr><td colspan="9" class="text-center text-muted py-3">
            Sin DDC para compensar en el rango indicado.</td></tr>`;
        document.getElementById('areaPreview').style.display = 'block';
        actualizarConteo();
        return;
    }

    data.forEach((r, i) => {
        const sinHe = (r.minHeAsignadasSim ?? 0) === 0;
        tbody.insertAdjacentHTML('beforeend', `
          <tr class="${sinHe ? 'table-light text-muted' : ''}" data-idx="${i}">
            <td>
              <input type="checkbox" class="form-check-input chk-prev"
                     data-cod="${r.codPersonal}"
                     ${sinHe ? 'disabled' : 'checked'}
                     onchange="actualizarConteo()" />
            </td>
            <td><code>${r.codPersonal}</code></td>
            <td class="text-truncate" style="max-width:200px;" title="${r.nombreCompleto ?? ''}">${r.nombreCompleto ?? ''}</td>
            <td><span class="badge" style="background:var(--aq-lt);color:var(--aq-dk);">${r.fechaDdcStr ?? ''}</span></td>
            <td><span class="badge" style="background:#f1f3f5;color:#495057;">${r.diaSemana ?? ''}</span></td>
            <td class="text-end">${r.horasFalta ?? '00:00'}</td>
            <td class="text-end fw-bold" style="color:var(--aq-ok);">${r.horasHeAsignadasSim ?? '00:00'}</td>
            <td class="text-end ${(r.minFaltaRestanteSim ?? 0) > 0 ? 'text-warning fw-semibold' : ''}">
              ${(r.minFaltaRestanteSim ?? 0) > 0 ? r.horasFaltaRestanteSim : '<span class="text-muted">—</span>'}
            </td>
            <td>${badgeEstadoDdc(r.estado)}</td>
          </tr>`);
    });

    document.getElementById('areaPreview').style.display = 'block';
    document.getElementById('areaResultados').style.display = 'none';
    actualizarConteo();
    sincronizarChkTodos();
}

function toggleTodos(chk) {
    document.querySelectorAll('.chk-prev:not(:disabled)').forEach(c => c.checked = chk.checked);
    actualizarConteo();
}

function sincronizarChkTodos() {
    const todos    = document.querySelectorAll('.chk-prev:not(:disabled)').length;
    const marcados = document.querySelectorAll('.chk-prev:not(:disabled):checked').length;
    const chkM = document.getElementById('chkTodos');
    chkM.indeterminate = marcados > 0 && marcados < todos;
    chkM.checked       = marcados > 0 && marcados === todos;
}

function actualizarConteo() {
    const total    = document.querySelectorAll('.chk-prev').length;
    const sinHe    = document.querySelectorAll('.chk-prev:disabled').length;
    const marcados = document.querySelectorAll('.chk-prev:not(:disabled):checked').length;
    document.getElementById('lblPreviewInfo').textContent =
        `${total} DDC(s) — ${sinHe} sin HE disponibles`;
    document.getElementById('lblSeleccion').textContent =
        marcados > 0 ? `${marcados} DDC(s) seleccionado(s)` : 'Seleccione al menos uno';
    document.getElementById('btnRegistrar').disabled = marcados === 0;
    sincronizarChkTodos();
}

// ── PASO 3: Registrar ─────────────────────────────────────────────────────

async function ejecutarRegistro() {
    const seleccionados = [...document.querySelectorAll('.chk-prev:not(:disabled):checked')];
    if (!seleccionados.length) return;

    const codsUnicos = [...new Set(seleccionados.map(c => c.dataset.cod))];
    const desde = document.getElementById('rangoDesde').value;
    const hasta = document.getElementById('rangoHasta').value;

    const ok = await msgModal('Confirmar registro',
        `<p>Se registrará la compensación DDC para <strong>${codsUnicos.length}</strong> empleado(s) en el rango indicado.</p>
         <div class="rounded py-2 px-3 small mt-2" style="background:var(--aq-wlt);color:var(--aq-warn);border:1px solid var(--aq-mid);">
           <i class="bi bi-exclamation-triangle me-1"></i>La transacción quedará abierta hasta que confirme o cancele.
         </div>`,
        { confirm: true });
    if (!ok) return;

    setBusy('btnRegistrar', true, 'Registrando...');

    try {
        const params = new URLSearchParams({
            fechaInicio:   isoADdMmYyyy(desde),
            fechaFin:      isoADdMmYyyy(hasta),
            listaPersonal: codsUnicos.join(',')
        });
        const res  = await fetch(`${URL_BASE}/RegistrarMasivo`, { method: 'POST', body: params });
        const json = await res.json();
        if (!json.ok) { await msgModal('Error', `<p>${json.error}</p>`); return; }
        txAbierta = true;
        _lastIdEvento = json.data?.find(r => r.idEvento)?.idEvento ?? null;
        renderResultados(json.data ?? []);
        document.getElementById('areaPreview').style.display = 'none';
    } catch (e) {
        await msgModal('Error de red', `<p>${e.message}</p>`);
    } finally {
        setBusy('btnRegistrar', false, '<i class="bi bi-check2-circle me-1"></i>Registrar Compensación DDC');
    }
}

function renderResultados(data) {
    const tbody = document.getElementById('bodyResultados');
    tbody.innerHTML = '';
    let ok = 0, parcial = 0, sinHe = 0, err = 0;

    data.forEach(r => {
        if      (r.estado === 'OK')                   ok++;
        else if (r.estado === 'PARCIAL')              parcial++;
        else if (r.estado === 'SIN_HE')               sinHe++;
        else if (r.estado === 'ADVERTENCIA_REDONDEO') ok++;
        else                                          err++;

        tbody.insertAdjacentHTML('beforeend', `
          <tr>
            <td><code>${r.codPersonal}</code></td>
            <td class="text-truncate" style="max-width:200px;">${r.nombreCompleto ?? ''}</td>
            <td><span class="badge" style="background:var(--aq-lt);color:var(--aq-dk);">${r.fechaDdcStr ?? ''}</span></td>
            <td><span class="badge" style="background:#f1f3f5;color:#495057;">${r.diaSemana ?? ''}</span></td>
            <td class="text-end">${r.horasFaltaTotal ?? '00:00'}</td>
            <td class="text-end fw-bold" style="color:var(--aq-ok);">${r.horasHeAsignadas ?? '00:00'}</td>
            <td class="text-end ${(r.minFaltaRestante ?? 0) > 0 ? 'text-warning fw-semibold' : ''}">
              ${(r.minFaltaRestante ?? 0) > 0 ? r.horasFaltaRestante : '<span class="text-muted">—</span>'}
            </td>
            <td>${badgeEstadoDdc(r.estado)}</td>
            <td class="small text-muted">${r.motivo ?? ''}</td>
          </tr>`);
    });

    document.getElementById('lblResultadosInfo').textContent =
        `✅ ${ok} OK  ~ ${parcial} parcial(es)  ⚠️ ${sinHe} sin HE  ❌ ${err} error(es)`;
    document.getElementById('areaResultados').style.display = 'block';
    document.getElementById('areaResultados').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// ── PASO 4: COMMIT / ROLLBACK ─────────────────────────────────────────────

async function hacerCommit() {
    const ok = await msgModal('Confirmar', '<p>¿Confirma el <strong>COMMIT</strong>? Los cambios quedarán guardados.</p>', { confirm: true });
    if (!ok) return;
    try {
        const res  = await fetch(`${URL_BASE}/Commit`, { method: 'POST' });
        const json = await res.json();
        if (json.ok) {
            txAbierta = false;
            mostrarResumenPostCommit();
        } else if (json.sinTransaccion) {
            txAbierta = false;
            await msgModal('⚠️ Sesión perdida',
                '<p>El servidor fue reiniciado y la transacción ya no existe en Oracle. ' +
                'Los cambios <strong>NO fueron guardados</strong>. Vuelva a realizar el registro.</p>');
            _limpiar();
        } else {
            await msgModal('Error', `<p>${json.error}</p>`);
        }
    } catch (e) { await msgModal('Error de red', `<p>${e.message}</p>`); }
}

async function mostrarResumenPostCommit() {
    if (!_lastIdEvento) {
        await msgModal('✅ Éxito', '<p>Compensaciones DDC confirmadas y guardadas correctamente.</p>');
        _limpiarYRecargar();
        return;
    }
    try {
        const res  = await fetch(`${URL_BASE}/ConsultarEvento?idEvento=${_lastIdEvento}`);
        const json = await res.json();
        if (!json.ok || !json.data?.length) {
            await msgModal('✅ Éxito', '<p>Compensaciones DDC confirmadas y guardadas correctamente.</p>');
            _limpiarYRecargar();
            return;
        }

        const porEmp = {};
        json.data.forEach(r => {
            const k = r.codPersonal;
            if (!porEmp[k]) porEmp[k] = { codPersonal: k, nombreCompleto: r.nombreCompleto, filas: [] };
            porEmp[k].filas.push(r);
        });

        let html = '<div class="alert alert-success py-2 small mb-3"><i class="bi bi-check-circle me-1"></i><strong>Compensaciones DDC guardadas correctamente.</strong></div>';
        html += '<p class="small text-muted mb-2">Detalle por empleado:</p>';

        Object.values(porEmp).forEach(emp => {
            const totalMin = emp.filas.reduce((s, r) => s + (r.tiempoMin ?? 0), 0);
            const hh = String(Math.floor(totalMin / 60)).padStart(2, '0');
            const mm = String(totalMin % 60).padStart(2, '0');

            html += `<div class="card mb-2">`;
            html += `<div class="card-header py-1 px-2 d-flex justify-content-between align-items-center" style="background:var(--aq-lt);">`;
            html += `<span class="fw-semibold small"><code>${emp.codPersonal}</code> ${emp.nombreCompleto ?? ''}</span>`;
            html += `<span class="badge" style="background:var(--aq-ok);color:#fff;">${hh}:${mm} compensadas</span>`;
            html += `</div>`;
            html += `<div class="table-responsive"><table class="table table-sm table-hover mb-0 small">`;
            html += `<thead><tr><th>ID</th><th>Origen (HE)</th><th>Destino (DDC)</th><th>Tipo Comp.</th><th class="text-end">Tiempo</th><th>Estado Origen</th><th>Estado Destino</th></tr></thead><tbody>`;
            emp.filas.forEach(r => {
                const oriEstado = r.oriAlerta06 === 'EC'
                    ? `<span class="badge" style="background:var(--aq-ok);color:#fff;">EC ✔ HE agotadas</span>`
                    : r.oriAlerta06
                        ? `<span class="badge" style="background:var(--aq-wlt);color:var(--aq-warn);">${r.oriAlerta06} ${r.oriHeActual ?? ''}</span>`
                        : `<span class="text-muted">—</span>`;
                const desEstado = r.destAlerta02 === 'FC'
                    ? `<span class="badge" style="background:var(--aq-ok);color:#fff;">FC ✔ Compensado</span>`
                    : r.destAlerta02 === 'FT'
                        ? `<span class="badge" style="background:var(--aq-wlt);color:var(--aq-warn);">FT ∼ Parcial ${r.destFaltaActual ?? ''}</span>`
                        : `<span class="text-muted">—</span>`;
                html += `<tr>`;
                html += `<td><code style="color:var(--aq-ok);">${r.idCompen ?? '—'}</code></td>`;
                html += `<td>${r.fechaOrigenStr ?? ''}</td>`;
                html += `<td>${r.fechaDestinoStr ?? ''}</td>`;
                html += `<td>${r.tipoCompensacion ?? ''}</td>`;
                html += `<td class="text-end fw-bold">${r.tiempoHhMi ?? '—'}</td>`;
                html += `<td>${oriEstado}</td>`;
                html += `<td>${desEstado}</td>`;
                html += `</tr>`;
            });
            html += `</tbody></table></div></div>`;
        });

        document.getElementById('modalResumenBody').innerHTML = html;
        const modalEl = document.getElementById('modalResumen');
        modalEl.addEventListener('hidden.bs.modal', () => _limpiarYRecargar(), { once: true });
        new bootstrap.Modal(modalEl).show();
    } catch {
        await msgModal('✅ Éxito', '<p>Compensaciones DDC confirmadas y guardadas correctamente.</p>');
        _limpiarYRecargar();
    }
}

async function hacerRollback() {
    const ok = await msgModal('Cancelar', '<p>¿Confirma el <strong>ROLLBACK</strong>? Todos los cambios serán revertidos.</p>', { confirm: true });
    if (!ok) return;
    try {
        const res  = await fetch(`${URL_BASE}/Rollback`, { method: 'POST' });
        const json = await res.json();
        if (json.ok) {
            txAbierta = false;
            document.getElementById('areaResultados').style.display = 'none';
            if (previewData.length) renderPreview(previewData);
            await msgModal('Cancelado', '<p>Compensaciones canceladas. Los datos NO fueron modificados.</p>');
        } else await msgModal('Error', `<p>${json.error}</p>`);
    } catch (e) { await msgModal('Error de red', `<p>${e.message}</p>`); }
}

// ── PASO 5: Historial / Consulta ──────────────────────────────────────────

async function consultarRango() {
    const personal    = document.getElementById('consPersonal').value.trim();
    const fechaInicio = isoADdMmYyyy(document.getElementById('consFechaIni').value);
    const fechaFin    = isoADdMmYyyy(document.getElementById('consFechaFin').value);
    if (!fechaInicio || !fechaFin) { await msgModal('Aviso', '<p>Ingrese las fechas de consulta.</p>'); return; }

    setBusy('btnConsultar', true, 'Consultando...');
    try {
        const params = new URLSearchParams({ fechaInicio, fechaFin, ...(personal && { codPersonal: personal }) });
        const res  = await fetch(`${URL_BASE}/ConsultarRango?${params}`);
        const json = await res.json();
        if (!json.ok) { await msgModal('Error', `<p>${json.error}</p>`); return; }
        renderConsulta(json.data ?? []);
    } catch (e) {
        await msgModal('Error de red', `<p>${e.message}</p>`);
    } finally {
        setBusy('btnConsultar', false, '<i class="bi bi-search me-1"></i>Consultar');
    }
}

function renderConsulta(data) {
    const tbody = document.getElementById('bodyConsulta');
    tbody.innerHTML = '';
    if (!data.length) {
        tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-3">Sin registros en el rango indicado.</td></tr>';
    } else {
        data.forEach(r => {
                const idEvento = r.evento ? r.evento.replace(/^D/i, '') : null;
                const btnVer = idEvento
                    ? `<button class="btn btn-outline-secondary btn-sm py-0 px-1" onclick="verEstadoDdc(${idEvento})" title="Ver detalle evento ${idEvento}"><i class="bi bi-eye"></i></button>`
                    : '';
            tbody.insertAdjacentHTML('beforeend', `
              <tr>
                <td><code>${r.idCompen ?? '—'}</code></td>
                <td><code>${r.codPersonal ?? ''}</code></td>
                <td class="text-truncate" style="max-width:180px;">${r.nombreCompleto ?? ''}</td>
                <td><span class="badge" style="background:var(--aq-elt);color:var(--aq-err);">${r.fechaDestinoStr ?? ''}</span></td>
                <td><span class="badge" style="background:var(--aq-wlt);color:var(--aq-warn);">${r.fechaOrigenStr ?? ''}</span></td>
                <td class="text-end fw-semibold">${r.tiempoHhMi ?? ''}</td>
                <td>${badgeAplicacion(r.estadoAplicacion ?? 'PENDIENTE')}</td>
                <td>${btnVer}</td>
              </tr>`);
        });
    }
    document.getElementById('areaConsulta').style.display = 'block';
}

async function verEstadoDdc(idCompen) {
    document.getElementById('modalEstadoBody').innerHTML =
        '<div class="text-center py-4"><div class="spinner-border" style="color:var(--aq-mid)"></div></div>';
    new bootstrap.Modal(document.getElementById('modalEstado')).show();
    try {
        const res  = await fetch(`${URL_BASE}/ConsultarEvento?idEvento=${idCompen}`);
        const json = await res.json();
        if (!json.ok || !json.data?.length) {
            document.getElementById('modalEstadoBody').innerHTML =
                `<div class="rounded p-3" style="background:var(--aq-elt);color:var(--aq-err);">Sin datos para este registro.</div>`;
            return;
        }
        const filas = json.data;
        const r0    = filas[0];
        const nombre = r0.nombreCompleto ?? '';
        let html = `<div class="row g-3 small">
          <div class="col-12">
            <table class="table table-sm table-borderless mb-2">
              <tr><th class="text-muted fw-normal" style="width:130px;">Personal:</th>
                  <td><code>${r0.codPersonal ?? ''}</code> — ${nombre}</td>
                  <th class="text-muted fw-normal ps-3">ID Evento:</th>
                  <td><code>${r0.idEvento ?? idCompen}</code></td></tr>
            </table>
          </div>
          <div class="col-12">
            <div class="table-responsive">
              <table class="table table-sm table-hover table-bordered mb-0">
                <thead style="background:var(--aq);color:#fff;">
                  <tr><th>ID Comp.</th><th>Origen (HE)</th><th>Destino (DDC)</th>
                      <th>Tipo</th><th class="text-end">Tiempo</th>
                      <th>Est. Origen</th><th>Est. Destino</th></tr>
                </thead><tbody>`;
        filas.forEach(f => {
            const oriEst = f.oriAlerta06 === 'EC'
                ? `<span class="badge" style="background:var(--aq-ok);color:#fff;">EC ✔</span>`
                : f.oriAlerta06
                    ? `<span class="badge" style="background:var(--aq-wlt);color:var(--aq-warn);">${f.oriAlerta06}</span>`
                    : '—';
            const desEst = f.destAlerta02 === 'FC'
                ? `<span class="badge" style="background:var(--aq-ok);color:#fff;">FC ✔</span>`
                : f.destAlerta02 === 'FT'
                    ? `<span class="badge" style="background:var(--aq-wlt);color:var(--aq-warn);">FT ∼ Parcial</span>`
                    : '—';
            html += `<tr>
              <td><code style="color:var(--aq-ok);">${f.idCompen ?? '—'}</code></td>
              <td>${f.fechaOrigenStr ?? ''}</td>
              <td>${f.fechaDestinoStr ?? ''}</td>
              <td>${f.tipoCompensacion ?? ''}</td>
              <td class="text-end fw-bold">${f.tiempoHhMi ?? '—'}</td>
              <td>${oriEst}</td>
              <td>${desEst}</td>
            </tr>`;
        });
        html += `</tbody></table></div></div></div>`;
        document.getElementById('modalEstadoBody').innerHTML = html;
    } catch (e) {
        document.getElementById('modalEstadoBody').innerHTML =
            `<div class="alert alert-danger">Error: ${e.message}</div>`;
    }
}

// ── Helpers ───────────────────────────────────────────────────────────────

function limpiarTodo() {
    if (txAbierta) {
        msgModal('Transacción abierta', '<p>Hay una transacción en curso. ¿Desea cancelarla y limpiar?</p>', { confirm: true })
            .then(ok => {
                if (!ok) return;
                fetch(`${URL_BASE}/Rollback`, { method: 'POST' });
                txAbierta = false;
                _limpiar();
            });
        return;
    }
    _limpiar();
}

function _limpiar() {
    rangoData     = [];
    rangoDataFilt = [];
    previewData   = [];
    seleccionCods = new Set();
    _lastIdEvento = null;
    _pagActual    = 1;
    document.getElementById('areaRango').style.display      = 'none';
    document.getElementById('areaPreview').style.display    = 'none';
    document.getElementById('areaResultados').style.display = 'none';
    document.getElementById('areaConsulta').style.display   = 'none';
    document.getElementById('bodyRango').innerHTML       = '';
    document.getElementById('bodyPreview').innerHTML     = '';
    document.getElementById('bodyResultados').innerHTML  = '';
    document.getElementById('bodyConsulta').innerHTML    = '';
    document.getElementById('lblRangoInfo').textContent      = '';
    document.getElementById('lblPreviewInfo').textContent    = '';
    document.getElementById('lblSeleccion').textContent      = '';
    document.getElementById('lblSeleccionRango').textContent = '';
    document.getElementById('btnRegistrar').disabled         = true;
    document.getElementById('btnCalcularSeleccion').disabled = true;
    actualizarPaginacion();
}

function _limpiarYRecargar() {
    _limpiar();
    buscarRango();
}
</script>
}
