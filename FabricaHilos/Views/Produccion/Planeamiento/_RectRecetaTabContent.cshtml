@using FabricaHilos.Models.Produccion.Planeamiento
@model IEnumerable<PlnRectificacionReceta>
@{
	var lista        = Model.ToList();
	var nPendientes  = lista.Count(x => x.EstaPendiente);
	var nEnProceso   = lista.Count(x => x.EstaEnProceso);
	var nAprobadas   = lista.Count(x => x.EstaAprobada);
	var estadoSel    = ViewBag.FiltroEstadoRec as string ?? "";
	var urlForm      = Url.Action("RectificacionRecetaPartial", "Planeamiento");
	var opEstados    = new System.Collections.Generic.List<(string Val, string Lbl)>
	{
		("",  "Todos"),
		("1", "Pendiente"),
		("3", "En Proceso"),
		("6", "Aprobada"),
		("9", "Anulada"),
	};
}

@* Filtro de estado (oculto) *@
<form method="get" action="@urlForm" class="d-none align-items-center gap-2 flex-wrap mb-3 pt-1" data-no-loading style="display:none;">
	<input type="hidden" name="tab" value="rect" />
	<i class="bi bi-funnel text-muted"></i>
	<label class="text-muted small mb-0">Estado:</label>
	<select name="estado" class="form-select form-select-sm" style="width:160px">
		@foreach (var op in opEstados)
		{
			if (op.Val == estadoSel)
			{
				<option value="@op.Val" selected="selected">@op.Lbl</option>
			}
			else
			{
				<option value="@op.Val">@op.Lbl</option>
			}
		}
	</select>
	<button type="submit" class="btn btn-outline-secondary btn-sm">
		<i class="bi bi-search me-1"></i>Filtrar
	</button>
</form>

@* KPIs *@
<div class="d-flex gap-2 flex-wrap mb-3">
	<span class="pend-kpi">
		<i class="bi bi-flask" style="color:#90cdf4;"></i>
		<span class="pend-kpi-val">@lista.Count</span>
		<span class="text-secondary fw-medium">rectificaciones</span>
	</span>
	<span class="pend-kpi" style="@(nPendientes > 0 ? "" : "opacity:.45")">
		<i class="bi bi-hourglass-split" style="color:#d97706;"></i>
		<span class="pend-kpi-val" style="@(nPendientes > 0 ? "color:#d97706;" : "")">@nPendientes</span>
		<span class="text-secondary fw-medium">pendientes</span>
	</span>
	<span class="pend-kpi" style="@(nEnProceso > 0 ? "" : "opacity:.45")">
		<i class="bi bi-arrow-repeat" style="color:#2563eb;"></i>
		<span class="pend-kpi-val" style="@(nEnProceso > 0 ? "color:#2563eb;" : "")">@nEnProceso</span>
		<span class="text-secondary fw-medium">en proceso</span>
	</span>
	<span class="pend-kpi" style="@(nAprobadas > 0 ? "" : "opacity:.45")">
		<i class="bi bi-check-circle" style="color:#16a34a;"></i>
		<span class="pend-kpi-val" style="@(nAprobadas > 0 ? "color:#16a34a;" : "")">@nAprobadas</span>
		<span class="text-secondary fw-medium">aprobadas</span>
	</span>
</div>

@if (!lista.Any())
{
	<div class="alert alert-info">
		<i class="bi bi-info-circle me-2"></i>No hay rectificaciones de receta con el filtro seleccionado.
	</div>
}
else
{
	<div class="d-flex align-items-center justify-content-between mb-2">
		<div class="d-flex align-items-center gap-2">
			<label class="form-label mb-0 small text-muted">Filas:</label>
			<select id="tblRectReceta-pgsize" class="form-select form-select-sm" style="width:80px;">
				<option value="20" selected>20</option>
				<option value="50">50</option>
				<option value="100">100</option>
				<option value="200">200</option>
			</select>
		</div>
	</div>
		<div class="table-responsive">
			<table class="table table-sm table-hover align-middle mb-0 pend-tbl" id="tblRectReceta">
			<thead>
				<tr>
					<th class="text-center">F. Registro</th>
					<th>Area</th>
					<th>Supervisor</th>
					<th>Partida</th>
					<th>Material</th>
					<th>Color Técnico</th>
					<th>Cliente</th>
					<th>Defecto</th>
					<th>Laboratorista</th>
					<th>Máq. Producción</th>
					<th class="text-center">F. Entrega</th>
					<th class="text-center">Estado</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var item in lista)
				{
					var rowCss = item.EstaPendiente ? "table-warning" :
								 item.EstaEnProceso ? "" :
								 item.EstaAprobada  ? "table-success" : "table-secondary";
					<tr class="@rowCss">
						<td class="text-center text-muted">@(item.Fecha.HasValue ? item.Fecha.Value.ToString("dd/MM/yy") : "—")</td>
						<td>
							@if (!string.IsNullOrWhiteSpace(item.Area))
							{
								var areaCss   = item.Area == "CC" ? "bg-danger" : item.Area == "PT" ? "bg-primary" : "bg-info text-dark";
								var areaLabel = item.Area == "CC" ? "Control Cal." : item.Area == "PT" ? "Tintorería" : item.Area;
								<span class="badge @areaCss">@areaLabel</span>
							}
						</td>
						<td style="font-size:.78rem;">@item.UserRegistro</td>
						<td class="fw-semibold" style="font-size:.82rem;">@item.Partida</td>
						<td style="font-size:.78rem;max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@item.Material">@item.Material</td>
						<td style="font-size:.78rem;" class="text-muted">@item.ColorTecnico</td>
						<td style="font-size:.78rem;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@item.DescCliente">@item.DescCliente</td>
						<td style="font-size:.78rem;">
							@if (!string.IsNullOrWhiteSpace(item.DescDefecto))
							{
								<span class="badge bg-secondary">@item.DescDefecto</span>
							}
						</td>
						<td style="font-size:.78rem;">@item.DescLabo</td>
						<td style="font-size:.78rem;">
							@if (!string.IsNullOrWhiteSpace(item.DescMaqProd))
							{
								<span title="@item.MaqProd">@item.DescMaqProd</span>
							}
							else if (!string.IsNullOrWhiteSpace(item.MaqProd))
							{
								<span>@item.MaqProd</span>
							}
						</td>
						<td class="text-center">
							@if (item.FentregaPed.HasValue)
							{
								var cls = item.EstaVencido ? "text-danger fw-semibold" : item.DiasRetraso >= -3 ? "text-warning fw-semibold" : "text-success";
								<span class="@cls">@item.FentregaPed.Value.ToString("dd/MM/yy")</span>
							}
							else
							{
								<span class="text-muted">—</span>
							}
						</td>
						<td class="text-center">
							<span class="badge bg-@item.EstadoBadge">@item.EstadoLabel</span>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
	<div class="d-flex align-items-center justify-content-between mt-2">
		<nav><ul class="pagination pagination-sm mb-0" id="tblRectReceta-pgnav"></ul></nav>
		<div id="tblRectReceta-pginfo" class="small text-muted"></div>
	</div>
}
