                                          <span class="tt-acc-preview">@detTt.Revisados.Count revisado@(detTt.Revisados.Count != 1 ? "s" : "")</span>
                                        </button>
                                      </h2>
                                      <div id="acc-tt-@(subIdx)-rev" class="accordion-collapse collapse">
                                        <div class="accordion-body p-2">
                                          @foreach (var rev in detTt.Revisados)
                                          {
                                            <div class="p-2 mb-2" style="background:#f6fff6;border-radius:6px;border:1px solid #bbf7d0;">
                                              <div class="d-flex gap-3 flex-wrap mb-2 align-items-center">
