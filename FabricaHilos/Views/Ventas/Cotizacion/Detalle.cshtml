@model FabricaHilos.Models.Ventas.Cotizacion.CotizacionDetalleViewModel
@{
    var h = Model.Header;
    ViewData["Title"] = Model.EsSimulacion ? $"Simulación SM-{h.Numero}" : $"Cotización {h.Numero}";

    static string AccionBadgeCss(string accionColor) => accionColor switch
    {
        "success"   => "sire-badge sire-badge-ok",
        "primary"   => "sire-badge sire-badge-info",
        "info"      => "sire-badge sire-badge-process",
        "secondary" => "sire-badge sire-badge-secondary",
        "danger"    => "sire-badge sire-badge-danger",
        "warning"   => "sire-badge sire-badge-warn",
        _           => "sire-badge sire-badge-secondary"
    };
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Ventas" asp-action="Index">Ventas</a></li>
    <li class="breadcrumb-item"><a asp-action="Index">Cotizaciones</a></li>
    <li class="breadcrumb-item active">@(Model.EsSimulacion ? $"SM-{h.Numero}" : $"{h.Numero}")</li>
}

@section Styles {
    <link rel="stylesheet" href="~/css/sire.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cotizacion.css" asp-append-version="true" />
}

@Html.AntiForgeryToken()

<div class="sire-strip">
    <i class="bi @(Model.EsSimulacion ? "bi-sliders" : "bi-file-earmark-text")" style="color:#90cdf4;font-size:.95rem;flex-shrink:0;"></i>
    <span class="sire-strip-title">@(Model.EsSimulacion ? $"Simulación SM-{h.Numero}" : $"Cotización N° {h.Numero}")</span>
    <span class="sire-strip-sep"></span>
    @if (!Model.EsSimulacion)
    {
        <span class="sire-kpi"><i class="bi bi-person"></i><span class="sire-kpi-val">@(h.NombreCliente ?? h.CodCliente ?? "-")</span></span>
    }
    <span class="sire-kpi"><i class="bi bi-calendar3"></i><span>@(h.Fecha?.ToString("dd/MM/yyyy") ?? "-")</span></span>
    @if (!string.IsNullOrEmpty(h.Estado))
    {
        <span class="sire-kpi"><i class="bi bi-info-circle"></i><span>Estado ERP: @h.Estado</span></span>
    }
    @if (Model.Eliminada)
    {
        <span class="sire-badge sire-badge-danger">Eliminada</span>
    }
    <div class="ms-auto d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-light btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
        @if (Model.Eliminada)
        {
            <form method="post" asp-action="Restaurar" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="tipoDoc" value="@h.TipoDoc" />
                <input type="hidden" name="serie" value="@h.Serie" />
                <input type="hidden" name="numero" value="@h.Numero" />
                <button type="submit" class="btn btn-success btn-sm">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Restaurar
                </button>
            </form>
        }
        else
        {
            <button type="button" class="btn btn-outline-danger btn-sm" id="btnEliminarDoc">
                <i class="bi bi-trash me-1"></i>Eliminar
            </button>
        }
    </div>
</div>

<form id="frmEliminarDoc" method="post" asp-action="Eliminar" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="tipoDoc" value="@h.TipoDoc" />
    <input type="hidden" name="serie" value="@h.Serie" />
    <input type="hidden" name="numero" value="@h.Numero" />
</form>

@for (int idx = 0; idx < Model.Items.Count; idx++)
{
    var d = Model.Items[idx];
    var it = d.Item;
    var margenActual = d.Historial.OrderByDescending(hi => hi.NroVersion).FirstOrDefault()?.MargenPct ?? 30;
    var editId = $"edit-{idx}";
    var histId = $"hist-{idx}";
    var rutaId = $"ruta-{idx}";
    var rutaContId = $"ruta-{idx}-container";
    var timelineId = $"timeline-{idx}";

    <div class="sire-card mb-4">
        <div class="sire-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <strong>Ítem @it.Item</strong>
                <span class="text-muted">— @(it.Titulo ?? "(sin título)") · Proceso @it.Proceso · @it.Cantidad kg</span>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#@editId">
                    <i class="bi bi-pencil me-1"></i>Editar
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#@histId">
                    <i class="bi bi-clock-history me-1"></i>Historial (@d.Historial.Count)
                </button>
                <button type="button" class="btn btn-sm btn-outline-info" data-bs-toggle="collapse" data-bs-target="#@rutaId">
                    <i class="bi bi-clipboard-data me-1"></i>Ficha técnica
                </button>
                <form method="post" asp-action="Duplicar" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tipoDoc" value="@h.TipoDoc" />
                    <input type="hidden" name="serie" value="@h.Serie" />
                    <input type="hidden" name="numero" value="@h.Numero" />
                    <input type="hidden" name="item" value="@it.Item" />
                    <button type="submit" class="btn btn-sm btn-outline-success">
                        <i class="bi bi-files me-1"></i>Duplicar
                    </button>
                </form>
            </div>
        </div>
        <div class="sire-card-body">
            <div id="@timelineId"></div>

            <!-- Sección editable -->
            <div class="collapse mt-3" id="@editId">
                <div class="cot-item-edit" data-tipodoc="@h.TipoDoc" data-serie="@h.Serie" data-numero="@h.Numero" data-item="@it.Item">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="cot-seccion-editable">
                                <h6><i class="bi bi-tag me-1"></i>Ruta / Título</h6>
                                <label class="form-label small">Código de título</label>
                                <input type="text" class="form-control form-control-sm f-titulo" value="@it.Titulo" />
                            </div>
                            <div class="cot-seccion-editable">
                                <h6><i class="bi bi-flower1 me-1"></i>Materia Prima</h6>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label class="form-label small">Fibra 1</label>
                                        <input type="text" class="form-control form-control-sm f-fibra1" value="@it.Fibra1" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small">Fibra 2</label>
                                        <input type="text" class="form-control form-control-sm f-fibra2" value="@it.Fibra2" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small">% Fibra 1 (VALPF)</label>
                                        <input type="text" class="form-control form-control-sm f-valpf" value="@it.Valpf" />
                                    </div>
                                </div>
                            </div>
                            <div class="cot-seccion-editable">
                                <h6><i class="bi bi-gear me-1"></i>Proceso e Intensidad</h6>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label class="form-label small">Proceso</label>
                                        <select class="form-select form-select-sm f-proceso">
                                            <option value="01" selected="@(it.Proceso == "01")">01 - Cardado</option>
                                            <option value="20" selected="@(it.Proceso == "20")">20 - Peinado</option>
                                            <option value="24" selected="@(it.Proceso == "24")">24 - Peinado Gaseado</option>
                                        </select>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small">Intensidad</label>
                                        <select class="form-select form-select-sm f-intensidad">
                                            <option value="0" selected="@(it.Intensidad == "0")">Crudo</option>
                                            <option value="5" selected="@(it.Intensidad == "5")">Blanco</option>
                                            <option value="1" selected="@(it.Intensidad == "1")">Claro</option>
                                            <option value="2" selected="@(it.Intensidad == "2")">Medio</option>
                                            <option value="3" selected="@(it.Intensidad == "3")">Oscuro</option>
                                            <option value="4" selected="@(it.Intensidad == "4")">Intenso</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="cot-seccion-editable">
                                <h6><i class="bi bi-box-seam me-1"></i>Presentación y Cantidad</h6>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label class="form-label small">Presentación</label>
                                        <select class="form-select form-select-sm f-presentacion">
                                            <option value="M" selected="@(string.IsNullOrEmpty(it.Presentacion) || it.Presentacion.ToUpper().StartsWith("M"))">Madeja</option>
                                            <option value="C" selected="@(it.Presentacion != null && it.Presentacion.ToUpper().StartsWith("C"))">Cono</option>
                                            <option value="R" selected="@(it.Presentacion != null && it.Presentacion.ToUpper().StartsWith("R"))">Rodete</option>
                                        </select>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small">Cantidad (kg)</label>
                                        <input type="number" step="0.01" class="form-control form-control-sm f-cantidad" value="@it.Cantidad" />
                                    </div>
                                </div>
                            </div>
                            <div class="cot-seccion-editable">
                                <h6><i class="bi bi-percent me-1"></i>Margen</h6>
                                <label class="form-label small">Margen (%)</label>
                                <input type="number" step="0.01" class="form-control form-control-sm f-margen" value="@margenActual" />
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-primary btn-sm btn-recalcular">
                                    <i class="bi bi-calculator me-1"></i>Recalcular
                                </button>
                                <button type="button" class="btn btn-outline-primary btn-sm btn-comparar">
                                    <i class="bi bi-columns-gap me-1"></i>Comparar tonalidades
                                </button>
                                <button type="button" class="btn btn-success btn-sm btn-guardar-item" disabled>
                                    <i class="bi bi-save me-1"></i>Guardar cambios
                                </button>
                            </div>
                            <div class="mt-3 preview-container"></div>
                            <div class="mt-3 comparativo-container"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Ficha técnica de ruta — snapshot CONGELADO al momento de guardar esta versión (no cambia
                 aunque Preparatoria edite la ficha después; requisito de trazabilidad exacta). -->
            <div class="collapse mt-3" id="@rutaId">
                <p class="text-muted small mb-2">
                    <i class="bi bi-lock me-1"></i>Snapshot congelado al guardar la última versión de este ítem
                    (no refleja cambios posteriores hechos por Preparatoria).
                </p>
                <div id="@rutaContId"></div>
            </div>

            <!-- Historial -->
            <div class="collapse mt-3" id="@histId">
                <div class="table-responsive">
                        <table class="sire-table w-100">
                            <thead>
                                <tr>
                                    <th>Ver.</th><th>Acción</th><th>Fecha</th><th>Usuario</th>
                                    <th>Título</th><th>Cant. (kg)</th><th>Margen %</th><th>Costo Total</th><th>Precio 30%</th><th>Obs.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var hi in d.Historial)
                                {
                                    <tr>
                                        <td>@hi.NroVersion</td>
                                        <td><span class="@AccionBadgeCss(hi.AccionColor)">@hi.AccionLabel</span></td>
                                    <td>@hi.FchHist.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@hi.Usuario</td>
                                    <td>@hi.Titulo</td>
                                    <td>@hi.CantidadKg</td>
                                    <td>@hi.MargenPct</td>
                                    <td>@hi.CostoTotal?.ToString("N4")</td>
                                    <td>@hi.Precio30?.ToString("N4")</td>
                                    <td>@hi.Observacion</td>
                                </tr>
                            }
                            @if (!d.Historial.Any())
                            {
                                <tr><td colspan="10" class="text-center text-muted">Sin versiones registradas.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script type="application/json" class="timeline-data" data-target="@timelineId">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(d.Timeline))</script>
    <script type="application/json" class="ruta-tecnica-data" data-target="@rutaContId">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(d.RutaTecnica, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))</script>
}

@section Scripts {
    <script src="~/js/cotizacion-timeline.js" asp-append-version="true"></script>
    <script src="~/js/ruta-tecnica.js" asp-append-version="true"></script>
    <script>
        // Render de las líneas de tiempo iniciales (una por ítem)
        document.querySelectorAll('.timeline-data').forEach(scriptTag => {
            const targetId = scriptTag.dataset.target;
            const timeline = JSON.parse(scriptTag.textContent);
            CotizacionTimeline.render(document.getElementById(targetId), timeline);
        });

        // Render de la ficha técnica de ruta CONGELADA (una por ítem)
        document.querySelectorAll('.ruta-tecnica-data').forEach(scriptTag => {
            const targetId = scriptTag.dataset.target;
            const ficha = JSON.parse(scriptTag.textContent || 'null');
            RutaTecnica.render(document.getElementById(targetId), ficha, { editUrl: '@Url.Action("Index", "RutaTecnica")' });
        });

        function getToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        function leerEdicion(root) {
            return {
                titulo: root.querySelector('.f-titulo').value || null,
                proceso: root.querySelector('.f-proceso').value,
                intensidadCod: root.querySelector('.f-intensidad').value,
                fibra1: root.querySelector('.f-fibra1').value || null,
                fibra2: root.querySelector('.f-fibra2').value || null,
                valpf: root.querySelector('.f-valpf').value || null,
                presentacion: root.querySelector('.f-presentacion').value,
                cantidadKg: parseFloat(root.querySelector('.f-cantidad').value) || 500,
                margenPct: parseFloat(root.querySelector('.f-margen').value) || 30
            };
        }

        document.querySelectorAll('.cot-item-edit').forEach(root => {
            const btnRecalcular = root.querySelector('.btn-recalcular');
            const btnGuardar = root.querySelector('.btn-guardar-item');
            const btnComparar = root.querySelector('.btn-comparar');
            const previewContainer = root.querySelector('.preview-container');
            const comparativoContainer = root.querySelector('.comparativo-container');
            const tipoDoc = root.dataset.tipodoc;
            const serie = root.dataset.serie;
            const numero = root.dataset.numero;
            const item = root.dataset.item;
            let ultimaEdicion = null;

            btnComparar.addEventListener('click', async () => {
                btnComparar.disabled = true;
                btnComparar.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Calculando...';
                try {
                    const resp = await fetch('@Url.Action("CompararTonalidadesItem")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(leerEdicion(root))
                    });
                    const data = await resp.json();
                    if (data.ok) {
                        comparativoContainer.innerHTML = '<h6 class="text-muted small mb-2">Comparativo por tonalidad (hoja "Resumen" del Excel):</h6>';
                        const div = document.createElement('div');
                        comparativoContainer.appendChild(div);
                        CotizacionTimeline.renderComparativo(div, data.comparativo);
                    } else {
                        AppAlert('Error al comparar tonalidades: ' + data.error, 'Error', 'danger');
                    }
                } catch (e) {
                    AppAlert('Error de red al comparar tonalidades: ' + e, 'Error', 'danger');
                } finally {
                    btnComparar.disabled = false;
                    btnComparar.innerHTML = '<i class="bi bi-columns-gap me-1"></i>Comparar tonalidades';
                }
            });

            btnRecalcular.addEventListener('click', async () => {
                ultimaEdicion = leerEdicion(root);
                btnRecalcular.disabled = true;
                try {
                    const resp = await fetch('@Url.Action("RecalcularItem")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(ultimaEdicion)
                    });
                    const data = await resp.json();
                    if (data.ok) {
                        previewContainer.innerHTML = '<h6 class="text-muted small mb-2">Vista previa del recálculo:</h6>';
                        const div = document.createElement('div');
                        previewContainer.appendChild(div);
                        CotizacionTimeline.render(div, data.timeline);
                        btnGuardar.disabled = false;
                    } else {
                        AppAlert('Error al recalcular: ' + data.error, 'Error', 'danger');
                    }
                } catch (e) {
                    AppAlert('Error de red al recalcular: ' + e, 'Error', 'danger');
                } finally {
                    btnRecalcular.disabled = false;
                }
            });

            btnGuardar.addEventListener('click', async () => {
                if (!ultimaEdicion) return;
                const ok = await AppConfirm('¿Guardar los cambios de este ítem? Se registrará una nueva versión en el historial.', 'Confirmar guardado');
                if (!ok) return;

                btnGuardar.disabled = true;
                try {
                    const url = tipoDoc === 'CT' ? '@Url.Action("GuardarEdicionItem")' : '@Url.Action("GuardarEdicionSimulacion")';
                    const body = tipoDoc === 'CT'
                        ? { tipoDoc: tipoDoc, serie: parseInt(serie), numero: parseInt(numero), item: parseInt(item), edicion: ultimaEdicion, observacion: null }
                        : { numero: parseInt(numero), edicion: ultimaEdicion, observacion: null };

                    const resp = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                        body: JSON.stringify(body)
                    });
                    const data = await resp.json();
                    if (data.ok) {
                        window.location.reload();
                    } else {
                        AppAlert('Error al guardar: ' + data.error, 'Error', 'danger');
                        btnGuardar.disabled = false;
                    }
                } catch (e) {
                    AppAlert('Error de red al guardar: ' + e, 'Error', 'danger');
                    btnGuardar.disabled = false;
                }
            });
        });

        document.getElementById('btnEliminarDoc')?.addEventListener('click', async () => {
            const ok = await AppConfirm('¿Eliminar esta cotización? Podrá restaurarla luego desde el listado.', 'Confirmar eliminación');
            if (ok) document.getElementById('frmEliminarDoc').submit();
        });
    </script>
}
