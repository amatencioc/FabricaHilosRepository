function aplicarColor(hex){
    var idxs = Object.keys(selected);
    if(!idxs.length) return;
    var payload = idxs.map(function(idx){
        var r=filtered[parseInt(idx)];
        return { nroProg:r.nroProg||null, numPed:r.numPedKey, nro:r.nroKey, numDet:r.numDetKey, reproceso:r.reprocesoKey, fchProg:r.fchProgKey||null, colorHexa:hex||null };
    });
    fetch('/Planeamiento/GuardarColorHexa', {
        method:'POST',
        headers:{'Content-Type':'application/json','RequestVerificationToken':document.querySelector('[name=__RequestVerificationToken]')?.value||''},
        body:JSON.stringify(payload)
    }).then(function(res){ return res.json(); }).then(function(j){
        if(j.ok){
            idxs.forEach(function(idx){
                var i=parseInt(idx);
                filtered[i].colorHexa=hex||null;
                var orig=allData.indexOf(filtered[i]);
                if(orig>=0) allData[orig].colorHexa=hex||null;
            });
            selected={};
            paletaEl.style.display='none';
            renderPage();
            updateColorBar();
            showToast(hex ? 'Etiqueta asignada.' : 'Etiqueta quitada.', hex||'#6c757d');
        }
    }).catch(function(){ showToast('Error al guardar etiqueta.','#dc3545'); });
}

