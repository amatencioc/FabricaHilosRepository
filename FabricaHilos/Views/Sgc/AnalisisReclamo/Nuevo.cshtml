@model FabricaHilos.Models.Sgc.CrearReclamoRequest

@{
    ViewData["Title"] = "Nuevo Reclamo";
    var clientes = ViewBag.Clientes as List<FabricaHilos.Models.Sgc.ClienteComboDto>
                   ?? new List<FabricaHilos.Models.Sgc.ClienteComboDto>();
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Sgc" asp-action="Index">SGC</a></li>
    <li class="breadcrumb-item"><a asp-controller="AnalisisReclamo" asp-action="Index">Análisis de Reclamos</a></li>
    <li class="breadcrumb-item active">Nuevo Reclamo</li>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="section-title mb-0">
        <i class="bi bi-plus-circle me-2"></i>Nuevo Reclamo
    </h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    var errores = ViewData.ModelState.Values
        .SelectMany(v => v.Errors)
        .Select(e => string.IsNullOrWhiteSpace(e.ErrorMessage) ? e.Exception?.Message : e.ErrorMessage)
        .Where(msg => !string.IsNullOrWhiteSpace(msg))
        .ToList();

    @if (errores.Any())
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-1"></i>
            <strong>Corrija los siguientes errores:</strong>
            <ul class="mb-0 mt-1">
                @foreach (var msg in errores)
                {
                    <li>@msg</li>
                }
            </ul>
        </div>
    }
}

<form asp-action="Nuevo" method="post" enctype="multipart/form-data" id="frmNuevoReclamo">
    @Html.AntiForgeryToken()

    <div class="row g-3">

        <!-- ── Columna izquierda: datos del reclamo ── -->
        <div class="col-lg-7">
            <div class="card card-dashboard h-100">
                <div class="card-header bg-primary text-white py-2">
                    <i class="bi bi-info-circle me-1"></i>Datos del Reclamo
                </div>
                <div class="card-body">

                    <!-- Cliente (autocomplete) -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Cliente <span class="text-danger">*</span>
                        </label>
                        <!-- Campo oculto con el código -->
                        <input type="hidden" id="CodCliente" name="CodCliente" value="@Model.CodCliente" required />
                        <input type="hidden" id="NomCliente" name="NomCliente" value="@Model.NomCliente" />

                        <!-- Búsqueda de cliente -->
                        <div class="input-group">
                            <input type="text" id="buscarCliente" class="form-control"
                                   placeholder="Escriba nombre o código del cliente..."
                                   value="@(string.IsNullOrEmpty(Model.NomCliente) ? Model.CodCliente : Model.NomCliente)"
                                   autocomplete="off" />
                            <button type="button" class="btn btn-outline-secondary" id="btnLimpiarCliente"
                                    title="Limpiar selección">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                        <!-- Resultados del autocomplete -->
                        <div id="resultadosCliente" class="list-group position-absolute z-3 shadow-sm"
                             style="max-height:220px; overflow-y:auto; width:calc(100% - 2rem); display:none;">
                        </div>
                        <div id="clienteSeleccionado" class="mt-1 small
                             @(string.IsNullOrEmpty(Model.CodCliente) ? "d-none" : "text-success")">
                            <i class="bi bi-check-circle me-1"></i>
                            <span id="lblClienteSeleccionado">@Model.NomCliente (@Model.CodCliente)</span>
                        </div>
                    </div>

                    <!-- Contacto -->
                    <div class="mb-3">
                        <label asp-for="Contacto" class="form-label fw-semibold">
                            Persona de Contacto <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Contacto" class="form-control"
                               placeholder="Nombre de la persona de contacto en el cliente"
                               maxlength="100" required />
                        <span asp-validation-for="Contacto" class="text-danger small"></span>
                    </div>

                    <!-- Teléfono -->
                    <div class="mb-3">
                        <label asp-for="Telefono" class="form-label fw-semibold">
                            Teléfono <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Telefono" class="form-control"
                               placeholder="Teléfono o celular de contacto"
                               maxlength="30" required
                               inputmode="tel" type="tel" />
                        <span asp-validation-for="Telefono" class="text-danger small"></span>
                    </div>

                    <!-- Asunto -->
                    <div class="mb-3">
                        <label asp-for="Asunto" class="form-label fw-semibold">
                            Asunto / Descripción del Reclamo <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Asunto" class="form-control"
                               placeholder="Resumen del reclamo"
                               maxlength="400" required />
                        <span asp-validation-for="Asunto" class="text-danger small"></span>
                    </div>

                    <!-- Descargo del vendedor -->
                    <div class="mb-3">
                        <label asp-for="Descargo" class="form-label fw-semibold">
                            Descargo del Vendedor <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="Descargo" class="form-control" rows="5"
                                  placeholder="Detalle de lo ocurrido, contexto, acciones tomadas..."
                                  required></textarea>
                        <span asp-validation-for="Descargo" class="text-danger small"></span>
                    </div>

                </div>
            </div>
        </div>

        <!-- ── Columna derecha: adjuntar archivos ── -->
        <div class="col-lg-5">
            <div class="card card-dashboard h-100">
                <div class="card-header bg-secondary text-white py-2">
                    <i class="bi bi-paperclip me-1"></i>Evidencia del Vendedor
                    <small class="ms-2 opacity-75">(opcional)</small>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-2">Tamaño máximo: <strong>100 MB</strong> por archivo.</p>

                    <!-- Tipos de archivo permitidos -->
                    <p class="text-muted small mb-1 fw-semibold">Tipos de archivo permitidos:</p>
                    <div class="mb-1">
                        <div class="d-flex flex-wrap gap-1">
                            <span class="badge bg-light text-secondary border">
                                <i class="bi bi-file-pdf text-danger me-1"></i>
                                <span class="fw-semibold">PDF</span>
                                <span class="text-muted fw-normal ms-1">.pdf</span>
                            </span>
                            <span class="badge bg-light text-secondary border">
                                <i class="bi bi-file-word text-primary me-1"></i>
                                <span class="fw-semibold">Word</span>
                                <span class="text-muted fw-normal ms-1">.doc .docx</span>
                            </span>
                            <span class="badge bg-light text-secondary border">
                                <i class="bi bi-file-excel text-success me-1"></i>
                                <span class="fw-semibold">Excel</span>
                                <span class="text-muted fw-normal ms-1">.xls .xlsx</span>
                            </span>
                            <span class="badge bg-light text-secondary border">
                                <i class="bi bi-file-ppt text-warning me-1"></i>
                                <span class="fw-semibold">PowerPoint</span>
                                <span class="text-muted fw-normal ms-1">.ppt .pptx</span>
                            </span>
                            <span class="badge bg-light text-secondary border">
                                <i class="bi bi-file-image text-info me-1"></i>
                                <span class="fw-semibold">Imagen</span>
                                <span class="text-muted fw-normal ms-1">.jpg .jpeg .png .gif .bmp .webp .heic</span>
                            </span>
                            <span class="badge bg-light text-secondary border">
                                <i class="bi bi-file-play text-danger me-1"></i>
                                <span class="fw-semibold">Video</span>
                                <span class="text-muted fw-normal ms-1">.mp4 .mov .avi .mkv .webm .3gp</span>
                            </span>
                            <span class="badge bg-light text-secondary border">
                                <i class="bi bi-file-music text-secondary me-1"></i>
                                <span class="fw-semibold">Audio</span>
                                <span class="text-muted fw-normal ms-1">.mp3 .wav .ogg .m4a .aac</span>
                            </span>
                            <span class="badge bg-light text-secondary border">
                                <i class="bi bi-envelope text-secondary me-1"></i>
                                <span class="fw-semibold">Correo</span>
                                <span class="text-muted fw-normal ms-1">.eml .msg</span>
                            </span>
                            <span class="badge bg-light text-secondary border">
                                <i class="bi bi-file-zip text-secondary me-1"></i>
                                <span class="fw-semibold">Comprimido</span>
                                <span class="text-muted fw-normal ms-1">.zip .rar .7z</span>
                            </span>
                            <span class="badge bg-light text-secondary border">
                                <i class="bi bi-file-text text-secondary me-1"></i>
                                <span class="fw-semibold">Texto</span>
                                <span class="text-muted fw-normal ms-1">.txt .csv .rtf</span>
                            </span>
                        </div>
                    </div>

                    <!-- Zona de drag & drop + botones de cámara -->
                    <div id="dropZone" class="border border-2 border-dashed rounded-3 p-3 text-center mb-3
                                              bg-light" style="cursor:pointer; min-height:120px;">
                        <i class="bi bi-cloud-upload fs-2 text-muted"></i>
                        <p class="mb-1 text-muted small">Arrastra archivos aquí o usa los botones</p>
                        <div class="d-flex justify-content-center gap-2 flex-wrap mt-2">
                            <!-- Botón principal (cualquier archivo) -->
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    onclick="document.getElementById('inputArchivos').click()">
                                <i class="bi bi-folder2-open me-1"></i>Adjuntar archivo
                            </button>
                            <!-- Botón cámara (foto/video directo — mobile) -->
                            <button type="button" class="btn btn-sm btn-outline-success d-md-none"
                                    onclick="document.getElementById('inputCamara').click()"
                                    title="Tomar foto o grabar video con la cámara">
                                <i class="bi bi-camera me-1"></i>Cámara
                            </button>
                        </div>
                    </div>

                    <!-- Input oculto principal (PC + mobile, cualquier archivo) -->
                    <input type="file" id="inputArchivos" name="Archivos" multiple
                           accept="*/*" class="d-none" />

                    <!-- Input oculto de cámara (solo mobile — capture abre cámara directamente) -->
                    <input type="file" id="inputCamara" name="Archivos" multiple
                           accept="image/*,video/*" capture="environment" class="d-none" />

                    <!-- Lista de archivos seleccionados -->
                    <div id="listaArchivos" class="d-none">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="fw-semibold text-muted">Archivos seleccionados:</small>
                            <button type="button" class="btn btn-sm btn-link text-danger p-0"
                                    onclick="limpiarArchivos()">
                                <i class="bi bi-trash me-1"></i>Limpiar
                            </button>
                        </div>
                        <ul id="ulArchivos" class="list-group list-group-flush small"></ul>
                    </div>

                </div>
            </div>
        </div>

    </div><!-- /row -->

    <!-- Botones de acción -->
    <div class="d-flex gap-2 justify-content-end mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-x-lg me-1"></i>Cancelar
        </a>
        <button type="submit" class="btn btn-primary" id="btnGuardar">
            <i class="bi bi-floppy me-1"></i>Guardar Reclamo
        </button>
    </div>

</form>

<!-- Modal: cliente no seleccionado -->
<div class="modal fade" id="modalSinCliente" tabindex="-1" aria-labelledby="modalSinClienteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="modalSinClienteLabel">
                    <i class="bi bi-exclamation-triangle me-1"></i>Cliente requerido
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Debe seleccionar un cliente de la lista antes de guardar el reclamo.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" data-bs-dismiss="modal" id="btnModalSinClienteOk">
                    Aceptar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
// ── Selección de archivos ────────────────────────────────────────────────────
let archivosSeleccionados = new DataTransfer();

function actualizarListaUI() {
    const lista    = document.getElementById('listaArchivos');
    const ulItems  = document.getElementById('ulArchivos');
    const files    = archivosSeleccionados.files;

    if (files.length === 0) {
        lista.classList.add('d-none');
        ulItems.innerHTML = '';
        return;
    }
    lista.classList.remove('d-none');
    ulItems.innerHTML = '';
    for (let i = 0; i < files.length; i++) {
        const f      = files[i];
        const size   = f.size < 1048576
            ? (f.size / 1024).toFixed(1) + ' KB'
            : (f.size / 1048576).toFixed(2) + ' MB';
        const style  = getFileStyle(f);
        const ext    = f.name.includes('.') ? f.name.slice(f.name.lastIndexOf('.')).toLowerCase() : '';
        const li     = document.createElement('li');
        li.className = 'list-group-item px-0 py-1';
        li.dataset.index = i;
        li.innerHTML = `
            <div class="d-flex align-items-center gap-2">
                <!-- Ícono con color de la leyenda -->
                <i class="bi ${style.icon} ${style.color} fs-4 flex-shrink-0"></i>
                <!-- Nombre + extensión -->
                <div class="flex-grow-1 overflow-hidden">
                    <div class="text-truncate small fw-semibold" title="${f.name}">${f.name}</div>
                    <div class="d-flex align-items-center gap-1 mt-1">
                        <span class="badge bg-light text-secondary border" style="font-size:.65rem">${ext || '–'}</span>
                        <span class="text-muted" style="font-size:.72rem">${style.label}</span>
                    </div>
                </div>
                <!-- Tamaño + quitar -->
                <div class="d-flex flex-column align-items-end flex-shrink-0 gap-1">
                    <span class="text-muted text-nowrap" style="font-size:.72rem">${size}</span>
                    <button type="button" class="btn btn-link btn-sm p-0 text-danger lh-1"
                            title="Quitar archivo" onclick="quitarArchivo(${i})">
                        <i class="bi bi-x-circle"></i>
                    </button>
                </div>
            </div>`;
        ulItems.appendChild(li);
    }

    // Nota: NO sincronizamos a inputArchivos.files aquí porque la asignación
    // falla silenciosamente para ciertos MIME types (Excel, .msg, etc.).
    // El envío se realiza vía FormData en el handler de submit.
}

/**
 * Devuelve { icon, color, label } que coinciden exactamente con los colores de la leyenda.
 */
function getFileStyle(file) {
    const mime = file.type.toLowerCase();
    const ext  = file.name.includes('.') ? file.name.slice(file.name.lastIndexOf('.')).toLowerCase() : '';
    if (mime.startsWith('image/'))
        return { icon: 'bi-file-image',  color: 'text-info',    label: 'Imagen'      };
    if (mime.startsWith('video/'))
        return { icon: 'bi-file-play',   color: 'text-danger',  label: 'Video'       };
    if (mime.startsWith('audio/'))
        return { icon: 'bi-file-music',  color: 'text-secondary', label: 'Audio'     };
    if (mime === 'application/pdf')
        return { icon: 'bi-file-pdf',    color: 'text-danger',  label: 'PDF'         };
    if (mime.includes('word')        || ext === '.doc'  || ext === '.docx')
        return { icon: 'bi-file-word',   color: 'text-primary', label: 'Word'        };
    if (mime.includes('excel')       || ext === '.xls'  || ext === '.xlsx')
        return { icon: 'bi-file-excel',  color: 'text-success', label: 'Excel'       };
    if (mime.includes('powerpoint')  || ext === '.ppt'  || ext === '.pptx')
        return { icon: 'bi-file-ppt',    color: 'text-warning', label: 'PowerPoint'  };
    if (mime === 'message/rfc822'    || ext === '.eml'  || ext === '.msg')
        return { icon: 'bi-envelope',    color: 'text-secondary', label: 'Correo'    };
    if (mime.includes('zip') || ext === '.zip' || ext === '.rar' || ext === '.7z')
        return { icon: 'bi-file-zip',    color: 'text-secondary', label: 'Comprimido' };
    if (mime.startsWith('text/')     || ext === '.txt'  || ext === '.csv' || ext === '.rtf')
        return { icon: 'bi-file-text',   color: 'text-secondary', label: 'Texto'     };
    return   { icon: 'bi-file-earmark', color: 'text-secondary', label: 'Archivo'    };
}

function quitarArchivo(index) {
    const nuevo = new DataTransfer();
    const files = archivosSeleccionados.files;
    for (let i = 0; i < files.length; i++) {
        if (i !== index) nuevo.items.add(files[i]);
    }
    archivosSeleccionados = nuevo;
    actualizarListaUI();
}

function agregarArchivos(nuevosArchivos) {
    for (const f of nuevosArchivos) {
        archivosSeleccionados.items.add(f);
    }
    actualizarListaUI();
}

function limpiarArchivos() {
    archivosSeleccionados = new DataTransfer();
    document.getElementById('inputArchivos').value  = '';
    document.getElementById('inputCamara').value    = '';
    actualizarListaUI();
}

// Input principal
document.getElementById('inputArchivos').addEventListener('change', function() {
    agregarArchivos(this.files);
});

// Input cámara
document.getElementById('inputCamara').addEventListener('change', function() {
    agregarArchivos(this.files);
    // Resetear para permitir re-capturar
    this.value = '';
});

// Drag & drop
const dropZone = document.getElementById('dropZone');

dropZone.addEventListener('dragover', e => {
    e.preventDefault();
    dropZone.classList.add('border-primary', 'bg-white');
});
dropZone.addEventListener('dragleave', () => {
    dropZone.classList.remove('border-primary', 'bg-white');
});
dropZone.addEventListener('drop', e => {
    e.preventDefault();
    dropZone.classList.remove('border-primary', 'bg-white');
    agregarArchivos(e.dataTransfer.files);
});

// ── Autocomplete de clientes ──────────────────────────────────────────────────
let timerCliente = null;
let _clientesData = [];   // cache del último resultado
let _idxActivo    = -1;   // índice de la fila resaltada

document.getElementById('buscarCliente').addEventListener('input', function() {
    _idxActivo = -1;
    clearTimeout(timerCliente);
    const q = this.value.trim();
    if (q.length < 2) {
        ocultarResultados();
        return;
    }
    timerCliente = setTimeout(() => buscarClientes(q), 300);
});

document.getElementById('buscarCliente').addEventListener('keydown', function(e) {
    const div  = document.getElementById('resultadosCliente');
    const items = div.querySelectorAll('.list-group-item');
    if (!items.length) return;

    if (e.key === 'ArrowDown') {
        e.preventDefault();
        _idxActivo = (_idxActivo + 1) % items.length;
        resaltarItem(items);
    } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        _idxActivo = (_idxActivo - 1 + items.length) % items.length;
        resaltarItem(items);
    } else if (e.key === 'Enter') {
        e.preventDefault();
        if (_idxActivo >= 0 && _idxActivo < _clientesData.length) {
            seleccionarCliente(_clientesData[_idxActivo]);
        }
    } else if (e.key === 'Escape') {
        ocultarResultados();
    }
});

function resaltarItem(items) {
    items.forEach((el, i) => {
        el.classList.toggle('active', i === _idxActivo);
    });
    if (_idxActivo >= 0) items[_idxActivo].scrollIntoView({ block: 'nearest' });
}

document.getElementById('buscarCliente').addEventListener('blur', function() {
    setTimeout(ocultarResultados, 200);
});

document.getElementById('btnLimpiarCliente').addEventListener('click', function() {
    document.getElementById('CodCliente').value = '';
    document.getElementById('NomCliente').value = '';
    document.getElementById('buscarCliente').value = '';
    document.getElementById('clienteSeleccionado').classList.add('d-none');
    ocultarResultados();
});

async function buscarClientes(q) {
    try {
        const res  = await fetch(`@Url.Action("BuscarClientes", "AnalisisReclamo")?q=${encodeURIComponent(q)}`);
        const data = await res.json();
        mostrarResultados(data);
    } catch { /* silencioso */ }
}

function mostrarResultados(clientes) {
    _clientesData = clientes.slice(0, 20);
    _idxActivo    = -1;
    const div = document.getElementById('resultadosCliente');
    div.innerHTML = '';
    if (!_clientesData.length) { ocultarResultados(); return; }

    _clientesData.forEach((c, i) => {
        const btn = document.createElement('button');
        btn.type      = 'button';
        btn.className = 'list-group-item list-group-item-action py-1 px-2 small';
        btn.innerHTML = `<strong>${c.codCliente}</strong> — ${c.nomCliente}`;
        btn.addEventListener('mousedown', () => seleccionarCliente(c));
        btn.addEventListener('mouseover', () => {
            _idxActivo = i;
            resaltarItem(div.querySelectorAll('.list-group-item'));
        });
        div.appendChild(btn);
    });
    div.style.display = 'block';
}

function seleccionarCliente(c) {
    document.getElementById('CodCliente').value = c.codCliente;
    document.getElementById('NomCliente').value = c.nomCliente;
    document.getElementById('buscarCliente').value = c.nomCliente;
    document.getElementById('lblClienteSeleccionado').textContent = c.codCliente + ' — ' + c.nomCliente;
    document.getElementById('clienteSeleccionado').classList.remove('d-none');
    ocultarResultados();
}

function ocultarResultados() {
    document.getElementById('resultadosCliente').style.display = 'none';
}

// ── Envío del formulario vía FormData para garantizar todos los tipos de archivo ──
document.getElementById('frmNuevoReclamo').addEventListener('submit', async function(e) {
    e.preventDefault();

    // Validación: cliente obligatorio
    if (!document.getElementById('CodCliente').value) {
        const modal = new bootstrap.Modal(document.getElementById('modalSinCliente'));
        modal.show();
        document.getElementById('btnModalSinClienteOk').addEventListener('click', function() {
            document.getElementById('buscarCliente').focus();
        }, { once: true });
        return;
    }

    const btn  = document.getElementById('btnGuardar');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando…';

    // Construir FormData con los campos del formulario
    const form = this;
    const fd   = new FormData(form);

    // Eliminar los inputs de archivo nativos del FormData (vienen vacíos o incompletos)
    // y añadir los archivos directamente desde el DataTransfer acumulado.
    fd.delete('Archivos');
    const files = archivosSeleccionados.files;
    for (let i = 0; i < files.length; i++) {
        fd.append('Archivos', files[i], files[i].name);
    }

    try {
        const resp = await fetch(form.action, {
            method : 'POST',
            body   : fd,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });

        // Si el servidor devuelve un redirect (303/302) o HTML de éxito, navegar
        if (resp.redirected) {
            window.location.href = resp.url;
            return;
        }
        if (resp.ok) {
            // El controlador puede responder con JSON {redirect: url} o directamente redirigir
            const ct = resp.headers.get('Content-Type') || '';
            if (ct.includes('application/json')) {
                const json = await resp.json();
                if (json.redirect) { window.location.href = json.redirect; return; }
            }
            // Fallback: recargar la respuesta como navegación normal
            window.location.href = resp.url || form.action;
            return;
        }
        // Error HTTP: mostrar como alerta
        const text = await resp.text();
        console.error('Error al guardar reclamo:', text);
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-floppy me-1"></i>Guardar Reclamo';
    } catch (err) {
        console.error('Error de red:', err);
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-floppy me-1"></i>Guardar Reclamo';
    }
});
</script>
}
