@model List<FabricaHilos.Models.Sgc.SgcModuloDto>

@{
    ViewData["Title"] = "Planeamiento";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Produccion" asp-action="Index">Producción</a></li>
    <li class="breadcrumb-item active">Planeamiento</li>
}

<h4 class="section-title"><i class="bi bi-kanban me-2"></i>Módulo de Planeamiento</h4>

@if (Model.Any())
{
    <div class="row g-3">
        @foreach (var modulo in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body d-flex flex-column align-items-center text-center p-4">
                        <i class="bi @modulo.Icono display-5 @modulo.ColorClase mb-3"></i>
                        <h6 class="fw-bold mb-1">@modulo.Nombre</h6>
                        <p class="text-muted small mb-3">@modulo.Descripcion</p>
                        <div class="mt-auto w-100">
                            <a asp-controller="@modulo.Controller" asp-action="@modulo.Action"
                               class="btn btn-sm btn-outline-secondary w-100">
                                <i class="bi bi-arrow-right me-1"></i>Ir a @modulo.Nombre
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        No hay módulos disponibles. Contacte al administrador.
    </div>
}
