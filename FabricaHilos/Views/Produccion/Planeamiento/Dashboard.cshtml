@model IReadOnlyList<FabricaHilos.Models.Produccion.Planeamiento.PlnSeguimiento>
@using FabricaHilos.Models.Produccion.Planeamiento

@{
    ViewData["Title"] = "Dashboard de Seguimiento";
    var estados          = ViewBag.Estados as IEnumerable<PlnEstadoCodigo> ?? Array.Empty<PlnEstadoCodigo>();
    var filtroCliente    = ViewBag.FiltroCliente  as string ?? "";
    var filtroPaso       = ViewBag.FiltroPaso      as string ?? "";
    var filtroNumPed     = ViewBag.FiltroNumPed    as string ?? "";
    var filtroAsesor     = ViewBag.FiltroAsesor    as string ?? "";
    var incluyeCerrados  = (bool)(ViewBag.IncluyeCerrados ?? false);
    var paginaActual     = (int)(ViewBag.Pagina       ?? 1);
    var totalPaginas     = (int)(ViewBag.TotalPaginas  ?? 1);
    var totalPedidos     = (int)(ViewBag.TotalPedidos  ?? 0);
    var tamPagina        = (int)(ViewBag.TamPagina     ?? 50);

    // KPIs globales (sobre el conjunto completo filtrado, no solo la página)
    var totalActivos        = (int)(ViewBag.TotalItems      ?? 0);
    var totalRetrasados     = (int)(ViewBag.TotalRetrasados  ?? 0);
    var totalUrgentes       = (int)(ViewBag.TotalUrgentes    ?? 0);
    var totalReprocesos     = (int)(ViewBag.TotalReprocesos  ?? 0);
    var totalSinPlanificar  = (int)(ViewBag.TotalSinPlanif   ?? 0);
    var totalPlanificados   = totalActivos - totalSinPlanificar;

    var alertasPorPedido = ViewBag.AlertasPorPedido as Dictionary<string, int> ?? new Dictionary<string, int>();
    var items = Model;

    // Asesores para el filtro: SOLO los presentes en los pedidos ya cargados en esta
    // página (no se hace una consulta aparte a SP_PLN_FILTRO_ASESORES). La lista se
    // actualiza según los filtros/página vigentes, igual que el patrón usado en
    // PendientesDespacho.cshtml para el filtro de Cliente.
    var asesoresFiltro = items
        .Where(x => !string.IsNullOrWhiteSpace(x.CodVende))
        .Select(x => new { x.CodVende, Nombre = string.IsNullOrWhiteSpace(x.NombreVende) ? x.CodVende : x.NombreVende })
        .DistinctBy(x => x.CodVende)
        .OrderBy(x => x.Nombre)
        .ToList();
}

@section Styles {
<link rel="stylesheet" href="~/css/planeamiento.css" asp-append-version="true" />
<style>
    /* ── Dashboard: estilos exclusivos ─────────────────────────── */

    /* Header strip oscuro con KPIs inline */
    .dash-strip {
        background: linear-gradient(135deg, var(--pln-dark-bg) 0%, var(--pln-gray-700) 100%);
        color: var(--pln-light-text);
        border-radius: .5rem .5rem 0 0;
        padding: .55rem 1rem;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: .5rem;
        border-bottom: 3px solid var(--pln-dark-deep);
        box-shadow: var(--pln-shadow-md);
    }
    .dash-strip-title {
        font-size: .82rem; font-weight: 800; letter-spacing: .08em;
        text-transform: uppercase; color: #f7fafc; white-space: nowrap;
        margin-right: .25rem;
    }
    .dash-strip-sep { width: 1px; height: 1.1rem; background: rgba(255,255,255,.25); flex-shrink: 0; }
    .dash-kpi {
        display: inline-flex; align-items: center; gap: .25rem;
        background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.18);
        border-radius: 999px; padding: .18rem .6rem;
        font-size: .7rem; white-space: nowrap; color: var(--pln-light-text);
    }
    .dash-kpi-val { font-weight: 700; font-size: .82rem; }
    .dash-strip-ts { margin-left: auto; font-size: .68rem; color: var(--pln-light-muted); white-space: nowrap; }
    .dash-strip-ts a { color: var(--pln-light-muted); }
    .dash-strip-ts a:hover { color: var(--pln-accent-blue); }

    /* Panel de filtros siempre visible (sin colapsar) */
    .dash-filter {
        background: #f8fafc;
        border: 1px solid var(--pln-gray-200);
        border-top: none;
        border-radius: 0 0 .45rem .45rem;
        padding: .55rem .9rem;
        margin-bottom: .85rem;
        box-shadow: 0 2px 4px rgba(0,0,0,.05);
    }

    /* Cards de pedido */
    .ped-card {
        border: 1px solid var(--pln-gray-200);
        border-radius: .4rem;
        margin-bottom: .4rem;
        box-shadow: var(--pln-shadow-sm);
        overflow: hidden;
        background: #fff;
    }
    .ped-card.urg  { border-left: 4px solid var(--pln-danger); }
    .ped-card.ret  { border-left: 4px solid var(--pln-warning); }
    .ped-card.norm { border-left: 4px solid var(--pln-gray-200); }
    .ped-card.cerr { border-left: 4px solid #a0aec0; opacity: .72; }

    .ped-head {
        display: flex; align-items: center; flex-wrap: nowrap; gap: .45rem;
        padding: .45rem .7rem; cursor: pointer; user-select: none;
        background: #fafbfd; transition: background .12s;
        overflow: hidden;
    }
    .ped-head:hover { background: #edf2ff; }
    /* Columna 1 — número de pedido (fijo) */
    .ped-num { font-weight: 700; font-size: .88rem; color: #2d3748; white-space: nowrap; flex: 0 0 90px; }
    .ped-num a { color: inherit; text-decoration: none; }
    .ped-num a:hover { color: var(--pln-blue-dk); text-decoration: underline; }
    /* Columna 2 — cliente (flexible, muestra nombre completo) */
    .ped-cliente {
        font-size: .78rem; color: #718096;
        flex: 1 1 240px; min-width: 0;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    /* Columna 3 — kg + fechas (registro / aprobación / compromiso) */
    .ped-meta  { flex: 0 0 265px; display: flex; flex-wrap: wrap; align-items: center; gap: .25rem .4rem; overflow: hidden; }
    /* Columna 4 — etapa + badge "más" (justo antes de acciones) */
    .ped-etapa { flex: 0 0 215px; display: flex; align-items: center; gap: .3rem; overflow: hidden; }
    .ped-meta-num { font-size: .72rem; color: #718096; white-space: nowrap; }
    .ped-actions { display: flex; gap: .25rem; flex-shrink: 0; }

    /* Sub-tabla de ítems colapsable — compacta con fondo ligeramente más oscuro */
    .subtbl { font-size: .77rem; background: #eef1f6; }
    .subtbl thead th {
        font-size: .68rem; font-weight: 700; color: var(--pln-gray-600);
        text-transform: uppercase; letter-spacing: .04em;
        border-bottom: 2px solid #cdd4e0; padding: .28rem .45rem;
        background: #e2e7f0;
    }
    .subtbl td { vertical-align: middle; }
    .subtbl tbody td { padding: .25rem .45rem; }
    .subtbl tbody tr { background: #eef1f6; }
    .subtbl tbody tr:hover td { background: #dde4f0; }
</style>
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Produccion" asp-action="Index">Producción</a></li>
    <li class="breadcrumb-item active">Seguimiento de Pedidos</li>
}

@await Html.PartialAsync("_PlnNavBar")

@{
    // TempData["Error09B"]: mensaje de error cuando se intenta avanzar al paso '09B — Gaseado'
    // con un ítem que no tiene PROCESO='24'. El controller captura la InvalidOperationException
    // lanzada por PlnSeguimientoService.AvanzaPasoAsync y guarda el mensaje aquí.
    // Se muestra en un modal Bootstrap en lugar de dejar que suba como error 500,
    // porque es un error de negocio esperado (no un fallo técnico) y el usuario
    // necesita un mensaje claro para saber qué acción tomar.
    var errorMsg  = TempData["Error09B"]  as string;
    var warnMsg   = TempData["Advertencia"] as string;
    var okMsg     = TempData["Exito"]       as string;
}

@* Modal de error de negocio (ej. intento de avanzar a 09B sin PROCESO='24') *@
@if (!string.IsNullOrEmpty(errorMsg))
{
    <div class="modal fade" id="modalError09B" tabindex="-1" aria-labelledby="modalError09BLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-danger">
                <div class="modal-header bg-danger text-white py-2">
                    <h6 class="modal-title" id="modalError09BLabel">
                        <i class="bi bi-exclamation-octagon-fill me-2"></i>Operación no permitida
                    </h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body small">
                    @* El mensaje explica exactamente por qué no se puede avanzar, incluyendo
                       el proceso actual del ítem y la restricción BUG#35 de PKG_PLN *@
                    <p class="mb-0">@errorMsg</p>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-danger btn-sm" data-bs-dismiss="modal">Entendido</button>
                </div>
            </div>
        </div>
    </div>
}

@* Modal de advertencia genérica *@
@if (!string.IsNullOrEmpty(warnMsg))
{
    <div class="modal fade" id="modalAdvertencia" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-warning">
                <div class="modal-header bg-warning py-2">
                    <h6 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Advertencia</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body small">@warnMsg</div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-warning btn-sm" data-bs-dismiss="modal">Aceptar</button>
                </div>
            </div>
        </div>
    </div>
}

@* Modal de éxito / confirmación *@
@if (!string.IsNullOrEmpty(okMsg))
{
    <div class="modal fade" id="modalExito" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-success">
                <div class="modal-header bg-success text-white py-2">
                    <h6 class="modal-title"><i class="bi bi-check-circle-fill me-2"></i>Operación exitosa</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body small">@okMsg</div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-success btn-sm" data-bs-dismiss="modal">Aceptar</button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Cabecera + KPIs inline + Filtros ─────────────────── *@
<div class="dash-strip">
    <i class="bi bi-kanban-fill" style="color:#90cdf4;font-size:.95rem;flex-shrink:0;"></i>
    <span class="dash-strip-title">Dashboard de Seguimiento</span>
    <span class="dash-strip-sep"></span>

    <span class="dash-kpi" title="Total de pedidos activos (agrupados por N° de pedido).">
        <i class="bi bi-cart-check" style="color:#90cdf4;"></i>
        <span class="dash-kpi-val">@totalPedidos</span>
        <span style="opacity:.75">pedidos</span>
    </span>
    <span class="dash-kpi" title="Total de ítems con ESTADO='A'. Incluye todos los pasos activos (01 al 13).">
        <i class="bi bi-boxes" style="color:#90cdf4;"></i>
        <span class="dash-kpi-val">@totalActivos</span>
        <span style="opacity:.75">ítems</span>
    </span>
    <span class="dash-kpi" style="@(totalRetrasados > 0 ? "" : "opacity:.45")"
          title="Ítems con IND_RETRASO='S': SYSDATE supera FCH_ENTREGA_COMP.">
        <i class="bi bi-clock-history" style="color:#fc8181;"></i>
        <span class="dash-kpi-val" style="@(totalRetrasados > 0 ? "color:#fc8181;" : "")">@totalRetrasados</span>
        <span style="opacity:.75">retraso</span>
    </span>
    <span class="dash-kpi" style="@(totalUrgentes > 0 ? "" : "opacity:.45")"
          title="Ítems con IND_URGENTE='S'. Activado por Ventas o por PKG_PLN.">
        <i class="bi bi-lightning-charge-fill" style="color:#f6ad55;"></i>
        <span class="dash-kpi-val" style="@(totalUrgentes > 0 ? "color:#f6ad55;" : "")">@totalUrgentes</span>
        <span style="opacity:.75">urgentes</span>
    </span>
    <span class="dash-kpi" style="@(totalReprocesos > 0 ? "" : "opacity:.45")"
          title="Ítems con IND_REPROCESO='S': fallaron CC en paso 09 y reinician en 9R.">
        <i class="bi bi-arrow-repeat" style="color:#76e4f7;"></i>
        <span class="dash-kpi-val" style="@(totalReprocesos > 0 ? "color:#76e4f7;" : "")">@totalReprocesos</span>
        <span style="opacity:.75">reprocesos</span>
    </span>
    <span class="dash-kpi" title="Ítems con paso activo >= '02': tienen NROPROG y fechas estimadas asignadas.">
        <i class="bi bi-check2-circle" style="color:#68d391;"></i>
        <span class="dash-kpi-val" style="color:#68d391;">@totalPlanificados</span>
        <span style="opacity:.75">planificados</span>
    </span>
    <span class="dash-kpi" style="@(totalSinPlanificar > 0 ? "" : "opacity:.45")"
          title="Ítems en paso '01' sin fechas estimadas. No generan alertas ni carga de máquinas. Use Gantt → Planificar.">
        <i class="bi bi-hourglass-split" style="color:#fbd38d;"></i>
        <span class="dash-kpi-val" style="@(totalSinPlanificar > 0 ? "color:#fbd38d;" : "")">@totalSinPlanificar</span>
        <span style="opacity:.75">sin planif.</span>
    </span>
    <span class="dash-strip-ts">
        <i class="bi bi-arrow-clockwise me-1"></i>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")
        <a href="#" class="ms-1" data-bs-toggle="tooltip"
           title="Vista general de pedidos activos (ESTADO='A'). Rojo = urgente, amarillo = con retraso. ⚙ = PROCESO='24' (merino/especial, candidato a 09B). Filtre por cliente o etapa.">
            <i class="bi bi-info-circle"></i>
        </a>
    </span>
</div>

@* Filtros — siempre visibles, compactos *@
<div class="dash-filter">
    <form method="get" id="frmFiltros" class="row g-2 align-items-end">
        <input type="hidden" name="pagina" value="1" />
        <div class="col-md-4">
            <label class="form-label fw-semibold mb-1 small">
                <i class="bi bi-person me-1 text-secondary"></i>Cliente (nombre o RUC)
            </label>
            <input name="busquedaCliente" value="@filtroCliente" class="form-control form-control-sm" placeholder="Buscar por nombre o RUC..." />
        </div>
        <div class="col-md-2">
            <label class="form-label fw-semibold mb-1 small">
                <i class="bi bi-hash me-1 text-secondary"></i>N.° Pedido
            </label>
            <input name="numPed" value="@filtroNumPed" class="form-control form-control-sm" placeholder="Ej. 88797..." />
        </div>
        <div class="col-md-2">
            <label class="form-label fw-semibold mb-1 small">
                <i class="bi bi-diagram-3 me-1 text-secondary"></i>Etapa
            </label>
            <select name="codPaso" class="form-select form-select-sm">
                <option value="">— Todas —</option>
                @foreach (var ec in estados.OrderBy(e => e.OrdenPaso))
                {
                    <option value="@ec.CodPaso"
                            title="@ec.Tooltip"
                            selected="@(filtroPaso == ec.CodPaso ? "selected" : null)">
                        @ec.CodPaso — @ec.NombrePaso
                    </option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label fw-semibold mb-1 small">
                <i class="bi bi-person-badge me-1 text-secondary"></i>Asesor
            </label>
            <select name="asesor" class="form-select form-select-sm">
                <option value="">— Todos —</option>
                @foreach (var a in asesoresFiltro)
                {
                    <option value="@a.CodVende" selected="@(filtroAsesor == a.CodVende ? "selected" : null)">
                        @a.Nombre
                    </option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary btn-sm w-100">
                <i class="bi bi-funnel me-1"></i>Filtrar
                @if (!string.IsNullOrEmpty(filtroCliente) || !string.IsNullOrEmpty(filtroPaso) || !string.IsNullOrEmpty(filtroNumPed) || !string.IsNullOrEmpty(filtroAsesor))
                {
                    <span class="badge bg-white text-primary ms-1" style="font-size:.6rem;">activo</span>
                }
            </button>
        </div>
        <div class="col-md-2">
            <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm w-100">
                <i class="bi bi-x-circle me-1"></i>Limpiar
            </a>
        </div>
        <div class="col-12 mt-1">
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" name="incluyeCerrados" value="true"
                       id="chkCerrados" @(incluyeCerrados ? "checked" : "")
                       onchange="this.form.submit()" />
                <label class="form-check-label small fw-semibold" for="chkCerrados">
                    <i class="bi bi-archive me-1 text-secondary"></i>Mostrar pedidos cerrados (despachados)
                </label>
            </div>
        </div>
    </form>
</div>

@* ── Pedidos activos (cards) ──────────────────────────── *@
<div class="section-sep"><i class="bi bi-stack"></i> @(incluyeCerrados ? "Pedidos (activos + cerrados)" : "Pedidos activos")</div>
@{
    // Mapa CodPaso → OrdenPaso para determinar la etapa más avanzada.
    var ordenPasoMap = estados.ToDictionary(e => e.CodPaso, e => e.OrdenPaso);

    // Los ítems de cada pedido se muestran ordenados por N° de ítem (asc).
    var pedidosGrupo = items
        .GroupBy(x => new { x.Serie, x.NumPed })
        .Select(g =>
        {
            var lista       = g.OrderBy(x => x.Nro).ToList();
            var esUrgente   = lista.Any(x => x.EsUrgente);
            var retrasado   = lista.Any(x => x.EstaRetrasado);
            var maxRetraso  = lista.Max(x => x.DiasRetraso);
            var kgTotal     = lista.Sum(x => x.KgPendientes);
            var fchMin      = lista.Where(x => x.FchEntregaComp.HasValue)
                                   .Select(x => x.FchEntregaComp!.Value)
                                   .DefaultIfEmpty()
                                   .Min();
            var etapas      = lista.Select(x => x.CodPasoAct).Distinct().ToList();
            var mayorItem    = lista
                .OrderByDescending(x => ordenPasoMap.TryGetValue(x.CodPasoAct, out var op) ? op : 0)
                .ThenByDescending(x => x.DiasRetraso)
                .First();
            var mayorColor     = mayorItem.ColorUi   ?? "#6c757d";
            var mayorNombre    = mayorItem.NombrePaso ?? "";
            var mayorCodigo    = mayorItem.CodPasoAct ?? "";
            var cliente       = lista.First().NombreCliente;
            var serie         = g.Key.Serie;
            var numPedG       = g.Key.NumPed;
            var fchPedido     = lista.First().FchPedido;
            var fchAprobacion = lista.Where(x => x.FchRealProgramado.HasValue)
                                     .Select(x => x.FchRealProgramado)
                                     .FirstOrDefault();
            var nroCount      = lista.Select(x => x.Nro).Distinct().Count();
            return (serie, numPed: numPedG, cliente, lista, esUrgente, retrasado, maxRetraso,
                    kgTotal, fchMin, etapas, mayorColor, mayorNombre, mayorCodigo,
                    fchPedido, fchAprobacion, nroCount);
        })
        .OrderByDescending(p => p.numPed)
        .ThenByDescending(p => p.esUrgente)
        .ThenByDescending(p => p.maxRetraso)
        .ThenBy(p => p.fchMin == default ? DateTime.MaxValue : p.fchMin)
        .ToList();
}
@if (!items.Any())
{
    <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>No hay ítems @(incluyeCerrados ? "con los filtros seleccionados" : "activos con los filtros seleccionados").</div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <span class="text-muted small">
            @totalPedidos pedidos en total · página @paginaActual de @totalPaginas
            · @totalActivos ítems @(incluyeCerrados ? "(incl. cerrados)" : "activos")
        </span>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <div class="d-flex align-items-center gap-1">
                <span class="text-muted small">Mostrar:</span>
                @foreach (var tp in new[] { 50, 100, 200 })
                {
                    var urlTp = new System.Text.StringBuilder("/Planeamiento/Dashboard?pagina=1&tamPagina=").Append(tp);
                    if (!string.IsNullOrEmpty(filtroCliente)) urlTp.Append("&busquedaCliente=").Append(Uri.EscapeDataString(filtroCliente));
                    if (!string.IsNullOrEmpty(filtroPaso))    urlTp.Append("&codPaso=").Append(Uri.EscapeDataString(filtroPaso));
                    if (!string.IsNullOrEmpty(filtroNumPed))  urlTp.Append("&numPed=").Append(Uri.EscapeDataString(filtroNumPed));
                    if (!string.IsNullOrEmpty(filtroAsesor))  urlTp.Append("&asesor=").Append(Uri.EscapeDataString(filtroAsesor));
                    if (incluyeCerrados)                      urlTp.Append("&incluyeCerrados=true");
                    <a href="@urlTp" class="btn btn-sm @(tamPagina == tp ? "btn-primary" : "btn-outline-secondary")" style="min-width:2.8rem;font-size:.72rem;padding:.18rem .45rem;">@tp</a>
                }
            </div>
            <button type="button" id="btnExpandAll" class="btn btn-outline-secondary btn-sm"
                    title="Expandir todos los pedidos para ver sus ítems">
                <i class="bi bi-chevron-double-down me-1"></i>Expandir todo
            </button>
            <button type="button" id="btnCollapseAll" class="btn btn-outline-secondary btn-sm"
                    title="Colapsar todos los pedidos">
                <i class="bi bi-chevron-double-up me-1"></i>Colapsar todo
            </button>
        </div>
    </div>

    @foreach (var p in pedidosGrupo)
    {
        var collapseId = $"items-{p.serie}-{p.numPed}";
        var esCerrado  = p.lista.All(x => x.EstaCerrado);
        var cardCls    = esCerrado ? "cerr" : p.esUrgente ? "urg" : p.retrasado ? "ret" : "norm";
        var keyAlerta  = $"{p.serie}|{p.numPed}";
        var cntAlerta  = alertasPorPedido.TryGetValue(keyAlerta, out var ca) ? ca : 0;
        <div class="ped-card @cardCls">
            @* Cabecera: clic = expandir/colapsar *@
            <div class="ped-head"
                 data-collapse-target="@collapseId"
                 onclick="togglePedidoRow(event, '@collapseId')">
                <i class="bi bi-chevron-right toggle-icon" style="font-size:.7rem;flex-shrink:0;color:#718096;"></i>

                <span class="ped-num">
                    <a asp-action="Pedido" asp-route-numPed="@p.numPed" asp-route-serie="@p.serie">
                        @p.serie-@p.numPed
                    </a>
                    @if (p.esUrgente)
                    {
                        <span class="badge bg-danger ms-1" title="Pedido urgente"><i class="bi bi-lightning-charge-fill"></i></span>
                    }
                    @if (esCerrado)
                    {
                        <span class="badge bg-success ms-1" style="font-size:.6rem;" title="Todos los ítems despachados y cerrados"><i class="bi bi-check2-all me-1"></i>Cerrado</span>
                    }
                    @if (cntAlerta > 0)
                    {
                        <span class="badge bg-warning text-dark ms-1"
                              title="@cntAlerta alerta(s) activa(s) en este pedido. Abra la bandeja de Alertas para ver el detalle.">
                            <i class="bi bi-bell-fill me-1"></i>@cntAlerta
                        </span>
                    }
                </span>

                <span class="ped-cliente" title="@p.cliente">@p.cliente</span>

                @* Columna 3 — métricas (kg + fechas) *@
                <span class="ped-meta">
                    <span class="ped-meta-num" title="Suma de kg pendientes">
                        <i class="bi bi-box2 me-1 text-secondary"></i>@p.kgTotal.ToString("N0") kg
                    </span>
                    <span class="ped-meta-num" title="Fecha de registro del pedido">
                        <i class="bi bi-calendar-event me-1 text-secondary"></i>Reg. @p.fchPedido.ToString("dd/MM/yy")
                    </span>
                    @if (p.fchAprobacion.HasValue)
                    {
                        <span class="ped-meta-num" title="Fecha de aprobación / planificación">
                            <i class="bi bi-calendar-check me-1" style="color:#48bb78;"></i>Apr. @p.fchAprobacion.Value.ToString("dd/MM/yy")
                        </span>
                    }
                    @if (p.fchMin != default)
                    {
                        <span class="ped-meta-num" title="Fecha compromiso de entrega más próxima">
                            <i class="bi bi-calendar3 me-1 text-secondary"></i>
                            <span class="@(p.retrasado ? "text-danger fw-bold" : "")">@p.fchMin.ToString("dd/MM/yy")</span>
                        </span>
                    }
                </span>

                @if (p.maxRetraso > 0)
                {
                    <span class="badge @(p.maxRetraso >= 7 ? "bg-danger" : p.maxRetraso >= 3 ? "bg-warning text-dark" : "bg-secondary")"
                          title="Días de retraso máximo entre todos los ítems del pedido.">
                        +@p.maxRetraso d
                    </span>
                }
                <span class="badge bg-secondary" title="@p.nroCount ítem(s) · @p.lista.Count sub-lote(s)">@p.nroCount</span>

                @* Etapa más avanzada — justo antes de los botones de acción *@
                <span class="ped-etapa">
                    <span class="paso-badge text-white" style="background-color:@p.mayorColor;font-size:.7rem;">
                        @p.mayorCodigo — @p.mayorNombre
                    </span>
                    @if (p.etapas.Count > 1)
                    {
                        <span class="badge bg-light text-muted border" style="font-size:.65rem;"
                              title="Este pedido tiene ítems en @p.etapas.Count etapas distintas.">
                            +@(p.etapas.Count - 1) más
                        </span>
                    }
                </span>

                <div class="ped-actions ms-auto">
                    <a asp-action="Pedido" asp-route-numPed="@p.numPed" asp-route-serie="@p.serie"
                       class="btn btn-outline-primary btn-accion" title="Detalle del pedido">
                        <i class="bi bi-clipboard2-data"></i>
                    </a>
                    <a asp-action="PedidoGantt" asp-route-numPed="@p.numPed" asp-route-serie="@p.serie"
                       class="btn btn-outline-success btn-accion" title="Gantt del pedido">
                        <i class="bi bi-bar-chart-steps"></i>
                    </a>
                </div>
            </div>

            @* Ítems del pedido (colapsable) *@
            <div class="collapse" id="@collapseId">
                <table class="table table-sm mb-0 subtbl">
                    <thead>
                        <tr>
                            <th class="item-indent" style="width:28px;"></th>
                            <th style="width:38px;text-align:center;">Ítem</th>
                            <th>Artículo</th>
                            <th>Proceso</th>
                            <th>Título / Color</th>
                            <th>Etapa</th>
                            <th>Avance</th>
                            <th class="text-end">Kg pend.</th>
                            <th>F. entrega</th>
                            <th>Retraso</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            // Agrupar sub-lotes (NUM_DET) por ítem (NRO) — mostrar una fila por NRO
                            // con el paso más atrasado (menor ORDEN_PASO) y KG/fechas agregados.
                            var nroGrupos = p.lista
                                .GroupBy(x => x.Nro)
                                .Select(g2 =>
                                {
                                    var ordered = g2
                                        .OrderBy(x => ordenPasoMap.TryGetValue(x.CodPasoAct, out var op) ? op : 99)
                                        .ToList();
                                    var peor = ordered.First(); // sublot más atrasado
                                    var fchEnt = g2.Where(x => x.FchEntregaComp.HasValue)
                                                   .Select(x => x.FchEntregaComp!.Value)
                                                   .DefaultIfEmpty()
                                                   .Min();
                                    var allClosed = g2.All(x => x.EstaCerrado);
                                    return (
                                        Nro:           g2.Key,
                                        Peor:          peor,
                                        NumSublots:    ordered.Count,
                                        KgPendientes:  g2.Sum(x => x.KgPendientes),
                                        FchEntrega:    fchEnt == default ? (DateTime?)null : fchEnt,
                                        DiasRetraso:   g2.Max(x => x.DiasRetraso),
                                        EsUrgente:     g2.Any(x => x.EsUrgente),
                                        EstaRetrasado: g2.Any(x => x.EstaRetrasado),
                                        AllClosed:     allClosed,
                                        TieneReclamo:  g2.Any(x => x.TieneReclamo)
                                    );
                                })
                                // Activos primero (por NRO), cerrados al final
                                .OrderBy(x => x.AllClosed ? 1 : 0)
                                .ThenBy(x => x.Nro)
                                .ToList();
                        }
                        @foreach (var grp in nroGrupos)
                        {
                            var s        = grp.Peor;
                            var subClass = grp.AllClosed
                                ? "text-muted"
                                : grp.EsUrgente ? "table-danger" : grp.EstaRetrasado ? "table-warning" : "";
                            <tr class="@subClass" style="@(grp.AllClosed ? "opacity:.65;" : "")">
                                <td class="item-indent">
                                    @if (grp.AllClosed)
                                    {
                                        <i class="bi bi-check2-circle text-success" title="Despachado/Cerrado"></i>
                                    }
                                    else if (grp.EsUrgente)
                                    {
                                        <i class="bi bi-lightning-charge-fill text-danger" title="Urgente"></i>
                                    }
                                    else if (grp.EstaRetrasado)
                                    {
                                        <i class="bi bi-clock-history text-warning" title="Con retraso"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-dot text-muted"></i>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge @(grp.AllClosed ? "bg-success" : "bg-dark")" style="font-size:.65rem;border-radius:2px;">@grp.Nro</span>
                                    @if (grp.TieneReclamo)
                                    {
                                        <br /><span class="badge bg-danger mt-1" style="font-size:.58rem;" title="ITEMPED.CANTIDAD_R > 0: tiene reclamo asociado"><i class="bi bi-exclamation-triangle-fill me-1"></i>Reclamo</span>
                                    }
                                </td>
                                <td class="text-truncate" style="max-width:120px;" title="@s.CodArt">@s.CodArt</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(s.Proceso))
                                    {
                                        <span class="badge @(s.Proceso == "24" ? "text-white" : "bg-light text-dark border") fw-semibold"
                                              style="@(s.Proceso == "24" ? "background:#6f42c1;" : "")"
                                              title="PROCESO='@s.Proceso'@(s.Proceso == "24" ? ": hilo especial — candidato a paso 09B." : ": flujo estándar.")">
                                            @s.Proceso
                                        </span>
                                    }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <td>
                                    <span>@s.Titulo</span>
                                    @if (!string.IsNullOrEmpty(s.Color))
                                    {
                                        <br /><span class="text-muted" style="font-size:.7rem;">@s.Color</span>
                                    }
                                </td>
                                <td>
                                    <span class="paso-badge text-white" style="background-color:@s.ColorUi;font-size:.68rem;">
                                        @s.CodPasoAct — @s.NombrePaso
                                    </span>
                                    @if (s.EstaEnReproceso)
                                    {
                                        <span class="badge bg-danger ms-1" title="Reproceso ciclo @s.NroCiclo">C.@s.NroCiclo</span>
                                    }
                                    @if (s.Proceso == "24")
                                    {
                                        <i class="bi bi-gear-fill ms-1" style="color:#6f42c1;font-size:.72rem;" title="Hilo especial — candidato a 09B"></i>
                                    }
                                    @if (s.CodPasoAct == "01")
                                    {
                                        <i class="bi bi-hourglass-split ms-1 text-muted" style="font-size:.7rem;" title="Sin planificar — sin fechas estimadas"></i>
                                    }
                                    @if (grp.NumSublots > 1)
                                    {
                                        <span class="badge bg-light text-muted border ms-1" style="font-size:.62rem;"
                                              title="@grp.NumSublots sub-lotes de producción. Etapa muestra el sub-lote más atrasado.">
                                            @grp.NumSublots sub-lotes
                                        </span>
                                    }
                                </td>
                                <td style="min-width:90px;">
                                    <div class="progress progress-thin mt-1">
                                        <div class="progress-bar" role="progressbar"
                                             style="width:@s.PctAvance%;background-color:@s.ColorUi;"></div>
                                    </div>
                                    <span class="text-muted" style="font-size:.7rem;">@s.PctAvance%</span>
                                </td>
                                <td class="text-end fw-semibold">@grp.KgPendientes.ToString("N0")</td>
                                <td>
                                    @if (grp.FchEntrega.HasValue)
                                    {
                                        <span class="@(grp.EstaRetrasado ? "text-danger fw-bold" : "")">
                                            @grp.FchEntrega.Value.ToString("dd/MM/yy")
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (grp.DiasRetraso > 0)
                                    {
                                        <span class="badge @(grp.DiasRetraso >= 7 ? "bg-danger" : grp.DiasRetraso >= 3 ? "bg-warning text-dark" : "bg-secondary")">
                                            +@grp.DiasRetraso d
                                        </span>
                                    }
                                </td>
                                <td style="white-space:nowrap;">
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-sm py-0 px-1"
                                            style="font-size:.65rem;"
                                            title="Línea de Tiempo — @s.CodArt@(grp.NumSublots > 1 ? " (sub-lote más atrasado)" : "")"
                                            onclick="abrirModalItem('timeline',@p.numPed,@p.serie,@grp.Nro,@s.NumDet,'@s.CodArt')">
                                        <i class="bi bi-clipboard2-pulse me-1"></i>L. Tiempo
                                    </button>
                                    <button type="button"
                                            class="btn btn-outline-success btn-sm py-0 px-1 ms-1"
                                            style="font-size:.65rem;"
                                            title="Gantt — @s.CodArt@(grp.NumSublots > 1 ? " (sub-lote más atrasado)" : "")"
                                            onclick="abrirModalItem('gantt',@p.numPed,@p.serie,@grp.Nro,@s.NumDet,'@s.CodArt')">
                                        <i class="bi bi-bar-chart-steps me-1"></i>Gantt
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* ── Paginación ─────────────────────────────────────────────────────── *@
    @if (totalPaginas > 1)
    {
        @* Helper: URL de una página conservando todos los filtros activos *@
        Func<int, string> urlPagina = pg =>
        {
            var qs = new System.Text.StringBuilder("?pagina=").Append(pg);
            qs.Append("&tamPagina=").Append(tamPagina);
            if (!string.IsNullOrEmpty(filtroCliente))  qs.Append("&busquedaCliente=").Append(Uri.EscapeDataString(filtroCliente));
            if (!string.IsNullOrEmpty(filtroPaso))     qs.Append("&codPaso=").Append(Uri.EscapeDataString(filtroPaso));
            if (!string.IsNullOrEmpty(filtroNumPed))   qs.Append("&numPed=").Append(Uri.EscapeDataString(filtroNumPed));
            if (incluyeCerrados)                       qs.Append("&incluyeCerrados=true");
            return "/Planeamiento/Dashboard" + qs.ToString();
        };

        const int maxBotones = 7;  // botones numéricos visibles a cada lado del actual
        int pIni = Math.Max(1, paginaActual - maxBotones / 2);
        int pFin = Math.Min(totalPaginas, pIni + maxBotones - 1);
        if (pFin - pIni < maxBotones - 1) pIni = Math.Max(1, pFin - maxBotones + 1);

        <nav class="mt-3" aria-label="Paginación de pedidos">
            <ul class="pagination pagination-sm justify-content-center flex-wrap mb-1">
                <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                    <a class="page-link" href="@urlPagina(1)" title="Primera página">
                        <i class="bi bi-chevron-double-left"></i>
                    </a>
                </li>
                <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                    <a class="page-link" href="@urlPagina(paginaActual - 1)" title="Página anterior">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                @if (pIni > 1)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                @for (int pg = pIni; pg <= pFin; pg++)
                {
                    <li class="page-item @(pg == paginaActual ? "active" : "")">
                        <a class="page-link" href="@urlPagina(pg)">@pg</a>
                    </li>
                }
                @if (pFin < totalPaginas)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                    <a class="page-link" href="@urlPagina(paginaActual + 1)" title="Página siguiente">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
                <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                    <a class="page-link" href="@urlPagina(totalPaginas)" title="Última página">
                        <i class="bi bi-chevron-double-right"></i>
                    </a>
                </li>
            </ul>
            <p class="text-center text-muted mb-0" style="font-size:.72rem;">
                Mostrando pedidos @((paginaActual - 1) * tamPagina + 1)–@(Math.Min(paginaActual * tamPagina, totalPedidos)) de @totalPedidos
            </p>
        </nav>
    }
}

<!-- Modal L. Tiempo / Gantt por ítem -->
<div class="modal fade" id="modalItemVista" tabindex="-1" aria-labelledby="modalItemVistaLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" style="max-width:680px;">
        <div class="modal-content" style="border:2px solid var(--pln-navy);border-radius:4px;box-shadow:var(--pln-shadow-lg);overflow:hidden;position:relative;">
            <button type="button" class="btn-close btn-close-white position-absolute"
                    data-bs-dismiss="modal" aria-label="Cerrar"
                    style="top:.5rem;right:.55rem;z-index:10;filter:drop-shadow(0 1px 2px rgba(0,0,0,.5));"></button>
            <div class="modal-body p-0" id="modalItemBody" style="background:var(--pln-gray-50);">
                <div class="d-flex align-items-center justify-content-center py-5 text-muted gap-2">
                    <div class="spinner-border spinner-border-sm" style="color:var(--pln-blue-link);"></div>
                    <span style="font-size:.8rem;">Cargando…</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ── Modal L.Tiempo / Gantt por ítem ─────────────────────────────────────
    function abrirModalItem(tipo, numPed, serie, nro, numDet, codArt) {
        const modal = new bootstrap.Modal(document.getElementById('modalItemVista'));
        const body  = document.getElementById('modalItemBody');

        const isTimeline = tipo === 'timeline';

        body.innerHTML = '<div class="d-flex align-items-center justify-content-center py-5 text-muted gap-2"><div class="spinner-border spinner-border-sm" style="color:var(--pln-blue-link);"></div><span style="font-size:.8rem;">Cargando…</span></div>';
        modal.show();

        const action = isTimeline ? 'ItemTimeline' : 'ItemGantt';
        fetch(`/Planeamiento/${action}?numPed=${numPed}&serie=${serie}&nro=${nro}&numDet=${numDet}`)
            .then(r => r.ok ? r.text() : Promise.reject(r.status))
            .then(html => { body.innerHTML = html; })
            .catch(() => { body.innerHTML = '<div class="alert alert-danger m-2">No se pudo cargar la información del ítem.</div>'; });
    }

    // Esta función se llama desde el onclick de cada <tr class="pedido-header">.
    // Solo expande/colapsa si el click NO fue en un enlace (<a>) o botón (<button>).
    // Esto permite que los enlaces dentro de la fila naveguen normalmente sin expandir.
    function togglePedidoRow(event, collapseId) {
        // Si el click fue en un <a>, <button>, o dentro de un <td> marcado con stopPropagation, ignorar
        const target = event.target;
        const clickedOnInteractive = target.closest('a, button') !== null;
        const clickedOnStopCell = target.closest('td[onclick*="stopPropagation"]') !== null;

        if (clickedOnInteractive || clickedOnStopCell) return;

        // Expandir/colapsar el panel
        const collapseEl = document.getElementById(collapseId);
        if (collapseEl) {
            const bsCollapse = bootstrap.Collapse.getOrCreateInstance(collapseEl);
            bsCollapse.toggle();
        }
    }

    // Inicializar tooltips de Bootstrap para todos los encabezados y badges
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el =>
        new bootstrap.Tooltip(el, { placement: 'top' }));

    // ── Persistir pedidos expandidos en localStorage ────────────────────────
    // Cuando el usuario navega al detalle de un pedido y regresa, la tabla recuerda
    // qué pedidos estaban abiertos y los restaura automáticamente, evitando que tenga
    // que volver a expandirlos uno a uno.
    const LS_EXPANDED = 'pln_dash_expanded';

    function getExpandedSet() {
        try { return new Set(JSON.parse(localStorage.getItem(LS_EXPANDED) || '[]')); }
        catch (_) { return new Set(); }
    }
    function saveExpandedSet(s) {
        try { localStorage.setItem(LS_EXPANDED, JSON.stringify([...s])); } catch (_) { }
    }

    // Los pedidos siempre arrancan colapsados; se limpia cualquier estado previo
    saveExpandedSet(new Set());

    // Rotar el ícono chevron cuando se expande/colapsa la fila de ítems del pedido.
    // El evento 'show.bs.collapse' se dispara al comenzar a expandirse el panel colapsable.
    document.querySelectorAll('.collapse').forEach(collapseEl => {
        collapseEl.addEventListener('show.bs.collapse', function () {
            const row = document.querySelector(`[data-collapse-target="${this.id}"]`);
            if (row) row.querySelector('.toggle-icon')?.classList.add('rotated');
            const s = getExpandedSet(); s.add(this.id); saveExpandedSet(s);
        });
        collapseEl.addEventListener('hide.bs.collapse', function () {
            const row = document.querySelector(`[data-collapse-target="${this.id}"]`);
            if (row) row.querySelector('.toggle-icon')?.classList.remove('rotated');
            const s = getExpandedSet(); s.delete(this.id); saveExpandedSet(s);
        });
    });

    // Expandir/colapsar todo: primero actúa sobre el DOM, luego persiste
    document.getElementById('btnExpandAll')?.addEventListener('click', () => {
        const s = getExpandedSet();
        document.querySelectorAll('.collapse[id^="items-"]').forEach(el => {
            s.add(el.id);
            if (!el.classList.contains('show'))
                bootstrap.Collapse.getOrCreateInstance(el).show();
        });
        saveExpandedSet(s);
    });
    document.getElementById('btnCollapseAll')?.addEventListener('click', () => {
        document.querySelectorAll('.collapse[id^="items-"]').forEach(el => {
            if (el.classList.contains('show'))
                bootstrap.Collapse.getOrCreateInstance(el).hide();
        });
        saveExpandedSet(new Set());
    });

    // Abrir automáticamente el modal que corresponda según TempData.
    // Se usa show() en lugar de depender del atributo data-bs-toggle en un botón
    // porque el modal fue colocado por el servidor (TempData), no por acción del usuario.
    // Razón: el usuario realizó una operación POST (ej. intentar avanzar a 09B) y fue
    // redirigido de vuelta al Dashboard. El modal aparece de inmediato para informarle
    // el resultado sin necesidad de que haga scroll o busque un mensaje de alerta.
    @if (!string.IsNullOrEmpty(errorMsg))
    {
        <text>new bootstrap.Modal(document.getElementById('modalError09B')).show();</text>
    }
    @if (!string.IsNullOrEmpty(warnMsg))
    {
        <text>new bootstrap.Modal(document.getElementById('modalAdvertencia')).show();</text>
    }
    @if (!string.IsNullOrEmpty(okMsg))
    {
        <text>new bootstrap.Modal(document.getElementById('modalExito')).show();</text>
    }
</script>
}

