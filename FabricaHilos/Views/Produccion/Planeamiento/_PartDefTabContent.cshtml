@using FabricaHilos.Models.Produccion.Planeamiento
@model IEnumerable<PlnPendientePartidaDef>
@{
    var lista      = Model.ToList();
    var kgTotal    = lista.Sum(x => x.PesoNeto);
    var estEvalSel = ViewBag.FiltroEstEval as string ?? "";
    var tiposEval  = (ViewBag.TiposEvalAll as List<string>) ?? new List<string>();
    var urlForm    = Url.Action("PartidasDefPartial", "Planeamiento");
}

@* -- Filtro de tipo evaluacion -- *@
<div class="pend-filter mb-3">
    <form method="get" action="@urlForm" class="d-flex gap-2 align-items-end flex-wrap" id="frmFiltrosPartDef" data-no-loading>
        <div>
            <label class="form-label form-label-sm mb-0">Tipo de Evaluacion</label>
            <select name="estEval" class="form-select form-select-sm" style="min-width:180px;">
                @if (string.IsNullOrEmpty(estEvalSel))
                {
                    <option value="" selected="selected">Todas</option>
                }
                else
                {
                    <option value="">Todas</option>
                }
                @foreach (var ev in tiposEval)
                {
                    if (ev == estEvalSel)
                    {
                        <option value="@ev" selected="selected">@ev</option>
                    }
                    else
                    {
                        <option value="@ev">@ev</option>
                    }
                }
            </select>
        </div>
        <div>
            <button type="submit" class="btn btn-primary btn-sm">
                <i class="bi bi-search me-1"></i>Filtrar
            </button>
        </div>
    </form>
</div>

@* -- Contenido -- *@
@if (!lista.Any())
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle me-2"></i>No hay partidas pendientes de definicion en este momento.
    </div>
}
else
{
    <div class="d-flex align-items-center justify-content-between mb-2">
        <div class="d-flex align-items-center gap-2">
            <label class="form-label mb-0 small text-muted">Filas:</label>
            <select id="tblPartDef-pgsize" class="form-select form-select-sm" style="width:80px;">
                <option value="20" selected>20</option>
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="200">200</option>
            </select>
        </div>
    </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0 pend-tbl" id="tblPartDef">
                <thead>
                <tr>
                    <th class="text-center">Fecha</th>
                    <th>Partida</th>
                    <th>Material</th>
                    <th>Presentacion</th>
                    <th>Intensidad</th>
                    <th class="text-center">RMC</th>
                    <th class="text-end">Kg Neto</th>
                    <th>Cliente</th>
                    <th>Defecto</th>
                    <th>Evaluacion</th>
                    <th>Observaciones</th>
                    <th class="text-center">F. Entrega</th>
                    <th class="text-center">Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in lista)
                {
                    var rowCss = item.EstaVencido ? "table-danger" :
                                 item.DiasRetraso >= -2 ? "table-warning" : "";
                    <tr class="@rowCss">
                        <td class="text-center text-muted">
                            @(item.Fecha.HasValue ? item.Fecha.Value.ToString("dd/MM/yy") : "—")
                        </td>
                        <td class="fw-bold" style="white-space:nowrap;">@item.Partida</td>
                        <td>@item.Material</td>
                        <td style="font-size:.78rem;">@item.Color</td>
                        <td style="font-size:.78rem;" class="text-muted">@item.DescIntensidad</td>
                        <td class="text-center text-muted">
                            @(item.NroRmc > 0 ? item.NroRmc.ToString("N0") : "—")
                        </td>
                        <td class="text-end fw-semibold">@item.PesoNeto.ToString("N2")</td>
                        <td>
                            <span style="max-width:150px;display:inline-block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
                                  title="@item.Cliente">@item.Cliente</span>
                        </td>
                        <td style="font-size:.78rem;">
                            @if (!string.IsNullOrWhiteSpace(item.DescDefecto))
                            {
                                <span class="badge bg-secondary">@item.DescDefecto</span>
                            }
                        </td>
                        <td style="font-size:.78rem;">
                            @if (!string.IsNullOrWhiteSpace(item.DescEvaluacion))
                            {
                                if (item.DescEvaluacion == "RECHAZADO")
                                {
                                    <span class="badge bg-danger">@item.DescEvaluacion</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark">@item.DescEvaluacion</span>
                                }
                            }
                        </td>
                        <td style="font-size:.75rem;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
                            title="@item.Observaciones">
                            @item.Observaciones
                        </td>
                        <td class="text-center">
                            @if (item.FchEntrega.HasValue)
                            {
                                if (item.EstaVencido)
                                {
                                    <span class="fw-semibold text-danger">@item.FchEntrega.Value.ToString("dd/MM/yy")</span>
                                }
                                else if (item.DiasRetraso >= -2)
                                {
                                    <span class="fw-semibold text-warning">@item.FchEntrega.Value.ToString("dd/MM/yy")</span>
                                }
                                else
                                {
                                    <span class="fw-semibold text-success">@item.FchEntrega.Value.ToString("dd/MM/yy")</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (!item.FchEntrega.HasValue)
                            {
                                <span class="text-muted">—</span>
                            }
                            else if (item.EstaVencido)
                            {
                                <span class="badge bg-danger" title="@item.DiasRetraso dias vencido">+@item.DiasRetraso d</span>
                            }
                            else if (item.DiasRetraso >= -2)
                            {
                                <span class="badge bg-warning text-dark">@(-item.DiasRetraso) d</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@(-item.DiasRetraso) d</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-semibold">
                    <td colspan="6" class="text-end text-muted">Totales:</td>
                    <td class="text-end">@kgTotal.ToString("N2")</td>
                    <td colspan="6"></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="d-flex align-items-center justify-content-between mt-2">
        <nav><ul class="pagination pagination-sm mb-0" id="tblPartDef-pgnav"></ul></nav>
        <div id="tblPartDef-pginfo" class="small text-muted"></div>
    </div>
}
