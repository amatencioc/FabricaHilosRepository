@model List<FabricaHilos.Models.Ventas.Cotizacion.RutaTecnicaCabDto>
@{
    ViewData["Title"] = "Fichas Técnicas de Ruta";
    string? buscar = ViewBag.Buscar as string;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Ventas" asp-action="Index">Ventas</a></li>
    <li class="breadcrumb-item"><a asp-controller="Cotizacion" asp-action="Index">Cotizaciones</a></li>
    <li class="breadcrumb-item active">Fichas Técnicas de Ruta</li>
}

@section Styles {
    <link rel="stylesheet" href="~/css/sire.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cotizacion.css" asp-append-version="true" />
}

<div class="sire-page-header">
    <div class="sire-page-icon sire"><i class="bi bi-clipboard-data"></i></div>
    <div>
        <h1 class="sire-page-title">Fichas Técnicas de Ruta</h1>
        <div class="sire-page-sub">
            Mantenimiento de Preparatoria — reemplaza el Excel manual usado para armar cotizaciones.
            Cada ficha (título + tonalidad) alimenta el panel informativo en Simular/Detalle de Cotización.
        </div>
    </div>
    <div class="sire-page-actions">
        <a asp-action="Editar" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Nueva ficha
        </a>
    </div>
</div>

@Html.AntiForgeryToken()

<div class="sire-filter">
    <form method="get" asp-action="Index" class="d-flex gap-2 flex-wrap align-items-center w-100">
        <i class="bi bi-search small" style="color:var(--sire-gray-600);"></i>
        <input type="text" name="buscar" value="@buscar"
               class="form-control form-control-sm"
               placeholder="Buscar por título o producto..." style="max-width:280px;" />
        <button type="submit" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-search"></i> Buscar
        </button>
        @if (!string.IsNullOrEmpty(buscar))
        {
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Limpiar</a>
        }
    </form>
</div>

<div class="sire-card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="sire-table w-100 mb-0">
                <thead>
                    <tr>
                        <th>Título ERP</th>
                        <th>Título / Ruta</th>
                        <th>Tonalidad</th>
                        <th>Producto</th>
                        <th class="text-center">Actualizado</th>
                        <th class="text-center">Pedido (kg)</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model)
                    {
                        <tr class="@(f.Estado != "A" ? "sire-row-excluido" : "")">
                            <td>
                                <span class="sire-badge sire-badge-info">@f.TituloCod</span>
                                @if (!string.IsNullOrEmpty(f.TituloDesc))
                                {
                                    <span class="small text-muted d-block">@f.TituloDesc</span>
                                }
                            </td>
                            <td><strong>@f.TituloRoute</strong></td>
                            <td>@f.Tonalidad</td>
                            <td>@f.ProductoDesc</td>
                            <td class="text-center">@(f.FchActualizado?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td class="text-center">@(f.PedidoMinKg?.ToString("N0") ?? "-") - @(f.PedidoMaxKg?.ToString("N0") ?? "-")</td>
                            <td class="text-center">
                                @if (f.Estado == "A")
                                {
                                    <span class="sire-badge sire-badge-ok">Activa</span>
                                }
                                else
                                {
                                    <span class="sire-badge sire-badge-danger">Anulada</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Editar" asp-route-idCab="@f.IdCab" class="btn btn-sm btn-outline-primary" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                @if (f.Estado == "A")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger btn-anular" data-id="@f.IdCab" title="Anular">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-success btn-restaurar" data-id="@f.IdCab" title="Restaurar">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No hay fichas técnicas registradas.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function getToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        async function postAccion(url, idCab) {
            const resp = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': getToken() },
                body: `idCab=${encodeURIComponent(idCab)}`
            });
            return resp.json();
        }

        document.querySelectorAll('.btn-anular').forEach(btn => {
            btn.addEventListener('click', async () => {
                const ok = await AppConfirm('¿Anular esta ficha técnica? Dejará de mostrarse como vigente en Cotización.', 'Confirmar anulación');
                if (!ok) return;
                const data = await postAccion('@Url.Action("Eliminar")', btn.dataset.id);
                if (data.ok) window.location.reload();
                else AppAlert('Error al anular: ' + data.error, 'Error', 'danger');
            });
        });

        document.querySelectorAll('.btn-restaurar').forEach(btn => {
            btn.addEventListener('click', async () => {
                const data = await postAccion('@Url.Action("Restaurar")', btn.dataset.id);
                if (data.ok) window.location.reload();
                else AppAlert('Error al restaurar: ' + data.error, 'Error', 'danger');
            });
        });
    </script>
}
