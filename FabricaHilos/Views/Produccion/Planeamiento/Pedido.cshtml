@model FabricaHilos.Models.Produccion.Planeamiento.PlnPedidoViewModel
@using FabricaHilos.Models.Produccion.Planeamiento

@{
    ViewData["Title"] = $"Pedido {Model.Serie}-{Model.NumPed}";
    var primerItem = Model.Items.FirstOrDefault();
    var pasoMap    = Model.Pasos.ToDictionary(p => p.CodPaso);
    var detCodArt  = Model.Items
        .DistinctBy(x => x.Nro)
        .ToDictionary(x => x.Nro, x => x.CodArt);

    // ── Timeline ApexCharts: estimado vs. real (primer sublote) ──────────
    var tlEstData  = new System.Collections.Generic.List<object>();
    var tlRealData = new System.Collections.Generic.List<object>();
    Func<DateTime, string> tlFmt = d => d.Date.ToString("yyyy-MM-dd");

    // ── Máquinas TT ─────────────────────────────────────────────────────────────────
    var maqStepsTT = new HashSet<string> { "06", "07", "08", "09", "09B", "9R" };
    // Devuelve nombre completo p.ej. "Rodete Nº5 · THIES" o "Madejas Nº3 · HANK"
    Func<string?, string> maqNombre = cod => {
        if (string.IsNullOrEmpty(cod)) return "";
        int ii = 0;
        while (ii < cod.Length && char.IsLetter(cod[ii])) ii++;
        var pref = cod[..ii].ToUpper();
        var numS = cod[ii..];
        var tipo  = pref switch { "R" => "Rodete", "M" => "Madejas", "MR" => "Mad.Rodete", _ => pref };
        var marca = pref switch { "R" => "THIES",  "M" => "HANK",    _ => "" };
        if (string.IsNullOrEmpty(numS)) return tipo + (marca != "" ? $" · {marca}" : "");
        var num = int.TryParse(numS, out var nn) ? nn.ToString() : numS;
        return marca != "" ? $"{tipo} Nº{num} · {marca}" : $"{tipo} Nº{num}";
    };

    if (primerItem != null)
    {
        var s = primerItem;
        // Estimados
        if (s.FchEstHilanderia.HasValue && s.FchEstPartida.HasValue)
            tlEstData.Add(new { x = "Hilandería", y = new[] { tlFmt(s.FchEstHilanderia.Value), tlFmt(s.FchEstPartida.Value) }, fillColor = "#0891b266" });
        if (s.FchEstTinIni.HasValue && s.FchEstTinFin.HasValue)
            tlEstData.Add(new { x = "Tintorería", y = new[] { tlFmt(s.FchEstTinIni.Value), tlFmt(s.FchEstTinFin.Value) }, fillColor = "#7e22ce66" });
        if (s.FchEstTinFin.HasValue && s.FchEstSecado.HasValue)
            tlEstData.Add(new { x = "Secado/CC", y = new[] { tlFmt(s.FchEstTinFin.Value), tlFmt(s.FchEstSecado.Value) }, fillColor = "#05996966" });
        if (s.FchEstSecado.HasValue && s.FchEstCalidad.HasValue)
            tlEstData.Add(new { x = "Calidad", y = new[] { tlFmt(s.FchEstSecado.Value), tlFmt(s.FchEstCalidad.Value) }, fillColor = "#dc262666" });
        if (s.FchEstCalidad.HasValue && s.FchEstDespacho.HasValue)
            tlEstData.Add(new { x = "Despacho", y = new[] { tlFmt(s.FchEstCalidad.Value), tlFmt(s.FchEstDespacho.Value) }, fillColor = "#06543666" });
        // Reales
        if (s.FchRealProduccion.HasValue && s.FchRealPartida.HasValue)
            tlRealData.Add(new { x = "Hilandería", y = new[] { tlFmt(s.FchRealProduccion.Value), tlFmt(s.FchRealPartida.Value) }, fillColor = "#0891b2" });
        if (s.FchRealTinIni.HasValue && s.FchRealTinFin.HasValue)
            tlRealData.Add(new { x = "Tintorería", y = new[] { tlFmt(s.FchRealTinIni.Value), tlFmt(s.FchRealTinFin.Value) }, fillColor = "#7e22ce" });
        if (s.FchRealTinFin.HasValue && s.FchRealSecado.HasValue)
            tlRealData.Add(new { x = "Secado/CC", y = new[] { tlFmt(s.FchRealTinFin.Value), tlFmt(s.FchRealSecado.Value) }, fillColor = "#059669" });
        if (s.FchRealSecado.HasValue && (s.FchRealCcTinto.HasValue || s.FchRealCalidad.HasValue))
        {
            var ccEnd = s.FchRealCcTinto ?? s.FchRealCalidad;
            tlRealData.Add(new { x = "Calidad", y = new[] { tlFmt(s.FchRealSecado.Value), tlFmt(ccEnd!.Value) }, fillColor = "#dc2626" });
        }
        if (s.FchRealAlmPt.HasValue && s.FchRealDespacho.HasValue)
            tlRealData.Add(new { x = "Despacho", y = new[] { tlFmt(s.FchRealAlmPt.Value), tlFmt(s.FchRealDespacho.Value) }, fillColor = "#065f46" });
    }

    var tlSeriesJson  = System.Text.Json.JsonSerializer.Serialize(new object[] {
        new { name = "Estimado", data = (object)tlEstData },
        new { name = "Real",     data = (object)tlRealData }
    });
    var showTimeline  = tlEstData.Count > 0 || tlRealData.Count > 0;
    var tlSubtitle    = primerItem != null
        ? $"Det.{primerItem.NumDet} — {primerItem.CodArt} {primerItem.Color} {primerItem.Titulo}"
        : "";
}

@section Styles {
<link rel="stylesheet" href="~/css/planeamiento.css" asp-append-version="true" />
<style>
    /* ─── Strip info-pedido: ver planeamiento.css §5 ────── */

    /* ─── Cards de sublotes ─────────────────────────────────── */
    .sublote-card { background: #fff; border: 2px solid #e2e8f0; margin-bottom: .5rem; border-left: 4px solid #cbd5e0; transition: border-left-color .15s, box-shadow .15s; }
    .sublote-card:hover { border-left-color: #4a5568; box-shadow: 0 2px 8px rgba(0,0,0,.08); }
    .sublote-card.urgente { border-left-color: #e53e3e; }
    .sublote-card.retraso { border-left-color: #fd7e14; }
    .sublote-head { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; padding: .45rem .9rem; background: linear-gradient(to right, #f7fafc 0%, #fff 100%); border-bottom: 1px solid #e2e8f0; }
    .sublote-art { font-size: .82rem; font-weight: 700; color: #2d3748; }
    .sublote-meta { font-size: .78rem; color: #4a5568; }
    .kg-pend { color: #e53e3e; font-weight: 700; }
    .sublote-body { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; padding: .5rem .9rem; }
    .sublote-avance { display: flex; align-items: center; gap: .5rem; min-width: 130px; }
    .avance-pct { font-size: .7rem; font-weight: 600; }
    .sublote-fecha { display: flex; flex-direction: column; line-height: 1.2; }
    .sublote-fecha .slbl { font-size: .62rem; text-transform: uppercase; letter-spacing: .06em; color: #718096; font-weight: 700; }
    .sublote-fecha .sval { font-size: .82rem; font-weight: 700; color: #2d3748; }
    /* ─── Panel flujo por sublote ────────────────────────────── */
    .sublote-panel { border-top: 2px solid #e2e8f0; background: #f0f4f8; }
    .sublote-panel-toggle { display: flex; align-items: center; gap: .4rem; padding: .32rem .9rem; font-size: .71rem; font-weight: 700; color: #4a5568; cursor: pointer; user-select: none; background: none; border: none; width: 100%; text-align: left; letter-spacing: .02em; }
    .sublote-panel-toggle:hover { background: #e2e8f0; color: #2d3748; }
    .sublote-panel-toggle[aria-expanded="true"] { background: #e2e8f0; color: #2d3748; }
    .sublote-panel-toggle .toggle-ico { transition: transform .2s; font-size: .65rem; margin-left: auto; }
    .sublote-panel-toggle[aria-expanded="true"] .toggle-ico { transform: rotate(180deg); }
    .sublote-panel-body { padding: .6rem .75rem .7rem; background: #fff; border-top: 1px solid #e2e8f0; }
    /* mini-tabs por sublote */
    .sub-tabs { border-bottom: 2px solid #8ea8c3; margin-bottom: 0; display: flex; gap: 2px; background: #cfdce9; padding: .3rem .5rem 0; }
    .sub-tabs .nav-link { border-radius: 4px 4px 0 0; font-size: .73rem; font-weight: 600; color: #4a5568; border: 1px solid transparent; border-bottom: none; padding: .28rem .75rem; }
    .sub-tabs .nav-link:hover { background: #dce9f5; color: #2d3748; }
    .sub-tabs .nav-link.active { color: #1a365d; background: #eef4fc; border-color: #8ea8c3; border-bottom-color: #eef4fc; border-top: 2px solid #3b6ea5; font-weight: 800; }
    .sub-tab-panel { border: 1px solid #8ea8c3; border-top: none; background: #eef4fc; min-height: 60px; }

    /* ─── Tabs industriales ─────────────────────────────────── */
    .pln-tabs { border-bottom: 2px solid #8ea8c3; margin-bottom: 0; }
    .pln-tabs .nav-link { border-radius: 4px 4px 0 0; font-size: .8rem; font-weight: 600; color: #4a5568; border: 2px solid transparent; border-bottom: none; padding: .5rem 1rem; margin-right: 2px; }
    .pln-tabs .nav-link:hover { background: #dce9f5; color: #2d3748; }
    .pln-tabs .nav-link.active { color: #1a365d; background: #eef4fc; border-color: #8ea8c3; border-bottom-color: #eef4fc; border-top: 2px solid #3b6ea5; font-weight: 800; }
    .pln-tab-panel { border: 2px solid #8ea8c3; border-top: none; background: #eef4fc; }

    /* ─── Timeline compacto en cuadrícula 2 columnas ──────── */
    .tl-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
    @@media (max-width: 768px) { .tl-grid { grid-template-columns: 1fr; } }
    .tl-step { display: flex; align-items: flex-start; gap: .55rem; padding: .38rem .75rem; border-bottom: 1px solid #f0f2f5; transition: background .12s; }
    .tl-step:hover { background: #f7fafc; }
    .tl-step.pendiente { opacity: .5; }
    .tl-dot { width: 9px; height: 9px; border-radius: 1px; flex-shrink: 0; margin-top: .38rem; border: 1px solid rgba(0,0,0,.15); }
    .tl-cod { flex-shrink: 0; }
    .tl-nombre { font-size: .8rem; flex: 1; line-height: 1.3; }
    .tl-nombre.completado { color: #2f855a; }
    .tl-nombre.activo { color: #2d3748; font-weight: 700; }
    .tl-nombre.pendiente { color: #a0aec0; }
    .tl-fechas { font-size: .65rem; color: #718096; display: flex; flex-direction: column; gap: .08rem; flex-shrink: 0; text-align: right; }
    .tl-fech-real { color: #2f855a; font-weight: 700; }

    /* ─── Panel de máquina TT (en pasos de Tintorería) ──────────────── */
    .maq-box { margin-top:.4rem; padding:.45rem .7rem; background:#f7fafc;
        border:1px solid #e2e8f0; border-left:4px solid #cbd5e0; border-radius:0 3px 3px 0;
        display:flex; flex-direction:column; gap:.3rem; width:100%; box-sizing:border-box; }
    .maq-box.maq-real    { border-left-color:#059669; background:#f0fdf4; }
    .maq-box.maq-prog    { border-left-color:#0891b2; background:#f0f9ff; }
    .maq-box.maq-cerrado { border-left-color:#9ca3af; background:#f9fafb; }
    .maq-box.maq-real-tt { border-left-color:#e65c00; background:#fff7ed; }
    /* fila 1: encabezado contextual */
    .maq-header-row { display:flex; align-items:center; gap:.4rem; }
    .maq-header-lbl { font-size:.63rem; font-weight:700; text-transform:uppercase;
        letter-spacing:.04em; color:#6b7280; flex:1; }
    .maq-src-badge { font-size:.6rem; font-weight:700; border-radius:2px; padding:.06rem .38rem; flex-shrink:0; }
    .maq-src-badge.maq-src-real    { background:#d1fae5; color:#065f46; border:1px solid #6ee7b7; }
    .maq-src-badge.maq-src-prog    { background:#e0f2fe; color:#0c4a6e; border:1px solid #7dd3fc; }
    .maq-src-badge.maq-src-done    { background:#f3f4f6; color:#374151; border:1px solid #9ca3af; }
    .maq-src-badge.maq-src-conflicto { background:#fef3c7; color:#92400e; border:1px solid #fcd34d; }
    .maq-src-badge.maq-src-real-tt   { background:#fff0e6; color:#9a3412; border:1px solid #fb923c; }
    /* fila 2: código + nombre de la máquina */
    .maq-id-row { display:flex; align-items:baseline; gap:.5rem; }
    .maq-box .maq-cod    { font-weight:800; font-size:.88rem; color:#111827; }
    .maq-box .maq-nombre { font-size:.76rem; color:#374151; }
    /* separador visual (solo lotes cerrados) */
    .maq-sep-label { font-size:.61rem; color:#9ca3af; font-style:italic;
        border-top:1px dashed #e5e7eb; padding-top:.25rem; margin-top:.02rem;
        display:flex; align-items:center; gap:.3rem; }
    /* fila 3: estado en tiempo real + barra de carga (inline) */
    .maq-status-row { display:flex; align-items:center; gap:.45rem; flex-wrap:wrap; }
    .maq-box .maq-live { font-size:.7rem; display:inline-flex; align-items:center;
        gap:.28rem; padding:.1rem .38rem; border-radius:3px; background:rgba(0,0,0,.04); flex-shrink:0; }
    .maq-box .dot-live  { width:8px; height:8px; border-radius:50%; background:#d1d5db; flex-shrink:0; }
    .maq-box .maq-live.libre   .dot-live { background:#059669; }
    .maq-box .maq-live.ocupada .dot-live { background:#d97706; }
    .maq-box .live-txt { color:#6b7280; }
    .maq-box .maq-live.libre   .live-txt { color:#059669; font-weight:700; }
    .maq-box .maq-live.ocupada .live-txt { color:#92400e; font-weight:600; }
    .maq-proc-row  { display:flex; align-items:center; gap:.25rem; margin:.2rem 0 .05rem; }
    .maq-proc-date { font-size:.65rem; color:#059669; font-weight:600; }
    /* Pill de progreso de baños */
    .maq-banos-row  { display:flex; align-items:center; gap:.3rem; font-size:.62rem; color:#6b7280;
                      margin:.2rem 0 .15rem; padding:.15rem .4rem; background:#f1f5f9;
                      border-radius:3px; border-left:2px solid #cbd5e0; }
    .maq-banos-row.maq-banos-completo { color:#059669; border-color:#6ee7b7; background:#f0fdf4; }
    .maq-banos-row.maq-banos-parcial  { color:#92400e; border-color:#fbbf24; background:#fffbeb; }
    .maq-banos-row.maq-banos-pendiente{ color:#6b7280; border-color:#d1d5db; }
    .maq-carga-lbl  { font-size:.62rem; color:#9ca3af; white-space:nowrap; flex-shrink:0; }
    .maq-carga-bar  { flex:1; min-width:40px; background:#e5e7eb; border-radius:2px; height:5px; }
    .maq-carga-fill { height:5px; border-radius:2px; background:#3b82f6; width:0%; transition:width .5s ease; }
    .maq-carga-fill.alta        { background:#f59e0b; }
    .maq-carga-fill.sobrecargada{ background:#ef4444; }
    .maq-carga-pct  { font-size:.62rem; color:#6b7280; white-space:nowrap; min-width:48px; text-align:right; }

    /* ─── Detalle de producción — secciones ─────────────────── */
    .tt-section-title { font-size:.73rem; font-weight:800; text-transform:uppercase;
        letter-spacing:.05em; color:var(--pln-gray-700); border-bottom:2px solid var(--pln-gray-300);
        padding-bottom:.2rem; margin-bottom:.5rem; display:flex; align-items:center; gap:.35rem; }
    .tt-lbl  { font-size:.65rem; font-weight:700; text-transform:uppercase;
        letter-spacing:.04em; color:var(--pln-gray-500); display:block; line-height:1.2; }
    .tt-val  { font-size:.8rem; color:var(--pln-dark-deep); display:block; line-height:1.3; }
    .tt-mono { font-family: 'Courier New', monospace; font-size:.77rem; }
    .maq-cod-inline { font-weight:800; font-size:.82rem; color:var(--pln-gray-700);
        background:var(--pln-gray-100); border:1px solid var(--pln-gray-300); border-radius:2px;
        padding:.05rem .35rem; letter-spacing:.02em; }
    .tt-table { font-size:.78rem; }
    .tt-table thead th { font-size:.65rem; font-weight:700; text-transform:uppercase;
        letter-spacing:.04em; color:var(--pln-gray-600); background:var(--pln-gray-50);
        border-bottom:2px solid var(--pln-gray-200); padding:.35rem .6rem; }
    .tt-table td { vertical-align:middle; padding:.3rem .6rem; }
    .tt-table tbody tr:hover { background:var(--pln-gray-100); }

    /* ─── Acordeón Detalle de producción ──────────────────────── */
    .tt-acc-item { border: none; border-bottom: 1px solid var(--pln-gray-200); }
    .tt-acc-item:last-child { border-bottom: none; }
    .tt-acc-btn { font-size: .73rem; font-weight: 800; text-transform: uppercase;
        letter-spacing: .05em; color: var(--pln-light-text);
        background: linear-gradient(135deg, var(--pln-dark-bg) 0%, var(--pln-gray-700) 100%);
        padding: .4rem .75rem; border-radius: 0; border-bottom: 2px solid var(--pln-dark-deep); }
    .tt-acc-btn:not(.collapsed) { color: var(--pln-light-text);
        background: linear-gradient(135deg, var(--pln-dark-deep) 0%, var(--pln-dark-bg) 100%);
        box-shadow: none; }
    .tt-acc-btn:focus { box-shadow: none; outline: none; }
    .tt-acc-btn::after { filter: brightness(0) invert(1); }
    .tt-acc-btn .bi { color: var(--pln-accent-blue); }
    .accordion-flush .tt-acc-item .accordion-body { padding: .5rem .75rem; }
</style>
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Produccion" asp-action="Index">Producción</a></li>
    <li class="breadcrumb-item"><a asp-controller="Planeamiento" asp-action="Index">Planeamiento</a></li>
    <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
    <li class="breadcrumb-item active">Pedido @Model.Serie-@Model.NumPed</li>
}

@* ── Modales de acción POST (fuera de cualquier grid) ──────── *@

@* Modal: Reprogramar despacho *@
<div class="modal fade" id="modalReprogramar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Reprogramar" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="serie"  value="@Model.Serie" />
                <input type="hidden" name="numPed" value="@Model.NumPed" />
                <div class="modal-header py-2">
                    <h6 class="modal-title"><i class="bi bi-calendar-event me-2 text-warning"></i>Reprogramar fecha de despacho</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Sublote (Det.)</label>
                        <select name="nro" class="form-select form-select-sm" required>
                            @foreach (var s in Model.Items.OrderBy(x => x.NumDet))
                            {
                                <option value="@s.Nro" data-det="@s.NumDet">Det.@s.NumDet — @s.Titulo (@s.Color)</option>
                            }
                        </select>
                    </div>
                    <input type="hidden" name="numDet" id="reprNumDet" value="@(Model.Items.FirstOrDefault()?.NumDet ?? 0)" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Nueva fecha de despacho</label>
                        <input type="date" name="nuevaFchDesp" class="form-control form-control-sm" required
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Motivo</label>
                        <input type="text" name="motivo" class="form-control form-control-sm" maxlength="200"
                               placeholder="Ej: Cliente solicitó extensión de plazo" required />
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning btn-sm"><i class="bi bi-save me-1"></i>Reprogramar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Modal: Recalcular fechas *@
<div class="modal fade" id="modalRecalcular" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <form asp-action="RecalcularFechas" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="serie"  value="@Model.Serie" />
                <input type="hidden" name="numPed" value="@Model.NumPed" />
                <input type="hidden" name="nro"    value="@(Model.Items.FirstOrDefault()?.Nro ?? 0)" />
                <input type="hidden" name="numDet" value="@(Model.Items.FirstOrDefault()?.NumDet ?? 0)" />
                <div class="modal-header py-2">
                    <h6 class="modal-title"><i class="bi bi-calculator me-2 text-info"></i>Recalcular fechas estimadas</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Motivo del recálculo</label>
                        <select name="motivo" class="form-select form-select-sm">
                            <option value="REP">REP — Reprogramado</option>
                            <option value="PED">PED — Pedido</option>
                            <option value="PLA">PLA — Planificado</option>
                            <option value="MAQ">MAQ — Cambio máquina</option>
                        </select>
                    </div>
                    <div class="alert alert-info small py-1 mb-0">
                        Recalcula todas las fechas estimadas del primer sublote y guarda historial.
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-info btn-sm text-white"><i class="bi bi-arrow-repeat me-1"></i>Recalcular</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Modal: Cerrar ítem *@
<div class="modal fade" id="modalCerrar" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content border-danger">
            <form asp-action="CerrarItem" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="numPed" value="@Model.NumPed" />
                <input type="hidden" name="serie"  value="@Model.Serie" />
                <div class="modal-header bg-danger text-white py-2">
                    <h6 class="modal-title"><i class="bi bi-x-circle me-2"></i>Cerrar ítem manualmente</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
