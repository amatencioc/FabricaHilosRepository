            <div class="tab-pane fade" id="panel-legacy" role="tabpanel">
                @if (legacy.Count == 0)
                {
                    <div class="sire-alert sire-alert-info m-3">
                        <i class="bi bi-info-circle"></i>
                        <span>No hay registros Legacy para <strong>@yyyyMm</strong>. Use <strong>Conciliar</strong> para cargar datos del ERP Logix.</span>
                    </div>
                }
                else
                {
                    <div class="table-responsive" style="max-height:460px;overflow-y:auto;">
                        <table class="table sire-table table-hover align-middle mb-0" id="tablaLegacyDetalle">
                            <thead style="position:sticky;top:0;z-index:1;">
                                <tr>
                                    <th style="width:48px">Tipo</th>
                                    <th style="width:62px">Serie</th>
                                    <th style="width:100px">Numero</th>
                                    <th style="width:82px;cursor:pointer;user-select:none;" data-sort-type="date" onclick="sireOrdenarColumna(this)" title="Ordenar por Emisión">Emision <span class="sire-sort-icon" style="font-size:.7rem;opacity:.5;">↕</span></th>
                                    <th style="width:96px">RUC</th>
                                    <th style="cursor:pointer;user-select:none;" data-sort-type="text" onclick="sireOrdenarColumna(this)" title="Ordenar por Proveedor">Proveedor <span class="sire-sort-icon" style="font-size:.7rem;opacity:.5;">↕</span></th>
                                    <th class="text-end" style="width:88px">Base</th>
                                    <th class="text-end" style="width:76px">IGV</th>
                                    <th class="text-end" style="width:88px">Total</th>
                                    <th style="width:46px" class="text-center">Mon.</th>
                                    <th class="d-none d-lg-table-cell" style="width:90px">Tabla</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in legacy)
                                {
                                    var tc = TipoComprobante(r.Tipdoc ?? "");
                                    <tr>
                                        <td><span class="@tc.Css" style="font-size:.68rem;">@tc.Desc</span></td>
                                        <td class="font-monospace">@(r.Serie ?? "-")</td>
                                        <td class="font-monospace">@(r.Numero ?? "-")</td>
                                        <td class="text-muted text-nowrap">@(r.FEmision?.ToString("dd/MM/yyyy") ?? "-")</td>
                                        <td class="font-monospace">@(r.Ruc ?? "-")</td>
                                        <td style="max-width:190px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="@r.Nombre">@(r.Nombre ?? "-")</td>
                                        <td class="text-end">@r.BaseImponible.ToString("N2")</td>
                                        <td class="text-end">@r.Igv.ToString("N2")</td>
                                        <td class="text-end fw-semibold" style="color:#0891b2;">@r.Total.ToString("N2")</td>
                                        <td class="text-center">
                                            @if (!string.IsNullOrEmpty(r.Moneda) && r.Moneda != "PEN")
                                            {
                                                <span class="sire-badge sire-badge-warn" style="font-size:.62rem;" title="TC: @r.Cambio.ToString("N4")">@r.Moneda</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted" style="font-size:.72rem;">S/</span>
                                            }
                                        </td>
                                        <td class="text-muted d-none d-lg-table-cell" style="font-size:.72rem;">@(r.TablaOrigen ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="6" class="text-end fw-semibold" style="font-size:.75rem;color:var(--sire-gray-600);">TOTALES</td>
                                    <td class="text-end fw-bold">@legacy.Sum(x => x.BaseImponible).ToString("N2")</td>
                                    <td class="text-end fw-bold">@legacy.Sum(x => x.Igv).ToString("N2")</td>
                                    <td class="text-end fw-bold" style="color:#0891b2;">@legacy.Sum(x => x.Total).ToString("N2")</td>
                                    <td></td>
                                    <td class="d-none d-lg-table-cell"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>

            @* ── Panel: SSCO ───────────────────────────────────────────────── *@
            <div class="tab-pane fade" id="panel-ssco" role="tabpanel">
                @{
                    var sscoLista = Model?.SscoLista ?? new List<FabricaHilos.Models.Sire.SscoListaEntry>();
                    // RUCs de Legacy del período actual (para detectar coincidencias con el padrón SSCO)
                    var rucsEnLegacy = new HashSet<string>(
                        legacy.Select(r => r.Ruc ?? "").Where(r => r.Length > 0),
                        StringComparer.OrdinalIgnoreCase);
                    // Sujetos SSCO que tienen comprobantes en Legacy primero, luego fecha de publicación desc
                    var sscoListaOrdenada = sscoLista
                        .OrderByDescending(s => rucsEnLegacy.Contains(s.Ruc) ? 1 : 0)
                        .ThenByDescending(s => s.FchPublicacion)
                        .ToList();
                }
                @if (rucsEnSsco.Count == 0)
                {
                    <div class="m-3">
                        <div class="sire-alert sire-alert-info">
                            <i class="bi bi-shield-slash"></i>
                            <span>Padrón SSCO no cargado. Use el botón <strong>SSCO</strong> de la barra para cargar el archivo <em>sujesincapacidadOperativa.xlsx</em> de SUNAT.</span>
                        </div>
                    </div>
                }
                else
                {
                    @* Contenedor vacío — el JS rellena sscoBanner solo tras ejecutar el botón SSCO *@
                    <div id="sscoBanner"></div>
                    @* Tabla del padrón completo (columnas del Excel SUNAT) *@
                    <div class="table-responsive mt-2" style="max-height:460px;overflow-y:auto;">
                        <table class="table sire-table table-hover align-middle mb-0" id="tablaSscoDetalle">
                            <thead style="position:sticky;top:0;z-index:1;">
                                <tr>
                                    <th style="width:110px;">RUC</th>
                                    <th>Razón Social</th>
                                    <th style="width:160px;">Resolución</th>
                                    <th style="width:88px;" class="text-center">Fch. Resol.</th>
                                    <th style="width:88px;" class="text-center">Quedó Firme</th>
                                    <th style="width:88px;" class="text-center">Publicación ↓</th>
                                    <th style="width:110px;">Doc. Rep. Legal</th>
                                    <th>Nom. Rep. Legal</th>
                                    <th style="width:80px;" class="text-center">En Legacy</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in sscoListaOrdenada)
                                {
                                    bool enLegacy   = rucsEnLegacy.Contains(s.Ruc);
                                    bool excluido   = rucsExclSsco.Contains(s.Ruc ?? "");
                                    <tr style="@(enLegacy ? "background:rgba(220,38,38,.09);border-left:3px solid #dc2626;" : "")">
                                        <td class="font-monospace @(enLegacy ? "fw-bold" : "")" style="@(enLegacy ? "color:#b91c1c;" : "")">@s.Ruc</td>
                                        <td style="max-width:220px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="@s.RazonSocial">@(s.RazonSocial ?? "-")</td>
                                        <td class="text-muted" style="font-size:.75rem;max-width:160px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="@s.ResolucionAtrib">@(s.ResolucionAtrib ?? "-")</td>
                                        <td class="text-center text-muted" style="font-size:.75rem;">@(s.FchResolucion?.ToString("dd/MM/yyyy") ?? "-")</td>
                                        <td class="text-center fw-semibold" style="font-size:.75rem;color:@(enLegacy ? "#b91c1c" : "inherit");">@s.FchQuedoFirme.ToString("dd/MM/yyyy")</td>
                                        <td class="text-center text-muted" style="font-size:.75rem;">@(s.FchPublicacion?.ToString("dd/MM/yyyy") ?? "-")</td>
                                        <td class="font-monospace" style="font-size:.75rem;">@(s.DocRepLegal ?? "-")</td>
                                        <td style="max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:.75rem;" title="@s.NomRepLegal">@(s.NomRepLegal ?? "-")</td>
                                        <td class="text-center">
                                            @if (enLegacy)
                                            {
                                                <span class="badge" style="background:#dc2626;font-size:.6rem;" title="Tiene comprobantes en Legacy este período"><i class="bi bi-exclamation-triangle-fill me-1"></i>SÍ</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted" style="font-size:.7rem;">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="9" class="text-muted" style="font-size:.72rem;">
                                        Total: <strong>@sscoLista.Count.ToString("N0")</strong> sujetos en padrón SSCO
                                        @if (sscoHits > 0){ <span class="ms-3 text-danger fw-semibold">&#9888; @sscoHits con comprobantes en Legacy</span> }
                                        @if (rucsExclSsco.Count > 0){ <span class="ms-3 fw-semibold" style="color:#16a34a;">&#x2713; @rucsExclSsco.Count RUC(s) excluido(s)</span> }
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>

            <div class="tab-pane fade" id="panel-concil" role="tabpanel">
                @if (concil.Count == 0)
                {
                    <div class="sire-alert sire-alert-info m-3">
                        <i class="bi bi-info-circle"></i>
                        <span>No hay datos cruzados para <strong>@yyyyMm</strong>. Use <strong>Conciliar</strong> para generar el cruce SUNAT vs ERP.</span>
                    </div>
                }
                else
                {
                    <div class="table-responsive" style="max-height:460px;overflow-y:auto;">
                        <table class="table sire-table table-hover align-middle mb-0" id="tablaConcilDetalle">
                            <thead style="position:sticky;top:0;z-index:1;">
                                <tr>
                                    <th id="th-check-concil" style="width:32px;display:none;">
                                        <input type="checkbox" id="chkTodosExcl" class="form-check-input" onclick="seleccionarTodosExcl(this)">
                                    </th>
                                    <th style="width:48px">Tipo</th>
                                    <th style="width:62px">Serie</th>
                                    <th style="width:100px">Numero</th>
                                    <th style="width:82px">Emisión</th>
                                    <th style="width:96px">RUC</th>
                                    <th>Proveedor</th>
                                    <th class="text-end" style="width:88px" title="Base imponible gravada según SUNAT">Base SUNAT</th>
                                    <th class="text-end" style="width:88px" title="Base imponible gravada según ERP Logix">Base ERP</th>
                                    <th class="text-end" style="width:82px" title="Diferencia: Base SUNAT menos Base ERP">Δ Base</th>
                                    <th class="text-end" style="width:88px" title="Total del comprobante de pago según SUNAT">Total SUNAT</th>
                                    <th class="text-end" style="width:88px" title="Total del comprobante de pago según ERP Logix">Total ERP</th>
                                    <th class="text-end" style="width:82px" title="Diferencia: Total SUNAT menos Total ERP">Δ Total</th>
                                    <th style="width:46px" class="text-center">Mon.</th>
                                    <th style="width:80px" class="text-center">Estado</th>
                                    <th style="width:130px" class="text-center" id="th-validez-sunat" title="Validación SUNAT: estado CP, RUC y domicilio fiscal">Validez SUNAT</th>
                                    <th title="Campos con diferencia entre SUNAT y ERP. Hover para ver los valores.">Diferencias detalladas</th>
                                    <th style="width:100px;" class="text-center" title="Proveedor en el padrón SSCO de SUNAT">SSCO</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    // Paleta de 8 pasteles muy suaves para grupos factura+N/C
                                    var pasteles = new[] {
                                        "rgba(173,216,230,.18)", // azul
                                        "rgba(144,238,144,.18)", // verde
                                        "rgba(255,218,185,.22)", // melocotón
                                        "rgba(221,160,221,.18)", // violeta
                                        "rgba(255,250,160,.22)", // amarillo
                                        "rgba(175,238,238,.20)", // turquesa
                                        "rgba(255,182,193,.20)", // rosa
                                        "rgba(216,191,216,.18)", // lavanda
                                    };

                                    // Construir orden: factura seguida de sus N/C vinculadas
                                    var esNotaC = (string? td) => td is "07" or "08";
                                    var facturas = concil
                                        .Where(x => !esNotaC(x.Tipdoc))
                                        .OrderBy(x => x.FEmision)
                                        .ThenBy(x => x.Serie)
                                        .ThenBy(x => x.Numero)
                                        .ToList();
                                    var notas = concil
                                        .Where(x => esNotaC(x.Tipdoc))
                                        .ToList();

                                    var concilOrdenadoRows  = new System.Collections.Generic.List<FabricaHilos.Models.Sire.SireConcilDetalle>();
                                    var concilOrdenadoGrups = new System.Collections.Generic.List<int>();
                                    int gi = 0;
                                    var notasYaUsadas = new HashSet<long>();

                                    foreach (var fac in facturas)
                                    {
                                        concilOrdenadoRows.Add(fac); concilOrdenadoGrups.Add(gi);
                                        var hijas = notas
                                            .Where(n => !notasYaUsadas.Contains(n.IdConcil)
                                                && string.Equals(n.SerDocref, fac.Serie, StringComparison.OrdinalIgnoreCase)
                                                && string.Equals(n.NroDocref, fac.Numero, StringComparison.OrdinalIgnoreCase))
                                            .OrderBy(n => n.FEmision)
                                            .ToList();
                                        foreach (var h in hijas)
                                        {
                                            concilOrdenadoRows.Add(h); concilOrdenadoGrups.Add(gi);
                                            notasYaUsadas.Add(h.IdConcil);
                                        }
                                        if (hijas.Count > 0) gi++;
                                    }
                                    foreach (var n in notas.Where(n => !notasYaUsadas.Contains(n.IdConcil)))
                                    { concilOrdenadoRows.Add(n); concilOrdenadoGrups.Add(-1); }

                                    var colorMap = new Dictionary<int, string>();
                                    int ci = 0;
                                    var conteosPorGrupo = concilOrdenadoRows
                                        .Select((row, idx) => new { row, grp = concilOrdenadoGrups[idx] })
                                        .Where(x => x.grp >= 0)
                                        .GroupBy(x => x.grp)
                                        .ToDictionary(g => g.Key, g => g.Count());
                                    foreach (var kvp in conteosPorGrupo)
                                    {
                                        if (kvp.Value > 1)
                                            colorMap[kvp.Key] = pasteles[ci++ % pasteles.Length];
                                    }

                                    var labelMap = new Dictionary<string,string>
                                    {
                                        ["BIGRAVDG"]   = "Base Gravada DG",
                                        ["IGVIPMDG"]   = "IGV",
                                        ["TOTAL_CP"]   = "Total CP",
                                        ["VALADQNG"]   = "Val. Adq. NG",
                                        ["ISC"]        = "ISC",
                                        ["OTROSTRIB"]  = "Otros Trib.",
                                        ["MONEDA"]     = "Moneda",
                                        ["EST.COMP"]   = "Estado CP",
                                        ["T.CAMBIO"]   = "T. Cambio",
                                        ["F.EMISION"]  = "F. Emisión",
                                        ["T.REF"]      = "Tipo Ref.",
                                        ["S.REF"]      = "Serie Ref.",
                                        ["N.REF"]      = "Nro Ref.",
                                        ["F.REF"]      = "F. Ref.",
                                        ["DETRAC"]     = "Detrac.",
                                        ["ANIO.DAM"]   = "Año DAM",
                                        ["TIPO.NOTA"]  = "Tipo Nota",
                                        ["TOTAL.GRAT"] = "Total Grat.",
                                    };

                                    for (int _ci = 0; _ci < concilOrdenadoRows.Count; _ci++)
                                    {
                                        var r        = concilOrdenadoRows[_ci];
                                        var grupoIdx = concilOrdenadoGrups[_ci];
                                        var tc       = TipoComprobante(r.Tipdoc ?? "");
                                        var rowClass = r.Estado == "EXCLUIDO" ? "sire-row-excluido"
                                                     : (r.Estado != "EXCLUIDO" && r.ValidezCp == "0") ? "sire-row-cp-noexiste"
                                                     : "";
                                        string rowBg = (r.Estado == "EXCLUIDO" && grupoIdx >= 0 && colorMap.TryGetValue(grupoIdx, out var pbg))
                                            ? $"background:{pbg}!important;"
                                            : "";
                                        var _tieneRef = r.Estado == "SOLO_SUNAT"
                                            && (r.Tipdoc is "07" or "08")
                                            && (!string.IsNullOrWhiteSpace(r.SerDocref) || !string.IsNullOrWhiteSpace(r.NroDocref));
                                        var _tieneCpeError = r.ValidezCp != null
                                            && (   (r.ValidezCp is not "1" and not "3")
                                                || (r.ValidezRuc != null && r.ValidezRuc != "00")
                                                || (r.ValidezDom != null && r.ValidezDom != "00") );
                                        // AVISO = fila OK con diferencias solo informativas (DiffCampos no vacío pero sin IGVIPMDG ni TOTAL_CP)
                                        var _tieneAviso = r.Estado == "OK"
                                            && !string.IsNullOrWhiteSpace(r.DiffCampos);
                                        <tr data-concil='@r.Estado' data-diff-info='@(_tieneAviso ? "1" : "")' data-validez-cp='@(r.ValidezCp ?? "")' data-cpe-error='@(_tieneCpeError ? "1" : "")' class="@rowClass" style="@rowBg">
                                            <td class="td-check-excl" style="display:none;">
                                                @if (r.Estado == "SOLO_SUNAT")
                                                {
                                                    <input type="checkbox" class="form-check-input sire-excl-check"
                                                           data-id-concil="@r.IdConcil" value="@r.IdConcil"
                                                           onchange="actualizarBadgeExcluir()">
                                                }
                                                @if (r.Estado == "EXCLUIDO")
                                                {
                                                    <div class="d-flex align-items-center gap-1">
                                                        <input type="checkbox" class="form-check-input sire-excl-check"
                                                               value="@r.IdConcil" onchange="actualizarBadgeExcluir()">
                                                        <button class="btn btn-xs btn-outline-warning p-0 px-1"
                                                                onclick="restaurarExcluido(@r.IdConcil)"
                                                                title="Restaurar a SOLO_SUNAT">
                                                            <i class="bi bi-arrow-counterclockwise"></i>
                                                        </button>
                                                    </div>
                                                }
                                            </td>
                                            <td><span class="@tc.Css" style="font-size:.68rem;">@tc.Desc</span></td>
                                            <td class="font-monospace">@(r.Serie ?? "-")</td>
                                            <td class="font-monospace">@(r.Numero ?? "-")</td>
                                            <td class="text-muted text-nowrap">@(r.FEmision?.ToString("dd/MM/yyyy") ?? "-")</td>
                                            <td class="font-monospace">@(r.Ruc ?? "-")</td>
                                            <td style="max-width:170px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="@r.Nombre">@(r.Nombre ?? "-")</td>
                                            <td class="text-end">@(r.SunatBase != 0 ? r.SunatBase.ToString("N2") : "-")</td>
                                            <td class="text-end">@(r.LegBase != 0 ? r.LegBase.ToString("N2") : "-")</td>
                                            <td class="text-end fw-semibold @(r.DiffBase != 0 ? "text-danger" : "text-success")">@(r.DiffBase != 0 ? r.DiffBase.ToString("N2") : "0.00")</td>
                                            <td class="text-end">@(r.SunatTotal != 0 ? r.SunatTotal.ToString("N2") : "-")</td>
                                            <td class="text-end">@(r.LegTotal != 0 ? r.LegTotal.ToString("N2") : "-")</td>
                                            <td class="text-end fw-semibold @(r.DiffTotalCp != 0 ? "text-danger" : "text-success")">@(r.DiffTotalCp != 0 ? r.DiffTotalCp.ToString("N2") : "0.00")</td>
                                            <td class="text-center">
                                                @{
                                                    var monConcil = r.SunatMoneda ?? r.LegMoneda;
                                                }
                                                @if (!string.IsNullOrEmpty(monConcil) && monConcil != "PEN")
                                                {
                                                    <span class="sire-badge sire-badge-warn" style="font-size:.62rem;" title="SUNAT:@(r.SunatCambio?.ToString("N4") ?? "-") / ERP:@(r.LegCambio?.ToString("N4") ?? "-")">@monConcil</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted" style="font-size:.72rem;">S/</span>
                                                }
                                            </td>
                                            <td class="text-center"><span class="@r.EstadoBadgeCss" style="font-size:.62rem;" title="@(r.DiffCampos ?? r.EstadoLabel)">@r.EstadoLabel</span></td>
                                            <td class="text-center td-validez-sunat" style="font-size:.6rem;" data-id="@r.IdConcil">
                                                @if (r.ValidezCp != null)
                                                {
                                                    <div class="d-flex flex-column align-items-center gap-1" title="Validado: @(r.FchValidez?.ToString("dd/MM/yyyy HH:mm") ?? "-")">
                                                        <span class="badge @r.ValidezCpBadge" style="font-size:.58rem;min-width:72px;">CP: @r.ValidezCpLabel</span>
                                                        <span class="badge @(r.ValidezRuc == "00" ? "bg-success" : "bg-warning text-dark")" style="font-size:.58rem;min-width:72px;">RUC: @r.ValidezRucLabel</span>
                                                        <span class="badge @(r.ValidezDom == "00" ? "bg-success" : "bg-warning text-dark")" style="font-size:.58rem;min-width:72px;">Dom: @r.ValidezDomLabel</span>
                                                    </div>
                                                    <button class="btn btn-revalidar-fila p-0 mt-1" data-id="@r.IdConcil"
                                                            title="Re-validar contra SUNAT" style="font-size:.6rem;line-height:1;background:none;border:none;color:#6c757d;">
                                                        <i class="bi bi-arrow-repeat"></i>
                                                    </button>
                                                }
                                                else if (r.Estado != "EXCLUIDO" && r.Estado != "SOLO_LEGACY")
                                                {
                                                    <button class="btn btn-revalidar-fila p-0" data-id="@r.IdConcil"
                                                            title="Validar este comprobante contra SUNAT" style="font-size:.6rem;line-height:1;background:none;border:none;color:#adb5bd;">
                                                        <i class="bi bi-patch-question"></i>
                                                    </button>
                                                }
                                            </td>
                                            <td>
                                                @if (r.Estado == "EXCLUIDO")
                                                {
                                                    var motivoLabel = r.ExclMotivo switch {
                                                        "NC_AUTO" => "N/C automática",
                                                        "MANUAL"  => "Exclusión manual",
                                                        _         => r.ExclMotivo ?? "Excluido"
                                                    };
                                                    var motivoIcon   = r.ExclMotivo == "NC_AUTO" ? "bi bi-scissors text-warning" : "bi bi-hand-index-thumb text-secondary";
                                                    var motivoBg     = r.ExclMotivo == "NC_AUTO" ? "rgba(255,193,7,.12)" : "rgba(108,117,125,.10)";
                                                    var motivoBorder = r.ExclMotivo == "NC_AUTO" ? "#ffc107" : "#6c757d";
                                                    <div style="border-left:3px solid @motivoBorder;background:@motivoBg;border-radius:3px;padding:3px 7px;font-size:.7rem;max-width:320px;">
                                                        <div class="d-flex align-items-center gap-1 mb-1">
                                                            <i class="@motivoIcon" style="font-size:.8rem;"></i>
                                                            <span class="fw-semibold">@motivoLabel</span>
                                                            @if (r.ExclFch.HasValue)
                                                            {
                                                                <span class="text-muted ms-auto" style="font-size:.6rem;white-space:nowrap;">@r.ExclFch.Value.ToString("dd/MM/yy HH:mm")</span>
                                                            }
                                                        </div>
                                                        @if (!string.IsNullOrWhiteSpace(r.ExclUsuario))
                                                        {
                                                            <div style="font-size:.6rem;color:#495057;">
                                                                <i class="bi bi-person me-1"></i>@r.ExclUsuario
                                                            </div>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(r.ExclObs))
                                                        {
                                                            <div class="mt-1" style="font-size:.62rem;color:#343a40;font-style:italic;">
                                                                <i class="bi bi-chat-left-text me-1 text-muted"></i>@r.ExclObs
                                                            </div>
                                                        }
                                                        @if ((r.Tipdoc is "07" or "08") && (!string.IsNullOrWhiteSpace(r.SerDocref) || !string.IsNullOrWhiteSpace(r.NroDocref)))
                                                        {
                                                            <div class="mt-1 d-flex flex-wrap gap-1 align-items-center">
                                                                <span style="font-size:.6rem;color:var(--sire-gray-600);white-space:nowrap;"><i class="bi bi-link-45deg"></i> Doc. original:</span>
                                                                @if (!string.IsNullOrWhiteSpace(r.TipDocref))
                                                                {
                                                                    <span class="badge bg-light text-dark border" style="font-size:.58rem;">T:@r.TipDocref</span>
                                                                }
                                                                <span class="font-monospace fw-semibold" style="font-size:.65rem;">@r.SerDocref-@r.NroDocref</span>
                                                                @if (r.FDocref.HasValue)
                                                                {
                                                                    <span class="text-muted" style="font-size:.6rem;">@r.FDocref.Value.ToString("dd/MM/yyyy")</span>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(r.TipoNota))
                                                                {
                                                                    <span class="badge bg-info text-dark" style="font-size:.58rem;" title="Tipo de nota">TN:@r.TipoNota</span>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else if (!string.IsNullOrWhiteSpace(r.DiffCampos) && r.Estado != "SOLO_SUNAT" && r.Estado != "SOLO_LEGACY")
                                                {
                                                    foreach (var campo in r.DiffCampos.Split('|', StringSplitOptions.RemoveEmptyEntries))
                                                    {
                                                        var esCritico   = campo is "IGVIPMDG" or "TOTAL_CP";
                                                        var (sv, lv)    = r.ValoresCampo(campo);
                                                        var label       = labelMap.TryGetValue(campo, out var lb2) ? lb2 : campo;
                                                        var borderColor = esCritico ? "#dc3545" : "#ffc107";
                                                        var bgColor     = esCritico ? "rgba(220,53,69,.10)" : "rgba(255,193,7,.15)";
                                                        var textColor   = esCritico ? "#dc3545" : "#856404";
                                                        <div class="d-inline-flex flex-column me-2 mb-1 align-items-start"
                                                             style="background:@bgColor;border-left:2px solid @borderColor;border-radius:3px;padding:2px 6px;font-size:.62rem;">
                                                            <span class="fw-semibold" style="color:@textColor;white-space:nowrap;">@label</span>
                                                            <span class="font-monospace" style="color:#495057;font-size:.58rem;">S: @sv &nbsp;➞&nbsp; E: @lv</span>
                                                        </div>
                                                    }
                                                }
                                                else if (r.Estado == "SOLO_SUNAT")
                                                {
                                                    <span class="badge bg-secondary" style="font-size:.58rem;">No existe en ERP Logix</span>
                                                }
                                                else if (r.Estado == "SOLO_LEGACY")
                                                {
                                                    <span class="badge bg-secondary" style="font-size:.58rem;">No existe en SUNAT</span>
                                                }
                                                @if (_tieneRef)
                                                {
                                                    <div class="mt-1 d-flex flex-wrap gap-1 align-items-center">
                                                        <span style="font-size:.6rem;color:var(--sire-gray-600);white-space:nowrap;"><i class="bi bi-link-45deg"></i> Doc. original:</span>
                                                        @if (!string.IsNullOrWhiteSpace(r.TipDocref))
                                                        {
                                                            <span class="badge bg-light text-dark border" style="font-size:.58rem;">T:@r.TipDocref</span>
                                                        }
                                                        <span class="font-monospace fw-semibold" style="font-size:.65rem;">@r.SerDocref-@r.NroDocref</span>
                                                        @if (r.FDocref.HasValue)
                                                        {
                                                            <span class="text-muted" style="font-size:.6rem;">@r.FDocref.Value.ToString("dd/MM/yyyy")</span>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(r.TipoNota))
                                                        {
                                                            <span class="badge bg-info text-dark" style="font-size:.58rem;" title="Tipo de nota">TN:@r.TipoNota</span>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (r.EsSsco && r.Estado == "SOLO_LEGACY")
                                                {
                                                    <button type="button" class="btn btn-sm py-0 px-1"
                                                        style="font-size:.65rem;background:#dc2626;color:#fff;border:none;"
                                                        title="Excluir del reemplazo SUNAT: proveedor en padrón SSCO"
                                                        onclick="sscoExcluir(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(r.Ruc ?? "")))">
                                                        <i class="bi bi-shield-slash me-1"></i>Excluir SSCO
                                                    </button>
                                                }
                                                else if (r.EsSsco && r.Estado == "EXCLUIDO")
                                                {
                                                    <button type="button" class="btn btn-sm py-0 px-1"
                                                        style="font-size:.65rem;background:#16a34a;color:#fff;border:none;"
                                                        title="Restaurar comprobantes excluidos por SSCO"
                                                        onclick="sscoRestaurar(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(r.Ruc ?? "")))">
                                                        <i class="bi bi-arrow-counterclockwise me-1"></i>Restaurar
                                                    </button>
                                                }
                                                else if (r.EsSsco)
                                                {
                                                    <span class="badge" style="background:#dc2626;font-size:.58rem;" title="Proveedor en padrón SSCO">
                                                        <i class="bi bi-shield-exclamation me-1"></i>SSCO
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted" style="font-size:.7rem;">—</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot style="position:sticky;bottom:0;z-index:1;background:#fff;">
                                <tr style="border-top:2px solid #dee2e6;">
                                    <td class="td-check-excl" style="display:none;"></td>
                                    <td colspan="6" class="text-end fw-semibold" style="font-size:.75rem;color:var(--sire-gray-600);">TOTALES</td>
                                    <td class="text-end fw-bold" id="tfoot-concil-sb">@concil.Sum(x => x.SunatBase).ToString("N2")</td>
                                    <td class="text-end fw-bold" id="tfoot-concil-lb">@concil.Sum(x => x.LegBase).ToString("N2")</td>
                                    <td class="text-end fw-bold @(concil.Sum(x => x.DiffBase) != 0 ? "text-danger" : "")" id="tfoot-concil-db">@concil.Sum(x => x.DiffBase).ToString("N2")</td>
                                    <td class="text-end fw-bold" id="tfoot-concil-st">@concil.Sum(x => x.SunatTotal).ToString("N2")</td>
                                    <td class="text-end fw-bold" id="tfoot-concil-lt">@concil.Sum(x => x.LegTotal).ToString("N2")</td>
                                    <td class="text-end fw-bold @(concil.Sum(x => x.DiffTotalCp) != 0 ? "text-danger" : "")" id="tfoot-concil-dt">@concil.Sum(x => x.DiffTotalCp).ToString("N2")</td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>

        </div>
    </div>
}


@* ── Modal: Resultado Aceptar Propuesta ─────────────────────────────────────────── *@
<div class="modal fade" id="modalResultadoAceptar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:12px;overflow:hidden;">
            <div class="modal-header py-2" id="modalResultadoAceptarHeader" style="background:var(--sire-rce);color:#fff;">
                <h6 class="modal-title fw-semibold">
                    <i class="bi bi-check-circle-fill me-2"></i><span id="rAcepTituloTxt">Propuesta aceptada</span>
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" style="font-size:.875rem;">
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr><th style="width:130px;font-weight:600;">Tipo</th><td id="rAcepTipo">—</td></tr>
                        <tr><th>Período</th><td id="rAcepPeriodo">—</td></tr>
                        <tr><th>Ticket SUNAT</th><td id="rAcepTicket" class="font-monospace small"></td></tr>
                        <tr><th>Estado</th><td id="rAcepEstado">—</td></tr>
                        <tr><th>Archivo</th><td id="rAcepArchivo" style="word-break:break-all;">—</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<script>
    // ── Enviar Reporte Solo SUNAT ─────────────────────────────────────────────
    function abrirModalEnviarReporte() {
        const periodoLabel = '@yyyyMm';
        document.getElementById('reportePeriodoLabel').textContent = periodoLabel || '—';
        document.getElementById('frmEnviarReportePeriodo').value = '@periodoSeleccionado';
        new bootstrap.Modal(document.getElementById('modalEnviarReporte')).show();
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.getElementById('btnConfirmarEnviarReporte')?.addEventListener('click', () => {
            const modalEl = document.getElementById('modalEnviarReporte');
            const ov      = document.getElementById('sireOverlayCorreo');
            // Esperar a que Bootstrap termine de ocultar el modal antes de mostrar el overlay
            modalEl.addEventListener('hidden.bs.modal', async function handler() {
                modalEl.removeEventListener('hidden.bs.modal', handler);
                if (ov) ov.style.display = 'flex';
                const periodo = document.getElementById('frmEnviarReportePeriodo')?.value || '@periodoSeleccionado';
                const token   = document.querySelector('[name=__RequestVerificationToken]')?.value ?? '';
                try {
                    const resp = await fetch('@Url.Action("EnviarReporteCompras", "Sire")', {
                        method : 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded',
                                   'RequestVerificationToken': token },
                        body   : 'periodo=' + encodeURIComponent(periodo)
                    });
                    const data = await resp.json();
                    if (ov) ov.style.display = 'none';
                    if (data.ok) {
                        mostrarToastSire('\u2713 ' + data.mensaje, 'success');
                    } else {
                        mostrarToastSire('\u26a0 ' + data.mensaje, 'danger');
                    }
                } catch(e) {
                    if (ov) ov.style.display = 'none';
                    mostrarToastSire('Error de red: ' + e.message, 'danger');
                }
            });
            bootstrap.Modal.getInstance(modalEl)?.hide();
        });

        // ── Fix badge SSCO: interceptar el form con AJAX y recargar la página al terminar ──
        document.getElementById('frmSscoCargar')?.addEventListener('submit', async function (e) {
            e.preventDefault();
            const btn = this.querySelector('[type=submit]');
            if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Cargando…'; }
            try {
                const resp = await fetch(this.action, { method: 'POST', body: new FormData(this) });
                const data = await resp.json();
                if (data.ok) {
                    mostrarToastSire('\u2713 ' + data.mensaje, 'success');
                    // Cerrar modal y recargar para que el badge SSCO refleje el nuevo padrón
                    bootstrap.Modal.getInstance(document.getElementById('modalSscoCargar'))?.hide();
                    setTimeout(() => location.reload(), 900);
                } else {
                    mostrarToastSire('\u26a0 ' + data.mensaje, 'danger');
                    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-upload me-1"></i>Cargar padrón'; }
                }
            } catch (err) {
                mostrarToastSire('Error de red: ' + err.message, 'danger');
                if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-upload me-1"></i>Cargar padrón'; }
            }
        });
    });

    function confirmarAceptar(periodo, periodoLabel) {
        const titulo = document.getElementById('modalConfirmarTitulo');
        if (titulo) titulo.innerHTML = '<i class="bi bi-check-circle me-1"></i>Aceptar Propuesta SUNAT';
        confirmarAccion(
            `¿Aceptar la propuesta ${periodoLabel} en SUNAT? SUNAT procesará el archivo y devolverá una constancia.`,
            async () => {
                mostrarOverlayGlobal('Aceptando propuesta en SUNAT...', `Período ${periodoLabel} — el polling puede tardar varios segundos.`);
                const frm   = document.getElementById('frmAceptar_' + periodo);
                const token = frm?.querySelector('[name=__RequestVerificationToken]')?.value
                           ?? document.querySelector('[name=__RequestVerificationToken]')?.value ?? '';
                try {
                    const resp = await fetch(frm.action, {
                        method : 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded',
                                   'RequestVerificationToken': token,
                                   'X-Requested-With': 'XMLHttpRequest' },
                        body   : `periodo=${encodeURIComponent(periodo)}&tipo=compras`
                    });
                    const data = await resp.json();
                    ocultarOverlayGlobal();
                    // Rellenar y mostrar modal de resultado
                    document.getElementById('rAcepTituloTxt').textContent = data.ok ? 'Propuesta aceptada' : 'Error al aceptar';
                    document.getElementById('modalResultadoAceptarHeader').style.background = data.ok ? 'var(--sire-rce)' : '#dc2626';
                    document.getElementById('rAcepTipo').textContent    = data.tipo    ?? '—';
                    document.getElementById('rAcepPeriodo').textContent = data.periodo ?? '—';
                    document.getElementById('rAcepTicket').textContent  = data.ticket  ?? '—';
                    document.getElementById('rAcepEstado').textContent  = data.estado  ?? '—';
                    document.getElementById('rAcepArchivo').textContent = data.archivo ?? '—';
                    const modalEl = document.getElementById('modalResultadoAceptar');
                    modalEl.addEventListener('hidden.bs.modal', () => location.reload(), { once: true });
                    new bootstrap.Modal(modalEl).show();
                } catch (err) {
                    ocultarOverlayGlobal();
                    mostrarToastSire('Error de red: ' + err.message, 'danger');
                }
            }
        );
    }
    function confirmarCerrar(periodo, periodoLabel) {
        const titulo = document.getElementById('modalConfirmarTitulo');
        if (titulo) titulo.innerHTML = '<i class="bi bi-lock me-1 text-danger"></i>Cerrar Período — Acción Irreversible';
        confirmarAccion(
            `⚠️ ¿Cerrar definitivamente el período ${periodoLabel}? Esta acción registra el preliminar en SUNAT y NO SE PUEDE DESHACER.`,
            () => {
                mostrarOverlayGlobal('Cerrando período en SUNAT...', `Período ${periodoLabel} — registrando preliminar, por favor espere.`);
                document.getElementById('frmCerrar_' + periodo).submit();
            }
        );
    }
    function confirmarConciliar(periodo, periodoLabel) {
        confirmarAccion(
            `¿Conciliar la propuesta ${periodoLabel} contra el ERP (Logix)? Esto actualizará SIRE_LEGACY y SIRE_CONCIL.`,
            () => {
                mostrarOverlayGlobal('Conciliando propuesta...', `Período ${periodoLabel} — puede tardar varios segundos.`);
                document.getElementById('frmConcil_' + periodo).submit();
            }
        );
    }
    function confirmarEliminar(periodo, periodoLabel, nroReg) {
        confirmarAccion(
            `¿Eliminar la propuesta ${periodoLabel}? Se borrarán ${nroReg} registros de SIRE_PROPUESTA.`,
            () => {
                mostrarOverlayGlobal('Eliminando propuesta...', `Período ${periodoLabel}`);
                document.getElementById('frmElim_' + periodo).submit();
            }
        );
    }
    function cambiarPeriodo() {
        const periodo = document.getElementById('periodoSelect').value;
        mostrarOverlayGlobal('Cargando período...', periodo || '');
        window.location.href = '@Url.Action("Compras", new { })' + (periodo ? '?periodo=' + periodo : '?periodo=');
    }

    function recargarPeriodo() {
        location.reload();
    }

    // ── Control de polling activo ─────────────────────────────────────────────
    // Solo un poll puede estar activo a la vez. Al iniciar nuevo job o cancelar,
    // se cambia _pollingJobId y el loop anterior se auto-detiene.
    let _pollingJobId = null;

    // Filtro activo en la pestana Cruzado/Diferencias (null = todos)
    let _concilFilter = null;

    // ── Modal de confirmación (reemplaza confirm() nativo) ────────────────────
    function confirmarAccion(mensaje, callbackSi) {
        const modalEl = document.getElementById('modalConfirmar');
        const tituloEl = document.getElementById('modalConfirmarTitulo');
        const mensajeEl = document.getElementById('modalConfirmarMensaje');
        const btn = document.getElementById('btnConfirmarSi');
        if (!modalEl || !btn) { console.error('SIRE: modal de confirmación no encontrado'); return; }
        if (tituloEl) tituloEl.innerHTML = '<i class="bi bi-question-circle me-1"></i>Confirmar acción';
        if (mensajeEl) mensajeEl.textContent = mensaje;
        // Restaurar estado base del botón antes de clonarlo
        btn.style.display = '';
        btn.className = 'btn btn-sm btn-primary';
        btn.textContent = 'Confirmar';
        const clone = btn.cloneNode(true); // elimina listeners previos
        btn.parentNode.replaceChild(clone, btn);
        clone.addEventListener('click', () => {
            bootstrap.Modal.getInstance(modalEl)?.hide();
            callbackSi();
        });
        new bootstrap.Modal(modalEl).show();
    }

    // Si venimos del Index con un job a reconectar, abrimos el modal automáticamente
    document.addEventListener('DOMContentLoaded', () => {
        if (sessionStorage.getItem('sireReconectar') === '1') {
            sessionStorage.removeItem('sireReconectar');
            const jobId  = sessionStorage.getItem('sireJobId');
            const period = sessionStorage.getItem('periodoExportacion');
            const tipo   = sessionStorage.getItem('tipoExportacion');
            if (jobId && period && tipo === 'compras') {
                _pollingJobId = jobId;
                const modal = new bootstrap.Modal(document.getElementById('modalExportacion'));
                modal.show();
                actualizarModalExportacion('EnProceso', 'Reconectando al proceso en curso…', jobId, 0);
                consultarEstadoJob(jobId, period, tipo);
            }
        }
    });

    // Inicia la exportación en segundo plano (BackgroundService) y muestra modal de progreso
    // ── Modal re-procesar ZIP local ──────────────────────────────────────────
    let _reprocesarPeriodo = null, _reprocesarTipo = null, _reprocesarBtnOrig = null, _reprocesarBtnEl = null;
    function abrirModalReprocesar(periodo, tipo, nombreZip) {
        _reprocesarPeriodo = periodo; _reprocesarTipo = tipo;
        document.getElementById('modalReprocesarNombreZip').textContent = nombreZip || '(desconocido)';
        const btnConf = document.getElementById('btnConfirmarReprocesar');
        const clone = btnConf.cloneNode(true);
        btnConf.parentNode.replaceChild(clone, btnConf);
        clone.addEventListener('click', () => {
            bootstrap.Modal.getInstance(document.getElementById('modalReprocesarZip'))?.hide();
            ejecutarReprocesarZip(periodo, tipo);
        });
        new bootstrap.Modal(document.getElementById('modalReprocesarZip')).show();
    }
    async function ejecutarReprocesarZip(periodo, tipo) {
        const btnId = tipo === 'ventas' ? 'btnReprocesarVentas' : 'btnReprocesarCompras';
        const btn = document.getElementById(btnId);
        if (btn) { _reprocesarBtnEl = btn; _reprocesarBtnOrig = btn.innerHTML; btn.disabled = true; }

        // Mostrar overlay y limpiar tablas
        const overlay = document.getElementById('overlayReprocesar');
        if (overlay) overlay.style.display = 'flex';
        ['tablaPropuestaDetalle','tablaLegacyDetalle','tablaConcilDetalle'].forEach(id => {
            const tb = document.getElementById(id)?.querySelector('tbody');
            if (tb) tb.innerHTML = '<tr><td colspan="20" class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Recargando datos…</td></tr>';
        });

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            const resp = await fetch('@Url.Action("ReprocesarZipLocal", "Sire")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({ tipo, periodo })
            });
            const data = await resp.json();
            if (data.exitoso) {
                mostrarToastSire(`✓ ${data.insertados} registros cargados. Ejecute «Conciliar» para actualizar Legacy y Cruzado.`, 'success');
                setTimeout(() => location.reload(), 1200);
            } else {
                if (overlay) overlay.style.display = 'none';
                mostrarToastSire(`Error: ${data.error ?? 'Ver log del servidor'}`, 'danger');
                if (_reprocesarBtnEl) { _reprocesarBtnEl.disabled = false; _reprocesarBtnEl.innerHTML = _reprocesarBtnOrig; }
            }
        } catch (e) {
            if (overlay) overlay.style.display = 'none';
            mostrarToastSire('Error de red: ' + e.message, 'danger');
            if (_reprocesarBtnEl) { _reprocesarBtnEl.disabled = false; _reprocesarBtnEl.innerHTML = _reprocesarBtnOrig; }
        }
    }
    function mostrarToastSire(msg, tipo) {
        let cont = document.getElementById('sireToastContainer');
        if (!cont) {
            cont = document.createElement('div');
            cont.id = 'sireToastContainer';
            cont.style.cssText = 'position:fixed;bottom:1.2rem;right:1.2rem;z-index:9999;display:flex;flex-direction:column;gap:.5rem;';
            document.body.appendChild(cont);
        }
        const t = document.createElement('div');
        t.className = `alert alert-${tipo} shadow py-2 px-3 mb-0`;
        t.style.cssText = 'font-size:.85rem;min-width:260px;animation:fadeInUp .25s ease;';
        t.textContent = msg;
        cont.appendChild(t);
        setTimeout(() => t.remove(), 4000);
    }

    function mostrarOverlaySire(msg) {
        const ov      = document.getElementById('sireOverlayGlobal');
        const elMsg   = document.getElementById('sireOvMsg');
        const elMens  = document.getElementById('sireOverlayMensaje');
        const elSub   = document.getElementById('sireOverlaySubMensaje');
        const elDet   = document.getElementById('sireOvDetalle');
        const elBWrap = document.getElementById('sireOvBarraWrap');
        const elPct   = document.getElementById('sireOvPct');
        // Modo validacion: ocultar slots normales, mostrar slots de progreso
        if (elMens)  { elMens.style.display  = 'none'; }
        if (elSub)   { elSub.style.display   = 'none'; }
        if (elMsg)   { elMsg.style.display   = 'block'; elMsg.textContent = msg ?? 'Validando comprobantes…'; }
        if (elDet)   { elDet.style.display   = 'block'; elDet.textContent = ''; }
        if (elBWrap) { elBWrap.style.display = 'block'; }
        if (elPct)   { elPct.style.display   = 'block'; elPct.textContent  = ''; }
        const barra = document.getElementById('sireOvBarra');
        if (barra)   barra.style.width = '0%';
        if (ov) {
            ov.dataset.modo = 'validacion';   // <-- marca: mostrarOverlayGlobal no debe interferir
            ov.style.display = 'flex'; ov.style.flexDirection = 'column';
            ov.style.alignItems = 'center'; ov.style.justifyContent = 'center';
        }
    }

    function ocultarOverlaySire() {
        const ov      = document.getElementById('sireOverlayGlobal');
        const elMsg   = document.getElementById('sireOvMsg');
        const elMens  = document.getElementById('sireOverlayMensaje');
        const elSub   = document.getElementById('sireOverlaySubMensaje');
        const elDet   = document.getElementById('sireOvDetalle');
        const elBWrap = document.getElementById('sireOvBarraWrap');
        const elPct   = document.getElementById('sireOvPct');
        if (ov) { ov.style.display = 'none'; delete ov.dataset.modo; }   // <-- quita la marca
        // Restaurar slots normales para próxima apertura (conciliar, etc.)
        if (elMsg)   { elMsg.style.display   = 'none'; }
        if (elDet)   { elDet.style.display   = 'none'; }
        if (elBWrap) { elBWrap.style.display = 'none'; }
        if (elPct)   { elPct.style.display   = 'none'; }
        if (elMens)  { elMens.style.display  = 'block'; }
        if (elSub)   { elSub.style.display   = 'block'; }
    }

    // Devuelve el id de la tabla visible según el tab activo
    function tablaActivaId() {
        const pane = document.querySelector('#tabsDetalle .nav-link.active')?.dataset?.bsTarget;
        if (pane === '#panel-legacy') return 'tablaLegacyDetalle';
        if (pane === '#panel-concil') return 'tablaConcilDetalle';
        if (pane === '#panel-ssco')   return 'tablaSscoDetalle';
        return 'tablaPropuestaDetalle';
    }

    function filtrarConcil(estado, btn) {
        _concilFilter = estado;
        document.querySelectorAll('#filtroConcilBtns button:not(#btnExcluirSelec):not(#btnRestaurarSelec)').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');

        // Mostrar/ocultar columna de checkbox
        const showCheck = estado === 'SOLO_SUNAT' || estado === 'EXCLUIDO';
        document.getElementById('th-check-concil').style.display = showCheck ? '' : 'none';
        document.querySelectorAll('.td-check-excl').forEach(td => td.style.display = showCheck ? '' : 'none');

        // Botón Enviar Reporte: solo visible en SOLO_SUNAT
        const btnRep   = document.getElementById('btnEnviarReporte');
        if (btnRep)   btnRep.style.display    = estado === 'SOLO_SUNAT' ? '' : 'none';

        // Desmarcar checkboxes al cambiar filtro y limpiar badges
        document.querySelectorAll('.sire-excl-check').forEach(c => c.checked = false);
        const chkTodos = document.getElementById('chkTodosExcl');
        if (chkTodos) chkTodos.checked = false;
        actualizarBadgeExcluir();  // esto controla también la visibilidad de Excluir/Restaurar

        filtrarTablaActiva(document.getElementById('inputBuscadorSire')?.value ?? '');
        // Re-aplicar el ordenamiento activo para que persista al cambiar de opción
        const thActivo = document.querySelector('#tablaConcilDetalle th[data-sort-dir="asc"], #tablaConcilDetalle th[data-sort-dir="desc"]');
        if (thActivo) sireOrdenarColumnaAplicar(thActivo);
    }

    function actualizarBadgeExcluir() {
        const n = document.querySelectorAll('.sire-excl-check:checked').length;
        const bdgExcl  = document.getElementById('excluirBadge');
        const bdgRest  = document.getElementById('restaurarBadge');
        const btnExcl  = document.getElementById('btnExcluirSelec');
        const btnRest  = document.getElementById('btnRestaurarSelec');
        if (bdgExcl) bdgExcl.textContent = n > 0 ? n : '';
        if (bdgRest) bdgRest.textContent = n > 0 ? n : '';
        // Mostrar botón solo si hay selección Y el filtro activo lo permite
        if (btnExcl) btnExcl.style.display  = (n > 0 && _concilFilter === 'SOLO_SUNAT') ? '' : 'none';
        if (btnRest) btnRest.style.display   = (n > 0 && _concilFilter === 'EXCLUIDO')   ? '' : 'none';
    }

    function parseVal(s) {
        if (!s || s.trim() === '-' || s.trim() === '') return 0;
        return parseFloat(s.replace(/,/g, '')) || 0;
    }

    function actualizarTotalesConcil() {
        const tbody = document.querySelector('#tablaConcilDetalle tbody');
        if (!tbody) return;
        const filas = Array.from(tbody.querySelectorAll('tr')).filter(tr => tr.style.display !== 'none');
        let sb=0, lb=0, db=0, st=0, lt=0, dt=0;
        filas.forEach(tr => {
            const tds = tr.querySelectorAll('td');
            // índice +1 por la columna de checkbox (td-check-excl) como primera celda
            sb += parseVal(tds[7]?.textContent);
            lb += parseVal(tds[8]?.textContent);
            db += parseVal(tds[9]?.textContent);
            st += parseVal(tds[10]?.textContent);
            lt += parseVal(tds[11]?.textContent);
            dt += parseVal(tds[12]?.textContent);
        });
        const fmt = n => n.toLocaleString('es-PE', {minimumFractionDigits:2, maximumFractionDigits:2});
        const set = (id, val, danger) => {
            const el = document.getElementById(id);
            if (!el) return;
            el.textContent = fmt(val);
            el.className = `text-end fw-bold${danger && Math.abs(val) > 0.005 ? ' text-danger' : ''}`;
        };
        set('tfoot-concil-sb', sb, false);
        set('tfoot-concil-lb', lb, false);
        set('tfoot-concil-db', db, true);
        set('tfoot-concil-st', st, false);
        set('tfoot-concil-lt', lt, false);
        set('tfoot-concil-dt', dt, true);
    }

    function actualizarVisibilidadFiltros() {
        const pane = document.querySelector('#tabsDetalle .nav-link.active')?.dataset?.bsTarget;
        const btns = document.getElementById('filtroConcilBtns');
        if (btns) btns.style.visibility = (pane === '#panel-concil') ? 'visible' : 'hidden';
    }

    // Oculta los botones de filtro del concil cuando el tab SSCO está activo.
    // Se llama desde onclick del tab SSCO: mostrarFiltrosSsco(false)
    function mostrarFiltrosSsco(visible) {
        const btns = document.getElementById('filtroConcilBtns');
        if (btns) btns.style.visibility = visible ? 'visible' : 'hidden';
    }

    function filtrarTablaActiva(q) {
        q = (q || '').toLowerCase();
        const id = tablaActivaId();
        const filas = document.querySelectorAll('#' + id + ' tbody tr');
        let vis = 0;
        filas.forEach(tr => {
            const textOk  = !q || tr.textContent.toLowerCase().includes(q);
            const concilOk = !_concilFilter
                || (_concilFilter === 'CP_NO_EXISTE'
                    ? tr.dataset.cpeError === '1'
                    : _concilFilter === 'AVISO'
                        ? tr.dataset.diffInfo === '1'
                        : (!tr.dataset.concil || tr.dataset.concil === _concilFilter));
            const mostrar = textOk && concilOk;
            tr.style.display = mostrar ? '' : 'none';
            if (mostrar) vis++;
        });
        const cnt = document.getElementById('contadorFilasActivo');
        if (cnt) cnt.textContent = vis + ' filas';
        if (id === 'tablaConcilDetalle') actualizarTotalesConcil();
    }

    // -- Validacion de comprobantes contra API Consulta Integrada SUNAT ------

    async function validarCpeSunat(btn) {
        const periodo = document.getElementById('periodoSeleccionado')?.value
                     ?? document.querySelector('[name="periodoSeleccionado"]')?.value
                     ?? '@periodoSeleccionado';
        if (!periodo) { mostrarToastSire('Seleccione un periodo antes de validar.', 'warning'); return; }
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        btn.disabled = true;
        const orig = btn.innerHTML;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Validando...';
        mostrarOverlaySire('Obteniendo lista de comprobantes...');
        let validados = 0, errores = 0;
        try {
            const listResp = await fetch('@Url.Action("GetIdsParaValidar","Sire")?tipo=compras&periodo=' + periodo, { credentials: 'include' });
            if (!listResp.ok) { mostrarToastSire('Error al obtener lista: ' + listResp.status, 'danger'); return; }
            const list = await listResp.json();
            if (!list.total) { mostrarToastSire('No hay comprobantes para validar.', 'info'); return; }
            const items = list.items;
            for (let i = 0; i < items.length; i++) {
                const item = items[i];
                const pct  = Math.round(((i + 1) / items.length) * 100);
                const elMsg   = document.getElementById('sireOvMsg');
                const elDet   = document.getElementById('sireOvDetalle');
                const elBarra = document.getElementById('sireOvBarra');
                const elPct   = document.getElementById('sireOvPct');
                if (elMsg)   elMsg.textContent   = 'Validando ' + (i + 1) + ' de ' + items.length + '...';
                if (elDet)   elDet.innerHTML     = '<span style="font-weight:600;">' + (item.serie ?? '') + '-' + (item.numero ?? '') + '</span>' +
                                                   ' &middot; ' + (item.ruc ?? '') +
                                                   '<br><span style="color:#9ca3af">' + (item.nombre ?? '') + '</span>';
                if (elBarra) elBarra.style.width = pct + '%';
                if (elPct)   elPct.textContent   = pct + '%  ✓ ' + validados + '  ✗ ' + errores;
                try {
                    const r = await fetch('@Url.Action("ValidarFilaSunat","Sire")?idConcil=' + item.idConcil, {
                        method: 'POST', credentials: 'include', headers: { 'RequestVerificationToken': token }
                    });
                    if (r.ok) { const res = await r.json(); actualizarCeldaValidez(item.idConcil, res); validados++; }
                    else { errores++; }
                } catch { errores++; }
            }
            mostrarToastSire('Validados: ' + validados + ' — Errores: ' + errores, errores > 0 ? 'warning' : 'success');
            // Re-aplicar el filtro activo para que las filas con CP: NO EXISTE se muestren/oculten correctamente
            filtrarTablaActiva(document.getElementById('inputBuscadorSire')?.value ?? '');
        } catch (e) {
            mostrarToastSire('Error de red: ' + e.message, 'danger');
        } finally {
            ocultarOverlaySire();
            btn.disabled = false;
            btn.innerHTML = orig;
        }
    }

    function actualizarCeldaValidez(idConcil, res) {
        const td = document.querySelector('.td-validez-sunat[data-id="' + idConcil + '"]');
        if (!td) return;
        const cpLbl  = res.estadoCpLabel  ?? res.estadoCp  ?? '-';
        const rucLbl = res.estadoRucLabel ?? res.estadoRuc ?? '-';
        const domLbl = res.condDomiLabel  ?? res.condDomiRuc ?? '-';
        // CP: clase del servidor (contiene 'bg-success','bg-danger','bg-warning',etc.)
        const cpCss  = res.badgeCss ?? 'badge bg-secondary';
        // RUC ACTIVO = '00', DOM HABIDO = '00'
        const rucOk  = res.estadoRuc   === '00';
        const domOk  = res.condDomiRuc === '00';
        const rucCss = rucOk  ? 'badge bg-success' : 'badge bg-warning text-dark';
        const domCss = domOk  ? 'badge bg-success' : 'badge bg-warning text-dark';
        const BSTYLE = 'font-size:.6rem;min-width:78px;text-align:center;padding:2px 5px;border-radius:4px;display:block;letter-spacing:.01em;';
        td.innerHTML =
            '<div class="d-flex flex-column align-items-center gap-1" style="min-width:82px;">' +
                '<span class="' + cpCss  + '" style="' + BSTYLE + '">CP: '  + cpLbl  + '</span>' +
                '<span class="' + rucCss + '" style="' + BSTYLE + '">RUC: ' + rucLbl + '</span>' +
                '<span class="' + domCss + '" style="' + BSTYLE + '">Dom: ' + domLbl + '</span>' +
            '</div>' +
            '<button class="btn btn-revalidar-fila p-0 mt-1" data-id="' + idConcil + '" title="Re-validar contra SUNAT" ' +
            'style="font-size:.62rem;line-height:1;background:none;border:none;color:#adb5bd;" >' +
                '<i class="bi bi-arrow-repeat"></i></button>';
                const cpOk   = res.estadoCp    === '1' || res.estadoCp    === '3';
                const rucErr = res.estadoRuc   != null  && res.estadoRuc   !== '00';
                const domErr = res.condDomiRuc != null  && res.condDomiRuc !== '00';
                const tr     = td.closest('tr');
                if (tr) {
                    tr.dataset.validezCp = res.estadoCp ?? '';
                    tr.dataset.cpeError  = (!cpOk || rucErr || domErr) ? '1' : '0';
                    // Pintar fila rojo si CP: NO EXISTE (estadoCp === '0'), quitar si ya no aplica
                    if (res.estadoCp === '0') {
                        tr.classList.add('sire-row-cp-noexiste');
                    } else {
                        tr.classList.remove('sire-row-cp-noexiste');
                    }
                }
            }

    async function validarFilaSunat(idConcil, tdEl) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        const tdDom = tdEl ?? document.querySelector('.td-validez-sunat[data-id="' + idConcil + '"]');
        const btnR  = tdDom?.querySelector('.btn-revalidar-fila');
        if (btnR) { btnR.disabled = true; btnR.innerHTML = '<span class="spinner-border spinner-border-sm" style="width:.7rem;height:.7rem;"></span>'; }
        try {
            const resp = await fetch('@Url.Action("ValidarFilaSunat","Sire")?idConcil=' + idConcil, {
                method: 'POST', credentials: 'include', headers: { 'RequestVerificationToken': token }
            });
            if (!resp.ok) {
                let msg = 'Error ' + resp.status;
                try { const j = await resp.json(); msg = j.error || msg; } catch {}
                mostrarToastSire('Advertencia: ' + msg, 'danger');
                if (btnR) { btnR.disabled = false; btnR.innerHTML = '<i class="bi bi-arrow-repeat"></i>'; }
                return;
            }
            const res = await resp.json();
            actualizarCeldaValidez(idConcil, res);
        } catch (e) {
            mostrarToastSire('Error de red: ' + e.message, 'danger');
            if (btnR) { btnR.disabled = false; btnR.innerHTML = '<i class="bi bi-arrow-repeat"></i>'; }
        }
    }

    // -- Exclusion manual -------------------------------------------------------------------

    function seleccionarTodosExcl(chk) {
        document.querySelectorAll('#tablaConcilDetalle tbody tr:not([style*="none"]) .sire-excl-check')
            .forEach(c => c.checked = chk.checked);
        actualizarBadgeExcluir();
    }

    function excluirSeleccionados() {
        const checks = Array.from(document.querySelectorAll('.sire-excl-check:checked'));
        if (checks.length === 0) {
            document.getElementById('modalConfirmarTitulo').innerHTML = '<i class="bi bi-info-circle me-1"></i>Sin selección';
            document.getElementById('modalConfirmarMensaje').textContent = 'Seleccione al menos un registro para excluir.';
            document.getElementById('btnConfirmarSi').style.display = 'none';
            new bootstrap.Modal(document.getElementById('modalConfirmar')).show();
            return;
        }
        document.getElementById('excluirContadorModal').textContent = checks.length;
        document.getElementById('excluirObsInput').value = '';
        new bootstrap.Modal(document.getElementById('modalExcluirSelec')).show();
    }

    document.addEventListener('DOMContentLoaded', () => {
        // Delegación click para re-validar fila individual
        document.addEventListener('click', function(e) {
            const btn = e.target.closest('.btn-revalidar-fila');
            if (!btn) return;
            const td = btn.closest('td');
            const id = parseInt(btn.dataset.id, 10);
            if (!td || !id) return;
            validarFilaSunat(id, td);
        });
        // Confirmar exclusión desde modal
        document.getElementById('btnConfirmarExcluir')?.addEventListener('click', async () => {
            const modal = bootstrap.Modal.getInstance(document.getElementById('modalExcluirSelec'));
            modal?.hide();
            const ids = Array.from(document.querySelectorAll('.sire-excl-check:checked')).map(c => parseInt(c.value, 10));
            const obs = document.getElementById('excluirObsInput')?.value?.trim() || null;
            const periodo = document.getElementById('periodoSelect')?.value || '@periodoSeleccionado';
            try {
                const resp = await fetch('@Url.Action("ExcluirManual","Sire")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json',
                               'RequestVerificationToken': document.querySelector('[name=__RequestVerificationToken]')?.value ?? '' },
                    body: JSON.stringify({ tipo: 'compras', periodo: periodo, idsConcil: ids, obs: obs })
                });
                const data = await resp.json();
                if (data.exitoso) {
                    mostrarToastSire(`\u2713 ${data.excluidos} registro(s) excluido(s). Aparecerán en el filtro \u2702 Excluidos.`, 'success');
                    marcarFilasExcluidas(ids, data.usuario, data.obs, data.fechaHora);
                } else {
                    mostrarToastSire('Error: ' + data.error, 'danger');
                }
            } catch(e) { mostrarToastSire('Error de red: ' + e.message, 'danger'); }
        });

        // Restaurar individual — usa modal genérico
        window._restaurarIdConcil = null;
        document.getElementById('btnConfirmarSi')?.addEventListener('click', async () => {
            const id = window._restaurarIdConcil;
            if (!id) return;
            window._restaurarIdConcil = null;
            bootstrap.Modal.getInstance(document.getElementById('modalConfirmar'))?.hide();
            await _doRestaurar(id);
        });
    });

    function restaurarExcluido(idConcil) {
        window._restaurarIdConcil = idConcil;
        document.getElementById('modalConfirmarTitulo').innerHTML = '<i class="bi bi-arrow-counterclockwise me-1"></i>Restaurar registro';
        document.getElementById('modalConfirmarMensaje').innerHTML = '¿Restaurar este registro a <strong>SOLO_SUNAT</strong>? Se marcará como pendiente de revisión.';
        const btnSi = document.getElementById('btnConfirmarSi');
        btnSi.style.display = '';
        btnSi.className = 'btn btn-sm btn-warning';
        btnSi.textContent = 'Sí, restaurar';
        new bootstrap.Modal(document.getElementById('modalConfirmar')).show();
    }

    async function restaurarSeleccionados() {
        const checks = Array.from(document.querySelectorAll('.sire-excl-check:checked'));
        if (checks.length === 0) {
            document.getElementById('modalConfirmarTitulo').innerHTML = '<i class="bi bi-info-circle me-1"></i>Sin selección';
            document.getElementById('modalConfirmarMensaje').textContent = 'Seleccione al menos un registro para restaurar.';
            document.getElementById('btnConfirmarSi').style.display = 'none';
            new bootstrap.Modal(document.getElementById('modalConfirmar')).show();
            return;
        }
        document.getElementById('modalConfirmarTitulo').innerHTML = '<i class="bi bi-arrow-counterclockwise me-1"></i>Restaurar registros';
        document.getElementById('modalConfirmarMensaje').innerHTML = `¿Restaurar <strong>${checks.length}</strong> registro(s) a <strong>SOLO_SUNAT</strong>? Quedarán pendientes de revisión.`;
        const btnSi = document.getElementById('btnConfirmarSi');
        btnSi.style.display = '';
        btnSi.className = 'btn btn-sm btn-warning';
        btnSi.textContent = 'Sí, restaurar todos';
        window._restaurarIdConcil = null;
        window._restaurarIds = checks.map(c => parseInt(c.value, 10));
        const modalEl = document.getElementById('modalConfirmar');
        const modal = new bootstrap.Modal(modalEl);
        // Override: al confirmar restaurar todos
        const handler = async () => {
            modal.hide();
            modalEl.removeEventListener('click', handler);
            let ok = 0, err = 0;
            for (const id of window._restaurarIds) {
                const r = await _doRestaurar(id, true);
                r ? ok++ : err++;
            }
            mostrarToastSire(`\u2713 ${ok} restaurado(s)${err > 0 ? `, ${err} con error` : ''}.`, err > 0 ? 'warning' : 'success');
            if (ok > 0) marcarFilasRestauradas(window._restaurarIds || []);
        };
        btnSi.onclick = handler;
        modal.show();
    }

    async function _doRestaurar(idConcil, silencioso = false) {
        try {
            const resp = await fetch('@Url.Action("RestaurarExcluido","Sire")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json',
                           'RequestVerificationToken': document.querySelector('[name=__RequestVerificationToken]')?.value ?? '' },
                body: JSON.stringify({ idConcil: idConcil })
            });
            const data = await resp.json();
            if (!silencioso) {
                if (data.exitoso) {
                    mostrarToastSire('\u2713 Registro restaurado a SOLO_SUNAT.', 'success');
                    marcarFilasRestauradas([idConcil]);
                } else {
                    mostrarToastSire('Error: ' + data.error, 'danger');
                }
            }
            return data.exitoso;
        } catch(e) {
            if (!silencioso) mostrarToastSire('Error de red: ' + e.message, 'danger');
            return false;
        }
    }

    // ── SSCO: Excluir / Restaurar por RUC ──────────────────────────────────────
    function _sscoModal(titulo, mensaje, cssBtnClass, btnTexto, onConfirmar) {
        document.getElementById('modalConfirmarTitulo').innerHTML = titulo;
        document.getElementById('modalConfirmarMensaje').innerHTML = mensaje;

        // Clonar el botón para eliminar TODOS los listeners previos (previene acumulación)
        const btnViejo = document.getElementById('btnConfirmarSi');
        const btnNuevo = btnViejo.cloneNode(true);
        btnViejo.parentNode.replaceChild(btnNuevo, btnViejo);

        btnNuevo.style.display = '';
        btnNuevo.className     = `btn btn-sm ${cssBtnClass}`;
        btnNuevo.textContent   = btnTexto;

        const modalEl = document.getElementById('modalConfirmar');
        const modal   = bootstrap.Modal.getOrCreateInstance(modalEl);
        btnNuevo.addEventListener('click', async () => {
