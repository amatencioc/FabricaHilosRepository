                                    <td class="text-end text-muted d-none d-xxl-table-cell">@(r.BiGravDgng != 0 ? r.BiGravDgng.ToString("N2") : "-")</td>
                                    <td class="text-end text-muted d-none d-xxl-table-cell">@(r.BiGravDng != 0 ? r.BiGravDng.ToString("N2") : "-")</td>
                                    <td class="text-end text-muted d-none d-xl-table-cell">@(r.ValAdqNg != 0 ? r.ValAdqNg.ToString("N2") : "-")</td>
                                    <td class="text-end">@r.IgvIpmDg.ToString("N2")</td>
