@await Html.PartialAsync("_PlnNavBar")

<div class="container-fluid py-3">
<div class="spt-card">

    @* ── Header ──────────────────────────────────────────────────────── *@
    <div class="pend-strip">
        <i class="bi bi-grid-3x3-gap-fill" style="color:#93c5fd;font-size:1rem;flex-shrink:0;"></i>
        <span class="pend-strip-title">Seguimiento Programación Tintorería</span>
        <span class="pend-strip-sep"></span>
        @if (buscado && items.Any())
        {
            <span class="pend-kpi"><i class="bi bi-list-check" style="color:#93c5fd;"></i><span class="pend-kpi-val">@items.Count</span> registros</span>
            <span class="pend-kpi"><i class="bi bi-droplet-half" style="color:#6ee7b7"></i><span class="pend-kpi-val" style="color:#6ee7b7">@conTenido</span> teñidos</span>
            <span class="pend-kpi"><i class="bi bi-patch-check" style="color:#a5f3fc"></i><span class="pend-kpi-val" style="color:#a5f3fc">@conCc</span> CC ok</span>
            <span class="pend-kpi"><i class="bi bi-truck" style="color:#fcd34d"></i><span class="pend-kpi-val" style="color:#fcd34d">@despachados</span> desp.</span>
            @if (retrasados > 0)
            {
                <span class="pend-kpi"><i class="bi bi-exclamation-triangle-fill" style="color:#f87171"></i><span class="pend-kpi-val" style="color:#f87171">@retrasados</span> retraso</span>
            }
            <span class="pv-strip-ts">
                <i class="bi bi-funnel me-1"></i>@opc
                @if (opc == "POR PEDIDO")
                { <span> &middot; Ped. <b style="color:#fff">@numPed</b></span> }
                else
                { <span> &middot; <b style="color:#fff">@fchIni</b> &rarr; <b style="color:#fff">@fchFin</b></span> }
            </span>
        }
        else if (!buscado)
        {
            <span style="font-size:.75rem;color:rgba(200,225,255,.7);">Aplica los filtros para consultar los datos.</span>
        }
        <span class="pend-strip-actions">
            <a asp-action="Dashboard" class="btn btn-sm btn-outline-light py-0 px-2" style="font-size:.72rem;">
                <i class="bi bi-arrow-left me-1"></i>Seguimiento
            </a>
        </span>
    </div>


    @* ── Filtros ──────────────────────────────────────────────────────────────────────────────────────────────────────── *@
    <div class="pend-filter">
        <form method="get" asp-action="SeguimientoTintoreria" id="stForm">

            @* Fila 1: modo búsqueda + fechas + acciones *@
            <div class="pend-filter-row">
                <div class="pend-fld">
                    <label class="pend-label" for="stOpc"><i class="bi bi-search"></i>Buscar por</label>
                    <select class="pend-ctrl" name="opc" id="stOpc" style="min-width:200px;">
                        @foreach (var op in opciones)
                        {
                            <option value="@op" selected="@(opc == op ? "selected" : null)">@op</option>
                        }
                    </select>
                </div>

                <div class="pend-fld" id="stGrpFechas">
                    <label class="pend-label" for="stFchIni"><i class="bi bi-calendar-event"></i>Fecha inicio</label>
                    <input type="date" class="pend-ctrl" name="fchIni" id="stFchIni" value="@iniHtml" style="min-width:135px;" />
                </div>
                <div class="pend-fld" id="stGrpFechaFin">
                    <label class="pend-label" for="stFchFin"><i class="bi bi-calendar-check"></i>Fecha fin</label>
                    <input type="date" class="pend-ctrl" name="fchFin" id="stFchFin" value="@finHtml" style="min-width:135px;" />
                </div>

                <div class="pend-fld" id="stGrpNumPed" style="display:none;">
                    <label class="pend-label" for="stNumPed"><i class="bi bi-hash"></i>N.° Pedido</label>
                    <input type="number" class="pend-ctrl" name="numPed" id="stNumPed"
                           value="@numPed" style="width:125px;" placeholder="Ej. 88797" />
                </div>

                <div class="pend-fld">
                    <label class="pend-label" style="visibility:hidden;">Acción</label>
                    <div style="display:flex;gap:.4rem;align-items:center;">
                        <button type="submit" class="btn btn-sm btn-primary">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                        <a asp-action="SeguimientoTintoreria" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-x-circle"></i> Limpiar
                        </a>
                    </div>
                </div>
            </div>

            @* Fila 2: filtros adicionales (ocultos — se envían igual via form) *@
            <div class="pend-filter-row" style="display:none;">
                <div class="pend-fld">
                    <label class="pend-label" for="stCliente"><i class="bi bi-building"></i>Cliente</label>
                    <select class="pend-ctrl" name="cliente" id="stCliente" style="min-width:260px;">
                        <option value="">— Todos —</option>
                        @foreach (var c in filtroClientes)
                        {
                            <option value="@c.CodCliente" selected="@(cliente == c.CodCliente ? "selected" : null)">@c.Nombre</option>
                        }
                    </select>
                </div>
                <div class="pend-fld">
                    <label class="pend-label" for="stAsesor"><i class="bi bi-person-badge"></i>Asesor</label>
                    <select class="pend-ctrl" name="asesor" id="stAsesor" style="min-width:210px;">
                        <option value="">— Todos —</option>
                        @foreach (var a in filtroAsesores)
                        {
                            <option value="@a.CodVende" selected="@(asesor == a.CodVende ? "selected" : null)">@a.Nombre</option>
                        }
                    </select>
                </div>
                <div class="pend-fld">
                    <label class="pend-label" for="stTitulo"><i class="bi bi-tag"></i>Título</label>
                    <select class="pend-ctrl" name="titulo" id="stTitulo" style="min-width:180px;">
                        <option value="">— Todos —</option>
                        @foreach (var t in filtroTitulos)
                        {
                            <option value="@t.Titulo" selected="@(titulo == t.Titulo ? "selected" : null)">@t.Descripcion</option>
                        }
                    </select>
                </div>
                <div class="pend-fld">
                    <label class="pend-label" for="stFibra"><i class="bi bi-layers"></i>Fibra</label>
                    <select class="pend-ctrl" name="fibra" id="stFibra" style="min-width:190px;">
                        <option value="">— Todas —</option>
                        @foreach (var f in filtroFibras)
                        {
                            <option value="@f.TipoFibra" selected="@(fibra == f.TipoFibra ? "selected" : null)">@f.Descripcion</option>
                        }
                    </select>
                </div>
                <div class="pend-fld">
                    <label class="pend-label" for="stProceso"><i class="bi bi-cpu"></i>Proceso</label>
                    <select class="pend-ctrl" name="proceso" id="stProceso" style="min-width:220px;">
                        <option value="">— Todos —</option>
                        @foreach (var p in filtroProcesos)
                        {
                            <option value="@p.Proceso" selected="@(proceso == p.Proceso ? "selected" : null)">@p.Descripcion</option>
                        }
                    </select>
                </div>
            </div>
        </form>
    </div>

    @* ── Chips de filtros activos ─────────────────────────────────────── *@
    @if (buscado && (hayMesAno || hayCliente || hayAsesor || hayTitulo || hayFibra || hayProceso))
    {
        <div class="pend-chips">
            <span style="font-size:.68rem;color:#64748b;font-weight:600;margin-right:.2rem;">Filtros:</span>
            @if (hayMesAno)  { <span class="pend-chip" style="background:#dbeafe;border-color:#93c5fd;"><span class="pend-chip-label">Mes</span> @nombresMes[stMes!.Value] @stAno</span> }
            @if (hayCliente) { <span class="pend-chip"><span class="pend-chip-label">Cliente</span> @nombreCliente</span> }
            @if (hayAsesor)  { <span class="pend-chip"><span class="pend-chip-label">Asesor</span>  @nombreAsesor</span>  }
            @if (hayTitulo)  { <span class="pend-chip"><span class="pend-chip-label">Título</span>  @nombreTitulo</span>  }
            @if (hayFibra)   { <span class="pend-chip"><span class="pend-chip-label">Fibra</span>   @nombreFibra</span>   }
            @if (hayProceso) { <span class="pend-chip"><span class="pend-chip-label">Proceso</span> @nombreProceso</span> }
        </div>
    }

</div>@* /spt-card filtros *@

<div class="spt-card">
    @* ── Resultados ──────────────────────────────────────────────────── *@
    @if (!buscado)
    {
        <div style="padding:2rem 1.5rem;text-align:center;color:#64748b;">
            <i class="bi bi-funnel" style="font-size:2.2rem;opacity:.35;display:block;margin-bottom:.5rem;"></i>
            <div style="font-size:.88rem;font-weight:600;">Aplica los filtros para consultar los datos</div>
            <div style="font-size:.78rem;opacity:.75;margin-top:.2rem;">Selecciona una opción de búsqueda y pulsa <strong>Buscar</strong>.</div>
        </div>
    }
    else if (!items.Any())
    {
        <div style="padding:2rem 1.5rem;text-align:center;color:#64748b;">
            <i class="bi bi-search" style="font-size:2rem;opacity:.35;display:block;margin-bottom:.5rem;"></i>
            <div style="font-size:.88rem;font-weight:600;">Sin resultados</div>
            <div style="font-size:.78rem;opacity:.75;margin-top:.2rem;">No se encontraron registros para los filtros seleccionados.</div>
        </div>
    }
    else
    {
        @* ── Barra de filtros client-side ── *@
        <div class="pend-cfbar" id="cfBar">

            @* 0. Limpiar (primero) *@
            <button id="cfResetBtn" class="cf-reset" type="button">
                <i class="bi bi-x-circle"></i> Limpiar
            </button>

            <div class="cf-vsep"></div>

            @* 1. MES — botones numéricos estilo imagen *@
            <div class="pend-fld">
                <label class="pend-label"><i class="bi bi-calendar-month"></i>MES</label>
                <div class="cf-mes-btns" id="cfMesBtns">
                    @foreach (var m in cfMesesDisp) {
                        <button type="button" class="cf-mes-btn" data-mes="@m">@m</button>
                    }
                    @if (cfHaySf) {
                        <button type="button" class="cf-mes-btn cf-mes-sf" data-mes="_sf">SF</button>
                    }
                </div>
            </div>

            @* Etiqueta (7 colores fijos) — filtro rápido *@
            <div class="pend-fld">
                <label class="pend-label"><i class="bi bi-palette2"></i>Etiqueta</label>
                <select class="pend-ctrl" id="cfEtiqueta" data-cf="colorhexa" style="min-width:115px;">
                    <option value="">Todas</option>
                    <option value="#dc3545">🔴 Etiqueta 1 (#dc3545)</option>
                    <option value="#fd7e14">🟠 Etiqueta 2 (#fd7e14)</option>
                    <option value="#ffc107">🟡 Etiqueta 3 (#ffc107)</option>
                    <option value="#198754">🟢 Etiqueta 4 (#198754)</option>
                    <option value="#0d6efd">🔵 Etiqueta 5 (#0d6efd)</option>
                    <option value="#6f42c1">🟣 Etiqueta 6 (#6f42c1)</option>
                    <option value="#7b4f2e">🟤 Etiqueta 7 (#7b4f2e)</option>
                    <option value="_none">Sin etiqueta</option>
                </select>
            </div>

            <div class="cf-vsep"></div>

            @* 2. AÑO — select, default 2026 *@
            <div class="pend-fld">
                <label class="pend-label"><i class="bi bi-calendar-check"></i>Año</label>
                <select class="pend-ctrl" id="cfAno" data-cf="ano" style="min-width:68px;">
                    <option value="">——</option>
                    @foreach (var y in cfAnosDisp) {
                        <option value="@y" selected="@(y == 2026 ? "selected" : null)">@y</option>
                    }
                </select>
            </div>

            <div class="cf-vsep"></div>

            @* 3. Partida *@
            <div class="pend-fld">
                <label class="pend-label"><i class="bi bi-hash"></i>Partida</label>
                <input type="text" class="pend-ctrl" data-cf="partida" list="dlPartida"
                       placeholder="Buscar…" style="min-width:90px;" autocomplete="off" />
                <datalist id="dlPartida">
                    @foreach (var v in cfPartidaOpts) { <option value="@v"></option> }
                </datalist>
            </div>

            @* 4. Material *@
            <div class="pend-fld">
                <label class="pend-label"><i class="bi bi-box-seam"></i>Material</label>
                <input type="text" class="pend-ctrl" data-cf="material" list="dlMaterial"
                       placeholder="Buscar…" style="min-width:110px;" autocomplete="off" />
                <datalist id="dlMaterial">
                    @foreach (var v in cfMaterialOpts) { <option value="@v"></option> }
                </datalist>
            </div>

            @* 5. Cliente *@
            <div class="pend-fld">
                <label class="pend-label"><i class="bi bi-building"></i>Cliente</label>
                <input type="text" class="pend-ctrl" data-cf="cliente" list="dlCliente"
                       placeholder="Buscar…" style="min-width:120px;" autocomplete="off" />
                <datalist id="dlCliente">
                    @foreach (var v in cfClienteOpts) { <option value="@v"></option> }
                </datalist>
            </div>

            @* 6. Revisado (con/sin fecha revisado) *@
            <div class="pend-fld">
                <label class="pend-label"><i class="bi bi-check2-all"></i>Revisado</label>
                <select class="pend-ctrl" data-cf-ind="revisado" style="min-width:90px;">
                    <option value="">Todos</option>
                    <option value="1">Con revisado</option>
                    <option value="0">Sin revisado</option>
                </select>
            </div>

            @* 7. Procesos *@
            <div class="pend-fld">
                <label class="pend-label"><i class="bi bi-cpu"></i>Proceso</label>
                <select class="pend-ctrl" data-cf="proceso" style="min-width:100px;">
                    <option value="">Todos</option>
                    @foreach (var v in filtroProcesos) { <option value="@v.Descripcion">@v.Descripcion</option> }
                </select>
            </div>

            @* 8. Despachos *@
            <div class="pend-fld">
                <label class="pend-label"><i class="bi bi-truck"></i>Despachos</label>
                <select class="pend-ctrl" data-cf="estdesp" style="min-width:90px;">
                    <option value="">Todos</option>
                    @foreach (var v in cfDespOpts) { <option value="@v">@v</option> }
                </select>
            </div>

            @* --- salto de línea flex --- *@
            <div style="flex-basis:100%;height:0;"></div>

            @* 9. Fecha Entrega *@
            <div class="pend-fld">
                <label class="pend-label"><i class="bi bi-calendar-event"></i>F.Entrega</label>
                <input type="date" class="pend-ctrl" id="cfFchEntDes" data-cf-fch="fchent-des" style="min-width:120px;" title="Desde" />
            </div>
            <div class="pend-fld">
                <label class="pend-label" style="visibility:hidden;">F.Hasta</label>
                <input type="date" class="pend-ctrl" id="cfFchEntHas" data-cf-fch="fchent-has" style="min-width:120px;" title="Hasta" />
            </div>

            @* 10. Est. Flujo — multi-select *@
            <div class="pend-fld">
                <label class="pend-label"><i class="bi bi-activity"></i>Est.Flujo</label>
                <div class="cf-msel-wrap" id="cfFlujoWrap">
                    <button type="button" class="spt-ctrl cf-msel-btn" id="cfFlujoBtn">
                        <span id="cfFlujoBtnTxt">Todos</span>
                        <i class="bi bi-chevron-down" style="font-size:.6rem;opacity:.7;margin-left:.2rem;"></i>
                    </button>
                    <div class="cf-msel-panel" id="cfFlujoPanel" style="display:none;">
                        @foreach (var v in cfFlujoOpts) {
                            <label class="cf-msel-item">
                                <input type="checkbox" class="cf-flujo-chk" value="@v"> @v
                            </label>
                        }
                        <div class="cf-msel-footer">
                            <button type="button" class="cf-msel-clr" id="cfFlujoClr">Limpiar todo</button>
                        </div>
                    </div>
                </div>
            </div>

            @* 11. Ev.Encon — multi-select (mismo patrón que Est.Flujo) *@
            <div class="pend-fld">
                <label class="pend-label"><i class="bi bi-check2-circle"></i>Ev.Encon</label>
                <div class="cf-msel-wrap" id="cfEvEnconWrap">
                    <button type="button" class="spt-ctrl cf-msel-btn" id="cfEvEnconBtn">
                        <span id="cfEvEnconBtnTxt">Todos</span>
                        <i class="bi bi-chevron-down" style="font-size:.6rem;opacity:.7;margin-left:.2rem;"></i>
                    </button>
                    <div class="cf-msel-panel" id="cfEvEnconPanel" style="display:none;">
                        @foreach (var v in cfEvEnconOpts) {
                            <label class="cf-msel-item">
                                <input type="checkbox" class="cf-evencon-chk" value="@v"> @v
                            </label>
                        }
                        <div class="cf-msel-footer">
                            <button type="button" class="cf-msel-clr" id="cfEvEnconClr">Limpiar todo</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="cf-vsep"></div>

            @* Contador + paginación *@
            <span class="cf-count"><span id="cfCount">@items.Count</span> / <span id="cfTotal">@items.Count</span></span>

            @* Exportar Excel *@
            <button type="button" id="btnExportXlsx" title="Exportar los registros filtrados a Excel"
                    style="background:#1d6f3b;color:#fff;border:none;border-radius:.32rem;font-size:.75rem;font-weight:700;
                           padding:.28rem .75rem;cursor:pointer;display:inline-flex;align-items:center;gap:.28rem;
                           box-shadow:0 2px 4px rgba(0,0,0,.15);transition:background .12s,transform .1s;white-space:nowrap;">
                <i class="bi bi-file-earmark-excel"></i> Exportar Excel
            </button>

            <div style="display:flex;align-items:center;gap:.35rem;margin-left:auto;flex-wrap:wrap;">
                <label style="font-size:.68rem;color:#4a6080;font-weight:700;white-space:nowrap;">Filas/pág</label>
                <select id="pgSize" class="pg-size">
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="200" selected>200</option>
                    <option value="500">500</option>
                    <option value="0">Todos</option>
                </select>
                <div class="pg-nums" id="pgNums"></div>
                <button class="pg-btn" id="pgPrev" type="button"><i class="bi bi-chevron-left"></i></button>
                <button class="pg-btn" id="pgNext" type="button"><i class="bi bi-chevron-right"></i></button>
                <span class="pg-info" id="pgInfo"></span>
            </div>
        </div>

        @* ── Panel de acción: colorear seleccionados ── *@
        <div id="stColorBar" class="st-color-bar" style="display:none;">
            <span id="stColorBarCount" class="st-cb-label"></span>
            <button type="button" class="st-cb-btn" id="btnAbrirPaleta">
                <i class="bi bi-palette2"></i> Asignar etiqueta
            </button>
            <button type="button" class="st-cb-btn st-cb-clr" id="btnQuitarColor">
                <i class="bi bi-eraser"></i> Quitar etiqueta
            </button>
            <div id="stPaleta" class="st-paleta" style="display:none;">
                <div class="st-pal-item" data-color="#dc3545" style="background:#dc3545;" title="Etiqueta 1 – #dc3545">Etiqueta 1</div>
                <div class="st-pal-item" data-color="#fd7e14" style="background:#fd7e14;" title="Etiqueta 2 – #fd7e14">Etiqueta 2</div>
                <div class="st-pal-item" data-color="#ffc107" style="background:#ffc107;color:#212529;" title="Etiqueta 3 – #ffc107">Etiqueta 3</div>
                <div class="st-pal-item" data-color="#198754" style="background:#198754;" title="Etiqueta 4 – #198754">Etiqueta 4</div>
                <div class="st-pal-item" data-color="#0d6efd" style="background:#0d6efd;" title="Etiqueta 5 – #0d6efd">Etiqueta 5</div>
                <div class="st-pal-item" data-color="#6f42c1" style="background:#6f42c1;" title="Etiqueta 6 – #6f42c1">Etiqueta 6</div>
                <div class="st-pal-item" data-color="#7b4f2e" style="background:#7b4f2e;" title="Etiqueta 7 – #7b4f2e">Etiqueta 7</div>
            </div>
        </div>

        <div class="spt-outer-wrap">
            @* LEFT: columnas fijas (no scroll horizontal) *@
            <div class="spt-frozen-panel">
                <table id="stTableL">
                    <thead>
                        <tr class="thead-grupos">
                            <th class="col-chk th-fix" rowspan="2" style="padding:0;vertical-align:middle;"><input type="checkbox" id="chkAll" title="Seleccionar todos"></th>
                            <th class="th-grp col-sep" colspan="6" style="text-align:center;">DATOS GENERALES</th>
                        </tr>
                        <tr class="thead-cols">
                            <th class="col-sep fc-5 th-fix">Partida</th>
                            <th class="fc-6 th-fix">Cliente</th>
                            <th class="fc-7 th-fix">Material</th>
                            <th class="fc-8 th-fix">Est</th>
                            <th class="fc-9 th-fix">Lote</th>
                            <th class="fc-10 th-fix">F.Pedido</th>
                        </tr>
                    </thead>
                    <tbody id="stTbodyL"></tbody>
                </table>
            </div>
            @* RIGHT: columnas desplazables *@
            <div class="spt-scroll-panel">
            <table id="stTable">
				<thead>
					@* ── Fila 1: Grupos ──────────────────────────────────────────────────── *@
					<tr class="thead-grupos">
						<th class="fc-1 th-fix" rowspan="2">Mes</th>
						<th class="fc-2 th-fix" rowspan="2">Mes.Tex</th>
						<th class="fc-3 th-fix" rowspan="2">Año</th>
						<th class="fc-4 th-fix" rowspan="2">Sem</th>
						<th class="col-ne th-fix" rowspan="2">Ne</th>
						<th class="col-mat th-fix" rowspan="2">Mat</th>
						<th class="th-grp col-sep" colspan="4">RODETE</th>
						<th class="th-grp col-sep" colspan="3">ENT. MATERIAL HILAND.</th>
						<th class="th-grp col-sep" colspan="3">RECETA</th>
						<th class="th-grp col-sep" colspan="1">PROGRAMA</th>
						<th class="th-grp col-sep" colspan="1">DESPACHO MAT.</th>
						<th class="th-grp col-sep" colspan="5">TENIDO</th>
						<th class="th-grp col-sep" colspan="1">TIPO ACAB.</th>
						<th class="th-grp col-sep" colspan="5">SECADO</th>
						<th class="th-grp col-sep" colspan="3">EVAL. CALIDAD</th>
						<th class="th-grp col-sep" colspan="2">ENCONADO</th>
						<th class="th-grp col-sep" colspan="4">ALMACEN</th>
						<th class="th-grp col-sep" colspan="5">KG.</th>
						<th class="th-grp col-sep" colspan="2">ESTADO</th>
						<th class="th-grp col-sep" colspan="2" style="white-space:nowrap;">
							<button type="button" id="btnGuardarAreaResp" style="background:#f59e0b;color:#1a2c40;border:none;border-radius:.3rem;font-size:.62rem;font-weight:700;padding:.18rem .55rem;cursor:pointer;display:inline-flex;align-items:center;gap:.25rem;letter-spacing:.03em;white-space:nowrap;">
								<i class="bi bi-save"></i> Guardar Área Resp.
							</button>
						</th>
					</tr>
					@* ── Fila 2: Cabeceras individuales ────────────────────────────────── *@
					<tr class="thead-cols">
						<th class="col-sep">Estima.Rod</th>
						<th>Entreg.Rod</th>
						<th>D.Rod</th>
						<th style="text-align:center">X.Rod</th>
						<th class="col-sep">Estima.Mat</th>
