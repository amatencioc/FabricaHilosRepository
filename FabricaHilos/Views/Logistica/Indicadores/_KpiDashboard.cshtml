@model FabricaHilos.Models.Logistica.IndLogisticaDashboardViewModel
@using System.Globalization
@using System.Text.Json

@{
    var culture  = CultureInfo.GetCultureInfo("es-PE");
    string FmtFecha(DateTime? d) => d?.ToString("dd/MM/yyyy") ?? "-";
    string FmtMon(decimal v)    => v.ToString("N2", culture);
    string FmtNum(decimal v, int d = 0) => v.ToString("N" + d, culture);

    string periodo = $"{FmtFecha(Model.FechaDesde)} — {FmtFecha(Model.FechaHasta)}";

    // ── KPI Cards globales ────────────────────────────────────────────────────
    int     totalReqs  = Model.Resumen.Sum(r => r.CantReqs);
    int     totalItems = Model.Resumen.Sum(r => r.CantItems);
    decimal montoTotal = Model.Resumen.Sum(r => r.MontoTotal);
    int     pendItems  = Model.Pendientes.Count;
    decimal montoPend  = Model.Pendientes.Sum(p => p.MontoPendiente);

    // PCT_ATENDIDO: tomar el de la primera fila por TIPO (window → mismo valor por tipo)
    var pctCompra    = Model.Resumen.FirstOrDefault(r => r.Tipo == "COMPRA")?.PctAtendido   ?? 0;
    var pctServicio  = Model.Resumen.FirstOrDefault(r => r.Tipo == "SERVICIO")?.PctAtendido ?? 0;

    // ── JSON para Chart.js ────────────────────────────────────────────────────
    var resumenJson = JsonSerializer.Serialize(Model.Resumen.Select(r => new {
        tipo  = r.Tipo, estado = r.Estado, reqs = r.CantReqs,
        items = r.CantItems, monto = r.MontoTotal, pct = r.PctAtendido
    }));

    var tiemposJson = Model.Tiempos == null ? "null" : JsonSerializer.Serialize(new {
        total = Model.Tiempos.TotalReqs,
        t1    = Model.Tiempos.DiasRegAutorizacion,
        t2    = Model.Tiempos.DiasAutRecibo,
        t3    = Model.Tiempos.DiasReciboOc,
        ciclo = Model.Tiempos.DiasCicloTotal
    });

    // Top CC: diferenciar CC (U) vs Activo Fijo (A) para colorear barras
    var topCcJson = JsonSerializer.Serialize(Model.TopCcosto.Select(c => new {
        desc  = (c.DescDestino ?? c.Destino ?? "-").Length > 32
                    ? (c.DescDestino ?? c.Destino ?? "-")[..32] + "…"
                    : (c.DescDestino ?? c.Destino ?? "-"),
        monto = c.MontoTotal,
        reqs  = c.CantReqs,
        tp    = c.TpDestino   // 'U'=CC, 'A'=AF
    }));

    // Donut TIPO: monto COMPRA vs SERVICIO
    var tipoJson = JsonSerializer.Serialize(new[] {
        new { tipo="COMPRA",   monto = Model.Resumen.Where(r=>r.Tipo=="COMPRA").Sum(r=>r.MontoTotal)   },
        new { tipo="SERVICIO", monto = Model.Resumen.Where(r=>r.Tipo=="SERVICIO").Sum(r=>r.MontoTotal) }
    });
}

<div class="text-center mb-4">
    <h5 class="fw-bold text-uppercase mb-1" style="color:#8B5E3C; font-size:.95rem;">
        KPI Logística — Panel Ejecutivo
    </h5>
    <p class="text-muted mb-0" style="font-size:.8rem;">Periodo: @periodo</p>
</div>

<!-- ── KPI Cards ─────────────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="kpi-card accent-green">
            <div class="kpi-icon">📋</div>
            <div class="kpi-label">Total Requisiciones</div>
            <div class="kpi-value" style="color:#1B4D3E;">@FmtNum(totalReqs)</div>
            <div class="kpi-sub">en el período</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card accent-blue">
            <div class="kpi-icon">📦</div>
            <div class="kpi-label">Total Ítems</div>
            <div class="kpi-value" style="color:#1565C0;">@FmtNum(totalItems)</div>
            <div class="kpi-sub">líneas de requisición</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card accent-orange">
            <div class="kpi-icon">💰</div>
            <div class="kpi-label">Monto Total (S/)</div>
            <div class="kpi-value" style="color:#e65100; font-size:1.5rem;">@FmtMon(montoTotal)</div>
            <div class="kpi-sub">inc. IGV donde aplica</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card accent-purple">
            <div class="kpi-icon">⏳</div>
            <div class="kpi-label">Ítems Pendientes</div>
            <div class="kpi-value" style="color:#4A148C;">@FmtNum(pendItems)</div>
            <div class="kpi-sub">S/ @FmtMon(montoPend) por despachar</div>
        </div>
    </div>
</div>

<!-- ── % Atendido por tipo ────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm p-3 text-center">
            <div style="font-size:.7rem; color:#6b7280; font-weight:700; text-transform:uppercase; letter-spacing:.05em;">
                % Atendido — COMPRA
            </div>
            <div class="fw-bold" style="font-size:2.4rem; color:#1B4D3E;">@FmtNum(pctCompra, 1)%</div>
            <div style="font-size:.72rem; color:#9ca3af;">de reqs no anuladas ya atendidas</div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm p-3 text-center">
            <div style="font-size:.7rem; color:#6b7280; font-weight:700; text-transform:uppercase; letter-spacing:.05em;">
                % Atendido — SERVICIO
            </div>
            <div class="fw-bold" style="font-size:2.4rem; color:#1565C0;">@FmtNum(pctServicio, 1)%</div>
            <div style="font-size:.72rem; color:#9ca3af;">de reqs no anuladas ya atendidas</div>
        </div>
    </div>
</div>

<!-- ── Gráfico: Resumen por estado + Donut tipo ──────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-md-7">
        <div class="card chart-card">
            <div class="card-header small"><i class="bi bi-bar-chart-fill me-1"></i>Requisiciones por Estado y Tipo</div>
            <div class="card-body" style="height:340px;"><canvas id="chartEstados"></canvas></div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card chart-card">
            <div class="card-header small"><i class="bi bi-pie-chart-fill me-1"></i>Monto por Tipo (S/)</div>
            <div class="card-body" style="height:340px;"><canvas id="chartTipo"></canvas></div>
        </div>
    </div>
</div>

<!-- ── Tiempos del ciclo ──────────────────────────────────────────────── -->
@if (Model.Tiempos != null)
{
    <div class="section-title">⏱️ Tiempos Promedio del Ciclo Logístico (@FmtNum(Model.Tiempos.TotalReqs) requisiciones)</div>
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="fs-4 mb-1">📝</div>
                <div style="font-size:.66rem; color:#6b7280; font-weight:700; text-transform:uppercase;">Reg. → Autorización</div>
                <div class="fw-bold fs-5" style="color:#1B4D3E;">@FmtNum(Model.Tiempos.DiasRegAutorizacion,1) d</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="fs-4 mb-1">✅</div>
                <div style="font-size:.66rem; color:#6b7280; font-weight:700; text-transform:uppercase;">Aut. → Recibo Log.</div>
                <div class="fw-bold fs-5" style="color:#1565C0;">@FmtNum(Model.Tiempos.DiasAutRecibo,1) d</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="fs-4 mb-1">🛒</div>
                <div style="font-size:.66rem; color:#6b7280; font-weight:700; text-transform:uppercase;">Recibo Log. → OC</div>
                <div class="fw-bold fs-5" style="color:#e65100;">@FmtNum(Model.Tiempos.DiasReciboOc,1) d</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="fs-4 mb-1">🔄</div>
                <div style="font-size:.66rem; color:#6b7280; font-weight:700; text-transform:uppercase;">Ciclo Total</div>
                <div class="fw-bold fs-5" style="color:#4A148C;">@FmtNum(Model.Tiempos.DiasCicloTotal,1) d</div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="card chart-card">
                <div class="card-header small"><i class="bi bi-bar-chart-steps me-1"></i>Waterfall — Desglose del Ciclo (días promedio) &nbsp; <small class="text-muted fw-normal">Verde ≤5d / Rojo &gt;5d</small></div>
                <div class="card-body" style="height:220px;"><canvas id="chartTiempos"></canvas></div>
            </div>
        </div>
    </div>
}

<!-- ── Top 10 Destinos ───────────────────────────────────────────────── -->
@if (Model.TopCcosto.Any())
{
    <div class="section-title">🏭 Top 10 Destinos por Monto — <small class="fw-normal text-muted">🔵 Centro de Costo &nbsp; 🟤 Activo Fijo</small></div>
    <div class="row g-3 mb-4">
        <div class="col-lg-7">
            <div class="card chart-card">
                <div class="card-header small"><i class="bi bi-bar-chart-horizontal-fill me-1"></i>Monto por Destino (S/)</div>
                <div class="card-body" style="height:360px;"><canvas id="chartTopCcosto"></canvas></div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card chart-card">
                <div class="card-header small"><i class="bi bi-table me-1"></i>Ranking de Destinos</div>
                <div class="card-body p-0" style="max-height:360px; overflow-y:auto;">
                <table class="table table-sm table-hover mb-0" style="font-size:.78rem;">
                    <thead class="table-dark sticky-top">
                        <tr>
                            <th>#</th>
                            <th>Destino</th>
                            <th>T</th>
                            <th class="text-end">Reqs</th>
                            <th class="text-end">Ítems</th>
                            <th class="text-end">Monto (S/)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.TopCcosto.Count; i++)
                        {
                            var t = Model.TopCcosto[i];
                            string tpIcon = t.TpDestino == "A" ? "🟤" : "🔵";
                            <tr>
                                <td class="fw-bold text-muted">@(i+1)</td>
                                <td title="@t.Destino">@(t.DescDestino ?? t.Destino ?? "-")</td>
                                <td>@tpIcon</td>
                                <td class="text-end">@FmtNum(t.CantReqs)</td>
                                <td class="text-end">@FmtNum(t.CantItems)</td>
                                <td class="text-end fw-semibold">@FmtMon(t.MontoTotal)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
    </div>
}

<!-- ── Ítems Pendientes ───────────────────────────────────────────────── -->
@if (Model.Pendientes.Any())
{
    <div class="section-title">
        ⏳ Ítems con Saldo Pendiente
        <small class="fw-normal text-muted ms-2">
            🟢 &lt;3d &nbsp; 🟡 3-7d &nbsp; 🔴 &gt;7d
        </small>
    </div>
    <div class="card chart-card mb-4">
        <div class="card-header small"><i class="bi bi-hourglass-split me-1"></i>Ítems con Saldo Pendiente &nbsp; <small class="fw-normal text-muted">🟢 &lt;3d &nbsp; 🟡 3-7d &nbsp; 🔴 &gt;7d</small></div>
        <div class="card-body p-0" style="max-height:420px; overflow-y:auto;">
            <table class="table table-sm table-hover mb-0" style="font-size:.77rem;">
                <thead class="table-dark sticky-top">
                    <tr>
                        <th>Nro. Req.</th>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Estado</th>
                        <th>Solicita</th>
                        <th>Cód. Art.</th>
                        <th>Artículo</th>
                        <th class="text-end">Saldo</th>
                        <th class="text-end">Mto. Pend. (S/)</th>
                        <th class="text-center">Días Espera</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Pendientes)
                    {
                        // Semáforo del SQL: verde <3d, amarillo 3-7d, rojo >7d
                        string semClass = p.DiasEnEspera < 3  ? "sem-verde"
                                        : p.DiasEnEspera <= 7 ? "sem-amarillo"
                                        : "sem-rojo";
                        string badgeClass = p.DiasEnEspera < 3  ? "bg-success"
                                           : p.DiasEnEspera <= 7 ? "bg-warning text-dark"
                                           : "bg-danger";
                        <tr class="@semClass">
                            <td class="fw-semibold">@p.NumReq</td>
                            <td>@FmtFecha(p.Fecha)</td>
                            <td><span class="badge @(p.Tipo=="SERVICIO" ? "bg-info text-dark" : "bg-secondary")">@p.Tipo</span></td>
                            <td><span class="badge bg-light text-dark border">@(p.Estado ?? "-")</span></td>
                            <td>@(p.Solicita ?? "-")</td>
                            <td>@(p.CodArt ?? "-")</td>
                            <td>@(p.DescArticulo ?? "-")</td>
                            <td class="text-end">@FmtNum(p.Saldo, 2)</td>
                            <td class="text-end fw-semibold">@FmtMon(p.MontoPendiente)</td>
                            <td class="text-center">
                                <span class="badge @badgeClass">@p.DiasEnEspera d</span>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-secondary fw-bold">
                    <tr>
                        <td colspan="7" class="text-end">TOTAL:</td>
                        <td></td>
                        <td class="text-end">S/ @FmtMon(Model.Pendientes.Sum(p => p.MontoPendiente))</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

<!-- ── JSON para Chart.js ─────────────────────────────────────────────── -->
<input type="hidden" id="indLogResumenJson" value='@Html.Raw(resumenJson)' />
<input type="hidden" id="indLogTiemposJson" value='@Html.Raw(tiemposJson)' />
<input type="hidden" id="indLogTopCcJson"   value='@Html.Raw(topCcJson)'   />
<input type="hidden" id="indLogTipoJson"    value='@Html.Raw(tipoJson)'    />

<script>
window.initIndLogisticaCharts = function () {
    const resumen = JSON.parse(document.getElementById('indLogResumenJson').value || '[]');
    const tiempos = JSON.parse(document.getElementById('indLogTiemposJson').value || 'null');
    const topCc   = JSON.parse(document.getElementById('indLogTopCcJson').value   || '[]');
    const tipos   = JSON.parse(document.getElementById('indLogTipoJson').value    || '[]');

    // ── 1. Stacked Bar: Requisiciones por Estado y Tipo ─────────────────
    const estados   = [...new Set(resumen.map(r => r.estado))];
    const tiposU    = [...new Set(resumen.map(r => r.tipo))];
    const colEstado = { 'REGISTRADO':'#6c757dcc','VISADO':'#1565C0cc','RECIBIDO':'#e65100cc',
                        'ATENDIDO':'#1B4D3Ecc','ANULADO':'#c62828cc' };
    const ctxEst = document.getElementById('chartEstados');
    if (ctxEst) {
        const datasets = estados.map(est => ({
            label: est,
            data: tiposU.map(tipo => { const r = resumen.find(x=>x.tipo===tipo&&x.estado===est); return r?r.reqs:0; }),
            backgroundColor: colEstado[est] || '#aaaacc',
            borderColor: (colEstado[est]||'#aaaacc').replace('cc',''),
            borderWidth: 1
        }));
        new Chart(ctxEst, {
                type:'bar', data:{ labels:tiposU, datasets },
                options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{ position:'bottom' }},
                          scales:{ x:{ stacked:true }, y:{ stacked:true, beginAtZero:true, min:0 }}}
            });
    }

    // ── 2. Donut: Monto por TIPO ────────────────────────────────────────
    const ctxTipo = document.getElementById('chartTipo');
    if (ctxTipo) {
        new Chart(ctxTipo, {
            type:'doughnut',
            data:{ labels: tipos.map(t=>t.tipo),
                   datasets:[{ data: tipos.map(t=>t.monto),
                               backgroundColor:['#1B4D3Ecc','#1565C0cc'],
                               borderColor:['#1B4D3E','#1565C0'], borderWidth:2 }]},
            options:{ responsive:true, maintainAspectRatio:false, plugins:{
                legend:{ position:'bottom' },
                tooltip:{ callbacks:{ label: c => ' S/ '+c.parsed.toLocaleString('es-PE',{minimumFractionDigits:2}) }}
            }}
        });
    }

    // ── 3. Waterfall Horizontal: Tiempos ────────────────────────────────
    const ctxTiempos = document.getElementById('chartTiempos');
    if (ctxTiempos && tiempos) {
        // SLA referencial: 5 días por tramo (del comentario del SQL)
        const vals = [tiempos.t1, tiempos.t2, tiempos.t3, tiempos.ciclo];
        const cols = vals.map(v => v <= 5 ? '#1B4D3Ecc' : '#c62828cc');
        new Chart(ctxTiempos, {
            type:'bar',
            data:{ labels:['Reg. → Autorización','Aut. → Recibo Log.','Recibo Log. → OC','Ciclo Total'],
                   datasets:[{ label:'Días promedio', data:vals,
                               backgroundColor:cols,
                               borderColor:cols.map(c=>c.replace('cc','')), borderWidth:1 }]},
            options:{ indexAxis:'y', responsive:true, maintainAspectRatio:false,
                      plugins:{ legend:{ display:false },
                                tooltip:{ callbacks:{ label: c => ` ${c.parsed.x} días` }}},
                      scales:{ x:{ beginAtZero:true, title:{ display:true, text:'Días' }}} }
        });
    }

    // ── 4. Bar Horizontal: Top 10 destinos ─────────────────────────────
    // Colorear diferente CC (azul) vs Activo Fijo (marrón)
    const ctxTop = document.getElementById('chartTopCcosto');
    if (ctxTop && topCc.length) {
        new Chart(ctxTop, {
            type:'bar',
            data:{ labels: topCc.map(x=>x.desc),
                   datasets:[{ label:'Monto (S/)', data: topCc.map(x=>x.monto),
                               backgroundColor: topCc.map(x => x.tp==='A' ? '#8B5E3Ccc' : '#1565C0cc'),
                               borderColor:     topCc.map(x => x.tp==='A' ? '#8B5E3C'   : '#1565C0'),
                               borderWidth:1 }]},
            options:{ indexAxis:'y', responsive:true, maintainAspectRatio:false,
                      plugins:{ legend:{ display:false },
                                tooltip:{ callbacks:{
                                    label: c => ' S/ '+c.parsed.x.toLocaleString('es-PE',{minimumFractionDigits:2}) }}},
                      scales:{ x:{ beginAtZero:true }}}
        });
    }
};

</script>
