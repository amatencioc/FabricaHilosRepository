@model FabricaHilos.Models.Capacitacion.CursoPlayerVm
@{
    ViewData["Title"] = Model.TituloCurso;
    var actual = Model.Actual;
    var curso  = Model.Curso;
}

@section Styles {
<style>
/* ── LMS · Player ────────────────────────────────── */
body { overflow-x:hidden; background:#f0f4f8; }
.player-layout { display:grid; grid-template-columns:300px 1fr; min-height:calc(100vh - 60px); }
.lms-sidebar { overflow-y:auto; height:calc(100vh - 60px); background:#f8fafc; border-right:1px solid #dde3ec; position:sticky; top:60px; }
.lms-lesson-item { padding:.5rem .75rem; border-radius:6px; cursor:pointer; transition:background .1s; display:flex; align-items:center; gap:.5rem; text-decoration:none; color:#334155; margin-bottom:2px; }
.lms-lesson-item:hover { background:rgba(29,78,216,.05); }
.lms-lesson-item.active { background:rgba(29,78,216,.1); color:#1d4ed8; font-weight:600; }
.lms-lesson-item.completed::after { content:'\F26B'; font-family:'bootstrap-icons'; color:#0f766e; float:right; margin-left:auto; }
.lms-lesson-item.locked { opacity:.45; pointer-events:none; }
.content-area { padding:1.75rem 2rem; background:#fff; min-height:calc(100vh - 68px); }
.progress-top { height:3px; background:#e8edf3; }
.progress-top-bar { height:100%; background:linear-gradient(90deg,#1d4ed8,#0284c7); transition:width .3s; }
.video-wrapper { position:relative; padding-bottom:56.25%; height:0; border-radius:10px; overflow:hidden; background:#0f172a; }
.video-wrapper video { position:absolute; top:0; left:0; width:100%; height:100%; }
.pdf-wrapper { width:100%; height:75vh; border:none; border-radius:10px; box-shadow:0 1px 4px rgba(15,23,42,.06); }
@@media (max-width:768px) {
    .player-layout { grid-template-columns:1fr; }
    .lms-sidebar { height:auto; position:relative; }
    .content-area { padding:1.25rem; }
}
.lms-btn { display:inline-flex; align-items:center; gap:.35rem; border-radius:7px; padding:.38rem .9rem; font-size:.82rem; font-weight:500; text-decoration:none; transition:all .12s; cursor:pointer; border:none; }
.lms-btn-primary { background:#1d4ed8; color:#fff; }
.lms-btn-primary:hover { background:#1e40af; color:#fff; }
.lms-btn-teal { background:#0f766e; color:#fff; }
.lms-btn-teal:hover { background:#0d6561; color:#fff; }
.lms-btn-outline { background:#fff; border:1px solid #dde3ec !important; color:#334155; }
.lms-btn-outline:hover { background:#f8fafc; border-color:#94a3b8 !important; color:#0f172a; }
</style>
}

<!-- Barra de progreso superior -->
<div class="progress-top">
    <div class="progress-top-bar" style="width:@Model.PctProgreso%"></div>
</div>

<div class="player-layout">
    <!-- SIDEBAR -->
    <aside class="lms-sidebar p-3">
        <!-- Cabecera -->
        <a asp-controller="Curso" asp-action="Detalle" asp-route-idCurso="@curso.IdCurso"
           class="text-decoration-none text-body">
            <div class="d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-arrow-left"></i>
                <span class="fw-semibold text-truncate small">@curso.Titulo</span>
            </div>
        </a>

        <!-- Progreso -->
        <div class="mb-3 px-1">
            <div class="d-flex justify-content-between mb-1" style="font-size:.7rem;color:#64748b">
                <span>@Model.LeccionesVistas de @Model.TotalLecciones completadas</span>
                <span class="fw-bold" style="color:#1d4ed8">@Model.PctProgreso%</span>
            </div>
            <div style="height:4px;border-radius:4px;background:#e8edf3;overflow:hidden">
                <div style="height:100%;width:@Model.PctProgreso%;background:linear-gradient(90deg,#1d4ed8,#0284c7);border-radius:4px"></div>
            </div>
        </div>

        <!-- Contenidos sin sección -->
        @foreach (var ct in Model.ContenidosSinSeccion)
        {
            var isCurrent = ct.IdContenido == Model.IdContenidoActual;
            var cssClass  = isCurrent ? "active" : (ct.Completado ? "completed" : "");
            if (ct.Bloqueado) cssClass += " locked";
            <a asp-controller="Curso" asp-action="Ver"
               asp-route-idCurso="@Model.IdCurso"
               asp-route-contenido="@ct.IdContenido"
               class="d-flex align-items-center gap-2 lms-lesson-item mb-1 text-decoration-none text-body @cssClass">
                <i class="bi @ct.TipoIcono" style="width:1.3rem;color:var(--lms-primary)"></i>
                <span class="small flex-grow-1 text-truncate">@ct.Titulo</span>
                @if (!string.IsNullOrEmpty(ct.DuracionFormato))
                {
                    <span class="text-muted" style="font-size:.7rem">@ct.DuracionFormato</span>
                }
            </a>
        }

        <!-- Secciones -->
        @foreach (var sec in Model.Secciones)
        {
            <div class="mt-3 mb-2">
                <div class="text-uppercase fw-bold text-muted" style="font-size:.7rem;letter-spacing:.05em">
                    @sec.Titulo
                    @if (sec.EstaCompleta)
                    {
                        <i class="bi bi-check-circle-fill ms-1" style="color:#0f766e"></i>
                    }
                </div>
            </div>
            @foreach (var ct in sec.Contenidos)
            {
                var isCurrent = ct.IdContenido == Model.IdContenidoActual;
                var cssClass  = isCurrent ? "active" : (ct.Completado ? "completed" : "");
                if (ct.Bloqueado) cssClass += " locked";
                <a asp-controller="Curso" asp-action="Ver"
                   asp-route-idCurso="@Model.IdCurso"
                   asp-route-contenido="@ct.IdContenido"
                   class="d-flex align-items-center gap-2 lms-lesson-item mb-1 text-decoration-none text-body @cssClass">
                    <i class="bi @ct.TipoIcono" style="width:1.3rem;color:var(--lms-primary)"></i>
                    <span class="small flex-grow-1 text-truncate">@ct.Titulo</span>
                    @if (!string.IsNullOrEmpty(ct.DuracionFormato))
                    {
                        <span class="text-muted" style="font-size:.7rem">@ct.DuracionFormato</span>
                    }
                </a>
            }
        }

        <!-- Examen final -->
        @if (Model.TieneExamen && Model.IdExamen.HasValue)
        {
            <div class="mt-3 border-top pt-3">
                @if (Model.ExamenFinalAprobado)
                {
                    <div class="lms-lesson-item d-flex align-items-center gap-2" style="color:#0f766e">
                        <i class="bi bi-patch-check-fill"></i>
                        <span class="small fw-semibold">Examen aprobado</span>
                    </div>
                }
                else if (!Model.ExamenFinalBloqueado)
                {
                    <a asp-controller="Examen" asp-action="IniciarExamen"
                       asp-route-idExamen="@Model.IdExamen"
                       asp-route-idInscripcion="@Model.IdInscripcion"
                       class="lms-btn lms-btn-primary w-100">
                        <i class="bi bi-pencil-square"></i> Rendir examen
                    </a>
                }
                else
                {
                    <div class="lms-lesson-item locked d-flex align-items-center gap-2">
                        <i class="bi bi-lock-fill"></i>
                        <span class="small">Completa todas las lecciones para habilitar el examen</span>
                    </div>
                }
            </div>
        }
    </aside>

    <!-- ÁREA DE CONTENIDO -->
    <main class="content-area">
        <h4 class="fw-bold mb-1">@actual.Titulo</h4>
        <div class="text-muted small mb-4">
            <i class="bi @actual.TipoIcono me-1"></i>
            @(actual.Tipo switch { "VID"=>"Video", "PDF"=>"PDF", "TXT"=>"Artículo", "URL"=>"Enlace externo", "ARC"=>"Archivo", _=>"" })
            @if (!string.IsNullOrEmpty(actual.DuracionFormato))
            {
                <span class="ms-2">· @actual.DuracionFormato</span>
            }
        </div>

        @if (actual.Tipo == "VID")
        {
            <div class="video-wrapper mb-4">
                <video id="videoPlayer" controls autoplay
                       data-inscripcion="@Model.IdInscripcion"
                       data-contenido="@actual.IdContenido"
                       data-seg="@actual.SegReproducido">
                    <source src="@Url.Action("ServirMedia","Curso",new{idContenido=actual.IdContenido})"
                            type="@(actual.MimeType ?? "video/mp4")">
                    Tu navegador no soporta video HTML5.
                </video>
            </div>
        }
        else if (actual.Tipo == "PDF")
        {
            <iframe src="@Url.Action("ServirMedia","Curso",new{idContenido=actual.IdContenido})"
                    class="pdf-wrapper mb-4" title="@actual.Titulo"></iframe>
        }
        else if (actual.Tipo == "URL" && !string.IsNullOrEmpty(actual.UrlExterna))
        {
            <div class="lms-card mb-4 p-4 text-center">
                <i class="bi bi-link-45deg mb-2" style="font-size:2.5rem;color:#1d4ed8"></i>
                <p style="font-size:.85rem;color:#64748b">Este contenido está alojado en una URL externa.</p>
                <a href="@actual.UrlExterna" target="_blank" rel="noopener noreferrer"
                   class="lms-btn lms-btn-primary">
                    <i class="bi bi-box-arrow-up-right"></i> Abrir enlace externo
                </a>
            </div>
        }
        else if (actual.Tipo == "TXT" && !string.IsNullOrEmpty(actual.ContenidoHtml))
        {
            <div class="lms-card mb-4 p-4">
                @Html.Raw(actual.ContenidoHtml)
            </div>
        }
        else if (actual.Tipo == "ARC")
        {
            <div class="lms-card mb-4 p-4">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-file-earmark-arrow-down-fill" style="font-size:2rem;color:#1d4ed8"></i>
                    <div>
                        <div class="fw-semibold" style="font-size:.9rem;color:#0f172a">@(actual.NombreArchOri ?? actual.Titulo)</div>
                        @if (!string.IsNullOrEmpty(actual.TamanioFormato))
                        {
                            <div style="font-size:.78rem;color:#64748b">@actual.TamanioFormato</div>
                        }
                    </div>
                    <a href="@Url.Action("ServirMedia","Curso",new{idContenido=actual.IdContenido})"
                       download class="lms-btn lms-btn-primary ms-auto">
                        <i class="bi bi-download"></i> Descargar
                    </a>
                </div>
            </div>
        }

        <!-- Botón completar -->
        @if (!actual.Completado)
        {
            <div class="mb-4">
                <button id="btnCompletar" class="lms-btn lms-btn-teal"
                        data-inscripcion="@Model.IdInscripcion"
                        data-contenido="@actual.IdContenido">
                    <i class="bi bi-check-circle"></i> Marcar como completado
                </button>
            </div>
        }
        else
        {
            <div class="d-inline-flex align-items-center gap-2 mb-4" style="background:#f0fdfa;border:1px solid #99f6e4;border-radius:8px;padding:.55rem 1rem;font-size:.84rem;color:#0f766e">
                <i class="bi bi-check-circle-fill"></i> Completado
            </div>
        }

        <!-- Navegación anterior / siguiente -->
        <div class="d-flex justify-content-between pt-3" style="border-top:1px solid #f1f5f9">
            @if (Model.Anterior != null)
            {
                <a asp-controller="Curso" asp-action="Ver"
                   asp-route-idCurso="@Model.IdCurso"
                   asp-route-contenido="@Model.Anterior.IdContenido"
                   class="lms-btn lms-btn-outline">
                    <i class="bi bi-chevron-left"></i> @Model.Anterior.Titulo
                </a>
            }
            else { <div></div> }

            @if (Model.Siguiente != null)
            {
                <a asp-controller="Curso" asp-action="Ver"
                   asp-route-idCurso="@Model.IdCurso"
                   asp-route-contenido="@Model.Siguiente.IdContenido"
                   class="lms-btn lms-btn-primary">
                    @Model.Siguiente.Titulo <i class="bi bi-chevron-right"></i>
                </a>
            }
        </div>
    </main>
</div>

@section Scripts {
@Html.AntiForgeryToken()
<script>
const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

// Completar lección
const btnCompletar = document.getElementById('btnCompletar');
if (btnCompletar) {
    btnCompletar.addEventListener('click', async function() {
        const { inscripcion, contenido } = this.dataset;
        this.disabled = true;
        this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Guardando...';
        await fetch('@Url.Action("MarcarCompletado","Curso")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
            body: `idInscripcion=${inscripcion}&idContenido=${contenido}&segReproducido=0`
        });
        location.reload();
    });
}

// Auto-completar video al terminar
const video = document.getElementById('videoPlayer');
if (video) {
    const seg = parseInt(video.dataset.seg || '0');
    if (seg > 0) video.currentTime = seg;

    let guardado = false;
    video.addEventListener('ended', async () => {
        if (guardado) return; guardado = true;
        const inscripcion = video.dataset.inscripcion;
        const contenido   = video.dataset.contenido;
        await fetch('@Url.Action("MarcarCompletado","Curso")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
            body: `idInscripcion=${inscripcion}&idContenido=${contenido}&segReproducido=${Math.floor(video.duration)}`
        });
        setTimeout(() => location.reload(), 800);
    });
}
</script>
}
