@model FabricaHilos.Controllers.Contabilidad.SireRegistrosViewModel
@using FabricaHilos.Sire.Models
@{
    ViewData["Title"] = "SIRE - RCE (Registro de Compras)";

    var periodos          = Model?.Periodos           ?? Array.Empty<PropuestaDto>();
    var periodoSeleccionado = Model?.PeriodoSeleccionado ?? string.Empty;
    var registros         = Model?.RegistrosCompras   ?? Array.Empty<RegistroCompra>();
    var esMock            = Model?.EsMock ?? false;
    var resumen           = Model?.PropuestasResumen  ?? new List<FabricaHilos.Models.Sire.PropuestaPeriodoResumen>();
    var propuesta         = Model?.RegistrosPropuesta ?? new List<FabricaHilos.Models.Sire.SireValidaRegistro>();

    var yyyyMm = periodoSeleccionado.Length == 6
        ? $"{periodoSeleccionado[..4]}/{periodoSeleccionado[4..]}"
        : periodoSeleccionado;

    static (string Desc, string Css) TipoComprobante(string cod) => cod switch
    {
        "01" => ("Factura",  "sire-badge sire-badge-rce"),
        "03" => ("Boleta",   "sire-badge sire-badge-info"),
        "07" => ("N/C",      "sire-badge sire-badge-warn"),
        "08" => ("N/D",      "sire-badge sire-badge-warn"),
        "09" => ("G.Rem.",   "sire-badge sire-badge-secondary"),
        _    => (cod,        "sire-badge sire-badge-secondary")
    };
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Contabilidad" asp-action="Index">Contabilidad</a></li>
    <li class="breadcrumb-item"><a asp-controller="Sire" asp-action="Index">SIRE</a></li>
    <li class="breadcrumb-item active">RCE — Compras</li>
}
@section Styles {
<link rel="stylesheet" href="~/css/sire.css" asp-append-version="true" />
}

@* ── Alertas de sesión ─────────────────────────────────────────────────────── *@
@if (esMock)
{
    <div class="sire-alert sire-alert-mock"><i class="bi bi-cone-striped"></i><strong>MODO MOCK</strong> — Datos de prueba. No se realizan llamadas reales a SUNAT.</div>
}
@if (TempData["Error"] is string errMsg)
{
    <div class="sire-alert sire-alert-danger"><i class="bi bi-exclamation-triangle-fill"></i><div>@errMsg</div></div>
}
@if (TempData["Success"] is string okMsg)
{
    <div class="sire-alert sire-alert-success"><i class="bi bi-check-circle-fill"></i><div>@okMsg</div></div>
}

@await Html.PartialAsync("~/Views/Contabilidad/Sire/_SireNavBar.cshtml")

@* ── Cabecera strip ───────────────────────────────────────────────────────── *@
<div class="sire-strip">
    <i class="bi bi-cart3" style="color:var(--sire-rce-mid);font-size:.9rem;flex-shrink:0;"></i>
    <span class="sire-strip-title">RCE — Registro de Compras Electrónico</span>
    @if (!string.IsNullOrWhiteSpace(periodoSeleccionado) && propuesta.Count > 0)
    {
        <span class="sire-strip-sep"></span>
        <span class="sire-kpi"><i class="bi bi-calendar3"></i><span class="sire-kpi-val">@yyyyMm</span></span>
        <span class="sire-kpi"><i class="bi bi-file-earmark-text" style="color:var(--sire-rce-mid);"></i><span class="sire-kpi-val">@propuesta.Count.ToString("N0")</span><span style="opacity:.7">regs.</span></span>
        <span class="sire-kpi"><i class="bi bi-calculator" style="color:#fbd38d;"></i><span class="sire-kpi-val">S/ @propuesta.Sum(x => x.BiGravDg).ToString("N0")</span><span style="opacity:.7">base</span></span>
        <span class="sire-kpi"><i class="bi bi-percent" style="color:#76e4f7;"></i><span class="sire-kpi-val">S/ @propuesta.Sum(x => x.IgvIpmDg).ToString("N0")</span><span style="opacity:.7">IGV</span></span>
        <span class="sire-kpi" style="background:rgba(21,101,192,.3);border-color:rgba(21,101,192,.5);"><i class="bi bi-credit-card" style="color:#90caf9;"></i><span class="sire-kpi-val">S/ @propuesta.Sum(x => x.TotalCp).ToString("N0")</span><span style="opacity:.7">total</span></span>
    }
</div>

@Html.AntiForgeryToken()

@* ── Toolbar ─────────────────────────────────────────────────────────────── *@
<div class="sire-filter">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-calendar3 small" style="color:var(--sire-gray-600);"></i>
        <span class="fw-semibold text-nowrap" style="font-size:.77rem;color:var(--sire-gray-700);">Período:</span>
        <select class="form-select form-select-sm" id="periodoSelect"
                style="width:220px;max-width:100%;" onchange="cambiarPeriodo()">
            <option value="">— seleccionar —</option>
            @foreach (var p in periodos)
            {
                <option value="@p.Periodo" selected="@(p.Periodo == periodoSeleccionado)">
                    @($"{p.Periodo[..4]}/{p.Periodo[4..]}"): @p.Descripcion
                </option>
            }
        </select>
        <button class="btn btn-sm btn-outline-secondary px-2" type="button" onclick="recargarPeriodo()" title="Recargar">
            <i class="bi bi-arrow-clockwise"></i>
        </button>
    </div>
    @if (!string.IsNullOrWhiteSpace(periodoSeleccionado))
    {
        <div class="vr d-none d-lg-block mx-1" style="opacity:.2;"></div>
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="iniciarExportacion('@periodoSeleccionado', 'compras')">
                <i class="bi bi-cloud-download me-1"></i>Exportar Propuesta
            </button>
            @if (Model?.TieneZipLocal == true)
            {
                <button type="button" class="btn btn-sm btn-outline-warning" id="btnReprocesarCompras"
                        data-zip-nombre="@(Model?.NombreZipLocal ?? "")"
                        onclick="abrirModalReprocesar('@periodoSeleccionado', 'compras', this.dataset.zipNombre)"
                        title="Re-parsear ZIP local sin contactar SUNAT">
                    <i class="bi bi-arrow-repeat me-1"></i>Re-procesar ZIP
                </button>
            }
            <div class="vr" style="opacity:.2;"></div>
            <a href="@Url.Action("DescargarConstancia", "Sire", new { periodo = periodoSeleccionado, tipo = "compras", nomArchivo = Model?.NombreArchivoConstancia })"
               class="btn btn-sm btn-outline-danger"
               @(string.IsNullOrWhiteSpace(Model?.NombreArchivoConstancia) ? "title=\"Constancia no disponible: primero Exportar Propuesta (estado COMPLETADO)\"" : "title=\"Descargar constancia SUNAT\"")>
                <i class="bi bi-file-pdf me-1"></i>Constancia
            </a>
            <a asp-action="Monitoreo" asp-route-operacion="EXPORTAR" asp-route-tab="log"
               class="btn btn-sm btn-outline-secondary" title="Log de auditoría HTTP">
                <i class="bi bi-journal-code me-1"></i>Log
            </a>
        </div>
    }
</div>

@* ── Modales ──────────────────────────────────────────────────────────────── *@
<!-- Modal: Re-procesar ZIP local -->
<div class="modal fade" id="modalReprocesarZip" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px">
        <div class="modal-content border-0 shadow">
            <div class="modal-header sire-modal-header-rce py-2">
                <h6 class="modal-title mb-0"><i class="bi bi-arrow-repeat me-2"></i>Re-procesar ZIP local</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="font-size:.86rem;">
                <p class="mb-2 text-muted">Se re-parsea el archivo local y se cargan los registros en Oracle <strong>sin contactar SUNAT</strong>.</p>
                <div class="d-flex align-items-start gap-2 p-2 rounded" style="background:var(--sire-gray-50);border:1px solid var(--sire-gray-200);">
                    <i class="bi bi-file-zip text-warning mt-1" style="font-size:1rem;flex-shrink:0;"></i>
                    <div>
                        <div class="sire-kpi-card-label">Archivo a procesar</div>
                        <div class="font-monospace fw-semibold text-break" id="modalReprocesarNombreZip" style="font-size:.78rem;color:var(--sire-rce);"></div>
                    </div>
                </div>
                <p class="mt-2 mb-0" style="font-size:.77rem;color:var(--sire-gray-600);"><i class="bi bi-info-circle me-1"></i>Los registros anteriores del período serán reemplazados.</p>
            </div>
            <div class="modal-footer py-2 gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-sm btn-warning fw-semibold" id="btnConfirmarReprocesar">
                    <i class="bi bi-arrow-repeat me-1"></i>Sí, re-procesar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Progreso de Exportación -->
<div class="modal fade" id="modalExportacion" tabindex="-1" aria-labelledby="modalExportacionLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header sire-modal-header-rce py-2">
                <h6 class="modal-title" id="modalExportacionLabel">
                    <i class="bi bi-cloud-download me-2"></i>Exportación RCE
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div id="estadoExportacion">
                    <div class="text-center py-3">
                        <div class="spinner-border text-primary mb-3" role="status"><span class="visually-hidden">Cargando...</span></div>
                        <p class="fw-semibold text-muted mb-0">Iniciando exportación…</p>
                    </div>
                </div>
                <div id="logsJobContainer" style="display:none;max-height:160px;overflow-y:auto;font-size:.78rem;border-top:1px solid var(--sire-gray-200);margin-top:.75rem;padding-top:.5rem"></div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" id="btnDescargarZip" class="btn btn-sm btn-primary" style="display:none;"
                        onclick="descargarArchivoExportado('@periodoSeleccionado', 'compras')">
                    <i class="bi bi-download me-1"></i>Descargar ZIP
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Confirmación genérica -->
<div class="modal fade" id="modalConfirmar" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <div class="modal-header py-2" style="background:var(--sire-navy);color:#fff;">
                <h6 class="modal-title" id="modalConfirmarTitulo"><i class="bi bi-question-circle me-1"></i>Confirmar acción</h6>
            </div>
            <div class="modal-body" id="modalConfirmarMensaje" style="font-size:.87rem;"></div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-sm btn-primary" id="btnConfirmarSi">Confirmar</button>
            </div>
        </div>
    </div>
</div>

@* ── Panel: Propuesta Descargada de SUNAT ─────────────────────────────────────────── *@
@if (resumen.Count > 0)
{
    <div class="sire-card mb-3">
        <div class="sire-card-header" style="padding:.35rem .75rem;">
            <i class="bi bi-database-fill-check" style="color:var(--sire-rce);font-size:.82rem;"></i>
            <span style="font-size:.79rem;">Propuesta Descargada de SUNAT</span>
            <span class="ms-auto sire-badge sire-badge-rce" style="font-size:.65rem;">@resumen.Count período(s)</span>
        </div>
        <div class="table-responsive">
            <table class="table sire-table table-hover align-middle mb-0" style="font-size:.78rem;">
                <thead>
                    <tr>
                        <th style="width:75px;padding:.3rem .5rem;">Período</th>
                        <th class="text-end" style="width:62px;padding:.3rem .5rem;">Regs.</th>
                        <th class="text-end d-none d-md-table-cell" style="padding:.3rem .5rem;">Base</th>
                        <th class="text-end d-none d-md-table-cell" style="padding:.3rem .5rem;">IGV</th>
                        <th class="text-end" style="padding:.3rem .5rem;">Total</th>
                        <th class="text-center" style="width:76px;padding:.3rem .5rem;">Concil.</th>
                        <th class="text-center d-none d-lg-table-cell" style="width:86px;padding:.3rem .5rem;">Cargado</th>
                        <th style="width:68px;padding:.3rem .5rem;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in resumen)
                    {
                        var esSel = r.Periodo.ToString() == periodoSeleccionado;
                        <tr @(esSel ? "style=background:var(--sire-rce-pale);" : "")>
                            <td style="padding:.3rem .5rem;">
                                <a href="@Url.Action("Compras")?periodo=@r.Periodo"
                                   class="text-decoration-none fw-semibold"
                                   style="color:@(esSel ? "var(--sire-rce)" : "var(--sire-navy)");">
                                    @r.PeriodoLabel
                                </a>
                            </td>
                            <td class="text-end font-monospace" style="padding:.3rem .5rem;">@r.TotalRegistros.ToString("N0")</td>
                            <td class="text-end d-none d-md-table-cell" style="padding:.3rem .5rem;">@r.TotalBase.ToString("N2")</td>
                            <td class="text-end d-none d-md-table-cell" style="padding:.3rem .5rem;">@r.TotalIgv.ToString("N2")</td>
                            <td class="text-end fw-semibold" style="color:var(--sire-rce);padding:.3rem .5rem;">S/ @r.TotalImporte.ToString("N2")</td>
                            <td class="text-center" style="padding:.3rem .5rem;">
                                <span class="badge @r.ConcilBadgeCss" style="font-size:.6rem;">@r.ConcilLabel</span>
                            </td>
                            <td class="text-center text-muted d-none d-lg-table-cell" style="font-size:.72rem;padding:.3rem .5rem;">
                                @(r.FchCarga?.ToString("dd/MM HH:mm") ?? "—")
                            </td>
                            <td class="text-center" style="padding:.25rem .4rem;">
                                <div class="d-flex gap-1 justify-content-center">
                                    <form method="post" asp-action="ConciliarPropuesta" id="frmConcil_@r.Periodo" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="tipo"    value="compras" />
                                        <input type="hidden" name="periodo" value="@r.Periodo" />
                                        <button type="button" class="btn btn-xs btn-outline-primary"
                                                onclick="confirmarConciliar(@r.Periodo, '@r.PeriodoLabel')"
                                                title="Conciliar contra ERP">
                                            <i class="bi bi-arrow-left-right"></i>
                                        </button>
                                    </form>
                                    <form method="post" asp-action="EliminarPropuesta" id="frmElim_@r.Periodo" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="tipo"    value="compras" />
                                        <input type="hidden" name="periodo" value="@r.Periodo" />
                                        <button type="button" class="btn btn-xs btn-outline-danger"
                                                onclick="confirmarEliminar(@r.Periodo, '@r.PeriodoLabel', @r.TotalRegistros)"
                                                title="Eliminar propuesta">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(periodoSeleccionado))
{
    <div class="sire-alert sire-alert-info">
        <i class="bi bi-info-circle"></i>
        <span>No hay propuesta descargada para <strong>@yyyyMm</strong>. Use <strong>Exportar Propuesta</strong> para obtener los registros desde SUNAT.</span>
    </div>
}

@* ── Panel: Resumen de Conciliación ─────────────────────────────────────── *@
@if (Model?.ConcilResumen != null)
{
    var cr = Model.ConcilResumen;
    <div class="sire-card mb-3">
        <div class="sire-card-header" style="padding:.35rem .75rem;">
            <i class="bi bi-check2-all" style="color:@(cr.TieneProblemas ? "var(--bs-warning)" : "var(--sire-rce)");font-size:.82rem;"></i>
            <span style="font-size:.79rem;">Supervisión de Conciliación</span>
            <span class="text-muted fw-normal ms-1" style="font-size:.72rem;">— @yyyyMm contra ERP Logix</span>
            @if (!cr.TieneProblemas)
            {
                <span class="ms-2 sire-badge sire-badge-ok" style="font-size:.65rem;"><i class="bi bi-check-circle me-1"></i>Sin diferencias</span>
            }
            else
            {
                <span class="ms-2 sire-badge sire-badge-warn" style="font-size:.65rem;"><i class="bi bi-exclamation-triangle me-1"></i>Con observaciones</span>
            }
        </div>
        <div class="px-3 py-2 d-flex gap-3 flex-wrap align-items-start" style="background:var(--sire-gray-50);font-size:.8rem;">
            <div class="d-flex flex-column align-items-center px-3 py-1 rounded"
                 style="border-left:3px solid var(--sire-rce);background:#fff;min-width:90px;">
                <span class="fw-bold" style="font-size:1.25rem;color:var(--sire-rce);">@cr.TotalOk.ToString("N0")</span>
                <span class="text-muted" style="font-size:.68rem;">Coinciden</span>
            </div>
            <div class="d-flex flex-column align-items-center px-3 py-1 rounded"
                 style="border-left:3px solid var(--bs-warning);background:#fff;min-width:90px;">
                <span class="fw-bold" style="font-size:1.25rem;color:#b45309;">@cr.TotalDifer.ToString("N0")</span>
                <span class="text-muted" style="font-size:.68rem;">Con diferencia</span>
            </div>
            <div class="d-flex flex-column align-items-center px-3 py-1 rounded"
                 style="border-left:3px solid var(--bs-danger);background:#fff;min-width:90px;">
                <span class="fw-bold" style="font-size:1.25rem;color:var(--bs-danger);">@cr.TotalSoloSunat.ToString("N0")</span>
                <span class="text-muted" style="font-size:.68rem;">Solo SUNAT</span>
            </div>
            <div class="d-flex flex-column align-items-center px-3 py-1 rounded"
                 style="border-left:3px solid var(--bs-info);background:#fff;min-width:90px;">
                <span class="fw-bold" style="font-size:1.25rem;color:var(--bs-info);">@cr.TotalSoloLeg.ToString("N0")</span>
                <span class="text-muted" style="font-size:.68rem;">Solo Legacy</span>
            </div>
            @if (cr.DiffTotal != 0)
            {
                <div class="d-flex flex-column align-items-center px-3 py-1 rounded"
                     style="border-left:3px solid var(--bs-danger);background:#fff;min-width:110px;">
                    <span class="fw-bold" style="font-size:1.1rem;color:var(--bs-danger);">S/ @cr.DiffTotal.ToString("N2")</span>
                    <span class="text-muted" style="font-size:.68rem;">Diferencia neta</span>
                </div>
            }
            <div class="ms-auto d-flex flex-column align-items-center px-3 py-1 rounded"
                 style="border-left:3px solid var(--sire-gray-300);background:#fff;min-width:80px;">
                <span class="fw-bold" style="font-size:1.25rem;color:var(--sire-navy);">@cr.PctOk.ToString("N1")%</span>
                <span class="text-muted" style="font-size:.68rem;">% OK</span>
            </div>
        </div>
        @if (cr.TieneProblemas)
        {
            <div class="px-3 pb-2 pt-1" style="font-size:.76rem;color:var(--sire-gray-700);">
                <i class="bi bi-info-circle me-1" style="color:var(--bs-warning);"></i>
                Los registros con diferencia o solo en SUNAT aparecen marcados en la tabla de detalle de abajo.
                Use el filtro <strong>Diferencia</strong> y <strong>Solo SUNAT</strong> para focalizarlos.
            </div>
        }
    </div>
}

@* ── Detalle: registros del período seleccionado ─────────────────────────── *@
@if (propuesta.Count > 0)
{
    <div class="sire-card">
        <div class="sire-card-header">
            <i class="bi bi-table" style="color:var(--sire-rce);"></i>
            <span>Propuesta SUNAT</span>
            <span class="text-muted fw-normal" style="font-size:.76rem;margin-left:.25rem;">— @yyyyMm</span>
            <div class="d-none d-lg-flex align-items-center gap-1" id="filtroConcilBtns">
                <button class="btn btn-xs btn-outline-secondary active" onclick="filtrarConcil(null,this)" title="Todos"><i class="bi bi-list"></i></button>
                <button class="btn btn-xs btn-outline-success" onclick="filtrarConcil('1',this)" title="Coinciden OK"><i class="bi bi-check-circle"></i></button>
                <button class="btn btn-xs btn-outline-warning" onclick="filtrarConcil('2',this)" title="Con diferencia"><i class="bi bi-exclamation-circle"></i></button>
                <button class="btn btn-xs btn-outline-danger" onclick="filtrarConcil('3',this)" title="Solo SUNAT"><i class="bi bi-cloud"></i></button>
                <button class="btn btn-xs btn-outline-info" onclick="filtrarConcil('4',this)" title="Solo Legacy"><i class="bi bi-hdd"></i></button>
            </div>
            <div class="ms-auto d-flex align-items-center gap-2">
                <div class="input-group input-group-sm" style="width:220px;">
                    <span class="input-group-text border-0" style="background:var(--sire-gray-100);padding:.2rem .4rem;">
                        <i class="bi bi-search" style="font-size:.75rem;color:var(--sire-gray-600);"></i>
                    </span>
                    <input type="text" class="form-control border-0 shadow-none" style="background:var(--sire-gray-100);font-size:.78rem;"
                           placeholder="Filtrar RUC, N°, nombre…" oninput="filtrarTablaPropuesta(this.value)">
                </div>
                <span class="sire-badge sire-badge-rce" id="contadorFilasPropuesta">@propuesta.Count regs.</span>
            </div>
        </div>
        <div class="table-responsive" style="max-height:460px;overflow-y:auto;">
            <table class="table sire-table table-hover align-middle mb-0" id="tablaPropuestaDetalle">
                <thead style="position:sticky;top:0;z-index:1;">
                    <tr>
                        <th style="width:48px">Tipo</th>
                        <th style="width:62px">Serie</th>
                        <th style="width:100px">Número</th>
                        <th style="width:82px">Emisión</th>
                        <th style="width:96px">RUC</th>
                        <th>Proveedor</th>
                        <th class="text-end" style="width:88px">Base</th>
                        <th class="text-end" style="width:76px">IGV</th>
                        <th class="text-end" style="width:88px">Total</th>
                        <th style="width:50px" class="text-center">Est.</th>
                        <th style="width:56px" class="text-center">Concil.</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in propuesta)
                    {
                        var tc = TipoComprobante(r.Tipdoc ?? "");
                        <tr data-concil='@(r.ConcilEstado ?? "0")'>
                            <td><span class="@tc.Css" style="font-size:.68rem;">@tc.Desc</span></td>
                            <td class="font-monospace">@(r.Serie ?? "—")</td>
                            <td class="font-monospace">@(r.Numero ?? "—")</td>
                            <td class="text-muted text-nowrap">@(r.FEmision?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="font-monospace">@(r.Ruc ?? "—")</td>
                            <td style="max-width:190px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="@r.Nombre">@(r.Nombre ?? "—")</td>
                            <td class="text-end">@r.BiGravDg.ToString("N2")</td>
                            <td class="text-end">@r.IgvIpmDg.ToString("N2")</td>
                            <td class="text-end fw-semibold" style="color:var(--sire-rce);">@r.TotalCp.ToString("N2")</td>
                            <td class="text-center"><span class="badge @r.EstCompBadge" style="font-size:.62rem;">@r.EstCompLabel</span></td>
                            <td class="text-center"><span class="badge @r.ConcilBadge" style="font-size:.62rem;" title="@(r.ConcilDiffs ?? r.ConcilLabel)">@r.ConcilLabel</span></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="6" class="text-end fw-semibold" style="font-size:.75rem;color:var(--sire-gray-600);">TOTALES</td>
                        <td class="text-end fw-bold">@propuesta.Sum(x => x.BiGravDg).ToString("N2")</td>
                        <td class="text-end fw-bold">@propuesta.Sum(x => x.IgvIpmDg).ToString("N2")</td>
                        <td class="text-end fw-bold" style="color:var(--sire-rce);">@propuesta.Sum(x => x.TotalCp).ToString("N2")</td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

<script>
    function confirmarConciliar(periodo, periodoLabel) {
        confirmarAccion(
            `¿Conciliar la propuesta ${periodoLabel} contra el ERP (Logix)? Esto actualizará SIRE_LEGACY y SIRE_CONCIL.`,
            () => document.getElementById('frmConcil_' + periodo).submit()
        );
    }
    function confirmarEliminar(periodo, periodoLabel, nroReg) {
        confirmarAccion(
            `¿Eliminar la propuesta ${periodoLabel}? Se borrarán ${nroReg} registros de SIRE_PROPUESTA.`,
            () => document.getElementById('frmElim_' + periodo).submit()
        );
    }
    function cambiarPeriodo() {
        const periodo = document.getElementById('periodoSelect').value;
        window.location.href = '@Url.Action("Compras", new { })' + (periodo ? '?periodo=' + periodo : '?periodo=');
    }

    function recargarPeriodo() {
        location.reload();
    }

    // ── Control de polling activo ─────────────────────────────────────────────
    // Solo un poll puede estar activo a la vez. Al iniciar nuevo job o cancelar,
    // se cambia _pollingJobId y el loop anterior se auto-detiene.
    let _pollingJobId = null;

    // ── Modal de confirmación (reemplaza confirm() nativo) ────────────────────
    function confirmarAccion(mensaje, callbackSi) {
        document.getElementById('modalConfirmarMensaje').textContent = mensaje;
        const btn = document.getElementById('btnConfirmarSi');
        const clone = btn.cloneNode(true); // elimina listeners previos
        btn.parentNode.replaceChild(clone, btn);
        clone.addEventListener('click', () => {
            bootstrap.Modal.getInstance(document.getElementById('modalConfirmar'))?.hide();
            callbackSi();
        });
        new bootstrap.Modal(document.getElementById('modalConfirmar')).show();
    }

    // Si venimos del Index con un job a reconectar, abrimos el modal automáticamente
    document.addEventListener('DOMContentLoaded', () => {
        if (sessionStorage.getItem('sireReconectar') === '1') {
            sessionStorage.removeItem('sireReconectar');
            const jobId  = sessionStorage.getItem('sireJobId');
            const period = sessionStorage.getItem('periodoExportacion');
            const tipo   = sessionStorage.getItem('tipoExportacion');
            if (jobId && period && tipo === 'compras') {
                _pollingJobId = jobId;
                const modal = new bootstrap.Modal(document.getElementById('modalExportacion'));
                modal.show();
                actualizarModalExportacion('EnProceso', 'Reconectando al proceso en curso…', jobId, 0);
                consultarEstadoJob(jobId, period, tipo);
            }
        }
    });

    // Inicia la exportación en segundo plano (BackgroundService) y muestra modal de progreso
    // ── Modal re-procesar ZIP local ──────────────────────────────────────────
    let _reprocesarPeriodo = null, _reprocesarTipo = null, _reprocesarBtnOrig = null, _reprocesarBtnEl = null;
    function abrirModalReprocesar(periodo, tipo, nombreZip) {
        _reprocesarPeriodo = periodo; _reprocesarTipo = tipo;
        document.getElementById('modalReprocesarNombreZip').textContent = nombreZip || '(desconocido)';
        const btnConf = document.getElementById('btnConfirmarReprocesar');
        const clone = btnConf.cloneNode(true);
        btnConf.parentNode.replaceChild(clone, btnConf);
        clone.addEventListener('click', () => {
            bootstrap.Modal.getInstance(document.getElementById('modalReprocesarZip'))?.hide();
            ejecutarReprocesarZip(periodo, tipo);
        });
        new bootstrap.Modal(document.getElementById('modalReprocesarZip')).show();
    }
    async function ejecutarReprocesarZip(periodo, tipo) {
        const btnId = tipo === 'ventas' ? 'btnReprocesarVentas' : 'btnReprocesarCompras';
        const btn = document.getElementById(btnId);
        if (btn) { _reprocesarBtnEl = btn; _reprocesarBtnOrig = btn.innerHTML; btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Procesando...'; }
        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            const resp = await fetch('@Url.Action("ReprocesarZipLocal", "Sire")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({ tipo, periodo })
            });
            const data = await resp.json();
            if (data.exitoso) {
                mostrarToastSire(`✓ ${data.insertados} registros cargados desde ${data.archivoUsado}.`, 'success');
                setTimeout(() => location.reload(), 1800);
            } else {
                mostrarToastSire(`Error: ${data.error ?? 'Ver log del servidor'}`, 'danger');
                if (_reprocesarBtnEl) { _reprocesarBtnEl.disabled = false; _reprocesarBtnEl.innerHTML = _reprocesarBtnOrig; }
            }
        } catch (e) {
            mostrarToastSire('Error de red: ' + e.message, 'danger');
            if (_reprocesarBtnEl) { _reprocesarBtnEl.disabled = false; _reprocesarBtnEl.innerHTML = _reprocesarBtnOrig; }
        }
    }
    function mostrarToastSire(msg, tipo) {
        let cont = document.getElementById('sireToastContainer');
        if (!cont) {
            cont = document.createElement('div');
            cont.id = 'sireToastContainer';
            cont.style.cssText = 'position:fixed;bottom:1.2rem;right:1.2rem;z-index:9999;display:flex;flex-direction:column;gap:.5rem;';
            document.body.appendChild(cont);
        }
        const t = document.createElement('div');
        t.className = `alert alert-${tipo} shadow py-2 px-3 mb-0`;
        t.style.cssText = 'font-size:.85rem;min-width:260px;animation:fadeInUp .25s ease;';
        t.textContent = msg;
        cont.appendChild(t);
        setTimeout(() => t.remove(), 4000);
    }
    let _concilFilter = null;
    function filtrarConcil(estado, btn) {
        _concilFilter = estado;
        document.querySelectorAll('#filtroConcilBtns button').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');
        filtrarTablaPropuesta(document.querySelector('#tablaPropuestaDetalle')?.closest('.sire-card')?.querySelector('input[type=text]')?.value ?? '');
    }
    function filtrarTablaPropuesta(q) {
        q = (q || '').toLowerCase();
        const filas = document.querySelectorAll('#tablaPropuestaDetalle tbody tr');
        let vis = 0;
        filas.forEach(tr => {
            const textOk = !q || tr.textContent.toLowerCase().includes(q);
            const concilOk = !_concilFilter || tr.dataset.concil === _concilFilter;
            const mostrar = textOk && concilOk;
            tr.style.display = mostrar ? '' : 'none';
            if (mostrar) vis++;
        });
        const cnt = document.getElementById('contadorFilasPropuesta');
        if (cnt) cnt.textContent = vis + ' filas';
    }

    async function iniciarExportacion(periodo, tipo) {
        const modal = new bootstrap.Modal(document.getElementById('modalExportacion'));
        modal.show();

        document.getElementById('estadoExportacion').innerHTML = `
            <div class="text-center">
                <div class="spinner-border text-primary mb-3" role="status"><span class="visually-hidden">Cargando...</span></div>
                <p class="fw-semibold">Verificando si existe proceso previo…</p>
            </div>`;
        document.getElementById('btnDescargarZip').style.display = 'none';

        try {
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';

            const response = await fetch('@Url.Action("IniciarExportacion", "Sire")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ periodo, tipo })
            });

            const result = await response.json();

            // ── Job activo detectado (mismo período o período diferente) ──────────
            if (result.bloqueadoPorOtro || (result.yaExiste && result.mismoPeriodo)) {
                mostrarModalProcesoActivo(result, periodo, tipo);
                return;
            }

            if (!result.exitoso) {
                mostrarErrorExportacion(result.error || result.mensaje);
                return;
            }

            sessionStorage.setItem('sireJobId', result.jobId);
            sessionStorage.setItem('periodoExportacion', periodo);
            sessionStorage.setItem('tipoExportacion', tipo);

            // Registrar el job activo ANTES de iniciar el poll
            _pollingJobId = result.jobId;
            actualizarModalExportacion('Pendiente', 'Solicitud enviada. El proceso corre en segundo plano…', result.jobId, 0);
            consultarEstadoJob(result.jobId, periodo, tipo);
        }
        catch (error) {
            mostrarErrorExportacion('Error al iniciar exportación: ' + error.message);
        }
    }

    // Polling ligero contra EstadoExportacion (solo lee Oracle, no llama a SUNAT)
    async function consultarEstadoJob(jobId, periodo, tipo, intentos = 0) {
        // Si _pollingJobId cambió (cancel o nuevo job), este loop ya no es el activo
        if (jobId !== _pollingJobId) return;

        const maxIntentos = 1440;
        const intervalo   = 5000;
        const segundosTranscurridos = Math.round((intentos * intervalo) / 1000);

        if (intentos >= maxIntentos) {
            mostrarErrorExportacion('Tiempo de espera agotado. El proceso sigue corriendo en el servidor; recargue la página más tarde.');
            return;
        }

        try {
            const response = await fetch(
                `@Url.Action("EstadoExportacion", "Sire")?jobId=${encodeURIComponent(jobId)}`,
                { method: 'GET' }
            );

            const result = await response.json();

            if (!result.exitoso) {
                mostrarErrorExportacion(result.error || 'Error al consultar estado del job.');
                return;
            }

            const estado = result.estado || 'EnProceso';
            actualizarModalExportacion(estado, estadoAMensaje(estado, result), jobId, segundosTranscurridos);

            // Actualizar ticket en sesión para que reconexión lo muestre
            if (result.numTicket) sessionStorage.setItem('sireNumTicket', result.numTicket);

            // Cargar logs del job cada 3 intentos (cada 15s)
            if (intentos % 3 === 0) cargarLogsJob(jobId);

            if (result.esFinal === true) {
                await cargarLogsJob(jobId);  // logs finales
                if (result.estado === 'Error') {
                    if (result.puedeReintentar) {
                        mostrarErrorConReintentar(result.mensajeError || 'El proceso terminó con error.', jobId, periodo, tipo);
                    } else {
                        mostrarErrorConCancel(result.mensajeError || 'El proceso terminó con error.', jobId, periodo, tipo);
                    }
                } else {
                    sessionStorage.setItem('sireJobIdCompletado', jobId);
                    mostrarExitoExportacion(
                        `Propuesta lista. ${result.registrosInsertados ?? 0} registros cargados en Oracle.`,
                        result.rutaArchivo, result.nombreArchivo
                    );
                }
                sessionStorage.removeItem('sireJobId');
                return;
            }

            // Job huérfano: lleva más de 2 min en Pendiente sin log = se perdió del Channel
            if (result.posibleHuerfano) {
                mostrarAvisoHuerfano(result.minutosParado, jobId, periodo, tipo);
                return; // detener polling, el watchdog del worker lo recuperará en ~2 min
            }

            // Advertencia si lleva mucho tiempo sin avanzar
            if (result.minutosParado > 10 && (estado === 'Pendiente' || estado === 'EnProceso')) {
                mostrarAdvertenciaParado(estado, result.minutosParado, result.fechaCreacion, jobId, periodo, tipo, result.numTicket);
            } else if (estado === 'EsperandoTicket') {
                // EsperandoTicket: WatcherWorker lo retoma a las ProximaConsulta.
                // No tiene sentido seguir preguntando cada 5s; el usuario ve la hora de próxima consulta.
                actualizarModalExportacion('EsperandoTicket', estadoAMensaje('EsperandoTicket', result), jobId, segundosTranscurridos);
                return; // detener polling — el Watcher avisará cuando retome
            }

            setTimeout(() => consultarEstadoJob(jobId, periodo, tipo, intentos + 1), intervalo);
        }
        catch (error) {
            mostrarErrorExportacion('Error al consultar estado: ' + error.message);
        }
    }

    // Carga y renderiza los logs de SIRE_LOG para el job actual
    async function cargarLogsJob(jobId) {
        try {
            const resp = await fetch(`@Url.Action("LogsJob", "Sire")?jobId=${encodeURIComponent(jobId)}`);
            const data = await resp.json();
            if (!data.exitoso || !data.logs?.length) return;

            const cont = document.getElementById('logsJobContainer');
            if (!cont) return;
            cont.style.display = 'block';

            const etiquetas = {
                AUTH:      { icon: '🔑', label: 'Autenticación con SUNAT' },
                INICIAR:   { icon: '▶️',  label: 'Job iniciado' },
                EXPORTAR:  { icon: '📤', label: 'Exportación solicitada a SUNAT' },
                TICKET:    { icon: '🔄', label: 'Verificando respuesta de SUNAT' },
                DESCARGAR: { icon: '⬇️', label: 'Descargando archivo' },
                GUARDAR:   { icon: '💾', label: 'Guardando archivo' },
                CARGAR:    { icon: '📥', label: 'Cargando registros al sistema' },
                COMPLETAR: { icon: '✅', label: 'Proceso completado' },
                CANCEL:    { icon: '🚫', label: 'Cancelado' },
                ERROR:     { icon: '❌', label: 'Error' },
            };
            cont.innerHTML = `<div class="fw-semibold mb-1 text-muted" style="font-size:.75rem">ACTIVIDAD RECIENTE</div>` +
                data.logs.map(l => {
                    const e = etiquetas[l.operacion] || { icon: l.exito ? '✅' : '❌', label: l.operacion };
                    const css = l.exito ? 'text-success-emphasis' : 'text-danger-emphasis';
                    const hora = l.fecha.slice(11, 19);
                    const durHtml = l.duracionMs > 0
                        ? `<span class="badge bg-secondary ms-1" style="font-size:.65rem;font-weight:400">${l.duracionMs}ms</span>` : '';
                    const httpHtml = l.httpStatus
                        ? `<span class="badge ms-1" style="font-size:.65rem;font-weight:400;background:#6c757d">${l.metodo || ''} ${l.httpStatus}</span>` : '';
                    const msgHtml = l.mensaje
                        ? `<div class="text-muted" style="font-size:.78rem;word-break:break-word">${l.mensaje}</div>` : '';
                    return `<div class="d-flex gap-2 border-bottom py-1 align-items-start small">
                        <span>${e.icon}</span>
                        <div style="flex:1">
                            <span class="${css} fw-semibold">${e.label}</span>${durHtml}${httpHtml}
                            ${msgHtml}
                        </div>
                        <span class="text-muted text-nowrap" style="font-size:.75rem">${hora}</span>
                    </div>`;
                }).join('');
        } catch { /* silencioso */ }
    }

    function estadoAMensaje(estado, result) {
        if (estado === 'Pendiente') {
            if (result.bloqueadorTipo) {
                const tipo = result.bloqueadorTipo === 'ventas' ? 'ventas' : 'compras';
                return `Su solicitud está en cola. Hay un proceso de <strong>${tipo} ${result.bloqueadorPeriodo}</strong> en ejecución. Se iniciará automáticamente al finalizar.`;
            }
            return 'Su solicitud fue recibida. El servidor la procesará en breve…';
        }
        if (estado === 'EnProceso') return 'Procesando en SUNAT. Esto puede tomar algunos minutos…';
        if (estado === 'EsperandoTicket') {
            const prox = result.proximaConsulta
                ? ` Próxima consulta automática: <strong>${result.proximaConsulta}</strong>.`
                : '';
            return `SUNAT está generando el archivo. El sistema consultará automáticamente cada 15 min.${prox}`;
        }
        if (estado === 'Completado') return `Proceso completado. ${result.registrosInsertados ?? 0} registros cargados.`;
        if (estado === 'Error') return result.mensajeError || 'Ocurrió un error en el proceso.';
        return 'Procesando…';
    }

    function actualizarModalExportacion(estado, mensaje, ref, segundos = 0) {
        const estadoDiv = document.getElementById('estadoExportacion');
        const badgeColor = estado === 'EnProceso' ? 'info'
            : estado === 'EsperandoTicket' ? 'warning'
            : estado === 'Completado' ? 'success'
            : estado === 'Error' ? 'danger' : 'secondary';
        const spinner = (estado === 'EnProceso' || estado === 'Pendiente' || estado === 'EsperandoTicket')
            ? `<span class="spinner-border spinner-border-sm me-1" style="width:.7rem;height:.7rem;"></span>` : '';
        const estadoLabel = {
            Pendiente: 'En cola',
            EnProceso: 'En proceso',
            EsperandoTicket: '⏳ Esperando SUNAT',
            Completado: 'Completado',
            Error: 'Error'
        }[estado] || estado;
        const tiempoTexto = segundos > 30
            ? `<small class="text-muted d-block mt-2">⏱ ${segundos}s esperando</small>` : '';

        estadoDiv.innerHTML = `
            <div class="text-center">
                <div class="mb-2"><span class="badge bg-${badgeColor} text-dark p-2" style="font-size:.9rem;">${spinner}${estadoLabel}</span></div>
                <p class="mb-1" style="font-size:.9rem;">${mensaje}</p>${tiempoTexto}
            </div>`;
    }

    // Bloqueado porque hay un job activo de OTRO período para el mismo tipo
    // Muestra los 3 botones dentro del modalExportacion cuando se detecta un job activo.
    // Cubre ambos casos: mismo período (yaExiste) o período diferente (bloqueadoPorOtro).
    function mostrarModalProcesoActivo(result, periodo, tipo) {
        const estadoDiv  = document.getElementById('estadoExportacion');
        const logsCont   = document.getElementById('logsJobContainer');
        if (logsCont) { logsCont.innerHTML = ''; logsCont.style.display = 'none'; }
        document.getElementById('btnDescargarZip').style.display = 'none';

        const jobId         = result.jobId;
        const periodoActivo = result.periodoActivo || periodo;
        const esDiferente   = result.bloqueadoPorOtro === true;
        const mins          = result.minutosParado || 0;
        const estadoLabel   = { Pendiente:'En cola', EnProceso:'En proceso', EsperandoTicket:'⏳ Esperando SUNAT' }[result.estado] || result.estado || '—';

        const alertMsg = esDiferente
            ? `<strong>No se puede iniciar:</strong> hay un proceso de <strong>RCE</strong> activo para el período <strong>${periodoActivo}</strong>.`
            : `<strong>Ya existe un proceso activo</strong> para el período <strong>${periodoActivo}</strong>. No se inició uno nuevo.`;

        const ticketFila  = result.numTicket
            ? `<tr><td class="text-muted small py-1">Ticket SUNAT</td><td class="small py-1"><code>${result.numTicket}</code></td></tr>` : '';
        const proximaFila = result.proximaConsulta
            ? `<tr><td class="text-muted small py-1">Próx. consulta</td><td class="small py-1 fw-semibold">${result.proximaConsulta}</td></tr>` : '';
        const minFila = result.estado !== 'EsperandoTicket'
            ? `<tr><td class="text-muted small py-1">Sin avanzar</td><td class="small py-1 ${mins > 30 ? 'text-danger fw-bold' : ''}">${mins} min</td></tr>` : '';

        estadoDiv.innerHTML = `
            <div class="alert ${esDiferente ? 'alert-danger' : 'alert-warning'} py-2 mb-3" style="font-size:.84rem">
                <i class="bi bi-activity me-1"></i>${alertMsg}
            </div>
            <table class="table table-sm table-borderless mb-3" style="font-size:.83rem">
                <tr><td class="text-muted small py-1">Estado actual</td>
                    <td class="py-1"><span class="badge bg-warning text-dark">${estadoLabel}</span></td></tr>
                <tr><td class="text-muted small py-1">Iniciado</td>
                    <td class="small py-1">${result.fechaCreacion || '—'}</td></tr>
                ${minFila}${ticketFila}${proximaFila}
            </table>
            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <button class="btn btn-outline-secondary btn-sm" onclick="cancelarJobSolo('${jobId}')">
                    <i class="bi bi-x me-1"></i>Solo Cancelar
                </button>
                <button class="btn btn-danger btn-sm" onclick="cancelarJob('${jobId}','${periodoActivo}','${tipo}')">
                    <i class="bi bi-x-circle me-1"></i>Cancelar y Reiniciar
                </button>
                <button class="btn btn-primary btn-sm" onclick="verProcesoActivoEnModal('${jobId}','${periodoActivo}','${tipo}')">
                    <i class="bi bi-eye me-1"></i>Ver Proceso Activo
                </button>
            </div>`;
    }

    // Ver Proceso Activo: carga logs y activa polling dentro del mismo modalExportacion
    function verProcesoActivoEnModal(jobId, periodo, tipo) {
        _pollingJobId = jobId;
        sessionStorage.setItem('sireJobId', jobId);
        sessionStorage.setItem('periodoExportacion', periodo);
        sessionStorage.setItem('tipoExportacion', tipo);
        const logsCont = document.getElementById('logsJobContainer');
        if (logsCont) { logsCont.innerHTML = ''; logsCont.style.display = 'none'; }
        actualizarModalExportacion('EnProceso', 'Conectando al proceso activo…', jobId, 0);
        cargarLogsJob(jobId);
        consultarEstadoJob(jobId, periodo, tipo);
    }

    function mostrarBloqueadoPorOtro(result, tipo) {
        const estadoDiv = document.getElementById('estadoExportacion');
        const mins = result.minutosParado || 0;
        const ticketFila = result.numTicket
            ? `<tr><td class="text-muted">Ticket SUNAT</td><td><code>${result.numTicket}</code></td></tr>`
            : '';
        estadoDiv.innerHTML = `
            <div class="alert alert-danger py-2 mb-2 text-start" style="font-size:.85rem">
                <i class="bi bi-lock-fill me-1"></i>
                <strong>No se puede iniciar: ya hay un proceso de ${tipo} activo</strong>
            </div>
            <table class="table table-sm table-borderless mb-2" style="font-size:.82rem">
                <tr><td class="text-muted">Período activo</td><td><strong>${result.periodoActivo}</strong></td></tr>
                <tr><td class="text-muted">Estado</td><td><span class="badge bg-warning text-dark">${result.estado}</span></td></tr>
                <tr><td class="text-muted">Iniciado</td><td>${result.fechaCreacion}</td></tr>
                <tr><td class="text-muted">Sin avanzar</td><td class="${mins > 30 ? 'text-danger fw-bold' : ''}">${mins} min</td></tr>
                ${ticketFila}
            </table>
            <p class="small text-muted">Solo puede haber <strong>un proceso de ${tipo}</strong> activo a la vez.
               Espere que termine o cancélelo para iniciar uno nuevo.</p>
            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <button class="btn btn-sm btn-info" onclick="verProcesoActivo('${result.jobId}', '${result.periodoActivo}', '${tipo}')">
                    <i class="bi bi-eye me-1"></i>Ir al proceso activo
                </button>
                <button class="btn btn-sm btn-danger" onclick="cancelarJob('${result.jobId}', '${result.periodoActivo}', '${tipo}')">
                    <i class="bi bi-x-circle me-1"></i>Cancelar y reiniciar
                </button>
                <button class="btn btn-sm btn-outline-secondary" onclick="cancelarJobSolo('${result.jobId}')">
                    <i class="bi bi-x me-1"></i>Solo cancelar
                </button>
            </div>`;
        // Ocultar logs hasta que el usuario haga clic en "Ir al proceso activo"
        const logsCont = document.getElementById('logsJobContainer');
        if (logsCont) logsCont.style.display = 'none';
    }

    // Ir al proceso activo: limpia el modal de bloqueo y muestra el progreso real con logs
    function verProcesoActivo(jobId, periodo, tipo) {
        _pollingJobId = jobId;
        sessionStorage.setItem('sireJobId', jobId);
        sessionStorage.setItem('periodoExportacion', periodo);
        sessionStorage.setItem('tipoExportacion', tipo);
        // Limpiar panel de logs antes de la transición
        const logsCont = document.getElementById('logsJobContainer');
        if (logsCont) { logsCont.innerHTML = ''; logsCont.style.display = 'none'; }
        // Mostrar estado de carga y lanzar polling
        actualizarModalExportacion('EnProceso', 'Conectando al proceso activo…', jobId, 0);
        cargarLogsJob(jobId);
        consultarEstadoJob(jobId, periodo, tipo);
    }

    function mostrarInfoReconexion(estado, fechaCreacion, minutos, jobId, periodo, tipo, extraHtml = '') {
        const estadoDiv = document.getElementById('estadoExportacion');
        const esViejo = minutos > 30;
        const estadoLabel = { Pendiente: 'En cola', EnProceso: 'En proceso' }[estado] || estado;
        estadoDiv.innerHTML = `
            <div class="alert alert-warning py-2 mb-2 text-start" style="font-size:.85rem">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                <strong>Hay un proceso activo para este período</strong> — No se inició uno nuevo.
            </div>
            <table class="table table-sm table-borderless mb-2" style="font-size:.85rem">
                <tr><td class="text-muted">Estado</td><td><span class="badge bg-warning text-dark">${estadoLabel}</span></td></tr>
                <tr><td class="text-muted">Iniciado</td><td>${fechaCreacion}</td></tr>
                <tr><td class="text-muted fw-semibold">Sin avanzar</td><td class="${esViejo ? 'text-danger fw-bold' : ''}">${minutos} min</td></tr>
            </table>
            ${esViejo ? `
            <div class="alert alert-danger py-2 mb-2" style="font-size:.82rem">
                <i class="bi bi-clock-history me-1"></i>
                Este proceso lleva <strong>${minutos} minutos</strong> sin avanzar. Puede cancelarlo y reiniciar.
            </div>
            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <button class="btn btn-sm btn-danger" onclick="cancelarJob('${jobId}','${periodo}','${tipo}')">
                    <i class="bi bi-x-circle me-1"></i>Cancelar y reiniciar
                </button>
                <button class="btn btn-sm btn-outline-secondary" onclick="cancelarJobSolo('${jobId}')">
                    <i class="bi bi-x me-1"></i>Solo cancelar
                </button>
            </div>` : ''}`;
        cargarLogsJob(jobId);
    }

    function mostrarAdvertenciaParado(estado, minutos, fechaCreacion, jobId, periodo, tipo, ticket) {
        const estadoDiv = document.getElementById('estadoExportacion');
        const estadoLabel = estado === 'Pendiente' ? 'En cola' : 'En proceso';
        estadoDiv.innerHTML = `
            <div class="alert alert-warning py-2 mb-2" style="font-size:.85rem">
                <i class="bi bi-clock-history me-1"></i>
                <strong>${estadoLabel}</strong> — Sin avanzar por <strong>${minutos} min</strong>
            </div>
            <p class="small text-center text-muted mb-2">El servidor está procesando. Si no avanza, puede cancelar y reiniciar.</p>
            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <button class="btn btn-sm btn-danger" onclick="cancelarJob('${jobId}','${periodo}','${tipo}')">
                    <i class="bi bi-x-circle me-1"></i>Cancelar y reiniciar
                </button>
                <button class="btn btn-sm btn-outline-secondary" onclick="cancelarJobSolo('${jobId}')">
                    <i class="bi bi-x me-1"></i>Solo cancelar
                </button>
            </div>`;
        cargarLogsJob(jobId);
    }

    function mostrarAvisoHuerfano(minutos, jobId, periodo, tipo) {
        const estadoDiv = document.getElementById('estadoExportacion');
        estadoDiv.innerHTML = `<div class="text-center">
            <div class="mb-2"><i class="bi bi-exclamation-triangle-fill fs-1 text-warning"></i></div>
            <p class="fw-semibold text-warning">Job en cola sin procesar</p>
            <p class="small text-muted mb-3">El proceso lleva <strong>${minutos} min</strong> en cola sin iniciar.
            Esto ocurre cuando el servidor se reinició después de crear el job.<br>
            El sistema lo recuperará automáticamente en los próximos 2 minutos.</p>
            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <button class="btn btn-sm btn-warning" onclick="forzarReencolar('${jobId}','${periodo}','${tipo}')">
                    <i class="bi bi-arrow-clockwise me-1"></i>Reencolar ahora
                </button>
                <button class="btn btn-sm btn-outline-secondary" onclick="cancelarJobSolo('${jobId}')">
                    <i class="bi bi-x me-1"></i>Cancelar
                </button>
            </div>
        </div>`;
    }

    async function forzarReencolar(jobId, periodo, tipo) {
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : '';
        try {
            const resp = await fetch('@Url.Action("ReencolarJobHuerfano", "Sire")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(jobId)
            });
            const data = await resp.json();
            if (data.exitoso) {
                _pollingJobId = jobId;
                actualizarModalExportacion('Pendiente', 'Job reencolado. El servidor lo procesará en breve…', jobId, 0);
                consultarEstadoJob(jobId, periodo, tipo);
            } else {
                mostrarErrorExportacion(data.error || 'No se pudo reencolar.');
            }
        } catch (e) { mostrarErrorExportacion('Error al reencolar: ' + e.message); }
    }

    function mostrarExitoExportacion(mensaje, rutaArchivo, nombreArchivo) {
        const estadoDiv = document.getElementById('estadoExportacion');
        const btnDescargar = document.getElementById('btnDescargarZip');
        const infoArchivo = rutaArchivo
            ? `<small class="text-muted d-block mt-1"><i class="bi bi-folder2"></i> ${rutaArchivo}</small>` : '';
        estadoDiv.innerHTML = `
            <div class="text-center">
                <div class="mb-3"><i class="bi bi-check-circle fs-1" style="color: #27ae60;"></i></div>
                <p class="fw-semibold text-success">${mensaje}</p>${infoArchivo}
            </div>`;
        // Mostrar botón ZIP solo si el archivo NO fue guardado en servidor
        btnDescargar.style.display = rutaArchivo ? 'none' : '';
    }

    function mostrarErrorExportacion(error) {
        const estadoDiv = document.getElementById('estadoExportacion');
        document.getElementById('btnDescargarZip').style.display = 'none';
        estadoDiv.innerHTML = `
            <div class="text-center">
                <div class="mb-3"><i class="bi bi-exclamation-circle fs-1" style="color: #e74c3c;"></i></div>
                <p class="fw-semibold text-danger">Error en la exportación</p>
                <small class="text-muted">${error}</small>
            </div>`;
    }

    function mostrarErrorConCancel(error, jobId, periodo, tipo) {
        const estadoDiv = document.getElementById('estadoExportacion');
        document.getElementById('btnDescargarZip').style.display = 'none';
        estadoDiv.innerHTML = `
            <div class="text-center">
                <div class="mb-2"><i class="bi bi-exclamation-circle fs-1 text-danger"></i></div>
                <p class="fw-semibold text-danger mb-1">Error</p>
                <small class="text-muted d-block mb-3">${error}</small>
                <div class="d-flex gap-2 justify-content-center flex-wrap">
                    <button class="btn btn-sm btn-danger" onclick="cancelarJob('${jobId}','${periodo}','${tipo}')">
                        <i class="bi bi-x-circle me-1"></i>Cancelar y reiniciar
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" onclick="cancelarJobSolo('${jobId}')">
                        <i class="bi bi-x me-1"></i>Solo cancelar
                    </button>
                </div>
            </div>`;
        cargarLogsJob(jobId);
    }

    function mostrarErrorConReintentar(error, jobId, periodo, tipo) {
        const estadoDiv = document.getElementById('estadoExportacion');
        document.getElementById('btnDescargarZip').style.display = 'none';
        estadoDiv.innerHTML = `
            <div class="text-center">
                <div class="mb-2"><i class="bi bi-exclamation-circle fs-1 text-danger"></i></div>
                <p class="fw-semibold text-danger">Error transitorio (SUNAT 504)</p>
                <small class="text-muted d-block mb-3">${error}</small>
                <div class="d-flex gap-2 justify-content-center">
                    <button class="btn btn-sm btn-warning" onclick="reintentarJob('${jobId}','${periodo}','${tipo}')">
                        <i class="bi bi-arrow-clockwise me-1"></i>Reintentar polling
                    </button>
                    <button class="btn btn-sm btn-danger" onclick="cancelarJob('${jobId}','${periodo}','${tipo}')">
                        <i class="bi bi-x-circle me-1"></i>Cancelar y reiniciar
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" onclick="cancelarJobSolo('${jobId}')">
                        <i class="bi bi-x me-1"></i>Solo cancelar
                    </button>
                </div>
            </div>`;
        cargarLogsJob(jobId);
    }

    // Cancela el job actual y lanza uno nuevo
    async function cancelarJob(jobId, periodo, tipo) {
        confirmarAccion(
            '¿Cancelar este proceso? Podrá iniciar una nueva exportación para el mismo período.',
            async () => {
                // Detener el poll activo inmediatamente
                _pollingJobId = null;

                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : '';
                try {
                    const resp = await fetch('@Url.Action("CancelarJob", "Sire")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                        body: JSON.stringify(jobId)
                    });
                    const data = await resp.json();
                    if (data.exitoso) {
                        sessionStorage.removeItem('sireJobId');
                        bootstrap.Modal.getInstance(document.getElementById('modalExportacion'))?.hide();
                        // Iniciar nueva exportación tras breve pausa
                        setTimeout(() => iniciarExportacion(periodo, tipo), 400);
                    } else {
                        mostrarErrorExportacion(data.error || 'No se pudo cancelar.');
                    }
                } catch (e) { mostrarErrorExportacion('Error al cancelar: ' + e.message); }
            }
        );
    }

    // Cancela el job sin iniciar una nueva exportación
    async function cancelarJobSolo(jobId) {
        confirmarAccion(
            '¿Cancelar este proceso? No se iniciará una nueva exportación automáticamente.',
            async () => {
                _pollingJobId = null;
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : '';
                try {
                    const resp = await fetch('@Url.Action("CancelarJob", "Sire")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                        body: JSON.stringify(jobId)
                    });
                    const data = await resp.json();
                    if (data.exitoso) {
                        sessionStorage.removeItem('sireJobId');
                        bootstrap.Modal.getInstance(document.getElementById('modalExportacion'))?.hide();
                    } else {
                        mostrarErrorExportacion(data.error || 'No se pudo cancelar.');
                    }
                } catch (e) { mostrarErrorExportacion('Error al cancelar: ' + e.message); }
            }
        );
    }

    async function reintentarJob(jobId, periodo, tipo) {
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : '';
        try {
            const response = await fetch('@Url.Action("ReintentarJob", "Sire")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(jobId)
            });
            const result = await response.json();
            if (!result.exitoso) { mostrarErrorExportacion(result.error || 'No se pudo reencolar.'); return; }
            actualizarModalExportacion('EnProceso', `Job reencolado. ${result.mensaje}`, jobId, 0);
            consultarEstadoJob(jobId, periodo, tipo);
        } catch (error) { mostrarErrorExportacion('Error al reintentar: ' + error.message); }
    }

    async function descargarArchivoExportado(periodo, tipo) {
        const ruc = '@(Model?.Ruc ?? "")';
        const codLibro = tipo === 'compras' ? '080000' : '140000';
        const nomArchivo = `PP${ruc}${periodo}${codLibro}001111110.ZIP`;
        window.location.href = `@Url.Action("DescargarArchivoExportado", "Sire")?periodo=${encodeURIComponent(periodo)}&tipo=${encodeURIComponent(tipo)}&nomArchivo=${encodeURIComponent(nomArchivo)}`;
    }
</script>
