@model IReadOnlyList<FabricaHilos.Controllers.Contabilidad.SirePeriodoDashboardItem>
@{
    ViewData["Title"] = "SIRE - Sistema de Llevado de Libros Electrónicos";

    string BadgeEstado(string estado) => estado switch
    {
        "PROPUESTA_DISPONIBLE" => "bg-warning text-dark",
        "CERRADO"              => "bg-success",
        "EN_PROCESO"           => "bg-info text-dark",
        "SIN_INFORMACION"      => "bg-secondary",
        "-"                    => "bg-light text-muted border",
        _                      => "bg-secondary"
    };

    string LabelEstado(string estado) => estado switch
    {
        "PROPUESTA_DISPONIBLE" => "Propuesta disponible",
        "CERRADO"              => "Cerrado",
        "EN_PROCESO"           => "En proceso",
        "SIN_INFORMACION"      => "Sin información",
        "-"                    => "—",
        _                      => estado
    };

    int rvieDisponibles = Model.Count(x => x.EstadoRvie == "PROPUESTA_DISPONIBLE");
    int rvieEnProceso   = Model.Count(x => x.EstadoRvie == "EN_PROCESO");
    int rvieCerrados    = Model.Count(x => x.EstadoRvie == "CERRADO");
    int rceDisponibles  = Model.Count(x => x.EstadoRce  == "PROPUESTA_DISPONIBLE");
    int rceEnProceso    = Model.Count(x => x.EstadoRce  == "EN_PROCESO");
    int rceCerrados     = Model.Count(x => x.EstadoRce  == "CERRADO");
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Contabilidad" asp-action="Index">Contabilidad</a></li>
    <li class="breadcrumb-item active">SIRE</li>
}

@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@err
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@ok
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (ViewBag.EsMock == true)
{
    <div class="alert alert-warning d-flex align-items-center gap-2 py-2 mb-3" role="alert">
        <i class="bi bi-cone-striped fs-5"></i>
        <span><strong>MODO MOCK ACTIVO</strong> — Los datos mostrados son de prueba. No se realizan llamadas reales a SUNAT.</span>
    </div>
}

<div class="d-flex align-items-center gap-2 mb-4">
    <div class="bg-primary rounded-3 p-2 d-flex align-items-center justify-content-center" style="width:48px;height:48px">
        <i class="bi bi-journal-text fs-4 text-white"></i>
    </div>
    <div>
        <h4 class="mb-0 fw-semibold">SIRE</h4>
        <small class="text-muted">Sistema de Llevado de Libros Electrónicos — SUNAT</small>
    </div>
    <a asp-action="Diagnostico" class="btn btn-outline-secondary btn-sm ms-auto">
        <i class="bi bi-plug me-1"></i>Diagnóstico de conexión
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100" style="border-left:4px solid var(--bs-primary) !important">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center" style="width:56px;height:56px;flex-shrink:0">
                    <i class="bi bi-receipt-cutoff fs-3 text-primary"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="fw-semibold mb-1">RVIE — Registro de Ventas e Ingresos</div>
                    <div class="text-muted small mb-2">Consulta y gestión de propuestas de ventas electrónicas.</div>
                    <a asp-controller="Sire" asp-action="Ventas" class="btn btn-primary btn-sm">
                        <i class="bi bi-arrow-right-circle me-1"></i>Acceder a RVIE
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100" style="border-left:4px solid var(--bs-success) !important">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center" style="width:56px;height:56px;flex-shrink:0">
                    <i class="bi bi-cart-check fs-3 text-success"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="fw-semibold mb-1">RCE — Registro de Compras y Gastos</div>
                    <div class="text-muted small mb-2">Consulta y gestión de propuestas de compras electrónicas.</div>
                    <a asp-controller="Sire" asp-action="Compras" class="btn btn-success btn-sm">
                        <i class="bi bi-arrow-right-circle me-1"></i>Acceder a RCE
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-light d-flex align-items-center gap-2">
        <i class="bi bi-bar-chart text-secondary"></i>
        <strong>Resumen de estado</strong>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-6 col-md-3">
                <div class="card border-0 bg-warning bg-opacity-10 text-center py-3">
                    <div class="display-6 fw-bold text-warning">@rvieDisponibles</div>
                    <div class="small text-muted">RVIE con propuesta</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 bg-info bg-opacity-10 text-center py-3">
                    <div class="display-6 fw-bold text-info">@rvieEnProceso</div>
                    <div class="small text-muted">RVIE en proceso</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 bg-warning bg-opacity-10 text-center py-3">
                    <div class="display-6 fw-bold text-warning">@rceDisponibles</div>
                    <div class="small text-muted">RCE con propuesta</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 bg-info bg-opacity-10 text-center py-3">
                    <div class="display-6 fw-bold text-info">@rceEnProceso</div>
                    <div class="small text-muted">RCE en proceso</div>
                </div>
            </div>
        </div>
        <div class="row g-3 mt-1">
            <div class="col-6 col-md-3 offset-md-3">
                <div class="card border-0 bg-success bg-opacity-10 text-center py-2">
                    <div class="fw-bold text-success fs-5">@rvieCerrados</div>
                    <div class="small text-muted">RVIE cerrados</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 bg-success bg-opacity-10 text-center py-2">
                    <div class="fw-bold text-success fs-5">@rceCerrados</div>
                    <div class="small text-muted">RCE cerrados</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-light d-flex align-items-center gap-2">
        <i class="bi bi-calendar3 text-secondary"></i>
        <strong>Estado de periodos</strong>
        <span class="badge bg-secondary ms-auto">@Model.Count periodo(s)</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:120px">Periodo</th>
                        <th>Descripción</th>
                        <th class="text-center" style="width:200px">Estado RVIE</th>
                        <th class="text-center" style="width:200px">Estado RCE</th>
                        <th class="text-center" style="width:120px">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            Sin periodos disponibles. Verifique la conexión con SUNAT.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        var periodo = item.Periodo;
                        var yyyyMm = periodo.Length == 6 ? $"{periodo[..4]}/{periodo[4..]}" : periodo;
                        <tr>
                            <td><span class="fw-semibold">@yyyyMm</span></td>
                            <td>@item.Descripcion</td>
                            <td class="text-center">
                                <span class="badge @BadgeEstado(item.EstadoRvie)">@LabelEstado(item.EstadoRvie)</span>
                            </td>
                            <td class="text-center">
                                <span class="badge @BadgeEstado(item.EstadoRce)">@LabelEstado(item.EstadoRce)</span>
                            </td>
                            <td class="text-center">
                                <a asp-controller="Sire" asp-action="Ventas" asp-route-periodo="@periodo" class="btn btn-outline-primary btn-sm" title="Ver RVIE">
                                    <i class="bi bi-receipt"></i>
                                </a>
                                <a asp-controller="Sire" asp-action="Compras" asp-route-periodo="@periodo" class="btn btn-outline-success btn-sm" title="Ver RCE">
                                    <i class="bi bi-cart3"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
