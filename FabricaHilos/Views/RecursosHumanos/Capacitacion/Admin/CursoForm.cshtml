                            <input type="number" name="orden" class="form-control" id="editOrden" value="1" min="1">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Duración (seg)</label>
                            <input type="number" name="duracionSeg" class="form-control" id="editDuracion" value="0" min="0">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Obligatorio</label>
                            <select name="obligatorio" class="form-select" id="editObligatorio">
                                <option value="S">Sí</option>
                                <option value="N">No (opcional)</option>
                            </select>
                        </div>

                        <!-- Campo archivo -->
                        <div class="col-12" id="editFieldArchivo">
                            <label class="form-label">Archivo (dejar vacío para mantener el actual)</label>
                            <input type="file" name="archivo" class="form-control"
                                   accept=".mp4,.webm,.pdf,.pptx,.ppt,.docx,.doc,.xlsx,.xls,.zip,.rar">
                            <div class="form-text">Máx 500 MB para video, 50 MB para documentos.</div>
                        </div>

                        <!-- Campo URL -->
                        <div class="col-12 d-none" id="editFieldUrl">
                            <label class="form-label">URL externa</label>
                            <input type="url" name="urlExterna" class="form-control" id="editUrlExterna"
                                   placeholder="https://...">
                        </div>

                        <!-- Campo HTML -->
                        <div class="col-12 d-none" id="editFieldHtml">
                            <label class="form-label">Contenido HTML</label>
                            <textarea name="contenidoHtml" class="form-control" rows="6" id="editContenidoHtml"
                                      placeholder="<p>Contenido del artículo...</p>"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="border-top:1px solid #f1f5f9">
                    <button type="button" class="lms-btn lms-btn-outline" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="lms-btn lms-btn-primary" onclick="actualizarContenido()">
                        <i class="bi bi-check-lg"></i> Actualizar contenido
                    </button>
                </div>
