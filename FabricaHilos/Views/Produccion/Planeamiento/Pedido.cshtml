                                                <div><span class="tt-lbl">Guía (Partida)</span><span class="tt-val tt-mono">@rev.Guia</span></div>
                                                <div>
                                                  <span class="tt-lbl">Máq. Procedencia</span>
                                                  <span class="badge bg-secondary" style="font-size:.62rem;">@rev.MaqProced</span>
                                                </div>
                                                <div><span class="tt-lbl">F/Registro</span><span class="tt-val tt-mono">@rev.FchRegistro.ToString("dd/MM/yy HH:mm")</span></div>
                                                @if (rev.FchFinRevisa.HasValue)
                                                {
                                                  <div><span class="tt-lbl">F/Fin Revisado</span><span class="tt-val tt-mono">@rev.FchFinRevisa.Value.ToString("dd/MM/yy")</span></div>
                                                }
                                              </div>
                                              @if (rev.Detalle.Count > 0)
                                              {
                                                <table class="table table-sm tt-table mb-0">
                                                  <thead>
                                                    <tr>
                                                      <th>Ítem</th>
                                                      <th>Fecha</th>
                                                      <th>Revisador</th>
                                                      <th>Turno</th>
                                                      <th class="text-end">Aprobado</th>
                                                      <th class="text-end">Rechazado</th>
                                                      <th class="text-end">Faltante</th>
                                                      <th class="text-end">Merma</th>
                                                      <th>Observación</th>
                                                    </tr>
                                                  </thead>
                                                  <tbody>
                                                    @foreach (var d in rev.Detalle)
                                                    {
                                                      <tr>
                                                        <td>@d.Item</td>
                                                        <td class="tt-mono">@d.Fecha.ToString("dd/MM/yy")</td>
                                                        <td>@d.Revisador</td>
                                                        <td>@d.Turno</td>
                                                        <td class="text-end text-success fw-semibold">@d.Aprobado.ToString("N0")</td>
                                                        <td class="text-end @(d.Rechazado > 0 ? "text-danger" : "")">@d.Rechazado.ToString("N0")</td>
                                                        <td class="text-end @(d.Faltante > 0 ? "text-warning" : "")">@d.Faltante.ToString("N0")</td>
                                                        <td class="text-end @(d.Merma > 0 ? "text-secondary" : "")">@d.Merma.ToString("N0")</td>
                                                        <td class="text-muted">@(d.Observacion ?? "—")</td>
                                                      </tr>
                                                    }
                                                  </tbody>
                                                </table>
                                              }
                                            </div>
                                          }
                                        </div>
                                      </div>
                                    </div>
                                  }

