        '<td class="col-sep" style="white-space:nowrap;">'+d(r.fchSecRod)+'</td>' +
        '<td style="white-space:nowrap;">'+(r.fchSecMad ? d(r.fchSecMad) : (r.acabado==='MADEJA'?'<span class="eb eb-proc" title="Secado madeja pendiente">MAD</span>':'\u2014'))+'</td>' +
