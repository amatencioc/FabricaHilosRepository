@{
    ViewData["Title"] = "Autorización de Horas — Acceso Aquarius";
    var loginError = TempData["LoginError"]?.ToString();
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a href="/RecursosHumanos">Recursos Humanos</a></li>
    <li class="breadcrumb-item active">Autorización de Horas</li>
}

<h4 class="section-title">
    <i class="bi bi-pencil-square me-2"></i>Autorización de Horas Extras
</h4>

<div class="row justify-content-center mt-4">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-header text-white py-3" style="background: linear-gradient(135deg,#C0622B 0%,#9E4D20 100%);">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-database-lock fs-4"></i>
                    <div>
                        <div class="fw-bold fs-6 lh-1">AQUARIUS</div>
                        <div class="small opacity-75 lh-1">Sistema de Recursos Humanos</div>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <p class="text-muted small mb-3">
                    <i class="bi bi-info-circle me-1"></i>
                    Ingrese su usuario de <strong>Aquarius</strong> para acceder al módulo de autorización de horas extras.
                </p>

                @if (!string.IsNullOrEmpty(loginError))
                {
                    <div class="alert alert-danger py-2">
                        <i class="bi bi-exclamation-triangle me-1"></i>@loginError
                    </div>
                }

                <form method="post" action="/RecursosHumanos/Aquarius/AuthHoras/Login">
                    @Html.AntiForgeryToken()
                    <div class="mb-4">
                        <label class="form-label fw-semibold small">Usuario Aquarius</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input name="CodUsuario" type="text" class="form-control"
                                   placeholder="Código de usuario" autocomplete="username" required autofocus
                                   oninput="this.value=this.value.toLowerCase()" />
                        </div>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn text-white fw-semibold" style="background:#C0622B;border-color:#C0622B;">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Ingresar a Aquarius
                        </button>
                    </div>
                </form>
            </div>
        </div>
        <div class="text-center mt-3">
            <a href="/RecursosHumanos" class="text-muted small">
                <i class="bi bi-arrow-left me-1"></i>Volver a Recursos Humanos
            </a>
        </div>
    </div>
</div>
