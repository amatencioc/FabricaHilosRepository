                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                            <div class="input-group mb-2 opcion-row">
                                <div class="input-group-text">
                                    <input type="checkbox" class="form-check-input opc-correcta" title="Marcar como correcta">
                                </div>
                                <input type="text" class="form-control opc-texto" placeholder="Texto de la opción...">
                                <button class="btn btn-outline-danger btn-sm" type="button" onclick="this.closest('.opcion-row').remove()">
                                    <i class="bi bi-x"></i>
                                </button>
