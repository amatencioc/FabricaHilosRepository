@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act  = ViewContext.RouteData.Values["action"]?.ToString()     ?? "";
}

<nav class="sire-navbar af mb-3" aria-label="Navegacion Activos Fijos" style="overflow-x:auto;-webkit-overflow-scrolling:touch;">
    <ul class="sire-navbar-list flex-nowrap">
        <li class="sire-navbar-item @(act == "Index" ? "active" : "")">
            <a asp-controller="ActivoFijo" asp-action="Index" class="sire-navbar-link">
                <i class="bi bi-buildings"></i> <span class="d-none d-sm-inline">Listado</span>
            </a>
        </li>
        <li class="sire-navbar-item @(act is "Editar" ? "active" : "")">
            <span class="sire-navbar-link" style="opacity:.45; cursor:default;">
                <i class="bi bi-pencil-square"></i> <span class="d-none d-sm-inline">Editar</span>
            </span>
        </li>
        <li class="sire-navbar-item @(act == "Ficha" ? "active" : "")">
            <span class="sire-navbar-link" style="opacity:.45; cursor:default;">
                <i class="bi bi-file-earmark-text"></i> <span class="d-none d-sm-inline">Ficha</span>
            </span>
        </li>
    </ul>
    <a asp-controller="Contabilidad" asp-action="Index"
       class="sire-navbar-link ms-auto flex-shrink-0" style="opacity:.7;" title="Volver a Contabilidad">
        <i class="bi bi-arrow-left-circle"></i>
    </a>
</nav>
