                                            @maq.FchEntregaComp.Value.ToString("dd/MM/yy")
                                        </span>
                                        @if (maq.DiasRetraso > 0)
                                        { <span class="badge bg-danger ms-1" style="font-size:.58rem;">+@maq.DiasRetraso d</span> }
                                    </div>
                                }
                                @if (maq.Kg > 0)
                                {
                                    <div class="tt-row mt-1">
                                        <span class="tt-lbl">Kg</span>
                                        <span class="fw-semibold">@maq.Kg.ToString("N1") kg</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="tt-libre-msg"><i class="bi bi-check-circle me-1"></i>Disponible</div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-light border text-muted small py-2">
            <i class="bi bi-info-circle me-1"></i>No se encontraron secadoras en el catálogo (T_MAQUINAS TIPO_MAQ='S').
        </div>
    }
</div>@*/ tab-sec *@

@*═══════════════════════════════════════════════════════════════════ TAB: OTRAS MÁQUINAS *@
<div class="tab-pane fade pln-tab-panel" id="tab-otras" role="tabpanel" aria-labelledby="tab-otras-btn">

    <p class="text-muted small mb-3">
        <i class="bi bi-info-circle me-1"></i>
