@model IEnumerable<FabricaHilos.Models.Produccion.Planeamiento.PlnFechaEstimada>

@{
    ViewData["Title"] = "Historial de Recálculos";
    var idSeguim = ViewBag.IdSeguim;
}

@section Styles {
<link rel="stylesheet" href="~/css/planeamiento.css" />
<style>
    /* — Info strip — */
    .hist-strip{background:linear-gradient(135deg,#2d3748 0%,#4a5568 100%);color:#f7fafc;border-radius:.5rem;padding:.9rem 1.1rem;margin-bottom:1rem;display:flex;align-items:center;gap:1rem;flex-wrap:wrap;}
    .hist-strip-cell{display:flex;flex-direction:column;gap:.1rem;}
    .hist-strip-lbl{font-size:.68rem;text-transform:uppercase;letter-spacing:.08em;color:#a0aec0;font-weight:600;}
    .hist-strip-val{font-size:.9rem;font-weight:700;color:#f7fafc;}
    .hist-strip-sep{width:1px;height:36px;background:rgba(255,255,255,.2);align-self:center;}
    .hist-strip-actions{margin-left:auto;display:flex;align-items:center;}
    /* — Snapshot cards — */
    .rcalc-card{border:1px solid #e2e8f0;border-radius:.5rem;margin-bottom:.65rem;overflow:hidden;}
    .rcalc-hd{display:flex;align-items:center;gap:.5rem;padding:.45rem .75rem;background:#f7fafc;border-bottom:1px solid #e2e8f0;flex-wrap:wrap;}
    .rcalc-num{font-size:.78rem;font-weight:700;color:#718096;min-width:24px;}
    .rcalc-fch{font-size:.78rem;color:#4a5568;font-weight:600;}
    .rcalc-usr{font-size:.72rem;color:#9ca3af;margin-left:auto;}
    /* date chips */
    .rcalc-dates{display:flex;gap:.4rem;flex-wrap:wrap;padding:.5rem .75rem;background:#fff;}
    .rcalc-chip{display:flex;flex-direction:column;align-items:center;padding:.25rem .5rem;background:#edf2f7;border-radius:.35rem;min-width:78px;border:1px solid #e2e8f0;}
    .rcalc-chip-lbl{font-size:.6rem;text-transform:uppercase;letter-spacing:.05em;color:#718096;font-weight:700;white-space:nowrap;}
    .rcalc-chip-val{font-size:.8rem;font-weight:700;color:#2d3748;}
    .rcalc-chip-none{font-size:.8rem;font-weight:400;color:#a0aec0;}
</style>
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Produccion" asp-action="Index">Producción</a></li>
    <li class="breadcrumb-item active">Historial de Recálculos</li>
}

<!-- ── Info strip ───────────────────────────────────────────── -->
<div class="hist-strip">
    <div class="hist-strip-cell">
        <span class="hist-strip-lbl"><i class="bi bi-clock-history me-1"></i>Ítem</span>
        <span class="hist-strip-val">#@idSeguim</span>
    </div>
    <div class="hist-strip-sep"></div>
    <div class="hist-strip-cell">
        <span class="hist-strip-lbl">Recálculos</span>
        <span class="hist-strip-val">@Model.Count()</span>
        <span style="font-size:.72rem;color:#cbd5e0;">en historial</span>
    </div>
    <div class="hist-strip-actions">
        <button type="button" class="btn btn-sm" style="background:rgba(255,255,255,.15);color:#f7fafc;border:1px solid rgba(255,255,255,.3);" onclick="history.back();">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </button>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>No se encontraron recálculos para este ítem (ID @idSeguim).
    </div>
}
else
{
    var rcIdx = 1;
    @foreach (var h in Model.OrderByDescending(x => x.FchCalculo))
    {
        <div class="rcalc-card">
            <div class="rcalc-hd">
                <span class="rcalc-num">#@rcIdx</span>
                <span class="badge bg-secondary" title="@h.MotivoRecalculo">@h.MotivoDesc</span>
                <span class="rcalc-fch"><i class="bi bi-clock me-1 opacity-50"></i>@h.FchCalculo.ToString("dd/MM/yyyy HH:mm")</span>
                @if (h.DiferDias.HasValue)
                {
                    <span class="badge @h.DiferCss">@(h.DiferDias.Value > 0 ? "+" : "")@h.DiferDias.Value d</span>
                }
                <span class="rcalc-usr"><i class="bi bi-person me-1"></i>@h.Usuario</span>
            </div>
            <div class="rcalc-dates">
                <div class="rcalc-chip">
                    <span class="rcalc-chip-lbl">Hilandería</span>
                    @if (h.FchEstHilanderia.HasValue)
                    { <span class="rcalc-chip-val">@h.FchEstHilanderia.Value.ToString("dd/MM/yy")</span> }
                    else { <span class="rcalc-chip-none">—</span> }
                </div>
                <div class="rcalc-chip">
                    <span class="rcalc-chip-lbl">Partida</span>
                    @if (h.FchEstPartida.HasValue)
                    { <span class="rcalc-chip-val">@h.FchEstPartida.Value.ToString("dd/MM/yy")</span> }
                    else { <span class="rcalc-chip-none">—</span> }
                </div>
                <div class="rcalc-chip">
                    <span class="rcalc-chip-lbl">TT Inicio</span>
                    @if (h.FchEstTinIni.HasValue)
                    { <span class="rcalc-chip-val">@h.FchEstTinIni.Value.ToString("dd/MM/yy")</span> }
                    else { <span class="rcalc-chip-none">—</span> }
                </div>
                <div class="rcalc-chip">
                    <span class="rcalc-chip-lbl">TT Fin</span>
                    @if (h.FchEstTinFin.HasValue)
                    { <span class="rcalc-chip-val">@h.FchEstTinFin.Value.ToString("dd/MM/yy")</span> }
                    else { <span class="rcalc-chip-none">—</span> }
                </div>
                <div class="rcalc-chip">
                    <span class="rcalc-chip-lbl">Secado</span>
                    @if (h.FchEstSecado.HasValue)
                    { <span class="rcalc-chip-val">@h.FchEstSecado.Value.ToString("dd/MM/yy")</span> }
                    else { <span class="rcalc-chip-none">—</span> }
                </div>
                <div class="rcalc-chip">
                    <span class="rcalc-chip-lbl">Calidad</span>
                    @if (h.FchEstCalidad.HasValue)
                    { <span class="rcalc-chip-val">@h.FchEstCalidad.Value.ToString("dd/MM/yy")</span> }
                    else { <span class="rcalc-chip-none">—</span> }
                </div>
                <div class="rcalc-chip" style="border-color:#bee3f8;background:#ebf8ff;">
                    <span class="rcalc-chip-lbl" style="color:#2c7a7b;">Despacho</span>
                    @if (h.FchEstDespacho.HasValue)
                    { <span class="rcalc-chip-val" style="color:#1a365d;">@h.FchEstDespacho.Value.ToString("dd/MM/yy")</span> }
                    else { <span class="rcalc-chip-none">—</span> }
                </div>
            </div>
        </div>
        rcIdx++;
    }

    <div class="alert alert-light mt-3">
        <small class="text-muted">
            <i class="bi bi-info-circle me-1"></i>
            <b>Motivos de recálculo (PKG_PLN §4):</b>
            <span class="badge bg-secondary me-1">AV</span> Avance de paso (recálculo automático al avanzar etapa),
            <span class="badge bg-secondary me-1">PED</span> Registro de pedido,
            <span class="badge bg-secondary me-1">PLA</span> Planificación (NROPROG asignado),
            <span class="badge bg-secondary me-1">REP</span> Reprogramación manual,
            <span class="badge bg-secondary me-1">MAQ</span> Cambio de máquina.
            <br/>
            <b>Δ días:</b> Diferencia en días respecto al cálculo anterior (<span class="text-danger fw-semibold">positivo = se demoró más</span>, <span class="text-success fw-semibold">negativo = se adelantó</span>).
        </small>
    </div>
}
