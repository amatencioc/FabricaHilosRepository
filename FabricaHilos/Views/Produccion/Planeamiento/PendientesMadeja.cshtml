@section Styles {
<link rel="stylesheet" href="~/css/planeamiento.css" asp-append-version="true" />
}

@using FabricaHilos.Models.Produccion.Planeamiento
@model IEnumerable<PlnPendienteMadeja>
@{
    ViewData["Title"] = "Pendientes de Acabado Madeja";
    var lista      = Model.ToList();
    var nVencidos  = lista.Count(x => x.EstaVencido);
    var kgTotal    = lista.Sum(x => x.Peso);
    var nMaquinas  = lista.Select(x => x.CodMaq).Where(m => m.Length > 0).Distinct().Count();
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Produccion" asp-action="Index">Producción</a></li>
    <li class="breadcrumb-item active">Pendientes de Acabado Madeja</li>
}

@await Html.PartialAsync("_PlnNavBar")

<div class="container-fluid py-3">

    @* ── Strip de cabecera ─────────────────────────────────────────────── *@
    <div class="pend-strip">
        <i class="bi bi-wind" style="color:#76e4f7;font-size:.95rem;flex-shrink:0;"></i>
        <span class="pend-strip-title">Acabado Madeja</span>
        <span class="pend-strip-sep"></span>

        <span class="pend-kpi" title="Total de partidas pendientes de acabado de madeja.">
            <i class="bi bi-boxes" style="color:#90cdf4;"></i>
            <span class="pend-kpi-val">@lista.Count</span>
            <span style="opacity:.75">partidas</span>
        </span>
        <span class="pend-kpi" style="@(nVencidos > 0 ? "" : "opacity:.45")"
              title="Partidas cuya fecha de entrega ya venció.">
            <i class="bi bi-clock-history" style="color:#fc8181;"></i>
            <span class="pend-kpi-val" style="@(nVencidos > 0 ? "color:#fc8181;" : "")">@nVencidos</span>
            <span style="opacity:.75">vencidas</span>
        </span>
        <span class="pend-kpi" title="Máquinas distintas involucradas.">
            <i class="bi bi-gear" style="color:#fbd38d;"></i>
            <span class="pend-kpi-val">@nMaquinas</span>
            <span style="opacity:.75">máquinas</span>
        </span>
        <span class="pend-kpi" title="Total de kg pendientes.">
            <i class="bi bi-bag-fill" style="color:#fbd38d;"></i>
            <span class="pend-kpi-val">@kgTotal.ToString("N0")</span>
            <span style="opacity:.75">kg</span>
        </span>

        <span class="pend-strip-actions">
            <a asp-action="Dashboard" class="btn btn-sm btn-outline-light py-0 px-2" style="font-size:.72rem;">
                <i class="bi bi-arrow-left me-1"></i>Seguimiento
            </a>
        </span>
    </div>

    @* ── Filtros ───────────────────────────────────────────────────────── *@
    <div class="pend-filter">
        @await Html.PartialAsync("_PlnFiltrosPendientes", (object)"PendientesMadeja")
    </div>

    @* ── Tabla ─────────────────────────────────────────────────────────── *@
    @if (!lista.Any())
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i>No hay partidas pendientes de acabado de madeja en este momento.
        </div>
    }
    else
    {
        <div class="d-flex align-items-end gap-2 mb-2">
            <div style="position:relative;">
                <label class="form-label form-label-sm mb-0">RMC</label>
                <button type="button" id="btnFiltroRmc" class="form-control form-control-sm d-flex justify-content-between align-items-center"
                        style="width:220px;" autocomplete="off">
                    <span id="filtroRmcLabel" class="text-truncate">Todos</span>
                    <i class="bi bi-chevron-down small text-muted ms-1"></i>
                </button>
                <div id="dropdownRmc" class="pln-autocomplete-dropdown" style="display:none;width:260px;">
                    <div class="p-2 border-bottom">
                        <input type="text" id="filtroRmcSearch" class="form-control form-control-sm"
                               placeholder="Buscar RMC…" autocomplete="off" />
                    </div>
                    <div class="p-2 border-bottom d-flex justify-content-between">
                        <a href="#" id="filtroRmcTodos" class="small">Marcar todos</a>
                        <a href="#" id="filtroRmcLimpiar" class="small">Limpiar</a>
                    </div>
                    <div id="rmcCheckList" style="max-height:220px;overflow-y:auto;"></div>
                </div>
            </div>
            <span class="text-muted small" id="filtroRmcCount"></span>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0 pend-tbl" id="tbl-madeja">
                <thead>
                    <tr>
                        <th>Partida</th>
                        <th>Material</th>
                        <th>Color Cliente</th>
                        <th>Cliente</th>
                        <th>Cód. Cliente</th>
                        <th>Cód. Vende</th>
                        <th class="text-center">F. Prog.</th>
                        <th>Cód. Maq.</th>
                        <th>Máquina</th>
                        <th>RMC</th>
                        <th class="text-center">Nro RMC</th>
                        <th class="text-end">Kg</th>
                        <th>Lote</th>
                        <th class="text-center pend-th-sort" data-col="fentrega" data-dir="" style="cursor:pointer;user-select:none;" title="Ordenar por F. Entrega">
                            F. Entrega <i class="bi bi-arrow-down-up sort-icon ms-1"></i>
                        </th>
                        <th class="text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in lista)
                    {
                        var rowCss = item.EstaVencido ? "table-danger" :
                                     item.DiasRetraso >= -2 ? "table-warning" : "";
                        <tr class="@rowCss"
                            data-fentrega="@(item.FchEntrega.HasValue ? item.FchEntrega.Value.ToString("yyyyMMdd") : "99999999")"
                            data-rmc="@item.Rmc">
                            <td class="fw-bold" style="white-space:nowrap;">@item.Partida</td>
                            <td>@item.Material</td>
                            <td style="font-size:.78rem;" class="text-muted">@item.ColorTecnico</td>
                            <td>
                                <span style="max-width:160px;display:inline-block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
                                      title="@item.Cliente">@item.Cliente</span>
                            </td>
                            <td class="text-muted" style="font-size:.75rem;">@item.CodCliente</td>
                            <td class="text-muted" style="font-size:.75rem;">@item.CodVende</td>
                            <td class="text-center text-muted">
                                @(item.FchProg.HasValue ? item.FchProg.Value.ToString("dd/MM/yy") : "—")
                            </td>
                            <td class="text-muted" style="font-size:.75rem;">@item.CodMaq</td>
                            <td style="font-size:.78rem;">@item.Maquina</td>
                            <td style="font-size:.78rem;">@item.Rmc</td>
                            <td class="text-center text-muted">
                                @(item.NroRmc > 0 ? item.NroRmc.ToString("N0") : "—")
                            </td>
                            <td class="text-end fw-semibold">@item.Peso.ToString("N2")</td>
                            <td style="font-size:.78rem;">@item.Lote</td>
                            <td class="text-center">
                                @if (item.FchEntrega.HasValue)
                                {
                                    <span class="fw-semibold @(item.EstaVencido ? "text-danger" : item.DiasRetraso >= -2 ? "text-warning" : "text-success")">
                                        @item.FchEntrega.Value.ToString("dd/MM/yy")
                                    </span>
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td class="text-center">
                                @if (!item.FchEntrega.HasValue)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else if (item.EstaVencido)
                                {
                                    <span class="badge bg-danger" title="@item.DiasRetraso días vencido">+@item.DiasRetraso d</span>
                                }
                                else if (item.DiasRetraso >= -2)
                                {
                                    <span class="badge bg-warning text-dark">@(-item.DiasRetraso) d</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@(-item.DiasRetraso) d</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-semibold">
                        <td colspan="11" class="text-end text-muted">Totales:</td>
                        <td class="text-end">@kgTotal.ToString("N2")</td>
                        <td colspan="3"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }

</div>

@section Scripts {
<script>
(function () {
    var tbl = document.getElementById('tbl-madeja');
    if (!tbl) return;
    var tbody = tbl.querySelector('tbody');
    var sortState = { col: null, dir: '' };
    function updateIcons() {
        tbl.querySelectorAll('.pend-th-sort').forEach(function (th) {
            var icon = th.querySelector('.sort-icon');
            if (!icon) return;
            icon.className = 'bi sort-icon ms-1 ' + (th.dataset.col === sortState.col
                ? (sortState.dir === 'asc' ? 'bi-sort-up' : 'bi-sort-down')
                : 'bi-arrow-down-up');
        });
    }
    function sortTable(col, dir) {
        var rows = Array.from(tbody.querySelectorAll('tr'));
        rows.sort(function (a, b) {
            var va = a.dataset[col] || '99999999';
            var vb = b.dataset[col] || '99999999';
            if (va === vb) return 0;
            return dir === 'asc' ? (va < vb ? -1 : 1) : (va > vb ? -1 : 1);
        });
        rows.forEach(function (r) { tbody.appendChild(r); });
        sortState.col = col; sortState.dir = dir;
        updateIcons();
    }
    tbl.querySelectorAll('.pend-th-sort').forEach(function (th) {
        th.addEventListener('click', function () {
            var col = this.dataset.col;
            var dir = (sortState.col === col && sortState.dir === 'asc') ? 'desc' : 'asc';
            sortTable(col, dir);
        });
    });
})();

(function () {
    // ── Filtro de RMC multi-selección (client-side, sobre la data ya cargada) ──
    var btn        = document.getElementById('btnFiltroRmc');
    var dropdown   = document.getElementById('dropdownRmc');
    var search     = document.getElementById('filtroRmcSearch');
    var checkList  = document.getElementById('rmcCheckList');
    var label      = document.getElementById('filtroRmcLabel');
    var count      = document.getElementById('filtroRmcCount');
    var btnTodos   = document.getElementById('filtroRmcTodos');
    var btnLimpiar = document.getElementById('filtroRmcLimpiar');
    var tbl        = document.getElementById('tbl-madeja');
    if (!btn || !tbl) return;

    var tbody    = tbl.querySelector('tbody');
    var rows     = Array.from(tbody.querySelectorAll('tr'));
    var total    = rows.length;
    var selected = new Set(); // vacío = "Todos"

    var valores = Array.from(new Set(rows.map(function (r) { return r.dataset.rmc || ''; })))
        .filter(function (v) { return v.length > 0; })
        .sort(function (a, b) { return a.localeCompare(b); });

    function renderCheckList(filter) {
        var q = (filter || '').trim().toLowerCase();
        var items = q.length === 0
            ? valores
            : valores.filter(function (v) { return v.toLowerCase().includes(q); });

        checkList.innerHTML = items.map(function (v) {
            var isChecked = selected.has(v);
            return '<div class="rmc-item d-flex align-items-center px-2 py-2' + (isChecked ? ' rmc-item-selected' : '') + '" data-val="' + v.replace(/"/g, '&quot;') + '">' +
                   '<i class="bi ' + (isChecked ? 'bi-check-square-fill text-primary' : 'bi-square text-muted') + ' me-2"></i>' +
                   '<span class="small">' + v + '</span>' +
                   '</div>';
        }).join('') || '<div class="p-2 text-muted small">Sin coincidencias</div>';

        checkList.querySelectorAll('.rmc-item').forEach(function (item) {
            item.addEventListener('click', function () {
                var v = item.dataset.val;
                if (selected.has(v)) selected.delete(v); else selected.add(v);
                renderCheckList(search.value);
                updateLabel();
                applyFilter();
            });
        });
    }

    function updateLabel() {
        if (selected.size === 0) {
            label.textContent = 'Todos';
        } else if (selected.size === 1) {
            label.textContent = Array.from(selected)[0];
        } else {
            label.textContent = selected.size + ' seleccionados';
        }
    }

    function applyFilter() {
        var visibles = 0;
        rows.forEach(function (r) {
            var rmc = r.dataset.rmc || '';
            var match = selected.size === 0 || selected.has(rmc);
            r.style.display = match ? '' : 'none';
            if (match) visibles++;
        });
        count.textContent = selected.size === 0
            ? ''
            : visibles + ' de ' + total + ' partidas';
    }

    function toggleDropdown(show) {
        dropdown.style.display = show ? 'block' : 'none';
        if (show) { renderCheckList(search.value); search.focus(); }
    }

    btn.addEventListener('click', function (e) {
        e.preventDefault();
        toggleDropdown(dropdown.style.display !== 'block');
    });

    document.addEventListener('click', function (e) {
        if (!dropdown.contains(e.target) && e.target !== btn && !btn.contains(e.target)) {
            toggleDropdown(false);
        }
    });

    search.addEventListener('input', function () { renderCheckList(search.value); });

    btnTodos.addEventListener('click', function (e) {
        e.preventDefault();
        valores.forEach(function (v) { selected.add(v); });
        renderCheckList(search.value);
        updateLabel();
        applyFilter();
    });

    btnLimpiar.addEventListener('click', function (e) {
        e.preventDefault();
        selected.clear();
        renderCheckList(search.value);
        updateLabel();
        applyFilter();
    });
})();
</script>
<style>
    .rmc-item { cursor: pointer; user-select: none; }
    .rmc-item:hover { background: #f0f4ff; }
    .rmc-item-selected { background: #eaf1ff; }
</style>
}
