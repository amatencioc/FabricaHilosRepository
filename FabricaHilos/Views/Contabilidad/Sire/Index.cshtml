@model IReadOnlyList<FabricaHilos.Controllers.Contabilidad.SirePeriodoDashboardItem>
@{
    ViewData["Title"] = "SIRE — Gestión de Libros Electrónicos";

    string BadgeEstado(string estado) => estado switch
    {
        "PROPUESTA_DISPONIBLE" => "sire-badge-warn",
        "CERRADO"              => "sire-badge-ok",
        "EN_PROCESO"           => "sire-badge-process",
        _                      => "sire-badge-secondary"
    };

    string LabelEstado(string estado) => estado switch
    {
        "PROPUESTA_DISPONIBLE" => "Propuesta disponible",
        "CERRADO"              => "Cerrado",
        "EN_PROCESO"           => "En proceso",
        "SIN_INFORMACION"      => "Sin información",
        "-"                    => "—",
        _                      => estado
    };

    string IconEstado(string estado) => estado switch
    {
        "PROPUESTA_DISPONIBLE" => "bi-exclamation-circle",
        "CERRADO"              => "bi-check-circle",
        "EN_PROCESO"           => "bi-arrow-repeat",
        _                      => "bi-dash-circle"
    };

    int rvieDisponibles = Model.Count(x => x.EstadoRvie == "PROPUESTA_DISPONIBLE");
    int rvieEnProceso   = Model.Count(x => x.EstadoRvie == "EN_PROCESO");
    int rvieCerrados    = Model.Count(x => x.EstadoRvie == "CERRADO");
    int rceDisponibles  = Model.Count(x => x.EstadoRce  == "PROPUESTA_DISPONIBLE");
    int rceEnProceso    = Model.Count(x => x.EstadoRce  == "EN_PROCESO");
    int rceCerrados     = Model.Count(x => x.EstadoRce  == "CERRADO");
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Contabilidad" asp-action="Index">Contabilidad</a></li>
    <li class="breadcrumb-item active">SIRE</li>
}

@section Styles {
<link rel="stylesheet" href="~/css/sire.css" asp-append-version="true" />
}

@if (TempData["Error"] is string err)
{
    <div class="sire-alert sire-alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <div><strong>Error:</strong> @err</div>
    </div>
}
@if (TempData["Success"] is string ok)
{
    <div class="sire-alert sire-alert-success" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <div>@ok</div>
    </div>
}
@if (ViewBag.EsMock == true)
{
    <div class="sire-alert sire-alert-mock" role="alert">
        <i class="bi bi-cone-striped"></i>
        <div><strong>MODO MOCK ACTIVO</strong> — Los datos mostrados son de prueba. No se realizan llamadas reales a SUNAT.</div>
    </div>
}

@await Html.PartialAsync("~/Views/Contabilidad/Sire/_SireNavBar.cshtml")

<div class="sire-strip">
    <i class="bi bi-journal-text" style="color:#90cdf4;font-size:.95rem;flex-shrink:0;"></i>
    <span class="sire-strip-title">SIRE</span>
    <span class="sire-strip-sep"></span>
    <span class="sire-kpi" title="RVIE con propuesta disponible">
        <i class="bi bi-receipt-cutoff" style="color:#fbd38d;"></i>
        <span class="sire-kpi-val">@rvieDisponibles</span>
        <span style="opacity:.75">RVIE pendientes</span>
    </span>
    <span class="sire-kpi" title="RCE con propuesta disponible">
        <i class="bi bi-cart-check" style="color:#90cdf4;"></i>
        <span class="sire-kpi-val">@rceDisponibles</span>
        <span style="opacity:.75">RCE pendientes</span>
    </span>
    <span class="sire-kpi">
        <i class="bi bi-arrow-repeat" style="color:#76e4f7;"></i>
        <span class="sire-kpi-val">@(rvieEnProceso + rceEnProceso)</span>
        <span style="opacity:.75">en proceso</span>
    </span>
    <span class="sire-kpi">
        <i class="bi bi-check2-circle" style="color:#68d391;"></i>
        <span class="sire-kpi-val">@(rvieCerrados + rceCerrados)</span>
        <span style="opacity:.75">cerrados</span>
    </span>
    <span class="sire-kpi" style="margin-left:auto;">
        <i class="bi bi-calendar3"></i>
        <span style="opacity:.75">@Model.Count período(s)</span>
    </span>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="sire-kpi-card rvie">
            <div class="sire-kpi-card-icon rvie"><i class="bi bi-exclamation-circle"></i></div>
            <div>
                <div class="sire-kpi-card-label">RVIE pendientes</div>
                <div class="sire-kpi-card-value">@rvieDisponibles</div>
                <div class="sire-kpi-card-sub">Propuesta disponible</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="sire-kpi-card warn">
            <div class="sire-kpi-card-icon warn"><i class="bi bi-arrow-repeat"></i></div>
            <div>
                <div class="sire-kpi-card-label">En proceso</div>
                <div class="sire-kpi-card-value">@(rvieEnProceso + rceEnProceso)</div>
                <div class="sire-kpi-card-sub">RVIE + RCE en trámite</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="sire-kpi-card ok">
            <div class="sire-kpi-card-icon ok"><i class="bi bi-check-circle"></i></div>
            <div>
                <div class="sire-kpi-card-label">Cerrados</div>
                <div class="sire-kpi-card-value">@(rvieCerrados + rceCerrados)</div>
                <div class="sire-kpi-card-sub">RVIE + RCE completados</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="sire-module-card h-100">
            <div class="sire-module-card-header rvie">
                <i class="bi bi-receipt-cutoff"></i> RVIE — Registro de Ventas e Ingresos
                @if (rvieDisponibles > 0)
                {
                    <span class="ms-auto sire-badge sire-badge-warn">@rvieDisponibles pendiente(s)</span>
                }
            </div>
            <div class="sire-module-card-body">
                <p class="text-muted small mb-3">Consulta y gestiona propuestas de ventas electrónicas desde SUNAT.</p>
                <a asp-controller="Sire" asp-action="Ventas" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-right me-1"></i>Acceder a RVIE
                </a>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="sire-module-card h-100">
            <div class="sire-module-card-header rce">
                <i class="bi bi-cart-check"></i> RCE — Registro de Compras y Gastos
                @if (rceDisponibles > 0)
                {
                    <span class="ms-auto sire-badge sire-badge-warn">@rceDisponibles pendiente(s)</span>
                }
            </div>
            <div class="sire-module-card-body">
                <p class="text-muted small mb-3">Consulta y gestiona propuestas de compras electrónicas desde SUNAT.</p>
                <a asp-controller="Sire" asp-action="Compras" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-right me-1"></i>Acceder a RCE
                </a>
            </div>
        </div>
    </div>
</div>

<div class="sire-card">
    <div class="sire-card-header">
        <i class="bi bi-calendar3"></i>
        <span>Períodos registrados</span>
        <span class="ms-auto sire-badge sire-badge-secondary">@Model.Count</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table sire-table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Período</th>
                        <th>Descripción</th>
                        <th class="text-center">RVIE</th>
                        <th class="text-center">RCE</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            <small>Sin períodos disponibles. Verifique la conexión con SUNAT.</small>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        var periodo = item.Periodo;
                        var yyyyMm  = periodo.Length == 6 ? $"{periodo[..4]}/{periodo[4..]}" : periodo;
                        <tr>
                            <td><span class="sire-badge sire-badge-period">@yyyyMm</span></td>
                            <td class="text-muted small">@item.Descripcion</td>
                            <td class="text-center">
                                <span class="sire-badge @BadgeEstado(item.EstadoRvie)">
                                    <i class="bi @IconEstado(item.EstadoRvie)"></i>
                                    @LabelEstado(item.EstadoRvie)
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="sire-badge @BadgeEstado(item.EstadoRce)">
                                    <i class="bi @IconEstado(item.EstadoRce)"></i>
                                    @LabelEstado(item.EstadoRce)
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-controller="Sire" asp-action="Ventas" asp-route-periodo="@periodo"
                                       class="btn btn-outline-secondary btn-sm" title="Ver RVIE" data-bs-toggle="tooltip">
                                        <i class="bi bi-receipt"></i>
                                    </a>
                                    <a asp-controller="Sire" asp-action="Compras" asp-route-periodo="@periodo"
                                       class="btn btn-outline-secondary btn-sm" title="Ver RCE" data-bs-toggle="tooltip">
                                        <i class="bi bi-cart3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="sire-card mt-3">
    <div class="sire-card-header">
        <i class="bi bi-activity"></i>
        <span>Actividad reciente de exportaciones</span>
        <button class="btn btn-xs btn-outline-secondary ms-auto py-0 px-2" onclick="cargarPanelActividad()" title="Actualizar">
            <i class="bi bi-arrow-clockwise"></i>
        </button>
        <a asp-action="Monitoreo" class="btn btn-xs btn-outline-info py-0 px-2 ms-1" title="Ver log completo">
            <i class="bi bi-journal-code me-1"></i>Log completo
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table sire-table table-hover align-middle mb-0 small">
                <thead>
                    <tr>
                        <th style="width:70px">Tipo</th>
                        <th style="width:80px">Período</th>
                        <th>Estado</th>
                        <th>Ticket SUNAT</th>
                        <th>Registros</th>
                        <th>Iniciado</th>
                        <th style="width:60px"></th>
                    </tr>
                </thead>
                <tbody id="tbodyJobs">
                    <tr>
                        <td colspan="7" class="text-center text-muted py-3 small">
                            <div class="spinner-border spinner-border-sm me-2" role="status"></div>Cargando actividad…
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <!-- Log del proceso activo -->
        <div class="px-3 py-2 border-top" id="seccionLogsActivos">
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-journal-text text-info"></i>
                <span class="fw-semibold small">Log del proceso activo</span>
            </div>
            <div id="logsActivosContainer" style="max-height:200px;overflow-y:auto;font-size:.8rem;">
                <p class="text-muted small mb-0">Sin proceso activo en este momento.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('[data-bs-toggle="tooltip"]')
            .forEach(el => new bootstrap.Tooltip(el));

        // Cargar panel de actividad al iniciar
        cargarPanelActividad();
    });

    // ── Panel de actividad: jobs recientes + logs del job activo ──────────────

    let _actividadTimer = null;

    async function cargarPanelActividad() {
        try {
            const resp = await fetch('@Url.Action("JobsRecientes", "Sire")', { method: 'GET' });
            const data = await resp.json();
            if (!data.exitoso) return;

            renderizarJobs(data.jobs || []);
            renderizarLogsActivos(data.logsActivos || []);

            // Si hay algún job activo, seguir actualizando cada 5s
            const hayActivo = (data.jobs || []).some(j => j.estado === 'Pendiente' || j.estado === 'EnProceso');
            clearTimeout(_actividadTimer);
            if (hayActivo) {
                _actividadTimer = setTimeout(cargarPanelActividad, 5000);
            }
        } catch (e) {
            // Silencioso — el panel no es crítico
        }
    }

    function badgeJob(estado) {
        switch (estado) {
            case 'Pendiente':  return '<span class="badge bg-warning text-dark">Pendiente</span>';
            case 'EnProceso':  return '<span class="badge bg-info text-dark"><span class="spinner-border spinner-border-sm me-1" style="width:.7rem;height:.7rem;"></span>En proceso</span>';
            case 'Completado': return '<span class="badge bg-success">Completado</span>';
            case 'Error':      return '<span class="badge bg-danger">Error</span>';
            default:           return `<span class="badge bg-secondary">${estado}</span>`;
        }
    }

    function renderizarJobs(jobs) {
        const tbody = document.getElementById('tbodyJobs');
        if (!tbody) return;

        if (!jobs.length) {
            tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-3 small"><i class="bi bi-inbox me-1"></i>Sin actividad registrada</td></tr>';
            return;
        }

        tbody.innerHTML = jobs.map(j => {
            const tipo   = j.tipoRegistro === 'ventas' ? 'RVIE' : 'RCE';
            const tipoBadge = j.tipoRegistro === 'ventas'
                ? '<span class="sire-badge sire-badge-rvie">RVIE</span>'
                : '<span class="sire-badge sire-badge-rce">RCE</span>';
            const perFmt = j.periodo.length === 6 ? `${j.periodo.slice(0,4)}/${j.periodo.slice(4)}` : j.periodo;
            const regs   = j.registrosInsertados != null ? `${j.registrosInsertados} reg.` : '—';
            const ticket = j.numTicket
                ? `<span class="sire-code" style="font-size:.7rem">${j.numTicket.slice(0,12)}…</span>`
                : '—';
            const err    = j.mensajeError
                ? `<i class="bi bi-info-circle text-danger ms-1" title="${j.mensajeError.replace(/"/g,'&quot;')}" data-bs-toggle="tooltip"></i>`
                : '';
            const acciones = j.puedeReintentar
                ? `<button class="btn btn-xs btn-outline-warning py-0 px-1" onclick="reconectarJobDesdeIndex('${j.jobId}','${j.periodo}','${j.tipoRegistro}')" title="Reintentar"><i class="bi bi-arrow-clockwise"></i></button>`
                : (j.esFinal ? '' : `<button class="btn btn-xs btn-outline-info py-0 px-1" onclick="reconectarJobDesdeIndex('${j.jobId}','${j.periodo}','${j.tipoRegistro}')" title="Ver progreso"><i class="bi bi-eye"></i></button>`);

            return `<tr>
                <td>${tipoBadge}</td>
                <td class="sire-badge sire-badge-period">${perFmt}</td>
                <td>${badgeJob(j.estado)}${err}</td>
                <td class="text-muted small">${ticket}</td>
                <td class="text-muted small">${regs}</td>
                <td class="text-muted small">${j.fechaCreacion}</td>
                <td>${acciones}</td>
            </tr>`;
        }).join('');

        // Re-inicializar tooltips en las nuevas filas
        tbody.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => new bootstrap.Tooltip(el));
    }

    function renderizarLogsActivos(logs) {
        const cont = document.getElementById('logsActivosContainer');
        if (!cont) return;

        if (!logs.length) {
            cont.innerHTML = '<p class="text-muted small mb-0"><i class="bi bi-journal-text me-1"></i>Sin entradas de log para el proceso activo.</p>';
            return;
        }

        const filas = logs.map(l => {
            const icono = l.exito
                ? '<i class="bi bi-check-circle text-success"></i>'
                : '<i class="bi bi-x-circle text-danger"></i>';
            const dur = l.duracionMs != null ? `<span class="text-muted ms-1">(${l.duracionMs}ms)</span>` : '';
            const http = l.httpStatus != null ? `<span class="badge bg-secondary ms-1">${l.httpStatus}</span>` : '';
            return `<div class="d-flex align-items-start gap-2 border-bottom py-1">
                <span style="min-width:1rem">${icono}</span>
                <div style="flex:1;min-width:0">
                    <span class="badge bg-dark me-1" style="font-size:.65rem">${l.operacion}</span>
                    ${http}
                    <span class="small">${l.mensaje || ''}</span>${dur}
                </div>
                <span class="text-muted small text-nowrap">${l.fecha.slice(11,19)}</span>
            </div>`;
        }).join('');

        cont.innerHTML = filas;
    }

    // Abre el modal de exportación reconectando a un job existente (desde la tabla de jobs)
    async function reconectarJobDesdeIndex(jobId, periodo, tipo) {
        // Navegar a la vista correcta con el modal abierto
        const url = tipo === 'ventas'
            ? '@Url.Action("Ventas", "Sire")?periodo=' + periodo
            : '@Url.Action("Compras", "Sire")?periodo=' + periodo;

        // Guardar jobId en sessionStorage para que la vista lo recoja
        sessionStorage.setItem('sireJobId', jobId);
        sessionStorage.setItem('periodoExportacion', periodo);
        sessionStorage.setItem('tipoExportacion', tipo);
        sessionStorage.setItem('sireReconectar', '1');

        window.location.href = url;
    }
</script>
}
