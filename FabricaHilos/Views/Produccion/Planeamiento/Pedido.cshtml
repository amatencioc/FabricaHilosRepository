                                        <button class="accordion-button collapsed tt-acc-btn" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#acc-tt-@(subIdx)-alm"
                                                aria-expanded="false">
                                          <span class="tt-sdot tt-sdot-ok"></span>
                                          <i class="bi bi-box-seam me-2"></i>Pesaje Ingreso Almacén PT
                                          <span class="tt-acc-preview">@detTt.PesajesAlmacen.Count ingreso@(detTt.PesajesAlmacen.Count != 1 ? "s" : "") · @detTt.PesajesAlmacen.Sum(x => x.PesoPesado).ToString("N0") kg</span>
