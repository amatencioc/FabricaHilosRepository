    function sireOrdenarColumna(th) {
        const dir = th.dataset.sortDir === 'asc' ? 'desc' : 'asc';
        th.closest('table').querySelectorAll('th[data-sort-type]').forEach(t => {
            t.dataset.sortDir = '';
            const ic = t.querySelector('.sire-sort-icon');
            if (ic) { ic.textContent = '\u2195'; ic.style.opacity = '.5'; }
        });
        th.dataset.sortDir = dir;
        const ic = th.querySelector('.sire-sort-icon');
        if (ic) { ic.textContent = dir === 'asc' ? '\u2191' : '\u2193'; ic.style.opacity = '1'; }
        sireOrdenarColumnaAplicar(th);
    }

    // Aplica el ordenamiento del th activo sin cambiar la dirección (para re-aplicar al filtrar)
    function sireOrdenarColumnaAplicar(th) {
        const table = th.closest('table');
        const tbody = table.querySelector('tbody');
        if (!tbody) return;
        const idx  = Array.from(th.closest('tr').children).indexOf(th);
        const tipo = th.dataset.sortType || 'text';
        const dir  = th.dataset.sortDir || 'asc';
        function parseFecha(v) {
            const p = (v || '').trim().split('/');
            return p.length === 3 ? new Date(+p[2], +p[1] - 1, +p[0]).getTime() : 0;
        }
        const rows = Array.from(tbody.rows);
        rows.sort((a, b) => {
            const av = (a.cells[idx]?.textContent ?? '').trim();
            const bv = (b.cells[idx]?.textContent ?? '').trim();
            const cmp = tipo === 'date'
                ? parseFecha(av) - parseFecha(bv)
                : av.localeCompare(bv, 'es', { sensitivity: 'base' });
            return dir === 'asc' ? cmp : -cmp;
        });
        rows.forEach(r => tbody.appendChild(r));
    }

    // ── SSCO: descarga automática desde portal SUNAT ──────────────────────────
    async function iniciarSscoAuto(periodo) {
        const overlay  = document.getElementById('overlaySscoAuto');
        const paso1    = document.getElementById('sscoPaso1');
        const paso2    = document.getElementById('sscoPaso2');
        const paso3    = document.getElementById('sscoPaso3');

        function setPaso(el, estado) {
            // estado: 'pending' | 'active' | 'ok' | 'error'
            const icon = el.querySelector('i');
            const text = el.querySelector('span');
            const estilos = {
                pending : { cls: 'bi-circle',             color: '#64748b', tc: '#94a3b8' },
                active  : { cls: 'bi-arrow-repeat spin',  color: '#fbbf24', tc: '#fde68a' },
                ok      : { cls: 'bi-check-circle-fill',  color: '#22c55e', tc: '#bbf7d0' },
                error   : { cls: 'bi-x-circle-fill',      color: '#ef4444', tc: '#fca5a5' },
            };
            const s = estilos[estado] ?? estilos.pending;
            icon.className = `bi ${s.cls}`;
            icon.style.color = s.color;
            text.style.color = s.tc;
        }

        // Mostrar overlay, resetear pasos
        [paso1, paso2, paso3].forEach(p => setPaso(p, 'pending'));
        overlay.style.display = 'flex';

        try {
            // Paso 1 activo: descargando
            setPaso(paso1, 'active');

            const token = document.querySelector('[name=__RequestVerificationToken]')?.value ?? '';
            const fd = new FormData();
            fd.append('periodo', periodo);
            fd.append('__RequestVerificationToken', token);

            // Los pasos 1 y 2 ocurren en el servidor de forma continua;
            // animamos los iconos con un pequeño delay para que el usuario vea el progreso.
            const pasoTimer = setTimeout(() => {
                setPaso(paso1, 'ok');
                setPaso(paso2, 'active');
            }, 2500);

            const res  = await fetch('@Url.Action("SscoDescargarAuto", "Sire")', {
                method: 'POST',
                body: fd
            });

            clearTimeout(pasoTimer);
            const data = await res.json();

            if (!data.ok) {
                // Fallo: marcar paso activo como error, ocultar overlay y ofrecer carga manual
                setPaso(paso1, 'error');
                setTimeout(() => {
                    overlay.style.display = 'none';
                    // Abrir modal de carga manual como fallback
                    const modalEl = document.getElementById('modalSscoCargar');
                    if (modalEl) bootstrap.Modal.getOrCreateInstance(modalEl).show();
                    // Mostrar mensaje de error en el modal
                    const errDiv = document.getElementById('sscoAutoError');
                    if (errDiv) {
                        errDiv.querySelector('span').textContent = data.mensaje;
                        errDiv.classList.remove('d-none');
                    }
                }, 1200);
                return;
            }

            // Éxito: completar pasos
            setPaso(paso1, 'ok');
            setPaso(paso2, 'ok');
            setPaso(paso3, 'active');

            // Actualizar texto del paso 3 con el resultado de la exclusión automática
            const paso3Text = paso3.querySelector('span');
            if (paso3Text) {
                const excl = data.comprobantesExcluidos ?? 0;
                const hits = data.sscoHits ?? 0;
                if (excl > 0)
                    paso3Text.textContent = `Exclusión automática: ${hits} RUC(s) → ${excl} comprobante(s) excluidos por SSCO.`;
                else if (hits > 0)
                    paso3Text.textContent = `${hits} RUC(s) con match en Legacy — sin comprobantes nuevos que excluir.`;
                else
                    paso3Text.textContent = 'Sin coincidencias con el padrón SSCO para el período.';
            }

            await new Promise(r => setTimeout(r, 600));
            setPaso(paso3, 'ok');
            await new Promise(r => setTimeout(r, 900));

            overlay.style.display = 'none';

            // ── Actualizar DOM sin recargar la página ───────────────────────────
            // ── Actualizar DOM sin recargar la página ───────────────────────────────────────────────────────────────
            // sscoRucsHit: solo los RUCs que tienen comprobantes en Legacy del período
            const rucsHitSet = new Set((data.sscoRucsHit || []).map(r => r.toString()));

            // 1. Actualizar tabla SSCO (pestaña SSCo)
            _sscoActualizarPanelSsco(rucsHitSet, data);

            // 2. Marcar/desmarcar filas de la tabla Legacy (solo las que coinciden con SSCO)
            _sscoMarcarFilasLegacy(rucsHitSet);

            // 3. Actualizar badge del tab SSCO
            _sscoActualizarBadgeTab(data.sscoHits, rucsHitSet.size);

            // 4. Actualizar badge del botón SSCO en la toolbar
            _sscoActualizarBadgeToolbar(data.sscoFchCarga);

            // 5. Mostrar resumen inline en la pestaña SSCO
            _sscoActualizarBanner(data.sscoHits, data.sscoFchCarga, data.sscoPeriodo, data.sujetos);

            // 6. Activar la pestaña SSCO
            const tabSsco = document.getElementById('tab-ssco');
            if (tabSsco) bootstrap.Tab.getOrCreateInstance(tabSsco).show();

            // 7. Toast con el resumen de exclusión automática
            const excl = data.comprobantesExcluidos ?? 0;
            const hits = data.sscoHits ?? 0;
            if (excl > 0) {
                mostrarToastSire(
                    `✓ SSCO: ${hits} RUC(s) excluidos automáticamente — ${excl} comprobante(s) movidos a Excluidos.`,
                    'warning');
                // Recargar la página para reflejar los nuevos excluidos en la tabla Cruzados
                setTimeout(() => location.reload(), 2500);
            } else if (hits > 0) {
                mostrarToastSire(
                    `✓ SSCO actualizado: ${hits} RUC(s) con match en Legacy, sin comprobantes nuevos que excluir.`,
                    'success');
            } else {
                mostrarToastSire('✓ Padrón SSCO actualizado. Sin coincidencias para el período.', 'success');
            }

        } catch (err) {
            setPaso(paso1, 'error');
            setTimeout(() => {
                overlay.style.display = 'none';
                const modalEl = document.getElementById('modalSscoCargar');
                if (modalEl) bootstrap.Modal.getOrCreateInstance(modalEl).show();
                const errDiv = document.getElementById('sscoAutoError');
                if (errDiv) {
                    errDiv.querySelector('span').textContent = 'Error de red: ' + err.message;
                    errDiv.classList.remove('d-none');
                }
            }, 1200);
        }
    }

    // ── Helpers de actualización DOM SSCO ────────────────────────────────────

    function _sscoActualizarPanelSsco(rucsSet, data) {
        const panel = document.getElementById('panel-ssco');
        if (!panel) return;
        // Quitar el mensaje de "no cargado" si existe
        const alertVacio = panel.querySelector('.sire-alert-info');
        if (alertVacio) alertVacio.closest('.m-3')?.remove();
    }

    function _sscoMarcarFilasLegacy(rucsSet) {
        // Opera sobre las dos tablas que renderizan registros legacy con RUC
        ['tablaSscoDetalle', 'tablaLegacyDetalle'].forEach(tablaId => {
            const tabla = document.getElementById(tablaId);
            if (!tabla) return;
            tabla.querySelectorAll('tbody tr').forEach(tr => {
                // La columna RUC es la 5ª (índice 4) en ambas tablas
                const rucCell = tr.cells[4];
                if (!rucCell) return;
                const ruc = rucCell.textContent.trim();
                const esHit = rucsSet.has(ruc);

                // Fila
                tr.style.background    = esHit ? 'rgba(220,38,38,.09)' : '';
                tr.style.borderLeft    = esHit ? '3px solid #dc2626' : '';

                // Celda RUC
                rucCell.style.color      = esHit ? '#b91c1c' : '';
                rucCell.style.fontWeight = esHit ? '700' : '';

                // Columna SSCO (última celda) si existe en tablaSscoDetalle
                if (tablaId === 'tablaSscoDetalle') {
                    const sscoCell = tr.cells[tr.cells.length - 1];
                    if (sscoCell) {
                        if (esHit) {
                            sscoCell.innerHTML = '<span class="badge" style="background:#dc2626;font-size:.6rem;" title="Proveedor en lista SSCO de SUNAT"><i class="bi bi-shield-fill-exclamation me-1"></i>SSCO</span>';
                        } else {
                            sscoCell.innerHTML = '<span class="text-muted" style="font-size:.7rem;">—</span>';
                        }
                    }
                }
            });
        });
    }

    function _sscoActualizarBadgeTab(hits, totalRucs) {
        const tabBtn = document.getElementById('tab-ssco');
        if (!tabBtn) return;
        // Eliminar badge anterior
        tabBtn.querySelectorAll('.badge').forEach(b => b.remove());
        if (hits > 0) {
            const b = document.createElement('span');
            b.className = 'ms-1 badge rounded-pill';
            b.style.cssText = 'background:#dc2626;font-size:.6rem;';
            b.title = `${hits} comprobante(s) con proveedor SSCO`;
            b.textContent = hits;
            tabBtn.appendChild(b);
        } else if (totalRucs > 0) {
            const b = document.createElement('span');
            b.className = 'ms-1 badge rounded-pill bg-success';
            b.style.fontSize = '.6rem';
            b.title = 'Sin coincidencias SSCO en este período';
            b.textContent = '0';
            tabBtn.appendChild(b);
        }
    }

    function _sscoActualizarBadgeToolbar(fchCarga) {
        const btn = document.getElementById('btnSsco');
        if (!btn) return;
        btn.querySelectorAll('.badge').forEach(b => b.remove());
        if (fchCarga) {
            // Mostrar sólo MM/yyyy del string "dd/MM/yyyy HH:mm"
            const partes = fchCarga.split('/');
            const mmyyyy = partes.length >= 2 ? `${partes[1].substring(0,2)}/${partes[2]?.substring(0,4) ?? ''}` : fchCarga;
            const b = document.createElement('span');
            b.className = 'badge bg-danger ms-1';
            b.style.fontSize = '.6rem';
            b.textContent = mmyyyy;
            btn.appendChild(b);
        }
    }

    function _sscoActualizarBanner(hits, fchCarga, periodo, sujetos) {
        // Buscar el banner por id fijo — lo reemplaza en su lugar sin duplicar
        const existing = document.getElementById('sscoBanner');
        const panel    = document.getElementById('panel-ssco');
        if (!panel) return;

        const div = document.createElement('div');
        div.id = 'sscoBanner';

        if (hits > 0) {
            div.style.cssText = 'margin:.5rem .75rem 0;padding:.4rem .75rem;background:rgba(220,38,38,.08);border-left:4px solid #dc2626;border-radius:4px;font-size:.8rem;display:flex;align-items:center;gap:.5rem;';
            div.innerHTML = `<i class="bi bi-exclamation-triangle-fill" style="color:#dc2626;font-size:.95rem;flex-shrink:0;"></i>
                <span><strong style="color:#b91c1c;">${hits} comprobante${hits !== 1 ? 's' : ''} de Legacy con proveedor SSCO</strong>
                — el proveedor figura en la lista SUNAT de Sujetos Sin Capacidad Operativa.
                ${fchCarga ? `<span class="text-muted ms-2" style="font-size:.72rem;">Padrón: ${fchCarga} — ${sujetos?.toLocaleString() ?? '?'} sujetos</span>` : ''}
                </span>`;
        } else {
            div.style.cssText = 'margin:.5rem .75rem 0;padding:.35rem .75rem;background:rgba(21,128,61,.07);border-left:4px solid #16a34a;border-radius:4px;font-size:.78rem;display:flex;align-items:center;gap:.5rem;';
            div.innerHTML = `<i class="bi bi-shield-check" style="color:#16a34a;font-size:.9rem;"></i>
                <span style="color:#15803d;"><strong>Sin coincidencias</strong> — ningún proveedor del período aparece en el padrón SSCO.
                ${fchCarga ? `<span class="text-muted ms-auto" style="font-size:.7rem;">Padrón: ${fchCarga} — ${sujetos?.toLocaleString() ?? '?'} sujetos</span>` : ''}
                </span>`;
        }

        if (existing) {
            // Reemplazar in-place
            existing.replaceWith(div);
        } else {
            // Insertar antes de la tabla (primera vez después de descarga sin recarga)
            const tabla = panel.querySelector('.table-responsive');
            if (tabla) panel.insertBefore(div, tabla);
            else panel.appendChild(div);
        }
    }

    // Animación spin para el icono de carga del paso activo
    (function() {
        if (document.getElementById('sscoSpinStyle')) return;
        const st = document.createElement('style');
        st.id = 'sscoSpinStyle';
        st.textContent = '@@keyframes sscoSpin{to{transform:rotate(360deg)}} .spin{display:inline-block;animation:sscoSpin .8s linear infinite;}';
        document.head.appendChild(st);
    })();
</script>
