                                          <div><span class="tt-lbl">Merma salida</span><span class="tt-val">@(cc.MermaFin.HasValue ? $"{cc.MermaFin.Value:N2} kg" : "—")</span></div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(cc.Tono) || !string.IsNullOrEmpty(cc.Solidez) || !string.IsNullOrEmpty(cc.Igualdad) || !string.IsNullOrEmpty(cc.Defecto))
                                        {
                                          <div class="d-flex flex-wrap gap-3">
                                            @if (!string.IsNullOrEmpty(cc.Tono))
                                            {
                                              <div><span class="tt-lbl">Tono</span><span class="tt-val">@cc.Tono</span></div>
                                            }
                                            @if (!string.IsNullOrEmpty(cc.Solidez))
                                            {
                                              <div><span class="tt-lbl">Solidez (SF)</span><span class="tt-val">@cc.Solidez</span></div>
                                            }
                                            @if (!string.IsNullOrEmpty(cc.Igualdad))
                                            {
                                              <div><span class="tt-lbl">Igualdad (SI)</span><span class="tt-val">@cc.Igualdad</span></div>
                                            }
                                            @if (!string.IsNullOrEmpty(cc.Defecto))
                                            {
                                              <div><span class="tt-lbl text-danger">Defecto</span><span class="tt-val text-danger fw-semibold">@cc.Defecto</span></div>
                                            }
