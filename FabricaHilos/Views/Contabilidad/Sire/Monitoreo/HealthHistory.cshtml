@model IReadOnlyList<FabricaHilos.Models.Sire.SireHealthCheckLog>

@{
    ViewData["Title"] = "Historial de Health Checks SIRE";

    string BadgeStatus(string status) => status switch
    {
        "Healthy" => "bg-success",
        "Degraded" => "bg-warning text-dark",
        "Unhealthy" => "bg-danger",
        _ => "bg-secondary"
    };

    string IconStatus(string status) => status switch
    {
        "Healthy" => "bi-check-circle-fill text-success",
        "Degraded" => "bi-exclamation-triangle-fill text-warning",
        "Unhealthy" => "bi-x-circle-fill text-danger",
        _ => "bi-question-circle"
    };

    // Estadísticas
    var healthy = Model.Count(x => x.Status == "Healthy");
    var degraded = Model.Count(x => x.Status == "Degraded");
    var unhealthy = Model.Count(x => x.Status == "Unhealthy");
    var uptimePercent = Model.Any() ? Math.Round((double)healthy / Model.Count * 100, 1) : 0;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Contabilidad" asp-action="Index">Contabilidad</a></li>
    <li class="breadcrumb-item"><a asp-controller="Sire" asp-action="Index">SIRE</a></li>
    <li class="breadcrumb-item active">Monitoreo - Health Checks</li>
}

<!-- Header Section -->
<div class="d-flex align-items-center gap-3 mb-4">
    <div class="bg-secondary rounded-3 p-2 d-flex align-items-center justify-content-center" style="width:48px;height:48px">
        <i class="bi bi-graph-up fs-4 text-white"></i>
    </div>
    <div class="flex-grow-1">
        <h4 class="mb-0 fw-semibold">Monitoreo — Historial de Health Checks</h4>
        <small class="text-muted">Disponibilidad continua de servicios SIRE / SUNAT</small>
    </div>
    <a asp-controller="Sire" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Volver al dashboard
    </a>
</div>

<!-- Estadísticas rápidas -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-success bg-opacity-10">
            <div class="card-body text-center">
                <div class="display-6 fw-bold text-success">@healthy</div>
                <div class="small text-muted">Operacional</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-warning bg-opacity-10">
            <div class="card-body text-center">
                <div class="display-6 fw-bold text-warning">@degraded</div>
                <div class="small text-muted">Degradado</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-danger bg-opacity-10">
            <div class="card-body text-center">
                <div class="display-6 fw-bold text-danger">@unhealthy</div>
                <div class="small text-muted">No disponible</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-info bg-opacity-10">
            <div class="card-body text-center">
                <div class="display-6 fw-bold text-info">@uptimePercent%</div>
                <div class="small text-muted">Disponibilidad</div>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de historial -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-light d-flex align-items-center gap-2">
        <i class="bi bi-clock-history text-secondary"></i>
        <strong>Registro de Health Checks</strong>
        <span class="badge bg-secondary ms-auto">@Model.Count evento(s)</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:180px">Timestamp (UTC)</th>
                        <th style="width:120px">Estado</th>
                        <th>Descripción</th>
                        <th class="text-center" style="width:100px">Token</th>
                        <th class="text-center" style="width:100px">RVIE</th>
                        <th class="text-center" style="width:100px">RCE</th>
                        <th class="text-center" style="width:80px">Alerta</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            Sin registros de health checks aún.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var log in Model.OrderByDescending(x => x.FechaUtc))
                    {
                        <tr>
                            <td>
                                <small class="text-monospace">@log.FechaUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</small>
                            </td>
                            <td>
                                <span class="badge @BadgeStatus(log.Status)">
                                    <i class="bi @IconStatus(log.Status)"></i>
                                    @log.Status
                                </span>
                            </td>
                            <td>
                                <small>@log.Descripcion</small>
                            </td>
                            <td class="text-center">
                                @if (log.AuthOk)
                                {
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                    <br />
                                    <small class="text-muted">@(log.TokenMinutosRestantes?.ToString("F1") ?? "—") min</small>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle-fill text-danger"></i>
                                }
                            </td>
                            <td class="text-center">
                                @if (log.RvieOk)
                                {
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                    <br />
                                    <small class="text-muted">@log.RviePeriodos p.</small>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle-fill text-danger"></i>
                                    @if (!string.IsNullOrEmpty(log.RvieError))
                                    {
                                        <br />
                                        <small class="text-danger" title="@log.RvieError">err</small>
                                    }
                                }
                            </td>
                            <td class="text-center">
                                @if (log.RceOk)
                                {
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                    <br />
                                    <small class="text-muted">@log.RcePeriodos p.</small>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle-fill text-danger"></i>
                                    @if (!string.IsNullOrEmpty(log.RceError))
                                    {
                                        <br />
                                        <small class="text-danger" title="@log.RceError">err</small>
                                    }
                                }
                            </td>
                            <td class="text-center">
                                @if (log.AlertaEnviada)
                                {
                                    <i class="bi bi-bell-fill text-warning" title="Alerta enviada"></i>
                                    @if (log.UltimaAlertaUtc.HasValue)
                                    {
                                        <br />
                                        <small class="text-muted">@((DateTime.UtcNow - log.UltimaAlertaUtc.Value).TotalMinutes < 1 ? "ahora" : Math.Round((DateTime.UtcNow - log.UltimaAlertaUtc.Value).TotalMinutes) + " min")</small>
                                    }
                                }
                                else
                                {
                                    <i class="bi bi-bell text-muted"></i>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Nota de información -->
<div class="alert alert-info mt-4">
    <i class="bi bi-info-circle me-2"></i>
    <strong>Información:</strong> El monitoreo SIRE se ejecuta automáticamente cada 5 minutos. Los registros mostrados corresponden a los últimos 500 health checks.
</div>
