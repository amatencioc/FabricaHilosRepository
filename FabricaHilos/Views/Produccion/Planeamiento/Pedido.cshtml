</div>
@section Scripts {
<script>
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el =>
        new bootstrap.Tooltip(el, { placement: 'top' }));

    // Carga descripción + material de artículos sin cambiar el modelo
    (async function () {
        const cards = document.querySelectorAll('[data-codartt]');
        const unique = [...new Set([...cards].map(c => c.dataset.codartt).filter(Boolean))];
        for (const cod of unique) {
            try {
                const res  = await fetch(`/Planeamiento/GetArticuloInfo?codArt=${encodeURIComponent(cod)}`);
                if (!res.ok) continue;
                const info = await res.json();
                const parts = [info.descripcion, info.fibra].filter(x => x);
                if (!parts.length) continue;
                const text = parts.join(' · ');
                document.querySelectorAll(`[data-codartt="${CSS.escape(cod)}"] .art-desc-info`)
                        .forEach(el => el.textContent = text);
            } catch { /* silencioso */ }
        }
    })();

    // Estado en tiempo real de maquinas TT
    (async function () {
        const maqs = [...new Set([...document.querySelectorAll('[data-maq]')].map(el => el.dataset.maq).filter(Boolean))];
        for (const cod of maqs) {
            try {
                const res = await fetch(`/Planeamiento/GetMaquinaStatus?codMaq=${encodeURIComponent(cod)}`);
                if (!res.ok) continue;
                const info = await res.json();
                document.querySelectorAll(`[data-maq="${CSS.escape(cod)}"]`).forEach(el => {
                    if (!el.classList.contains('maq-box')) return;
                    const liveDiv   = el.querySelector('.maq-live');
                    const txt       = el.querySelector('.live-txt');
                    const cargaFill = el.querySelector('.maq-carga-fill');
                    const cargaPct  = el.querySelector('.maq-carga-pct');
                    const cerrado   = el.dataset.cerrado === 'true';
                    if (!liveDiv) return;
                    liveDiv.classList.remove('loading');
                    if (info.esLibre) {
                        liveDiv.classList.add('libre');
                        if (txt) txt.textContent = 'Disponible — sin actividad ahora';
                    } else {
                        liveDiv.classList.add('ocupada');
                        const n     = info.banosActivos;
                        const propio = el.dataset.propio === 'true';
                        if (txt) txt.textContent = (cerrado || !propio)
                            ? `En uso por otro lote · ${n} baño${n !== 1 ? 's' : ''} activo${n !== 1 ? 's' : ''}`
                            : `Ocupada · ${n} baño${n !== 1 ? 's' : ''} en proceso`;
                    }
                    // Barra de carga — siempre actualizar
                    if (cargaPct) {
                        if (info.hayCargaHoy) {
                            const pct  = Math.min(100, Math.max(0, info.pctCargaHoy));
                            const dias = info.diasAntiguo;
                            const lbl  = el.querySelector('.maq-carga-lbl');
                            if (lbl) lbl.textContent = dias === 0 ? 'Hoy:' : dias === 1 ? 'Ayer:' : `Hace ${dias}d:`;
                            if (cargaFill) {
                                cargaFill.style.width = pct + '%';
                                cargaFill.classList.toggle('alta',         pct >= 60 && pct < 90);
                                cargaFill.classList.toggle('sobrecargada', pct >= 90);
                            }
                            cargaPct.textContent = pct.toFixed(0) + '%';
                        } else if (info.banosActivos > 0) {
                            // Sin datos en PLN_CARGA_DIARIA → barra estimada por baños activos
                            const n       = info.banosActivos;
                            const estimado = Math.min(100, n * 40);   // 1 baño≈40%, 2≈80%, 3+=100%
                            const lbl = el.querySelector('.maq-carga-lbl');
                            if (lbl) lbl.textContent = 'En uso:';
                            if (cargaFill) {
                                cargaFill.style.width = estimado + '%';
                                cargaFill.classList.toggle('alta',         estimado >= 60 && estimado < 90);
                                cargaFill.classList.toggle('sobrecargada', estimado >= 90);
                            }
                            cargaPct.textContent = `~${estimado}%`;
                        } else {
                            cargaPct.textContent = 'Sin actividad';
                        }
                    }
                });
            } catch { /* silencioso */ }
        }
    })();
</script>
}
