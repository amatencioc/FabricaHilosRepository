@model FabricaHilos.Models.Logistica.IndLogisticaDashboardViewModel
@using System.Globalization
@using System.Text.Json

@{
    var culture = CultureInfo.GetCultureInfo("es-PE");
    string FmtFecha(DateTime? d) => d?.ToString("dd/MM/yyyy") ?? "-";
    string FmtNum(decimal v, int dec = 0) => v.ToString("N" + dec, culture);
    string FmtMon(decimal v) => v.ToString("N2", culture);

    string periodo = $"{FmtFecha(Model.FechaDesde)} — {FmtFecha(Model.FechaHasta)}";

    // ── KPI Cards ─────────────────────────────────────────────────────────────
    int    totalReqs   = Model.Resumen.Sum(r => r.CantReqs);
    int    totalItems  = Model.Resumen.Sum(r => r.CantItems);
    decimal montoTotal = Model.Resumen.Sum(r => r.MontoTotal);
    int    pendItems   = Model.Pendientes.Count;

    // ── Datos para gráficos ───────────────────────────────────────────────────
    // Gráfico 1: Resumen por tipo/estado (barras apiladas)
    var resumenJson = JsonSerializer.Serialize(Model.Resumen.Select(r => new {
        tipo  = r.Tipo,
        estado= r.Estado,
        reqs  = r.CantReqs,
        items = r.CantItems,
        monto = r.MontoTotal,
        pct   = r.PctAtendido
    }));

    // Gráfico 2: Tiempos (doughnut / barras horizontales)
    var tiemposJson = Model.Tiempos == null ? "null" : JsonSerializer.Serialize(new {
        total  = Model.Tiempos.TotalReqs,
        t1     = Model.Tiempos.DiasRegAutorizacion,
        t2     = Model.Tiempos.DiasAutRecibo,
        t3     = Model.Tiempos.DiasReciboOc,
        ciclo  = Model.Tiempos.DiasCicloTotal
    });

    // Gráfico 3: Top centro de costos (barras horizontales)
    var topCcJson = JsonSerializer.Serialize(Model.TopCcosto.Select(c => new {
        desc  = (c.DescDestino ?? c.Destino ?? "-").Length > 30
                    ? (c.DescDestino ?? c.Destino ?? "-")[..30] + "…"
                    : (c.DescDestino ?? c.Destino ?? "-"),
        monto = c.MontoTotal,
        items = c.CantItems
    }));
}

<!-- ── Título y período ───────────────────────────────────────────────── -->
<div class="text-center mb-4">
    <h5 class="fw-bold text-uppercase mb-1" style="color:#8B5E3C; letter-spacing:.06em; font-size:.95rem;">
        KPI Logística — Indicadores de Requisiciones
    </h5>
    <p class="text-muted mb-0" style="font-size:.8rem;">Periodo: @periodo</p>
</div>

<!-- ── KPI Cards ─────────────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="kpi-card accent-green">
            <div class="kpi-icon">📋</div>
            <div class="kpi-label">Total Requisiciones</div>
            <div class="kpi-value" style="color:#1B4D3E;">@FmtNum(totalReqs)</div>
            <div class="kpi-sub">en el período</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card accent-blue">
            <div class="kpi-icon">📦</div>
            <div class="kpi-label">Total Ítems</div>
            <div class="kpi-value" style="color:#1565C0;">@FmtNum(totalItems)</div>
            <div class="kpi-sub">líneas de requisición</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card accent-orange">
            <div class="kpi-icon">💰</div>
            <div class="kpi-label">Monto Total (S/)</div>
            <div class="kpi-value" style="color:#e65100; font-size:1.5rem;">@FmtMon(montoTotal)</div>
            <div class="kpi-sub">inc. IGV donde aplica</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card accent-purple">
            <div class="kpi-icon">⏳</div>
            <div class="kpi-label">Ítems Pendientes</div>
            <div class="kpi-value" style="color:#4A148C;">@FmtNum(pendItems)</div>
            <div class="kpi-sub">con saldo por despachar</div>
        </div>
    </div>
</div>

@if (Model.Tiempos != null)
{
    <!-- ── Tiempos del ciclo logístico ──────────────────────────────── -->
    <div class="section-title">⏱️ Tiempos Promedio del Ciclo Logístico (@FmtNum(Model.Tiempos.TotalReqs) requisiciones)</div>
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="fs-4 mb-1">📝</div>
                <div style="font-size:.68rem; color:#6b7280; font-weight:700; text-transform:uppercase;">Reg. → Autorización</div>
                <div class="fw-bold fs-5" style="color:#1B4D3E;">@FmtNum(Model.Tiempos.DiasRegAutorizacion,1) días</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="fs-4 mb-1">✅</div>
                <div style="font-size:.68rem; color:#6b7280; font-weight:700; text-transform:uppercase;">Aut. → Recibo Log.</div>
                <div class="fw-bold fs-5" style="color:#1565C0;">@FmtNum(Model.Tiempos.DiasAutRecibo,1) días</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="fs-4 mb-1">🛒</div>
                <div style="font-size:.68rem; color:#6b7280; font-weight:700; text-transform:uppercase;">Recibo → OC</div>
                <div class="fw-bold fs-5" style="color:#e65100;">@FmtNum(Model.Tiempos.DiasReciboOc,1) días</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="fs-4 mb-1">🔄</div>
                <div style="font-size:.68rem; color:#6b7280; font-weight:700; text-transform:uppercase;">Ciclo Total</div>
                <div class="fw-bold fs-5" style="color:#4A148C;">@FmtNum(Model.Tiempos.DiasCicloTotal,1) días</div>
            </div>
        </div>
    </div>

    <!-- Gráfico: Tiempos del ciclo (barras horizontales) -->
    <div class="row mb-4">
        <div class="col-md-7">
            <div class="card border-0 shadow-sm p-3">
                <div class="section-title mt-0">📊 Desglose del Ciclo (días promedio)</div>
                <canvas id="chartTiempos" height="90"></canvas>
            </div>
        </div>
        <div class="col-md-5">
            <div class="card border-0 shadow-sm p-3">
                <div class="section-title mt-0">📊 Resumen por Estado</div>
                <canvas id="chartEstados" height="160"></canvas>
            </div>
        </div>
    </div>
}
else
{
    <div class="row mb-4">
        <div class="col">
            <div class="card border-0 shadow-sm p-3">
                <div class="section-title mt-0">📊 Resumen por Estado</div>
                <canvas id="chartEstados" height="120"></canvas>
            </div>
        </div>
    </div>
}

<!-- ── Top 10 Centros de Costo ────────────────────────────────────────── -->
@if (Model.TopCcosto.Any())
{
    <div class="section-title">🏭 Top 10 Destinos por Monto Solicitado</div>
    <div class="row mb-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm p-3">
                <canvas id="chartTopCcosto" height="180"></canvas>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm p-3" style="max-height:380px; overflow-y:auto;">
                <table class="table table-sm table-hover mb-0" style="font-size:.78rem;">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Destino</th>
                            <th class="text-end">Ítems</th>
                            <th class="text-end">Monto (S/)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.TopCcosto.Count; i++)
                        {
                            var t = Model.TopCcosto[i];
                            <tr>
                                <td class="fw-bold text-muted">@(i + 1)</td>
                                <td title="@t.Destino">@(t.DescDestino ?? t.Destino ?? "-")</td>
                                <td class="text-end">@FmtNum(t.CantItems)</td>
                                <td class="text-end fw-semibold">@FmtMon(t.MontoTotal)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- ── Ítems Pendientes ───────────────────────────────────────────────── -->
@if (Model.Pendientes.Any())
{
    <div class="section-title">⏳ Ítems con Saldo Pendiente de Despacho</div>
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-0">
            <div style="max-height:380px; overflow-y:auto;">
                <table class="table table-sm table-hover mb-0" style="font-size:.78rem;">
                    <thead class="table-dark sticky-top">
                        <tr>
                            <th>Nro. Req.</th>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th>Solicita</th>
                            <th>Cód. Art.</th>
                            <th>Artículo</th>
                            <th class="text-end">Saldo</th>
                            <th class="text-end">Mto. Pend. (S/)</th>
                            <th class="text-end">Días Espera</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Pendientes)
                        {
                            string alertClass = p.DiasEnEspera >= 30 ? "table-danger"
                                              : p.DiasEnEspera >= 15 ? "table-warning"
                                              : "";
                            <tr class="@alertClass">
                                <td class="fw-semibold">@p.NumReq</td>
                                <td>@FmtFecha(p.Fecha)</td>
                                <td><span class="badge @(p.Tipo == "SERVICIO" ? "bg-info text-dark" : "bg-secondary")">@p.Tipo</span></td>
                                <td>@(p.Solicita ?? "-")</td>
                                <td>@(p.CodArt ?? "-")</td>
                                <td>@(p.DescArticulo ?? "-")</td>
                                <td class="text-end">@FmtNum(p.Saldo, 2)</td>
                                <td class="text-end fw-semibold">@FmtMon(p.MontoPendiente)</td>
                                <td class="text-end">
                                    @if (p.DiasEnEspera.HasValue)
                                    {
                                        <span class="badge @(p.DiasEnEspera >= 30 ? "bg-danger" : p.DiasEnEspera >= 15 ? "bg-warning text-dark" : "bg-success")">
                                            @p.DiasEnEspera d
                                        </span>
                                    }
                                    else { <span class="text-muted">-</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- ── Datos JSON para Chart.js ──────────────────────────────────────── -->
<input type="hidden" id="indLogResumenJson"  value='@Html.Raw(resumenJson)'  />
<input type="hidden" id="indLogTiemposJson"  value='@Html.Raw(tiemposJson)'  />
<input type="hidden" id="indLogTopCcJson"    value='@Html.Raw(topCcJson)'    />

<script>
window.initIndLogisticaCharts = function () {
    // ── Gráfico: Resumen por Estado ────────────────────────────────────
    const resumen = JSON.parse(document.getElementById('indLogResumenJson').value || '[]');
    const estadosUnicos = [...new Set(resumen.map(r => r.estado))];
    const tiposUnicos   = [...new Set(resumen.map(r => r.tipo))];
    const colores = ['#1B4D3E','#1565C0','#e65100','#4A148C','#C62828','#2E7D32','#00838F','#F57F17'];

    const ctxEst = document.getElementById('chartEstados');
    if (ctxEst) {
        const datasets = tiposUnicos.map((tipo, i) => ({
            label: tipo,
            data: estadosUnicos.map(est => {
                const r = resumen.find(x => x.tipo === tipo && x.estado === est);
                return r ? r.reqs : 0;
            }),
            backgroundColor: colores[i % colores.length] + 'cc',
            borderColor: colores[i % colores.length],
            borderWidth: 1
        }));
        new Chart(ctxEst, {
            type: 'bar',
            data: { labels: estadosUnicos, datasets },
            options: {
                responsive: true,
                plugins: { legend: { position: 'bottom' }, tooltip: { mode: 'index' } },
                scales: { x: { stacked: true }, y: { stacked: true, beginAtZero: true } }
            }
        });
    }

    // ── Gráfico: Tiempos del ciclo ─────────────────────────────────────
    const tiempos = JSON.parse(document.getElementById('indLogTiemposJson').value || 'null');
    const ctxTiempos = document.getElementById('chartTiempos');
    if (ctxTiempos && tiempos) {
        new Chart(ctxTiempos, {
            type: 'bar',
            data: {
                labels: ['Reg. → Autorización', 'Aut. → Recibo Log.', 'Recibo Log. → OC', 'Ciclo Total'],
                datasets: [{
                    label: 'Días promedio',
                    data: [tiempos.t1, tiempos.t2, tiempos.t3, tiempos.ciclo],
                    backgroundColor: ['#1B4D3Ecc','#1565C0cc','#e65100cc','#4A148Ccc'],
                    borderColor:     ['#1B4D3E',  '#1565C0',  '#e65100',  '#4A148C'],
                    borderWidth: 1
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { x: { beginAtZero: true, title: { display: true, text: 'Días' } } }
            }
        });
    }

    // ── Gráfico: Top 10 centros de costo ───────────────────────────────
    const topCc = JSON.parse(document.getElementById('indLogTopCcJson').value || '[]');
    const ctxTop = document.getElementById('chartTopCcosto');
    if (ctxTop && topCc.length) {
        new Chart(ctxTop, {
            type: 'bar',
            data: {
                labels: topCc.map(x => x.desc),
                datasets: [{
                    label: 'Monto (S/)',
                    data: topCc.map(x => x.monto),
                    backgroundColor: '#8B5E3Ccc',
                    borderColor: '#8B5E3C',
                    borderWidth: 1
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                plugins: { legend: { display: false }, tooltip: {
                    callbacks: {
                        label: ctx => ' S/ ' + ctx.parsed.x.toLocaleString('es-PE', { minimumFractionDigits: 2 })
                    }
                }},
                scales: { x: { beginAtZero: true } }
            }
        });
    }
};

// Auto-inicializar si Chart.js ya está disponible (carga normal)
if (typeof Chart !== 'undefined') window.initIndLogisticaCharts();
</script>
