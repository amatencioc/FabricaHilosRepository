@model FabricaHilos.Models.Capacitacion.CapCertificado
@{
    Layout = null;

    var empresaNombre  = ViewBag.EmpresaNombre  as string ?? "FABRICA DE HILOS S.A.";
    var empresaNombreC = ViewBag.EmpresaNombreC as string ?? empresaNombre;
    var empresaRuc     = ViewBag.EmpresaRuc     as string ?? "";
    var logoUrl        = ViewBag.LogoUrl        as string;
    var logoIconUrl    = ViewBag.LogoIconUrl    as string;

    string[] meses = new[] { "enero","febrero","marzo","abril","mayo","junio",
                              "julio","agosto","septiembre","octubre","noviembre","diciembre" };
    var fechaTexto = $"{Model.FchEmision.Day} de {meses[Model.FchEmision.Month - 1]} de {Model.FchEmision.Year}";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Certificado &mdash; @Model.NombreUsuario &mdash; @empresaNombre</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        /* Toolbar */
        .cert-toolbar {
            width: 100%; position: sticky; top: 0; z-index: 100;
            background: #2E7D32; color: #fff;
            display: flex; align-items: center; gap: 8px;
            padding: 8px 14px; box-shadow: 0 2px 6px rgba(0,0,0,.2);
        }
        .ct-btn {
            display: inline-flex; align-items: center; gap: 5px;
            border: none; border-radius: 5px; padding: 6px 14px;
            font-size: 9pt; font-weight: 600; cursor: pointer;
            text-decoration: none; transition: opacity .15s;
        }
        .ct-btn:hover { opacity: .85; }
        .ct-back  { background: #1B5E20; color: #fff; }
        .ct-print { background: #C8A951; color: #3E2723; }
        .ct-title { margin-left: auto; font-size: 9pt; opacity: .85; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        @@media screen and (max-width: 600px) { .ct-title { display: none; } }

        /* Centrar certificado en pantalla */
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #e0e4e8;
            display: flex; flex-direction: column; align-items: center;
            min-height: 100vh; margin: 0; padding: 0;
        }
        .page-wrap {
            flex: 1; display: flex; align-items: center;
            justify-content: center; padding: 10px 8px; width: 100%;
        }

        /*
         * LANDSCAPE A4: 297mm x 210mm  (ratio 1.4142:1)
         * Escala para caber en la ventana sin scroll.
         */
        .page {
            --avail-h: calc(100vh - 46px - 20px);
            --avail-w: calc(100vw - 16px);
            height: min(var(--avail-h), calc(var(--avail-w) / 1.4142));
            width:  min(calc(var(--avail-h) * 1.4142), var(--avail-w));
            background: #fff;
            box-shadow: 0 4px 28px rgba(0,0,0,.20);
            border-radius: 4px; overflow: hidden; position: relative;
            display: flex; flex-direction: column;
            container-type: size; container-name: cert;
        }

        /* Esquinas verdes */
        .corner { position: absolute; width: 0; height: 0; border-style: solid; }
        .corner-tr-1 { top:0;right:0;   border-width:0 20cqh 20cqh 0; border-color:transparent #1B5E20 transparent transparent; }
        .corner-tr-2 { top:0;right:0;   border-width:0 14cqh 14cqh 0; border-color:transparent #2E7D32 transparent transparent; }
        .corner-tr-3 { top:0;right:0;   border-width:0  9cqh  9cqh 0; border-color:transparent #43A047 transparent transparent; }
        .corner-bl-1 { bottom:0;left:0; border-width:20cqh 0 0 20cqh; border-color:transparent transparent transparent #1B5E20; }
        .corner-bl-2 { bottom:0;left:0; border-width:14cqh 0 0 14cqh; border-color:transparent transparent transparent #2E7D32; }
        .corner-bl-3 { bottom:0;left:0; border-width: 9cqh 0 0  9cqh; border-color:transparent transparent transparent #43A047; }

        /* Cuerpo */
        .cert-body {
            flex: 1; display: flex; flex-direction: column;
            align-items: center; justify-content: space-between;
            padding: 4cqh 6cqw 3cqh; position: relative; z-index: 1;
        }
        .cert-top    { width:100%; display:flex; flex-direction:column; align-items:center; }
        .cert-bottom { width:100%; display:flex; flex-direction:column; align-items:center; }

        /* Logo */
        .cert-logo-wrap { align-self:flex-start; display:flex; align-items:center; gap:1.2cqw; }
        .cert-logo-img  { max-height:14cqh; max-width:32cqw; object-fit:contain; background:transparent; }
        .cert-logo-icon { height:12cqh; width:auto; object-fit:contain; }
        .cert-logo-name { display:flex; flex-direction:column; line-height:1.15; }
        .cert-logo-name span:first-child { font-size:3.5cqh; font-weight:800; color:#1B5E20; }
        .cert-logo-name span:last-child  { font-size:1.5cqh; font-weight:600; color:#555; letter-spacing:.07em; text-transform:uppercase; }
        .cert-logo-text { align-self:flex-start; font-size:3cqh; font-weight:700; color:#1B5E20; }
        .cert-logo-sub  { align-self:flex-start; font-size:1.3cqh; color:#555; }

        /* Titulo */
        .cert-title    { margin-top:2.5cqh; font-size:11cqh; font-weight:900; color:#1a1a1a; letter-spacing:.02em; line-height:1; text-align:center; }
        .cert-subtitle { font-size:4cqh; font-weight:700; color:#2E7D32; text-align:center; margin-top:0.5cqh; }

        /* Divisor */
        .cert-divider      { width:100%; display:flex; align-items:center; gap:1.5cqw; margin:2cqh 0; }
        .cert-divider-line { flex:1; height:1.5px; background:#2E7D32; }
        .cert-divider-gem  { font-size:2cqh; color:#2E7D32; }

        /* Nombre */
        .cert-label     { font-size:2.2cqh; font-style:italic; color:#555; text-align:center; margin-bottom:0.8cqh; }
        .cert-name      { font-size:5.8cqh; font-weight:700; color:#1a1a1a; text-align:center; white-space:nowrap; }
        .cert-name-line { width:100%; height:2px; background:#2E7D32; margin:1.5cqh 0; }

        /* Texto curso */
        .cert-text { font-size:2.6cqh; color:#555; text-align:center; line-height:1.55; max-width:75cqw; }
        .cert-text strong { color:#1a1a1a; }
        .cert-text .nota  { color:#C8860A; font-weight:700; }

        /* Fecha */
        .cert-fecha { font-size:2.6cqh; color:#555; text-align:center; margin-top:0.8cqh; }

        /* Firma */
        .cert-firma-wrap   { display:flex; justify-content:center; margin-bottom:0.8cqh; }
        .cert-firma        { width:30cqw; text-align:center; }
        .cert-firma-line   { height:1.5px; background:#1a1a1a; margin-bottom:0.8cqh; }
        .cert-firma-nombre { font-size:2cqh; font-weight:700; color:#1a1a1a; white-space:nowrap; }
        .cert-firma-cargo  { font-size:1.8cqh; color:#555; }

        /* Codigo verificacion */
        .cert-cod   { font-size:1.4cqh; color:#999; text-align:center; }
        .cert-cod a { color:#999; text-decoration:none; }

        /* PRINT: A4 landscape */
        @@media print {
            .cert-toolbar { display:none !important; }
            body { background:#fff; margin:0; padding:0; display:block; }
            .page-wrap { padding:0; display:block; }
            @@page { size: A4 landscape; margin:0; }
            .page {
                width:297mm; height:210mm;
                max-width:none; max-height:none;
                box-shadow:none; border-radius:0;
                container-type:size;
                -webkit-print-color-adjust:exact !important;
                print-color-adjust:exact !important;
            }
        }
    </style>
</head>
<body>

<!-- Barra de herramientas -->
<div class="cert-toolbar">
    <button class="ct-btn ct-back" onclick="history.back()">&#8592; Volver</button>
    <button class="ct-btn ct-print" onclick="window.print()">&#128438; Imprimir / Guardar PDF</button>
    <span class="ct-title">Certificado &mdash; @Model.NombreUsuario &nbsp;&middot;&nbsp; @empresaNombre</span>
</div>

<div class="page-wrap">
<div class="page">
    <!-- Esquinas decorativas -->
    <div class="corner corner-tr-1"></div>
    <div class="corner corner-tr-2"></div>
    <div class="corner corner-tr-3"></div>
    <div class="corner corner-bl-1"></div>
    <div class="corner corner-bl-2"></div>
    <div class="corner corner-bl-3"></div>

    <div class="cert-body">
      <div class="cert-top">

        <!-- Logo -->
        @if (!string.IsNullOrWhiteSpace(logoUrl))
        {
            <div class="cert-logo-wrap">
                <img src="@logoUrl" alt="@empresaNombre" class="cert-logo-img" />
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(logoIconUrl))
        {
            <div class="cert-logo-wrap">
                <img src="@logoIconUrl" alt="@empresaNombreC" class="cert-logo-icon" />
                <div class="cert-logo-name">
                    <span>@empresaNombreC</span>
                    <span>@empresaNombre</span>
                </div>
            </div>
        }
        else
        {
            <div class="cert-logo-text">@empresaNombre</div>
            @if (!string.IsNullOrWhiteSpace(empresaRuc))
            {
                <div class="cert-logo-sub">RUC: @empresaRuc</div>
            }
        }

        <!-- Titulo -->
        <div class="cert-title">CERTIFICADO</div>
        <div class="cert-subtitle">DE APROBACI&Oacute;N</div>

        <!-- Divisor -->
        <div class="cert-divider">
            <div class="cert-divider-line"></div>
            <span class="cert-divider-gem">&#9670;</span>
            <div class="cert-divider-line"></div>
        </div>

        <!-- Nombre -->
        <div class="cert-label">Otorgado a</div>
        <div class="cert-name">@Model.NombreUsuario</div>
        <div class="cert-name-line"></div>

        <!-- Descripcion -->
        <p class="cert-text">
            Por haber completado satisfactoriamente la capacitaci&oacute;n de
            <strong>@Model.TituloCurso</strong>,
            alcanzando la nota: <span class="nota">@Model.PuntajeObt.ToString("F0")</span>.
        </p>

        <!-- Fecha -->
        <div class="cert-fecha">Callao, @fechaTexto</div>

      </div><!-- /cert-top -->

      <div class="cert-bottom">

        <!-- Firma -->
        <div class="cert-firma-wrap">
            <div class="cert-firma">
                <div class="cert-firma-line"></div>
                <div class="cert-firma-nombre">FERNANDO FIOCCO BLOISA</div>
                <div class="cert-firma-cargo">Gerente General</div>
            </div>
        </div>

        <!-- Codigo de verificacion -->
        <div class="cert-cod">
            &#128274; C&oacute;digo de verificaci&oacute;n: <strong>@Model.CodigoVerif</strong>
            &nbsp;&middot;&nbsp;
            <a href="/RecursosHumanos/Certificado/Verificar?c=@Model.CodigoVerif" target="_blank">
                Verificar en l&iacute;nea &#8594;
            </a>
        </div>

      </div><!-- /cert-bottom -->

    </div><!-- /cert-body -->
</div><!-- /page -->
</div><!-- /page-wrap -->

<script>
    if (new URLSearchParams(window.location.search).get('print') === '1') {
        window.addEventListener('load', function () { window.print(); });
    }
</script>
</body>
</html>