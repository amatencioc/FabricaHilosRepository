@model FabricaHilos.Models.Produccion.Planeamiento.PlnPedidoViewModel
@using FabricaHilos.Models.Produccion.Planeamiento

@{
    ViewData["Title"] = $"Gantt — Pedido {Model.Serie}-{Model.NumPed}";

    var primerItem = Model.Items.FirstOrDefault();
    var pasoMap    = Model.Pasos.ToDictionary(p => p.CodPaso);
    // Nombre y color dinámicos desde PLN_ESTADO_CODIGO (fallback al valor hardcoded si el paso no existe).
    // CRÍTICO: '05'=Laboratorio, '03'=En Hilan., '04'=Lote Disp. — NO intercambiar los códigos.
    Func<string, string, string> Nm = (cod, fb) => pasoMap.TryGetValue(cod, out var ecN) ? ecN.NombrePaso : fb;
    Func<string, string, string> Cl = (cod, fb) => pasoMap.TryGetValue(cod, out var ecC) ? ecC.ColorUi   : fb;
    var detCodArt  = Model.Items
        .DistinctBy(x => x.Nro)
        .ToDictionary(x => x.Nro, x => x.CodArt);

    // Rango de fechas del eje X
    // Incluye tanto los campos directos de PlnSeguimiento como las fechas
    // derivadas de DetalleTt (misma fuente que Pedido.cshtml) para que las
    // barras del Gantt nunca queden fuera del eje visible.
    var todasFechas = Model.Items
        .SelectMany(s =>
        {
            PlnDetalleTt? _dt = null;
            if (s.NumPartida > 0) Model.DetalleTt.TryGetValue(s.NumPartida, out _dt);
            return new DateTime?[]
            {
                s.FchPedido,
                s.FchEntregaComp,
                s.FchEstHilanderia, s.FchEstPartida, s.FchEstTinIni,
                s.FchEstTinFin, s.FchEstSecado, s.FchEstCalidad, s.FchEstDespacho,
                s.FchRealProgramado, s.FchRealProduccion, s.FchRealPartida,
                s.FchRealTinIni, s.FchRealTinFin, s.FchRealSecado,
                s.FchRealCcTinto, s.FchRealDevanado, s.FchRealCalidad,
                s.FchRealAlmPt, s.FchRealDespacho,
                // Fechas reales desde DetalleTt (pueden diferir de los campos directos)
                _dt?.FechaPartida,
                _dt?.InicioTt,
                _dt?.FinTt,
                _dt?.Secado?.FechaFin,
                _dt?.Calidad != null ? (DateTime?)_dt.Calidad.Fecha : null,
                _dt?.ValidacionReceta?.FchValidacion,
                _dt?.ValidacionReceta?.FchRegistro,    // fuente de _ri02 (paso 02 ajuste lab)
                _dt?.Revisados.Count > 0 ? (DateTime?)_dt.Revisados.Min(r => r.FchRegistro) : null,
                _dt?.Revisados.Count > 0 && _dt.Revisados[0].Detalle.Count > 0
                    ? (DateTime?)_dt.Revisados[0].Detalle[0].Fecha : null,
                s.FchRealCcRechazo,                    // fuente del paso 9R (CC Rechazo)
            };
        })
        .Where(d => d.HasValue)
        .Select(d => d!.Value)
        .ToList();

    var hoy       = DateTime.Today;
    var fechaMin  = todasFechas.Any() ? todasFechas.Min().AddDays(-2) : hoy.AddDays(-3);
    var fechaMax  = todasFechas.Any() ? todasFechas.Max().AddDays(3)  : hoy.AddDays(10);
    var totalDias = (fechaMax - fechaMin).TotalDays;

    // Helpers de posición
    Func<DateTime?, double> pctLeft  = d =>
        d.HasValue ? Math.Max(0, (d.Value - fechaMin).TotalDays / totalDias * 100) : 0;

    Func<DateTime?, DateTime?, double> pctWidth = (ini, fin) =>
    {
        if (!ini.HasValue || !fin.HasValue) return 0;
        return Math.Max(0.8, (fin.Value - ini.Value).TotalDays / totalDias * 100);
    };

    // Pasos que muestran pin de fecha orientativa en el Gantt.
    // Un paso es "aproximado" cuando su fecha se deriva como proxy de otro hito,
    // no de un timestamp propio. La evaluación debe ser dinámica por sublote
    // (igual que Pedido.cshtml), pero aquí se usa un conjunto de candidatos;
    // el render final verifica si el dato real existe antes de mostrar el pin.
    // "05" Lote Disp.: siempre proxy (usa FCH_REAL_PARTIDA del paso anterior)
    // "07" Teñido Comp.: solo proxy cuando FinTt == null
    // "11" Revisado: solo proxy cuando no hay REVISADO_D
    // "12" Almacén PT: solo proxy cuando FCH_REAL_ALM_PT == null
    // NOTA: "03" ya NO está: ahora usa L_VALIDA_RECETA.FCH_VALIDACION (dato real)
    var pasosAproximados = new HashSet<string> { "05", "07", "11", "12" };
    var descripcionAprox = new Dictionary<string, string>
    {
        ["05"] = "Fecha proxy: fin de H_RPRODUC (lote disponible para TT). No tiene timestamp propio.",
        ["07"] = "Hito orientativo si no hay baños TT registrados (FinTt null). Cuando hay baños reales usa el mayor FECHA_FIN.",
        ["11"] = "Hito orientativo si no hay REVISADO_D registrado. Cuando existe usa la primera REVISADO_D.FECHA.",
        ["12"] = "Hito orientativo si no hay ingreso físico a almacén PT (FCH_REAL_ALM_PT null).",
    };

    // EffEst: si FCH_EST_* quedó desfasada (ej. backfill con SYSDATE) pero el
    // evento real ya ocurrió, usa la fecha real como fallback para la barra estimada.
    Func<DateTime?, DateTime?, DateTime?> EffEst = (est, real) =>
        (est == null || (real.HasValue && est.Value.Date > real.Value.Date)) ? real : est;

    Func<PlnSeguimiento, PlnDetalleTt?, List<(string Cod, string Nom, string Color,
         DateTime? EI, DateTime? EF, DateTime? RI, DateTime? RF)>> etapasDe = (s, dtFb) =>
    {
        // ── Fechas reales con fuente unificada (misma lógica que Pedido.cshtml) ──────
        // PASO '03' — Laboratorio: FchValidacion de L_VALIDA_RECETA; fallback: FCH_REAL_PRODUCCION
        var _rLab      = dtFb?.ValidacionReceta?.FchValidacion ?? s.FchRealProduccion;
        // PASO '04' — En Hilandería: PARTIDA.FECHA; fallback: FCH_REAL_PRODUCCION
        var _rHilan    = dtFb?.FechaPartida ?? s.FchRealProduccion;
        // PASO '05'/'06' inicio TT: menor FECHA_INI de baños (InicioTt); fallback: FCH_REAL_TIN_INI
        var _rTinIni   = dtFb?.InicioTt ?? s.FchRealTinIni;
        // PASO '06'/'07'/'08' fin TT: mayor FECHA_FIN de baños (FinTt); fallback: FCH_REAL_TIN_FIN
        var _rTinFin   = dtFb?.FinTt ?? s.FchRealTinFin;
        // PASO '08'/'09' inicio CC: fin de secado (TT_RSECADO); fallback: FCH_REAL_SECADO
        var _rSecado   = dtFb?.Secado?.FechaFin ?? s.FchRealSecado;
        // PASO '09' fin CC: CTCALIDAD_D.FECHA; fallback: FCH_REAL_CC_TINTO — idéntico a Pedido.cshtml paso "09" fReal.
        // NOTA: FCH_REAL_CALIDAD no se usa aquí (es un campo distinto, Pedido tampoco lo usa para este paso).
        var _rCcTinto  = (dtFb?.Calidad != null ? (DateTime?)dtFb.Calidad.Fecha : null)
                         ?? s.FchRealCcTinto;
        // PASO '09B' (Gaseado) — sin cambio, FCH_REAL_GASEADO es fuente directa
        // PASO '10' — Devanado: primer REVISADO_G.A_ADFECHA; fallback: FCH_REAL_DEVANADO
        var _rDevanado = (dtFb?.Revisados.Count > 0
                             ? (DateTime?)dtFb.Revisados.Min(r => r.FchRegistro)
                             : null)
                         ?? s.FchRealDevanado;
        // PASO '11' — Revisado: primera REVISADO_D.FECHA con aprobado > 0; fallback: FCH_REAL_CALIDAD
        var _rRevisado = (dtFb?.Revisados.Count > 0 && dtFb.Revisados[0].Detalle.Count > 0
                             ? (DateTime?)dtFb.Revisados[0].Detalle[0].Fecha
                             : null)
                         ?? s.FchRealCalidad;

        // _ri02: min(FchRealProgramado, ValidacionReceta.FchRegistro) — misma lógica que Pedido.cshtml.
        // Si el lab ya tenía registrada la receta antes de la emisión del NROPROG, ese es el inicio real.
        var _labFchReg02 = dtFb?.ValidacionReceta?.FchRegistro;
        var _ri02 = s.FchRealProgramado;
        if (_ri02.HasValue && _labFchReg02.HasValue && _ri02.Value.Date > _labFchReg02.Value.Date)
            _ri02 = _labFchReg02;

        return new List<(string, string, string, DateTime?, DateTime?, DateTime?, DateTime?)>
        {
            ("01", "Pedido",        "#5a6570", s.FchPedido,                                        s.FchRealProgramado ?? EffEst(s.FchEstHilanderia, _rHilan),
                                               s.FchPedido,                                       s.FchRealProgramado),
            // Paso 02 — Programado: RI = _ri02 (ajustado al lab si es anterior a FchRealProgramado).
            ("02", "Programado",    "#2563eb", s.FchRealProgramado,                               EffEst(s.FchEstHilanderia, _rHilan),
                                               _ri02,                                              _rHilan),
            // Paso 03 — Laboratorio: hito = aprobación de receta en L_VALIDA_RECETA.
            // Fallback: FCH_REAL_PRODUCCION (PARTIDA.FECHA) como proxy si no hay validación lab.
            ("03", "Laboratorio",   "#7c3aed", EffEst(s.FchEstHilanderia, _rLab),               EffEst(s.FchEstHilanderia, _rLab),
                                               _rLab,                                              _rLab),
            // Paso 04 — En Hilandería: inicio = PARTIDA.FECHA (DetalleTt.FechaPartida).
            ("04", "Hilandería",    "#0891b2", EffEst(s.FchEstHilanderia, _rHilan),             EffEst(s.FchEstPartida, s.FchRealPartida),
                                               _rHilan,                                            s.FchRealPartida),
            // Paso 05 — Lote Disponible: fin = inicio TT real (InicioTt).
            ("05", "Lote Disp.",    "#0e7490", EffEst(s.FchEstPartida, s.FchRealPartida),       EffEst(s.FchEstTinIni, _rTinIni),
                                               s.FchRealPartida,                                  _rTinIni),
            // Paso 06 — En Tintorería: InicioTt → FinTt (baños reales TT_RPRODUC).
            ("06", Nm("06","Tintorería"),         Cl("06","#6f42c1"), EffEst(s.FchEstTinIni, _rTinIni),                EffEst(s.FchEstTinFin, _rTinFin),
                                               _rTinIni,                                           _rTinFin),
            // Paso 07 — Teñido Completo: hito = FinTt (mayor FECHA_FIN de baños).
            ("07", Nm("07","Teñido Comp."),        Cl("07","#d63384"), EffEst(s.FchEstTinFin, _rTinFin),               EffEst(s.FchEstTinFin, _rTinFin),
                                               _rTinFin,                                           _rTinFin),
            // Paso 08 — Secado.
            ("08", Nm("08","Secado"),              Cl("08","#20c997"), EffEst(s.FchEstTinFin, _rTinFin),               EffEst(s.FchEstSecado, _rSecado),
                                               _rTinFin,                                           _rSecado),
            // Paso 09 — CC TT Aprobado: inicio = fin secado, fin = CTCALIDAD_D.Fecha.
            ("09", Nm("09","C.Calidad"),           Cl("09","#fd7e14"), EffEst(s.FchEstSecado, _rSecado),               EffEst(s.FchEstCalidad, _rCcTinto),
                                               _rSecado,                                           _rCcTinto),
            // Paso 09B — Gaseado: solo PROCESO='24' (PEINADO GASEADO). FCH_REAL_GASEADO es fuente directa.
            ("09B",Nm("09B","Gaseado"),            Cl("09B","#ffd700"), s.Proceso == "24" ? EffEst(s.FchEstCalidad, _rCcTinto) : null,
                                               s.Proceso == "24" ? EffEst(s.FchEstCalidad, _rCcTinto) : null,
                                               s.Proceso == "24" ? s.FchRealGaseado : null,
                                               s.Proceso == "24" ? s.FchRealGaseado : null),
            // Paso 9R — Reproceso (CC rechazado): solo cuando FCH_REAL_CC_RECHAZO tiene valor.
            ("9R", Nm("9R","CC Rechazo"),         Cl("9R","#dc3545"), s.FchRealCcRechazo.HasValue ? EffEst(s.FchEstCalidad, s.FchRealCcRechazo) : null,
                                               s.FchRealCcRechazo.HasValue ? EffEst(s.FchEstCalidad, s.FchRealCcRechazo) : null,
                                               s.FchRealCcRechazo,
                                               s.FchRealCcRechazo),
            // Paso 10 — Devanado: inicio = primer REVISADO_G.A_ADFECHA, fin = AlmPT.
            ("10", Nm("10","Devanado"),            Cl("10","#ffc107"), EffEst(s.FchEstCalidad, _rDevanado),            EffEst(s.FchEstDespacho, s.FchRealAlmPt),
                                               _rDevanado,                                         s.FchRealAlmPt),
            // Paso 11 — Revisado: hito = primera REVISADO_D.FECHA (detalle aprobado).
            ("11", Nm("11","Revisado"),            Cl("11","#0d6efd"), EffEst(s.FchEstCalidad, _rRevisado),            EffEst(s.FchEstCalidad, _rRevisado),
                                               _rRevisado,                                         _rRevisado),
            // Paso 12 — Ingresado Almacén PT.
            ("12", Nm("12","Almacén PT"),          Cl("12","#198754"), EffEst(s.FchEstCalidad, s.FchRealAlmPt),        EffEst(s.FchEstCalidad, s.FchRealAlmPt),
                                               s.FchRealAlmPt,                                    s.FchRealAlmPt),
            // Paso 13 — Listo para Despacho: entre AlmPT y fecha compromiso.
            ("13", Nm("13","Listo Despacho"),      Cl("13","#20c997"), EffEst(s.FchEstDespacho, s.FchRealAlmPt),      s.FchEntregaComp,
                                               s.FchRealAlmPt,                                    s.FchRealDespacho),
            ("14", Nm("14","Despacho"),            Cl("14","#198754"), EffEst(s.FchEstDespacho, s.FchRealAlmPt),      s.FchEntregaComp,
                                               s.FchRealAlmPt,                                    s.FchRealDespacho),
        };
    };
}

@section Styles {
<link rel="stylesheet" href="~/css/planeamiento.css" asp-append-version="true" />
<style>
    /* ── Gantt: estilos exclusivos de la vista ──────────── */

    /* ── Contenedor del Gantt ────────────────────────────── */
    .gantt-wrap {
        overflow-x: hidden;
        border-radius: 0;
        border: 1px solid #dee2e6;
    }
    .gantt-grid {
        display: grid;
        grid-template-columns: 220px 1fr;
        background: #f8f9fa;
    }

    /* ── Cabecera del eje X ──────────────────────────────── */
    .gantt-hdr-label {
        background: #f1f3f5;
        border-right: 1px solid #dee2e6;
        padding: .6rem .85rem;
        font-weight: 700;
        font-size: .73rem;
        letter-spacing: .05em;
        text-transform: uppercase;
        color: #495057;
        border-bottom: 1px solid #dee2e6;
        position: sticky;
        left: 0;
        z-index: 3;
    }
    .gantt-hdr-axis {
        position: relative;
        border-bottom: 1px solid #dee2e6;
        background: #f1f3f5;
        height: 46px;
    }
    .gantt-tick {
        position: absolute; top: 0; height: 100%;
        border-left: 1px solid #dee2e6;
        font-size: .66rem;
        color: #868e96;
        font-weight: 600;
        padding-left: 5px;
        padding-top: .4rem;
        white-space: nowrap;
        user-select: none;
    }
    .gantt-tick.hoy {
        border-left: 2px solid #dc3545;
        color: #dc3545;
        font-weight: 700;
        z-index: 2;
        background: rgba(220,53,69,.04);
    }
    .gantt-tick.semana {
        border-left: 1px solid #adb5bd;
        color: #6c757d;
        font-weight: 700;
    }
    .gantt-tick.dia {
        color: #ced4da;
        font-weight: 500;
        font-size: .58rem;
    }

    /* ── Filas del Gantt ─────────────────────────────────── */
    .gantt-row-label {
        background: #ffffff;
        border-right: 1px solid #dee2e6;
        border-bottom: 1px solid #f1f3f5;
        padding: .45rem .7rem .45rem .9rem;
        font-size: .8rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 70px;
        position: sticky;
        left: 0;
        z-index: 2;
        border-left: 3px solid transparent;
        transition: border-left-color .15s;
        font-weight: 500;
    }
    .gantt-row-label.paso-activo {
        border-left-color: var(--paso-color, #0d6efd);
        background: #ffffff;
    }
    .gantt-row-label.paso-completado {
        border-left-color: #198754;
        background: #ffffff;
    }
    .gantt-row-label.paso-pendiente { opacity: .45; }

    .gantt-row-body {
        position: relative;
        border-bottom: 1px solid #f1f3f5;
        background-color: #ffffff;
        background-image:
            linear-gradient(90deg, rgba(0,0,0,.09) 0, rgba(0,0,0,.09) 1px, transparent 1px),
            linear-gradient(90deg, rgba(0,0,0,.04) 0, rgba(0,0,0,.04) 1px, transparent 1px);
        background-size: var(--week-pct) 100%, var(--day-pct) 100%;
        background-repeat: repeat-x;
        min-height: 72px;
    }
    .gantt-row-body.paso-activo  { background-color: #ffffff; }
    .gantt-row-body.paso-completado { background-color: #ffffff; }

    /* ── Barras del Gantt ────────────────────────────────── */
    .gantt-bar {
        position: absolute;
        border-radius: 3px;
        cursor: help;
        transition: filter .15s;
    }
    .gantt-bar:hover {
        filter: brightness(.9);
        z-index: 10;
    }
    /* Estimada: franja superior semitransparente */
    .gantt-bar.est {
        top: 10px;
        height: 18px;
        opacity: .35;
        border: 1px solid rgba(0,0,0,.1);
    }
    /* Real: barra principal */
    .gantt-bar.real {
        top: 32px;
        height: 26px;
        border: none;
        opacity: .88;
    }
    .gantt-bar.borde-derecho {
        border-right: 2px dashed rgba(0,0,0,.25);
        border-radius: 3px 0 0 3px;
    }
    /* Etiqueta de fecha */
    .gantt-bar-label {
        position: absolute;
        top: 34px;
        height: 20px;
        font-size: .62rem;
        color: #fff;
        font-weight: 700;
        padding: 0 6px;
        line-height: 20px;
        pointer-events: none;
        overflow: hidden;
        white-space: nowrap;
        text-shadow: 0 1px 1px rgba(0,0,0,.45);
        letter-spacing: .02em;
    }

    /* ── Hitos (diamantes) ───────────────────────────────── */
    .gantt-hito {
        position: absolute;
        width: 13px;
        height: 13px;
        border-radius: 2px;
        border: 2px solid #fff;
        box-shadow: 0 0 0 2px currentColor, 0 2px 4px rgba(0,0,0,.2);
        top: 21px;
        transform: translateX(-50%) rotate(45deg);
        cursor: help;
        transition: transform .15s;
    }
    .gantt-hito:hover {
        transform: translateX(-50%) rotate(45deg) scale(1.15);
    }
    .gantt-hito-diamond {
        position: absolute;
        width: 14px;
        height: 14px;
        transform: translateX(-50%) rotate(45deg);
        top: 22px;
        cursor: help;
        box-shadow: 0 2px 4px rgba(0,0,0,.15);
    }

    /* ── Línea de hoy ────────────────────────────────────── */
    .gantt-hoy-line {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 2px;
        background: rgba(220,53,69,.7);
        pointer-events: none;
        z-index: 1;
    }

    /* ── Separador de sublote ────────────────────────────── */
    .sublote-sep {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: 220px 1fr;
        background: #f1f3f5;
        font-size: .76rem;
        font-weight: 600;
        color: #343a40;
        border-top: 1px solid #dee2e6;
        border-bottom: 1px solid #dee2e6;
        cursor: pointer;
        user-select: none;
    }
    .sublote-sep-label {
        padding: .5rem .7rem .5rem .9rem;
        display: flex;
        align-items: flex-start;
        flex-direction: column;
        gap: .3rem;
        border-right: 1px solid #dee2e6;
        overflow: hidden;
    }
    .sublote-sep-axis {
        padding: .5rem .7rem;
        display: flex;
        align-items: center;
        gap: .75rem;
        overflow: hidden;
    }
    .sublote-sep:hover { background: #e9ecef; }
    .sublote-toggle {
        transition: transform .2s;
        color: #6c757d;
        flex-shrink: 0;
    }
    .sublote-sep[aria-expanded="false"] .sublote-toggle {
        transform: rotate(-90deg);
    }
    .sublote-rows {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: 220px 1fr;
    }
    .sublote-rows.collapsing { grid-column: 1 / -1; }

    /* .evento-item, .evento-dot, .evento-badge, .evento-hora → planeamiento.css */
    /* .leyenda-bar → planeamiento.css */

    /* ─── Strip de info (gantt header) ───────────────────── */
    /* ─── Strip info-pedido: ver planeamiento.css §5 ────── */

    /* ─── Aviso cronograma pendiente ──────────────────────── */
    .pln-aviso-strip {
        border: 1px solid #93c5fd;
        border-left: 3px solid #0d6efd;
        background: #f0f7ff;
        padding: .55rem 1rem;
        font-size: .82rem;
        color: #084298;
    }

    /* ─── Panel notas de lectura + leyenda ────────────────── */
    .pln-notas-toggle {
        background: #f8f9fa;
        color: #495057;
        border: 1px solid #dee2e6;
        font-size: .78rem;
        letter-spacing: .03em;
        border-radius: 0;
    }
    .pln-notas-toggle:hover, .pln-notas-toggle:focus {
        background: #e9ecef;
        color: #212529;
        border-color: #adb5bd;
    }
    .pln-notas-panel {
        border: 1px solid #dee2e6;
        border-top: none;
        background: #ffffff;
        padding: 1rem 1.2rem;
    }
    .pln-notas-body {
        font-size: .82rem;
        color: #495057;
        padding: .5rem .75rem;
        background: #f8f9fa;
        border-left: 3px solid #adb5bd;
        margin-bottom: .75rem;
    }
</style>
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Produccion" asp-action="Index">Producción</a></li>
    <li class="breadcrumb-item"><a asp-action="Dashboard">Seguimiento de Pedidos</a></li>
    <li class="breadcrumb-item active">Gantt @Model.Serie-@Model.NumPed</li>
}

<!-- ── Cabecera de página ────────────────────────────────── -->
<div class="pln-page-hdr mb-2">
    <i class="bi bi-bar-chart-steps pln-page-hdr-icon"></i>
    <div class="pln-page-hdr-body">
        <div class="pln-page-hdr-title">Diagrama Gantt <strong>@Model.Serie-@Model.NumPed</strong></div>
        <div class="pln-page-hdr-sub">Cronograma de etapas &nbsp;·&nbsp; Estado planificado vs. real</div>
    </div>
    <div class="pln-page-hdr-actions">
        <a asp-action="Pedido" asp-route-numPed="@Model.NumPed" asp-route-serie="@Model.Serie"
           class="btn btn-outline-light btn-sm">
            <i class="bi bi-clipboard2-data me-1"></i>Detalle
        </a>
        <a asp-action="Dashboard" class="btn btn-outline-light btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>

<!-- ── Strip industrial: info ───────────────────────────── -->
<div class="pln-info-strip mb-3">
    <div class="d-flex align-items-stretch flex-wrap">
        <div class="pln-strip-cell" style="min-width:180px;">
            <div class="pln-strip-lbl"><i class="bi bi-bar-chart-steps me-1"></i>Diagrama Gantt</div>
            <div class="pln-strip-val">@Model.Serie-@Model.NumPed</div>
            @if (primerItem != null)
            {
                <div class="pln-strip-sub">@primerItem.NombreCliente</div>
            }
        </div>
        @if (primerItem != null)
        {
            <div class="pln-strip-cell">
                <div class="pln-strip-lbl">Fecha pedido</div>
                <div class="pln-strip-val">@primerItem.FchPedido.ToString("dd/MM/yyyy")</div>
            </div>
            <div class="pln-strip-cell">
                <div class="pln-strip-lbl">Entrega comprometida</div>
                <div class="pln-strip-val @(primerItem.EstaRetrasado ? "text-warning" : "")">
                    @(primerItem.FchEntregaComp?.ToString("dd/MM/yyyy") ?? "—")
                    @if (primerItem.EstaRetrasado)
                    {
                        <span class="badge bg-danger ms-1" style="font-size:.68rem;">+@primerItem.DiasRetraso d</span>
                    }
                </div>
            </div>
            <div class="pln-strip-cell">
                <div class="pln-strip-lbl">Etapa actual</div>
                <div class="mt-1">
                    <span class="paso-badge text-white" style="background-color:@primerItem.ColorUi;">
                        @primerItem.CodPasoAct — @primerItem.NombrePaso
                    </span>
                </div>
            </div>
            @if (Model.Items.Any(x => x.EsUrgente))
            {
                <div class="pln-strip-cell">
                    <div class="pln-strip-lbl">Estado</div>
                    <div class="pln-strip-val"><span class="badge bg-danger">⚡ URGENTE</span></div>
                </div>
            }
        }
    </div>
    @* ── Fila de actores (Registró / Aprobó / Planificó) ── *@
    @{
        var actorItemG = Model.Items.FirstOrDefault(x =>
            !string.IsNullOrEmpty(x.NombreRegistro) ||
            !string.IsNullOrEmpty(x.NombreAprobacion) ||
            !string.IsNullOrEmpty(x.NombrePlanif));
    }
    @if (actorItemG != null)
    {
        <div class="d-flex gap-3 flex-wrap px-2 py-1 border-top" style="font-size:.72rem; color:#6c757d; background:rgba(255,255,255,.04);">
            @if (!string.IsNullOrEmpty(actorItemG.NombreRegistro))
            {
                <span><i class="bi bi-person me-1"></i><strong>Registró:</strong> @actorItemG.NombreRegistro</span>
            }
            @if (!string.IsNullOrEmpty(actorItemG.NombreAprobacion))
            {
                <span><i class="bi bi-patch-check me-1"></i><strong>Aprobó:</strong> @actorItemG.NombreAprobacion
                    @if (actorItemG.FchAprobacion.HasValue)
                    {
                        <span class="opacity-75 ms-1">(@actorItemG.FchAprobacion.Value.ToString("dd/MM/yy"))</span>
                    }
                </span>
            }
            @if (!string.IsNullOrEmpty(actorItemG.NombrePlanif))
            {
                <span><i class="bi bi-calendar2-check me-1"></i><strong>Planificó:</strong> @actorItemG.NombrePlanif
                    @if (actorItemG.FchPlanif.HasValue)
                    {
                        <span class="opacity-75 ms-1">(@actorItemG.FchPlanif.Value.ToString("dd/MM/yy"))</span>
                    }
                </span>
            }
        </div>
    }
</div>

@* Aviso errores de auto-planificación (solo si SP_PLN_CALCULA_FECHAS falló para algún ítem) *@
@if (ViewBag.ErroresPlanif is List<string> errPlanif && errPlanif.Any())
{
    <div class="pln-aviso-strip mb-2 d-flex gap-2 align-items-start">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1"></i>
        <div>
            <strong>No se pudo calcular el cronograma para algunos ítems:</strong>
            <ul class="mb-0 mt-1">
                @foreach (var err in errPlanif) { <li>@err</li> }
            </ul>
        </div>
    </div>
}



@* Panel colapsable único: notas de lectura + leyenda *@
<div class="mb-3">
    <button class="btn btn-sm pln-notas-toggle fw-bold" type="button"
            data-bs-toggle="collapse" data-bs-target="#ganttNotas" aria-expanded="false">
        <i class="bi bi-info-circle me-1"></i>NOTAS DE LECTURA Y LEYENDA DE ETAPAS
        <i class="bi bi-chevron-down ms-1 toggle-icon"></i>
    </button>
    <div class="collapse" id="ganttNotas">
        <div class="pln-notas-panel">
            <div class="pln-notas-body mb-3">
                Las barras <strong>con patrón diagonal</strong> son fechas <strong>ESTIMADAS</strong> (barra superior, semitransparente) y las <strong>sólidas</strong> son fechas <strong>REALES</strong> (barra inferior). La línea <span class="text-danger fw-bold">ROJA GRUESA</span> marca hoy. Si la barra real supera la estimada, hay retraso en esa etapa. Los pasos con <i class="bi bi-pin-angle-fill text-warning"></i> son <strong>orientativos</strong>: <strong>03 — Laboratorio</strong>, <strong>07 — Teñido Completo</strong>, <strong>11 — Revisado</strong> y <strong>12 — Almacén PT</strong> no tienen duración programada fija. Para fechas exactas consulte el <a asp-action="HistorialEventos" asp-route-numPed="@Model.NumPed" asp-route-serie="@Model.Serie" asp-route-idSeguim="@(primerItem?.IdSeguim ?? 0)" class="fw-semibold">Historial de eventos</a>.
            </div>
            <div class="row g-2 small">
                <div class="col-12 mb-1" style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#4a5568;border-left:3px solid #4a5568;padding-left:.5rem;">Leyenda de etapas</div>
                @{
                    var leyendaEtapas = new[]
                    {
                        ("#5a6570", "01", "01 — Pedido Registrado",    "Ventas registra el ítem en el sistema.",                          false),
                        ("#2563eb", "02", "02 — Planificado",           "Planeamiento asigna número de programación (NROPROG).",            false),
                        ("#7c3aed", "03", "03 — Laboratorio",           "Laboratorio aprueba la receta de tintorería antes de iniciar producción (fecha orientativa).", true),
                        ("#0891b2", "04", "04 — En Hilandería",         "PARTIDA creada en planta: se inicia la producción del lote.",     false),
                        ("#0e7490", "05", "05 — Lote Disponible",       "H_RPRODUC confirma la producción completa; el lote está listo para entrar a tintorería.", false),
                        ("#7e22ce", "06", "06 — En Tintorería",         "El lote entra al proceso de teñido (baños).",                    false),
                        ("#be185d", "07", "07 — Teñido Completo",       "Todos los baños aprobados. Fecha orientativa.",                   true),
                        ("#059669", "08", "08 — Secado",                "Finalizado el teñido; el lote pasa a secado.",                   false),
                        ("#dc2626", "09", "09 — C.Calidad Aprobado",    "Control de calidad aprueba el lote teñido.",                     false),
                        ("#d97706", "10", "10 — Devanado / Almacén PT", "Devanado y revisión final antes del despacho.",                  false),
                        ("#1d4ed8", "11", "11 — Revisado",              "Revisión final de calidad. Fecha orientativa.",                   true),
                        ("#047857", "12", "12 — Ingresado Almacén PT",  "Ingreso físico al almacén PT. Fecha orientativa.",                true),
                        ("#10b981", "13", "13 — Listo para Despacho",   "El lote está disponible y pendiente de despacho.",               false),
                        ("#065f46", "14", "14 — Despachado/Cerrado",              "El lote ha sido despachado total o parcialmente al cliente.",     false),
                    };
                    }
                    @foreach (var (color, cod, nombre, desc, esAprox) in leyendaEtapas)
                    {
                        <div class="col-sm-6 col-lg-4 d-flex align-items-start gap-2">
                            <span style="display:inline-block;width:26px;min-width:26px;height:14px;background:@color;border-radius:1px;margin-top:4px;border:1px solid rgba(0,0,0,.2);box-shadow:0 2px 4px rgba(0,0,0,.18);"></span>
                            <div>
                                <span class="fw-bold" style="font-size:.82rem;">@nombre</span>
                                @if (esAprox)
                            {
                                <span class="badge bg-warning text-dark ms-1 border border-dark" style="font-size:.64rem;font-weight:700;" title="Fecha aproximada: este paso no tiene una duración programada, por lo que se ubica en la posición más cercana disponible."><i class="bi bi-pin-angle-fill me-1"></i>ORIENTATIVO</span>
                            }
                            <br /><span class="text-muted" style="font-size:.76rem;">@desc</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="section-sep"><i class="bi bi-bar-chart-steps"></i> DIAGRAMA GANTT — @Model.Items.Count() SUBLOTE(S)</div>
<div class="card border-0 shadow-sm" style="border:1px solid #4a5568 !important;border-radius:0 !important;">
    <div class="card-body p-0 gantt-wrap"
         style="--day-pct:@((100.0/totalDias).ToString("F4",System.Globalization.CultureInfo.InvariantCulture))%;--week-pct:@((700.0/totalDias).ToString("F4",System.Globalization.CultureInfo.InvariantCulture))%;">
        <div class="gantt-grid">

            <!-- Cabecera -->
            <div class="gantt-hdr-label">Etapa / Sublote</div>
            <div class="gantt-hdr-axis">
                @{
                    var tickDate = fechaMin.Date;
                }
                @while (tickDate <= fechaMax.Date)
                {
                    var left     = (tickDate - fechaMin).TotalDays / totalDias * 100;
                    var esHoy2   = tickDate == hoy;
                    var esSemana = tickDate.DayOfWeek == DayOfWeek.Monday;
                    var esPrimero = tickDate == fechaMin.Date;
                    var label    = esHoy2 ? "Hoy"
                                 : (esSemana || esPrimero) ? tickDate.ToString("dd/MM")
                                 : tickDate.Day.ToString();
                    var cls      = esHoy2 ? "hoy" : (esSemana || esPrimero) ? "semana" : "dia";
                    <div class="gantt-tick @cls"
                         style="left:@left.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)%;">
                        @label
                    </div>
                    tickDate = tickDate.AddDays(1);
                }
            </div>

            <!-- Filas por sublote -->
            @foreach (var s in Model.Items.OrderBy(x => x.NumDet))
            {
                <!-- Separador de sublote -->
                <div class="sublote-sep"
                     data-bs-toggle="collapse" data-bs-target="#seg-@(s.IdSeguim)"
                     aria-expanded="false" aria-controls="seg-@(s.IdSeguim)"
                     data-codartt="@s.CodArt">
                    <div class="sublote-sep-label">
                        <div style="display:flex;align-items:center;gap:.45rem;">
                            <i class="bi bi-chevron-down sublote-toggle"></i>
                            <span class="fw-bold" style="font-size:.82rem;letter-spacing:.02em;">@s.CodArt</span>
                            @if (s.NumDet > 0)
                            {
                                <span class="badge" style="background:#1a202c;font-size:.68rem;font-weight:800;border:1px solid rgba(255,255,255,.2);">DET.@s.NumDet</span>
                            }
                        </div>
                        <div style="display:flex;align-items:center;gap:.35rem;flex-wrap:wrap;padding-left:1.5rem;">
                            <span class="badge" style="background-color:@s.ColorUi;font-size:.68rem;font-weight:800;border:2px solid rgba(0,0,0,.25);text-shadow:1px 1px 1px rgba(0,0,0,.2);">
                                @s.CodPasoAct &mdash; @s.NombrePaso
                            </span>
                            @if (s.EstaEnReproceso)
                            {
                                <span class="badge" style="background:#991b1b;font-weight:800;border:2px solid rgba(0,0,0,.3);">REPROCESO C.@s.NroCiclo</span>
                            }
                            @if (s.EsUrgente)
                            {
                                <span class="badge" style="background:#dc2626;font-weight:800;border:2px solid rgba(0,0,0,.3);">&#x26A1; URGENTE</span>
                            }
                        </div>
                    </div>
                    <div class="sublote-sep-axis">
                        <div style="flex:1 1 0;min-width:0;overflow:hidden;display:flex;align-items:center;gap:.5rem;">
                            <span class="art-desc-info" style="font-size:.72rem;color:#6c757d;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"></span>
                            @if (!string.IsNullOrEmpty(s.Titulo))
                            {
                                <span style="font-size:.68rem;color:#6c757d;white-space:nowrap;flex-shrink:0;">Tít.: <strong style="color:#343a40;">@s.Titulo</strong>@(!string.IsNullOrEmpty(s.Color) ? " · " + s.Color : "")</span>
                            }
                        </div>
                        @if (s.FchEntregaComp.HasValue)
                        {
                            <span class="small" style="color:#495057;font-weight:700;flex-shrink:0;"
                                  title="Fecha compromiso de entrega al cliente">
                                <i class="bi bi-calendar-event me-1"></i><span style="font-size:.68rem;text-transform:uppercase;letter-spacing:.05em;margin-right:.35rem;">Entrega:</span>@s.FchEntregaComp.Value.ToString("dd/MM/yyyy")
                            </span>
                        }

                    </div>
                </div>

                <div class="sublote-rows collapse" id="seg-@(s.IdSeguim)">
                @{
                    PlnDetalleTt? _ganttDtFb = null;
                    if (s.NumPartida > 0) Model.DetalleTt.TryGetValue(s.NumPartida, out _ganttDtFb);
                }
                @foreach (var e in etapasDe(s, _ganttDtFb))
                {
                    var tieneEst  = e.EI.HasValue && e.EF.HasValue;
                    var tieneReal = e.RI.HasValue;

                    // Paso 01 sin FCH_EST_*: el ítem aún no fue planificado (SP_PLN_CALCULA_FECHAS
                    // no se ejecuta hasta el paso '02'). Se muestra la fila como "pendiente" para
                    // que el usuario vea el flujo completo. Las barras no se dibujan (sin fechas).
                    var esPendienteSinFechas = !tieneEst && !tieneReal;
                    var esCodPaso01 = e.Cod == "01";
                    var esActual  = s.CodPasoAct == e.Cod;
                    var itemEnPaso01 = s.CodPasoAct == "01";

                    // Saltar "01" si no tiene datos (no debería ocurrir, FchPedido siempre existe)
                    if (esPendienteSinFechas && esCodPaso01) { continue; }
                    // Para ítems que ya pasaron el paso 01, saltar etapas sin fechas que no son la activa
                    if (esPendienteSinFechas && !esActual && !itemEnPaso01) { continue; }

                    var mostrarFilaPendiente = esPendienteSinFechas; // solo llegaremos aquí si itemEnPaso01

                    var eIniL    = pctLeft(e.EI).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                    var eW       = pctWidth(e.EI, e.EF).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                    var rIniL    = pctLeft(e.RI).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                    var rW       = pctWidth(e.RI, e.RF).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                    var hoyL     = pctLeft(hoy).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

                    // Pin orientativo: igual que Pedido.cshtml — dinámico por paso y por datos disponibles
                    var esAproxFila =
                        e.Cod == "05" ||   // siempre proxy
                        (e.Cod == "07" && _ganttDtFb?.FinTt == null && !s.FchRealTinFin.HasValue) ||
                        (e.Cod == "11" && (_ganttDtFb == null || _ganttDtFb.Revisados.Count == 0 || _ganttDtFb.Revisados[0].Detalle.Count == 0)) ||
                        (e.Cod == "12" && !s.FchRealAlmPt.HasValue);
                    var ttAprox = esAproxFila && descripcionAprox.TryGetValue(e.Cod, out var da) ? da : "";
                    var ttEst  = tieneEst
                        ? $"{e.Nom} (Est): {e.EI!.Value:dd/MM/yy} → {e.EF!.Value:dd/MM/yy}" +
                          (esAproxFila ? " ⚠ Fecha orientativa" : "")
                        : "";
                    var ttReal = tieneReal
                        ? $"{e.Nom} (Real): {e.RI!.Value:dd/MM/yy}" +
                          (e.RF.HasValue ? $" → {e.RF.Value:dd/MM/yy}" : " → en curso") +
                          (esAproxFila ? " ⚠ Fecha orientativa" : "")
                        : "";

                    @if (mostrarFilaPendiente)
                    {
                        <div class="gantt-row-label" style="opacity:.45;">
                            <div style="color:@e.Color;">@e.Nom</div>
                            <small class="text-muted" style="font-size:.6rem;font-style:italic;">pendiente de planificación</small>
                        </div>
                        <div class="gantt-row-body" style="opacity:.25;background:repeating-linear-gradient(90deg,#dee2e6 0,#dee2e6 4px,transparent 4px,transparent 16px);">
                            <div class="gantt-hoy-line" style="left:@pctLeft(hoy).ToString("F2", System.Globalization.CultureInfo.InvariantCulture)%;"></div>
                        </div>
                    }
                    else
                    {
                        var ordenActualStep = pasoMap.ContainsKey(s.CodPasoAct) ? pasoMap[s.CodPasoAct].OrdenPaso : 0;
                        var ordenEtapa      = pasoMap.ContainsKey(e.Cod)         ? pasoMap[e.Cod].OrdenPaso         : 0;
                        var esCompletadoRow = !esActual && ordenEtapa < ordenActualStep;
                        var labelClase = esActual ? "paso-activo" : esCompletadoRow ? "paso-completado" : "";
                        <div class="gantt-row-label @labelClase"
                             style="@(esActual ? $"--paso-color:{e.Color};" : "")">
                            <div class="d-flex align-items-center gap-1 flex-wrap">
                                    <span class="paso-badge text-white" style="background:@e.Color;text-shadow:1px 1px 1px rgba(0,0,0,.3);">@e.Cod</span>
                                    <span class="fw-bold @(esActual ? "" : esCompletadoRow ? "text-success" : "text-muted")"
                                          style="font-size:.82rem;letter-spacing:.01em;">@e.Nom</span>
                                </div>
                                @if (esActual)
                                {
                                    <span class="badge mt-1 text-white" style="background:@e.Color;font-size:.64rem;font-weight:800;border:1px solid rgba(0,0,0,.25);text-shadow:1px 1px 1px rgba(0,0,0,.2);">⬤ ACTIVO</span>
                                }
                                else if (esCompletadoRow)
                                {
                                    <small class="fw-bold" style="font-size:.65rem;color:#047857;"><i class="bi bi-check-circle-fill me-1"></i>COMPLETADO</small>
                                }
                                else if (esAproxFila)
                                {
                                    <small class="text-warning fw-bold" style="font-size:.62rem;" title="@ttAprox"><i class="bi bi-pin-angle-fill me-1"></i>ORIENTATIVO</small>
                                }
                                else if (tieneReal && !e.RF.HasValue)
                                {
                                    <small class="fw-bold" style="font-size:.65rem;color:#2563eb;"><i class="bi bi-gear-fill me-1"></i>EN CURSO</small>
                                }
                                @* Fechas impresas bajo el nombre de etapa *@
                                @if (tieneEst)
                                {
                                    <div style="font-size:.62rem;color:#718096;margin-top:2px;white-space:nowrap;font-weight:700;">
                                        <i class="bi bi-calendar2 me-1"></i>EST: @e.EI!.Value.ToString("dd/MM/yy")@(e.EF.HasValue && e.EF != e.EI ? $" → {e.EF.Value:dd/MM/yy}" : "")
                                    </div>
                                }
                                @if (tieneReal)
                                {
                                    <div style="font-size:.62rem;color:#1d4ed8;margin-top:2px;white-space:nowrap;font-weight:700;">
                                        <i class="bi bi-calendar2-check me-1"></i>REAL: @e.RI!.Value.ToString("dd/MM/yy")@(e.RF.HasValue && e.RF != e.RI ? $" → {e.RF.Value:dd/MM/yy}" : e.RF.HasValue ? "" : " → hoy")
                                    </div>
                                }
                        </div>
                        <div class="gantt-row-body @labelClase">
                            <div class="gantt-hoy-line" style="left:@hoyL%;"></div>

                            @if (tieneEst)
                            {
                                <div class="gantt-bar est"
                                     style="left:@eIniL%;width:@eW%;background:@e.Color;"
                                     title="@ttEst">
                                </div>
                            }
                            @if (tieneReal)
                            {
                                var rWNum = e.RF.HasValue ? double.Parse(rW, System.Globalization.CultureInfo.InvariantCulture) : 1.5;
                                <div class="gantt-bar real @(!e.RF.HasValue ? "borde-derecho" : "")"
                                     style="left:@rIniL%;width:@rWNum.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)%;background:@e.Color;"
                                     title="@ttReal">
                                </div>
                                @if (e.RI.HasValue && rWNum > 5)
                                {
                                    <div class="gantt-bar-label"
                                         style="left:@rIniL%;background:transparent;">@e.RI.Value.ToString("dd/MM")</div>
                                }
                            }
                        </div>
                    }
                }

                <!-- Hito: entrega comprometida -->
                @if (s.FchEntregaComp.HasValue)
                {
                    var hitoL     = pctLeft(s.FchEntregaComp).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                    var hoyHitoL  = pctLeft(hoy).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                    var hitoColor = s.EstaRetrasado ? "#dc2626" : "#047857";

                    <div class="gantt-row-label" style="font-size:.78rem;color:@hitoColor;font-weight:800;letter-spacing:.02em;">
                        ENTREGA COMP.
                    </div>
                    <div class="gantt-row-body">
                        <div class="gantt-hoy-line" style="left:@hoyHitoL%;"></div>
                        <div class="gantt-hito"
                             style="left:calc(@hitoL% - 8px);background:@hitoColor;"
                             title="Entrega comprometida: @s.FchEntregaComp.Value.ToString("dd/MM/yyyy")">
                        </div>
                        @if (s.EstaRetrasado)
                        {
                            <span style="position:absolute;top:16px;left:calc(@hitoL% + 10px);
                                         font-size:.7rem;color:#dc2626;font-weight:900;white-space:nowrap;text-shadow:1px 1px 1px rgba(255,255,255,.5);">
                                +@s.DiasRetraso D
                            </span>
                        }
                    </div>
                }
                </div>@* /sublote-rows *@
            }
        </div>
    </div>
</div>

<div style="margin-bottom:1.5rem;"></div>

@section Scripts {
<script>
    // Carga descripción + material de artículos via endpoint (reutiliza GetArticuloInfo)
    (async function () {
        const seps  = document.querySelectorAll('[data-codartt]');
        const unique = [...new Set([...seps].map(c => c.dataset.codartt).filter(Boolean))];
        for (const cod of unique) {
            try {
                const res  = await fetch(`/Planeamiento/GetArticuloInfo?codArt=${encodeURIComponent(cod)}`);
                if (!res.ok) continue;
                const info = await res.json();
                const parts = [info.descripcion, info.fibra].filter(x => x);
                if (!parts.length) continue;
                const text = parts.join(' · ');
                document.querySelectorAll(`[data-codartt="${CSS.escape(cod)}"] .art-desc-info`)
                        .forEach(el => el.textContent = text);
            } catch { /* silencioso */ }
        }
    })();


</script>
}



