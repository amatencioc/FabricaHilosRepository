@section Styles {
<link rel="stylesheet" href="~/css/planeamiento.css" asp-append-version="true" />
}

@using FabricaHilos.Models.Produccion.Planeamiento
@model IEnumerable<PlnPendienteEnconado>
@{
    ViewData["Title"] = "Pendientes de Enconado";
    var lista       = Model.ToList();
    var nVencidos   = lista.Count(x => x.EstaVencido);
    var kgTotal     = lista.Sum(x => x.Peso);
    var rmcActual   = ViewBag.FiltroRmc as string ?? "%";
    var estadoActual = (ViewBag.FiltroEstado as string ?? "").ToLowerInvariant();
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Produccion" asp-action="Index">Producción</a></li>
    <li class="breadcrumb-item active">Pendientes de Enconado</li>
}

@await Html.PartialAsync("_PlnNavBar")

<div class="container-fluid py-3">

    @* ── Strip de cabecera ─────────────────────────────────────────────── *@
    <div class="pend-strip">
        <i class="bi bi-arrow-repeat" style="color:#f6ad55;font-size:.95rem;flex-shrink:0;"></i>
        <span class="pend-strip-title">Enconado / Devanado</span>
        <span class="pend-strip-sep"></span>

        <span class="pend-kpi" title="Total de partidas pendientes de enconado o devanado.">
            <i class="bi bi-boxes" style="color:#90cdf4;"></i>
            <span class="pend-kpi-val">@lista.Count</span>
            <span style="opacity:.75">partidas</span>
        </span>
        <span class="pend-kpi" style="@(nVencidos > 0 ? "" : "opacity:.45")"
              title="Partidas cuya fecha de entrega ya venció.">
            <i class="bi bi-clock-history" style="color:#fc8181;"></i>
            <span class="pend-kpi-val" style="@(nVencidos > 0 ? "color:#fc8181;" : "")">@nVencidos</span>
            <span style="opacity:.75">vencidas</span>
        </span>
        <span class="pend-kpi" title="Total de kg pendientes.">
            <i class="bi bi-bag-fill" style="color:#fbd38d;"></i>
            <span class="pend-kpi-val">@kgTotal.ToString("N0")</span>
            <span style="opacity:.75">kg</span>
        </span>

        <span class="pend-strip-actions">
            <a asp-action="Dashboard" class="btn btn-sm btn-outline-light py-0 px-2" style="font-size:.72rem;">
                <i class="bi bi-arrow-left me-1"></i>Seguimiento
            </a>
        </span>
    </div>

    @* ── Cuadros resumen (réplica del reporte legacy "Partidas Pendientes de Enconado") ── *@
    @{
        var cuadro1 = (ViewBag.Cuadro1 as IEnumerable<PlnEnconadoCuadro1>)?.ToList() ?? new List<PlnEnconadoCuadro1>();
        var cuadro2 = (ViewBag.Cuadro2 as IEnumerable<PlnEnconadoCuadro2>)?.ToList() ?? new List<PlnEnconadoCuadro2>();
    }
    @if (cuadro1.Any() || cuadro2.Any())
    {
        <div class="row g-3 mb-3">
            <div class="col-lg-6">
                <div class="card h-100 position-relative">
                    <div id="cuadro1-loading" class="pend-cuadro-loading d-none">
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                        <span class="ms-2 small text-muted">Actualizando…</span>
                    </div>
                    <div class="card-header py-1 px-2" style="font-size:.8rem;font-weight:600;">Resumen por Categoría</div>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered mb-0" style="font-size:.8rem;">
                            <thead>
                                <tr>
                                    <th>Material</th>
                                    <th class="text-end">Kg</th>
                                    <th class="text-end">#Part</th>
                                </tr>
                            </thead>
                            <tbody id="cuadro1-body">
                                @foreach (var c in cuadro1.OrderBy(c => c.Orden))
                                {
                                    <tr>
                                        <td>@c.Texto</td>
                                        <td class="text-end">@c.PesoKg.ToString("N2")</td>
                                        <td class="text-end">@c.Cantidad.ToString("N0")</td>
                                    </tr>
                                }
                                <tr class="fw-bold table-light">
                                    <td>TOTAL</td>
                                    <td class="text-end" id="cuadro1-total-kg">@cuadro1.Sum(c => c.PesoKg).ToString("N2")</td>
                                    <td class="text-end" id="cuadro1-total-cant">@cuadro1.Sum(c => c.Cantidad).ToString("N0")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card h-100 position-relative">
                    <div id="cuadro2-loading" class="pend-cuadro-loading d-none">
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                        <span class="ms-2 small text-muted">Actualizando…</span>
                    </div>
                    <div class="card-header py-1 px-2" style="font-size:.8rem;font-weight:600;">Material por Aprobar — Detalle por Estatus</div>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered mb-0" style="font-size:.8rem;">
                            <thead>
                                <tr>
                                    <th>Estatus</th>
                                    <th class="text-end">Kg</th>
                                    <th class="text-end">#Part</th>
                                </tr>
                            </thead>
                            <tbody id="cuadro2-body">
                                @foreach (var c in cuadro2.OrderBy(c => c.Estatus))
                                {
                                    <tr>
                                        <td>@c.Estatus</td>
                                        <td class="text-end">@c.Kg.ToString("N2")</td>
                                        <td class="text-end">@c.Cantidad.ToString("N0")</td>
                                    </tr>
                                }
                                <tr class="fw-bold table-light">
                                    <td>TOTAL</td>
                                    <td class="text-end" id="cuadro2-total-kg">@cuadro2.Sum(c => c.Kg).ToString("N2")</td>
                                    <td class="text-end" id="cuadro2-total-cant">@cuadro2.Sum(c => c.Cantidad).ToString("N0")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ── Filtros ───────────────────────────────────────────────────────── *@
    <div class="pend-filter">
        @await Html.PartialAsync("_PlnFiltrosPendientes", (object)"PendientesEnconado")
    </div>

    @* ── Tabla ─────────────────────────────────────────────────────────── *@
    @if (!lista.Any())
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i>No hay partidas pendientes de enconado en este momento.
        </div>
    }
    else
    {
        @* ── Filtro de estado de vencimiento ────────────────────────── *@
        <div class="d-flex align-items-end gap-2 mb-2 flex-wrap">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-funnel text-muted" style="font-size:.85rem;"></i>
                <label class="text-muted small mb-0" for="filtro-estado-enc">Estado:</label>
                <select id="filtro-estado-enc" name="estado" form="frmFiltrosPend" class="form-select form-select-sm" style="width:auto;">
                    <option value="" selected="@(estadoActual == "" ? "selected" : null)">Todos</option>
                    <option value="vencido" selected="@(estadoActual == "vencido" ? "selected" : null)">🔴 Vencidas</option>
                    <option value="porvencer" selected="@(estadoActual == "porvencer" ? "selected" : null)">🟡 Por vencer</option>
                    <option value="atiempo" selected="@(estadoActual == "atiempo" ? "selected" : null)">🟢 A tiempo</option>
                    <option value="sinfecha" selected="@(estadoActual == "sinfecha" ? "selected" : null)">— Sin fecha</option>
                </select>
                <span class="text-muted small" id="enc-count-label"></span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <label class="form-label form-label-sm mb-0" for="filtro-rmc-enc">RMC:</label>
                <select id="filtro-rmc-enc" name="rmc" form="frmFiltrosPend" class="form-select form-select-sm" style="width:auto;">
                    <option value="" selected="@(rmcActual == "%" ? "selected" : null)">Todos</option>
                    <option value="R" selected="@(rmcActual == "R" ? "selected" : null)">Rodete/Rollo</option>
                    <option value="M" selected="@(rmcActual == "M" ? "selected" : null)">Madeja</option>
                </select>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0 pend-tbl" id="tbl-enconado">
                <thead>
                    <tr>
                        <th>Partida</th>
                        <th>Material</th>
                        <th>Color Técnico</th>
                        <th>Color Cliente</th>
                        <th>Cliente</th>
                        <th class="text-center">#RMC</th>
                        <th>RMC</th>
                        <th class="text-end">Kg</th>
                        <th>Lote</th>
                        <th class="text-center pend-th-sort" data-col="ftenido" data-dir="" style="cursor:pointer;user-select:none;" title="Ordenar por F. Teñido">
                            F. Teñido <i class="bi bi-arrow-down-up sort-icon ms-1"></i>
                        </th>
                        <th>Eval. Calidad</th>
                        <th class="text-center pend-th-sort" data-col="fprogenc" data-dir="" style="cursor:pointer;user-select:none;" title="Ordenar por F. Prog. Enconado">
                            F. Prog. Enconado <i class="bi bi-arrow-down-up sort-icon ms-1"></i>
                        </th>
                        <th class="text-center pend-th-sort" data-col="fentrega" data-dir="" style="cursor:pointer;user-select:none;" title="Ordenar por F. Entrega">
                            F. Entrega <i class="bi bi-arrow-down-up sort-icon ms-1"></i>
                        </th>
                        <th class="text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in lista)
                    {
                        var rowCss = item.EstaVencido ? "table-danger" :
                                     item.DiasRetraso >= -2 ? "table-warning" : "";
                        var estadoEnc = !item.FchEntrega.HasValue ? "sinfecha" :
                                         item.EstaVencido       ? "vencido"   :
                                         item.DiasRetraso >= -2 ? "porvencer" : "atiempo";
                        <tr class="@rowCss"
                            data-estado="@estadoEnc"
                            data-ftenido="@(item.FecTenido.HasValue ? item.FecTenido.Value.ToString("yyyyMMdd") : "99999999")"
                            data-fprogenc="@(item.FhcProg.HasValue ? item.FhcProg.Value.ToString("yyyyMMdd") : "99999999")"
                            data-fentrega="@(item.FchEntrega.HasValue ? item.FchEntrega.Value.ToString("yyyyMMdd") : "99999999")"
                            data-rmc="@item.Rmc"
                            data-kg="@item.Peso.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                            <td class="fw-bold">@item.Partida</td>
                            <td>@item.Material</td>
                            <td style="font-size:.78rem;">@item.ColorTecnico</td>
                            <td style="font-size:.78rem;">@item.ColorCli</td>
                            <td>
                                <span style="max-width:160px;display:inline-block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
                                      title="@item.Cliente">@item.Cliente</span>
                            </td>
                            <td class="text-center text-muted">
                                @(item.NroRmc > 0 ? item.NroRmc.ToString("N0") : "—")
                            </td>
                            <td class="text-muted" style="font-size:.78rem;">
                                @(!string.IsNullOrWhiteSpace(item.Rmc) ? item.Rmc : "—")
                            </td>
                            <td class="text-end fw-semibold">@item.Peso.ToString("N2")</td>
                            <td style="font-size:.78rem;">@item.Lote</td>
                            <td class="text-center text-muted">
                                @(item.FecTenido.HasValue ? item.FecTenido.Value.ToString("dd/MM/yy") : "—")
                            </td>
                            <td style="font-size:.78rem;">@item.DescEstEvaluacion</td>
                            <td class="text-center text-muted">
                                @(item.FhcProg.HasValue ? item.FhcProg.Value.ToString("dd/MM/yy") : "—")
                            </td>
                            <td class="text-center">
                                @if (item.FchEntrega.HasValue)
                                {
                                    <span class="fw-semibold @(item.EstaVencido ? "text-danger" : item.DiasRetraso >= -2 ? "text-warning" : "text-success")">
                                        @item.FchEntrega.Value.ToString("dd/MM/yy")
                                    </span>
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td class="text-center">
                                @if (item.EstaVencido)
                                {
                                    <span class="badge bg-danger">+@item.DiasRetraso d</span>
                                }
                                else if (item.DiasRetraso >= -2)
                                {
                                    <span class="badge bg-warning text-dark">@(-item.DiasRetraso) d</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@(-item.DiasRetraso) d</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold table-light">
                        <td colspan="7" class="text-end">Total Kg (filtrado):</td>
                        <td class="text-end" id="kg-total-footer">@lista.Sum(x => x.Peso).ToString("N2")</td>
                        <td colspan="6"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }

</div>

@section Scripts {
<script>
(function () {
    var tbl = document.getElementById('tbl-enconado');
    if (!tbl) return;
    var tbody      = tbl.querySelector('tbody');
    var selEstado  = document.getElementById('filtro-estado-enc');
    var lblCount   = document.getElementById('enc-count-label');

    var filtroTipo    = @Html.Raw(Json.Serialize(ViewBag.FiltroTipoSel ?? ""));
    var filtroAsesor  = @Html.Raw(Json.Serialize(ViewBag.FiltroAsesor ?? ""));
    var filtroCliente = @Html.Raw(Json.Serialize(ViewBag.FiltroCliente ?? ""));
    // RMC ya viene filtrado desde el servidor (PKG_PLN.SP_PLN_PEND_ENCONADO, p_rmc);
    // se reenvía el mismo valor a los cuadros resumen para que coincidan con la grilla.
    var filtroRmc     = @Html.Raw(Json.Serialize(ViewBag.FiltroRmc ?? "%"));

    function escapeHtml(s) {
        return String(s == null ? '' : s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    function showToast(msg, type) {
        type = type || 'danger';
        var container = document.getElementById('toastContainer');
        if (!container) {
            container = document.createElement('div');
            container.id = 'toastContainer';
            container.style.cssText = 'position:fixed;top:1rem;right:1rem;z-index:9999;';
            document.body.appendChild(container);
        }
        var toast = document.createElement('div');
        toast.className = 'alert alert-' + type + ' alert-dismissible fade show shadow';
        toast.style.cssText = 'min-width:300px;font-size:.85rem;margin-bottom:.5rem;';
        toast.innerHTML = escapeHtml(msg) + '<button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>';
        container.appendChild(toast);
        setTimeout(function () { if (toast.parentNode) toast.remove(); }, 6000);
    }

    // ── Recalcula los 2 cuadros resumen en el servidor cuando cambia Estado ──
    // (RMC ya no cambia sin recargar la página; ver comentario en filtroRmc arriba)
    var cuadro1Body = document.getElementById('cuadro1-body');
    var cuadro2Body = document.getElementById('cuadro2-body');

    function estadoParamActual() {
        var v = selEstado ? selEstado.value : '';
        return v ? v.toUpperCase() : '%';
    }

    function renderCuadro1(rows) {
        if (!cuadro1Body) return;
        var totKg = 0, totCant = 0;
        var html = rows.map(function (c) {
            totKg += c.pesoKg; totCant += c.cantidad;
            return '<tr><td>' + escapeHtml(c.texto) + '</td><td class="text-end">' + fmtN2(c.pesoKg) + '</td><td class="text-end">' + fmtN0(c.cantidad) + '</td></tr>';
        }).join('');
        html += '<tr class="fw-bold table-light"><td>TOTAL</td><td class="text-end" id="cuadro1-total-kg">' + fmtN2(totKg) + '</td><td class="text-end" id="cuadro1-total-cant">' + fmtN0(totCant) + '</td></tr>';
        cuadro1Body.innerHTML = html;
    }

    function renderCuadro2(rows) {
        if (!cuadro2Body) return;
        var totKg = 0, totCant = 0;
        var html = rows.map(function (c) {
            totKg += c.kg; totCant += c.cantidad;
            return '<tr><td>' + escapeHtml(c.estatus) + '</td><td class="text-end">' + fmtN2(c.kg) + '</td><td class="text-end">' + fmtN0(c.cantidad) + '</td></tr>';
        }).join('');
        html += '<tr class="fw-bold table-light"><td>TOTAL</td><td class="text-end" id="cuadro2-total-kg">' + fmtN2(totKg) + '</td><td class="text-end" id="cuadro2-total-cant">' + fmtN0(totCant) + '</td></tr>';
        cuadro2Body.innerHTML = html;
    }

    function fmtN2(n) { return (n || 0).toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
    function fmtN0(n) { return (n || 0).toLocaleString('es-PE', { maximumFractionDigits: 0 }); }

    var cuadro1Loading = document.getElementById('cuadro1-loading');
    var cuadro2Loading = document.getElementById('cuadro2-loading');
    function toggleCuadrosLoading(show) {
        if (cuadro1Loading) cuadro1Loading.classList.toggle('d-none', !show);
        if (cuadro2Loading) cuadro2Loading.classList.toggle('d-none', !show);
    }

    var cuadrosAbortCtrl = null;
    function refreshCuadros() {
        if (!cuadro1Body && !cuadro2Body) return;
        if (cuadrosAbortCtrl) cuadrosAbortCtrl.abort();
        cuadrosAbortCtrl = new AbortController();
        toggleCuadrosLoading(true);
        var qs = new URLSearchParams({
            tipo: filtroTipo, asesor: filtroAsesor, cliente: filtroCliente,
            rmc: filtroRmc, estado: estadoParamActual()
        });
        fetch('@Url.Action("GetEnconadoCuadros", "Planeamiento")?' + qs.toString(), { signal: cuadrosAbortCtrl.signal })
            .then(function (r) {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                return r.json();
            })
            .then(function (data) {
                renderCuadro1(data.cuadro1 || []);
                renderCuadro2(data.cuadro2 || []);
            })
            .catch(function (err) {
                if (err.name === 'AbortError') return;
                console.error('Error al actualizar cuadros', err);
                showToast('No se pudieron actualizar los cuadros resumen. Intente nuevamente.', 'warning');
            })
            .finally(function () { toggleCuadrosLoading(false); });
    }

    var sortState = { col: 'fprogenc', dir: 'asc' };

    function updateIcons() {
        tbl.querySelectorAll('.pend-th-sort').forEach(function (th) {
            var icon = th.querySelector('.sort-icon');
            if (!icon) return;
            icon.className = 'bi sort-icon ms-1 ' + (th.dataset.col === sortState.col
                ? (sortState.dir === 'asc' ? 'bi-sort-up' : 'bi-sort-down')
                : 'bi-arrow-down-up');
        });
    }

    var kgTotalFooter = document.getElementById('kg-total-footer');

    function applyFilter() {
        var filtro = selEstado ? selEstado.value : '';
        var visible = 0;
        var kgTotal = 0;
        tbody.querySelectorAll('tr').forEach(function (r) {
            var show = (!filtro || r.dataset.estado === filtro);
            r.style.display = show ? '' : 'none';
            if (show) { visible++; kgTotal += parseFloat(r.dataset.kg || '0') || 0; }
        });
        if (lblCount) {
            lblCount.textContent = filtro
                ? visible + ' de @lista.Count partida@(lista.Count == 1 ? "" : "s")'
                : '';
        }
        if (kgTotalFooter) kgTotalFooter.textContent = fmtN2(kgTotal);
        refreshCuadros();
    }

    function sortTable(col, dir) {
        var NODATE = '99999999';
        var rows = Array.from(tbody.querySelectorAll('tr'));
        rows.sort(function (a, b) {
            var va = a.dataset[col] || NODATE;
            var vb = b.dataset[col] || NODATE;
            // filas sin fecha siempre al final, independientemente de la dirección
            var aNoDate = va === NODATE;
            var bNoDate = vb === NODATE;
            if (aNoDate && bNoDate) return 0;
            if (aNoDate) return 1;
            if (bNoDate) return -1;
            if (va === vb) return 0;
            return dir === 'asc' ? (va < vb ? -1 : 1) : (va > vb ? -1 : 1);
        });
        rows.forEach(function (r) { tbody.appendChild(r); });
        sortState.col = col; sortState.dir = dir;
        updateIcons();
    }

    tbl.querySelectorAll('.pend-th-sort').forEach(function (th) {
        th.addEventListener('click', function () {
            var col = this.dataset.col;
            var dir = (sortState.col === col && sortState.dir === 'asc') ? 'desc' : 'asc';
            sortTable(col, dir);
        });
    });

    if (selEstado) selEstado.addEventListener('change', applyFilter);

    // Orden inicial: F. Prog. Enconado ASC
    sortTable('fprogenc', 'asc');
})();
</script>
}
