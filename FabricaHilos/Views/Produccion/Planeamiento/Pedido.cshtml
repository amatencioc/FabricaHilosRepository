                    </button>
                </li>
                <li>
                    <button class="dropdown-item small" data-bs-toggle="modal" data-bs-target="#modalRecalcular">
                        <i class="bi bi-calculator me-2 text-info"></i>Recalcular fechas
                    </button>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <button class="dropdown-item small text-danger" data-bs-toggle="modal" data-bs-target="#modalCerrar">
                        <i class="bi bi-x-circle me-2"></i>Cerrar ítem
                    </button>
                </li>
            </ul>
