        const logsCont = document.getElementById('logsJobContainer');
        if (logsCont) logsCont.style.display = 'none';
    }

    // Ir al proceso activo: limpia el modal de bloqueo y muestra el progreso real con logs
    function verProcesoActivo(jobId, periodo, tipo) {
        _pollingJobId = jobId;
        sessionStorage.setItem('sireJobId', jobId);
        sessionStorage.setItem('periodoExportacion', periodo);
        sessionStorage.setItem('tipoExportacion', tipo);
        // Limpiar panel de logs antes de la transición
        const logsCont = document.getElementById('logsJobContainer');
        if (logsCont) { logsCont.innerHTML = ''; logsCont.style.display = 'none'; }
        // Mostrar estado de carga y lanzar polling
        actualizarModalExportacion('EnProceso', 'Conectando al proceso activo…', jobId, 0);
        cargarLogsJob(jobId);
        consultarEstadoJob(jobId, periodo, tipo);
    }

    function mostrarInfoReconexion(estado, fechaCreacion, minutos, jobId, periodo, tipo, extraHtml = '', proximaConsulta = null) {
        const estadoDiv = document.getElementById('estadoExportacion');
        // EsperandoTicket nunca se considera "parado": es comportamiento normal
        const esEsperando = estado === 'EsperandoTicket';
        const esViejo = !esEsperando && minutos > 30;
        const estadoLabel = {
            Pendiente: 'En cola',
            EnProceso: 'En proceso',
            EsperandoTicket: '⏳ Esperando SUNAT'
        }[estado] || estado;

        const proximaFila = esEsperando && proximaConsulta
            ? `<tr><td class="text-muted">Próx. consulta</td><td><strong>${proximaConsulta}</strong></td></tr>`
            : '';
        const notaEsperando = esEsperando
            ? `<div class="alert alert-info py-2 mb-2" style="font-size:.82rem">
                <i class="bi bi-hourglass-split me-1"></i>
                SUNAT aún está generando el archivo. El sistema verificará automáticamente cada 15 min. No es necesario hacer nada.
               </div>`
            : '';

        estadoDiv.innerHTML = `
            <div class="alert alert-warning py-2 mb-2 text-start" style="font-size:.85rem">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                <strong>Hay un proceso activo para este período</strong> — No se inició uno nuevo.
            </div>
            <table class="table table-sm table-borderless mb-2" style="font-size:.85rem">
                <tr><td class="text-muted">Estado</td><td><span class="badge bg-warning text-dark">${estadoLabel}</span></td></tr>
                <tr><td class="text-muted">Iniciado</td><td>${fechaCreacion}</td></tr>
                ${!esEsperando ? `<tr><td class="text-muted fw-semibold">Sin avanzar</td><td class="${esViejo ? 'text-danger fw-bold' : ''}">${minutos} min</td></tr>` : ''}
                ${proximaFila}
            </table>
            ${notaEsperando}
            ${extraHtml}
            ${esViejo ? `
            <div class="alert alert-danger py-2 mb-2" style="font-size:.82rem">
                <i class="bi bi-clock-history me-1"></i>
                Este proceso lleva <strong>${minutos} minutos</strong> sin avanzar. Puede cancelarlo y reiniciar.
            </div>
            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <button class="btn btn-sm btn-danger" onclick="cancelarJob('${jobId}','${periodo}','${tipo}')">
                    <i class="bi bi-x-circle me-1"></i>Cancelar y reiniciar
                </button>
                <button class="btn btn-sm btn-outline-secondary" onclick="cancelarJobSolo('${jobId}')">
                    <i class="bi bi-x me-1"></i>Solo cancelar
                </button>
            </div>` : ''}`;
        cargarLogsJob(jobId);
    }

    function mostrarAdvertenciaParado(estado, minutos, fechaCreacion, jobId, periodo, tipo, ticket) {
        const estadoDiv = document.getElementById('estadoExportacion');
        const estadoLabel = estado === 'Pendiente' ? 'En cola' : 'En proceso';
        estadoDiv.innerHTML = `
            <div class="alert alert-warning py-2 mb-2" style="font-size:.85rem">
                <i class="bi bi-clock-history me-1"></i>
                <strong>${estadoLabel}</strong> — Sin avanzar por <strong>${minutos} min</strong>
            </div>
            <p class="small text-center text-muted mb-2">El servidor está procesando. Si no avanza, puede cancelar y reiniciar.</p>
            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <button class="btn btn-sm btn-danger" onclick="cancelarJob('${jobId}','${periodo}','${tipo}')">
                    <i class="bi bi-x-circle me-1"></i>Cancelar y reiniciar
                </button>
                <button class="btn btn-sm btn-outline-secondary" onclick="cancelarJobSolo('${jobId}')">
                    <i class="bi bi-x me-1"></i>Solo cancelar
                </button>
            </div>`;
        cargarLogsJob(jobId);
