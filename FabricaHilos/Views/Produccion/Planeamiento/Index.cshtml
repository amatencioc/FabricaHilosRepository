@model List<FabricaHilos.Models.Sgc.SgcModuloDto>

@{
    ViewData["Title"] = "Planeamiento de Planta";
}

@section Styles {
<link rel="stylesheet" href="~/css/planeamiento.css" />
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Produccion" asp-action="Index">Producción</a></li>
    <li class="breadcrumb-item active">Planeamiento</li>
}

<h4 class="section-title"><i class="bi bi-diagram-3 me-2"></i>Módulo de Planeamiento</h4>

@if (Model.Any())
{
    <div class="row g-4">
        @foreach (var modulo in Model)
        {
            <div class="col-md-6">
                <div class="card card-dashboard h-100">
                    <div class="card-body text-center p-5">
                        <i class="bi @modulo.Icono display-4 @modulo.ColorClase mb-3"></i>
                        <h5 class="fw-bold">@modulo.Nombre</h5>
                        <p class="text-muted">@modulo.Descripcion</p>
                        <a asp-controller="@modulo.Controller" asp-action="@modulo.Action"
                           class="btn btn-outline-primary mt-2">
                            <i class="bi bi-arrow-right me-1"></i>Ir a @modulo.Nombre
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">No tiene módulos de Planeamiento habilitados.</div>
}
