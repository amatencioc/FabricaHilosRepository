.tbl-lms tbody tr:hover td { background:#f8fafc; }
.bdg { display:inline-block; font-size:.67rem; font-weight:600; padding:.2em .55em; border-radius:4px; text-transform:uppercase; letter-spacing:.03em; }
.bdg-comp { background:#f0fdfa; color:#0f766e; }
.bdg-prog { background:#eff6ff; color:#1d4ed8; }
.bdg-venc { background:#fff1f2; color:#9f1239; }
.bdg-anul { background:#f8fafc; color:#64748b; border:1px solid #e2e8f0; }
.bdg-obl  { background:#fff1f2; color:#9f1239; border:1px solid #fecdd3; }
.progress-lms-inline { height:5px; border-radius:3px; background:#e8edf3; overflow:hidden; display:inline-block; width:80px; vertical-align:middle; }
.progress-lms-bar { height:100%; background:linear-gradient(90deg,#1d4ed8,#0284c7); border-radius:3px; }
.lms-btn { display:inline-flex; align-items:center; gap:.35rem; border-radius:7px; padding:.38rem .9rem; font-size:.82rem; font-weight:500; text-decoration:none; transition:all .12s; cursor:pointer; border:none; }
.lms-btn-primary { background:#1d4ed8; color:#fff; }
.lms-btn-primary:hover { background:#1e40af; color:#fff; }
.lms-btn-outline { background:#fff; border:1px solid #dde3ec !important; color:#334155; }
.lms-btn-outline:hover { background:#f8fafc; border-color:#94a3b8 !important; color:#0f172a; }
.lms-tabs .nav-link { color:#64748b; font-size:.85rem; font-weight:600; border:none; border-bottom:2px solid transparent; border-radius:0; padding:.6rem 1rem; }
.lms-tabs .nav-link.active { color:#1d4ed8; border-bottom-color:#1d4ed8; background:transparent; }
.lms-tabs .nav-link:hover { color:#1d4ed8; }
#pivChartOuter { overflow-x:auto; overflow-y:hidden; }
#pivChartOuter::-webkit-scrollbar { height:8px; }
#pivChartOuter::-webkit-scrollbar-thumb { background:#cbd5e1; border-radius:4px; }
.piv-toolbar label.form-label { font-size:.72rem; font-weight:600; color:#334155; }
.piv-tipo-group .btn { border-color:#dde3ec; color:#64748b; font-size:.85rem; padding:.3rem .55rem; }
.piv-tipo-group .btn-check:checked + .btn { background:#1d4ed8; border-color:#1d4ed8; color:#fff; }
.piv-insight-card { background:#fff; border:1px solid #dde3ec; border-radius:10px; padding:.8rem 1rem; display:flex; align-items:flex-start; gap:.7rem; height:100%; }
.piv-insight-icon { width:34px; height:34px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:1rem; flex-shrink:0; }
.piv-insight-lbl { font-size:.66rem; color:#94a3b8; text-transform:uppercase; letter-spacing:.06em; font-weight:700; }
.piv-insight-val { font-size:.95rem; font-weight:700; color:#0f172a; line-height:1.25; }
.piv-insight-sub { font-size:.72rem; color:#64748b; }
.piv-rank-item { display:flex; align-items:center; gap:.6rem; padding:.5rem 0; border-bottom:1px solid #f1f5f9; }
.piv-rank-item:last-child { border-bottom:none; }
.piv-rank-pos { width:22px; height:22px; border-radius:50%; background:#eff6ff; color:#1d4ed8; font-size:.7rem; font-weight:700; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.piv-rank-pos.top1 { background:#fef3c7; color:#92400e; }
.piv-rank-body { flex:1; min-width:0; }
.piv-rank-name { font-size:.78rem; font-weight:600; color:#0f172a; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.piv-rank-bar-bg { height:5px; border-radius:3px; background:#e8edf3; overflow:hidden; margin-top:3px; }
.piv-rank-bar { height:100%; background:linear-gradient(90deg,#1d4ed8,#0284c7); border-radius:3px; }
.piv-rank-val { font-size:.76rem; font-weight:700; color:#334155; flex-shrink:0; min-width:44px; text-align:right; }
.jef-header { cursor:pointer; background:#f8fafc; border:1px solid #e8edf3; border-radius:8px; padding:.6rem .9rem; display:flex; align-items:center; justify-content:between; gap:.6rem; }
.jef-header:hover { background:#f1f5f9; }
.jef-body { border:1px solid #e8edf3; border-top:none; border-radius:0 0 8px 8px; }
.area-row td { font-weight:700; background:#fafbfc; color:#0f172a; }
.ccosto-row td:first-child { padding-left:2rem; color:#64748b; }
.worker-row td { color:#334155; }
.worker-row td:first-child { font-weight:500; }
</style>
}

<div class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <span class="sec-lbl" style="margin-bottom:.25rem">Admin LMS · Capacitación</span>
    <h4 class="fw-bold mb-0" style="color:#0f172a">
      <i class="bi bi-bar-chart-fill me-2" style="color:#1d4ed8;font-size:1.1rem"></i>Reportes
      @if (cursoActivo != null)
      {
        <span class="ms-1" style="font-size:.82rem;font-weight:400;color:#64748b">· @cursoActivo.Titulo</span>
      }
    </h4>
  </div>
  <div class="d-flex gap-2">
    <a asp-controller="CapacitacionAdmin" asp-action="Index" class="lms-btn lms-btn-outline">
      <i class="bi bi-arrow-left"></i> Volver
    </a>
  </div>
</div>

<!-- Selector de curso y filtros — solo aplica a las pestañas Detalle / Panel interactivo
     (la pestaña Jefaturas usa CAP_V_HEADCOUNT_JEFATURA, independiente de estos filtros;
     se oculta automáticamente al abrir esa pestaña, ver script al final) -->
<div class="lms-card mb-4 p-3" id="filtrosPrincipales">
  <form method="get" asp-controller="CapacitacionAdmin" asp-action="Reportes" class="row g-2 align-items-end">
    <div class="col-md-6 col-lg-4">
      <label class="form-label" style="font-size:.75rem;font-weight:600;color:#334155">Curso</label>
      <select name="idCurso" class="form-select form-select-sm" onchange="this.form.submit()" style="border-color:#dde3ec;font-size:.84rem">
        <option value="">— Todos los cursos —</option>
        @foreach (var c in cursos)
        {
          <option value="@c.IdCurso" selected="@(c.IdCurso==idCursoActivo)">@c.Titulo</option>
        }
      </select>
    </div>
    <div class="col-md-6 col-lg-3">
      <label class="form-label" style="font-size:.75rem;font-weight:600;color:#334155">Categoría</label>
      <select name="idCategoria" class="form-select form-select-sm" onchange="this.form.submit()" style="border-color:#dde3ec;font-size:.84rem">
        <option value="">— Todas —</option>
        @foreach (var cat in categorias)
        {
          <option value="@cat.IdCategoria" selected="@(cat.IdCategoria==idCategoriaActiva)">@cat.Nombre</option>
        }
      </select>
    </div>
    <div class="col-md-6 col-lg-2">
      <label class="form-label" style="font-size:.75rem;font-weight:600;color:#334155">Gran Centro de Costo</label>
      <select name="area" class="form-select form-select-sm" onchange="this.form.submit()" style="border-color:#dde3ec;font-size:.84rem">
        <option value="">— Todos —</option>
        @foreach (var a in areas)
        {
          <option value="@a.GranCcosto" selected="@(a.GranCcosto==areaActiva)">@a.DescArea</option>
        }
      </select>
    </div>
    <div class="col-md-6 col-lg-2">
      <label class="form-label" style="font-size:.75rem;font-weight:600;color:#334155">Centro de Costo</label>
      <select name="centroCosto" class="form-select form-select-sm" onchange="this.form.submit()" style="border-color:#dde3ec;font-size:.84rem">
        <option value="">— Todos —</option>
        @foreach (var grupo in centrosCosto.GroupBy(c => c.DescArea).OrderBy(g => g.Key))
        {
          <optgroup label="@grupo.Key">
            @foreach (var c in grupo)
            {
              <option value="@c.CentroCosto" selected="@(c.CentroCosto==ccostoActivo)">@c.NombreCcosto</option>
            }
          </optgroup>
        }
      </select>
    </div>
    <div class="col-md-6 col-lg-1">
      <label class="form-label" style="font-size:.75rem;font-weight:600;color:#334155">Supervisor</label>
      <select name="supervisor" class="form-select form-select-sm" onchange="this.form.submit()" style="border-color:#dde3ec;font-size:.84rem">
        <option value="">— Todos —</option>
        @foreach (var s in supervisores)
        {
          <option value="@s.CodSupervisor" selected="@(s.CodSupervisor==supervisorActivo)">@s.NombreSupervisor</option>
        }
      </select>
    </div>
  </form>
  <div style="font-size:.7rem;color:#94a3b8;margin-top:.5rem">
    <i class="bi bi-info-circle me-1"></i>
    Un <strong>Gran Centro de Costo</strong> (ej. "PREPARATORIA") agrupa varios <strong>Centros de Costo</strong>
    (ej. BATAN, CARDAS, MANUARES...). Filtre por Gran Centro de Costo para ver todo el grupo, o elija un
    Centro de Costo puntual para acotar más.
  </div>
</div>

<ul class="nav lms-tabs mb-3" id="reportesTab" role="tablist">
  <li class="nav-item" role="presentation">
    <button class="nav-link active" id="tab-detalle-btn" data-bs-toggle="tab" data-bs-target="#tab-detalle" type="button" role="tab" aria-controls="tab-detalle" aria-selected="true">
      <i class="bi bi-table me-1"></i> Detalle
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" id="tab-analisis-btn" data-bs-toggle="tab" data-bs-target="#tab-analisis" type="button" role="tab" aria-controls="tab-analisis" aria-selected="false">
      <i class="bi bi-diagram-2 me-1"></i> Análisis organizacional
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" id="tab-jefaturas-btn" data-bs-toggle="tab" data-bs-target="#tab-jefaturas" type="button" role="tab" aria-controls="tab-jefaturas" aria-selected="false">
      <i class="bi bi-diagram-3-fill me-1"></i> Jefaturas
      <span class="badge rounded-pill ms-1" style="background:#eef2ff;color:#4338ca">@headcount.Count</span>
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" id="tab-rankings-btn" data-bs-toggle="tab" data-bs-target="#tab-rankings" type="button" role="tab" aria-controls="tab-rankings" aria-selected="false">
      <i class="bi bi-list-ol me-1"></i> Rankings
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" id="tab-panel-btn" data-bs-toggle="tab" data-bs-target="#tab-panel" type="button" role="tab" aria-controls="tab-panel" aria-selected="false">
      <i class="bi bi-bar-chart-fill me-1"></i> Panel interactivo
    </button>
  </li>
</ul>

<div class="tab-content" id="reportesTabContent">
  <div class="tab-pane fade show active" id="tab-detalle" role="tabpanel" aria-labelledby="tab-detalle-btn">
@if (Model.Any())
{
    <!-- KPIs del curso -->
    <div class="row g-3 mb-4">
      <div class="col-6 col-md-3 col-xl-2">
        <div class="lms-stat">
          <div class="lms-stat-icon" style="background:#eff6ff"><i class="bi bi-people-fill" style="color:#1d4ed8"></i></div>
          <div><div class="lms-stat-val">@Model.Count</div><div class="lms-stat-lbl">Inscritos</div></div>
        </div>
      </div>
      <div class="col-6 col-md-3 col-xl-2">
        <div class="lms-stat">
          <div class="lms-stat-icon" style="background:#f0fdfa"><i class="bi bi-check-circle-fill" style="color:#0f766e"></i></div>
          <div><div class="lms-stat-val">@Model.Count(i => i.Estado == "C")</div><div class="lms-stat-lbl">Completados</div></div>
        </div>
      </div>
      <div class="col-6 col-md-3 col-xl-2">
        <div class="lms-stat">
          <div class="lms-stat-icon" style="background:#ecfeff"><i class="bi bi-graph-up" style="color:#0891b2"></i></div>
          <div><div class="lms-stat-val">@(Model.Any() ? (int)Model.Average(i => i.PctProgreso) : 0)%</div><div class="lms-stat-lbl">Prom. avance</div></div>
        </div>
      </div>
      <div class="col-6 col-md-3 col-xl-2">
        <div class="lms-stat">
          <div class="lms-stat-icon" style="background:#fef3c7"><i class="bi bi-award-fill" style="color:#92400e"></i></div>
          <div><div class="lms-stat-val">@Model.Count(i => i.ExamenAprobado == "S")</div><div class="lms-stat-lbl">Examen aprobado</div></div>
        </div>
      </div>
      <div class="col-6 col-md-3 col-xl-2">
        <div class="lms-stat">
          <div class="lms-stat-icon" style="background:#fff1f2"><i class="bi bi-exclamation-circle-fill" style="color:#9f1239"></i></div>
          <div><div class="lms-stat-val">@Model.Count(i => i.TieneExamen == "S" && i.TotalIntentos == 0)</div><div class="lms-stat-lbl">Examen pendiente</div></div>
        </div>
      </div>
      <div class="col-6 col-md-3 col-xl-2">
        <div class="lms-stat">
          <div class="lms-stat-icon" style="background:#f8fafc"><i class="bi bi-calendar-check" style="color:#64748b"></i></div>
          <div><div class="lms-stat-val">@Model.Count(i => i.Obligatorio=="S")</div><div class="lms-stat-lbl">Obligatorios</div></div>
        </div>
      </div>
    </div>

    <!-- Tabla de inscritos -->
    <div class="alert-datos-snapshot mb-2" style="font-size:.74rem;color:#9a3412;background:#fff7ed;border:1px solid #fed7aa;border-radius:7px;padding:.5rem .8rem">
      <i class="bi bi-camera-fill me-1"></i>
      <strong>Dato histórico (foto al momento de inscribirse):</strong> Área, Centro de Costo y Cargo aquí mostrados corresponden a la situación del colaborador <u>cuando se inscribió</u> al curso, no a su situación actual. Si el colaborador cambió de área/cargo o cesó después, este detalle NO se actualiza (es el registro de auditoría del curso). Para ver la organización <strong>vigente hoy</strong>, usa la pestaña <strong>Jefaturas</strong>.
    </div>
    <div class="lms-card overflow-hidden">
      <div class="d-flex align-items-center justify-content-between px-3 py-2" style="border-bottom:1px solid #e8edf3">
        <span style="font-size:.78rem;font-weight:600;color:#334155">Detalle por usuario</span>
        <div class="input-group input-group-sm" style="max-width:200px">
          <span class="input-group-text bg-white border-end-0" style="border-color:#dde3ec"><i class="bi bi-search" style="color:#94a3b8;font-size:.75rem"></i></span>
          <input class="form-control form-control-sm border-start-0" id="searchReporte" placeholder="Buscar…" style="border-color:#dde3ec;font-size:.8rem" />
        </div>
      </div>
      <div class="table-responsive">
        <table class="table tbl-lms mb-0" id="tablaReporte">
          <thead>
            <tr>
              <th>Participante</th>
              <th>Nombre Completo</th>
              <th>DNI</th>
              <th>Gran Centro de Costo</th>
              <th>Centro de Costo</th>
              <th>Cargo</th>
              <th>Curso</th>
              <th>F. Ingreso</th>
              <th>Inscripción</th>
              <th>Progreso</th>
              <th>Estado</th>
              <th>Examen</th>
              <th>Nota</th>
              <th>Intentos</th>
              <th>Oblig.</th>
              <th>Vence</th>
            </tr>
          </thead>
          <tbody>
            @if (!idCursoActivo.HasValue)
            {
              var grupos = Model.GroupBy(i => i.TituloCurso ?? $"Curso #{i.IdCurso}").OrderBy(g => g.Key);
              foreach (var grupo in grupos)
              {
                var totalGrupo = grupo.Count();
                var completadosGrupo = grupo.Count(x => x.Estado == "C");
                var aprobadosGrupo = grupo.Count(x => x.ExamenAprobado == "S");
                <tr class="grupo-curso-row" style="background:#f8fafc">
                  <td colspan="16" style="padding:.5rem .75rem;border-bottom:2px solid #e8edf3">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                      <i class="bi bi-book-fill" style="color:#1d4ed8;font-size:.85rem"></i>
                      <span style="font-size:.82rem;font-weight:700;color:#0f172a">@grupo.Key</span>
                      <span class="bdg bdg-prog ms-2">@totalGrupo inscrito(s)</span>
                      <span class="bdg bdg-comp">@completadosGrupo completado(s)</span>
                      @if (grupo.Any(x => x.TieneExamen == "S"))
                      {
                        <span class="bdg" style="background:#fef3c7;color:#92400e">@aprobadosGrupo aprobado(s)</span>
                      }
                    </div>
                  </td>
                </tr>
                foreach (var i in grupo)
                {
                  @await Html.PartialAsync("~/Views/RecursosHumanos/Capacitacion/Admin/_ReporteFilaAlumno.cshtml", i)
                }
              }
            }
            else
            {
              foreach (var i in Model)
              {
                @await Html.PartialAsync("~/Views/RecursosHumanos/Capacitacion/Admin/_ReporteFilaAlumno.cshtml", i)
              }
            }
          </tbody>
        </table>
      </div>
    </div>
}
else
{
    <div style="background:#f0f9ff;border:1px solid #bae6fd;border-radius:8px;padding:.7rem 1rem;font-size:.84rem;color:#0369a1">
        <i class="bi bi-info-circle me-2"></i>No hay inscripciones registradas@(idCursoActivo.HasValue ? " en este curso" : "") aún.
    </div>
}
  </div>

  <div class="tab-pane fade" id="tab-rankings" role="tabpanel" aria-labelledby="tab-rankings-btn">
@if (Model.Any())
{
    <div class="lms-card mb-3 p-3">
      <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
        <i class="bi bi-list-ol" style="color:#1d4ed8"></i>
        <span style="font-size:.85rem;font-weight:700;color:#0f172a">Rankings</span>
        <span style="font-size:.72rem;color:#64748b">· top 8 por categoría, siempre visibles</span>
      </div>
    </div>
    <div class="row g-3" id="pivRankingsExtra">
      <div class="col-md-6 col-xl-4">
        <div class="lms-card p-3 h-100">
          <div class="d-flex align-items-center gap-2 mb-2">
            <i class="bi bi-book-fill" style="color:#1d4ed8;font-size:.8rem"></i>
            <span style="font-size:.8rem;font-weight:700;color:#0f172a">Cursos con más participantes</span>
          </div>
          <div id="rankCursos"></div>
        </div>
      </div>
      <div class="col-md-6 col-xl-4">
        <div class="lms-card p-3 h-100">
          <div class="d-flex align-items-center gap-2 mb-2">
            <i class="bi bi-diagram-2-fill" style="color:#0891b2;font-size:.8rem"></i>
            <span style="font-size:.8rem;font-weight:700;color:#0f172a">Gran Centro de Costo con más participantes</span>
          </div>
          <div id="rankArea"></div>
        </div>
      </div>
      <div class="col-md-6 col-xl-4">
        <div class="lms-card p-3 h-100">
