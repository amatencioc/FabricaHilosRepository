@section Styles {
<link rel="stylesheet" href="~/css/planeamiento.css" asp-append-version="true" />
}

@using FabricaHilos.Models.Produccion.Planeamiento
@model PlnSecadoViewModel
@{
    ViewData["Title"] = "Pendientes de Secado";
    var lista      = Model.Secado.ToList();
    var nVencidos  = lista.Count(x => x.EstaVencido);
    var kgTotal    = lista.Sum(x => x.Peso);
    var nMaquinas  = lista.Select(x => x.CodMaq).Distinct().Count();

    var tipo    = ViewBag.FiltroTipoSel as string ?? "";
    var asesor  = ViewBag.FiltroAsesor  as string ?? "";
    var cliente = ViewBag.FiltroCliente as string ?? "";

    var asesoresMap = ((ViewBag.FiltroAsesores as IEnumerable<PlnFiltroAsesor>) ?? Enumerable.Empty<PlnFiltroAsesor>())
        .Where(a => !string.IsNullOrEmpty(a.CodVende))
        .GroupBy(a => a.CodVende!, StringComparer.OrdinalIgnoreCase)
        .ToDictionary(g => g.Key, g => g.First().Nombre ?? g.First().Abreviada ?? "", StringComparer.OrdinalIgnoreCase);
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Produccion" asp-action="Index">Producción</a></li>
    <li class="breadcrumb-item active">Pendientes de Secado</li>
}

@await Html.PartialAsync("_PlnNavBar")

<div class="container-fluid py-3">

    @* ── Strip de cabecera ─────────────────────────────────────────────── *@
    <div class="pend-strip">
        <i class="bi bi-thermometer-half" style="color:#f6ad55;font-size:.95rem;flex-shrink:0;"></i>
        <span class="pend-strip-title">Pendientes de Secado</span>
        <span class="pend-strip-sep"></span>

        <span class="pend-kpi" title="Total de partidas pendientes de secado.">
            <i class="bi bi-boxes" style="color:#90cdf4;"></i>
            <span class="pend-kpi-val">@lista.Count</span>
            <span style="opacity:.75">partidas</span>
        </span>
        <span class="pend-kpi" style="@(nVencidos > 0 ? "" : "opacity:.45")"
              title="Partidas cuya fecha de entrega ya venció.">
            <i class="bi bi-clock-history" style="color:#fc8181;"></i>
            <span class="pend-kpi-val" style="@(nVencidos > 0 ? "color:#fc8181;" : "")">@nVencidos</span>
            <span style="opacity:.75">vencidas</span>
        </span>
        <span class="pend-kpi" title="Máquinas distintas involucradas.">
            <i class="bi bi-gear" style="color:#fbd38d;"></i>
            <span class="pend-kpi-val">@nMaquinas</span>
            <span style="opacity:.75">máquinas</span>
        </span>
        <span class="pend-kpi" title="Total de kg pendientes.">
            <i class="bi bi-bag-fill" style="color:#fbd38d;"></i>
            <span class="pend-kpi-val">@kgTotal.ToString("N0")</span>
            <span style="opacity:.75">kg</span>
        </span>
        <span class="pend-kpi" title="Partidas actualmente en proceso de secado (carga al abrir la pestaña).">
            <i class="bi bi-thermometer-sun" style="color:#f6ad55;"></i>
            <span class="pend-kpi-val" id="kpi-en-secado-count">—</span>
            <span style="opacity:.75">en secado</span>
        </span>

        <span class="pend-strip-actions">
            <a asp-action="Dashboard" class="btn btn-sm btn-outline-light py-0 px-2" style="font-size:.72rem;">
                <i class="bi bi-arrow-left me-1"></i>Seguimiento
            </a>
        </span>
    </div>

    @* ── Filtros ───────────────────────────────────────────────────────── *@
    <div class="pend-filter">
        @await Html.PartialAsync("_PlnFiltrosPendientes", (object)"PendientesSecado")
    </div>

    @* ── Tabs ──────────────────────────────────────────────────────────── *@
    <ul class="nav nav-tabs mt-3 mb-0" id="tabsSecado" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-secado-btn" data-bs-toggle="tab"
                    data-bs-target="#tab-secado" type="button" role="tab">
                <i class="bi bi-thermometer-half me-1"></i>Pend. Secado
                <span class="badge bg-secondary ms-1">@lista.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-en-secado-btn" data-bs-toggle="tab"
                    data-bs-target="#tab-en-secado" type="button" role="tab">
                <i class="bi bi-thermometer-sun me-1"></i>En Secado
                <span class="badge bg-secondary ms-1" id="badge-en-secado-count">
                    <span class="spinner-border spinner-border-sm" role="status" style="width:.6rem;height:.6rem;"></span>
                </span>
            </button>
        </li>
    </ul>

    <div class="tab-content border border-top-0 rounded-bottom p-3 bg-white">

    @* -- TAB 1: Pend. Secado (server-side) -- *@
    <div class="tab-pane fade show active" id="tab-secado" role="tabpanel">
    @if (!lista.Any())
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i>No hay partidas pendientes de secado en este momento.
        </div>
    }
    else
    {
        <div class="d-flex align-items-end gap-2 mb-2">
            <div style="position:relative;">
                <label class="form-label form-label-sm mb-0">RMC</label>
                <button type="button" id="btnFiltroRmc" class="form-control form-control-sm d-flex justify-content-between align-items-center"
                        style="width:220px;" autocomplete="off">
                    <span id="filtroRmcLabel" class="text-truncate">Todos</span>
                    <i class="bi bi-chevron-down small text-muted ms-1"></i>
                </button>
                <div id="dropdownRmc" class="pln-autocomplete-dropdown" style="display:none;width:260px;">
                    <div class="p-2 border-bottom">
                        <input type="text" id="filtroRmcSearch" class="form-control form-control-sm"
                               placeholder="Buscar RMC…" autocomplete="off" />
                    </div>
                    <div class="p-2 border-bottom d-flex justify-content-between">
                        <a href="#" id="filtroRmcTodos" class="small">Marcar todos</a>
                        <a href="#" id="filtroRmcLimpiar" class="small">Limpiar</a>
                    </div>
                    <div id="rmcCheckList" style="max-height:220px;overflow-y:auto;"></div>
                </div>
            </div>
            <span class="text-muted small" id="filtroRmcCount"></span>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0 pend-tbl" id="tbl-secado">
                <thead>
                    <tr>
                        <th>Máquina</th>
                        <th class="text-center pend-th-sort" data-col="ffintt" data-dir="" style="cursor:pointer;user-select:none;" title="Ordenar por Fecha Final de Teñido">
                            Fecha Final Teñido <i class="bi bi-arrow-down-up sort-icon ms-1"></i>
                        </th>
                        <th>Partida</th>
                        <th>Material</th>
                        <th>Color Cliente</th>
                        <th>Cliente</th>
                        <th>Asesor</th>
                        <th>Proceso</th>
                        <th>RMC</th>
                        <th class="text-center">Nro RMC</th>
                        <th class="text-end">Kg</th>
                        <th>Lote</th>
                        <th class="text-center pend-th-sort" data-col="fentrega" data-dir="" style="cursor:pointer;user-select:none;" title="Ordenar por F. Entrega">
                            F. Entrega <i class="bi bi-arrow-down-up sort-icon ms-1"></i>
                        </th>
                        <th class="text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in lista)
                    {
                        var rowCss = item.EstaVencido ? "table-danger" :
                                     item.DiasRetraso >= -2 ? "table-warning" : "";
                        <tr class="@rowCss"
                            data-ffintt="@(item.Fecha.HasValue ? item.Fecha.Value.ToString("yyyyMMdd") : "99999999")"
                            data-fentrega="@(item.FchEntrega.HasValue ? item.FchEntrega.Value.ToString("yyyyMMdd") : "99999999")"
                            data-rmc="@item.Rmc">
                            <td style="font-size:.78rem;">@item.Maquina</td>
                            <td class="text-center text-muted">
                                @(item.Fecha.HasValue ? item.Fecha.Value.ToString("dd/MM/yy HH:mm") : "—")
                            </td>
                            <td class="fw-bold" style="white-space:nowrap;">@item.Partida</td>
                            <td>@item.Material</td>
                            <td style="font-size:.78rem;" class="text-muted">@item.ColorTecnico</td>
                            <td>
                                <span style="max-width:160px;display:inline-block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
                                      title="@item.Cliente">@item.Cliente</span>
                            </td>
                            <td style="font-size:.78rem;" class="text-muted">
                                @(asesoresMap.TryGetValue(item.CodVende, out var nombreAsesor) ? nombreAsesor : "—")
                            </td>
                            <td style="font-size:.75rem;" class="text-muted">@item.Proceso</td>
                            <td style="font-size:.78rem;">@item.Rmc</td>
                            <td class="text-center text-muted">
                                @(item.NroRmc > 0 ? item.NroRmc.ToString("N0") : "—")
                            </td>
                            <td class="text-end fw-semibold">@item.Peso.ToString("N2")</td>
                            <td style="font-size:.78rem;">@item.Lote</td>
                            <td class="text-center">
                                @if (item.FchEntrega.HasValue)
                                {
                                    <span class="fw-semibold @(item.EstaVencido ? "text-danger" : item.DiasRetraso >= -2 ? "text-warning" : "text-success")">
                                        @item.FchEntrega.Value.ToString("dd/MM/yy")
                                    </span>
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td class="text-center">
                                @if (!item.FchEntrega.HasValue)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else if (item.EstaVencido)
                                {
                                    <span class="badge bg-danger" title="@item.DiasRetraso días vencido">+@item.DiasRetraso d</span>
                                }
                                else if (item.DiasRetraso >= -2)
                                {
                                    <span class="badge bg-warning text-dark">@(-item.DiasRetraso) d</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@(-item.DiasRetraso) d</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-semibold">
                        <td colspan="10" class="text-end text-muted">Totales:</td>
                        <td class="text-end">@kgTotal.ToString("N2")</td>
                        <td colspan="3"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    </div>

    @* -- TAB 2: En Secado – lazy load -- *@
    <div class="tab-pane fade" id="tab-en-secado" role="tabpanel">
        <div id="en-secado-tab-body" class="pt-2">
            <div class="d-flex align-items-center justify-content-center py-5">
                <div class="spinner-border text-secondary me-2" role="status"></div>
                <span class="text-muted">Cargando partidas en secado&hellip;</span>
            </div>
        </div>
    </div>

    </div>

</div>

@section Scripts {
<script>
function initThSort(tableId) {
    var tbl = document.getElementById(tableId);
    if (!tbl) return;
    var tbody = tbl.querySelector('tbody');
    var sortState = { col: null, dir: '' };
    function updateIcons() {
        tbl.querySelectorAll('.pend-th-sort').forEach(function (th) {
            var icon = th.querySelector('.sort-icon');
            if (!icon) return;
            icon.className = 'bi sort-icon ms-1 ' + (th.dataset.col === sortState.col
                ? (sortState.dir === 'asc' ? 'bi-sort-up' : 'bi-sort-down')
                : 'bi-arrow-down-up');
        });
    }
    function sortTable(col, dir) {
        var rows = Array.from(tbody.querySelectorAll('tr'));
        rows.sort(function (a, b) {
            var va = a.dataset[col] || '99999999';
            var vb = b.dataset[col] || '99999999';
            if (va === vb) return 0;
            return dir === 'asc' ? (va < vb ? -1 : 1) : (va > vb ? -1 : 1);
        });
        rows.forEach(function (r) { tbody.appendChild(r); });
        sortState.col = col; sortState.dir = dir;
        updateIcons();
        if (typeof tbl._pagerRender === 'function') tbl._pagerRender();
    }
    tbl.querySelectorAll('.pend-th-sort').forEach(function (th) {
        th.addEventListener('click', function () {
            var col = this.dataset.col;
            var dir = (sortState.col === col && sortState.dir === 'asc') ? 'desc' : 'asc';
            sortTable(col, dir);
        });
    });
}

(function () {
    initThSort('tbl-secado');
})();

(function () {
    // ── Filtro de RMC multi-selección (client-side, sobre la data ya cargada) ──
    var btn        = document.getElementById('btnFiltroRmc');
    var dropdown   = document.getElementById('dropdownRmc');
    var search     = document.getElementById('filtroRmcSearch');
    var checkList  = document.getElementById('rmcCheckList');
    var label      = document.getElementById('filtroRmcLabel');
    var count      = document.getElementById('filtroRmcCount');
    var btnTodos   = document.getElementById('filtroRmcTodos');
    var btnLimpiar = document.getElementById('filtroRmcLimpiar');
    var tbl        = document.getElementById('tbl-secado');
    if (!btn || !tbl) return;

    var tbody    = tbl.querySelector('tbody');
    var rows     = Array.from(tbody.querySelectorAll('tr'));
    var total    = rows.length;
    var selected = new Set(); // vacío = "Todos"

    // Valores distintos de RMC presentes en la data ya cargada, ordenados alfabéticamente
    var valores = Array.from(new Set(rows.map(function (r) { return r.dataset.rmc || ''; })))
        .filter(function (v) { return v.length > 0; })
        .sort(function (a, b) { return a.localeCompare(b); });

    function renderCheckList(filter) {
        var q = (filter || '').trim().toLowerCase();
        var items = q.length === 0
            ? valores
            : valores.filter(function (v) { return v.toLowerCase().includes(q); });

        checkList.innerHTML = items.map(function (v) {
            var isChecked = selected.has(v);
            return '<div class="rmc-item d-flex align-items-center px-2 py-2' + (isChecked ? ' rmc-item-selected' : '') + '" data-val="' + v.replace(/"/g, '&quot;') + '">' +
                   '<i class="bi ' + (isChecked ? 'bi-check-square-fill text-primary' : 'bi-square text-muted') + ' me-2"></i>' +
                   '<span class="small">' + v + '</span>' +
                   '</div>';
        }).join('') || '<div class="p-2 text-muted small">Sin coincidencias</div>';

        checkList.querySelectorAll('.rmc-item').forEach(function (item) {
            item.addEventListener('click', function () {
                var v = item.dataset.val;
                if (selected.has(v)) selected.delete(v); else selected.add(v);
                renderCheckList(search.value);
                updateLabel();
                applyFilter();
            });
        });
    }

    function updateLabel() {
        if (selected.size === 0) {
            label.textContent = 'Todos';
        } else if (selected.size === 1) {
            label.textContent = Array.from(selected)[0];
        } else {
            label.textContent = selected.size + ' seleccionados';
        }
    }

    function applyFilter() {
        var visibles = 0;
        rows.forEach(function (r) {
            var rmc = r.dataset.rmc || '';
            var match = selected.size === 0 || selected.has(rmc);
            r.style.display = match ? '' : 'none';
            if (match) visibles++;
        });
        count.textContent = selected.size === 0
            ? ''
            : visibles + ' de ' + total + ' partidas';
    }

    function toggleDropdown(show) {
        dropdown.style.display = show ? 'block' : 'none';
        if (show) { renderCheckList(search.value); search.focus(); }
    }

    btn.addEventListener('click', function (e) {
        e.preventDefault();
        toggleDropdown(dropdown.style.display !== 'block');
    });

    document.addEventListener('click', function (e) {
        if (!dropdown.contains(e.target) && e.target !== btn && !btn.contains(e.target)) {
            toggleDropdown(false);
        }
    });

    search.addEventListener('input', function () { renderCheckList(search.value); });

    btnTodos.addEventListener('click', function (e) {
        e.preventDefault();
        valores.forEach(function (v) { selected.add(v); });
        renderCheckList(search.value);
        updateLabel();
        applyFilter();
    });

    btnLimpiar.addEventListener('click', function (e) {
        e.preventDefault();
        selected.clear();
        renderCheckList(search.value);
        updateLabel();
        applyFilter();
    });
})();

(function () {
    /* =====================================================================
       PAGINACIÓN — función genérica reutilizable (usada por la pestaña "En Secado")
       ===================================================================== */
    function initPager(tableId, sizeSelId, navId, infoTopId, infoBotId) {
        var table   = document.getElementById(tableId);
        var sizeSel = document.getElementById(sizeSelId);
        var navEl   = document.getElementById(navId);
        var infoTop = infoTopId ? document.getElementById(infoTopId) : null;
        var infoBot = infoBotId ? document.getElementById(infoBotId) : null;
        if (!table || !sizeSel || !navEl) return;

        var tbody   = table.querySelector('tbody');
        var curPage = 1;

        function allRows() {
            return Array.prototype.slice.call(tbody.querySelectorAll('tr'));
        }

        function render() {
            var allR     = allRows();
            var filterFn = table._rmcFilter || function () { return true; };
            var rows     = allR.filter(filterFn);
            allR.forEach(function (r) { if (!filterFn(r)) r.style.display = 'none'; });
            var pageSize = parseInt(sizeSel.value, 10) || 20;
            var total    = rows.length;
            var pages    = Math.max(1, Math.ceil(total / pageSize));
            if (curPage > pages) curPage = pages;

            var start = (curPage - 1) * pageSize;
            var end   = Math.min(start + pageSize, total);

            rows.forEach(function (r, i) {
                r.style.display = (i >= start && i < end) ? '' : 'none';
            });

            var infoTxt = total === 0 ? '' :
                'Mostrando ' + (start + 1) + ' – ' + end + ' de ' + total + ' filas';
            if (infoTop) infoTop.textContent = infoTxt;
            if (infoBot) infoBot.textContent = infoTxt;

            navEl.innerHTML = '';
            if (pages <= 1) return;

            function addItem(label, page, disabled, active) {
                var li = document.createElement('li');
                li.className = 'page-item' + (disabled ? ' disabled' : '') + (active ? ' active' : '');
                var a = document.createElement('a');
                a.className = 'page-link';
                a.href = '#';
                a.innerHTML = label;
                if (!disabled && !active) {
                    a.addEventListener('click', function (e) {
                        e.preventDefault();
                        curPage = page;
                        render();
                    });
                } else {
                    a.addEventListener('click', function (e) { e.preventDefault(); });
                }
                li.appendChild(a);
                navEl.appendChild(li);
            }

            addItem('&laquo;', curPage - 1, curPage === 1, false);

            var winSize  = 5;
            var winStart = Math.max(1, curPage - Math.floor(winSize / 2));
            var winEnd   = Math.min(pages, winStart + winSize - 1);
            winStart     = Math.max(1, winEnd - winSize + 1);

            if (winStart > 1) {
                addItem('1', 1, false, false);
                if (winStart > 2) addItem('…', null, true, false);
            }
            for (var p = winStart; p <= winEnd; p++) {
                addItem(p, p, false, p === curPage);
            }
            if (winEnd < pages) {
                if (winEnd < pages - 1) addItem('…', null, true, false);
                addItem(pages, pages, false, false);
            }

            addItem('&raquo;', curPage + 1, curPage === pages, false);
        }

        sizeSel.addEventListener('change', function () { curPage = 1; render(); });
        render();

        table._pagerRender = render;
        table._pagerResetPage = function () { curPage = 1; render(); };
    }

    /* =====================================================================
       FILTRO RMC (multi-selección, combinado con la paginación)
       ===================================================================== */
    function initRmcPagerFilter(tableId, ids) {
        var tbl        = document.getElementById(tableId);
        var btn        = document.getElementById(ids.btn);
        var dropdown   = document.getElementById(ids.dropdown);
        var search     = document.getElementById(ids.search);
        var checkList  = document.getElementById(ids.checkList);
        var label      = document.getElementById(ids.label);
        var count      = document.getElementById(ids.count);
        var btnTodos   = document.getElementById(ids.todos);
        var btnLimpiar = document.getElementById(ids.limpiar);
        if (!tbl || !btn) return;

        var tbody    = tbl.querySelector('tbody');
        var rows     = Array.from(tbody.querySelectorAll('tr'));
        var total    = rows.length;
        var selected = new Set();

        var valores = Array.from(new Set(rows.map(function (r) { return r.dataset.rmc || ''; })))
            .filter(function (v) { return v.length > 0; })
            .sort(function (a, b) { return a.localeCompare(b, undefined, { numeric: true }); });

        function renderCheckList(filter) {
            var q = (filter || '').trim().toLowerCase();
            var items = q.length === 0
                ? valores
                : valores.filter(function (v) { return v.toLowerCase().includes(q); });

            checkList.innerHTML = items.map(function (v) {
                var isChecked = selected.has(v);
                return '<div class="rmc-item d-flex align-items-center px-2 py-2' + (isChecked ? ' rmc-item-selected' : '') + '" data-val="' + v.replace(/"/g, '&quot;') + '">' +
                       '<i class="bi ' + (isChecked ? 'bi-check-square-fill text-primary' : 'bi-square text-muted') + ' me-2"></i>' +
                       '<span class="small">' + v + '</span>' +
                       '</div>';
            }).join('') || '<div class="p-2 text-muted small">Sin coincidencias</div>';

            checkList.querySelectorAll('.rmc-item').forEach(function (item) {
                item.addEventListener('click', function () {
                    var v = item.dataset.val;
                    if (selected.has(v)) selected.delete(v); else selected.add(v);
                    renderCheckList(search.value);
                    updateLabel();
                    applyFilter();
                });
            });
        }

        function updateLabel() {
            if (selected.size === 0) {
                label.textContent = 'Todos';
            } else if (selected.size === 1) {
                label.textContent = Array.from(selected)[0];
            } else {
                label.textContent = selected.size + ' seleccionados';
            }
        }

        function applyFilter() {
            tbl._rmcFilter = function (r) {
                var rmc = r.dataset.rmc || '';
                return selected.size === 0 || selected.has(rmc);
            };
            if (typeof tbl._pagerResetPage === 'function') tbl._pagerResetPage();
            var visibles = rows.filter(tbl._rmcFilter).length;
            if (count) count.textContent = selected.size === 0 ? '' : visibles + ' de ' + total + ' partidas';
        }

        function toggleDropdown(show) {
            dropdown.style.display = show ? 'block' : 'none';
            if (show) { renderCheckList(search.value); search.focus(); }
        }

        btn.addEventListener('click', function (e) {
            e.preventDefault();
            toggleDropdown(dropdown.style.display !== 'block');
        });

        document.addEventListener('click', function (e) {
            if (!dropdown.contains(e.target) && e.target !== btn && !btn.contains(e.target)) {
                toggleDropdown(false);
            }
        });

        search.addEventListener('input', function () { renderCheckList(search.value); });

        btnTodos.addEventListener('click', function (e) {
            e.preventDefault();
            valores.forEach(function (v) { selected.add(v); });
            renderCheckList(search.value);
            updateLabel();
            applyFilter();
        });

        btnLimpiar.addEventListener('click', function (e) {
            e.preventDefault();
            selected.clear();
            renderCheckList(search.value);
            updateLabel();
            applyFilter();
        });

        applyFilter();
    }

    /* =====================================================================
       LAZY LOAD — Tab 2: En Secado
       ===================================================================== */
    var loadedEnSecado = false;
    var tabEnSecadoBtn = document.getElementById('tab-en-secado-btn');
    var enSecadoBody   = document.getElementById('en-secado-tab-body');
    var badgeEnSecado  = document.getElementById('badge-en-secado-count');
    var kpiEnSecado    = document.getElementById('kpi-en-secado-count');
    var ctrlHolder     = { ctrl: null };

    function loadEnSecado() {
        if (loadedEnSecado) return;
        loadedEnSecado = true;
        if (ctrlHolder.ctrl) { ctrlHolder.ctrl.abort(); }
        var ctrl = new AbortController();
        ctrlHolder.ctrl = ctrl;

        var url = '@Url.Action("EnSecadoPartial", "Planeamiento")' +
            '?tipo=' + encodeURIComponent('@tipo') +
            '&asesor=' + encodeURIComponent('@asesor') +
            '&cliente=' + encodeURIComponent('@cliente');

        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' }, signal: ctrl.signal })
            .then(function (r) { return r.ok ? r.text() : Promise.reject('HTTP ' + r.status); })
            .then(function (html) {
                if (ctrlHolder.ctrl !== ctrl) return;
                ctrlHolder.ctrl = null;
                enSecadoBody.innerHTML = html;

                initPager('tblEnSecado', 'tblEnSecado-pgsize', 'tblEnSecado-pgnav', null, 'tblEnSecado-pginfo');
                initThSort('tblEnSecado');
                initRmcPagerFilter('tblEnSecado', {
                    btn: 'btnFiltroRmcEnSec', dropdown: 'dropdownRmcEnSec', search: 'filtroRmcSearchEnSec',
                    checkList: 'rmcCheckListEnSec', label: 'filtroRmcLabelEnSec', count: 'filtroRmcCountEnSec',
                    todos: 'filtroRmcTodosEnSec', limpiar: 'filtroRmcLimpiarEnSec'
                });

                var cnt = enSecadoBody.querySelectorAll('tbody tr').length;
                if (badgeEnSecado) badgeEnSecado.textContent = cnt;
                if (kpiEnSecado)   kpiEnSecado.textContent   = cnt;
            })
            .catch(function (err) {
                if (err && err.name === 'AbortError') return;
                ctrlHolder.ctrl = null;
                enSecadoBody.innerHTML = '<div class="alert alert-danger m-2"><i class="bi bi-exclamation-triangle me-1"></i>Error al cargar los datos. <button class="btn btn-sm btn-outline-danger ms-2" onclick="location.reload()">Reintentar</button></div>';
                if (badgeEnSecado) badgeEnSecado.textContent = '!';
                loadedEnSecado = false;
            });
    }

    if (tabEnSecadoBtn) tabEnSecadoBtn.addEventListener('show.bs.tab', loadEnSecado);
})();
</script>
<style>
    .rmc-item { cursor: pointer; user-select: none; }
    .rmc-item:hover { background: #f0f4ff; }
    .rmc-item-selected { background: #eaf1ff; }
</style>
}
