@using FabricaHilos.Services
@inject IMenuService MenuService
@{
    var menus    = MenuService.GetMenusActuales();
    var ctrl     = ViewContext.RouteData.Values["controller"]?.ToString();
    var act      = ViewContext.RouteData.Values["action"]?.ToString();

    // Indica si la vista actual es alguna del sub-módulo Alertas (Alertas + HistorialAlertas)
    bool esRegistroPedidos = ctrl == "Planeamiento" && act == "RegistroPedido";
    bool esAlertas         = ctrl == "Planeamiento" && (act == "Alertas" || act == "HistorialAlertas");
    bool esDashboard       = ctrl == "Planeamiento" && act == "Dashboard";
    bool esCargaMaquinas   = ctrl == "Planeamiento" && act == "CargaMaquinas";
    bool esPendDespacho    = ctrl == "Planeamiento" && act == "PendientesDespacho";
    bool esProximosVencer  = ctrl == "Planeamiento" && act == "ProximosVencer";
    bool esSeguimTinto     = ctrl == "Planeamiento" && act == "SeguimientoTintoreria";
    bool esPendRevisado    = ctrl == "Planeamiento" && act == "PendientesRevisado";
    bool esPendEvalCal     = ctrl == "Planeamiento" && act == "PendientesEvalCalidad";
    bool esPendEnconado    = ctrl == "Planeamiento" && act == "PendientesEnconado";
    bool esPendTenido      = ctrl == "Planeamiento" && act == "PendientesTenido";
    bool esPendSecado      = ctrl == "Planeamiento" && act == "PendientesSecado";
    bool esPendMadeja      = ctrl == "Planeamiento" && act == "PendientesMadeja";
    bool esIngresoPedApAprobFibra = ctrl == "Planeamiento" && act == "IngresoPedApAprobFibra";

    // Auto-refresh: segundos por vista (0 = sin auto-refresh)
    int autoRefreshSeg = act switch {
        "RegistroPedido"         => 0,
        "PendientesDespacho"     => 180,
        "PendientesRevisado"     => 180,
        "PendientesEvalCalidad"  => 180,
        "PendientesSecado"       => 180,
        "PendientesMadeja"       => 180,
        "PendientesEnconado"     => 180,
        "PendientesTenido"       => 180,
        "Dashboard"              => 300,
        "CargaMaquinas"          => 300,
        "Alertas"                => 300,
        "ProximosVencer"         => 300,
        "SeguimientoTintoreria"  => 0,
        _                        => 0
    };
}
<nav class="pln-navbar mb-3">
    <ul class="pln-navbar-list">
        @if (menus.PlaneamientoDashboard)
        {
            <li class="pln-navbar-item @(esDashboard ? "active" : "")">
                <a asp-controller="Planeamiento" asp-action="Dashboard" class="pln-navbar-link">
                    <i class="bi bi-kanban-fill"></i>
                    <span>Seguimiento</span>
                </a>
            </li>
        }
        @if (menus.PlaneamientoRegistroPedidos)
        {
            <li class="pln-navbar-item @(esRegistroPedidos ? "active" : "")">
                <a asp-controller="Planeamiento" asp-action="RegistroPedido" class="pln-navbar-link">
                    <i class="bi bi-journal-text"></i>
                    <span>Registro de Pedidos</span>
                </a>
            </li>
        }
        @if (menus.PlaneamientoSeguimientoTintoreria)
        {
            <li class="pln-navbar-item @(esSeguimTinto ? "active" : "")">
                <a asp-controller="Planeamiento" asp-action="SeguimientoTintoreria" class="pln-navbar-link">
                    <i class="bi bi-table"></i>
                    <span>Seguimiento Prog. Tintorería</span>
                </a>
            </li>
        }
        @if (menus.PlaneamientoProximosVencer)
        {
            <li class="pln-navbar-item @(esProximosVencer ? "active" : "")">
                <a asp-controller="Planeamiento" asp-action="ProximosVencer" class="pln-navbar-link">
                    <i class="bi bi-calendar-event-fill"></i>
                    <span>Próx. a Vencer</span>
                </a>
            </li>
        }
        @if (menus.PlaneamientoPendTenido)
        {
            <li class="pln-navbar-item @(esPendTenido ? "active" : "")">
                <a asp-controller="Planeamiento" asp-action="PendientesTenido" class="pln-navbar-link">
                    <i class="bi bi-droplet-half"></i>
                    <span>Pend. Teñido</span>
                </a>
            </li>
        }
        @if (menus.PlaneamientoPendSecado)
        {
            <li class="pln-navbar-item @(esPendSecado ? "active" : "")">
                <a asp-controller="Planeamiento" asp-action="PendientesSecado" class="pln-navbar-link">
                    <i class="bi bi-thermometer-half"></i>
                    <span>Pend. Secado</span>
                </a>
            </li>
        }
        @if (menus.PlaneamientoPendMadeja)
        {
            <li class="pln-navbar-item @(esPendMadeja ? "active" : "")">
                <a asp-controller="Planeamiento" asp-action="PendientesMadeja" class="pln-navbar-link">
                    <i class="bi bi-wind"></i>
                    <span>Pend. Acab. Madeja</span>
                </a>
            </li>
        }
        @if (menus.PlaneamientoPendEvalCalidad)
        {
            <li class="pln-navbar-item @(esPendEvalCal ? "active" : "")">
                <a asp-controller="Planeamiento" asp-action="PendientesEvalCalidad" class="pln-navbar-link">
                    <i class="bi bi-patch-check"></i>
                    <span>Eval. Calidad</span>
                </a>
            </li>
        }
        @if (menus.PlaneamientoPendEnconado)
        {
            <li class="pln-navbar-item @(esPendEnconado ? "active" : "")">
                <a asp-controller="Planeamiento" asp-action="PendientesEnconado" class="pln-navbar-link">
                    <i class="bi bi-arrow-repeat"></i>
                    <span>Pend. Enconado</span>
                </a>
            </li>
        }
        @if (menus.PlaneamientoPendRevisado)
        {
            <li class="pln-navbar-item @(esPendRevisado ? "active" : "")">
                <a asp-controller="Planeamiento" asp-action="PendientesRevisado" class="pln-navbar-link">
                    <i class="bi bi-clipboard2-check"></i>
                    <span>Revisado</span>
                </a>
            </li>
        }
        @if (menus.PlaneamientoPendientesDespacho)
        {
            <li class="pln-navbar-item @(esPendDespacho ? "active" : "")">
                <a asp-controller="Planeamiento" asp-action="PendientesDespacho" class="pln-navbar-link">
                    <i class="bi bi-truck"></i>
                    <span>Pend. Despacho</span>
                </a>
            </li>
        }
        @if (menus.PlaneamientoCargaMaquinas)
        {
            <li class="pln-navbar-item @(esCargaMaquinas ? "active" : "")">
                <a asp-controller="Planeamiento" asp-action="CargaMaquinas" class="pln-navbar-link">
                    <i class="bi bi-gear-wide-connected"></i>
                    <span>Carga Máquinas</span>
                </a>
            </li>
        }
        @if (menus.PlaneamientoAlertas)
        {
            <li class="pln-navbar-item @(esAlertas ? "active" : "")">
                <a asp-controller="Planeamiento" asp-action="Alertas" class="pln-navbar-link">
                    <i class="bi bi-bell-fill"></i>
                    <span>Alertas</span>
                </a>
            </li>
        }
        @if (menus.PlaneamientoIngresoPedApAprobFibra)
        {
            <li class="pln-navbar-item @(esIngresoPedApAprobFibra ? "active" : "")">
                <a asp-controller="Planeamiento" asp-action="IngresoPedApAprobFibra" class="pln-navbar-link">
                    <i class="bi bi-diagram-3-fill"></i>
                    <span>Ingreso Ped. Aprob. Fibra</span>
                </a>
            </li>
        }
    </ul>

    @if (autoRefreshSeg > 0)
    {
        <div id="pln-autorefresh" class="pln-autorefresh-badge" title="Actualización automática activa">
            <i class="bi bi-arrow-clockwise" id="pln-refresh-icon"></i>
            <span id="pln-refresh-countdown"></span>
        </div>
    }
</nav>

@if (autoRefreshSeg > 0)
{
    <script>
    (function () {
        var total    = @autoRefreshSeg;
        var restante = total;
        var pausado  = false;
        var el       = document.getElementById('pln-refresh-countdown');
        var icon     = document.getElementById('pln-refresh-icon');
        var badge    = document.getElementById('pln-autorefresh');

        function fmt(s) {
            var m = Math.floor(s / 60), ss = s % 60;
            return m + ':' + (ss < 10 ? '0' : '') + ss;
        }

        function estaInteractuando() {
            // Modal de Bootstrap abierto
            if (document.querySelector('.modal.show')) return true;
            // Input / select / textarea con foco
            var f = document.activeElement;
            if (f && (f.tagName === 'INPUT' || f.tagName === 'SELECT' || f.tagName === 'TEXTAREA')) return true;
            return false;
        }

        function actualizarBadge() {
            if (!el) return;
            if (pausado) {
                el.textContent = 'Pausado';
                if (badge) { badge.classList.remove('pln-autorefresh-soon'); badge.style.opacity = '.45'; }
            } else {
                el.textContent = fmt(restante);
                if (badge) { badge.style.opacity = ''; badge.classList.toggle('pln-autorefresh-soon', restante <= 30); }
            }
        }

        function setPausado(val) {
            pausado = val;
            actualizarBadge();
        }

        // Pausa cuando el tab queda en segundo plano
        document.addEventListener('visibilitychange', function () {
            if (document.hidden) {
                setPausado(true);
            } else {
                // Al volver: si ya expiró, recargar inmediatamente; si no, reanudar
                if (restante <= 0) { location.reload(); }
                else { setPausado(false); }
            }
        });

        function tick() {
            if (pausado || estaInteractuando()) {
                actualizarBadge();
                return;
            }
            restante--;
            if (restante <= 0) {
                if (icon) icon.classList.add('spin');
                el.textContent = 'Actualizando…';
                location.reload();
                return;
            }
            actualizarBadge();
        }

        actualizarBadge();
        setInterval(tick, 1000);
    })();
    </script>
}
