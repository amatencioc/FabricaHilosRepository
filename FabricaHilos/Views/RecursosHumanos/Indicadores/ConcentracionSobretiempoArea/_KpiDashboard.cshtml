@model FabricaHilos.Models.RecursosHumanos.ConcentracionSobretiempoAreaViewModel
@using System.Globalization

@{
    var culture   = CultureInfo.GetCultureInfo("es-PE");
    string NombreMes(int m) => culture.DateTimeFormat.GetMonthName(m);

    string periodo = Model.AnoIni == Model.AnoFin && Model.MesIni == Model.MesFin
        ? $"01 al {DateTime.DaysInMonth(Model.AnoFin, Model.MesFin):D2} de {NombreMes(Model.MesFin)} de {Model.AnoFin}"
        : $"{NombreMes(Model.MesIni)} {Model.AnoIni} — {NombreMes(Model.MesFin)} {Model.AnoFin}";

    // Períodos únicos ordenados
    var periodos = Model.Filas
        .Select(f => new { f.Ano, f.Mes })
        .Distinct()
        .OrderBy(p => p.Ano).ThenBy(p => p.Mes)
        .ToList();

    // Áreas únicas ordenadas por PCT_CON_HE desc (promedio entre períodos)
    var areas = Model.Filas
        .GroupBy(f => f.Area)
        .OrderByDescending(g => g.Average(x => x.PctConHe))
        .Select(g => g.Key)
        .ToList();

    // Totales globales
    int gTotalTrab = Model.Filas.GroupBy(f => new { f.Ano, f.Mes })
                        .Sum(g => g.Sum(x => x.TotalTrab));
    int gConHe     = Model.Filas.GroupBy(f => new { f.Ano, f.Mes })
                        .Sum(g => g.Sum(x => x.ConHe));
    int gSinHe     = gTotalTrab - gConHe;
    decimal gPctConHe = gTotalTrab > 0 ? Math.Round((decimal)gConHe / gTotalTrab * 100, 1) : 0m;

    Func<int, int, string, FabricaHilos.Models.RecursosHumanos.ConcentracionSobretiempoAreaDto?> GetFila =
        (ano, mes, area) => Model.Filas.FirstOrDefault(f => f.Ano == ano && f.Mes == mes && f.Area == area);

    // Semáforo
    string Semaforo(decimal pct) => pct switch { <= 30 => "success", <= 60 => "warning", _ => "danger" };
    string SemaforoIcon(decimal pct) => pct switch { <= 30 => "🟢", <= 60 => "🟡", _ => "🔴" };
    string SemaforoLabel(decimal pct) => pct switch { <= 30 => "HE puntual", <= 60 => "HE frecuente", _ => "HE sistémica" };

    // JSON para gráficos
    var chartRows = Model.Filas.Select(f => new {
        ano    = f.Ano,
        mes    = f.Mes,
        area   = f.Area,
        pctCon = Math.Round(f.PctConHe, 1),
        pctSin = Math.Round(f.PctSinHe, 1),
        conHe  = f.ConHe,
        sinHe  = f.SinHe,
        total  = f.TotalTrab
    });
    var rawJson = System.Text.Json.JsonSerializer.Serialize(chartRows);
}

<!-- Datos para Chart.js -->
<input type="hidden" id="chartRawData" value='@rawJson' />

<!-- ── Título y período ─────────────────────────────────── -->
<div class="text-center mb-4">
    <h5 class="fw-bold text-uppercase mb-1" style="color:#1B4D3E; letter-spacing:.06em; font-size:.95rem;">
        KPI Concentración de Sobretiempo por Área
    </h5>
    <p class="text-muted mb-0" style="font-size:.8rem;">Período: @periodo</p>
</div>

<!-- ── KPI Cards ─────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-icon">👥</div>
            <div class="kpi-label">Total Trabajadores</div>
            <div class="kpi-value">@gTotalTrab</div>
            <div class="kpi-sub">en planilla</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-icon">⏱️</div>
            <div class="kpi-label">Con Sobretiempo</div>
            <div class="kpi-value" style="color:#c0392b;">@gConHe</div>
            <div class="kpi-sub">cobraron HE</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-icon">✅</div>
            <div class="kpi-label">Sin Sobretiempo</div>
            <div class="kpi-value" style="color:#1B4D3E;">@gSinHe</div>
            <div class="kpi-sub">sin HE</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-icon">📊</div>
            <div class="kpi-label">% con Sobretiempo</div>
            <div class="kpi-value" style="color:@(gPctConHe > 60 ? "#c0392b" : gPctConHe > 30 ? "#e67e22" : "#1B4D3E");">
                @gPctConHe.ToString("N1")%
            </div>
            <div class="kpi-sub">@SemaforoLabel(gPctConHe)</div>
        </div>
    </div>
</div>

<!-- ── Tabla comparativa por período ─────────────────────── -->
@if (periodos.Count > 1)
{
    <div class="section-title"><i class="bi bi-calendar-range me-1"></i>Resumen Comparativo por Período</div>
    <div class="table-responsive mb-4">
        <table class="table table-sm table-hover table-corporate align-middle mb-0">
            <thead>
                <tr>
                    <th>Período</th>
                    <th class="text-center">Total Trab.</th>
                    <th class="text-center">Con HE</th>
                    <th class="text-center">Sin HE</th>
                    <th class="text-end">% Con HE</th>
                    <th class="text-center">Semáforo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in periodos)
                {
                    var filasPer = Model.Filas.Where(f => f.Ano == p.Ano && f.Mes == p.Mes).ToList();
                    int tot = filasPer.Sum(f => f.TotalTrab);
                    int con = filasPer.Sum(f => f.ConHe);
                    int sin = filasPer.Sum(f => f.SinHe);
                    decimal pct = tot > 0 ? Math.Round((decimal)con / tot * 100, 1) : 0m;
                    <tr>
                        <td class="fw-semibold">@NombreMes(p.Mes) @p.Ano</td>
                        <td class="text-center">@tot</td>
                        <td class="text-center text-danger fw-semibold">@con</td>
                        <td class="text-center text-success">@sin</td>
                        <td class="text-end">@pct.ToString("N1")%</td>
                        <td class="text-center"><span class="badge bg-@(Semaforo(pct))">@SemaforoIcon(pct) @SemaforoLabel(pct)</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- ── Tabla de áreas ─────────────────────────────────────── -->
<div class="section-title"><i class="bi bi-table me-1"></i>Detalle por Área</div>
<div class="table-responsive mb-4">
    <table class="table table-sm table-hover table-corporate align-middle mb-0">
        <thead>
            <tr>
                <th rowspan="2" class="align-middle">Área</th>
                @foreach (var p in periodos)
                {
                    <th colspan="4" class="text-center border-start">@NombreMes(p.Mes) @p.Ano</th>
                }
            </tr>
            <tr>
                @foreach (var p in periodos)
                {
                    <th class="text-center border-start" style="font-size:.75rem; white-space:nowrap;">Total</th>
                    <th class="text-center"              style="font-size:.75rem; white-space:nowrap;">Con HE</th>
                    <th class="text-center"              style="font-size:.75rem; white-space:nowrap;">Sin HE</th>
                    <th class="text-end"                 style="font-size:.75rem; white-space:nowrap;">% Con HE</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var areaName in areas)
            {
                <tr>
                    <td class="fw-semibold">@areaName</td>
                    @foreach (var p in periodos)
                    {
                        var cell = GetFila(p.Ano, p.Mes, areaName);
                        string semColor = cell is not null ? Semaforo(cell.PctConHe) : "";
                        <td class="text-center border-start">@(cell?.TotalTrab.ToString() ?? "—")</td>
                        <td class="text-center text-danger">@(cell?.ConHe.ToString() ?? "—")</td>
                        <td class="text-center text-success">@(cell?.SinHe.ToString() ?? "—")</td>
                        <td class="text-end">
                            @if (cell is not null)
                            {
                                <span class="badge bg-@semColor" style="font-size:.75rem;">
                                    @SemaforoIcon(cell.PctConHe) @cell.PctConHe.ToString("N1")%
                                </span>
                            }
                            else { <span>—</span> }
                        </td>
                    }
                </tr>
            }
        </tbody>
        <tfoot>
            <tr style="background:#e8f0e9; font-weight:700; border-top:2px solid #1B4D3E;">
                <td>Total</td>
                @foreach (var p in periodos)
                {
                    var fp  = Model.Filas.Where(f => f.Ano == p.Ano && f.Mes == p.Mes).ToList();
                    int tot = fp.Sum(f => f.TotalTrab);
                    int con = fp.Sum(f => f.ConHe);
                    int sin = fp.Sum(f => f.SinHe);
                    decimal pct = tot > 0 ? Math.Round((decimal)con / tot * 100, 1) : 0m;
                    <td class="text-center border-start">@tot</td>
                    <td class="text-center text-danger">@con</td>
                    <td class="text-center text-success">@sin</td>
                    <td class="text-end"><span class="badge bg-@(Semaforo(pct))">@pct.ToString("N1")%</span></td>
                }
            </tr>
        </tfoot>
    </table>
</div>

<!-- ── Gráficos ───────────────────────────────────────────── -->
<div class="section-title"><i class="bi bi-bar-chart-line me-1"></i>Análisis Gráfico Comparativo</div>
<div class="row g-3 mb-2">
    <div class="col-lg-6">
        <div class="card chart-card">
            <div class="card-header small">% Trabajadores con Sobretiempo por Área</div>
            <div class="card-body" style="height:360px;">
                <canvas id="chartBarPct"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card chart-card">
            <div class="card-header small">Distribución Con HE vs Sin HE por Área (Acumulado)</div>
            <div class="card-body" style="height:360px;">
                <canvas id="chartStackedBar"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- ── Análisis Automático ────────────────────────────────── -->
@{
    var areasAcum = Model.Filas
        .GroupBy(f => f.Area)
        .Select(g => new {
            Area      = g.Key,
            TotalTrab = g.Sum(x => x.TotalTrab),
            ConHe2    = g.Sum(x => x.ConHe),
            SinHe2    = g.Sum(x => x.SinHe),
            PctConHe  = g.Sum(x => x.TotalTrab) > 0
                        ? Math.Round((decimal)g.Sum(x => x.ConHe) / g.Sum(x => x.TotalTrab) * 100, 1)
                        : 0m
        })
        .OrderByDescending(x => x.PctConHe)
        .ToList();

    int criticas  = areasAcum.Count(a => a.PctConHe > 60);
    int frecuente = areasAcum.Count(a => a.PctConHe > 30 && a.PctConHe <= 60);
    int puntual   = areasAcum.Count(a => a.PctConHe <= 30);
}

<div class="section-title mt-3"><i class="bi bi-cpu me-1"></i>Análisis Automático del Período</div>
<div class="row g-3 mb-4">

    <!-- Resumen semáforo -->
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-header fw-semibold small" style="background:#f0f4f0; color:#1B4D3E;">
                <i class="bi bi-traffic-light me-1"></i> Resumen Semáforo
            </div>
            <div class="card-body">
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex align-items-center justify-content-between p-2 rounded" style="background:#d4edda;">
                        <span class="small fw-semibold">🟢 HE puntual (0–30%)</span>
                        <span class="badge bg-success fs-6">@puntual área@(puntual != 1 ? "s" : "")</span>
                    </div>
                    <div class="d-flex align-items-center justify-content-between p-2 rounded" style="background:#fff3cd;">
                        <span class="small fw-semibold">🟡 HE frecuente (31–60%)</span>
                        <span class="badge bg-warning text-dark fs-6">@frecuente área@(frecuente != 1 ? "s" : "")</span>
                    </div>
                    <div class="d-flex align-items-center justify-content-between p-2 rounded" style="background:#f8d7da;">
                        <span class="small fw-semibold">🔴 HE sistémica (&gt;60%)</span>
                        <span class="badge bg-danger fs-6">@criticas área@(criticas != 1 ? "s" : "")</span>
                    </div>
                </div>
                @if (criticas > 0)
                {
                    <div class="alert alert-danger py-1 px-2 mt-3 small mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        <strong>@criticas área@(criticas != 1 ? "s" : "") con HE sistémica</strong> — posible déficit de personal.
                    </div>
                }
                else if (frecuente > 0)
                {
                    <div class="alert alert-warning py-1 px-2 mt-3 small mb-0">
                        <i class="bi bi-exclamation-circle-fill me-1"></i>
                        <strong>@frecuente área@(frecuente != 1 ? "s" : "") con HE frecuente</strong> — revisar distribución de carga.
                    </div>
                }
                else
                {
                    <div class="alert alert-success py-1 px-2 mt-3 small mb-0">
                        <i class="bi bi-check-circle-fill me-1"></i>
                        Todas las áreas con HE puntual y controlada.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Diagnóstico por área -->
    <div class="col-md-8">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-header fw-semibold small" style="background:#f0f4f0; color:#1B4D3E;">
                <i class="bi bi-grid-3x3-gap me-1"></i> Diagnóstico por Área (% Con HE acumulado)
            </div>
            <div class="card-body p-2">
                <div style="max-height:320px; overflow-y:auto;">
                    <table class="table table-sm table-hover mb-0" style="font-size:.78rem;">
                        <thead class="table-dark sticky-top">
                            <tr>
                                <th>#</th>
                                <th>Área</th>
                                <th class="text-center">Total</th>
                                <th class="text-center">Con HE</th>
                                <th class="text-center">Sin HE</th>
                                <th class="text-end">% Con HE</th>
                                <th>Estado</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int rank = 0; }
                            @foreach (var a in areasAcum)
                            {
                                rank++;
                                string semColor = Semaforo(a.PctConHe);
                                string accion = a.PctConHe switch {
                                    > 60 => "Evaluar déficit de personal",
                                    > 30 => "Revisar distribución de carga",
                                    _    => "Mantener seguimiento"
                                };
                                <tr>
                                    <td>@rank</td>
                                    <td class="fw-semibold">@a.Area</td>
                                    <td class="text-center">@a.TotalTrab</td>
                                    <td class="text-center text-danger fw-semibold">@a.ConHe2</td>
                                    <td class="text-center text-success">@a.SinHe2</td>
                                    <td class="text-end @(a.PctConHe > 60 ? "text-danger fw-bold" : a.PctConHe > 30 ? "text-warning fw-semibold" : "")">
                                        @a.PctConHe.ToString("N1")%
                                    </td>
                                    <td><span class="badge bg-@semColor">@SemaforoIcon(a.PctConHe) @SemaforoLabel(a.PctConHe)</span></td>
                                    <td class="text-muted" style="font-size:.72rem;">@accion</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
