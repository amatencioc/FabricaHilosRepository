@using FabricaHilos.Models.Produccion.Planeamiento

@{
    ViewData["Title"] = "Carga de Máquinas";

    var ttMaquinas   = (ViewBag.EstadoTintoreria  as List<PlnEstadoMaquinaTT>)    ?? new List<PlnEstadoMaquinaTT>();
    var secMaquinas  = (ViewBag.EstadoSecado       as List<PlnEstadoMaquinaTT>)    ?? new List<PlnEstadoMaquinaTT>();
    var otraMaquinas = (ViewBag.EstadoOtras        as List<PlnEstadoMaquinaTT>)    ?? new List<PlnEstadoMaquinaTT>();
    var hilMaquinas  = (ViewBag.EstadoHilanderia   as List<PlnResumenHilanderia>)  ?? new List<PlnResumenHilanderia>();
    var compromisos  = (ViewBag.Compromisos        as List<PlnMaquinaCompromiso>)  ?? new List<PlnMaquinaCompromiso>();

    int ttActivas    = ttMaquinas.Count(m => m.EsActiva);
    int ttLibres     = ttMaquinas.Count(m => !m.EsActiva);
    int ttRetrasadas = ttMaquinas.Count(m => m.EsActiva && m.EstaRetrasado);
    int secActivas   = secMaquinas.Count(m => m.EsActiva);
    int hilActivas   = hilMaquinas.Count(m => m.EsActiva);
    int plnRetrasos  = compromisos.Count(c => c.EstaRetrasado);
}

@section Styles {
<link rel="stylesheet" href="~/css/planeamiento.css" asp-append-version="true" />
<style>
    .cm-kpi            { border-radius:.6rem; border:none; box-shadow:var(--pln-shadow-sm); background:#fff; }
    .cm-kpi-val        { font-size:1.8rem; font-weight:800; line-height:1; }
    .cm-kpi-lbl        { font-size:.72rem; color:var(--pln-gray-500); margin-top:.2rem; }
    /* pln-tabs y pln-tab-panel vienen de planeamiento.css */
    .tt-maq-card       { border-radius:6px; border:1px solid #e2e8f0; box-shadow:var(--pln-shadow-sm); background:#fff;
                         transition:box-shadow .15s,transform .15s; overflow:hidden; }
    .tt-maq-card:hover { box-shadow:var(--pln-shadow-md); transform:translateY(-1px); }
    .tt-maq-card .tt-head  { display:flex; align-items:flex-start; gap:.5rem; padding:.5rem .75rem .4rem; flex-wrap:wrap; }
    .tt-maq-card .tt-cod   { font-size:.95rem; font-weight:800; color:var(--pln-navy); flex-shrink:0; }
    .tt-maq-card .tt-nom   { font-size:.7rem; color:var(--pln-gray-600); font-weight:500; flex:1; min-width:0; line-height:1.25; word-break:break-word; }
    .tt-maq-card .tt-body  { padding:.4rem .75rem .6rem; font-size:.78rem; }
    .tt-maq-card .tt-row   { display:flex; gap:.35rem; align-items:baseline; margin-bottom:.18rem; }
    .tt-maq-card .tt-lbl   { color:var(--pln-gray-500); min-width:4rem; font-size:.68rem; text-transform:uppercase; letter-spacing:.03em; }
    .tt-maq-card .tt-libre-msg { padding:.5rem .75rem .6rem; color:var(--pln-gray-500); font-size:.78rem; font-style:italic; }
    .tt-maq-card.tt-libre  { opacity:.7; }
    .tt-maq-card.tt-retrasada { background:#fff8f8; }
    .cm-filter-bar     { display:flex; align-items:center; gap:.6rem; flex-wrap:wrap; }
    .cm-filter-bar .btn-group .btn { font-size:.78rem; }
    .cm-filter-bar input { max-width:220px; }
    .tt-hidden         { display:none !important; }
    .tbl-hil           { font-size:.8rem; }
    .tbl-hil thead th  { font-size:.68rem; text-transform:uppercase; letter-spacing:.04em;
                         color:var(--pln-gray-500); font-weight:700;
                         background:var(--pln-gray-50); border-bottom:2px solid var(--pln-border); }
    .tbl-hil tbody td  { vertical-align:middle; border-color:var(--pln-border); }
    .tbl-hil .maq-name { font-weight:700; color:var(--pln-navy); font-size:.82rem; }
    .tbl-hil .proceso-tag { font-size:.65rem; color:var(--pln-gray-600); background:var(--pln-gray-100); padding:.1rem .4rem; border-radius:8px; }
    .maq-comp-card     { border-radius:6px; border:1px solid #e2e8f0; box-shadow:var(--pln-shadow-sm);
                         background:#fff; transition:box-shadow .15s; overflow:hidden; }
    .maq-comp-card:hover { box-shadow:var(--pln-shadow-md); }
    .maq-comp-card .maq-head { display:flex; align-items:center; gap:.5rem; padding:.5rem .75rem .4rem; border-bottom:1px solid #e9ecef; }
    .maq-comp-card .maq-cod  { font-size:.9rem; font-weight:800; color:var(--pln-navy); }
    .maq-comp-card .maq-nom  { font-size:.72rem; color:var(--pln-gray-500); }
    .maq-comp-card .maq-area-tag { margin-left:auto; font-size:.6rem; font-weight:700; padding:.15rem .55rem; border-radius:10px; letter-spacing:.04em; }
    .maq-badges        { padding:.3rem .75rem; display:flex; gap:.35rem; flex-wrap:wrap; border-bottom:1px solid #f1f5f9; }
    .tbl-compromisos   { font-size:.77rem; margin-bottom:0; }
    .tbl-compromisos thead th { font-size:.67rem; text-transform:uppercase; letter-spacing:.04em;
                                color:var(--pln-gray-500); font-weight:700; padding:.25rem .5rem; background:var(--pln-gray-50); }
    .tbl-compromisos tbody td { padding:.28rem .5rem; vertical-align:middle; }
    .cm-ver-mas        { font-size:.75rem; color:var(--pln-blue-link); cursor:pointer; text-decoration:none; }
    .cm-ver-mas:hover  { text-decoration:underline; }
    .cm-maq-col.cm-hidden { display:none !important; }
    .grupo-legend      { display:inline-flex; align-items:center; gap:.3rem; font-size:.73rem; }
    .grupo-dot         { width:8px; height:8px; border-radius:50%; display:inline-block; }
</style>
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Produccion" asp-action="Index">Producción</a></li>
    <li class="breadcrumb-item active">Carga de Máquinas</li>
}

@await Html.PartialAsync("_PlnNavBar")

<div class="container-fluid py-3">

<div class="pln-page-hdr mb-3">
    <i class="bi bi-gear-wide-connected pln-page-hdr-icon"></i>
    <div class="pln-page-hdr-body">
        <div class="pln-page-hdr-title">Carga de Máquinas</div>
        <div class="pln-page-hdr-sub">Estado en tiempo real · Tintorería, Secado, Hilandería y Compromisos PLN</div>
    </div>
    <div class="pln-page-hdr-actions">
        <a asp-action="CargaMaquinas" class="btn btn-outline-light btn-sm">
            <i class="bi bi-arrow-clockwise me-1"></i>Actualizar
        </a>
        <a asp-action="Dashboard" class="btn btn-outline-light btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Seguimiento
        </a>
    </div>
</div>

<div class="row g-2 mb-3">
    <div class="col-6 col-md-3 col-xl-2">
        <div class="card cm-kpi p-3 text-center">
            <div class="cm-kpi-val text-success">@ttActivas</div>
            <div class="cm-kpi-lbl"><i class="bi bi-play-circle-fill text-success me-1"></i>TT activas</div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
        <div class="card cm-kpi p-3 text-center">
            <div class="cm-kpi-val text-secondary">@ttLibres</div>
            <div class="cm-kpi-lbl"><i class="bi bi-circle me-1"></i>TT libres</div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
        <div class="card cm-kpi p-3 text-center">
            <div class="cm-kpi-val @(ttRetrasadas > 0 ? "text-danger" : "text-secondary")">@ttRetrasadas</div>
            <div class="cm-kpi-lbl">
                <i class="bi bi-exclamation-triangle@(ttRetrasadas > 0 ? "-fill text-danger" : " text-secondary") me-1"></i>
                TT retrasadas
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
        <div class="card cm-kpi p-3 text-center">
            <div class="cm-kpi-val @(secActivas > 0 ? "text-info" : "text-secondary")">@secActivas</div>
            <div class="cm-kpi-lbl"><i class="bi bi-wind @(secActivas > 0 ? "text-info" : "text-secondary") me-1"></i>Secadoras activas</div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
        <div class="card cm-kpi p-3 text-center">
            <div class="cm-kpi-val text-primary">@hilActivas</div>
            <div class="cm-kpi-lbl"><i class="bi bi-cpu-fill text-primary me-1"></i>Hil. activas hoy</div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
        <div class="card cm-kpi p-3 text-center">
            <div class="cm-kpi-val @(plnRetrasos > 0 ? "text-danger" : "text-secondary")">@plnRetrasos</div>
            <div class="cm-kpi-lbl">
                <i class="bi bi-clock-history @(plnRetrasos > 0 ? "text-danger" : "text-secondary") me-1"></i>
                Compromisos retrasados
            </div>
        </div>
    </div>
</div>

<ul class="nav nav-tabs pln-tabs" id="cmTabs" role="tablist">
    <li class="nav-item">
        <button class="nav-link active" id="tab-tt-btn" data-bs-toggle="tab" data-bs-target="#tab-tt"
                type="button" role="tab" aria-controls="tab-tt" aria-selected="true">
            <i class="bi bi-droplet-fill me-1" style="color:#6f42c1;"></i>Tintorería
            <span class="badge bg-secondary ms-1" style="font-size:.63rem;">@ttMaquinas.Count máq.</span>
            @if (ttActivas > 0)
            {
                <span class="badge bg-success ms-1" style="font-size:.63rem;">@ttActivas activas</span>
            }
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" id="tab-sec-btn" data-bs-toggle="tab" data-bs-target="#tab-sec"
                type="button" role="tab" aria-controls="tab-sec" aria-selected="false">
            <i class="bi bi-wind me-1" style="color:#20c997;"></i>Secado
            <span class="badge bg-secondary ms-1" style="font-size:.63rem;">@secMaquinas.Count máq.</span>
            @if (secActivas > 0)
            {
                <span class="badge bg-success ms-1" style="font-size:.63rem;">@secActivas activas</span>
            }
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" id="tab-otras-btn" data-bs-toggle="tab" data-bs-target="#tab-otras"
                type="button" role="tab" aria-controls="tab-otras" aria-selected="false">
            <i class="bi bi-tools me-1" style="color:#fd7e14;"></i>Otras
            <span class="badge bg-secondary ms-1" style="font-size:.63rem;">@otraMaquinas.Count máq.</span>
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" id="tab-hil-btn" data-bs-toggle="tab" data-bs-target="#tab-hil"
                type="button" role="tab" aria-controls="tab-hil" aria-selected="false">
            <i class="bi bi-gear-wide me-1" style="color:#0d6efd;"></i>Hilandería
            <span class="badge bg-secondary ms-1" style="font-size:.63rem;">@hilMaquinas.Count máq.</span>
            @if (hilActivas > 0)
            {
                <span class="badge bg-success ms-1" style="font-size:.63rem;">@hilActivas activas</span>
            }
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" id="tab-pln-btn" data-bs-toggle="tab" data-bs-target="#tab-pln"
                type="button" role="tab" aria-controls="tab-pln" aria-selected="false">
            <i class="bi bi-clipboard-check me-1" style="color:#198754;"></i>Compromisos PLN
            <span class="badge bg-secondary ms-1" style="font-size:.63rem;">
                @(compromisos.Select(x => x.CodMaq).Distinct().Count()) máq.
            </span>
        </button>
    </li>
</ul>

<div class="tab-content">

@*═══════════════════════════════════════════════════════════════════ TAB: TINTORERÍA *@
<div class="tab-pane fade show active pln-tab-panel" id="tab-tt" role="tabpanel" aria-labelledby="tab-tt-btn">

    <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
        <div class="grupo-legend"><span class="grupo-dot bg-primary"></span><strong>Thies</strong> (R01–R19)</div>
        <div class="grupo-legend"><span class="grupo-dot bg-success"></span><strong>HANK</strong> (M01–M08)</div>
        <div class="grupo-legend"><span class="grupo-dot bg-warning"></span><strong>Mad.Rodete</strong> (MR1–MR2)</div>
        <div class="ms-auto d-flex align-items-center gap-2 flex-wrap">
            <div class="grupo-legend"><span class="grupo-dot" style="background:#198754;"></span>ACTIVA</div>
            <div class="grupo-legend"><span class="grupo-dot bg-secondary"></span>LIBRE</div>
            <div class="grupo-legend"><span class="grupo-dot" style="background:#e53e3e;"></span>RETRASADA</div>
        </div>
    </div>

    <div class="cm-filter-bar mb-3">
        <div class="btn-group btn-group-sm" role="group">
            <input type="radio" class="btn-check" name="ttGrp" id="ttAll"   value="all"        autocomplete="off" checked>
            <label class="btn btn-outline-secondary" for="ttAll">Todas</label>
            <input type="radio" class="btn-check" name="ttGrp" id="ttThies" value="Thies"      autocomplete="off">
            <label class="btn btn-outline-primary"   for="ttThies">Thies (R)</label>
            <input type="radio" class="btn-check" name="ttGrp" id="ttHank"  value="HANK"       autocomplete="off">
            <label class="btn btn-outline-success"   for="ttHank">HANK (M)</label>
            <input type="radio" class="btn-check" name="ttGrp" id="ttMR"    value="Mad.Rodete" autocomplete="off">
            <label class="btn btn-outline-warning"   for="ttMR">Mad.Rod.</label>
        </div>
        <div class="btn-group btn-group-sm" role="group">
            <input type="radio" class="btn-check" name="ttEst" id="ttEstAll"    value="all"    autocomplete="off" checked>
            <label class="btn btn-outline-secondary" for="ttEstAll">Todas</label>
            <input type="radio" class="btn-check" name="ttEst" id="ttEstActiva" value="ACTIVA" autocomplete="off">
            <label class="btn btn-outline-success"   for="ttEstActiva">Activas</label>
            <input type="radio" class="btn-check" name="ttEst" id="ttEstLibre"  value="LIBRE"  autocomplete="off">
            <label class="btn btn-outline-secondary" for="ttEstLibre">Libres</label>
        </div>
        <div class="input-group input-group-sm" style="max-width:200px;">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
            <input id="ttSearch" type="text" class="form-control border-start-0 ps-0" placeholder="Buscar máquina…" autocomplete="off" />
        </div>
        <small class="text-muted ms-auto"><span id="ttVisibleCount">@ttMaquinas.Count</span> / @ttMaquinas.Count máquinas</small>
    </div>

    @if (ttMaquinas.Any())
    {
        string[] grupoOrden = { "Thies", "HANK", "Mad.Rodete", "Otro" };
        var ttPorGrupo = ttMaquinas
            .GroupBy(m => m.Grupo)
            .OrderBy(g => { var idx = Array.IndexOf(grupoOrden, g.Key); return idx < 0 ? 99 : idx; })
            .ToList();

        foreach (var grp in ttPorGrupo)
        {
            var grpColor = grp.Key switch
            {
                "Thies"      => "#0d6efd",
                "HANK"       => "#198754",
                "Mad.Rodete" => "#fd7e14",
                _            => "#6c757d"
            };
            int grpActivas = grp.Count(m => m.EsActiva);
            int grpLibres  = grp.Count(m => !m.EsActiva);
            <div class="mb-4">
                <div class="d-flex align-items-center gap-2 mb-2" style="border-left:3px solid @grpColor; padding-left:.6rem;">
                    <span class="fw-bold" style="color:@grpColor; font-size:.9rem;">@grp.Key</span>
                    <span class="badge bg-light text-dark border ms-1" style="font-size:.65rem;">@grp.Count() máq.</span>
                    @if (grpActivas > 0)
                    { <span class="badge bg-success" style="font-size:.62rem;">@grpActivas activas</span> }
                    <span class="badge bg-secondary" style="font-size:.62rem;">@grpLibres libres</span>
                </div>
                <div class="row g-2">
                    @foreach (var maq in grp.OrderBy(m => m.CodMaq))
                    {
                        <div class="col-12 col-sm-6 col-lg-4 col-xl-3 tt-col"
                             data-grupo="@maq.Grupo" data-estado="@maq.EstadoMaq"
                             data-maq="@maq.CodMaq.ToUpper()">
                            <div class="tt-maq-card @(maq.EsActiva ? (maq.EstaRetrasado ? "tt-retrasada" : "") : "tt-libre") h-100"
                                 style="border-left:3px solid @maq.ColorBorde;">
                                <div class="tt-head">
                                    <i class="bi bi-circle-fill" style="color:@maq.ColorBorde; font-size:.55rem; flex-shrink:0;"></i>
                                    <div style="flex:1; min-width:0;">
                                        <div class="tt-cod">@maq.CodMaq</div>
                                        <div class="tt-nom">@maq.NombreMaqDisplay</div>
                                    </div>
                                    <span class="badge @maq.BadgeClase" style="font-size:.62rem; flex-shrink:0;">
                                        @(maq.EsActiva ? (maq.EstaRetrasado ? "RETRASADA" : "ACTIVA") : "LIBRE")
                                    </span>
                                </div>
                                @if (maq.EsActiva)
                                {
                                    <div class="tt-body">
                                        <div class="tt-row">
                                            <span class="tt-lbl">Proceso</span>
                                            <span class="badge" style="background:@(maq.TipDoc=="IR" ? "#6f42c120" : "#0d6efd20"); color:@(maq.TipDoc=="IR" ? "#6f42c1" : "#0d6efd"); border:1px solid @(maq.TipDoc=="IR" ? "#6f42c1" : "#0d6efd"); font-size:.62rem; font-weight:700;">
                                                @maq.NombreProceso
                                            </span>
                                            <span class="badge bg-light text-dark border ms-1" style="font-size:.58rem;">@maq.TipDoc</span>
                                        </div>
                                        @if (maq.TienePedido)
                                        {
                                            <div class="tt-row">
                                                <span class="tt-lbl">Pedido</span>
                                                <a asp-action="Pedido" asp-route-numPed="@maq.NumPed" asp-route-serie="@maq.Serie"
                                                   class="fw-semibold text-decoration-none" style="color:var(--pln-blue-link);">
                                                    @maq.NumPed/@maq.Nro
                                                </a>
                                                @if (maq.EsUrgente)
                                                { <i class="bi bi-lightning-charge-fill text-warning ms-1" title="Urgente"></i> }
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(maq.NombrePaso))
                                        {
                                            <div class="tt-row">
                                                <span class="tt-lbl">Paso PLN</span>
                                                <span class="badge" style="background:@maq.ColorUi; font-size:.6rem;">@maq.NombrePaso</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(maq.NombreCliente))
                                        {
                                            <div class="tt-row">
                                                <span class="tt-lbl">Cliente</span>
                                                <span style="font-size:.75rem; flex:1; min-width:0; word-break:break-word;" title="@maq.NombreCliente">@maq.NombreCliente</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(maq.Titulo))
                                        {
                                            <div class="tt-row">
                                                <span class="tt-lbl">Título</span>
                                                <span class="fw-semibold">@maq.Titulo</span>
                                                @if (!string.IsNullOrEmpty(maq.CodArt))
                                                { <span class="text-muted ms-1" style="font-size:.65rem;" title="@maq.CodArt">@(maq.CodArt.Length > 14 ? maq.CodArt[..14]+"…" : maq.CodArt)</span> }
                                            </div>
                                        }
                                        @if (maq.FchEntregaComp.HasValue)
                                        {
                                            <div class="tt-row">
                                                <span class="tt-lbl">Entrega</span>
                                                <span class="@(maq.EstaRetrasado ? "text-danger fw-bold" : "")">
                                                    @maq.FchEntregaComp.Value.ToString("dd/MM/yy")
                                                </span>
                                                @if (maq.DiasRetraso > 0)
                                                { <span class="badge bg-danger ms-1" style="font-size:.58rem;">+@maq.DiasRetraso d</span> }
                                            </div>
                                        }
                                        @if (maq.Kg > 0)
                                        {
                                            <div class="tt-row mt-1">
                                                <span class="tt-lbl">Kg proc.</span>
                                                <span class="fw-semibold">@maq.Kg.ToString("N1") kg</span>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="tt-libre-msg"><i class="bi bi-check-circle me-1"></i>Disponible</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-light border text-muted small py-2">
            <i class="bi bi-info-circle me-1"></i>No se encontraron máquinas de tintorería en el catálogo (TT_RPRODUC).
        </div>
    }
</div>@*/ tab-tt *@

@*═══════════════════════════════════════════════════════════════════ TAB: SECADO *@
<div class="tab-pane fade pln-tab-panel" id="tab-sec" role="tabpanel" aria-labelledby="tab-sec-btn">

    <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
        <div class="grupo-legend"><span class="grupo-dot" style="background:#20c997;"></span><strong>Secadoras</strong> (S01–S04)</div>
        <div class="ms-auto d-flex align-items-center gap-2 flex-wrap">
            <div class="grupo-legend"><span class="grupo-dot" style="background:#198754;"></span>ACTIVA</div>
            <div class="grupo-legend"><span class="grupo-dot bg-secondary"></span>LIBRE</div>
            <div class="grupo-legend"><span class="grupo-dot" style="background:#e53e3e;"></span>RETRASADA</div>
        </div>
    </div>

    @if (secMaquinas.Any())
    {
        <div class="row g-2">
            @foreach (var maq in secMaquinas.OrderBy(m => m.CodMaq))
            {
                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                    <div class="tt-maq-card @(maq.EsActiva ? (maq.EstaRetrasado ? "tt-retrasada" : "") : "tt-libre") h-100"
                         style="border-left:3px solid @maq.ColorBorde;">
                        <div class="tt-head">
                            <i class="bi bi-wind" style="color:@maq.ColorBorde; font-size:.75rem;"></i>
                            <span class="tt-cod">@maq.CodMaq</span>
                            <span class="tt-nom">@maq.NombreMaqDisplay</span>
                            <span class="ms-auto badge @maq.BadgeClase" style="font-size:.62rem;">
                                @(maq.EsActiva ? (maq.EstaRetrasado ? "RETRASADA" : "ACTIVA") : "LIBRE")
                            </span>
                        </div>
                        @if (maq.EsActiva)
                        {
                            <div class="tt-body">
                                <div class="tt-row">
                                    <span class="tt-lbl">Proceso</span>
                                    <span class="badge" style="background:#20c99720; color:#20c997; border:1px solid #20c997; font-size:.62rem; font-weight:700;">
                                        @maq.NombreProceso
                                    </span>
                                </div>
                                @if (maq.TienePedido)
                                {
                                    <div class="tt-row">
                                        <span class="tt-lbl">Pedido</span>
