@model FabricaHilos.Models.Contabilidad.MemorandoDto
@{
    Layout = null;
    var meses = new[] { "enero","febrero","marzo","abril","mayo","junio",
                        "julio","agosto","septiembre","octubre","noviembre","diciembre" };
    var fechaLarga = $"{Model.Fecha.Day} de {meses[Model.Fecha.Month - 1]} de {Model.Fecha.Year}";

    var empresaNombre    = Model.EmpresaNombre    ?? "FÁBRICA DE HILOS S.A.";
    var empresaRuc       = Model.EmpresaRuc       ?? "";
    var empresaDireccion = Model.EmpresaDireccion ?? "";
    var empresaTelefono  = Model.EmpresaTelefono  ?? "";
    var logoPath         = Model.EmpresaLogoPath  ?? "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Memorando @Model.NumeroMemo — @empresaNombre</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            font-size: 9pt;
            color: #1a1a2e;
            background: #f0f4f8;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
        /* ── Contenedor A4 ────────────────────────────────────── */
        .page {
            width: 210mm;
            min-height: 297mm;
            margin: 10mm auto;
            background: #fff;
            box-shadow: 0 4px 28px rgba(0,0,0,.18);
            border-radius: 3px;
            overflow: hidden;
        }
        /* ── Franja superior ──────────────────────────────────── */
        .top-stripe {
            height: 7px;
            background: linear-gradient(90deg, #0d2d5a 0%, #1a4a8a 55%, #4a90d9 100%);
        }
        /* ── Header ───────────────────────────────────────────── */
        .doc-header {
            display: flex;
            align-items: stretch;
            border-bottom: 2px solid #1a3a5c;
        }
        .header-left {
            flex: 1;
            padding: 8mm 8mm 6mm 10mm;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .header-logo img { max-height: 110px; max-width: 240px; object-fit: contain; }
        .header-logo-placeholder {
            width: 200px; height: 90px;
            display: flex; align-items: center; justify-content: center;
            background: #e8eef5; border: 1px solid #a8bbcc; border-radius: 3px;
            font-size: 8pt; color: #1a3a5c; font-weight: 600;
        }
        .header-company { margin-left: 10px; }
        .header-company h1 { font-size: 13pt; font-weight: 700; color: #1a3a5c; letter-spacing: -.3px; line-height: 1.1; }
        .header-company p  { font-size: 8pt; color: #555; margin-top: 2px; line-height: 1.5; }
        .header-right {
            width: 62mm;
            background: #1a3a5c;
            color: #fff;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            padding: 8mm 6mm; gap: 4px;
        }
        .header-right .doc-type  { font-size: 8pt; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; opacity: .85; text-align: center; }
        .header-right .doc-num   { font-size: 13pt; font-weight: 800; letter-spacing: .3px; line-height: 1.2; text-align: center; word-break: break-all; }
        /* ── Datos DE / A / REF ───────────────────────────────── */
        .memo-campos { padding: 5mm 10mm 4mm; border-bottom: 1px solid #d0dce8; }
        .memo-fecha-line { font-size: 9.5pt; color: #333; margin-bottom: 6px; }
        .campo-table { width: 100%; border-collapse: collapse; }
        .campo-table td { padding: 2px 4px; vertical-align: top; font-size: 9.5pt; }
        .campo-table .lbl { font-weight: 700; color: #1a3a5c; white-space: nowrap; width: 36px; }
        .campo-table .sep { width: 12px; color: #555; }
        .campo-table .val { color: #111; }
        .campo-table .val strong { font-size: 10pt; }
        .campo-ref td { border-bottom: 1.5px solid #1a3a5c; padding-bottom: 5px; }
        /* ── Cuerpo ───────────────────────────────────────────── */
        .memo-body { padding: 4mm 10mm 3mm; border-bottom: 1px solid #d0dce8; }
        .memo-cuerpo { font-size: 9.5pt; line-height: 1.6; color: #111; text-align: justify; margin-bottom: 4px; }
        .memo-motivo { font-size: 9pt; color: #555; font-style: italic; margin-top: 3px; }
        /* ── Tabla de ítems ───────────────────────────────────── */
        .items-section { padding: 0 7mm 0; }
        .items-header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 3mm 0 2mm; border-bottom: 2px solid #1a3a5c;
        }
        .items-header h2 { font-size: 8pt; font-weight: 700; color: #1a3a5c; text-transform: uppercase; letter-spacing: .06em; }
        .badge-items {
            background: #e8eef5; color: #1a3a5c; border: 1px solid #a8bbcc;
            font-size: 7pt; font-weight: 700; padding: 1px 8px; border-radius: 20px;
        }
        .oc-table { width: 100%; border-collapse: collapse; }
        .oc-table thead tr { background: #1a3a5c; color: #fff; }
        .oc-table thead th { padding: 3px 6px; font-size: 7pt; font-weight: 600; letter-spacing: .03em; text-align: center; white-space: nowrap; }
        .oc-table thead th.l { text-align: left; }
        .oc-table thead th.r { text-align: right; }
        .oc-table tbody tr { border-bottom: 1px solid #e8edf2; }
        .oc-table tbody tr:nth-child(even) td { background: #f0f4f8; }
        .oc-table tbody td { padding: 3px 6px; font-size: 8.5pt; vertical-align: middle; text-align: center; }
        .oc-table tbody td.l { text-align: left; }
        .oc-table tbody td.r { text-align: right; }
        .oc-table tbody td.cod { font-family: 'Courier New', monospace; font-size: 8pt; font-weight: 700; color: #1a3a5c; }
        /* ── Totales ──────────────────────────────────────────── */
        .totals-wrap { display: flex; justify-content: flex-end; padding: .4rem 0 .5rem; }
        .totals-table table { border-collapse: collapse; }
        .totals-table td { padding: 2px 4px; font-size: 8pt; }
        .totals-table .t-lbl { color: #6c7a89; font-size: 7.5pt; text-align: right; padding-right: 8px; }
        .totals-table .t-val { text-align: right; font-weight: 600; color: #1a1a2e; white-space: nowrap; }
        .totals-table tr.grand-total td { background: #1a3a5c; color: #fff; font-weight: 700; font-size: 10pt; }
        .totals-table tr.grand-total .t-lbl { color: #a8bbcc; }
        /* ── Firma ────────────────────────────────────────────── */
        .firma-section { display: flex; padding: 5mm 7mm 4mm; gap: 5mm; border-top: 1px solid #d0dce8; }
        .firma-box { flex: 0 0 auto; text-align: center; min-width: 55mm; }
        .firma-img { height: 16mm; max-width: 100%; object-fit: contain; margin-bottom: 1mm; }
        .firma-img-placeholder { height: 16mm; }
        .firma-line { border-top: 1.5px solid #1a3a5c; width: 55mm; margin: 0 auto 3px; }
        .firma-nombre { font-size: 8.5pt; font-weight: 700; color: #1a3a5c; text-transform: uppercase; }
        .firma-cargo  { font-size: 7.5pt; color: #555; }
        /* ── Footer ───────────────────────────────────────────── */
        .doc-footer {
            display: flex; align-items: center; justify-content: space-between;
            padding: 3mm 7mm; background: #eef2f7; border-top: 1px solid #a8bbcc;
            font-size: 7pt; color: #888;
        }
        .bottom-stripe { height: 5px; background: linear-gradient(90deg, #4a90d9 0%, #1a4a8a 55%, #0d2d5a 100%); }
        /* ── Barra de botones (pantalla) ──────────────────────── */
        .print-bar { display: flex; justify-content: center; gap: 10px; padding: 8px; background: #fff; }
        .btn-print { background: #1a3a5c; color: #fff; border: none; border-radius: 4px; padding: 6px 22px; font-size: 9pt; font-weight: 600; cursor: pointer; }
        .btn-print:hover { background: #0d2d5a; }
        .btn-close-win { background: #6c757d; color: #fff; border: none; border-radius: 4px; padding: 6px 16px; font-size: 9pt; cursor: pointer; }
        .btn-close-win:hover { background: #5a6268; }
        /* ── Print ────────────────────────────────────────────── */
        @@media print {
            html, body { background: #fff !important; margin: 0; padding: 0; }
            .print-bar { display: none !important; }
            .page { width: 100%; min-height: 0; margin: 0; box-shadow: none; border-radius: 0; }
            @@page { size: A4 portrait; margin: 8mm 10mm 10mm; }
            .oc-table tbody tr { page-break-inside: avoid; }
        }
    </style>
</head>
<body>

<div class="print-bar">
    <button class="btn-print" onclick="window.print()">🖨 Imprimir / Guardar PDF</button>
    <button class="btn-close-win" onclick="window.close()">✕ Cerrar</button>
</div>

<div class="page">

    <div class="top-stripe"></div>

    <!-- HEADER -->
    <div class="doc-header">
        <div class="header-left">
            <div class="header-logo">
                @if (!string.IsNullOrWhiteSpace(logoPath))
                {
                    <img src="/@logoPath" alt="@empresaNombre" />
                }
                else
                {
                    <div class="header-logo-placeholder">@empresaNombre</div>
                }
            </div>
            <div class="header-company">
                <h1>@empresaNombre</h1>
                <p>
                    @if (!string.IsNullOrWhiteSpace(empresaDireccion)) { <span>@empresaDireccion</span> }
                    @if (!string.IsNullOrWhiteSpace(empresaTelefono))  { <br /><span>Tel. @empresaTelefono</span> }
                    @if (!string.IsNullOrWhiteSpace(empresaRuc))       { <br /><span>RUC: @empresaRuc</span> }
                </p>
            </div>
        </div>
        <div class="header-right">
            <span class="doc-type">Memorando Interno</span>
            <span class="doc-num">@Model.NumeroMemo</span>
        </div>
    </div>

    <!-- FECHA / DE / A / REF -->
    <div class="memo-campos">
        <div class="memo-fecha-line">@Model.Ciudad, @fechaLarga</div>
        <table class="campo-table">
            <tr>
                <td class="lbl">DE</td>
                <td class="sep">:</td>
                <td class="val">@Model.De</td>
            </tr>
            <tr>
                <td class="lbl">A</td>
                <td class="sep">:</td>
                <td class="val">
                    <strong>@Model.Para</strong>
                    @if (!string.IsNullOrWhiteSpace(Model.CargoDestino))
                    {
                        <br /><span style="font-size:8.5pt;color:#444;">@Model.CargoDestino</span>
                    }
                </td>
            </tr>
            <tr class="campo-ref">
                <td class="lbl">REF</td>
                <td class="sep">:</td>
                <td class="val">@Model.Referencia</td>
            </tr>
        </table>
    </div>

    <!-- CUERPO -->
    @if (!string.IsNullOrWhiteSpace(Model.CuerpoTexto) || !string.IsNullOrWhiteSpace(Model.MotivoEntre))
    {
        <div class="memo-body">
            @if (!string.IsNullOrWhiteSpace(Model.CuerpoTexto))
            {
                <div class="memo-cuerpo">@Model.CuerpoTexto</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.MotivoEntre))
            {
                <div class="memo-motivo">(@Model.MotivoEntre)</div>
            }
        </div>
    }

    <!-- TABLA DE ACTIVOS -->
    @if (Model.Items.Count > 0)
    {
        <div class="items-section">
            <div class="items-header">
                <h2>Relación de Activos Fijos</h2>
                <span class="badge-items">@Model.Items.Count ítem@(Model.Items.Count == 1 ? "" : "s")</span>
            </div>
            <table class="oc-table">
                <thead>
                    <tr>
                        <th style="width:80px;">Código</th>
                        <th style="width:90px;">Fecha de<br />Ingreso</th>
                        <th class="l">Descripción</th>
                        <th style="width:80px;">Años de<br />Antigüedad</th>
                        <th class="r" style="width:100px;">Precio<br />Referencial S/</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="cod">@item.Codigo</td>
                            <td>@(item.FIngreso.HasValue ? item.FIngreso.Value.ToString("dd/MM/yyyy") : "—")</td>
                            <td class="l">@(item.Descripcion?.ToUpperInvariant() ?? "—")</td>
                            <td>@item.AniosAnt</td>
                            <td class="r" style="font-weight:700;">@item.PrecioRef.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="totals-wrap">
                <div class="totals-table">
                    <table>
                        <tr class="grand-total">
                            <td class="t-lbl">TOTAL:</td>
                            <td class="t-val">S/ @Model.Total.ToString("N2")</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- FIRMA -->
    @{
        bool tieneFirma    = Model.FirmaEmisor != null;
        bool tieneImgFirma = tieneFirma
            && Model.FirmaEmisor!.Firma != null
            && Model.FirmaEmisor.Firma.Length > 0;
        string? mimeF = null;
        string? b64F  = null;
        if (tieneImgFirma)
        {
            mimeF = FabricaHilos.Services.Contabilidad.ActivoFijoService.DetectImageMimeType(Model.FirmaEmisor!.Firma!) ?? "image/png";
            b64F  = Convert.ToBase64String(Model.FirmaEmisor!.Firma!);
        }
    }
    <div class="firma-section">
        <div class="firma-box">
            @if (tieneImgFirma)
            {
                <img class="firma-img" src="data:@mimeF;base64,@b64F" alt="Firma digital" />
            }
            else
            {
                <div class="firma-img-placeholder"></div>
            }
            <div class="firma-line"></div>
            @if (tieneFirma)
            {
                <div class="firma-nombre">@Model.FirmaEmisor!.NombreCompleto</div>
                <div class="firma-cargo">@Model.FirmaEmisor.Cargo</div>
            }
            else
            {
                <div class="firma-nombre" style="color:#888;">____________________________</div>
                <div class="firma-cargo" style="color:#aaa;">Firma y sello</div>
            }
        </div>
    </div>

    <!-- FOOTER -->
    <div class="doc-footer">
        <span>@empresaNombre &mdash; Documento generado el @Model.Fecha.ToString("dd/MM/yyyy HH:mm")</span>
        <span>Memorando N.&#176; @Model.NumeroMemo</span>
    </div>
    <div class="bottom-stripe"></div>

</div><!-- /page -->

</body>
</html>
