@model IReadOnlyList<FabricaHilos.Sire.Models.RegistroCompra>
@using FabricaHilos.Sire.Models
@{
    ViewData["Title"] = "SIRE - RCE";
    var periodos = ViewBag.Periodos as IReadOnlyList<PropuestaDto> ?? Array.Empty<PropuestaDto>();
    string periodo = ViewBag.Periodo as string ?? string.Empty;
    var yyyyMm = periodo.Length == 6 ? $"{periodo[..4]}/{periodo[4..]}" : periodo;
    decimal totalBaseGravada = Model.Sum(r => r.BaseImponibleGravadaDestinoGravadas);
    decimal totalIgv  = Model.Sum(r => r.IgvDestinoGravadas);
    decimal totalMonto = Model.Sum(r => r.ImporteTotal);

    static (string Desc, string Css) TipoComprobante(string cod) => cod switch
    {
        "01" => ("Factura",        "bg-primary"),
        "03" => ("Boleta",         "bg-info text-dark"),
        "07" => ("Nota de Crédito","bg-warning text-dark"),
        "08" => ("Nota de Débito", "bg-orange text-dark"),
        "09" => ("Guía Remisión",  "bg-secondary"),
        _    => (cod,              "bg-secondary")
    };
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Contabilidad" asp-action="Index">Contabilidad</a></li>
    <li class="breadcrumb-item"><a asp-controller="Sire" asp-action="Index">SIRE</a></li>
    <li class="breadcrumb-item active">RCE</li>
}

@if (ViewBag.EsMock == true)
{
    <div class="alert alert-warning d-flex align-items-center gap-2 py-2 mb-3" role="alert">
        <i class="bi bi-cone-striped fs-5"></i>
        <span><strong>MODO MOCK ACTIVO</strong> — Los datos mostrados son de prueba. No se realizan llamadas reales a SUNAT.</span>
    </div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@err
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@ok
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex align-items-center gap-2 mb-4">
    <div class="bg-success rounded-3 p-2 d-flex align-items-center justify-content-center" style="width:48px;height:48px">
        <i class="bi bi-cart-check fs-4 text-white"></i>
    </div>
    <div>
        <h4 class="mb-0 fw-semibold">RCE — Registro de Compras y Gastos</h4>
        <small class="text-muted">SIRE — SUNAT</small>
    </div>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-center">
            <div class="col-sm-auto">
                <label class="col-form-label col-form-label-sm fw-semibold">Periodo:</label>
            </div>
            <div class="col-sm-3">
                <form asp-controller="Sire" asp-action="Compras" method="get" id="formPeriodo">
                    <select class="form-select form-select-sm" name="periodo" onchange="document.getElementById('formPeriodo').submit()">
                        @foreach (var p in periodos)
                        {
                            var label = p.Periodo.Length == 6 ? $"{p.Periodo[..4]}/{p.Periodo[4..]} — {p.Descripcion}" : $"{p.Periodo} — {p.Descripcion}";
                            <option value="@p.Periodo" selected="@(p.Periodo == periodo)">@label</option>
                        }
                    </select>
                </form>
            </div>
            <div class="col-sm-auto ms-sm-auto d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#modalAceptar">
                    <i class="bi bi-check-circle me-1"></i>Aceptar propuesta
                </button>
                <button type="button" class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#modalReemplazar">
                    <i class="bi bi-arrow-repeat me-1"></i>Reemplazar
                </button>
                <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#modalCerrar">
                    <i class="bi bi-lock me-1"></i>Cerrar periodo
                </button>
                <a asp-action="DescargarConstancia" asp-route-periodo="@periodo" asp-route-tipo="compras"
                   class="btn btn-outline-secondary btn-sm" data-no-loading="true">
                    <i class="bi bi-download me-1"></i>Constancia
                </a>
            </div>
        </div>
    </div>
</div>

@if (Model.Any())
{
    <div class="row g-3 mb-3">
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm text-center py-2">
                <div class="text-muted small">Base Imponible Gravada</div>
                <div class="fw-semibold fs-6 text-primary">S/ @totalBaseGravada.ToString("N2")</div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm text-center py-2">
                <div class="text-muted small">IGV Total</div>
                <div class="fw-semibold fs-6 text-warning">S/ @totalIgv.ToString("N2")</div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm text-center py-2">
                <div class="text-muted small">Importe Total</div>
                <div class="fw-semibold fs-6 text-success">S/ @totalMonto.ToString("N2")</div>
            </div>
        </div>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-light d-flex align-items-center gap-2 flex-wrap">
        <i class="bi bi-table text-secondary"></i>
        <strong>Propuesta RCE — @yyyyMm</strong>
        <span class="badge bg-secondary">@Model.Count registro(s)</span>
        <div class="ms-auto d-flex align-items-center gap-2 flex-wrap">
            <div class="d-flex align-items-center gap-1 flex-wrap">
                <i class="bi bi-calendar-range text-secondary" title="Filtrar por rango de fechas"></i>
                <input type="date" id="sireFechaDesde" class="form-control form-control-sm" style="width:145px" title="Desde">
                <span class="text-muted small">—</span>
                <input type="date" id="sireFechaHasta" class="form-control form-control-sm" style="width:145px" title="Hasta">
                <button id="sireLimpiarFechas" class="btn btn-outline-secondary btn-sm" title="Limpiar fechas" style="display:none">
                    <i class="bi bi-x-circle"></i>
                </button>
            </div>
            <div class="btn-group btn-group-sm" role="group" id="sireFiltroTipo">
                <button type="button" class="btn btn-outline-secondary active" data-filtro="todas">Todas <span class="badge bg-secondary ms-1 sire-cnt" data-filtro-cnt="todas">@Model.Count</span></button>
                <button type="button" class="btn btn-outline-warning"           data-filtro="notas">Solo notas <span class="badge bg-warning text-dark ms-1 sire-cnt" data-filtro-cnt="notas">0</span></button>
                <button type="button" class="btn btn-outline-danger"            data-filtro="anuladas">Solo anuladas <span class="badge bg-danger ms-1 sire-cnt" data-filtro-cnt="anuladas">0</span></button>
            </div>
            <input type="search" id="sireSearch" class="form-control form-control-sm" style="width:200px" placeholder="Buscar..." />
            <select id="sirePageSize" class="form-select form-select-sm" style="width:90px">
                <option value="10">10</option>
                <option value="25" selected>25</option>
                <option value="50">50</option>
                <option value="0">Todos</option>
            </select>
            <button id="btnExportarCsvCompras" class="btn btn-outline-success btn-sm">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i>Exportar CSV
            </button>
        </div>
    </div>
            </button>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="tablaRce" class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Tipo Comprobante</th>
                        <th>Serie-Número</th>
                        <th>RUC Proveedor</th>
                        <th>Proveedor</th>
                        <th class="text-end">Base Grav.</th>
                        <th class="text-end">IGV</th>
                        <th class="text-end">Total</th>
                        <th>Referencia</th>
                        <th class="text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            Sin registros para el periodo @yyyyMm.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        var estadoBadge = item.Estado == "1" ? "bg-success" : item.Estado == "0" ? "bg-danger" : "bg-secondary";
                        var estadoLabel = item.Estado == "1" ? "Activo" : item.Estado == "0" ? "Anulado" : item.Estado;
                        var (tdesc, tcss) = TipoComprobante(item.TipoComprobante);
                        var esNota     = item.TipoComprobante == "07" || item.TipoComprobante == "08";
                        var esAnulada  = item.Estado == "0";
                        var trClass    = esAnulada ? "table-danger" : esNota ? "table-warning" : string.Empty;
                        <tr class="@trClass sire-row-detalle" style="cursor:pointer" title="Clic para ver detalle"
                            data-tipo="@item.TipoComprobante" data-estado="@item.Estado"
                            data-det-fecha="@item.FechaEmision"
                            data-det-venc="@item.FechaVencimientoPago"
                            data-det-tipo="@item.TipoComprobante"
                            data-det-tipodesc="@tdesc"
                            data-det-serie="@item.SerieComprobante"
                            data-det-numero="@item.NumeroComprobante"
                            data-det-tdoc="@item.TipoDocIdentidadProveedor"
                            data-det-ndoc="@item.NumeroDocIdentidadProveedor"
                            data-det-razon="@item.RazonSocialProveedor"
                            data-det-base="@item.BaseImponibleGravadaDestinoGravadas.ToString("N2")"
                            data-det-igv="@item.IgvDestinoGravadas.ToString("N2")"
                            data-det-total="@item.ImporteTotal.ToString("N2")"
                            data-det-tc="@(item.TipoCambio > 0 ? item.TipoCambio.ToString("N3") : "")"
                            data-det-detraccion="@item.NumeroConstanciaDetraccion"
                            data-det-retencion="@item.IndicadorSujetoRetencion"
                            data-det-clasif="@item.ClasificacionBienesServicios"
                            data-det-estado="@estadoLabel"
                            data-det-modtipo="@item.TipoDocModificado"
                            data-det-modserie="@item.SerieDocModificado"
                            data-det-modnum="@item.NumeroDocModificado"
                            data-det-modfecha="@item.FechaEmisionDocModificado"
                            data-det-cuo="@item.Cuo">
                            <td class="text-nowrap">@item.FechaEmision</td>
                            <td class="text-nowrap">
                                <span class="badge @tcss">@tdesc</span>
                                <small class="text-muted ms-1">@item.TipoComprobante</small>
                            </td>
                            <td class="text-nowrap">@item.SerieComprobante-@item.NumeroComprobante</td>
                            <td>@item.NumeroDocIdentidadProveedor</td>
                            <td>@item.RazonSocialProveedor</td>
                            <td class="text-end">@item.BaseImponibleGravadaDestinoGravadas.ToString("N2")</td>
                            <td class="text-end">@item.IgvDestinoGravadas.ToString("N2")</td>
                            <td class="text-end @(esNota ? "fw-bold" : "fw-semibold")">@item.ImporteTotal.ToString("N2")</td>
                            <td class="text-nowrap">
                            @if (!string.IsNullOrWhiteSpace(item.TipoDocModificado) && !string.IsNullOrWhiteSpace(item.NumeroDocModificado))
                            {
                                var (rdesc, _) = TipoComprobante(item.TipoDocModificado);
                                <span class="badge bg-light text-dark border me-1" title="@rdesc">@item.TipoDocModificado</span>
                                <span class="text-muted small">@item.SerieDocModificado-@item.NumeroDocModificado</span>
                                @if (!string.IsNullOrWhiteSpace(item.FechaEmisionDocModificado))
                                {
                                    <br /><small class="text-muted">@item.FechaEmisionDocModificado</small>
                                }
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                            </td>
                            <td class="text-center"><span class="badge @estadoBadge">@estadoLabel</span></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top" id="sireFooter">
            <small class="text-muted" id="sireInfo"></small>
            <nav><ul class="pagination pagination-sm mb-0" id="sirePagination"></ul></nav>
        </div>
        <div class="px-3 py-2 border-top bg-light d-flex flex-wrap gap-3">
            <span class="d-flex align-items-center gap-1 small">
                <span class="d-inline-block rounded" style="width:14px;height:14px;background:var(--bs-warning-bg-subtle);border:1px solid var(--bs-warning)"></span>
                Nota de Crédito / Débito (tipo 07 u 08)
            </span>
            <span class="d-flex align-items-center gap-1 small">
                <span class="d-inline-block rounded" style="width:14px;height:14px;background:var(--bs-danger-bg-subtle);border:1px solid var(--bs-danger)"></span>
                Comprobante anulado (estado 0)
            </span>
            <span class="d-flex align-items-center gap-1 small">
                <strong>S/ 0.00</strong>&nbsp;Importe en negrita = nota de crédito/débito
            </span>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const table     = document.getElementById('tablaRce');
    const search    = document.getElementById('sireSearch');
    const pgSel     = document.getElementById('sirePageSize');
    const info      = document.getElementById('sireInfo');
    const pager     = document.getElementById('sirePagination');
    const filtroGrp = document.getElementById('sireFiltroTipo');
    const fDesde    = document.getElementById('sireFechaDesde');
    const fHasta    = document.getElementById('sireFechaHasta');
    const btnLimpF  = document.getElementById('sireLimpiarFechas');
    let page = 1;
    let filtroActivo = 'todas';

    // Convierte fecha dd/MM/yyyy a Date comparable
    function parsefecha(str) {
        if (!str) return null;
        const p = str.split('/');
        if (p.length !== 3) return null;
        return new Date(+p[2], +p[1] - 1, +p[0]);
    }

    function rows() { return Array.from(table.tBodies[0].rows); }

    function cumpleFiltro(r) {
        const tipo   = r.dataset.tipo   || '';
        const estado = r.dataset.estado || '';
        if (filtroActivo === 'notas')    return tipo === '07' || tipo === '08';
        if (filtroActivo === 'anuladas') return estado === '0';
        return true;
    }

    function cumpleFecha(r) {
        const desde = fDesde.value ? new Date(fDesde.value) : null;
        const hasta = fHasta.value ? new Date(fHasta.value) : null;
        if (!desde && !hasta) return true;
        const fila = parsefecha(r.dataset.detFecha);
        if (!fila) return true;
        if (desde && fila < desde) return false;
        if (hasta && fila > hasta) return false;
        return true;
    }

    function filter() {
        const q = search.value.toLowerCase();
        rows().forEach(r => {
            const visible = cumpleFiltro(r) && cumpleFecha(r) && (q === '' || r.textContent.toLowerCase().includes(q));
            r.style.display = visible ? '' : 'none';
        });
        btnLimpF.style.display = (fDesde.value || fHasta.value) ? '' : 'none';
        page = 1; render();
    }

    function render() {
        const visible = rows().filter(r => r.style.display !== 'none');
        const ps = parseInt(pgSel.value);
        const total = visible.length;
        const pages = ps === 0 ? 1 : Math.ceil(total / ps);
        if (page > pages) page = Math.max(1, pages);
        visible.forEach((r, i) => r.style.display = (ps === 0 || (i >= (page-1)*ps && i < page*ps)) ? '' : 'none');
        info.textContent = ps === 0 ? `${total} registro(s)` : `Mostrando ${Math.min((page-1)*ps+1,total)}-${Math.min(page*ps,total)} de ${total}`;
        pager.innerHTML = '';
        if (ps === 0 || pages <= 1) return;
        const add = (lbl, p, dis, act) => {
            const li = document.createElement('li');
            li.className = 'page-item' + (dis?' disabled':'') + (act?' active':'');
            li.innerHTML = `<a class="page-link" href="#">${lbl}</a>`;
            if (!dis) li.querySelector('a').addEventListener('click', e => { e.preventDefault(); page = p; render(); });
            pager.appendChild(li);
        };
        add('&laquo;', page-1, page===1);
        for (let i=1;i<=pages;i++) add(i, i, false, i===page);
        add('&raquo;', page+1, page===pages);
    }

    filtroGrp.querySelectorAll('button').forEach(btn => {
        btn.addEventListener('click', () => {
            filtroGrp.querySelectorAll('button').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            filtroActivo = btn.dataset.filtro;
            filter();
        });
    });

    // Calcular contadores iniciales
    (function actualizarContadores() {
        const allRows = rows();
        const nNotas    = allRows.filter(r => r.dataset.tipo === '07' || r.dataset.tipo === '08').length;
        const nAnuladas = allRows.filter(r => r.dataset.estado === '0').length;
        document.querySelector('[data-filtro-cnt="notas"]').textContent    = nNotas;
        document.querySelector('[data-filtro-cnt="anuladas"]').textContent = nAnuladas;
    })();

    search.addEventListener('input', filter);
    pgSel.addEventListener('change', () => { page=1; filter(); });
    fDesde.addEventListener('change', filter);
    fHasta.addEventListener('change', filter);
    btnLimpF.addEventListener('click', () => { fDesde.value = ''; fHasta.value = ''; filter(); });
    filter();

    document.getElementById('btnExportarCsvCompras')
        const encabezados = Array.from(table.tHead.rows[0].cells).map(c => '"' + c.textContent.trim() + '"');
        const filas = rows().map(r => Array.from(r.cells).map(c => '"' + c.textContent.trim().replace(/"/g,'""') + '"').join(','));
        const csv = '\uFEFF' + [encabezados.join(','), ...filas].join('\r\n');
        const a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([csv], {type:'text/csv;charset=utf-8;'}));
        a.download = 'RCE_@(periodo)_@(DateTime.Now.ToString("yyyyMMddHHmm")).csv';
        a.click();
    });

    // Modal de detalle al hacer clic en fila
    const modalDet = new bootstrap.Modal(document.getElementById('modalDetalleCompra'));
    document.querySelectorAll('.sire-row-detalle').forEach(tr => {
        tr.addEventListener('click', function () {
            const d = this.dataset;
            document.getElementById('det-c-fecha').textContent      = d.detFecha      || '—';
            document.getElementById('det-c-venc').textContent       = d.detVenc       || '—';
            document.getElementById('det-c-tipo').textContent       = `${d.detTipodesc} (${d.detTipo})`;
            document.getElementById('det-c-serie').textContent      = `${d.detSerie}-${d.detNumero}`;
            document.getElementById('det-c-tdoc').textContent       = d.detTdoc       || '—';
            document.getElementById('det-c-ndoc').textContent       = d.detNdoc       || '—';
            document.getElementById('det-c-razon').textContent      = d.detRazon      || '—';
            document.getElementById('det-c-base').textContent       = `S/ ${d.detBase}`;
            document.getElementById('det-c-igv').textContent        = `S/ ${d.detIgv}`;
            document.getElementById('det-c-total').textContent      = `S/ ${d.detTotal}`;
            document.getElementById('det-c-tc').textContent         = d.detTc ? `S/ ${d.detTc}` : '—';
            document.getElementById('det-c-detraccion').textContent = d.detDetraccion || '—';
            document.getElementById('det-c-retencion').textContent  = d.detRetencion === '1' ? 'Sí' : 'No';
            document.getElementById('det-c-clasif').textContent     = d.detClasif     || '—';
            document.getElementById('det-c-estado').textContent     = d.detEstado     || '—';
            document.getElementById('det-c-cuo').textContent        = d.detCuo        || '—';
            const refRow = document.getElementById('det-c-ref-row');
            if (d.detModnum) {
                document.getElementById('det-c-ref').textContent = `${d.detModtipo} ${d.detModserie}-${d.detModnum} (${d.detModfecha})`;
                refRow.style.display = '';
            } else {
                refRow.style.display = 'none';
            }
            modalDet.show();
        });
    });
})();
</script>
}
<!-- Modal: Detalle de comprobante -->
<div class="modal fade" id="modalDetalleCompra" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="bi bi-cart-check me-2"></i>Detalle del Comprobante — RCE</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <h6 class="text-muted fw-semibold border-bottom pb-1 mb-2">Identificación</h6>
                        <table class="table table-sm table-borderless mb-0">
                            <tr><td class="text-muted" style="width:150px">Fecha emisión</td><td class="fw-semibold" id="det-c-fecha"></td></tr>
                            <tr><td class="text-muted">Fecha vencimiento</td><td id="det-c-venc"></td></tr>
                            <tr><td class="text-muted">Tipo comprobante</td><td id="det-c-tipo"></td></tr>
                            <tr><td class="text-muted">Serie - Número</td><td class="fw-semibold" id="det-c-serie"></td></tr>
                            <tr><td class="text-muted">CUO</td><td class="small text-muted" id="det-c-cuo"></td></tr>
                            <tr><td class="text-muted">Estado</td><td id="det-c-estado"></td></tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted fw-semibold border-bottom pb-1 mb-2">Proveedor</h6>
                        <table class="table table-sm table-borderless mb-0">
                            <tr><td class="text-muted" style="width:150px">Tipo doc.</td><td id="det-c-tdoc"></td></tr>
                            <tr><td class="text-muted">N° documento</td><td class="fw-semibold" id="det-c-ndoc"></td></tr>
                            <tr><td class="text-muted">Razón social</td><td id="det-c-razon"></td></tr>
                        </table>
                        <h6 class="text-muted fw-semibold border-bottom pb-1 mb-2 mt-3">Datos adicionales</h6>
                        <table class="table table-sm table-borderless mb-0">
                            <tr><td class="text-muted" style="width:150px">Detracción</td><td id="det-c-detraccion"></td></tr>
                            <tr><td class="text-muted">Sujeto retención</td><td id="det-c-retencion"></td></tr>
                            <tr><td class="text-muted">Clasificación</td><td id="det-c-clasif"></td></tr>
                        </table>
                    </div>
                    <div class="col-12">
                        <h6 class="text-muted fw-semibold border-bottom pb-1 mb-2">Importes</h6>
                        <div class="row g-2">
                            <div class="col-sm-3"><div class="card border-0 bg-light text-center py-2"><div class="small text-muted">Base Gravada</div><div class="fw-bold text-success" id="det-c-base"></div></div></div>
                            <div class="col-sm-3"><div class="card border-0 bg-light text-center py-2"><div class="small text-muted">IGV</div><div class="fw-bold text-warning" id="det-c-igv"></div></div></div>
                            <div class="col-sm-3"><div class="card border-0 bg-light text-center py-2"><div class="small text-muted">Total</div><div class="fw-bold text-primary" id="det-c-total"></div></div></div>
                            <div class="col-sm-3"><div class="card border-0 bg-light text-center py-2"><div class="small text-muted">Tipo Cambio</div><div class="fw-semibold" id="det-c-tc"></div></div></div>
                        </div>
                    </div>
                    <div class="col-12" id="det-c-ref-row">
                        <h6 class="text-muted fw-semibold border-bottom pb-1 mb-2">Comprobante Modificado (NC/ND)</h6>
                        <p class="mb-0" id="det-c-ref"></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Aceptar propuesta -->
<div class="modal fade" id="modalAceptar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-check-circle text-success me-2"></i>Aceptar propuesta RCE</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Confirma que desea <strong>aceptar</strong> la propuesta del periodo <strong>@yyyyMm</strong>?
                <div class="alert alert-info mt-3 mb-0 small">
                    <i class="bi bi-info-circle me-1"></i>Esta acción enviará la propuesta a SUNAT para su procesamiento.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <form asp-action="AceptarPropuesta" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="periodo" value="@periodo" />
                    <input type="hidden" name="tipo" value="compras" />
                    <button class="btn btn-success btn-sm" type="submit">
                        <i class="bi bi-check-circle me-1"></i>Confirmar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Reemplazar propuesta -->
<div class="modal fade" id="modalReemplazar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-arrow-repeat text-warning me-2"></i>Reemplazar propuesta RCE</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ReemplazarPropuesta" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <p>Seleccione el archivo de reemplazo para el periodo <strong>@yyyyMm</strong>:</p>
                    <input type="hidden" name="periodo" value="@periodo" />
                    <input type="hidden" name="tipo" value="compras" />
                    <input type="file" name="archivo" class="form-control form-control-sm" required />
                    <div class="alert alert-warning mt-3 mb-0 small">
                        <i class="bi bi-exclamation-triangle me-1"></i>El archivo reemplazará la propuesta actual en SUNAT.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button class="btn btn-warning btn-sm" type="submit">
                        <i class="bi bi-arrow-repeat me-1"></i>Reemplazar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Cerrar periodo -->
<div class="modal fade" id="modalCerrar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-lock me-2"></i>Cerrar periodo RCE</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Confirma que desea <strong>cerrar</strong> el periodo <strong>@yyyyMm</strong>?
                <div class="alert alert-danger mt-3 mb-0 small">
                    <i class="bi bi-exclamation-octagon me-1"></i><strong>Atención:</strong> Esta operación es <strong>irreversible</strong>. El periodo quedará cerrado en SUNAT.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <form asp-action="CerrarPeriodo" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="periodo" value="@periodo" />
                    <input type="hidden" name="tipo" value="compras" />
                    <button class="btn btn-danger btn-sm" type="submit">
                        <i class="bi bi-lock me-1"></i>Confirmar cierre
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
