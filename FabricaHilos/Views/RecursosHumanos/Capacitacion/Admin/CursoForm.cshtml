@model FabricaHilos.Models.Capacitacion.CapCurso
@{
    ViewData["Title"] = Model.IdCurso == 0 ? "Nuevo Curso" : $"Editar: {Model.Titulo}";
    var categorias = ViewBag.Categorias as List<FabricaHilos.Models.Capacitacion.CapCategoria> ?? new List<FabricaHilos.Models.Capacitacion.CapCategoria>();
    var contenidos = ViewBag.Contenidos as List<FabricaHilos.Models.Capacitacion.CapContenido> ?? new List<FabricaHilos.Models.Capacitacion.CapContenido>();
    var examen = ViewBag.Examen as FabricaHilos.Models.Capacitacion.CapExamen;
    int totalPreguntas = ViewBag.TotalPreguntas ?? 0;
    var esNuevo = Model.IdCurso == 0;
    var areasDisponibles = ViewBag.Areas as List<FabricaHilos.Models.Capacitacion.CapAreaOption> ?? new List<FabricaHilos.Models.Capacitacion.CapAreaOption>();
    var areasCurso    = ViewBag.AreasCurso as List<FabricaHilos.Models.Capacitacion.CapCursoArea> ?? new List<FabricaHilos.Models.Capacitacion.CapCursoArea>();
    var usuariosCurso = ViewBag.UsuariosCurso as List<FabricaHilos.Models.Capacitacion.CapCursoUsuario> ?? new List<FabricaHilos.Models.Capacitacion.CapCursoUsuario>();
    // Jerarquía Área → Centro de Costo (ver 12_CAP_JERARQUIA_CCOSTO.sql)
    var centrosCostoDisponibles = ViewBag.CentrosCosto as List<FabricaHilos.Models.Capacitacion.CapCcostoOption> ?? new List<FabricaHilos.Models.Capacitacion.CapCcostoOption>();
    var ccostoCurso   = ViewBag.CcostoCurso as List<FabricaHilos.Models.Capacitacion.CapCursoCcosto> ?? new List<FabricaHilos.Models.Capacitacion.CapCursoCcosto>();
    // Cargo (ver 15_CAP_CURSO_CARGO.sql) — complemento de ALCANCE=AREA
    var cargosDisponibles = ViewBag.Cargos as List<FabricaHilos.Models.Capacitacion.CapCargoOption> ?? new List<FabricaHilos.Models.Capacitacion.CapCargoOption>();
    var cargoCurso    = ViewBag.CargoCurso as List<FabricaHilos.Models.Capacitacion.CapCursoCargo> ?? new List<FabricaHilos.Models.Capacitacion.CapCursoCargo>();
}

@section Styles {
<link rel="stylesheet" href="~/lib/select2/dist/css/select2.min.css" asp-append-version="true">
<link rel="stylesheet" href="~/lib/select2-bootstrap-5-theme/dist/select2-bootstrap-5-theme.min.css" asp-append-version="true">
<style>
/* ── LMS · Formulario Curso ────────────────────── */
body { background:#f0f4f8; }
.select2-container--bootstrap-5 .select2-selection { font-size:.85rem; border-color:#dde3ec; }
.lms-card { background:#fff; border:1px solid #dde3ec; border-radius:10px; box-shadow:0 1px 4px rgba(15,23,42,.04); padding:1.5rem; }
.lms-card-sticky { position:sticky; top:80px; }
.form-label { font-size:.78rem; font-weight:600; color:#334155; margin-bottom:.3rem; }
.form-control, .form-select { font-size:.85rem; border-color:#dde3ec; border-radius:7px; }
.form-control:focus, .form-select:focus { border-color:#1d4ed8; box-shadow:0 0 0 3px rgba(29,78,216,.1); }
.sec-lbl { font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:#64748b; display:block; margin-bottom:.65rem; }
.lms-btn { display:inline-flex; align-items:center; gap:.35rem; border-radius:7px; padding:.38rem .9rem; font-size:.82rem; font-weight:500; text-decoration:none; transition:all .12s; cursor:pointer; border:none; }
.lms-btn-primary { background:#1d4ed8; color:#fff; }
.lms-btn-primary:hover { background:#1e40af; color:#fff; }
.lms-btn-outline { background:#fff; border:1px solid #dde3ec !important; color:#334155; }
.lms-btn-outline:hover { background:#f8fafc; border-color:#94a3b8 !important; color:#0f172a; }
.lms-btn-block { width:100%; justify-content:center; padding:.5rem 1rem; font-size:.85rem; }
</style>
}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="CapacitacionAdmin" asp-action="Index">Admin</a></li>
        <li class="breadcrumb-item active">@(esNuevo ? "Nuevo Curso" : "Editar Curso")</li>
    </ol>
</nav>

<h4 class="fw-bold mb-4" style="color:#0f172a">
    <i class="bi @(esNuevo?"bi-plus-circle":"bi-pencil") me-2" style="color:#1d4ed8;font-size:1.1rem"></i>
    @(esNuevo ? "Nuevo Curso" : Model.Titulo)
</h4>

<div class="row g-4">
    <!-- Datos del curso -->
    <div class="col-lg-8">
        <div class="lms-card mb-4">
            <h6 class="fw-semibold mb-3" style="font-size:.82rem;text-transform:uppercase;letter-spacing:.06em;color:#64748b">Información general</h6>
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label">Título <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="titulo" value="@Model.Titulo" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Categoría <span class="text-danger">*</span></label>
                    <select class="form-select" id="categoria">
                        @foreach (var cat in categorias)
                        {
                            <option value="@cat.IdCategoria" selected="@(cat.IdCategoria==Model.IdCategoria)">
                                @cat.Nombre
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Nivel</label>
                    <select class="form-select" id="nivel">
                        <option value="B" selected="@(Model.Nivel=="B")">Básico</option>
                        <option value="I" selected="@(Model.Nivel=="I")">Intermedio</option>
                        <option value="A" selected="@(Model.Nivel=="A")">Avanzado</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Duración (min)</label>
                    <input type="number" class="form-control" id="duracion" value="@Model.DuracionMin" min="0">
                </div>
                <div class="col-12">
                    <label class="form-label">Descripción</label>
                    <textarea class="form-control" id="descripcion" rows="3">@Model.Descripcion</textarea>
                </div>
                <div class="col-12">
                    <label class="form-label">Objetivo</label>
                    <textarea class="form-control" id="objetivo" rows="2">@Model.Objetivo</textarea>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Nota mínima (%)</label>
                    <input type="number" class="form-control" id="notaAprob"
                           value="@Model.NotaAprobacion" min="0" max="100">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Máx. intentos examen</label>
                    <input type="number" class="form-control" id="maxIntentos"
                           value="@Model.MaxIntentos" min="1">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Validez cert. (días)</label>
                    <input type="number" class="form-control" id="certValidez"
                           value="@Model.CertValidezDias" min="0" placeholder="Sin vencimiento">
                </div>
                <div class="col-12">
                    <div class="d-flex gap-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="obligatorio"
                                   @(Model.EsObligatorio?"checked":"")>
                            <label class="form-check-label" for="obligatorio">Obligatorio</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="tieneExamen"
                                   @(Model.TieneExamen=="S"?"checked":"")>
                            <label class="form-check-label" for="tieneExamen">Tiene examen</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="tieneCert"
                                   @(Model.TieneCertificado=="S"?"checked":"")>
                            <label class="form-check-label" for="tieneCert">Con certificado</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contenidos -->
        @if (Model.IdCurso > 0)
        {
            <div class="lms-card mb-4">
                <div class="d-flex justify-content-between mb-3">
                    <h6 class="fw-semibold mb-0" style="font-size:.82rem;text-transform:uppercase;letter-spacing:.06em;color:#64748b">Contenidos del curso</h6>
                    <button class="lms-btn lms-btn-outline" style="padding:.25rem .65rem;font-size:.78rem" data-bs-toggle="modal"
                            data-bs-target="#modalContenido">
                        <i class="bi bi-plus"></i> Agregar
                    </button>
                </div>
                <div id="listaContenidos">
                    @if (contenidos.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var cont in contenidos)
                            {
                                var tipoIcon = cont.Tipo switch { "VID" => "bi-play-circle-fill", "PDF" => "bi-file-earmark-pdf-fill", "URL" => "bi-link-45deg", "TXT" => "bi-file-earmark-text-fill", _ => "bi-file-earmark-fill" };
                                var tipoColor = cont.Tipo switch { "VID" => "#1d4ed8", "PDF" => "#dc2626", "URL" => "#0891b2", "TXT" => "#7c3aed", _ => "#64748b" };
                                <div class="list-group-item d-flex align-items-center gap-3 px-0 py-2" style="border-color:#f1f5f9">
                                    <span style="width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:6px;background:@(tipoColor)12;flex-shrink:0">
                                        <i class="bi @tipoIcon" style="color:@tipoColor;font-size:.85rem"></i>
                                    </span>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="text-truncate" style="font-size:.82rem;color:#0f172a;font-weight:500">@cont.Titulo</div>
                                        <div style="font-size:.7rem;color:#94a3b8">@cont.Tipo · Orden @cont.Orden @(cont.DuracionSeg > 0 ? $"· {cont.DuracionSeg}s" : "")</div>
                                    </div>
                                    <span class="bdg" style="font-size:.6rem;background:@(cont.Obligatorio == "S" ? "#fef2f2" : "#f0fdf4");color:@(cont.Obligatorio == "S" ? "#991b1b" : "#166534")">
                                        @(cont.Obligatorio == "S" ? "Obligatorio" : "Opcional")
                                    </span>
                                    <button class="btn btn-sm btn-link text-primary p-0" title="Editar"
                                            onclick="editarContenido(@cont.IdContenido)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-link text-danger p-0" title="Eliminar"
                                            onclick="eliminarContenido(@cont.IdContenido, this)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            }
                        </div>
                        <div class="mt-2" style="font-size:.72rem;color:#64748b">
                            <i class="bi bi-info-circle me-1"></i>@contenidos.Count contenido(s) registrado(s)
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small text-center py-3">
                            No hay contenidos. Usa el botón "+ Agregar" para añadir lecciones.
                        </div>
                    }
                </div>
            </div>

            <!-- Examen -->
            <div class="lms-card mb-4" id="seccionExamen">
                <div class="d-flex justify-content-between mb-3">
                    <h6 class="fw-semibold mb-0" style="font-size:.82rem;text-transform:uppercase;letter-spacing:.06em;color:#64748b">
                        <i class="bi bi-pencil-square me-1" style="color:#1d4ed8"></i>Examen del curso
                    </h6>
                    @if (examen == null && Model.TieneExamen == "S")
                    {
                        <button class="lms-btn lms-btn-outline" style="padding:.25rem .65rem;font-size:.78rem"
                                data-bs-toggle="modal" data-bs-target="#modalCrearExamen">
                            <i class="bi bi-plus"></i> Crear examen
                        </button>
                    }
                </div>

                @if (examen != null)
                {
                    <div class="row g-2 mb-3">
                        <div class="col-12">
                            <div style="font-size:.85rem;font-weight:600;color:#0f172a">@examen.Titulo</div>
                            @if (!string.IsNullOrEmpty(examen.Instrucciones))
                            {
                                <div style="font-size:.75rem;color:#64748b;margin-top:.25rem">@examen.Instrucciones</div>
                            }
                        </div>
                        <div class="col-6">
                            <span style="font-size:.75rem;color:#64748b">Tiempo:</span>
                            <span style="font-size:.82rem;color:#0f172a;font-weight:500">@examen.TiempoMin min</span>
                        </div>
                        <div class="col-6">
                            <span style="font-size:.75rem;color:#64748b">Preguntas:</span>
                            <span style="font-size:.82rem;color:#0f172a;font-weight:500">@totalPreguntas</span>
                        </div>
                        <div class="col-6">
                            <span style="font-size:.75rem;color:#64748b">Modo:</span>
                            <span style="font-size:.82rem;color:#0f172a;font-weight:500">@(examen.EsModoAleatorio ? $"Aleatorio ({examen.NroPregAleatorias} preg.)" : "Fijas")</span>
                        </div>
                        <div class="col-6">
                            <span style="font-size:.75rem;color:#64748b">Mezclar:</span>
                            <span style="font-size:.82rem;color:#0f172a;font-weight:500">@(examen.MezclarPreg == "S" ? "Sí" : "No")</span>
                        </div>
                    </div>

                    <!-- Lista de preguntas -->
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="sec-lbl mb-0">Preguntas registradas</span>
                        <button class="lms-btn lms-btn-outline" style="padding:.25rem .65rem;font-size:.78rem"
                                data-bs-toggle="modal" data-bs-target="#modalPregunta">
                            <i class="bi bi-plus"></i> Agregar pregunta
                        </button>
                    </div>
                    <div id="listaPreguntas">
                        <div class="text-center py-2">
                            <span class="spinner-border spinner-border-sm text-secondary"></span>
                            <span class="small text-muted ms-2">Cargando preguntas...</span>
                        </div>
                    </div>
                }
                else if (Model.TieneExamen == "S")
                {
                    <div class="text-muted small text-center py-2">
                        <i class="bi bi-exclamation-triangle me-1"></i>El curso tiene examen activado pero no se ha creado el registro de examen aún.
                        Usa el botón "Crear examen" para configurarlo.
                    </div>
                }
                else
                {
                    <div class="text-muted small text-center py-2">
                        <i class="bi bi-info-circle me-1"></i>Active la opción "Tiene examen" arriba y guarde el curso para poder crear un examen.
                    </div>
                }
            </div>
        }
        else
        {
            <div class="lms-card mb-4">
                <div class="text-muted small text-center py-3">
                    <i class="bi bi-info-circle me-1"></i>Guarde el curso primero para poder agregar contenidos, examen y preguntas.
                </div>
            </div>
        }
    </div>

    <!-- Acciones -->
    <div class="col-lg-4">
        <div class="lms-card lms-card-sticky">
            <h6 class="fw-semibold mb-3" style="font-size:.82rem;text-transform:uppercase;letter-spacing:.06em;color:#64748b">Publicación</h6>
            <div class="mb-3">
                <label class="form-label">Estado</label>
                <select class="form-select" id="estadoCurso">
                    <option value="I" selected="@(Model.Estado=="I")">Borrador</option>
                    <option value="A" selected="@(Model.Estado=="A")">Publicado</option>
                    <option value="B" selected="@(Model.Estado=="B")">Archivado</option>
                </select>
            </div>
            <button class="lms-btn lms-btn-primary lms-btn-block mb-2" onclick="guardarCurso()">
                <i class="bi bi-save"></i> Guardar curso
            </button>
            <a asp-controller="CapacitacionAdmin" asp-action="Index"
               class="lms-btn lms-btn-outline lms-btn-block">Cancelar</a>
        </div>

        <!-- Visibilidad y alcance -->
        <div class="lms-card mt-4">
            <h6 class="fw-semibold mb-3" style="font-size:.82rem;text-transform:uppercase;letter-spacing:.06em;color:#64748b">
                <i class="bi bi-eye me-1" style="color:#1d4ed8"></i>Visibilidad y audiencia
            </h6>
            <div class="mb-3">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="cursoPrivado"
                           @(Model.EsPrivado ? "checked" : "")>
                    <label class="form-check-label" for="cursoPrivado">Curso privado</label>
                </div>
                <div style="font-size:.72rem;color:#64748b;margin-top:.25rem">
                    Público: visible para todos en el catálogo. Privado: solo visible para la
                    audiencia que definas abajo (los ya inscritos siempre lo conservan).
                </div>
            </div>

            <div id="seccionAlcance" style="display:@(Model.EsPrivado ? "block" : "none")">
                <div class="mb-3">
                    <label class="form-label">Dirigido a</label>
                    <select class="form-select" id="tipoAlcance">
                        <option value="TODOS"    selected="@(Model.Alcance=="TODOS")">Todo el personal</option>
                        <option value="AREA"     selected="@(Model.Alcance=="AREA")">Gran Centro de Costo / Centro de Costo / Cargo</option>
                        <option value="PERSONAL" selected="@(Model.Alcance=="PERSONAL")">Personal específico</option>
                    </select>
                </div>

                <div class="mb-3" id="wrapAreas" style="display:@(Model.Alcance=="AREA" ? "block" : "none")">
                    <label class="form-label">Gran Centro de Costo (completo)</label>
                    <select class="form-select" id="selectAreas" multiple style="width:100%">
                        @foreach (var a in areasDisponibles)
                        {
                            <option value="@a.GranCcosto" selected="@(areasCurso.Any(x => x.GranCcosto == a.GranCcosto))">@a.DescArea</option>
                        }
                    </select>
                </div>

                <div class="mb-3" id="wrapCcosto" style="display:@(Model.Alcance=="AREA" ? "block" : "none")">
                    <label class="form-label">Centros de costo específicos <span class="text-muted fw-normal">(opcional)</span></label>
                    <select class="form-select" id="selectCcosto" multiple style="width:100%">
                        @foreach (var grupo in centrosCostoDisponibles.GroupBy(c => c.DescArea).OrderBy(g => g.Key))
                        {
                            <optgroup label="@grupo.Key">
                                @foreach (var c in grupo)
                                {
                                    <option value="@c.CentroCosto" selected="@(ccostoCurso.Any(x => x.CentroCosto == c.CentroCosto))">@c.NombreCcosto</option>
                                }
                            </optgroup>
                        }
                    </select>
                    <div style="font-size:.72rem;color:#64748b;margin-top:.25rem">
                        Un <strong>Gran Centro de Costo</strong> agrupa varios <strong>Centros de Costo</strong> (ej. "CONERAS" incluye
                        AUTOCONER, CONERA INDUSTRIAL, MADEJERAS, REDINA...). Si no selecciona ninguno aquí,
                        el curso queda visible para <strong>todo</strong> el Gran Centro de Costo marcado arriba. Puede combinar
                        Grandes Centros de Costo completos con Centros de Costo puntuales de otros.
                    </div>
                </div>

                <div class="mb-3" id="wrapCargo" style="display:@(Model.Alcance=="AREA" ? "block" : "none")">
                    <label class="form-label">Cargos específicos <span class="text-muted fw-normal">(opcional)</span></label>
                    <select class="form-select" id="selectCargo" multiple style="width:100%">
                        @foreach (var g in cargosDisponibles)
                        {
                            <option value="@g.CodCargo" selected="@(cargoCurso.Any(x => x.CodCargo == g.CodCargo))">@g.DescCargo (@g.Cantidad)</option>
                        }
                    </select>
                    <div style="font-size:.72rem;color:#64748b;margin-top:.25rem">
                        Dirige el curso a todo el personal con ese <strong>Cargo</strong>, sin importar su área o
                        centro de costo (ej. "todos los Supervisores"). Se puede combinar con las áreas/centros
                        marcados arriba — el curso queda visible para la unión de ambos.
                    </div>
                </div>

                <div class="mb-2" id="wrapUsuarios" style="display:@(Model.Alcance=="PERSONAL" ? "block" : "none")">
                    <label class="form-label">Personal</label>
                    <select class="form-select" id="selectUsuarios" multiple style="width:100%">
                        @foreach (var u in usuariosCurso)
                        {
                            <option value="@u.CCodigo" selected>@u.NombreUsuario @(string.IsNullOrEmpty(u.CodUsuario) ? "(sin acceso LMS)" : $"({u.CodUsuario})")</option>
                        }
                    </select>
                    <div style="font-size:.72rem;color:#64748b;margin-top:.25rem">
                        Se puede asignar a cualquier trabajador activo, tenga o no cuenta de acceso al LMS.
                        Quien aparezca como "sin acceso LMS" no podrá ver el curso hasta que Sistemas le cree su usuario.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@Html.AntiForgeryToken()

<!-- Modal agregar contenido -->
<div class="modal fade" id="modalContenido" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Agregar contenido</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formContenido" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idCurso" value="@Model.IdCurso">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">Título</label>
                            <input type="text" name="titulo" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Tipo</label>
                            <select name="tipo" class="form-select" id="tipoContenido"
                                    onchange="cambiarTipo(this.value)">
                                <option value="VID">Video</option>
                                <option value="PDF">PDF</option>
                                <option value="ARC">Archivo</option>
                                <option value="URL">URL externa</option>
                                <option value="TXT">Artículo HTML</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Orden</label>
                            <input type="number" name="orden" class="form-control" value="1" min="1">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Duración (seg)</label>
                            <input type="number" name="duracionSeg" class="form-control" value="0" min="0" id="fieldDuracion">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Obligatorio</label>
                            <select name="obligatorio" class="form-select">
                                <option value="S">Sí</option>
                                <option value="N">No (opcional)</option>
                            </select>
                        </div>

                        <!-- Campo archivo -->
                        <div class="col-12" id="fieldArchivo">
                            <label class="form-label">Archivo</label>
                            <input type="file" name="archivo" class="form-control"
                                   accept=".mp4,.webm,.pdf,.pptx,.ppt,.docx,.doc,.xlsx,.xls,.zip,.rar">
                            <div class="form-text">Máx 500 MB para video, 50 MB para documentos.</div>
                        </div>

                        <!-- Campo URL -->
                        <div class="col-12 d-none" id="fieldUrl">
                            <label class="form-label">URL externa</label>
                            <input type="url" name="urlExterna" class="form-control"
                                   placeholder="https://...">
                        </div>

                        <!-- Campo HTML -->
                        <div class="col-12 d-none" id="fieldHtml">
                            <label class="form-label">Contenido HTML</label>
                            <textarea name="contenidoHtml" class="form-control" rows="6"
                                      placeholder="<p>Contenido del artículo...</p>"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="border-top:1px solid #f1f5f9">
                    <button type="button" class="lms-btn lms-btn-outline" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="lms-btn lms-btn-primary" onclick="subirContenido()">
                        <i class="bi bi-cloud-upload"></i> Guardar contenido
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal editar contenido -->
<div class="modal fade" id="modalEditarContenido" tabindex="-1">
