                                                    <td class="text-end">@ds.Unidades.ToString("N0")</td>
                                                    <td class="text-end fw-semibold">@ds.PesoKg.ToString("N2")</td>
                                                    <td class="text-muted">@(ds.Glosa ?? "—")</td>
                                                  </tr>
                                                }
                                              </tbody>
                                            </table>
                                          </div>
                                        </div>
                                      </div>
                                    </div>
                                  }

                                  </div>@* /accordion *@
                                </div>
                              }
                            </div>@* /tab-tt *@

                            @* Tab Historial de eventos *@
                            <div class="tab-pane fade" id="@tabEventosId" role="tabpanel">
                                @if (!eventosSub.Any())
                                {
                                    <div class="p-3 text-muted small"><i class="bi bi-info-circle me-1"></i>Sin eventos registrados para este sublote.</div>
                                }
                                else
                                {
                                    @foreach (var ev in eventosSub)
                                    {
                                        var dotColorEv = ev.TipoEvento switch {
                                            "AV" => "#198754",
                                            "RE" => "#dc3545",
                                            "AL" => "#fd7e14",
                                            "CI" => "#6c757d",
                                            _    => "#0d6efd"
                                        };
                                        <div class="evento-item">
                                            <div class="evento-dot" style="background:@dotColorEv;"></div>
                                            <div>
                                                <div class="d-flex align-items-center gap-1 flex-wrap">
                                                    <span class="badge bg-@ev.TipoEventoCss evento-badge">@ev.TipoEventoDesc</span>
                                                    <span class="fw-semibold" style="font-size:.8rem;">@ev.NombrePaso</span>
                                                    @if (ev.NroCiclo > 1)
                                                    {
                                                        <span class="badge bg-secondary" style="font-size:.63rem;">C.@ev.NroCiclo</span>
                                                    }
                                                </div>
                                                @if (ev.KgCantidad.HasValue)
                                                {
                                                    <div class="text-muted mt-1" style="font-size:.72rem;"><i class="bi bi-box me-1"></i>@ev.KgCantidad.Value.ToString("N0") kg</div>
                                                }
                                                @if (!string.IsNullOrEmpty(ev.Observacion))
                                                {
                                                    <div class="text-muted" style="font-size:.72rem;">@ev.Observacion</div>
                                                }
                                            </div>
                                            <div class="evento-hora">@ev.FchEvento.ToString("dd/MM/yy")<br/>@ev.FchEvento.ToString("HH:mm")</div>
                                        </div>
                                    }
                                }
                            </div>

                        </div>@* /tab-content *@
                    </div>@* /sublote-panel-body *@
                </div>@* /collapse *@
            </div>@* /sublote-panel *@

        </div>@* /sublote-card *@
    }
</div>
@section Scripts {
@* ── Datos de alertas serializados para el modal JS *@
@{
    var alertasJson = System.Text.Json.JsonSerializer.Serialize(Model.Alertas.Select(a => new {
        nro           = a.Nro,
        nivel         = a.Nivel,
        nivelTxt      = a.NivelTexto,
        nivelCol      = a.NivelColor,
        tipAlerta     = a.TipAlerta,
        tipo          = a.TipoTexto,
        titulo        = a.Titulo,
        detalle       = a.Detalle,
        nombrePaso    = a.NombrePaso,
        colorPaso     = a.ColorUiPaso,
        tituloArt     = a.TituloArt,
        procesoTxt    = a.ProcesoTexto,
        fchComp       = a.FchEntregaComp.HasValue ? a.FchEntregaComp.Value.ToString("dd/MM/yy") : (string?)null,
        diasComp      = a.FchEntregaComp.HasValue ? (int)(a.FchEntregaComp.Value - DateTime.Today).TotalDays : (int?)null,
        kgPend        = a.KgPendientes.HasValue ? (double?)Math.Round((double)a.KgPendientes.Value, 1) : null,
        cantOrig      = a.CantidadOrig.HasValue ? (double?)Math.Round((double)a.CantidadOrig.Value, 0) : null,
        kgPct         = (a.KgPendientes.HasValue && a.CantidadOrig.HasValue && a.CantidadOrig > 0)
                            ? (double?)Math.Round((double)(a.KgPendientes / a.CantidadOrig * 100), 0) : null,
        diasRetraso   = a.DiasRetraso,
        nroCiclo      = a.NroCiclo,
        urgente       = a.IndUrgente == "S",
        horas         = a.HorasSinResolver.HasValue ? (int)a.HorasSinResolver.Value : (int?)null
    }));
}
<div class="modal fade" id="modalAlertasPedido" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-2" style="background:linear-gradient(135deg,#2d3748,#4a5568);color:#fff;">
                <h6 class="modal-title mb-0"><i class="bi bi-bell-fill me-2 text-danger"></i><span id="modalAlertasTitulo">Alertas</span></h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-2" id="modalAlertasBody"></div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
<style>
    /* ── Modal alertas: subtabla ─────────────────────────────── */
    #modalAlertasBody .mal-tbl { width:100%; border-collapse:collapse; font-size:.8rem; }
    #modalAlertasBody .mal-tbl thead th {
        font-size:.67rem; font-weight:700; text-transform:uppercase; letter-spacing:.04em;
        color:#718096; background:#e2e7f0; padding:.28rem .5rem;
        border-bottom:2px solid #cdd4e0;
    }
    #modalAlertasBody .mal-tbl td { padding:.3rem .5rem; vertical-align:middle; }
    #modalAlertasBody .mal-tbl tbody tr.tip-RET1 { background:#fff5f5; }
    #modalAlertasBody .mal-tbl tbody tr.tip-RET2 { background:#fffbeb; }
    #modalAlertasBody .mal-tbl tbody tr.tip-SMP  { background:#fffbeb; }
    #modalAlertasBody .mal-tbl tbody tr.tip-STN  { background:#eff6ff; }
    #modalAlertasBody .mal-tbl tbody tr.tip-QCF  { background:#fff5f5; }
    #modalAlertasBody .mal-tbl tbody tr:hover td { filter:brightness(.96); }
    #modalAlertasBody .mal-kg-bar { height:5px; border-radius:3px; background:#e2e8f0; overflow:hidden; min-width:50px; }
    #modalAlertasBody .mal-kg-fill { height:100%; border-radius:3px; }
    #modalAlertasBody .mal-paso-dot { width:9px;height:9px;border-radius:50%;display:inline-block;flex-shrink:0; }
</style>
<script>
    const _alertasData = @Html.Raw(alertasJson);

    function abrirModalAlertas(nro) {
        const lista = nro === null ? _alertasData : _alertasData.filter(a => a.nro === nro);
        const titulo = nro === null ? 'Alertas del pedido' : `Alertas — Ítem ${nro}`;
        document.getElementById('modalAlertasTitulo').textContent = titulo;

        let html = '';
        if (!lista.length) {
            html = '<div class="text-muted p-3 text-center"><i class="bi bi-check-circle text-success me-2"></i>No hay alertas para este ítem.</div>';
        } else {
            html += `<table class="mal-tbl">
                <thead><tr>
                    <th style="width:22px;"></th>
                    <th style="width:32px;">Ítem</th>
                    <th>Tipo · Paso</th>
                    <th>Artículo</th>
                    <th>Vencimiento</th>
                    <th>KG pendientes</th>
                    <th>Detalle</th>
                    <th style="width:80px;">Sin resolver</th>
                </tr></thead><tbody>`;

            lista.forEach(a => {
                // nivel icon
                const nivelIcon = a.nivel === 'C'
                    ? '<i class="bi bi-exclamation-octagon-fill text-danger"></i>'
                    : a.nivel === 'A'
                        ? '<i class="bi bi-exclamation-triangle-fill text-warning"></i>'
                        : '<i class="bi bi-info-circle-fill text-info"></i>';

                // tipo icon
                const tipIconMap = {
                    'RET1': 'bi-alarm-fill text-danger',
                    'RET2': 'bi-clock-history text-warning',
                    'SMP' : 'bi-calendar-x-fill text-warning',
                    'STN' : 'bi-arrow-right-square-fill text-primary',
                    'QCF' : 'bi-x-circle-fill text-danger'
                };
                const tipIcon = `<i class="bi ${tipIconMap[a.tipAlerta] ?? 'bi-bell-fill text-secondary'} me-1"></i>`;

                // tipo + paso
                let tipoCel = `<div>${tipIcon}<strong>${a.tipo}</strong>`;
                if (a.diasRetraso > 0) tipoCel += ` <span class="badge bg-danger" style="font-size:.6rem;">+${a.diasRetraso} d</span>`;
                if (a.urgente) tipoCel += ` <i class="bi bi-fire text-warning ms-1" title="Urgente"></i>`;
                tipoCel += '</div>';
                if (a.nombrePaso) {
                    const dot = a.colorPaso ? `<span class="mal-paso-dot me-1" style="background:${a.colorPaso};"></span>` : '';
                    tipoCel += `<div class="d-flex align-items-center mt-1" style="font-size:.7rem;color:#718096;">${dot}${a.nombrePaso}`;
                    if ((a.nroCiclo ?? 1) > 1) tipoCel += ` <span class="badge bg-danger ms-1" style="font-size:.58rem;">Ciclo ${a.nroCiclo}</span>`;
                    tipoCel += '</div>';
                }

                // artículo
                let artCel = '';
                if (a.nro) artCel += `<div class="fw-semibold" style="font-size:.78rem;">Ítem ${a.nro}</div>`;
                if (a.tituloArt) artCel += `<span class="badge bg-light text-dark border" style="font-size:.65rem;">Nm ${a.tituloArt}</span> `;
                if (a.procesoTxt) artCel += `<span style="font-size:.7rem;color:#718096;">${a.procesoTxt}</span>`;

                // vencimiento
                let vencCel = '—';
                if (a.fchComp !== null) {
                    const d = a.diasComp;
                    const cls = d < 0 ? 'text-danger fw-bold' : d <= 3 ? 'text-warning fw-semibold' : '';
                    const badge = d < 0
                        ? `<span class="badge bg-danger" style="font-size:.6rem;">Vencido ${Math.abs(d)} d</span>`
                        : d === 0
                            ? `<span class="badge bg-warning text-dark" style="font-size:.6rem;">Hoy</span>`
                            : `<span style="font-size:.7rem;color:#718096;">en ${d} d</span>`;
                    vencCel = `<div class="${cls}" style="font-size:.78rem;">${a.fchComp}</div><div>${badge}</div>`;
                }

                // KG
                let kgCel = '—';
                if (a.kgPend !== null && a.cantOrig > 0) {
                    const pct  = a.kgPct ?? 0;
                    const col  = pct > 80 ? '#dc3545' : pct > 40 ? '#ffc107' : '#198754';
                    kgCel = `<div><span class="fw-semibold">${a.kgPend.toFixed(1)}</span> <small class="text-muted">/ ${a.cantOrig.toFixed(0)} kg</small></div>`
                          + `<div class="mal-kg-bar mt-1"><div class="mal-kg-fill" style="width:${pct}%;background:${col};"></div></div>`;
                }

                // detalle
                const detalleStr = (a.detalle?.length ? a.detalle : a.titulo) ?? '';
                const detalleCel = `<span class="text-muted" title="${detalleStr}" style="font-size:.75rem;display:block;max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${detalleStr}</span>`;

                // tiempo sin resolver
                let sinResCel = '—';
                if (a.horas !== null) {
                    const d2 = Math.floor(a.horas / 24), hr = a.horas % 24;
                    const cls2 = a.horas >= 48 ? 'text-danger fw-bold' : a.horas >= 24 ? 'text-warning fw-semibold' : 'text-muted';
                    sinResCel = `<span class="${cls2}" title="${a.horas}h sin resolver">${d2 > 0 ? d2 + '<small>d</small> ' + hr + '<small>h</small>' : a.horas + '<small>h</small>'}</span>`;
                }

                html += `<tr class="tip-${a.tipAlerta}">
                    <td>${nivelIcon}</td>
                    <td class="text-center">${a.nro ? `<span class="badge bg-dark" style="font-size:.62rem;">${a.nro}</span>` : ''}</td>
                    <td>${tipoCel}</td>
                    <td>${artCel || '—'}</td>
                    <td>${vencCel}</td>
                    <td>${kgCel}</td>
                    <td>${detalleCel}</td>
                    <td>${sinResCel}</td>
                </tr>`;
            });

            html += '</tbody></table>';
        }
        document.getElementById('modalAlertasBody').innerHTML = html;
        new bootstrap.Modal(document.getElementById('modalAlertasPedido')).show();
    }
</script>
<script>
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el =>
        new bootstrap.Tooltip(el, { placement: 'top' }));

    // Carga descripción + material de artículos sin cambiar el modelo
    (async function () {
        const cards = document.querySelectorAll('[data-codartt]');
        const unique = [...new Set([...cards].map(c => c.dataset.codartt).filter(Boolean))];
        for (const cod of unique) {
            try {
                const res  = await fetch(`/Planeamiento/GetArticuloInfo?codArt=${encodeURIComponent(cod)}`);
                if (!res.ok) continue;
                const info = await res.json();
                const parts = [info.descripcion, info.fibra].filter(x => x);
                if (!parts.length) continue;
                const text = parts.join(' · ');
                document.querySelectorAll(`[data-codartt="${CSS.escape(cod)}"] .art-desc-info`)
                        .forEach(el => el.textContent = text);
            } catch { /* silencioso */ }
        }
    })();

    // Estado en tiempo real de maquinas TT
    (async function () {
        const maqs = [...new Set([...document.querySelectorAll('[data-maq]')].map(el => el.dataset.maq).filter(Boolean))];
        for (const cod of maqs) {
            try {
                const res = await fetch(`/Planeamiento/GetMaquinaStatus?codMaq=${encodeURIComponent(cod)}`);
                if (!res.ok) continue;
                const info = await res.json();
                document.querySelectorAll(`[data-maq="${CSS.escape(cod)}"]`).forEach(el => {
                    if (!el.classList.contains('maq-box')) return;
                    const liveDiv   = el.querySelector('.maq-live');
                    const txt       = el.querySelector('.live-txt');
                    const cargaFill = el.querySelector('.maq-carga-fill');
                    const cargaPct  = el.querySelector('.maq-carga-pct');
                    const cerrado   = el.dataset.cerrado === 'true';
                    if (!liveDiv) return;
                    liveDiv.classList.remove('loading');
                    if (info.esLibre) {
                        liveDiv.classList.add('libre');
                        if (txt) txt.textContent = 'Disponible — sin actividad ahora';
                    } else {
                        liveDiv.classList.add('ocupada');
                        const n     = info.banosActivos;
                        const propio = el.dataset.propio === 'true';
                        if (txt) txt.textContent = (cerrado || !propio)
                            ? `En uso por otro lote · ${n} baño${n !== 1 ? 's' : ''} activo${n !== 1 ? 's' : ''}`
                            : `Ocupada · ${n} baño${n !== 1 ? 's' : ''} en proceso`;
                    }
                    // Barra de carga — siempre actualizar
                    if (cargaPct) {
                        if (info.hayCargaHoy) {
                            const pct  = Math.min(100, Math.max(0, info.pctCargaHoy));
                            const dias = info.diasAntiguo;
                            const lbl  = el.querySelector('.maq-carga-lbl');
                            if (lbl) lbl.textContent = dias === 0 ? 'Hoy:' : dias === 1 ? 'Ayer:' : `Hace ${dias}d:`;
                            if (cargaFill) {
                                cargaFill.style.width = pct + '%';
                                cargaFill.classList.toggle('alta',         pct >= 60 && pct < 90);
                                cargaFill.classList.toggle('sobrecargada', pct >= 90);
                            }
                            cargaPct.textContent = pct.toFixed(0) + '%';
                        } else if (info.banosActivos > 0) {
                            // Sin datos en PLN_CARGA_DIARIA → barra estimada por baños activos
                            const n       = info.banosActivos;
                            const estimado = Math.min(100, n * 40);   // 1 baño≈40%, 2≈80%, 3+=100%
                            const lbl = el.querySelector('.maq-carga-lbl');
                            if (lbl) lbl.textContent = 'En uso:';
                            if (cargaFill) {
                                cargaFill.style.width = estimado + '%';
                                cargaFill.classList.toggle('alta',         estimado >= 60 && estimado < 90);
                                cargaFill.classList.toggle('sobrecargada', estimado >= 90);
                            }
                            cargaPct.textContent = `~${estimado}%`;
                        } else {
                            cargaPct.textContent = 'Sin actividad';
                        }
                    }
                });
            } catch { /* silencioso */ }
        }
    })();
</script>
}
