@{
    ViewData["Title"] = "Consulta de Horas Autorizadas";

    var hoy    = DateTime.Today;
    var diff   = (int)hoy.DayOfWeek - 1;
    if (diff < 0) diff = 6;
    var lunes   = hoy.AddDays(-diff);
    var domingo = lunes.AddDays(6);
    var fDesde  = lunes.ToString("yyyy-MM-dd");
    var fHasta  = domingo.ToString("yyyy-MM-dd");
}

@section Styles {
<style>
    :root {
        --aq:       #C0622B;
        --aq-dk:    #9E4D20;
        --aq-lt:    #FEF3EB;
        --aq-mid:   #F5D5BC;
        --aq-ok:    #4E7E58;
        --aq-ok-lt: #EAF4EC;
        --aq-warn:  #B8772C;
        --aq-wlt:   #FEF5E3;
        --aq-err:   #AE3F3C;
        --aq-elt:   #FDECEA;
        --aq-info:  #7A6E9E;
        --aq-ilt:   #F2EDF7;
    }

    .badge-sin-he     { background: #e9ecef;          color: #6c757d; }
    .badge-pendiente  { background: var(--aq-wlt);    color: var(--aq-warn); }
    .badge-parcial    { background: var(--aq-ilt);    color: var(--aq-info); }
    .badge-completo   { background: var(--aq-ok-lt);  color: var(--aq-ok);   }

    .resumen-table th { white-space: nowrap; font-size: .78rem; }
    .resumen-table td { font-size: .82rem; vertical-align: middle; }
    .resumen-table td, .resumen-table th { padding: .22rem .4rem; }
    .resumen-table .col-sep { border-left: 2px solid rgba(0,0,0,.12) !important; }

    .form-control:focus, .form-select:focus {
        border-color: var(--aq);
        box-shadow: 0 0 0 .2rem rgba(192,98,43,.15);
    }

    .bar-wrap { display: flex; align-items: center; gap: 6px; min-width: 120px; }
    .bar-bg   { flex: 1; height: 8px; border-radius: 4px; background: #e9ecef; overflow: hidden; }
    .bar-fill { height: 100%; border-radius: 4px; background: var(--aq-ok); }

    .aq-modal-header { background: var(--aq);    color: #fff; }
    .aq-modal-err    { background: var(--aq-err);color: #fff; }

    .btn-filter-estado {
        font-size: .85rem;
        padding: .35rem .6rem;
        border: 1px solid #dee2e6;
        background: #fff;
        color: #6c757d;
        cursor: pointer;
        transition: all .2s ease;
    }
    .btn-filter-estado:hover {
        background: #f8f9fa;
        border-color: var(--aq);
    }
    .btn-filter-estado.active {
        background: var(--aq);
        color: #fff;
        border-color: var(--aq);
    }

    .fila-visada { background: rgba(78,126,88,0.06) !important; }
</style>
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a href="/RecursosHumanos">Recursos Humanos</a></li>
    <li class="breadcrumb-item"><a href="/RecursosHumanos/Aquarius/AuthHoras/Dashboard">Aquarius</a></li>
    <li class="breadcrumb-item active">Consulta de Horas</li>
}

<div class="d-flex justify-content-between align-items-center mb-1">
    <h4 class="section-title mb-0">
        <i class="bi bi-bar-chart-line me-2"></i>Consulta de Horas Autorizadas / Pendientes
    </h4>
    <div class="d-flex align-items-center gap-2">
        <span class="badge fs-6" style="background:var(--aq)" id="lblNomUsuario">Cargando…</span>
        <a href="/RecursosHumanos/Aquarius/AuthHoras/Dashboard" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
        <form method="post" action="/RecursosHumanos/Aquarius/AuthHoras/Logout" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-box-arrow-right me-1"></i>Cerrar sesión
            </button>
        </form>
    </div>
</div>
<hr class="mt-1 mb-3" />

<!-- FILTROS -->
<div class="row g-2 mb-3 align-items-end">
    <div class="col-auto" id="divEmpresa" style="display:none">
        <label class="form-label fw-semibold mb-1">Empresa</label>
        <select id="selEmpresa" class="form-select form-select-sm" style="min-width:140px"></select>
    </div>
    <div class="col-auto" id="divSupervisor" style="display:none">
        <label class="form-label fw-semibold mb-1">Supervisor</label>
        <select id="selSupervisor" class="form-select form-select-sm" style="min-width:200px">
            <option value="">— Todos —</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label fw-semibold mb-1">Período</label>
        <div class="input-group input-group-sm">
            <input type="date" id="dtDesde" class="form-control" value="@fDesde" />
            <span class="input-group-text">—</span>
            <input type="date" id="dtHasta" class="form-control" value="@fHasta" />
        </div>
    </div>
    <div class="col-auto">
        <button id="btnBuscar" class="btn btn-sm text-white" style="background:var(--aq);border-color:var(--aq);">
            <i class="bi bi-search me-1"></i>Consultar
        </button>
    </div>
    <div class="col-auto d-flex gap-1">
        <select id="selGranCCosto" class="form-select form-select-sm" style="font-size:.78rem">
            <option value="">Gran Centro de Costo</option>
        </select>
        <select id="selCCosto" class="form-select form-select-sm" style="font-size:.78rem">
            <option value="">Centro de Costos</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label fw-semibold mb-1">Estado</label>
        <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn-filter-estado active" data-estado="todos" title="Mostrar todos">
                Todos
            </button>
            <button type="button" class="btn-filter-estado" data-estado="PARCIAL" title="Parcialmente autorizados">
                Parcial
            </button>
            <button type="button" class="btn-filter-estado" data-estado="COMPLETO" title="Completamente autorizados">
                Completo
            </button>
        </div>
    </div>
    <div class="col-auto" id="divBtnVisado" style="display:none">
        <button id="btnGuardarVisado" class="btn btn-sm btn-outline-success" disabled>
            <i class="bi bi-check2-all me-1"></i>Guardar Visado
        </button>
    </div>
    <div class="col-auto ms-auto">
        <input type="search" id="inpFiltro" class="form-control form-control-sm"
               placeholder="Filtrar por nombre o fotocheck…" style="min-width:220px" />
    </div>
</div>

<!-- TARJETAS RESUMEN -->
<div class="row g-3 mb-3" id="divKpis" style="display:none">
    <div class="col-6 col-md-3">
        <div class="card border-0 text-center py-2 px-1" style="background:var(--aq-lt)">
            <div class="fs-3 fw-bold" id="kpiTotal" style="color:var(--aq)">0</div>
            <div class="small text-muted">Empleados con HE</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 text-center py-2 px-1" style="background:var(--aq-wlt)">
            <div class="fs-3 fw-bold" id="kpiPendiente" style="color:var(--aq-warn)">0</div>
            <div class="small text-muted">Con días pendientes</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 text-center py-2 px-1" style="background:var(--aq-ilt)">
            <div class="fs-3 fw-bold" id="kpiParcial" style="color:var(--aq-info)">0</div>
            <div class="small text-muted">Parcialmente autorizados</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 text-center py-2 px-1" style="background:var(--aq-ok-lt)">
            <div class="fs-3 fw-bold" id="kpiCompleto" style="color:var(--aq-ok)">0</div>
            <div class="small text-muted">Completamente autorizados</div>
        </div>
    </div>
</div>

<!-- TABLA -->
<div class="card">
    <div class="card-body p-0" style="overflow-x:auto">
        <table class="table table-sm resumen-table mb-0" id="tblResumen">
            <thead class="table-light sticky-top">
                <tr>
                    <th class="text-center" style="width:32px;min-width:32px" title="Estado visado"><i class="bi bi-patch-check" style="font-size:.9rem;color:var(--aq-ok)"></i></th>
                    <th>Fotocheck</th>
                    <th>Empleado</th>
                    <th>Centro Costo</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center">Días HE</th>
                    <th class="text-center" style="color:var(--aq-warn)">Pendientes</th>
                    <th class="text-center" style="color:var(--aq-ok)">Autorizados</th>
                    <th class="text-center col-sep" style="background:var(--aq-lt);color:var(--aq)">
                        HE Simples<br/><span class="fw-normal" style="font-size:.7rem">Horas</span>
                    </th>
                    <th class="text-center" style="background:var(--aq-lt);color:var(--aq-dk)">
                        HE Simples<br/><span class="fw-normal" style="font-size:.7rem">Aut.</span>
                    </th>
                    <th class="text-center col-sep" style="background:var(--aq-mid);color:var(--aq-dk)">
                        HE Dobles<br/><span class="fw-normal" style="font-size:.7rem">Horas</span>
                    </th>
                    <th class="text-center" style="background:var(--aq-mid);color:var(--aq-dk)">
                        HE Dobles<br/><span class="fw-normal" style="font-size:.7rem">Aut.</span>
                    </th>
                    <th class="col-motivo-res">Motivo / Observación</th>
                    <th>% Autorizado</th>
                    <th id="thVisado" class="text-center" style="min-width:60px">Visado</th>
                </tr>
            </thead>
            <tbody id="tbodyResumen">
                <tr><td colspan="15" class="text-muted text-center p-4">Seleccione empresa, período y presione Consultar.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal resultado -->
<div class="modal fade" id="modalMsg" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" id="modalMsgHeader">
                <h5 class="modal-title" id="modalMsgTitulo">Aviso</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalMsgCuerpo"></div>
            <div class="modal-footer">
                <button class="btn text-white" style="background:var(--aq);border-color:var(--aq);" data-bs-dismiss="modal">Aceptar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
let sesion = {};
let _listaResumen = [];
let _estadoFiltro = 'todos';
let _filtroGranCCosto = '';
let _filtroCCosto     = '';

// ── Init ────────────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', async () => {
    await cargarSesion();
    document.getElementById('btnBuscar').addEventListener('click', buscar);
    document.getElementById('inpFiltro').addEventListener('input', function () {
        renderTabla(this.value.trim().toLowerCase());
    });

    // Filtro de estado
    document.querySelectorAll('.btn-filter-estado').forEach(btn => {
        btn.addEventListener('click', function () {
            document.querySelectorAll('.btn-filter-estado').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            _estadoFiltro = this.dataset.estado;
            renderTabla(document.getElementById('inpFiltro').value.trim().toLowerCase());
        });
    });

    document.getElementById('selGranCCosto').addEventListener('change', function () {
        _filtroGranCCosto = this.value;
        poblarFiltrosCCosto();   // recalcula opciones de Centro de Costos (cascada)
        renderTabla(document.getElementById('inpFiltro').value.trim().toLowerCase());
    });
    document.getElementById('selCCosto').addEventListener('change', function () {
        _filtroCCosto = this.value;
        renderTabla(document.getElementById('inpFiltro').value.trim().toLowerCase());
    });
});

async function cargarSesion() {
    const r = await fetch('/RecursosHumanos/Aquarius/AuthHoras/SesionInfo', { cache: 'no-store' });
    if (!r.ok) { window.location = '/RecursosHumanos/Aquarius/AuthHoras'; return; }
    sesion = await r.json();
    document.getElementById('lblNomUsuario').textContent = '👤 ' + (sesion.nomUsuario || sesion.codUsuario);

    if (sesion.esAdmin === 'S') {
        document.getElementById('divSupervisor').style.display = '';
    }
    
    // Mostrar columna y botón de visado para todos los supervisores autenticados
    document.getElementById('divBtnVisado').style.display = '';
    document.getElementById('thVisado').style.display = '';
    document.getElementById('btnGuardarVisado').addEventListener('click', guardarVisado);

    if (sesion.cntEmpresas == 1 && sesion.codEmpresa) {
        document.getElementById('divEmpresa').style.display = 'none';
        if (sesion.esAdmin === 'S') await cargarSupervisores();
    } else {
        document.getElementById('divEmpresa').style.display = '';
        cargarEmpresas();
        document.getElementById('selEmpresa').addEventListener('change', async () => {
            if (sesion.esAdmin === 'S') await cargarSupervisores();
        });
        if (sesion.esAdmin === 'S') await cargarSupervisores();
    }
}

function cargarEmpresas() {
    const empresas = [
        { cod: '0001', des: 'La Colonial' },
        { cod: '0002', des: 'Arbona' },
        { cod: '0003', des: 'Solsa' },
    ];
    const sel = document.getElementById('selEmpresa');
    sel.innerHTML = empresas.map(e => `<option value="${e.cod}">${e.des}</option>`).join('');

    if (sesion.codEmpresaSistema) {
        sel.value    = sesion.codEmpresaSistema;
        sel.disabled = true;
    }
}

async function cargarSupervisores() {
    const empresa = getEmpresa();
    if (!empresa) return;
    const r = await fetch(`/RecursosHumanos/Aquarius/AuthHoras/Supervisores?empresa=${empresa}`, { cache: 'no-store' });
    if (!r.ok) return;
    const lista = await r.json();
    const sel = document.getElementById('selSupervisor');
    sel.innerHTML = '<option value="">— Todos —</option>' +
        lista.map(s => `<option value="${s.codUsuario}">${s.nomUsuario}</option>`).join('');
}

// ── Consultar ────────────────────────────────────────────────────────────────
async function buscar() {
    const empresa = getEmpresa();
    if (!empresa) { mostrarMsg(false, 'Seleccione una empresa.'); return; }

    const desde = formatFecha(document.getElementById('dtDesde').value);
    const hasta = formatFecha(document.getElementById('dtHasta').value);
    if (!desde || !hasta) { mostrarMsg(false, 'Ingrese el período.'); return; }

    const supervisor = document.getElementById('selSupervisor')?.value ?? '';

    let url = `/RecursosHumanos/Aquarius/AuthHoras/ResumenHe?empresa=${empresa}&desde=${desde}&hasta=${hasta}`;
    if (supervisor) url += `&supervisor=${supervisor}`;

    const btn = document.getElementById('btnBuscar');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Consultando…';

    const r = await fetch(url, { cache: 'no-store' });
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-search me-1"></i>Consultar';

    if (!r.ok) { mostrarMsg(false, 'Error al obtener datos.'); return; }
    _listaResumen = await r.json();

    // Reinicia filtros de Gran Centro de Costo / Centro de Costos y recalcula
    // sus opciones a partir de la nueva data (se trae todo por fecha primero).
    _filtroGranCCosto = '';
    _filtroCCosto     = '';
    document.getElementById('selGranCCosto').value = '';
    document.getElementById('selCCosto').value     = '';
    poblarFiltrosCCosto();

    actualizarKpis();
    renderTabla(document.getElementById('inpFiltro').value.trim().toLowerCase());
}

function actualizarKpis() {
    const conHe     = _listaResumen.filter(e => e.estado !== 'SIN_HE');
    const pendiente = _listaResumen.filter(e => e.estado === 'PENDIENTE');
    const parcial   = _listaResumen.filter(e => e.estado === 'PARCIAL');
    const completo  = _listaResumen.filter(e => e.estado === 'COMPLETO');

    document.getElementById('kpiTotal').textContent    = conHe.length;
    document.getElementById('kpiPendiente').textContent = pendiente.length;
    document.getElementById('kpiParcial').textContent  = parcial.length;
    document.getElementById('kpiCompleto').textContent = completo.length;
    document.getElementById('divKpis').style.display   = '';
    // Habilitar botón guardar visado cuando hay datos
    document.getElementById('btnGuardarVisado').disabled = _listaResumen.length === 0;
}

// ─── Filtros: Gran Centro de Costo / Centro de Costos ──────────────────────
// Puebla ambos <select> a partir de _listaResumen. El de Centro de Costos
// se acota (cascada) según el Gran Centro de Costo seleccionado, si hay uno.
function poblarFiltrosCCosto() {
    const selGran   = document.getElementById('selGranCCosto');
    const selCCosto = document.getElementById('selCCosto');

    // Gran Centro de Costo: valores únicos de toda la lista
    const granMap = new Map();
    _listaResumen.forEach(e => {
        if (e.granCCosto) granMap.set(e.granCCosto, e.granCCostoNombre || e.granCCosto);
    });
    const granValorPrevio = selGran.value;
    selGran.innerHTML = '<option value="">Gran Centro de Costo</option>' +
        [...granMap.entries()]
            .sort((a, b) => a[1].localeCompare(b[1], 'es'))
            .map(([cod, des]) => '<option value="' + cod + '">' + des + '</option>').join('');
    if ([...granMap.keys()].includes(granValorPrevio)) selGran.value = granValorPrevio;
    else _filtroGranCCosto = '';

    // Centro de Costos: acotado por el Gran Centro de Costo activo (si hay)
    const ccostoMap = new Map();
    _listaResumen
        .filter(e => !_filtroGranCCosto || (e.granCCosto || '') === _filtroGranCCosto)
        .forEach(e => {
            if (e.codCCostos) ccostoMap.set(e.codCCostos, e.desCCostos || e.codCCostos);
        });
    const ccostoValorPrevio = selCCosto.value;
    selCCosto.innerHTML = '<option value="">Centro de Costos</option>' +
        [...ccostoMap.entries()]
            .sort((a, b) => a[1].localeCompare(b[1], 'es'))
            .map(([cod, des]) => '<option value="' + cod + '">' + des + '</option>').join('');
    if ([...ccostoMap.keys()].includes(ccostoValorPrevio)) selCCosto.value = ccostoValorPrevio;
    else _filtroCCosto = '';
}

function renderTabla(filtro = '') {
    const tbody = document.getElementById('tbodyResumen');
    let lista = _listaResumen.slice();

    // Aplicar filtro de estado
    if (_estadoFiltro !== 'todos') {
        lista = lista.filter(e => e.estado === _estadoFiltro);
    }

    // Aplicar filtro de Gran Centro de Costo / Centro de Costos
    if (_filtroGranCCosto) {
        lista = lista.filter(e => (e.granCCosto || '') === _filtroGranCCosto);
    }
    if (_filtroCCosto) {
        lista = lista.filter(e => (e.codCCostos || '') === _filtroCCosto);
    }

    // Aplicar filtro de búsqueda
    if (filtro) {
        lista = lista.filter(e =>
            (e.nombreCompleto || '').toLowerCase().includes(filtro) ||
            (e.numFotocheck   || '').toLowerCase().includes(filtro)
        );
    }

    if (!lista.length) {
        const nCols = 15;  // 15 columnas (indicador visado + fotocheck + ... + visado)
        tbody.innerHTML = `<tr><td colspan="${nCols}" class="text-muted text-center p-4">Sin resultados${filtro ? ' para "' + filtro + '"' : ''}.</td></tr>`;
        return;
    }

    tbody.innerHTML = lista.map(e => {
        const badgeEstado = estadoBadge(e.estado);
        const pct         = e.diasConHe > 0 ? Math.min(100, Math.round(e.diasAutorizados / e.diasConHe * 100)) : 0;
        const barFill     = `<div class="bar-wrap"><div class="bar-bg"><div class="bar-fill" style="width:${pct}%"></div></div><span style="font-size:.75rem">${pct}%</span></div>`;

        // Campo único de observación
        const motivoFila = e.obs
            ? `<span style="font-size:.78rem;word-break:break-word;">${escapeHtml(limpiarPrefijosObs(e.obs))}</span>`
            : '<span class="text-muted">—</span>';

        // Checkbox de visado (todos los supervisores, solo COMPLETO o PARCIAL)
        const puedeVisar = (e.estado === 'COMPLETO' || e.estado === 'PARCIAL');
        const isVisado   = e.indVisado !== 'N';   // null o 'S' = checked por defecto
        const tooltipVis = e.fecVisado
            ? `Visado el ${escapeHtml(e.fecVisado)}${e.codUsuVisado ? ' por ' + escapeHtml(e.codUsuVisado) : ''}`
            : (e.indVisado === 'N' ? 'Visado como No aprobado' : 'Sin visar aún');
        let chkVisadoHtml;
        if (puedeVisar) {
            chkVisadoHtml = `<input type="checkbox" class="form-check-input chk-visado"
                style="width:1.2em;height:1.2em;cursor:pointer"
                data-personal="${e.codPersonal}"
                title="${tooltipVis}"
                ${isVisado ? 'checked' : ''}>`;
        } else {
            chkVisadoHtml = '<span class="text-muted" style="font-size:.8rem">—</span>';
        }

        const indV           = (e.indVisado || '').trim();
        const tieneRegistro  = indV === 'S' || indV === 'N';
        const iconoVisado    = puedeVisar && tieneRegistro
            ? `<i class="bi bi-check-circle-fill" style="color:var(--aq-ok);font-size:1rem" title="${tooltipVis}"></i>`
            : '';
        return `<tr class="${tieneRegistro ? 'fila-visada' : ''}">
            <td class="text-center">${iconoVisado}</td>
            <td><span style="color:var(--aq-dk);font-weight:600">${e.numFotocheck || '—'}</span></td>
            <td>${e.nombreCompleto}</td>
            <td><small class="text-muted">${e.desCCostos || e.codCCostos}</small></td>
            <td class="text-center">${badgeEstado}</td>
            <td class="text-center">${e.diasConHe}</td>
            <td class="text-center">${e.diasPendientes > 0 ? `<span class="badge badge-pendiente">${e.diasPendientes}</span>` : '—'}</td>
            <td class="text-center">${e.diasAutorizados > 0 ? `<span class="badge badge-completo">${e.diasAutorizados}</span>` : '—'}</td>
            <td class="text-center col-sep">${fmtMin(e.minHed)}</td>
            <td class="text-center">${fmtMin(e.minHedAut)}</td>
            <td class="text-center col-sep">${fmtMin(e.minHeo)}</td>
            <td class="text-center">${fmtMin(e.minHeoAut)}</td>
            <td>${motivoFila}</td>
            <td>${barFill}</td>
            <td class="text-center">${chkVisadoHtml}</td>
        </tr>`;
    }).join('');
}

// ── Helpers ──────────────────────────────────────────────────────────────────
function estadoBadge(estado) {
    switch (estado) {
        case 'PENDIENTE': return '<span class="badge badge-pendiente">Pendiente</span>';
        case 'PARCIAL':   return '<span class="badge badge-parcial">Parcial</span>';
        case 'COMPLETO':  return '<span class="badge badge-completo">Completo</span>';
        default:          return '<span class="badge badge-sin-he">Sin HE</span>';
    }
}

function fmtMin(min) {
    if (!min || min === 0) return '<span class="text-muted">—</span>';
    const h = Math.floor(min / 60);
    const m = String(min % 60).padStart(2, '0');
    return `${h}:${m}`;
}

function getEmpresa() {
    if (sesion.cntEmpresas == 1) return sesion.codEmpresa;
    return document.getElementById('selEmpresa')?.value ?? '';
}

function formatFecha(iso) {
    if (!iso) return '';
    const [y, m, d] = iso.split('-');
    return `${d}/${m}/${y}`;
}

function mostrarMsg(ok, msg) {
    const h = document.getElementById('modalMsgHeader');
    h.className = 'modal-header ' + (ok ? '' : 'aq-modal-err');
    document.getElementById('modalMsgTitulo').textContent = ok ? 'Información' : 'Error';
    document.getElementById('modalMsgCuerpo').textContent = msg;
    new bootstrap.Modal(document.getElementById('modalMsg')).show();
}

async function guardarVisado() {
    const empresa = getEmpresa();
    const desde   = formatFecha(document.getElementById('dtDesde').value);
    const hasta   = formatFecha(document.getElementById('dtHasta').value);
    if (!empresa || !desde || !hasta) { mostrarMsg(false, 'Seleccione empresa y período.'); return; }

    const checkboxes = document.querySelectorAll('.chk-visado');
    if (!checkboxes.length) { mostrarMsg(false, 'No hay empleados para visar.'); return; }

    const visados = Array.from(checkboxes).map(chk => ({
        codPersonal: chk.dataset.personal,
        indVisado:   chk.checked ? 'S' : 'N',
        obsVisado:   null
    }));

    const btn = document.getElementById('btnGuardarVisado');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando…';
    try {
        const token = document.querySelector('[name="__RequestVerificationToken"]')?.value ?? '';
        const r = await fetch('/RecursosHumanos/Aquarius/AuthHoras/GrabarVisado', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body:    JSON.stringify({ codEmpresa: empresa, desde, hasta, visados })
        });
        if (!r.ok) { mostrarMsg(false, 'Error al guardar el visado.'); return; }
        const result = await r.json();
        if (result.ok) {
            mostrarMsg(true, `Visado guardado: ${result.guardados} empleado(s).`);
            buscar();   // recargar para reflejar estado
        } else {
            mostrarMsg(false, result.mensaje || 'Error al guardar.');
        }
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-check2-all me-1"></i>Guardar Visado';
    }
}

function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

function limpiarPrefijosObs(str) {
    return (str || '').replace(/^(\[[^\]]+\]\s*)+/, '').trim();
}
</script>
@Html.AntiForgeryToken()
}
