@model List<FabricaHilos.Models.Capacitacion.CapCurso>
@{
    ViewData["Title"] = "Administración de Capacitación";
    var categorias = ViewBag.Categorias as List<FabricaHilos.Models.Capacitacion.CapCategoria> ?? [];
}

@section Styles {
<style>
    .admin-kpi { border:none; box-shadow:0 2px 8px rgba(0,0,0,.08); }
</style>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-gear-fill text-primary me-2"></i>Administración · Capacitación</h2>
    <div class="d-flex gap-2">
        <a asp-controller="CapacitacionAdmin" asp-action="Reportes" class="btn btn-outline-secondary">
            <i class="bi bi-bar-chart me-1"></i>Reportes
        </a>
        <a asp-controller="CapacitacionAdmin" asp-action="CursoForm" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Nuevo Curso
        </a>
    </div>
</div>

<!-- KPIs -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card admin-kpi text-center p-3">
            <div class="h3 fw-bold text-primary">@Model.Count</div>
            <div class="text-muted small">Cursos publicados</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card admin-kpi text-center p-3">
            <div class="h3 fw-bold text-warning">@Model.Count(c => c.Obligatorio=="S")</div>
            <div class="text-muted small">Cursos obligatorios</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card admin-kpi text-center p-3">
            <div class="h3 fw-bold text-success">@categorias.Count</div>
            <div class="text-muted small">Categorías activas</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card admin-kpi text-center p-3">
            <div class="h3 fw-bold text-info">@Model.Sum(c => c.TotalLecciones)</div>
            <div class="text-muted small">Lecciones totales</div>
        </div>
    </div>
</div>

<!-- Tabla de cursos -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h6 class="mb-0 fw-semibold">Cursos</h6>
        <input class="form-control form-control-sm w-auto" placeholder="Buscar…" id="searchCursos">
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="tablaCursos">
            <thead class="table-light">
                <tr>
                    <th>Curso</th>
                    <th>Categoría</th>
                    <th>Nivel</th>
                    <th>Lecciones</th>
                    <th>Estado</th>
                    <th>Inscritos</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@c.Titulo</div>
                            @if (c.EsObligatorio)
                            {
                                <span class="badge bg-danger-subtle text-danger small">Obligatorio</span>
                            }
                        </td>
                        <td>
                            <span class="badge" style="background:@c.ColorCategoria">
                                <i class="bi @c.IconoCategoria me-1"></i>@c.NombreCategoria
                            </span>
                        </td>
                        <td>
                            <span class="badge @(c.Nivel=="B"?"bg-success":c.Nivel=="I"?"bg-warning text-dark":"bg-danger")">
                                @c.NivelTexto
                            </span>
                        </td>
                        <td>@c.TotalLecciones</td>
                        <td>
                            <span class="badge @(c.Estado=="A"?"bg-success":c.Estado=="I"?"bg-warning text-dark":"bg-secondary")">
                                @c.EstadoTexto
                            </span>
                        </td>
                        <td>—</td>
                        <td class="text-end">
                            <a asp-controller="CapacitacionAdmin" asp-action="CursoForm"
                               asp-route-id="@c.IdCurso"
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-controller="CapacitacionAdmin" asp-action="Reportes"
                               asp-route-idCurso="@c.IdCurso"
                               class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-people"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
document.getElementById('searchCursos').addEventListener('input', function() {
    const q = this.value.toLowerCase();
    document.querySelectorAll('#tablaCursos tbody tr').forEach(tr => {
        tr.style.display = tr.textContent.toLowerCase().includes(q) ? '' : 'none';
    });
});
</script>
}
