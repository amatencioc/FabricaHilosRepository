@model FabricaHilos.Controllers.Contabilidad.SireRegistrosViewModel
@using FabricaHilos.Sire.Models
@{
    ViewData["Title"] = "SIRE - RVIE (Registro de Ventas)";
    var periodos          = Model?.Periodos         ?? Array.Empty<PropuestaDto>();
    var periodoSeleccionado = Model?.PeriodoSeleccionado ?? string.Empty;
    var resumen           = Model?.PropuestasResumen  ?? new List<FabricaHilos.Models.Sire.PropuestaPeriodoResumen>();
    var propuesta           = Model?.RegistrosPropuesta ?? new List<FabricaHilos.Models.Sire.SireValidaRegistro>();
    var legacy              = Model?.RegistrosLegacy      ?? new List<FabricaHilos.Models.Sire.SireLegacyRegistro>();
    var concil              = Model?.RegistrosConcil      ?? new List<FabricaHilos.Models.Sire.SireConcilDetalle>();
    var esMock            = Model?.EsMock ?? false;
    var esStub            = Model?.EsStub ?? false;

    var yyyyMm = periodoSeleccionado.Length == 6
        ? $"{periodoSeleccionado[..4]}/{periodoSeleccionado[4..]}"
        : periodoSeleccionado;

    static (string Desc, string Css) TipoComprobante(string cod) => cod switch
    {
        "01" => ("Factura",    "sire-badge sire-badge-rvie"),
        "03" => ("Boleta",     "sire-badge sire-badge-info"),
        "07" => ("N/C",        "sire-badge sire-badge-warn"),
        "08" => ("N/D",        "sire-badge sire-badge-warn"),
        "14" => ("Servicio",   "sire-badge sire-badge-secondary"),
        "36" => ("Gas Nat.",   "sire-badge sire-badge-secondary"),
        "37" => ("Rev.Tec.",   "sire-badge sire-badge-secondary"),
        "40" => ("IVAP",       "sire-badge sire-badge-secondary"),
        "50" => ("DUA",        "sire-badge sire-badge-info"),
        "52" => ("Desp.Simp.", "sire-badge sire-badge-info"),
        "53" => ("Courier",    "sire-badge sire-badge-info"),
        "54" => ("Liq.Cobr.",  "sire-badge sire-badge-secondary"),
        _    => (cod,          "sire-badge sire-badge-secondary")
    };
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Contabilidad" asp-action="Index">Contabilidad</a></li>
    <li class="breadcrumb-item"><a asp-controller="Sire" asp-action="Index">SIRE</a></li>
    <li class="breadcrumb-item active">RVIE — Ventas</li>
}
@section Styles {
<link rel="stylesheet" href="~/css/sire.css" asp-append-version="true" />
<style>
    /* Tooltip ancho para campos de conciliación SIRE */
    .tooltip-sire .tooltip-inner { max-width: 320px; text-align: left; font-size: .76rem; line-height: 1.4; }
</style>
}

@* ── Alertas de sesión ─────────────────────────────────────────────────────── *@
@if (esMock)
{
    <div class="sire-alert sire-alert-mock"><i class="bi bi-cone-striped"></i><strong>MODO MOCK</strong> — Datos de prueba. No se realizan llamadas reales a SUNAT.</div>
}
@if (esStub)
{
    <div class="sire-alert sire-alert-stub"><i class="bi bi-exclamation-triangle-fill"></i><strong>MODO PRUEBA (STUB)</strong> — Las acciones <em>Aceptar Propuesta</em> y <em>Cerrar Período</em> simulan el envío a SUNAT sin hacer llamadas reales. Los datos Oracle y los registros locales sí se procesan.</div>
}

@await Html.PartialAsync("~/Views/Contabilidad/Sire/_SireNavBar.cshtml")

@if (TempData["Error"] is string errCarga)
{
    <div class="alert alert-danger alert-dismissible d-flex align-items-start gap-2 py-2 mb-2" role="alert" style="font-size:.82rem;">
        <i class="bi bi-database-exclamation fs-5 flex-shrink-0"></i>
        <div><strong>Error al cargar datos:</strong> @errCarga</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@* ── Cabecera strip
<div class="sire-strip">
    <i class="bi bi-receipt-cutoff" style="color:var(--sire-accent-blue);font-size:.9rem;flex-shrink:0;"></i>
    <span class="sire-strip-title">RVIE — Registro de Ventas e Ingresos</span>
    @if (!string.IsNullOrWhiteSpace(periodoSeleccionado) && propuesta.Count > 0)
    {
        <span class="sire-strip-sep"></span>
        <span class="sire-kpi"><i class="bi bi-calendar3"></i><span class="sire-kpi-val">@yyyyMm</span></span>
        <span class="sire-kpi"><i class="bi bi-file-earmark-text" style="color:var(--sire-accent-blue);"></i><span class="sire-kpi-val">@propuesta.Count.ToString("N0")</span><span style="opacity:.7">regs.</span></span>
        <span class="sire-kpi"><i class="bi bi-calculator" style="color:#fbd38d;"></i><span class="sire-kpi-val">S/ @propuesta.Sum(x => x.BiGravDg).ToString("N0")</span><span style="opacity:.7">base</span></span>
        <span class="sire-kpi"><i class="bi bi-percent" style="color:#76e4f7;"></i><span class="sire-kpi-val">S/ @propuesta.Sum(x => x.IgvIpmDg).ToString("N0")</span><span style="opacity:.7">IGV</span></span>
        <span class="sire-kpi" style="background:rgba(27,77,62,.4);border-color:rgba(27,77,62,.5);"><i class="bi bi-credit-card" style="color:#68d391;"></i><span class="sire-kpi-val">S/ @propuesta.Sum(x => x.TotalCp).ToString("N0")</span><span style="opacity:.7">total</span></span>
    }
</div>

@Html.AntiForgeryToken()

@* ── Toolbar ─────────────────────────────────────────────────────────────── *@
<div class="sire-filter">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-calendar3 small" style="color:var(--sire-gray-600);"></i>
        <span class="fw-semibold text-nowrap" style="font-size:.77rem;color:var(--sire-gray-700);">Período:</span>
        <select class="form-select form-select-sm" id="periodoSelect"
                style="width:220px;max-width:100%;" onchange="cambiarPeriodo()">
            <option value="">— seleccionar —</option>
            @foreach (var p in periodos)
            {
                <option value="@p.Periodo" selected="@(p.Periodo == periodoSeleccionado)">
                    @($"{p.Periodo[..4]}/{p.Periodo[4..]}"): @p.Descripcion
                </option>
            }
        </select>
        <button class="btn btn-sm btn-outline-secondary px-2" type="button" onclick="recargarPeriodo()" title="Recargar">
            <i class="bi bi-arrow-clockwise"></i>
        </button>
    </div>
    @if (!string.IsNullOrWhiteSpace(periodoSeleccionado))
    {
        <div class="vr d-none d-lg-block mx-1" style="opacity:.2;"></div>
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="iniciarExportacion('@periodoSeleccionado', 'ventas')">
                <i class="bi bi-cloud-download me-1"></i>Exportar Propuesta
            </button>
            @if (Model?.TieneZipLocal == true)
            {
                <button type="button" class="btn btn-sm btn-outline-warning" id="btnReprocesarVentas"
                        data-zip-nombre="@(Model?.NombreZipLocal ?? "")"
                        onclick="abrirModalReprocesar('@periodoSeleccionado', 'ventas', this.dataset.zipNombre)"
                        title="Re-parsear ZIP local sin contactar SUNAT">
                    <i class="bi bi-arrow-repeat me-1"></i>Re-procesar ZIP
                </button>
            }
        </div>
    }
</div>

@* ── Modales ──────────────────────────────────────────────────────────────── *@
<!-- Modal: Re-procesar ZIP local -->
<div class="modal fade" id="modalReprocesarZip" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px">
        <div class="modal-content border-0 shadow">
            <div class="modal-header sire-modal-header-rvie py-2">
                <h6 class="modal-title mb-0"><i class="bi bi-arrow-repeat me-2"></i>Re-procesar ZIP local</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="font-size:.86rem;">
                <p class="mb-2 text-muted">Se re-parsea el archivo local y se cargan los registros en Oracle <strong>sin contactar SUNAT</strong>.</p>
                <div class="d-flex align-items-start gap-2 p-2 rounded" style="background:var(--sire-gray-50);border:1px solid var(--sire-gray-200);">
                    <i class="bi bi-file-zip text-warning mt-1" style="font-size:1rem;flex-shrink:0;"></i>
                    <div>
                        <div class="sire-kpi-card-label">Archivo a procesar</div>
                        <div class="font-monospace fw-semibold text-break" id="modalReprocesarNombreZip" style="font-size:.78rem;color:var(--sire-rvie);"></div>
                    </div>
                </div>
                <p class="mt-2 mb-0" style="font-size:.77rem;color:var(--sire-gray-600);"><i class="bi bi-info-circle me-1"></i>Los registros anteriores del período serán reemplazados.</p>
            </div>
            <div class="modal-footer py-2 gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-sm btn-warning fw-semibold" id="btnConfirmarReprocesar">
                    <i class="bi bi-arrow-repeat me-1"></i>Sí, re-procesar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Progreso de Exportación -->
<div class="modal fade" id="modalExportacion" tabindex="-1" aria-labelledby="modalExportacionLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header sire-modal-header-rvie py-2">
                <h6 class="modal-title" id="modalExportacionLabel">
                    <i class="bi bi-cloud-download me-2"></i>Exportación RVIE
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div id="estadoExportacion">
                    <div class="text-center py-3">
                        <div class="spinner-border text-success mb-3" role="status"><span class="visually-hidden">Cargando...</span></div>
                        <p class="fw-semibold text-muted mb-0">Iniciando exportación…</p>
                    </div>
                </div>
                <div id="logsJobContainer" style="display:none;max-height:160px;overflow-y:auto;font-size:.78rem;border-top:1px solid var(--sire-gray-200);margin-top:.75rem;padding-top:.5rem"></div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" id="btnDescargarZip" class="btn btn-sm btn-success" style="display:none;"
                        onclick="descargarArchivoExportado('@periodoSeleccionado', 'ventas')">
                    <i class="bi bi-download me-1"></i>Descargar ZIP
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ===== OVERLAY GLOBAL DE CARGA ===== -->
<div id="sireOverlayGlobal" style="display:none;position:fixed;inset:0;z-index:9990;background:rgba(10,18,40,.60);backdrop-filter:blur(4px);align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:14px;padding:32px 40px 28px;box-shadow:0 24px 64px rgba(0,0,0,.35);text-align:center;min-width:320px;max-width:420px;width:92vw;">
        <div id="sireOvSpinnerWrap" style="margin:0 auto 18px;width:52px;height:52px;position:relative;">
            <svg viewBox="0 0 52 52" style="width:52px;height:52px;animation:sireGlobalSpin 1s linear infinite;">
                <circle cx="26" cy="26" r="22" fill="none" stroke="#e9ecef" stroke-width="5"/>
                <circle cx="26" cy="26" r="22" fill="none" stroke="#1565c0" stroke-width="5"
                        stroke-dasharray="80 60" stroke-linecap="round"/>
            </svg>
        </div>
        <div id="sireOverlayMensaje"    style="font-size:.95rem;font-weight:700;color:#1c3a5e;">Procesando...</div>
        <div id="sireOverlaySubMensaje" style="margin-top:4px;font-size:.78rem;color:#6b7280;"></div>
        <div id="sireOvMsg"             style="font-size:.88rem;font-weight:700;color:#1c3a5e;display:none;"></div>
        <div id="sireOvDetalle"         style="font-size:.73rem;color:#6c757d;margin-top:3px;display:none;line-height:1.35;"></div>
        <div id="sireOvBarraWrap"       style="display:none;margin-top:10px;height:7px;background:#e9ecef;border-radius:4px;overflow:hidden;">
            <div id="sireOvBarra"       style="height:100%;width:0%;background:#1565c0;transition:width .2s;border-radius:4px;"></div>
        </div>
        <div id="sireOvPct"             style="font-size:.68rem;color:#6c757d;margin-top:4px;display:none;"></div>
        <div style="margin-top:14px;font-size:.73rem;color:#9ca3af;">No cierre esta ventana. Puede minimizarla.</div>
    </div>
</div>
<style>@@keyframes sireGlobalSpin{to{transform:rotate(360deg)}}</style>

<!-- Modal: Confirmación genérica -->
<div class="modal fade" id="modalConfirmar" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <div class="modal-header py-2" style="background:var(--sire-navy);color:#fff;">
                <h6 class="modal-title" id="modalConfirmarTitulo"><i class="bi bi-question-circle me-1"></i>Confirmar acción</h6>
            </div>
            <div class="modal-body" id="modalConfirmarMensaje" style="font-size:.87rem;"></div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-sm btn-primary" id="btnConfirmarSi">Confirmar</button>
            </div>
        </div>
    </div>
</div>


@* ── Overlays de carga ─────────────────────────────────────────────────────────────────────── *@
<div id="overlayConciliar" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(10,20,40,.62);z-index:9100;align-items:center;justify-content:center;flex-direction:column;gap:1.2rem;">
    <div class="spinner-border text-light" style="width:3.2rem;height:3.2rem;" role="status"><span class="visually-hidden">Procesando...</span></div>
    <span class="text-white fw-semibold" style="font-size:1.05rem;letter-spacing:.03em;">Conciliando propuesta…</span>
    <span class="text-white-50" style="font-size:.82rem;">Por favor espere, esto puede tomar unos segundos.</span>
</div>

<div id="overlayReprocesar" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(10,20,40,.62);z-index:9100;align-items:center;justify-content:center;flex-direction:column;gap:1.2rem;">
    <div class="spinner-border text-light" style="width:3.2rem;height:3.2rem;" role="status"><span class="visually-hidden">Procesando...</span></div>
    <span class="text-white fw-semibold" style="font-size:1.05rem;letter-spacing:.03em;">Re-procesando archivo ZIP…</span>
    <span class="text-white-50" style="font-size:.82rem;">Por favor espere, los datos se están actualizando.</span>
</div>

@* ── Panel: Propuesta Descargada de SUNAT ─────────────────────────────────────────── *@
@if (resumen.Count > 0)
{
    <div class="sire-card mb-3">
        <div class="sire-card-header" style="padding:.35rem .75rem;">
            <i class="bi bi-database-fill-check" style="color:var(--sire-rvie);font-size:.82rem;"></i>
            <span style="font-size:.79rem;">Propuesta Descargada de SUNAT</span>
            <span class="ms-auto sire-badge sire-badge-rvie" style="font-size:.65rem;">@resumen.Count período(s)</span>
        </div>
        <div class="table-responsive">
            <table class="table sire-table table-hover align-middle mb-0" style="font-size:.78rem;">
                <thead>
                    <tr>
                        <th style="width:75px;padding:.3rem .5rem;">Período</th>
                        <th class="text-end" style="width:62px;padding:.3rem .5rem;">Regs.</th>
                        <th class="text-end d-none d-md-table-cell" style="padding:.3rem .5rem;">Base</th>
                        <th class="text-end d-none d-md-table-cell" style="padding:.3rem .5rem;">IGV</th>
                        <th class="text-end" style="padding:.3rem .5rem;">Total</th>
                        <th class="text-center" style="width:76px;padding:.3rem .5rem;">Concil.</th>
                        <th class="text-center d-none d-lg-table-cell" style="width:86px;padding:.3rem .5rem;">Cargado</th>
                        <th style="width:100px;padding:.3rem .5rem;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in resumen)
                    {
                        var esSel = r.Periodo.ToString() == periodoSeleccionado;
                        <tr @(esSel ? "style=background:var(--sire-rvie-pale);" : "")>
                            <td style="padding:.3rem .5rem;">
                                <a href="@Url.Action("Ventas")?periodo=@r.Periodo"
                                   class="text-decoration-none fw-semibold"
                                   style="color:@(esSel ? "var(--sire-rvie)" : "var(--sire-navy)");">
                                    @r.PeriodoLabel
                                </a>
                            </td>
                            <td class="text-end font-monospace" style="padding:.3rem .5rem;">@r.TotalRegistros.ToString("N0")</td>
                            <td class="text-end d-none d-md-table-cell" style="padding:.3rem .5rem;">@r.TotalBase.ToString("N2")</td>
                            <td class="text-end d-none d-md-table-cell" style="padding:.3rem .5rem;">@r.TotalIgv.ToString("N2")</td>
                            <td class="text-end fw-semibold" style="color:var(--sire-rvie);padding:.3rem .5rem;">S/ @r.TotalImporte.ToString("N2")</td>
                            <td class="text-center" style="padding:.3rem .5rem;">
                                <span class="badge @r.ConcilBadgeCss" style="font-size:.6rem;">@r.ConcilLabel</span>
                            </td>
                            <td class="text-center text-muted d-none d-lg-table-cell" style="font-size:.72rem;padding:.3rem .5rem;">
                                @(r.FchCarga?.ToString("dd/MM HH:mm") ?? "—")
                            </td>
                            <td class="text-center" style="padding:.25rem .4rem;">
                                <div class="d-flex gap-1 justify-content-center">
                                    <form method="post" asp-action="ConciliarPropuesta" id="frmConcil_@r.Periodo" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="tipo"    value="ventas" />
                                        <input type="hidden" name="periodo" value="@r.Periodo" />
                                        <button type="button" class="btn btn-xs btn-outline-primary"
                                                onclick="confirmarConciliar(@r.Periodo, '@r.PeriodoLabel')"
                                                title="Conciliar contra ERP">
                                            <i class="bi bi-arrow-left-right"></i>
                                        </button>
                                    </form>
                                    @if (r.ConcilEstado != "0")
                                    {
                                        <form method="post" asp-action="AceptarPropuesta" id="frmAceptar_@r.Periodo" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="tipo"    value="ventas" />
                                            <input type="hidden" name="periodo" value="@r.Periodo" />
                                            <button type="button" class="btn btn-xs btn-outline-success"
                                                    onclick="confirmarAceptar(@r.Periodo, '@r.PeriodoLabel')"
                                                    title="Aceptar propuesta en SUNAT">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                        </form>
                                        <form method="post" asp-action="CerrarPeriodo" id="frmCerrar_@r.Periodo" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="tipo"    value="ventas" />
                                            <input type="hidden" name="periodo" value="@r.Periodo" />
                                            <button type="button" class="btn btn-xs btn-outline-danger"
                                                    onclick="confirmarCerrar(@r.Periodo, '@r.PeriodoLabel')"
                                                    title="Cerrar período (preliminar) — irreversible">
                                                <i class="bi bi-lock"></i>
                                            </button>
                                        </form>
                                    }
                                    <form method="post" asp-action="EliminarPropuesta" id="frmElim_@r.Periodo" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="tipo"    value="ventas" />
                                        <input type="hidden" name="periodo" value="@r.Periodo" />
                                        <button type="button" class="btn btn-xs btn-outline-danger"
                                                onclick="confirmarEliminar(@r.Periodo, '@r.PeriodoLabel', @r.TotalRegistros)"
                                                title="Eliminar propuesta">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(periodoSeleccionado))
{
    <div class="sire-alert sire-alert-info">
        <i class="bi bi-info-circle"></i>
        <span>No hay propuesta descargada para <strong>@yyyyMm</strong>. Use <strong>Exportar Propuesta</strong> para obtener los registros desde SUNAT.</span>
    </div>
}

@* ── Panel: Resumen de Conciliación ─────────────────────────────────────── *@
@*
@if (Model?.ConcilResumen != null)
{
    var cr = Model.ConcilResumen;
    <div class="sire-card mb-3">
        <div class="sire-card-header" style="padding:.35rem .75rem;">
            <i class="bi bi-check2-all" style="color:@(cr.TieneProblemas ? "var(--bs-warning)" : "var(--sire-rvie)");font-size:.82rem;"></i>
            <span style="font-size:.79rem;">Supervisión de Conciliación</span>
            <span class="text-muted fw-normal ms-1" style="font-size:.72rem;">— @yyyyMm contra ERP Logix</span>
            @if (!cr.TieneProblemas)
            {
                <span class="ms-2 sire-badge sire-badge-ok" style="font-size:.65rem;"><i class="bi bi-check-circle me-1"></i>Sin diferencias</span>
            }
            else
            {
                <span class="ms-2 sire-badge sire-badge-warn" style="font-size:.65rem;"><i class="bi bi-exclamation-triangle me-1"></i>Con observaciones</span>
            }
        </div>
        <div class="px-3 py-2 d-flex gap-3 flex-wrap align-items-start" style="background:var(--sire-gray-50);font-size:.8rem;">
            <div class="d-flex flex-column align-items-center px-3 py-1 rounded"
                 style="border-left:3px solid var(--sire-rvie);background:#fff;min-width:90px;">
                <span class="fw-bold" style="font-size:1.25rem;color:var(--sire-rvie);">@cr.TotalOk.ToString("N0")</span>
                <span class="text-muted" style="font-size:.68rem;">Coinciden</span>
            </div>
            <div class="d-flex flex-column align-items-center px-3 py-1 rounded"
                 style="border-left:3px solid var(--bs-warning);background:#fff;min-width:90px;">
                <span class="fw-bold" style="font-size:1.25rem;color:#b45309;">@cr.TotalDifer.ToString("N0")</span>
                <span class="text-muted" style="font-size:.68rem;">Con diferencia</span>
            </div>
            <div class="d-flex flex-column align-items-center px-3 py-1 rounded"
                 style="border-left:3px solid var(--bs-danger);background:#fff;min-width:90px;">
                <span class="fw-bold" style="font-size:1.25rem;color:var(--bs-danger);">@cr.TotalSoloSunat.ToString("N0")</span>
                <span class="text-muted" style="font-size:.68rem;">Solo SUNAT</span>
            </div>
            <div class="d-flex flex-column align-items-center px-3 py-1 rounded"
                 style="border-left:3px solid var(--bs-info);background:#fff;min-width:90px;">
                <span class="fw-bold" style="font-size:1.25rem;color:var(--bs-info);">@cr.TotalSoloLeg.ToString("N0")</span>
                <span class="text-muted" style="font-size:.68rem;">Solo Legacy</span>
            </div>
            @if (cr.DiffTotal != 0)
            {
                <div class="d-flex flex-column align-items-center px-3 py-1 rounded"
                     style="border-left:3px solid var(--bs-danger);background:#fff;min-width:110px;">
                    <span class="fw-bold" style="font-size:1.1rem;color:var(--bs-danger);">S/ @cr.DiffTotal.ToString("N2")</span>
                    <span class="text-muted" style="font-size:.68rem;">Diferencia neta
                        <i class="bi bi-info-circle ms-1" style="cursor:help;"
                           title="Diferencia Neta = Total SUNAT − Total ERP (Logix), acumulada sobre todos los registros cruzados del período. Representa el importe neto no conciliado entre ambas fuentes."></i>
                    </span>
                </div>
            }
            <div class="ms-auto d-flex flex-column align-items-center px-3 py-1 rounded"
                 style="border-left:3px solid var(--sire-gray-300);background:#fff;min-width:80px;">
                <span class="fw-bold" style="font-size:1.25rem;color:var(--sire-navy);">@cr.PctOk.ToString("N1")%</span>
                <span class="text-muted" style="font-size:.68rem;">% OK</span>
            </div>
        </div>
        @if (cr.TieneProblemas)
        {
            <div class="px-3 pb-2 pt-1" style="font-size:.76rem;color:var(--sire-gray-700);">
                <i class="bi bi-info-circle me-1" style="color:var(--bs-warning);"></i>
                Los registros con diferencia o solo en SUNAT aparecen marcados en la tabla de detalle de abajo.
                Use el filtro <strong>Diferencia</strong> y <strong>Solo SUNAT</strong> para focalizarlos.
            </div>
        }
    </div>
}
