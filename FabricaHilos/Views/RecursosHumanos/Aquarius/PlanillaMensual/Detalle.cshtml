@{
    ViewData["Title"] = "Detalle de Asistencia Semanal — Planilla Mensual";
}

@section Styles {
<style>
    :root {
        --aq:       #C0622B;
        --aq-dk:    #9E4D20;
        --aq-lt:    #FEF3EB;
        --aq-mid:   #F5D5BC;
        --aq-ok:    #4E7E58;
        --aq-ok-lt: #EAF4EC;
        --aq-info:  #7A6E9E;
        --aq-ilt:   #F2EDF7;
        --aq-warn:  #B8772C;
        --aq-wlt:   #FEF5E3;
    }
    .filter-bar { background:#f8f9fa; border-bottom:1px solid #dee2e6; padding:.85rem 1.2rem; }
    .filter-bar .form-label { font-size:.78rem; font-weight:600; margin-bottom:.2rem; }
    .filter-bar .form-select, .filter-bar .form-control { font-size:.83rem; }
    .form-control:focus, .form-select:focus { border-color:var(--aq); box-shadow:0 0 0 .2rem rgba(192,98,43,.15); }

    .det-table { font-size:.76rem; }
    .det-table thead th {
        background:#f1f3f5; color:#495057;
        font-size:.69rem; font-weight:600; text-transform:uppercase; letter-spacing:.35px;
        white-space:nowrap; padding:.45rem .4rem;
        border-bottom:2px solid var(--aq-mid);
        position:sticky; z-index:2;
    }
    /* Cabecera de 2 filas: cada fila debe "apilarse" en su propio offset vertical,
       no ambas en top:0 (eso hacia que la 2da fila se superpusiera sobre la 1ra
       al hacer scroll, perdiendo la coherencia visual de las columnas).
       El offset de la 2da fila se calcula por JS (altura real de la 1ra fila),
       ya que forzar un "height" fijo rompería las celdas con rowspan="2" (Cód./DNI/Nombre/Sem/Fecha). */
    .det-table thead tr:first-child  th { top:0; z-index:3; }
    .det-table thead tr:nth-child(2) th { top: var(--thead-row1-h, 1.95rem); }
    .det-table tbody td { padding:.32rem .4rem; vertical-align:middle; white-space:nowrap; }
    .det-table tbody tr:hover { background:var(--aq-lt); }

    /* fila empleado (separador) */
    .tr-emp { background:var(--aq-mid) !important; }
    .tr-emp td { font-weight:700; font-size:.78rem; color:var(--aq-dk); padding:.55rem .4rem !important; }

    /* fila total */
    .tr-total { background:#e8f0fc !important; }
    .tr-total td { font-weight:700; font-size:.77rem; color:#1a3a6b; padding:.45rem .4rem !important; }

    /* fila descanso */
    .tr-descanso td { color:#adb5bd; font-style:italic; }

    /* fila feriado */
    .tr-feriado { background:#fff3cd !important; }

    /* fila falta (día sin marcación, alerta02='FT' + tipodescuentofalta='1') */
    .tr-falta { background:#FBEAEA !important; }
    .tr-falta td { color:#7a2c2a; }
    .badge-falta {
        background:#AE3F3C; color:#fff; font-size:.62rem; font-weight:700;
        padding:1px 6px; border-radius:3px; letter-spacing:.3px; white-space:nowrap;
    }

    /* columna tardanza */
    .td-tard   { color:var(--aq-warn); font-weight:600; }
    .td-falta  { color:#AE3F3C; font-weight:600; }

    .col-sep { border-left:2px solid rgba(0,0,0,.09) !important; }
    .th-grp-ef   { background:var(--aq-lt)  !important; color:var(--aq)      !important; }
    .th-grp-he   { background:var(--aq-mid) !important; color:var(--aq-dk)   !important; }
    .th-grp-horas { background:var(--aq-ilt) !important; color:var(--aq-info) !important; }

    .exportar-btn { background:var(--aq); color:#fff; border:none; }
    .exportar-btn:hover { background:var(--aq-dk); }
    #spinner { display:none; }
    .badge-0 { opacity:.3; }
    .det-table thead th[data-sort] { cursor:pointer; user-select:none; }
    .det-table thead th[data-sort]:hover { background:var(--aq-mid) !important; }
    .det-table thead th .sort-icon { font-size:.6rem; margin-left:2px; }
</style>
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a href="/RecursosHumanos">Recursos Humanos</a></li>
    <li class="breadcrumb-item"><a href="/RecursosHumanos/Aquarius/PlanillaMensual/Dashboard">Planilla Mensual</a></li>
    <li class="breadcrumb-item active">Detalle Semanal</li>
}

<!-- Título -->
<div class="d-flex justify-content-between align-items-center mb-2">
    <h4 class="mb-0"><i class="bi bi-list-columns-reverse me-2" style="color:var(--aq)"></i>Reporte de Asistencia Detallado (Semanal)</h4>
    <div class="d-flex gap-2">
        <button class="btn btn-sm exportar-btn" id="btnExportar" disabled>
            <i class="bi bi-file-earmark-excel me-1"></i>Excel
        </button>
        <a href="/RecursosHumanos/Aquarius/PlanillaMensual/Dashboard" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>
<hr class="mt-1 mb-3" />

<!-- FILTROS SIMPLIFICADOS: Solo Tipo Empleado (EMPLEADO/OBRERO) y Período -->
<div class="filter-bar rounded mb-3">
    <div class="row g-2 align-items-end">
        <!-- Tipo Empleado (EMPLEADO / OBRERO) -->
        <div class="col-auto">
            <label class="form-label">Tipo Empleado</label>
            <div class="btn-group btn-group-sm" role="group">
                <input type="radio" class="btn-check" name="rdoTipo" id="rdoEmpleado" value="02" checked />
                <label class="btn btn-outline-secondary" for="rdoEmpleado">EMPLEADO</label>
                
                <input type="radio" class="btn-check" name="rdoTipo" id="rdoObrero" value="05" />
                <label class="btn btn-outline-secondary" for="rdoObrero">OBRERO</label>
            </div>
        </div>
        <!-- Período Del / Al -->
        <div class="col-auto ms-4">
            <label class="form-label">Del</label>
            <input type="date" id="dtDesde" class="form-control form-control-sm" style="width:140px" />
        </div>
        <div class="col-auto">
            <label class="form-label">Al</label>
            <input type="date" id="dtHasta" class="form-control form-control-sm" style="width:140px" />
        </div>
        <!-- Consultar -->
        <div class="col-auto">
            <button id="btnBuscar" class="btn btn-sm text-white" style="background:var(--aq);border-color:var(--aq)">
                <i class="bi bi-search me-1"></i>Consultar
            </button>
        </div>
        <div class="col-auto" id="spinner">
            <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
        </div>
        <!-- Filtro rápido -->
        <div class="col-auto ms-auto">
            <input type="search" id="inpFiltro" class="form-control form-control-sm"
                   placeholder="Filtrar por nombre o código…" style="min-width:200px" />
        </div>
    </div>
</div>

<!-- Info -->
<div id="divInfo" class="d-none mb-2 text-muted" style="font-size:.82rem">
    <i class="bi bi-info-circle me-1"></i><span id="lblInfo"></span>
</div>

<!-- TABLA DETALLE -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0" style="overflow-x:auto; max-height:72vh">
        <table class="table table-sm det-table mb-0" id="tblDetalle">
            <thead>
                <tr>
                    <!-- Identificación -->
                    <th rowspan="2" style="min-width:38px" id="thCod" data-sort="codPersonal">Cód. <i class="bi sort-icon"></i></th>
                    <th rowspan="2">DNI</th>
                    <th rowspan="2" style="min-width:160px" id="thNombre" data-sort="nomTrabajador">Apellidos y Nombres <i class="bi sort-icon"></i></th>
                    <th rowspan="2" class="text-center" title="Semana">Sem</th>
                    <th rowspan="2" class="text-center" style="min-width:80px">FECHA</th>
                    <!-- Horarios -->
                    <th colspan="4" class="text-center col-sep th-grp-horas">Horarios</th>
                    <!-- Efectivas -->
                    <th colspan="4" class="text-center col-sep th-grp-ef">Horas Efectivas</th>
                    <!-- Otros -->
                    <th colspan="3" class="text-center col-sep" style="background:#f8f8f8">Desc./Perm.</th>
                    <!-- HE -->
                    <th colspan="3" class="text-center col-sep th-grp-he">Horas Extras</th>
                    <!-- Observaciones -->
                    <th rowspan="2" class="col-sep">Observ.</th>
                </tr>
                <tr>
                    <th class="text-center col-sep th-grp-horas" title="Horario Teórico">H.Teór.</th>
                    <th class="text-center th-grp-horas" title="Horario Real">H.Real</th>
                    <th class="text-center th-grp-horas" title="Horario Refrigerio">H.Refrig.</th>
                    <th class="text-center th-grp-horas" title="Horas Refrigerio">H.Ref</th>
                    <th class="text-center col-sep th-grp-ef" title="H.Efectivas">H.Efe</th>
                    <th class="text-center th-grp-ef d-none" title="H.Efectivas T1">H.T1</th>
                    <th class="text-center th-grp-ef col-sep" title="H.Efectivas T2 / Días T2 en total">H.T2<br/><small style="opacity:.7">días en tot</small></th>
                    <th class="text-center th-grp-ef" title="H.Efectivas T3 / Días T3 en total">H.T3<br/><small style="opacity:.7">días en tot</small></th>
                    <th class="text-center th-grp-ef" title="H.Nocturnas">H.Noc</th>
                    <th class="text-center col-sep" title="Tardanza">Tard</th>
                    <th class="text-center" title="Antes de Salida">H.Ant</th>
                    <th class="text-center" title="Permiso">Perm</th>
                    <th class="text-center col-sep th-grp-he" title="H25%">H25%</th>
                    <th class="text-center th-grp-he" title="H35%">H35%</th>
                    <th class="text-center th-grp-he" title="Horas Dobles">Dob</th>
                </tr>
            </thead>
            <tbody id="tbodyDet">
                <tr><td colspan="21" class="text-center text-muted py-4">
                    <i class="bi bi-search me-2"></i>Seleccione el tipo de empleado y el período, luego pulse Consultar.
                </td></tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
const BASE = '/RecursosHumanos/Aquarius/PlanillaMensual';
let allData = [];
let currentRows = [];
let sortCol = null;
let sortDir = 1;

// Valores por defecto (fijos, según legacy BO: Empresa=LA COLONIAL, Sucursal=ARGENTINA 4151)
const CFG = {
    codEmpresa:      '0003',      // LA COLONIAL
    codSucursal:     '002',       // ARGENTINA 4151
    cCostos:         'TODOS',
    codTipoPlanillaEmpleado: '02', // EMPLEADO
    codTipoPlanillaObrero:   '05'  // OBRERO
};
// Tipo de planilla REALMENTE consultado (no el del radio en vivo): la fila TOTAL
// muestra T2/T3 en días (EMPLEADO) u horas HH:MM -trabajo original- (OBRERO)
// según esto, evitando que cambie de formato si el usuario toca el radio sin
// volver a pulsar Consultar.
let tipoConsultado = CFG.codTipoPlanillaEmpleado;
// ── Inicialización ─────────────────────────────────────────────────────────
function init() {
    setPeriodoDefault();
    document.getElementById('btnBuscar').addEventListener('click', consultar);
    document.querySelectorAll('input[name="rdoTipo"]').forEach(rdo => {
        rdo.addEventListener('change', () => console.log('Tipo empleado:', getTipoPlanillaSeleccionado()));
    });
    document.getElementById('inpFiltro').addEventListener('input', aplicarFiltrosOrden);
    document.querySelectorAll('#tblDetalle th[data-sort]').forEach(th => {
        th.addEventListener('click', () => {
            const col = th.dataset.sort;
            if (sortCol === col) { sortDir *= -1; } else { sortCol = col; sortDir = 1; }
            actualizarIconosOrden();
            aplicarFiltrosOrden();
        });
    });
}

function setPeriodoDefault() {
    const hoy = new Date();
    const ini = new Date(hoy.getFullYear(), hoy.getMonth() - 1, 24);
    const fin = new Date(hoy.getFullYear(), hoy.getMonth(),     23);
    document.getElementById('dtDesde').value = ini.toISOString().slice(0,10);
    document.getElementById('dtHasta').value = fin.toISOString().slice(0,10);
}

function getTipoPlanillaSeleccionado() {
    const rdo = document.querySelector('input[name="rdoTipo"]:checked');
    return rdo ? rdo.value : CFG.codTipoPlanillaEmpleado;
}

// ── Consultar ──────────────────────────────────────────────────────────────
async function consultar() {
    const desde = document.getElementById('dtDesde').value;
    const hasta = document.getElementById('dtHasta').value;
    const plan  = getTipoPlanillaSeleccionado();

    if (!desde || !hasta) { alert('Seleccione el período.'); return; }

    tipoConsultado = plan;
    document.getElementById('spinner').style.display = '';
    document.getElementById('btnBuscar').disabled    = true;
    document.getElementById('tblDetalle').querySelector('tbody').innerHTML =
        '<tr><td colspan="21" class="text-center text-muted py-3"><span class="spinner-border spinner-border-sm me-2"></span>Consultando…</td></tr>';

    try {
        const resp = await fetch(`${BASE}/api/Detalle`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                codEmpresa:      CFG.codEmpresa,
                codSucursal:     CFG.codSucursal,
                codTipoPlanilla: plan,
                cCostos:         CFG.cCostos,
                fechaInicio:     formatFecha(desde),
                fechaFinal:      formatFecha(hasta)
            })
        });
        if (!resp.ok) { const e = await resp.json(); throw new Error(e.error || resp.statusText); }
        allData = await resp.json();
        aplicarFiltrosOrden();
        const empCount = [...new Set(allData.filter(r => r.tipoFila === 'T').map(r => r.nomTrabajador))].length;
        document.getElementById('divInfo').classList.remove('d-none');
        document.getElementById('lblInfo').textContent =
            `${empCount} empleados — Período: ${desde} al ${hasta}`;
        document.getElementById('btnExportar').disabled = allData.length === 0;
    } catch(ex) {
        document.getElementById('tblDetalle').querySelector('tbody').innerHTML =
            `<tr><td colspan="21" class="text-center text-danger py-3"><i class="bi bi-exclamation-triangle me-2"></i>${ex.message}</td></tr>`;
    } finally {
        document.getElementById('spinner').style.display = 'none';
        document.getElementById('btnBuscar').disabled    = false;
    }
}

// ── Agrupar filas por empleado (cada grupo = filas 'D' + su fila 'T') ──────
function agruparPorEmpleado(rows) {
    const grupos = [];
    const idx = new Map();
    for (const r of rows) {
        const key = r.codPersonal ?? r.nomTrabajador;
        if (!idx.has(key)) {
            idx.set(key, { codPersonal: r.codPersonal, nomTrabajador: r.nomTrabajador, filas: [] });
            grupos.push(idx.get(key));
        }
        idx.get(key).filas.push(r);
    }
    return grupos;
}

// ── Filtro por código/nombre + orden asc/desc por Cód./Nombre ─────────────
function aplicarFiltrosOrden() {
    let grupos = agruparPorEmpleado(allData);

    const q = (document.getElementById('inpFiltro').value || '').toLowerCase().trim();
    if (q) {
        grupos = grupos.filter(g =>
            (g.nomTrabajador ?? '').toLowerCase().includes(q) ||
            (g.codPersonal   ?? '').toLowerCase().includes(q));
    }

    if (sortCol) {
        grupos = [...grupos].sort((a, b) => {
            const va = (a[sortCol] ?? '').toString();
            const vb = (b[sortCol] ?? '').toString();
            return va.localeCompare(vb, 'es', { numeric: true, sensitivity: 'base' }) * sortDir;
        });
    }

    currentRows = grupos.flatMap(g => g.filas);
    renderDetalle(currentRows);
    ajustarOffsetCabecera();
}

function actualizarIconosOrden() {
    document.querySelectorAll('#tblDetalle th[data-sort]').forEach(th => {
        const icon = th.querySelector('.sort-icon');
        if (!icon) return;
        if (th.dataset.sort === sortCol) {
            icon.className = 'bi sort-icon ' + (sortDir === 1 ? 'bi-caret-up-fill' : 'bi-caret-down-fill');
        } else {
            icon.className = 'bi sort-icon';
        }
    });
}

// ── Render tabla detalle ───────────────────────────────────────────────────
function renderDetalle(rows) {
    const tbody = document.getElementById('tbodyDet');
    if (!rows.length) {
        tbody.innerHTML = '<tr><td colspan="21" class="text-center text-muted py-4">Sin resultados.</td></tr>';
        return;
    }

    let html       = '';
    let lastEmp    = null;
    let lastSem    = null;

    for (const r of rows) {
        const isTotal   = r.tipoFila === 'T';
        const esDescanso = !r.horarioTeorico && !isTotal;
        const esFeriado  = r.feriado === 'F';
        const sinHorario = r.diLab === 'SIN Horario';
        const esFalta    = r.esFalta === 'S';

        // ── Separador de empleado (antes de la primera fila del empleado) ──
        if (r.nomTrabajador !== lastEmp) {
            lastEmp = r.nomTrabajador;
            lastSem = null;
            html += `<tr class="tr-emp">
                <td>${r.codPersonal ?? ''}</td>
                <td>${r.numDocIdentidad ?? ''}</td>
                <td colspan="19">${r.nomTrabajador ?? ''}</td>
            </tr>`;
        }

        if (isTotal) {
            // ── Fila TOTAL (corregida) ────────────────────────────────────
            const h25  = minToHHMM(r.horaExofi1MRnd);
            const h35  = minToHHMM(r.horaExofi2MRnd);
            const hdob = minToHHMM(r.horaDoblesRnd);
            const hnoc = minToHHMM(r.totHoraNocturnaM);
            const hef  = minToHHMM(r.horaEfectivaM);
            const hef1 = minToHHMM(r.horaEfectivaT1M);
            const tard = minToHHMM(r.horaTardanzaM);
            const perm = minToHHMM(r.horaPermisoM);
            // T2/T3: OBRERO respeta el trabajo original (horas HH:MM); EMPLEADO en días
            const esObrero = tipoConsultado === CFG.codTipoPlanillaObrero;
            const t2 = esObrero ? minToHHMM(r.horaEfectivaT2M) : `${r.diasT2} días`;
            const t3 = esObrero ? minToHHMM(r.horaEfectivaT3M) : `${r.diasT3} días`;
            html += `<tr class="tr-total">
                <td colspan="4" class="text-end pe-2 text-muted" style="font-size:.7rem">TOTAL</td>
                <td></td>
                <td class="col-sep text-center" colspan="4"></td>
                <td class="col-sep text-center th-grp-ef fw-bold">${hef}</td>
                <td class="text-center th-grp-ef d-none">${hef1}</td>
                <td class="text-center th-grp-ef fw-bold col-sep" title="T2">${t2}</td>
                <td class="text-center th-grp-ef fw-bold" title="T3">${t3}</td>
                <td class="text-center th-grp-ef">${hnoc}</td>
                <td class="col-sep text-center ${r.horaTardanzaM > 0 ? 'td-tard' : ''}">${tard}</td>
                <td class="text-center"></td>
                <td class="text-center">${perm}</td>
                <td class="col-sep text-center th-grp-he fw-bold">${h25}</td>
                <td class="text-center th-grp-he fw-bold">${h35}</td>
                <td class="text-center th-grp-he fw-bold">${hdob}</td>
                <td class="col-sep"></td>
            </tr>`;
            continue;
        }

        // ── Separador de semana ───────────────────────────────────────────
        if (r.semProceso && r.semProceso !== lastSem) {
            lastSem = r.semProceso;
            html += `<tr style="background:#f0f4f8;border-top:1px solid var(--aq-mid)">
                <td colspan="21" style="font-size:.7rem;color:var(--aq-dk);padding:.25rem .5rem">
                    <i class="bi bi-calendar3-week me-1"></i>Semana ${r.semProceso}
                </td>
            </tr>`;
        }

        // ── Fila detalle diaria ───────────────────────────────────────────
        const trClass = esFalta ? 'tr-falta' : (sinHorario ? 'tr-descanso' : (esFeriado ? 'tr-feriado' : ''));
        const fecLabel = formatFechaLabel(r.fecProceso, r.dia);
        const tardClass = r.horaTardanzaM > 0 ? 'td-tard' : '';

        html += `<tr class="${trClass}">
            <td></td>
            <td></td>
            <td></td>
            <td class="text-center text-muted" style="font-size:.68rem">${r.semProceso ?? ''}</td>
            <td class="text-center">${fecLabel}</td>
            <td class="col-sep text-center text-muted" style="font-size:.71rem">${r.horarioTeorico ?? '—'}</td>
            <td class="text-center" style="font-size:.71rem">${r.horarioJornada ?? (sinHorario ? '<em>Descanso</em>' : '—')}</td>
            <td class="text-center text-muted" style="font-size:.71rem">${r.horarioRefrigerio ?? '—'}</td>
            <td class="text-center">${r.horaRef ?? ''}</td>
            <td class="col-sep text-center fw-semibold ${esFalta ? 'td-falta' : ''}">${esFalta ? 'FALTA' : (r.horaEfectiva ?? (sinHorario ? '' : '—'))}</td>
            <td class="text-center text-muted d-none">${r.horaEfectivaT1 ?? ''}</td>
            <td class="text-center col-sep" style="color:var(--aq-info)">${r.horaEfectivaT2 ?? ''}</td>
            <td class="text-center" style="color:#6259a8">${r.horaEfectivaT3 ?? ''}</td>
            <td class="text-center text-muted">${r.totHoraNocturna ?? ''}</td>
            <td class="col-sep text-center ${tardClass}">${r.horaTardanza ?? ''}</td>
            <td class="text-center">${r.horaAnteSalida ?? ''}</td>
            <td class="text-center">${r.horaPermiso ?? ''}</td>
            <td class="col-sep text-center th-grp-he">${r.horaExofi1 ?? ''}</td>
            <td class="text-center th-grp-he">${r.horaExofi2 ?? ''}</td>
            <td class="text-center th-grp-he">${r.horaDobles ?? ''}</td>
            <td class="col-sep text-muted" style="font-size:.71rem">${esFalta ? '<span class="badge-falta">FALTA</span> ' : ''}${r.diLab ?? ''}</td>
        </tr>`;
    }
    tbody.innerHTML = html;
}

// ── Helpers ────────────────────────────────────────────────────────────────────
function minToHHMM(min) {
    if (!min || min === 0) return '<span class="badge-0">0:00</span>';
    const h = Math.floor(min / 60), m = min % 60;
    return `${h}:${String(m).padStart(2,'0')}`;
}

function formatFecha(iso) {
    const [y, m, d] = iso.split('-');
    return `${d}/${m}/${y}`;
}

function formatFechaLabel(fec, dia) {
    if (!fec) return '';
    const dias = { 'LU':'Lu','MA':'Ma','MI':'Mi','JU':'Ju','VI':'Vi','SA':'<span style="color:var(--aq-info)">Sa</span>','DO':'<span style="color:var(--aq-err,#AE3F3C)">Do</span>' };
    const label = dias[dia?.trim()] ?? dia ?? '';
    return `<span class="text-muted me-1">${label}</span>${fec}`;
}

// ── Helpers para exportación Excel ───────────────────────────────────────
function construirTablaExcel() {
    const original = document.getElementById('tblDetalle');
    const clone = original.cloneNode(true);

    clone.querySelectorAll('.d-none').forEach(el => el.remove());
    clone.querySelectorAll('.sort-icon').forEach(el => el.remove());
    clone.querySelectorAll('th').forEach(th => {
        th.style.position = '';
        th.style.top = '';
        th.setAttribute('style', (th.getAttribute('style') || '') + ';background:#f4a462;color:#222;border:1px solid #ccc;padding:4px');
    });

    // Las clases CSS (tr-emp, tr-total, tr-feriado, tr-descanso) no se
    // conservan al exportar (el .xls no incluye la hoja de estilos), por lo
    // que se convierten a estilos inline para que el fondo distintivo de
    // cada fila (p.ej. el nombre del empleado) se vea igual que en la vista.
    clone.querySelectorAll('tr.tr-emp').forEach(tr => {
        tr.setAttribute('style', 'background:#F5D5BC;font-weight:700;color:#9E4D20');
        tr.querySelectorAll('td').forEach(td => td.setAttribute('style', (td.getAttribute('style') || '') + ';background:#F5D5BC;font-weight:700;color:#9E4D20'));
    });
    clone.querySelectorAll('tr.tr-total').forEach(tr => {
        tr.setAttribute('style', 'background:#e8f0fc;font-weight:700;color:#1a3a6b');
        tr.querySelectorAll('td').forEach(td => td.setAttribute('style', (td.getAttribute('style') || '') + ';background:#e8f0fc;font-weight:700;color:#1a3a6b'));
    });
    clone.querySelectorAll('tr.tr-feriado').forEach(tr => {
        tr.setAttribute('style', 'background:#fff3cd');
        tr.querySelectorAll('td').forEach(td => td.setAttribute('style', (td.getAttribute('style') || '') + ';background:#fff3cd'));
    });
    clone.querySelectorAll('tr.tr-descanso').forEach(tr => {
        tr.querySelectorAll('td').forEach(td => td.setAttribute('style', (td.getAttribute('style') || '') + ';color:#adb5bd;font-style:italic'));
    });
    clone.querySelectorAll('tr.tr-falta').forEach(tr => {
        tr.setAttribute('style', 'background:#FBEAEA');
        tr.querySelectorAll('td').forEach(td => td.setAttribute('style', (td.getAttribute('style') || '') + ';background:#FBEAEA;color:#7a2c2a'));
    });

    return '<table border="1" style="border-collapse:collapse;font-family:Calibri,Arial;font-size:11px">' +
        clone.innerHTML +
        '</table>';
}

// ── Exportar Excel (clona la tabla EXACTAMENTE como se ve en pantalla) ──
document.getElementById('btnExportar').addEventListener('click', () => {
    if (!allData.length) return;
    const tabla = construirTablaExcel();
    const html = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">' +
        '<head><meta charset="UTF-8">' +
        '<!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet>' +
        '<x:Name>DetalleSemanal</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions>' +
        '</x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]-->' +
        '<\/head><body>' + tabla + '<\/body><\/html>';
    const blob = new Blob(['\uFEFF' + html], { type: 'application/vnd.ms-excel;charset=utf-8;' });
    const url  = URL.createObjectURL(blob);
    Object.assign(document.createElement('a'), { href: url, download: 'DetalleSemanal.xls' }).click();
    URL.revokeObjectURL(url);
});

// ── Init ─────────────────────────────────────────────────────────────────
function ajustarOffsetCabecera() {
    const tabla = document.getElementById('tblDetalle');
    if (!tabla) return;
    const filaTh = tabla.querySelector('thead tr:first-child th[colspan]');
    if (!filaTh) return;
    const alto = filaTh.getBoundingClientRect().height;
    if (alto > 0) tabla.style.setProperty('--thead-row1-h', alto + 'px');
}

document.addEventListener('DOMContentLoaded', () => {
    init();
    ajustarOffsetCabecera();
    window.addEventListener('resize', ajustarOffsetCabecera);
});
</script>
}
