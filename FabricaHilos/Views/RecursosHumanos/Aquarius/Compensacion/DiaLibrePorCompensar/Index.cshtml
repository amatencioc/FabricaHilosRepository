function limpiarTodo() {
    if (txAbierta) {
        msgModal('Transacción abierta', '<p>Hay una transacción en curso. ¿Desea cancelarla y limpiar?</p>', { confirm: true })
            .then(ok => {
                if (!ok) return;
                fetch(`${URL_BASE}/Rollback`, { method: 'POST' });
                txAbierta = false;
                _limpiar();
            });
        return;
    }
    _limpiar();
}

function _limpiar() {
    rangoData     = [];
    rangoDataFilt = [];
    previewData   = [];
    seleccionCods = new Set();
    seleccionDias = new Set();
    _lastIdEvento = null;
    _pagActual    = 1;
    document.getElementById('areaRango').style.display      = 'none';
    document.getElementById('areaPreview').style.display    = 'none';
    document.getElementById('areaResultados').style.display = 'none';
    document.getElementById('areaConsulta').style.display   = 'none';
    document.getElementById('bodyRango').innerHTML       = '';
    document.getElementById('bodyPreview').innerHTML     = '';
    document.getElementById('bodyResultados').innerHTML  = '';
    document.getElementById('bodyConsulta').innerHTML    = '';
    document.getElementById('lblRangoInfo').textContent      = '';
    document.getElementById('lblPreviewInfo').textContent    = '';
    document.getElementById('lblSeleccion').textContent      = '';
    document.getElementById('lblSeleccionRango').textContent = '';
    document.getElementById('btnRegistrar').disabled         = true;
    document.getElementById('btnCalcularSeleccion').disabled = true;
    actualizarPaginacion();
}

function _limpiarYRecargar() {
    _limpiar();
    buscarRango();
}

// ── Visor Acuerdo DOCX ───────────────────────────────────────────────────
var _modalVisorAcuerdo     = null;
var _visorAcuerdoDocxEl    = document.getElementById('visorAcuerdoDocx');
var _visorAcuerdoSpinnerEl = document.getElementById('visorAcuerdoSpinner');
var _visorAcuerdoErrorEl   = document.getElementById('visorAcuerdoError');
var _visorAcuerdoDescBtn   = document.getElementById('visorAcuerdoBtnDescargar');
var _visorAcuerdoImpBtn    = document.getElementById('visorAcuerdoBtnImprimir');
var _visorAcuerdoNombreEl  = document.getElementById('visorAcuerdoNombre');
var _visorAcuerdoBuf       = null;

function abrirVisorAcuerdo(url, nombre) {
    if (!_modalVisorAcuerdo) {
        _modalVisorAcuerdo = new bootstrap.Modal(document.getElementById('modalVisorAcuerdo'));
    }

    _visorAcuerdoNombreEl.textContent  = nombre;
    _visorAcuerdoDescBtn.href          = url;
    _visorAcuerdoDescBtn.setAttribute('download', nombre);

    _visorAcuerdoDocxEl.style.display    = 'none';
    _visorAcuerdoDocxEl.innerHTML        = '';
    _visorAcuerdoSpinnerEl.style.display = 'block';
    _visorAcuerdoErrorEl.style.display   = 'none';
    _visorAcuerdoBuf                     = null;

    _modalVisorAcuerdo.show();

    fetch(url, { noLoading: true })
        .then(function (r) {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.arrayBuffer();
        })
        .then(function (buf) {
            _visorAcuerdoBuf = buf;
            _visorAcuerdoSpinnerEl.style.display = 'none';
            _visorAcuerdoDocxEl.style.display    = 'block';
            return docx.renderAsync(buf, _visorAcuerdoDocxEl, null, {
                className: 'docx-preview',
                inWrapper: true,
                ignoreWidth: true,
                ignoreHeight: true
            });
        })
        .catch(function (err) {
            console.error('Error al renderizar Acuerdo:', err);
            _visorAcuerdoSpinnerEl.style.display = 'none';
            _visorAcuerdoDocxEl.style.display    = 'none';
            _visorAcuerdoErrorEl.style.display   = 'block';
        });
}

document.getElementById('visorAcuerdoBtnImprimir').addEventListener('click', function () {
    var contenido = _visorAcuerdoDocxEl.innerHTML;
    if (!contenido) return;
    var win = window.open('', '_blank');
    win.document.write(
        '<!DOCTYPE html><html><head><meta charset="utf-8"><title>Acuerdo</title>' +
        '<style>' +
        '@@page{size:A4;margin:8mm 10mm 8mm 10mm;}' +
        '*{box-sizing:border-box;}' +
        'body{font-family:Arial,sans-serif;margin:0;padding:0;font-size:9pt;color:#000;background:#fff;}' +
        '.docx-wrapper,.docx-wrapper>section{background:#fff!important;box-shadow:none!important;padding:0!important;margin:0!important;width:100%!important;}' +
        'table{width:100%!important;border-collapse:collapse;font-size:8pt;}' +
        'td,th{border:1px solid #000;padding:2px 4px;color:#000;background:#fff!important;}' +
        'p{margin:0 0 3pt 0;}' +
        '@@media print{body{margin:0;}@@page{margin:8mm 10mm 8mm 10mm;}}' +
        '<\/style>' +
        '<\/head><body>' + contenido + '<\/body><\/html>'
    );
    win.document.close();
    win.focus();
    win.onload = function () { win.print(); };
});

document.getElementById('modalVisorAcuerdo').addEventListener('hidden.bs.modal', function () {
    _visorAcuerdoDocxEl.innerHTML     = '';
    _visorAcuerdoDocxEl.style.display = 'none';
    _visorAcuerdoBuf                  = null;
});

// ── Inicialización ────────────────────────────────────────────────────────

document.addEventListener('DOMContentLoaded', () => {
    cargarEmpresasDisponibles();
});
</script>
