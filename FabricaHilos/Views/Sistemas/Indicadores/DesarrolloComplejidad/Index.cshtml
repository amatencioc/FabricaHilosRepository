@{
    ViewData["Title"] = "KPI Desarrollo - Complejidad";
}

@section Styles {
<style>
    /* ── layout general ─────────────────────────── */
    .filter-bar {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,.07);
        padding: .85rem 1.25rem;
        margin-bottom: 1.4rem;
    }
    .chart-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 10px rgba(0,0,0,.08);
        background: #f5f5f2;
    }
    .chart-card .card-header {
        background: transparent;
        color: #1B4D3E;
        font-weight: 700;
        border-bottom: 1px solid #e0e0e0;
        border-radius: 12px 12px 0 0 !important;
        font-size: .9rem;
        padding: .65rem 1rem;
    }
    .chart-card .card-body {
        background: #f0f0ec;
        border-radius: 0 0 12px 12px;
    }
    /* ── sección ─────────────────────────────────── */
    .section-title {
        font-size: 1rem;
        font-weight: 700;
        color: #1B4D3E;
        margin: 1.6rem 0 .25rem;
        border-left: 4px solid #c8a84b;
        padding-left: .55rem;
    }
    .report-desc {
        font-size: .78rem;
        color: #637381;
        margin: 0 0 .85rem .65rem;
        line-height: 1.55;
    }
    /* ── KPI cards ───────────────────────────────── */
    .kpi-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 10px rgba(0,0,0,.08);
        text-align: center;
        padding: 1.1rem .8rem;
        background: #fff;
    }
    .kpi-card .kpi-icon  { font-size: 1.8rem; }
    .kpi-card .kpi-label { font-size: .67rem; color: #637381; font-weight: 700; text-transform: uppercase; margin: .15rem 0; }
    .kpi-card .kpi-value { font-size: 2rem; font-weight: 700; }
    /* ── tabla pivot ─────────────────────────────── */
    .tabla-pivot           { font-size: .79rem; }
    .tabla-pivot th,
    .tabla-pivot td        { vertical-align: middle !important; }
    .tabla-pivot thead th  { text-align: center; }
    .tabla-pivot td.compl  { font-weight: 600; padding-left: .75rem; }
    .tabla-pivot td.num    { text-align: center; }
    .tabla-pivot tfoot td  { font-weight: bold; text-align: center; background: #e8f5e9; }
    /* ── badges de complejidad ───────────────────── */
    .badge-alta   { background: #c62828; color: #fff; border-radius: 6px; padding: 2px 8px; font-size: .72rem; font-weight: 700; }
    .badge-media  { background: #e65100; color: #fff; border-radius: 6px; padding: 2px 8px; font-size: .72rem; font-weight: 700; }
    .badge-baja   { background: #1565C0; color: #fff; border-radius: 6px; padding: 2px 8px; font-size: .72rem; font-weight: 700; }
    .badge-sin    { background: #6c757d; color: #fff; border-radius: 6px; padding: 2px 8px; font-size: .72rem; font-weight: 700; }
</style>
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a href="/Sistemas">Sistemas</a></li>
    <li class="breadcrumb-item active">KPI Desarrollo - Complejidad</li>
}

<!-- ══ DESCRIPCIÓN GENERAL ══════════════════════════════════ -->
<div class="alert mb-3 border-0 rounded-3 shadow-sm" style="background:#e8f5e9; border-left:5px solid #1B4D3E !important; padding:1rem 1.25rem">
    <div class="d-flex align-items-start gap-2">
        <span style="font-size:1.6rem; line-height:1">⚖️</span>
        <div>
            <div class="fw-bold" style="color:#1B4D3E; font-size:.95rem">¿Qué mide este indicador?</div>
            <div class="mt-1" style="font-size:.8rem; color:#374151; line-height:1.65">
                El indicador <strong>KPI Desarrollo - Complejidad</strong> analiza los requerimientos de desarrollo
                ponderados por su nivel de dificultad:
                <span class="badge-alta">ALTA</span>,
                <span class="badge-media">MEDIA</span> y
                <span class="badge-baja">BAJA</span>.
                A mayor complejidad, mayor impacto en la carga real del equipo de Sistemas.<br>
                La agrupación por complejidad permite priorizar el backlog, identificar si los requerimientos de
                <strong>alta dificultad</strong> están siendo atendidos a tiempo y medir la distribución de la carga.
                El campo <strong>Complejidad</strong> se obtiene de la <em>Prioridad</em> registrada en cada requerimiento.
            </div>
        </div>
    </div>
</div>

<!-- ══ FILTROS ════════════════════════════════════════════ -->
<div class="filter-bar">
    <div class="d-flex flex-wrap align-items-end gap-3">
        <div>
            <label class="form-label mb-1 small fw-semibold">Fecha Inicio</label>
            <input type="date" id="fechaInicio" class="form-control form-control-sm" style="min-width:140px">
        </div>
        <div>
            <label class="form-label mb-1 small fw-semibold">Fecha Fin</label>
            <input type="date" id="fechaFin" class="form-control form-control-sm" style="min-width:140px">
        </div>
        <button class="btn btn-sm btn-success" onclick="loadAll()">
            <i class="bi bi-arrow-clockwise me-1"></i>Actualizar
        </button>
        <button class="btn btn-sm btn-outline-success" id="btnExportar" onclick="exportarExcel()" disabled>
            <i class="bi bi-file-earmark-excel me-1"></i>Exportar Excel
        </button>
    </div>
</div>

<!-- ══ KPI CARDS ══════════════════════════════════════════ -->
<p class="report-desc mt-1 mb-2">
    <i class="bi bi-info-circle me-1"></i>
    <strong>Alta Complejidad</strong> = requerimientos marcados como ALTA prioridad (mayor peso en la carga del equipo).
    <strong>% Atención</strong> = proporción atendida en el año más reciente del rango.
</p>
<div class="row g-3 mb-4" id="kpiCards"></div>

<!-- ══════════════════════════════════════════════════════
     SECCIÓN 1 — Tabla pivot COMPLEJIDAD × AÑO
════════════════════════════════════════════════════════ -->
<div class="section-title"><i class="bi bi-table me-1"></i>Requerimientos por Complejidad y Año</div>
<p class="report-desc">
    Tabla dinámica que cruza <strong>nivel de complejidad (filas)</strong> con <strong>años (columnas)</strong>.
    Por cada celda: <strong>PEND</strong> = total recibidos en ese año con ese nivel · <strong>ENTR</strong> = ya entregados.<br>
    Los niveles se muestran de mayor a menor peso: <span class="badge-alta">ALTA</span> primero.
    Una celda PEND muy superior a ENTR indica backlog crítico por nivel de dificultad.
</p>
<div class="card chart-card position-relative mb-4">
    <div id="spinnerPivot" class="chart-spinner" style="position:absolute;inset:0;background:rgba(255,255,255,.78);display:flex;align-items:center;justify-content:center;border-radius:12px;z-index:10">
        <div class="spinner-border text-success"></div>
    </div>
    <div class="card-header"><i class="bi bi-grid-3x2-gap me-1"></i>Detalle por Complejidad y Año</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-bordered tabla-pivot mb-0" id="tablaPivot">
                <thead></thead><tbody></tbody><tfoot></tfoot>
            </table>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════
     SECCIÓN 2 — Distribución global + Avance por complejidad
════════════════════════════════════════════════════════ -->
<div class="section-title"><i class="bi bi-pie-chart me-1"></i>Distribución y Avance por Complejidad</div>
<p class="report-desc">
    Izquierda: proporción de requerimientos por nivel de complejidad sobre el total del período.
    Derecha: porcentaje de cumplimiento (requerimientos entregados / recibidos) por nivel.
    <strong>Semaforizado:</strong>
    <span style="color:#2e7d32; font-weight:700">■ Verde ≥ 80%</span>,
    <span style="color:#e65100; font-weight:700">■ Naranja ≥ 50%</span>,
    <span style="color:#c62828; font-weight:700">■ Rojo &lt; 50%</span>.
</p>
<div class="row g-3 mb-4">
    <div class="col-lg-5">
        <div class="card chart-card">
            <div class="card-header"><i class="bi bi-pie-chart-fill me-1"></i>¿Cómo se distribuyen por complejidad?</div>
            <div class="px-3 pt-2 pb-0" style="font-size:.74rem;color:#637381;line-height:1.5">
                Cada segmento = un nivel de complejidad. El porcentaje indica su peso sobre el total de requerimientos del período.
            </div>
            <div class="card-body" style="height:310px;display:flex;align-items:center;justify-content:center;">
                <canvas id="chartDona"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card chart-card">
            <div class="card-header"><i class="bi bi-speedometer2 me-1"></i>% Avance por nivel de complejidad</div>
            <div class="px-3 pt-2 pb-0" style="font-size:.74rem;color:#637381;line-height:1.5">
                Porcentaje de requerimientos ya entregados respecto al total recibido por cada nivel.
                Un nivel ALTA con bajo % indica deuda técnica crítica acumulada.
            </div>
            <div class="card-body p-2">
                <div id="wrapperAvance" style="position:relative;height:260px">
                    <canvas id="chartAvance"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════
     SECCIÓN 3 — Evolución por año (agrupado)
════════════════════════════════════════════════════════ -->
<div class="section-title"><i class="bi bi-bar-chart-line me-1"></i>Volumen por Año</div>
<p class="report-desc">
    Total de requerimientos recibidos y entregados por año.
    Permite identificar si el volumen crece o decrece y qué proporción fue cerrada.
</p>
<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="card chart-card">
            <div class="card-header"><i class="bi bi-calendar4-range me-1"></i>Requerimientos recibidos y entregados — por año</div>
            <div class="px-3 pt-2 pb-0" style="font-size:.74rem;color:#637381;line-height:1.5">
                Barra <strong>naranja</strong> = total recibidos; barra <strong>azul</strong> = ya entregados.
                Si ambas son iguales, todo el backlog de ese año está cerrado.
            </div>
            <div class="card-body" style="height:360px">
                <canvas id="chartAno"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════
     SECCIÓN 4 — Barras apiladas por complejidad × mes
════════════════════════════════════════════════════════ -->
<div class="section-title"><i class="bi bi-bar-chart-steps me-1"></i>Requerimientos por mes y complejidad <span id="lblAnoAt"></span></div>
<p class="report-desc">
    Barras apiladas: cada color es un nivel de complejidad (<span class="badge-alta">ALTA</span> = rojo,
    <span class="badge-media">MEDIA</span> = naranja, <span class="badge-baja">BAJA</span> = azul).
    La <strong>línea negra</strong> muestra el peso acumulado del mes (suma de puntos de complejidad).
    Un mes con mucho rojo indica alta carga de trabajos complejos.
</p>
<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="card chart-card">
            <div class="card-header"><i class="bi bi-layers me-1"></i>Requerimientos por mes agrupados por nivel de complejidad</div>
            <div class="card-body" style="height:380px">
                <canvas id="chartMesCompl"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════
     SECCIÓN 5 — Tabla mensual de atención
════════════════════════════════════════════════════════ -->
<div class="section-title"><i class="bi bi-calendar3 me-1"></i>Atención mensual <span id="lblAnoAt2"></span></div>
<p class="report-desc">
    Detalle mes a mes del año más reciente: requerimientos recibidos, atendidos en el mismo mes,
    atendidos en mes posterior, pendientes y porcentaje de resolución inmediata.
    La columna <strong>Peso</strong> suma los puntos de complejidad del mes (ALTA=3, MEDIA=2, BAJA=1).
</p>
<div class="row g-3 mb-4">
    <div class="col-lg-5">
        <div class="card chart-card">
            <div class="card-header"><i class="bi bi-table me-1"></i>Tabla de atención mensual</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-bordered mb-0" id="tablaMes" style="font-size:.79rem">
                        <thead></thead><tbody></tbody><tfoot></tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card chart-card">
            <div class="card-header"><i class="bi bi-bar-chart-steps me-1"></i>Evolución mensual: atendidos, pendientes y % resolución inmediata</div>
            <div class="card-body" style="height:370px">
                <canvas id="chartMes"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Modal de error -->
<div class="modal fade" id="modalErrorCompl" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger">
            <div class="modal-header bg-danger text-white py-2">
                <h6 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Error al cargar el dashboard</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1 text-muted small">Se produjo un error al obtener los datos. Detalle:</p>
                <pre id="modalErrorDetalle" class="bg-light border rounded p-2 small mb-0"
                     style="white-space:pre-wrap;max-height:260px;overflow:auto"></pre>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/lib/chartjs-plugin-datalabels/dist/chartjs-plugin-datalabels.min.js" asp-append-version="true"></script>
<script>
(function () {
    'use strict';

    if (typeof ChartDataLabels !== 'undefined') Chart.register(ChartDataLabels);
    Chart.defaults.font.family = "'Segoe UI','Helvetica Neue',Arial,sans-serif";
    Chart.defaults.font.size   = 12;
    Chart.defaults.color       = '#374151';

    /* ── Paleta por complejidad ───────────────────── */
    const COMPL_COLOR = {
        'ALTA':             { bg: 'rgba(198,40,40,0.82)',   border: '#c62828' },
        'MEDIA':            { bg: 'rgba(230,81,0,0.82)',    border: '#e65100' },
        'BAJA':             { bg: 'rgba(21,101,192,0.82)',  border: '#1565C0' },
        '(Sin clasificar)': { bg: 'rgba(108,117,125,0.70)', border: '#6c757d' },
    };
    function colorBg(c)  { return (COMPL_COLOR[c] || COMPL_COLOR['(Sin clasificar)']).bg; }
    function colorBdr(c) { return (COMPL_COLOR[c] || COMPL_COLOR['(Sin clasificar)']).border; }

    const AÑO_BG      = ['#d1e9ff','#d4edda','#fff3cd','#f8d7da','#e2d9f3'];
    const AÑO_ENTR_BG = ['#1565C0','#28a745','#e65100','#dc3545','#7c4dff'];

    const charts = {};
    const destroy = k => { if (charts[k]) { charts[k].destroy(); delete charts[k]; } };

    /* ── Fechas por defecto ───────────────────── */
    function setDefaultDates() {
        const hoy = new Date(), ini = new Date(hoy.getFullYear(), 0, 1);
        const iso = d => d.toISOString().slice(0, 10);
        document.getElementById('fechaInicio').value = iso(ini);
        document.getElementById('fechaFin').value    = iso(hoy);
    }

    function buildParams() {
        const p = new URLSearchParams();
        const fi = document.getElementById('fechaInicio').value;
        const ff = document.getElementById('fechaFin').value;
        if (fi) p.set('fechaInicio', fi);
        if (ff) p.set('fechaFin',    ff);
        return p;
    }

    /* ══════════════════════════════════════════
       KPI CARDS
    ══════════════════════════════════════════ */
    function renderKpis(d) {
        const cards = [
            { icon: '📋', label: 'Total Recibidos',     value: d.totalRecibidos,  color: '#1B4D3E' },
            { icon: '⏳', label: 'Pendientes Abiertos', value: d.totalPendientes, color: '#e65100' },
            { icon: '✅', label: 'Total Entregados',    value: d.totalEntregados, color: '#1565C0' },
            { icon: '🔴', label: 'Alta Complejidad',    value: d.totalComplejos,  color: '#c62828' },
            { icon: '📊', label: '% Atención ' + d.anoAtencion, value: d.pctAtencionAno + '%', color: '#2e7d32' },
        ];
        document.getElementById('kpiCards').innerHTML = cards.map(c => `
            <div class="col-6 col-xl">
                <div class="kpi-card" style="border-top:4px solid ${c.color}">
                    <div class="kpi-icon">${c.icon}</div>
                    <div class="kpi-label">${c.label}</div>
                    <div class="kpi-value" style="color:${c.color}">${c.value}</div>
                </div>
            </div>`).join('');
    }

    /* ══════════════════════════════════════════
       SECCIÓN 1 — Tabla pivot COMPLEJIDAD × AÑO
    ══════════════════════════════════════════ */
    function renderPivot(d) {
        const t = document.getElementById('tablaPivot');
        const a = d.anos || [];

        let h1 = `<tr>
            <th rowspan="2" class="text-start align-middle ps-3"
                style="background:#e8eaf6; min-width:160px;">COMPLEJIDAD</th>`;
        a.forEach((an, i) => {
            h1 += `<th colspan="2" class="text-center"
                       style="background:${AÑO_BG[i % AÑO_BG.length]};
                              border-bottom:3px solid ${AÑO_ENTR_BG[i % AÑO_ENTR_BG.length]};">
                       <strong>${an}</strong></th>`;
        });
        h1 += `<th rowspan="2" class="text-center align-middle"
                   style="background:#c8e6da; color:#1B4D3E; min-width:72px;">Total<br>PEND</th>
               <th rowspan="2" class="text-center align-middle"
                   style="background:#bbdefb; color:#1565C0; min-width:72px;">Total<br>ENTR</th></tr>`;

        let h2 = '<tr>';
        a.forEach((_, i) => {
            const bg = AÑO_BG[i % AÑO_BG.length];
            h2 += `<th class="text-center" style="background:${bg}; font-size:.74rem; min-width:52px;">PEND</th>
                   <th class="text-center" style="background:${bg}; font-size:.74rem; min-width:52px;">ENTR</th>`;
        });
        h2 += '</tr>';
        t.tHead.innerHTML = h1 + h2;

        t.tBodies[0].innerHTML = (d.filas || []).map(f => {
            const bdr = colorBdr(f.complejidad);
            let row = `<tr><td class="compl" style="border-left:4px solid ${bdr}">
                <span style="color:${bdr};font-weight:700">${f.complejidad}</span></td>`;
            f.anos.forEach((c, i) => {
                const bg = AÑO_BG[i % AÑO_BG.length];
                const ec = AÑO_ENTR_BG[i % AÑO_ENTR_BG.length];
                row += `<td class="num" style="background:${bg}44">${c.pendiente || ''}</td>`;
                row += `<td class="num" style="background:${bg}44; color:${ec}; font-weight:600">${c.entregado || ''}</td>`;
            });
            row += `<td class="num" style="background:#eafaf1; color:#1B4D3E; font-weight:700">${f.totalPendiente || ''}</td>
                    <td class="num" style="background:#e3f2fd; color:#1565C0; font-weight:700">${f.totalEntregado || ''}</td>`;
            return row + '</tr>';
        }).join('');

        let foot = '<tr><td class="text-center fw-bold">Total general</td>';
        (d.totalesAno || []).forEach((c, i) => {
            const bg = AÑO_BG[i % AÑO_BG.length];
            const ec = AÑO_ENTR_BG[i % AÑO_ENTR_BG.length];
            foot += `<td style="background:${bg}66">${c.pendiente || ''}</td>
                     <td style="background:${bg}66; color:${ec}; font-weight:700">${c.entregado || ''}</td>`;
        });
        foot += `<td style="color:#1B4D3E; font-weight:700">${d.gtPendiente || ''}</td>
                 <td style="color:#1565C0; font-weight:700">${d.gtEntregado || ''}</td></tr>`;
        t.tFoot.innerHTML = foot;

        document.getElementById('spinnerPivot').style.display = 'none';
    }

    /* ══════════════════════════════════════════
       SECCIÓN 2a — Dona: distribución por complejidad
    ══════════════════════════════════════════ */
    function renderChartDona(d) {
        destroy('dona');
        const data = (d.porComplejidad || []).filter(r => r.totalPendiente > 0);
        if (!data.length) return;
        const gran = data.reduce((s, r) => s + r.totalPendiente, 0);
        charts.dona = new Chart(document.getElementById('chartDona').getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: data.map(r => r.complejidad),
                datasets: [{
                    data:            data.map(r => r.totalPendiente),
                    backgroundColor: data.map(r => colorBg(r.complejidad)),
                    borderColor:     data.map(r => colorBdr(r.complejidad)),
                    borderWidth: 2, hoverOffset: 8
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false, cutout: '60%',
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 13, padding: 14 } },
                    tooltip: {
                        callbacks: {
                            label: ctx => `${ctx.label}: ${ctx.raw} (${(ctx.raw / gran * 100).toFixed(1)}%)`
                        }
                    },
                    datalabels: {
                        display: true, color: '#fff',
                        font: { size: 13, weight: '700' },
                        textStrokeColor: 'rgba(0,0,0,.4)', textStrokeWidth: 2,
                        formatter: (v) => {
                            const pct = gran > 0 ? (v / gran * 100).toFixed(0) : 0;
                            return pct >= 6 ? pct + '%' : '';
                        }
                    }
                }
            }
        });
    }

    /* ══════════════════════════════════════════
       SECCIÓN 2b — Avance por complejidad (barras horiz.)
    ══════════════════════════════════════════ */
    function renderChartAvance(d) {
        destroy('avance');
        const data = (d.porComplejidad || [])
            .filter(r => r.totalPendiente > 0)
            .map(r => ({
                compl: r.complejidad,
                pct:   r.totalPendiente > 0
                    ? Math.round(r.totalEntregado / r.totalPendiente * 100) : 0
            }));
        if (!data.length) return;

        charts.avance = new Chart(document.getElementById('chartAvance').getContext('2d'), {
            type: 'bar',
            data: {
                labels: data.map(r => r.compl),
                datasets: [{
                    label: '% Entregados',
                    data:  data.map(r => r.pct),
                    backgroundColor: data.map(r => {
                        const p = r.pct;
                        return p >= 80 ? 'rgba(46,125,50,.82)' : p >= 50 ? 'rgba(230,81,0,.82)' : 'rgba(198,40,40,.82)';
                    }),
                    borderColor: data.map(r => {
                        const p = r.pct;
                        return p >= 80 ? '#2e7d32' : p >= 50 ? '#e65100' : '#c62828';
                    }),
                    borderWidth: 1, borderRadius: 4,
                    datalabels: {
                        display: true, anchor: 'end', align: 'right',
                        color: '#374151', font: { size: 13, weight: '700' },
                        textStrokeColor: 'rgba(255,255,255,.9)', textStrokeWidth: 3,
                        formatter: v => v + '%'
                    }
                }]
            },
            options: {
                indexAxis: 'y', responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    datalabels: {}
                },
                layout: { padding: { right: 48 } },
                scales: {
                    x: { beginAtZero: true, max: 100,
                         ticks: { callback: v => v + '%' },
                         grid: { color: 'rgba(0,0,0,.06)' } },
                    y: { ticks: { font: { size: 12 } } }
                }
            }
        });
    }

    /* ══════════════════════════════════════════
       SECCIÓN 3 — Barras agrupadas por año
    ══════════════════════════════════════════ */
    function renderChartAno(d) {
        destroy('ano');
        const data = (d.porAno || []).filter(x => x.pendiente > 0 || x.entregado > 0);
        if (!data.length) return;
        charts.ano = new Chart(document.getElementById('chartAno').getContext('2d'), {
            type: 'bar',
            data: {
                labels: data.map(r => String(r.ano)),
                datasets: [
                    {
                        label: 'Recibidos (total)',
                        data: data.map(r => r.pendiente),
                        backgroundColor: 'rgba(230,81,0,0.82)',
                        borderColor: '#e65100', borderWidth: 1, borderRadius: 5,
                        datalabels: {
                            display: true, anchor: 'end', align: 'top',
                            color: '#374151', font: { size: 12, weight: '700' },
                            textStrokeColor: 'rgba(255,255,255,.9)', textStrokeWidth: 3,
                            formatter: v => v
                        }
                    },
                    {
                        label: 'Entregados',
                        data: data.map(r => r.entregado),
                        backgroundColor: 'rgba(21,101,192,0.75)',
                        borderColor: '#1565C0', borderWidth: 1, borderRadius: 5,
                        datalabels: {
                            display: true, anchor: 'end', align: 'top',
                            color: '#1565C0', font: { size: 12, weight: '700' },
                            textStrokeColor: 'rgba(255,255,255,.9)', textStrokeWidth: 3,
                            formatter: v => v
                        }
                    }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { position: 'top', labels: { boxWidth: 13, padding: 12 } } },
                layout: { padding: { top: 30 } },
                scales: {
                    y: { beginAtZero: true, ticks: { stepSize: 7 }, grid: { color: 'rgba(0,0,0,.06)' } },
                    x: { grid: { display: false } }
                }
            }
        });
    }

    /* ══════════════════════════════════════════
       SECCIÓN 4 — Barras apiladas por complejidad × mes
    ══════════════════════════════════════════ */
    function renderChartMesCompl(d) {
        destroy('mesCompl');
        const meses  = d.mesDetalle || [];
        const compls = d.complejidades || [];
        if (!meses.length || !compls.length) return;

        document.getElementById('lblAnoAt').textContent  = d.anoAtencion;
        document.getElementById('lblAnoAt2').textContent = d.anoAtencion;

        // Dataset por complejidad (barras apiladas)
        const datasets = compls.map(c => ({
            type: 'bar', label: c,
            data: meses.map(m => (m.porComplejidad || {})[c] || 0),
            backgroundColor: colorBg(c),
            borderColor: colorBdr(c), borderWidth: 1,
            stack: 'compl', yAxisID: 'y',
            datalabels: {
                display: ctx => ctx.dataset.data[ctx.dataIndex] > 0,
                anchor: 'center', align: 'center',
                color: '#fff', font: { size: 11, weight: '700' },
                textStrokeColor: 'rgba(0,0,0,.4)', textStrokeWidth: 2,
                formatter: v => v
            }
        }));

        // Línea de peso acumulado
        const pesoData = (d.atencionMes || []);
        datasets.push({
            type: 'line', label: 'Peso acumulado (ALTA×3, MEDIA×2, BAJA×1)',
            data: meses.map(m => {
                const row = pesoData.find(r => r.mes === m.mes);
                return row ? row.pesoTotal : 0;
            }),
            borderColor: '#212529', backgroundColor: 'rgba(0,0,0,0.06)',
            borderWidth: 2.5, pointRadius: 6,
            pointBackgroundColor: '#212529', pointBorderColor: '#fff', pointBorderWidth: 2,
            tension: 0.3, yAxisID: 'y1', stack: undefined,
            datalabels: {
                display: true, anchor: 'top', align: 'top',
                color: '#000', font: { size: 11, weight: '700' },
                borderColor: '#fff', borderWidth: 1, borderRadius: 3,
                backgroundColor: 'rgba(255,255,255,0.75)',
                padding: { top: 1, bottom: 1, left: 3, right: 3 },
                formatter: v => Math.round(v)
            }
        });

        charts.mesCompl = new Chart(document.getElementById('chartMesCompl').getContext('2d'), {
            data: {
                labels: meses.map(m => m.etiqueta),
                datasets
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { position: 'top', labels: { boxWidth: 13, padding: 12 } },
                    datalabels: {}
                },
                layout: { padding: { top: 30 } },
                scales: {
                    y:  { beginAtZero: true, stacked: true,
                          title: { display: true, text: 'Cantidad', font: { size: 11 } },
                          grid: { color: 'rgba(0,0,0,.06)' } },
                    y1: { beginAtZero: true, position: 'right',
                          grid: { drawOnChartArea: false },
                          title: { display: true, text: 'Peso', font: { size: 11 } } },
                    x:  { grid: { display: false } }
                }
            }
        });
    }

    /* ══════════════════════════════════════════
       SECCIÓN 5 — Tabla mensual + Chart mensual
    ══════════════════════════════════════════ */
    function renderMes(d) {
        const data = d.atencionMes || [];
        const tab  = document.getElementById('tablaMes');

        tab.tHead.innerHTML = `
            <tr style="background:#c5d9f7">
                <th rowspan="2" class="text-start align-middle ps-2" style="min-width:88px;vertical-align:middle">MES</th>
                <th rowspan="2" class="align-middle" style="vertical-align:middle">REQ</th>
                <th colspan="2" class="text-center" style="background:#9fbef0">ATENCIÓN</th>
                <th rowspan="2" class="align-middle" style="background:#fde8c8;vertical-align:middle">PEND</th>
                <th rowspan="2" class="align-middle" style="vertical-align:middle">%</th>
                <th rowspan="2" class="align-middle" style="vertical-align:middle">Peso</th>
            </tr>
            <tr style="background:#bcd1f0">
                <th style="font-size:.74rem">MES</th>
                <th style="font-size:.74rem">SIG.</th>
            </tr>`;

        tab.tBodies[0].innerHTML = data.map(r => {
            const color = r.pctMismoMes >= 80 ? '#2e7d32' : r.pctMismoMes >= 50 ? '#e65100' : '#c62828';
            return `<tr>
                <td class="text-start" style="font-weight:600;padding-left:.75rem">${r.etiqueta}</td>
                <td style="text-align:center">${r.recibidos}</td>
                <td style="text-align:center;color:#1565C0;font-weight:700">${r.atMismoMes || ''}</td>
                <td style="text-align:center;color:#1B4D3E">${r.atSigMes || ''}</td>
                <td style="text-align:center;color:#e65100;font-weight:700">${r.pendientes || ''}</td>
                <td style="text-align:center"><span class="badge" style="background:${color};font-size:.72rem">${r.pctMismoMes}%</span></td>
                <td style="text-align:center;font-weight:600;color:#212529">${Math.round(r.pesoTotal)}</td>
            </tr>`;
        }).join('');

        const tot = data.reduce((s, r) => ({
            rec: s.rec + r.recibidos, mismo: s.mismo + r.atMismoMes,
            sig: s.sig + r.atSigMes, pend: s.pend + r.pendientes, peso: s.peso + r.pesoTotal
        }), { rec: 0, mismo: 0, sig: 0, pend: 0, peso: 0 });
        const totColor = d.pctAtencionAno >= 80 ? '#2e7d32' : d.pctAtencionAno >= 50 ? '#e65100' : '#c62828';
        tab.tFoot.innerHTML = `
            <tr style="background:#e8f5e9;font-weight:bold;text-align:center">
                <td class="text-start" style="padding-left:.75rem">TOTAL</td>
                <td>${tot.rec}</td>
                <td style="color:#1565C0">${tot.mismo}</td>
                <td style="color:#1B4D3E">${tot.sig}</td>
                <td style="color:#e65100">${tot.pend || ''}</td>
                <td><span class="badge" style="background:${totColor};font-size:.78rem">${d.pctAtencionAno}%</span></td>
                <td>${Math.round(tot.peso)}</td>
            </tr>`;

        // Chart mixto mensual (mismo mes / sig mes / pendientes / línea %)
        destroy('mes');
        if (!data.length) return;
        charts.mes = new Chart(document.getElementById('chartMes').getContext('2d'), {
            data: {
                labels: data.map(r => r.etiqueta),
                datasets: [
                    {
                        type: 'bar', label: 'Atendidos mismo mes',
                        data: data.map(r => r.atMismoMes),
                        backgroundColor: 'rgba(21,101,192,0.82)',
                        borderColor: '#1565C0', borderWidth: 1,
                        stack: 'a', yAxisID: 'y',
                        datalabels: {
                            display: ctx => ctx.dataset.data[ctx.dataIndex] > 0,
                            anchor: 'center', align: 'center',
                            color: '#fff', font: { size: 11, weight: '700' },
                            textStrokeColor: 'rgba(0,0,0,.4)', textStrokeWidth: 2,
                            formatter: v => v
                        }
                    },
                    {
                        type: 'bar', label: 'Atendidos mes siguiente',
                        data: data.map(r => r.atSigMes),
                        backgroundColor: 'rgba(27,77,62,0.72)',
                        borderColor: '#1B4D3E', borderWidth: 1,
                        stack: 'a', yAxisID: 'y',
                        datalabels: {
                            display: ctx => ctx.dataset.data[ctx.dataIndex] > 0,
                            anchor: 'center', align: 'center',
                            color: '#fff', font: { size: 11, weight: '700' },
                            textStrokeColor: 'rgba(0,0,0,.4)', textStrokeWidth: 2,
                            formatter: v => v
                        }
                    },
                    {
                        type: 'bar', label: 'Pendientes',
                        data: data.map(r => r.pendientes),
                        backgroundColor: 'rgba(230,81,0,0.82)',
                        borderColor: '#e65100', borderWidth: 1,
                        stack: 'a', yAxisID: 'y',
                        datalabels: {
                            display: ctx => ctx.dataset.data[ctx.dataIndex] > 0,
                            anchor: 'center', align: 'center',
                            color: '#fff', font: { size: 11, weight: '700' },
                            textStrokeColor: 'rgba(0,0,0,.4)', textStrokeWidth: 2,
                            formatter: v => v
                        }
                    },
                    {
                        type: 'line', label: '% Atendidos mismo mes',
                        data: data.map(r => r.pctMismoMes),
                        borderColor: '#111', backgroundColor: 'rgba(0,0,0,0.06)',
                        borderWidth: 2.5, pointRadius: 6,
                        pointBackgroundColor: '#111', pointBorderColor: '#fff', pointBorderWidth: 2,
                        tension: 0.3, yAxisID: 'y1',
                        datalabels: {
                            display: true, anchor: 'top', align: 'top',
                            color: '#000', font: { size: 11, weight: '700' },
                            borderColor: '#fff', borderWidth: 1, borderRadius: 3,
                            backgroundColor: 'rgba(255,255,255,0.75)',
                            padding: { top: 1, bottom: 1, left: 3, right: 3 },
                            formatter: v => v + '%'
                        }
                    }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { position: 'top', labels: { boxWidth: 13, padding: 12 } },
                    datalabels: {}
                },
                layout: { padding: { top: 30 } },
                scales: {
                    y:  { beginAtZero: true, stacked: true, ticks: { stepSize: 3 },
                          title: { display: true, text: 'Cantidad', font: { size: 11 } },
                          grid: { color: 'rgba(0,0,0,.06)' } },
                    y1: { beginAtZero: true, max: 100, position: 'right',
                          grid: { drawOnChartArea: false },
                          ticks: { callback: v => v + '%', stepSize: 10 },
                          title: { display: true, text: '% Atención', font: { size: 11 } } },
                    x:  { grid: { display: false } }
                }
            }
        });
    }

    /* ══════════════════════════════════════════
       CARGA PRINCIPAL
    ══════════════════════════════════════════ */
    async function loadAll() {
        // Mostrar spinners
        document.getElementById('spinnerPivot').style.display = 'flex';
        document.getElementById('kpiCards').innerHTML =
            '<div class="col-12 text-center py-3"><div class="spinner-border text-success"></div></div>';

        try {
            const params = buildParams();
            const resp   = await fetch('/Sistemas/DesarrolloComplejidad/DatosDashboard?' + params);
            if (!resp.ok) throw new Error(`HTTP ${resp.status}: ${await resp.text()}`);
            const d = await resp.json();

            renderKpis(d);
            renderPivot(d);
            renderChartDona(d);
            renderChartAvance(d);
            renderChartAno(d);
            renderChartMesCompl(d);
            renderMes(d);

            document.getElementById('btnExportar').disabled = false;
        } catch (err) {
            document.getElementById('modalErrorDetalle').textContent = err.message || String(err);
            new bootstrap.Modal(document.getElementById('modalErrorCompl')).show();
            document.getElementById('spinnerPivot').style.display = 'none';
        }
    }
    window.loadAll = loadAll;

    /* ══════════════════════════════════════════
       Exportar gráficos al Excel
    ══════════════════════════════════════════ */
    async function exportarExcel() {
        const btn = document.getElementById('btnExportar');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Generando...';

        try {
            const canvasIds = ['chartDona', 'chartAvance', 'chartAno', 'chartMesCompl', 'chartMes'];
            const imagenes  = canvasIds
                .map(id => document.getElementById(id))
                .filter(c => c)
                .map(c => c.toDataURL('image/png'));

            const fi = document.getElementById('fechaInicio').value;
            const ff = document.getElementById('fechaFin').value;
            const fmtDate = v => v ? new Date(v + 'T00:00:00').toLocaleDateString('es-PE', { day: '2-digit', month: 'long', year: 'numeric' }) : '';
            const periodo = (fi && ff) ? `${fmtDate(fi)} — ${fmtDate(ff)}` : '';

            const resp = await fetch('/Sistemas/DesarrolloComplejidad/ExportarExcel', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify({ imagenes, periodo })
            });

            if (!resp.ok) throw new Error(await resp.text());

            const blob = await resp.blob();
            const url  = URL.createObjectURL(blob);
            const a    = document.createElement('a');
            a.href     = url;
            a.download = `Indicador_DesarrolloComplejidad_${fi || 'export'}.xlsx`;
            a.click();
            URL.revokeObjectURL(url);
        } catch (e) {
            console.error(e);
            document.getElementById('modalErrorDetalle').textContent = e.message || String(e);
            new bootstrap.Modal(document.getElementById('modalErrorCompl')).show();
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-file-earmark-excel me-1"></i>Exportar Excel';
        }
    }
    window.exportarExcel = exportarExcel;

    /* ── Inicio ───────────────────────────────── */
    setDefaultDates();
    loadAll();
})();
</script>
}
