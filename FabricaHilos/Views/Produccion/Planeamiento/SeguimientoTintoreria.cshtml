    maqTen     = r.MaqTen,
    estimaTen  = r.EstimaTenido.HasValue  ? r.EstimaTenido.Value.ToString("dd/MM/yy")  : (string?)null,
    entregTen  = r.EntregTenido.HasValue  ? r.EntregTenido.Value.ToString("dd/MM/yy")  : (string?)null,
    diasT      = r.DiasTenido,
    fchPartida = r.FchPartida.HasValue    ? r.FchPartida.Value.ToString("dd/MM/yy")    : (string?)null,
    fchReceta  = r.FchReceta.HasValue     ? r.FchReceta.Value.ToString("dd/MM/yy")     : (string?)null,
    fchSecRod  = r.FchSecRodete.HasValue  ? r.FchSecRodete.Value.ToString("dd/MM/yy")  : (string?)null,
    fchSecMad  = r.FchSecMadeja.HasValue  ? r.FchSecMadeja.Value.ToString("dd/MM/yy")  : (string?)null,
    fchAprobCal= r.FchAprobCal.HasValue   ? r.FchAprobCal.Value.ToString("dd/MM/yy")   : (string?)null,
    timeAprov  = r.TimeAprov,
    tipoAc     = r.TipoAcabado,
    fchEncon   = r.FchEnconado.HasValue   ? r.FchEnconado.Value.ToString("dd/MM/yy")   : (string?)null,
    fchRev     = r.FchRevisado.HasValue   ? r.FchRevisado.Value.ToString("dd/MM/yy")   : (string?)null,
    evEncon    = r.EvEncon,
    fchEntrega = r.FchEntrega.HasValue    ? r.FchEntrega.Value.ToString("dd/MM/yy")    : (string?)null,
    ingAlmpt   = r.IngAlmpt.HasValue      ? r.IngAlmpt.Value.ToString("dd/MM/yy")      : (string?)null,
    diasEsp    = r.DiasEnEspera,
    de         = r.De,
    deCopia    = r.DeCopia,
    kgProg     = r.KgProg,
    kgDespa    = r.KgDespa,
    gap        = r.Gap,
    pctTol     = r.PctToleran,
    estFlujo   = r.EstadoFlujo,
    estDesp    = r.EstadoDespacho,
    area       = r.AreaResponsable,
    bp         = r.Bp,
    retrasado  = r.EstaRetrasado,
    semClass   = r.SemaforoClass,
    conTen     = r.EntregTenido.HasValue,
    conCc      = r.FchAprobCal.HasValue,
    despachado = r.KgDespa.HasValue && r.KgDespa > 0,
    indDiasRod = r.DiasRod.HasValue ? (r.DiasRod > 0 ? "ret" : "ok") : "sin",
    indDiasMh  = r.DiasMh.HasValue  ? (r.DiasMh  > 0 ? "ret" : "ok") : "sin",
    indDiasRec = r.DiasRec.HasValue ? (r.DiasRec > 0 ? "ret" : "ok") : "sin",
    indDiasT   = r.DiasTenido.HasValue ? (r.DiasTenido > 0 ? "ret" : "ok") : "sin",
    indDe      = r.De.HasValue      ? (r.De      > 0 ? "ret" : "ok") : "sin"
})));
</script>
<script>
(function () {
'use strict';

// ── Helpers de formato y color ────────────────────────────────────────────
function d(v)   { return v != null ? v : '\u2014'; }
function n0(v)  { return v != null ? Number(v).toLocaleString('es-PE', {maximumFractionDigits:0}) : '\u2014'; }
function n2(v)  { return v != null ? Number(v).toLocaleString('es-PE', {minimumFractionDigits:2, maximumFractionDigits:2}) : '\u2014'; }
function bgRet(v)   { return (v != null && v > 0) ? 'background-color:#FEA8B4;' : ''; }
function bgDiasT(v) { return (v != null && v > 0) ? 'background-color:#FE9CB1;' : ''; }
function bgDE(v)    { return (v != null && v > 0) ? 'background-color:#FEA8B4;' : ''; }
function iconX(v) {
    if (v == null || v === 0) return '<i class="bi bi-circle-fill text-success" title="A tiempo"></i>';
    if (v === 1)              return '<i class="bi bi-circle-fill text-warning" title="1 d\u00eda retraso"></i>';
    return '<i class="bi bi-circle-fill text-danger" title="Retraso cr\u00edtico"></i>';
}
function iconDE(v) {
    if (v == null || v === 0) return '<i class="bi bi-circle-fill text-success" title="Sin espera"></i>';
    if (v === 1)              return '<i class="bi bi-circle-fill text-warning" title="1 d\u00eda espera"></i>';
    return '<i class="bi bi-circle-fill text-danger" title="En espera cr\u00edtica"></i>';
}

// ── HTML de una fila ──────────────────────────────────────────────────────
function buildRow(r) {
    var cls = r.retrasado ? 'row-retraso' : '';
    var tenBadge = r.entregTen
        ? '<span class="eb eb-ok"><i class="bi bi-check-lg"></i>' + r.entregTen + '</span>'
        : '<span class="eb eb-sin">\u2014</span>';
    return '<tr class="' + cls + '">' +
        '<td class="fc-1" style="white-space:nowrap;text-align:center;">' + d(r.mes) + '</td>' +
        '<td class="fc-2" style="white-space:nowrap;text-align:center;">' + d(r.mesTex) + '</td>' +
        '<td class="fc-3" style="white-space:nowrap;text-align:center;">' + d(r.ano) + '</td>' +
        '<td class="fc-4" style="white-space:nowrap;text-align:center;">' + d(r.sem) + '</td>' +
        '<td class="col-sep fc-5" style="white-space:nowrap;font-weight:600;color:#1e3a5f;">' + d(r.partida) + '</td>' +
        '<td class="fc-6" style="max-width:130px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="' + (r.cliente||'') + '">' + d(r.cliente) + '</td>' +
        '<td class="fc-7" style="max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="' + (r.material||'') + '">' + d(r.material) + '</td>' +
        '<td class="fc-8" style="white-space:nowrap;"><span class="eb eb-est">' + d(r.est) + '</span></td>' +
        '<td style="white-space:nowrap;">' + d(r.ne)   + '</td>' +
        '<td style="white-space:nowrap;">' + d(r.mat)  + '</td>' +
        '<td style="white-space:nowrap;">' + d(r.lote) + '</td>' +
        '<td style="white-space:nowrap;">' + d(r.fchPedido) + '</td>' +
        '<td class="col-sep" style="white-space:nowrap;">' + d(r.estimaRod) + '</td>' +
        '<td style="white-space:nowrap;">' + d(r.entregRod) + '</td>' +
        '<td style="text-align:right;white-space:nowrap;' + bgRet(r.diasRod) + '">' + n0(r.diasRod) + '</td>' +
        '<td class="col-sep" style="white-space:nowrap;">' + d(r.estimaMat) + '</td>' +
        '<td style="white-space:nowrap;">' + d(r.entregMat) + '</td>' +
        '<td style="text-align:right;white-space:nowrap;' + bgRet(r.diasMh) + '">' + n0(r.diasMh) + '</td>' +
        '<td class="col-sep" style="white-space:nowrap;">' + d(r.fchaGuia) + '</td>' +
        '<td class="col-sep" style="white-space:nowrap;">' + d(r.estimaRec) + '</td>' +
        '<td style="white-space:nowrap;">' + d(r.entregRec) + '</td>' +
        '<td style="text-align:right;white-space:nowrap;' + bgRet(r.diasRec) + '">' + n0(r.diasRec) + '</td>' +
        '<td style="text-align:center;white-space:nowrap;">' + iconX(r.x) + '</td>' +
        '<td class="col-sep" style="white-space:nowrap;">' + d(r.fchProg) + '</td>' +
        '<td style="white-space:nowrap;">' + d(r.maqTen) + '</td>' +
        '<td style="white-space:nowrap;">' + d(r.estimaTen) + '</td>' +
        '<td style="white-space:nowrap;">' + tenBadge + '</td>' +
        '<td style="text-align:right;white-space:nowrap;' + bgDiasT(r.diasT) + '">' + n0(r.diasT) + '</td>' +
        '<td class="col-sep" style="white-space:nowrap;">' + d(r.fchPartida)  + '</td>' +
        '<td style="white-space:nowrap;">' + d(r.fchReceta)   + '</td>' +
        '<td style="white-space:nowrap;">' + d(r.fchSecRod)   + '</td>' +
        '<td style="white-space:nowrap;">' + d(r.fchSecMad)   + '</td>' +
        '<td style="white-space:nowrap;">' + d(r.fchAprobCal) + '</td>' +
        '<td style="text-align:right;white-space:nowrap;' + bgRet(r.timeAprov) + '">' + n0(r.timeAprov) + '</td>' +
        '<td class="col-sep" style="white-space:nowrap;">' + d(r.tipoAc)   + '</td>' +
        '<td style="white-space:nowrap;">' + d(r.fchEncon) + '</td>' +
        '<td style="white-space:nowrap;">' + d(r.fchRev)   + '</td>' +
        '<td style="white-space:nowrap;">' + d(r.evEncon)  + '</td>' +
        '<td class="col-sep" style="white-space:nowrap;' + r.semClass + '">' + d(r.fchEntrega) + '</td>' +
        '<td style="white-space:nowrap;">' + d(r.ingAlmpt) + '</td>' +
        '<td style="text-align:right;white-space:nowrap;' + bgRet(r.diasEsp) + '">' + n0(r.diasEsp) + '</td>' +
        '<td style="text-align:center;white-space:nowrap;' + bgDE(r.de) + '">' + n0(r.de) + '</td>' +
        '<td style="text-align:center;white-space:nowrap;">' + iconDE(r.deCopia) + '</td>' +
        '<td class="col-sep" style="text-align:right;white-space:nowrap;">' + n2(r.kgProg)  + '</td>' +
        '<td style="text-align:right;white-space:nowrap;">' + n2(r.kgDespa) + '</td>' +
        '<td style="text-align:right;white-space:nowrap;">' + n2(r.gap)     + '</td>' +
        '<td style="text-align:right;white-space:nowrap;">' + n2(r.pctTol)  + '</td>' +
        '<td class="col-sep" style="white-space:nowrap;"><span class="eb eb-estado">' + d(r.estFlujo) + '</span></td>' +
        '<td style="white-space:nowrap;"><span class="eb ' + (r.estDesp === 'VENCIDO' ? 'eb-retaso' : 'eb-ok') + '">' + d(r.estDesp) + '</span></td>' +
        '<td class="col-sep" style="white-space:nowrap;">' + d(r.area) + '</td>' +
        '<td style="white-space:nowrap;">' + d(r.bp) + '</td>' +
        '</tr>';
}

// ── Referencias DOM ───────────────────────────────────────────────────────
var tbody    = document.getElementById('stTbody');
var tbl      = document.getElementById('stTable');
var cntEl    = document.getElementById('cfCount');
var totalEl  = document.getElementById('cfTotal');
var pgNums   = document.getElementById('pgNums');
var pgPrev   = document.getElementById('pgPrev');
var pgNext   = document.getElementById('pgNext');
var pgInfo   = document.getElementById('pgInfo');
var pgSizeEl = document.getElementById('pgSize');

if (!tbody || !window.stData) return;

var allData  = window.stData;
var filtered = allData.slice();
var pageSize = 200;
var curPage  = 1;

if (totalEl) totalEl.textContent = allData.length;

function norm(s) { return (s||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,''); }

var EXACT_CF = { mes:1, ano:1, est:1, maq:1, estflujo:1, estdesp:1, area:1, tipoac:1 };
var CF_MAP = {
    mes:function(r){return norm(r.mes);}, ano:function(r){return norm(r.ano);},
    partida:function(r){return norm(r.partida);}, cliente:function(r){return norm(r.cliente);},
    material:function(r){return norm(r.material);}, est:function(r){return norm(r.est);},
    ne:function(r){return norm(r.ne);}, mat:function(r){return norm(r.mat);},
    lote:function(r){return norm(r.lote);}, maq:function(r){return norm(r.maqTen);},
    estflujo:function(r){return norm(r.estFlujo);}, estdesp:function(r){return norm(r.estDesp);},
    area:function(r){return norm(r.area);}, tipoac:function(r){return norm(r.tipoAc);}
};
var IND_MAP = {
    retrasado:function(r){return r.retrasado?'1':'0';}, conten:function(r){return r.conTen?'1':'0';},
    concc:function(r){return r.conCc?'1':'0';}, despachado:function(r){return r.despachado?'1':'0';},
    diasrod:function(r){return r.indDiasRod;}, diasmh:function(r){return r.indDiasMh;},
    diasrec:function(r){return r.indDiasRec;}, diast:function(r){return r.indDiasT;},
    de:function(r){return r.indDe;}
};

var cfInputs = document.querySelectorAll('[data-cf]');
var cfInds   = document.querySelectorAll('[data-cf-ind]');

function applyFilters() {
    var vals={}, inds={};
    cfInputs.forEach(function(el){var v=el.value; if(v!=='') vals[el.dataset.cf]=norm(v);});
    cfInds.forEach(function(el){var v=el.value; if(v!=='') inds[el.dataset.cfInd]=v;});
    filtered = allData.filter(function(r){
        for(var key in vals){var fn=CF_MAP[key]; if(!fn) continue; var cell=fn(r); if(EXACT_CF[key]){if(cell!==vals[key]) return false;} else{if(!cell.includes(vals[key])) return false;}}
        for(var k2 in inds){var fn2=IND_MAP[k2]; if(!fn2) continue; if(fn2(r)!==inds[k2]) return false;}
        return true;
    });
    if(cntEl) cntEl.textContent=filtered.length;
    curPage=1; renderPage(); updateKpis();
}

function renderPage() {
    var total=filtered.length, ps=pageSize<=0?total:pageSize, pages=ps>0?Math.max(1,Math.ceil(total/ps)):1;
    if(curPage>pages) curPage=pages;
    var start=(curPage-1)*(ps>0?ps:total), end=ps>0?Math.min(start+ps,total):total;
    var html='';
    for(var i=0;i<filtered.slice(start,end).length;i++) html+=buildRow(filtered.slice(start,end)[i]);
    tbody.innerHTML=html;
    if(pgInfo) pgInfo.textContent=total===0?'0 registros':(ps<=0?'Todos ('+total+')':(start+1)+'\u2013'+end+' de '+total);
    if(pgPrev) pgPrev.disabled=(curPage<=1);
    if(pgNext) pgNext.disabled=(curPage>=pages);
    if(pgNums){
        var nums='',maxB=7,half=Math.floor(maxB/2),s=Math.max(1,curPage-half),e=Math.min(pages,s+maxB-1);
        if(e-s<maxB-1) s=Math.max(1,e-maxB+1);
        if(s>1){nums+='<button class="pg-btn" data-pg="1">1</button>';if(s>2) nums+='<span style="align-self:center;color:#94a3b8;">\u2026</span>';}
        for(var p=s;p<=e;p++) nums+='<button class="pg-btn'+(p===curPage?' pg-active':'')+'" data-pg="'+p+'">'+p+'</button>';
        if(e<pages){if(e<pages-1) nums+='<span style="align-self:center;color:#94a3b8;">\u2026</span>'; nums+='<button class="pg-btn" data-pg="'+pages+'">'+pages+'</button>';}
        pgNums.innerHTML=nums;
        pgNums.querySelectorAll('[data-pg]').forEach(function(btn){btn.addEventListener('click',function(){curPage=parseInt(this.dataset.pg);renderPage();fixTheadRowTops();});});
    }
}

function promedioNeg(arr){var n=arr.filter(function(v){return v!==null&&v<0;});return n.length?n.reduce(function(a,b){return a+b;},0)/n.length:null;}
function promedio(arr){var n=arr.filter(function(v){return v!==null;});return n.length?n.reduce(function(a,b){return a+b;},0)/n.length:null;}
function kpiFmt(v){return v!==null?v.toFixed(1):'\u2014';}

function updateKpis() {
    if(!tbl) return;
    var kpiRod=promedioNeg(filtered.map(function(r){return r.diasRod!=null?+r.diasRod:null;}));
    var kpiMh=promedioNeg(filtered.map(function(r){return r.diasMh!=null?+r.diasMh:null;}));
    var kpiRec=promedio(filtered.map(function(r){return r.diasRec!=null?+r.diasRec:null;}));
    var kpiDiasT=promedio(filtered.map(function(r){return r.diasT!=null?+r.diasT:null;}));
    tbl.querySelectorAll('tfoot td[data-kpi]').forEach(function(td){
        var k=td.dataset.kpi,val=null;
        if(k==='rod'){val=kpiRod;td.style.backgroundColor=(kpiRod!=null&&kpiRod>0)?'#FEA8B4':'';}
        if(k==='mh'){val=kpiMh;td.style.backgroundColor=(kpiMh!=null&&kpiMh>0)?'#FEA8B4':'';}
        if(k==='rec'){val=kpiRec;td.style.backgroundColor=(kpiRec!=null&&kpiRec>0)?'#FEA8B4':'';}
        if(k==='diast'){val=kpiDiasT;td.style.backgroundColor=(kpiDiasT!=null&&kpiDiasT>0)?'#FE9CB1':'';}
        if(k==='timeaprov'){val=kpiDiasT;td.style.backgroundColor=(kpiDiasT!=null&&kpiDiasT>0)?'#FEA8B4':'';}
        td.textContent=kpiFmt(val);
    });
}

var allCtrls=Array.from(cfInputs).concat(Array.from(cfInds));
allCtrls.forEach(function(el){el.addEventListener('input',applyFilters);el.addEventListener('change',applyFilters);});
var resetBtn=document.getElementById('cfResetBtn');
if(resetBtn) resetBtn.addEventListener('click',function(){allCtrls.forEach(function(el){el.value='';});applyFilters();});

if(pgPrev) pgPrev.addEventListener('click',function(){if(curPage>1){curPage--;renderPage();fixTheadRowTops();}});
if(pgNext) pgNext.addEventListener('click',function(){var ps=pageSize<=0?filtered.length:pageSize,pages=Math.max(1,Math.ceil(filtered.length/(ps||1)));if(curPage<pages){curPage++;renderPage();fixTheadRowTops();}});
if(pgSizeEl) pgSizeEl.addEventListener('change',function(){pageSize=parseInt(this.value);curPage=1;renderPage();fixTheadRowTops();});

var stOpc=document.getElementById('stOpc');
function toggleCampos(){var ep=stOpc.value==='POR PEDIDO';document.getElementById('stGrpFechas').style.display=ep?'none':'';document.getElementById('stGrpFechaFin').style.display=ep?'none':'';document.getElementById('stGrpNumPed').style.display=ep?'':'none';}
stOpc.addEventListener('change',toggleCampos);
toggleCampos();

function fixTheadRowTops(){if(!tbl) return;var f=tbl.querySelector('thead tr:first-child');if(!f) return;var h=f.offsetHeight||f.getBoundingClientRect().height;var w=tbl.closest('.spt-table-wrap')||tbl;w.style.setProperty('--thead-row1-h',h+'px');}
requestAnimationFrame(function(){fixTheadRowTops();});
window.addEventListener('resize',fixTheadRowTops);


applyFilters();
})();
</script>
}
