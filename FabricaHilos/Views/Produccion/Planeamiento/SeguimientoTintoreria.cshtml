}

function escHtml(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

// ── Referencias DOM ───────────────────────────────────────────────────────────
var tbody    = document.getElementById('stTbody');
var tbodyL   = document.getElementById('stTbodyL');  // tabla izquierda (columnas fijas)
var tbl      = document.getElementById('stTable');
var cntEl    = document.getElementById('cfCount');
var totalEl  = document.getElementById('cfTotal');
var pgNums   = document.getElementById('pgNums');
var pgPrev   = document.getElementById('pgPrev');
var pgNext   = document.getElementById('pgNext');
var pgInfo   = document.getElementById('pgInfo');
var pgSizeEl = document.getElementById('pgSize');
var colorBar = document.getElementById('stColorBar');
var colorBarCnt = document.getElementById('stColorBarCount');

if (!tbody || !window.stData) return;

var allData  = window.stData;
var filtered = allData.slice();
var pageSize = 200;
var curPage  = 1;

// Inicializar _area (borrador edición) y _areaSaved (último valor guardado en servidor).
// _area  → se actualiza en cada tecla para que al paginar se conserve lo que el usuario escribió.
// _areaSaved → solo se actualiza tras un save exitoso; es la referencia para detectar cambios reales.
allData.forEach(function(r){
    r._area      = (r.area != null ? r.area : '');
    r._areaSaved = r._area;   // igual al inicio (viene del servidor)
});

if (totalEl) totalEl.textContent = allData.length;

function norm(s){ return (s||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,''); }

// ── Mapas de filtros ──────────────────────────────────────────────────────────
var EXACT_CF = { mes:1, ano:1, estflujo:1, estdesp:1, proceso:1, colorhexa:1 };
var CF_MAP = {
    mes:     function(r){ return norm(r.mes); },
    ano:     function(r){ return norm(r.ano); },
    partida: function(r){ return norm(r.partida); },
    cliente: function(r){ return norm(r.cliente); },
    material:function(r){ return norm(r.material); },
    proceso: function(r){ return norm(r.proTt||''); },
    estdesp: function(r){ return norm(r.estDesp); },
    estflujo:function(r){ return norm(r.estFlujo); },
    colorhexa:function(r){
        // filtro especial: '_none' = sin color
        return (r.colorHexa||'').toLowerCase();
    }
};
var IND_MAP = {
    revisado:  function(r){ return r.fchRev ? '1' : '0'; },
    despachado:function(r){ return r.despachado ? '1' : '0'; }
};
// Filtro fecha entrega
var cfFchEntDes = null, cfFchEntHas = null;

// ── applyFilters ─────────────────────────────────────────────────────────────
var cfInputs = document.querySelectorAll('[data-cf]');
var cfInds   = document.querySelectorAll('[data-cf-ind]');

function applyFilters() {
    var vals={}, inds={};
    cfInputs.forEach(function(el){ var v=el.value; if(v!=='') vals[el.dataset.cf]=norm(v); });
    cfInds.forEach(function(el){   var v=el.value; if(v!=='') inds[el.dataset.cfInd]=v; });
    var fDes = cfFchEntDes ? cfFchEntDes.value : '';
    var fHas = cfFchEntHas ? cfFchEntHas.value : '';

    filtered = allData.filter(function(r){
        // filtros texto/select
        for(var key in vals){
            var fn=CF_MAP[key]; if(!fn) continue;
            var cell=fn(r);
            if(key==='colorhexa'){
                var vv=vals[key];
                if(vv==='_none'){ if(r.colorHexa) return false; }
                else { if(cell!==vv) return false; }
                continue;
            }
            if(EXACT_CF[key]){ if(cell!==vals[key]) return false; }
            else { if(!cell.includes(vals[key])) return false; }
        }
        // filtros indicador
        for(var k2 in inds){ var fn2=IND_MAP[k2]; if(!fn2) continue; if(fn2(r)!==inds[k2]) return false; }
        // filtro fecha entrega
        if(fDes||fHas){
            var fe=r.fchEntrega;
            if(!fe) return false;
            // fe es "dd/MM/yy" -> convertir a Date comparable
            var p=fe.split('/'); var dd=parseInt(p[0]),mm=parseInt(p[1])-1,yy=parseInt(p[2]);
            var yr=yy<50?2000+yy:1900+yy;
            var feD=new Date(yr,mm,dd);
            if(fDes){ var fd=new Date(fDes); fd.setHours(0,0,0,0); if(feD<fd) return false; }
            if(fHas){ var fh=new Date(fHas); fh.setHours(23,59,59,999); if(feD>fh) return false; }
        }
        return true;
    });
    if(cntEl) cntEl.textContent = filtered.length;
    curPage=1; renderPage(); updateKpis();
}

// ── renderPage ───────────────────────────────────────────────────────────────
function renderPage() {
    var total=filtered.length, ps=pageSize<=0?total:pageSize;
    var pages=ps>0?Math.max(1,Math.ceil(total/ps)):1;
    if(curPage>pages) curPage=pages;
    var start=(curPage-1)*(ps>0?ps:total), end=ps>0?Math.min(start+ps,total):total;
    var page=filtered.slice(start,end);
    var htmlL='', htmlR='';
    for(var i=0;i<page.length;i++){ var row=buildRow(page[i],start+i); htmlL+=row.l; htmlR+=row.r; }
    tbody.innerHTML=htmlR;
    if(tbodyL) tbodyL.innerHTML=htmlL;
    if(pgInfo) pgInfo.textContent=total===0?'0 registros':(ps<=0?'Todos ('+total+')':(start+1)+'\u2013'+end+' de '+total);
    if(pgPrev) pgPrev.disabled=(curPage<=1);
    if(pgNext) pgNext.disabled=(curPage>=pages);
    if(pgNums){
        var nums='',maxB=7,half=Math.floor(maxB/2),s=Math.max(1,curPage-half),e=Math.min(pages,s+maxB-1);
        if(e-s<maxB-1) s=Math.max(1,e-maxB+1);
        if(s>1){nums+='<button class="pg-btn" data-pg="1">1</button>';if(s>2) nums+='<span style="align-self:center;color:#94a3b8;">\u2026</span>';}
        for(var p=s;p<=e;p++) nums+='<button class="pg-btn'+(p===curPage?' pg-active':'')+'" data-pg="'+p+'">'+p+'</button>';
        if(e<pages){if(e<pages-1) nums+='<span style="align-self:center;color:#94a3b8;">\u2026</span>';nums+='<button class="pg-btn" data-pg="'+pages+'">'+pages+'</button>';}
        pgNums.innerHTML=nums;
        pgNums.querySelectorAll('[data-pg]').forEach(function(btn){
            btn.addEventListener('click',function(){curPage=parseInt(this.dataset.pg);renderPage();});
        });
    }
    // reconectar checkboxes y obs inputs tras render
    bindRowEvents();
    syncRowHeights();
}

