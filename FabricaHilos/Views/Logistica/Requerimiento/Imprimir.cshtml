@model (FabricaHilos.Models.Logistica.RequisicionDto Cabecera, List<FabricaHilos.Models.Logistica.ItemReqDto> Items)
@{
    Layout = null;

    var cab   = Model.Cabecera;
    var items = Model.Items;

    var nombres          = ViewBag.Nombres              as Dictionary<string, string> ?? new Dictionary<string, string>();
    var centrosCosto     = ViewBag.CentrosCosto          as Dictionary<string, string> ?? new Dictionary<string, string>();
    var descsArt         = ViewBag.DescripcionesArticulos as Dictionary<string, string> ?? new Dictionary<string, string>();
    var destinos         = ViewBag.Destinos              as Dictionary<string, string> ?? new Dictionary<string, string>();
    var prioridades      = ViewBag.Prioridades           as Dictionary<string, string> ?? new Dictionary<string, string>();
    var destinosItem     = ViewBag.DestinosItem          as Dictionary<string, string> ?? new Dictionary<string, string>();

    var empresaNombre    = ViewBag.EmpresaNombre    as string ?? "FÁBRICA DE HILOS S.A.";
    var empresaRuc       = ViewBag.EmpresaRuc        as string ?? "";
    var empresaDireccion = ViewBag.EmpresaDireccion  as string ?? "";
    var empresaTelefono  = ViewBag.EmpresaTelefono   as string ?? "";
    var logoPath          = ViewBag.EmpresaLogoPath    as string ?? "";
    var logoAlt           = ViewBag.EmpresaLogoAlt     as string ?? "Logo";
    var empresaNombreCorto = ViewBag.EmpresaNombreCorto as string ?? "";

    _ = centrosCosto.TryGetValue(cab.CentroCosto ?? "", out var nomCc);
    _ = destinos.TryGetValue(cab.Destino ?? "", out var nomDestino);
    _ = prioridades.TryGetValue(cab.Prioridad ?? "", out var nomPrioridad);

    Func<string?, string> fmtPersona = cod => {
        if (string.IsNullOrWhiteSpace(cod)) return "—";
        return nombres.TryGetValue(cod, out var n) && !string.IsNullOrWhiteSpace(n) ? n : cod;
    };

    var estadoTexto = cab.Estado switch {
        "0" => "BORRADOR",
        "1" => "AUTORIZADO",
        "2" => "RECIBIDO",
        "3" => "EN PROCESO",
        "6" => "CERRADO",
        "9" => "ANULADO",
        _   => cab.Estado ?? "—"
    };
    var estadoColor = cab.Estado switch {
        "1" => "#1a5276",
        "2" => "#1e8449",
        "6" => "#6c757d",
        "9" => "#c0392b",
        _   => "#784212"
    };

    var numDoc = $"{cab.NumReq:D6}";

    // Calcular totales
    decimal totalSoles      = items.Where(i => (i.Moneda ?? "S") != "D").Sum(i => i.Cantidad * i.Precio);
    decimal totalDolar      = items.Where(i => (i.Moneda ?? "S") == "D").Sum(i => i.Cantidad * i.Precio);
    decimal igvTasa         = (cab.Impsto ?? 0m) > 0 ? cab.Impsto!.Value : 0.18m;
    bool    afectaIgv       = (cab.AfectoIgv ?? "N") == "S";
    decimal igvSoles        = afectaIgv ? Math.Round(totalSoles * igvTasa, 2) : 0m;
    decimal igvDolar        = afectaIgv ? Math.Round(totalDolar  * igvTasa, 2) : 0m;
    decimal totalFinal      = totalSoles + igvSoles;
    decimal totalFinalDolar = totalDolar  + igvDolar;

    var isoCodigoReq  = ViewBag.IsoCodigoRequerimiento              as string ?? "F - 15";
    var isoFechaReq   = ViewBag.IsoFechaActualizacionRequerimiento    as string ?? "";

    var firmaHecho    = ViewBag.FirmaHecho    as FabricaHilos.Models.Logistica.FirmaOcDto;
    var firmaAprobado = ViewBag.FirmaAprobado as FabricaHilos.Models.Logistica.FirmaOcDto;
    var firmaRecibido = ViewBag.FirmaRecibido as FabricaHilos.Models.Logistica.FirmaOcDto;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>REQ @numDoc — @empresaNombre</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            font-size: 9pt;
            color: #1a1a2e;
            background: #f0f4f8;
        }
        .page {
            width: 210mm;
            min-height: 297mm;
            margin: 10mm auto;
            background: #fff;
            box-shadow: 0 4px 28px rgba(0,0,0,.18);
            border-radius: 3px;
            overflow: hidden;
        }
        .top-stripe {
            height: 7px;
            background: linear-gradient(90deg, #0F2E25 0%, #1B4D3E 55%, #C8A951 100%);
        }
        .doc-header {
            display: flex;
            align-items: stretch;
            border-bottom: 2px solid #1B4D3E;
        }
        .header-left {
            flex: 1;
            padding: 10mm 8mm 6mm 10mm;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .header-logo img {
            max-height: 120px;
            max-width: 260px;
            object-fit: contain;
        }
        .header-logo-placeholder {
            width: 260px;
            height: 120px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #e8f0ec;
            border: 1px solid #a8c4b8;
            border-radius: 3px;
            font-size: 8pt;
            color: #1B4D3E;
            font-weight: 600;
        }
        .header-company {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .header-company .empresa-marca {
            font-size: 11pt;
            font-weight: 800;
            color: #C8A951;
            letter-spacing: .5px;
            margin-bottom: 2px;
        }
        .header-company h1 {
            font-size: 13pt;
            font-weight: 700;
            color: #1B4D3E;
            letter-spacing: -.3px;
            line-height: 1.1;
        }
        .header-company p {
            font-size: 8pt;
            color: #555;
            margin-top: 2px;
            line-height: 1.5;
        }
        .header-right {
            width: 62mm;
            background: #1B4D3E;
            color: #fff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 8mm 6mm;
            gap: 4px;
        }
        .header-right .doc-type {
            font-size: 9pt;
            font-weight: 600;
            letter-spacing: .08em;
            text-transform: uppercase;
            opacity: .85;
            text-align: center;
        }
        .header-right .doc-num {
            font-size: 18pt;
            font-weight: 800;
            letter-spacing: .5px;
            line-height: 1.1;
        }
        .header-right .doc-estado {
            margin-top: 4px;
            font-size: 7.5pt;
            font-weight: 700;
            padding: 2px 10px;
            border-radius: 20px;
            text-transform: uppercase;
            letter-spacing: .05em;
        }
        .header-right .iso-box {
            align-self: stretch;
            background: #fff;
            color: #1a1a2e;
            border: 1px solid #a8c4b8;
            border-radius: 2px;
            text-align: center;
            padding: 3px 8px;
            margin-bottom: 4px;
            line-height: 1.5;
        }
        .header-right .iso-box .iso-code {
            display: block;
            font-size: 8.5pt;
            font-weight: 700;
            text-decoration: underline;
            color: #1a1a2e;
        }
        .header-right .iso-box .iso-fecha {
            display: block;
            font-size: 7.5pt;
            color: #333;
        }
        .section-grid {
            display: flex;
            gap: 0;
            border-bottom: 1px solid #d0dce8;
        }
        .section-col {
            flex: 1;
            padding: 5mm 7mm 4mm;
            border-right: 1px solid #d0dce8;
        }
        .section-col:last-child { border-right: none; }
        .section-title {
            font-size: 7pt;
            font-weight: 700;
            color: #1B4D3E;
            text-transform: uppercase;
            letter-spacing: .07em;
            border-bottom: 1px solid #a8c4b8;
            padding-bottom: 2px;
            margin-bottom: 4px;
        }
        .field-row {
            display: flex;
            align-items: baseline;
            margin-bottom: 2px;
        }
        .field-lbl {
            font-size: 7pt;
            color: #6c7a89;
            font-weight: 600;
            white-space: nowrap;
            min-width: 72px;
            margin-right: 4px;
        }
        .field-val {
            font-size: 8.5pt;
            color: #1a1a2e;
            font-weight: 500;
            word-break: break-word;
        }
        .field-val.highlight {
            color: #1B4D3E;
            font-weight: 700;
        }
        .items-section { padding: 0 7mm 0; }
        .items-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 3mm 0 2mm;
            border-bottom: 2px solid #1B4D3E;
        }
        .items-header h2 {
            font-size: 8pt;
            font-weight: 700;
            color: #1B4D3E;
            text-transform: uppercase;
            letter-spacing: .06em;
        }
        .items-header .badge-items {
            background: #e8f0ec;
            color: #1B4D3E;
            border: 1px solid #a8c4b8;
            font-size: 7pt;
            font-weight: 700;
            padding: 1px 8px;
            border-radius: 20px;
        }
        .oc-table {
            width: 100%;
            border-collapse: collapse;
        }
        .oc-table thead tr { background: #1B4D3E; color: #fff; }
        .oc-table thead th {
            padding: 3px 5px;
            font-size: 7pt;
            font-weight: 600;
            letter-spacing: .03em;
            white-space: nowrap;
            text-align: left;
        }
        .oc-table thead th.r { text-align: right; }
        .oc-table thead th.c { text-align: center; }
        .oc-table tbody tr { border-bottom: 1px solid #e8edf2; }
        .oc-table tbody tr:nth-child(even) td { background: #f0f5f2; }
        .oc-table tbody td {
            padding: 3px 5px;
            font-size: 8pt;
            vertical-align: middle;
        }
        .oc-table tbody td.r { text-align: right; }
        .oc-table tbody td.c { text-align: center; }
        .oc-table tbody td.art-code { font-weight: 700; color: #1B4D3E; font-size: 7.5pt; }
        .oc-table tbody td.desc { color: #222; line-height: 1.3; }
        .oc-table tbody td.num { color: #999; font-size: 7.5pt; text-align: center; }
        .oc-table tfoot td {
            border-top: 2px solid #1B4D3E;
            font-weight: 700;
            padding: 3px 5px;
            font-size: 8pt;
            background: #eef3f1;
        }
        .totals-table { flex: 0 0 auto; min-width: 55mm; }
        .totals-table table { width: 100%; border-collapse: collapse; }
        .totals-table td { padding: 2px 4px; font-size: 8pt; }
        .totals-table .t-lbl { color: #6c7a89; font-size: 7.5pt; text-align: right; padding-right: 8px; }
        .totals-table .t-val { text-align: right; font-weight: 600; color: #1a1a2e; white-space: nowrap; }
        .totals-table tr.grand-total td {
            background: #1B4D3E; color: #fff; font-weight: 700; font-size: 10pt;
        }
        .totals-table tr.grand-total .t-lbl { color: #a8c4b8; }
        .firma-section {
            display: flex;
            padding: 6mm 7mm 5mm;
            gap: 5mm;
            border-bottom: 1px solid #d0dce8;
        }
        .firma-box {
            flex: 1;
            text-align: center;
            padding: 0 4mm;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .firma-img { height: 16mm; max-width: 100%; object-fit: contain; margin-bottom: 1mm; }
        .firma-img-placeholder { height: 16mm; }
        .firma-line { border-top: 1.5px solid #1B4D3E; width: 100%; margin-bottom: 3px; }
        .firma-label { font-size: 7pt; font-weight: 600; color: #1B4D3E; text-transform: uppercase; letter-spacing: .05em; }
        .firma-sublabel { font-size: 7pt; color: #888; }
        .firma-nombre { font-size: 7pt; color: #333; font-weight: 500; }
        .doc-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 3mm 7mm;
            background: #eef3f1;
            border-top: 1px solid #a8c4b8;
        }
        .doc-footer .footer-left { font-size: 7pt; color: #888; }
        .doc-footer .footer-right { font-size: 7pt; color: #888; text-align: right; }
        .bottom-stripe { height: 5px; background: linear-gradient(90deg, #C8A951 0%, #2D7A5F 55%, #0F2E25 100%); }
        .print-bar {
            display: flex;
            justify-content: center;
            gap: 10px;
            padding: 8px;
            background: #fff;
        }
        .btn-print {
            background: #1B4D3E; color: #fff; border: none; border-radius: 4px;
            padding: 6px 22px; font-size: 9pt; font-weight: 600; cursor: pointer;
            display: flex; align-items: center; gap: 6px;
        }
        .btn-print:hover { background: #0F2E25; }
        .btn-close-win {
            background: #6c757d; color: #fff; border: none; border-radius: 4px;
            padding: 6px 16px; font-size: 9pt; cursor: pointer;
        }
        .btn-close-win:hover { background: #5a6268; }
        @@media print {
            html, body { background: #fff !important; margin: 0; padding: 0; }
            .print-bar { display: none !important; }
            .page { width: 100%; min-height: 0; margin: 0; box-shadow: none; border-radius: 0; }
            @@page { size: A4 portrait; margin: 8mm 10mm 10mm; }
            .oc-table tbody tr { page-break-inside: avoid; }
        }
    </style>
</head>
<body>

<div class="print-bar">
    <button class="btn-print" onclick="window.print()">🖨 Imprimir / Guardar PDF</button>
    <button class="btn-close-win" onclick="window.close()">✕ Cerrar</button>
</div>

<div class="page">

    <div class="top-stripe"></div>

    <!-- HEADER -->
    <div class="doc-header">
        <div class="header-left">
            <div class="header-logo">
                @if (!string.IsNullOrWhiteSpace(logoPath))
                {
                    <img src="/@logoPath" alt="@logoAlt" />
                }
                else
                {
                    <div class="header-logo-placeholder">@logoAlt</div>
                }
            </div>
            <div class="header-company">
                @if (!string.IsNullOrWhiteSpace(empresaNombreCorto)) { <div class="empresa-marca">@empresaNombreCorto</div> }
                <h1>@empresaNombre</h1>
                <p>
                    @if (!string.IsNullOrWhiteSpace(empresaRuc))
                    {
                        <span>RUC: <strong>@empresaRuc</strong></span>
                    }
                    @if (!string.IsNullOrWhiteSpace(empresaDireccion))
                    {
                        <br /><span>@empresaDireccion</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(empresaTelefono))
                    {
                        <br /><span>Teléfono: @empresaTelefono</span>
                    }
                </p>
            </div>
        </div>
        <div class="header-right">
            <div class="iso-box">
                <span class="iso-code">@isoCodigoReq</span>
                @if (!string.IsNullOrWhiteSpace(isoFechaReq))
                {
                    <span class="iso-fecha">Actualizado al: @isoFechaReq</span>
                }
            </div>
            <span class="doc-type">REQUERIMIENTO DE COMPRA Y/O SERVICIO</span>
            <span class="doc-num">@numDoc</span>
            <span class="doc-estado" style="background-color:@estadoColor;">@estadoTexto</span>
        </div>
    </div>

    <!-- DATOS GENERALES -->
    <div class="section-grid">
        <div class="section-col">
            <div class="section-title">Datos del Documento</div>
            <div class="field-row">
                <span class="field-lbl">Centro Costos:</span>
                <span class="field-val highlight">@(nomCc ?? cab.CentroCosto ?? "—")</span>
            </div>
            <div class="field-row">
                <span class="field-lbl">Proveedor:</span>
                <span class="field-val">@(cab.Proveedores ?? "SIN PROVEEDOR")</span>
            </div>
            <div class="field-row">
                <span class="field-lbl">F. Emisión:</span>
                <span class="field-val">@(cab.Fecha?.ToString("dd/MM/yyyy") ?? "—")</span>
            </div>
            <div class="field-row">
                <span class="field-lbl">F. Entrega:</span>
                <span class="field-val">@(cab.FEntrega?.ToString("dd/MM/yyyy") ?? "—")</span>
            </div>
        </div>
        <div class="section-col">
            <div class="section-title">Condiciones</div>
            <div class="field-row">
                <span class="field-lbl">Observación:</span>
                <span class="field-val">@(cab.Observacion ?? "—")</span>
            </div>
            <div class="field-row">
                <span class="field-lbl">Prioridad:</span>
                <span class="field-val">@(nomPrioridad ?? cab.Prioridad ?? "—")</span>
            </div>
            <div class="field-row">
                <span class="field-lbl">Destino:</span>
                <span class="field-val">@(nomDestino ?? cab.Destino ?? "—")</span>
            </div>
            <div class="field-row">
                <span class="field-lbl">Responsable:</span>
                <span class="field-val">@fmtPersona(cab.Responsable)</span>
            </div>
        </div>
        <div class="section-col">
            <div class="section-title">Autorización</div>
            @if (cab.FAutoriza.HasValue)
            {
                <div class="field-row">
                    <span class="field-lbl">F. Autoriza:</span>
                    <span class="field-val">@cab.FAutoriza.Value.ToString("dd/MM/yyyy")</span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(cab.Autoriza))
            {
                <div class="field-row">
                    <span class="field-lbl">Autoriza:</span>
                    <span class="field-val">@fmtPersona(cab.Autoriza)</span>
                </div>
            }
            @if (cab.FRecibe.HasValue)
            {
                <div class="field-row">
                    <span class="field-lbl">F. Recibe:</span>
                    <span class="field-val">@cab.FRecibe.Value.ToString("dd/MM/yyyy")</span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(cab.Recibe))
            {
                <div class="field-row">
                    <span class="field-lbl">Recibe:</span>
                    <span class="field-val">@fmtPersona(cab.Recibe)</span>
                </div>
            }
        </div>
    </div>

    <!-- TABLA DE ÍTEMS -->
    <div class="items-section">
        <div class="items-header">
            <h2>Detalle de Ítems</h2>
            <span class="badge-items">@items.Count ítem@(items.Count == 1 ? "" : "s")</span>
        </div>
        <table class="oc-table">
            <thead>
                <tr>
                    <th class="c" style="width:18px;">#</th>
                    <th class="c" style="width:26px;">Cant</th>
                    <th class="c" style="width:24px;">Und</th>
                    <th style="width:62px;">Código</th>
                    <th>Descripción</th>
                    <th style="width:78px;">Sol. Para</th>
                    <th style="width:78px;">Solicitado</th>
                    <th class="r" style="width:52px;">Precio</th>
                    <th class="r" style="width:62px;">Importe</th>
                </tr>
            </thead>
            <tbody>
                @{ int rowNum = 0; }
                @foreach (var it in items)
                {
                    rowNum++;
                    var desc = descsArt.TryGetValue(it.CodArt ?? "", out var da) && !string.IsNullOrWhiteSpace(da)
                                ? da : it.Detalle ?? it.CodArt ?? "—";
                    var destItem = destinosItem.TryGetValue(it.Destino ?? "", out var dd) && !string.IsNullOrWhiteSpace(dd)
                                    ? dd : it.Destino ?? "—";
                    var monSimb = (it.Moneda ?? "S") == "D" ? "US$" : "S/.";
                    var importe = it.Cantidad * it.Precio;
                    var solicitadoNombre = fmtPersona(it.CodSolicita);
                    <tr>
                        <td class="num">@rowNum</td>
                        <td class="c">@it.Cantidad.ToString("N0")</td>
                        <td class="c" style="color:#555;">@(it.Unidad ?? "—")</td>
                        <td class="art-code">@(it.CodArt ?? "—")</td>
                        <td class="desc" style="white-space:normal;word-break:break-word;line-height:1.35;">@desc</td>
                        <td style="font-size:7pt;color:#2c3e50;white-space:nowrap;">@destItem</td>
                        <td style="font-size:7pt;white-space:normal;line-height:1.25;">@solicitadoNombre</td>
                        <td class="r" style="white-space:nowrap;">@monSimb @it.Precio.ToString("N3")</td>
                        <td class="r" style="font-weight:700;white-space:nowrap;">@importe.ToString("N2")</td>
                    </tr>
                }
            </tbody>
                <tfoot>
                <tr>
                    <td colspan="8" style="text-align:left;color:#6c7a89;font-weight:600;padding:3px 5px;">Subtotal</td>
                    <td class="r" style="white-space:nowrap;font-weight:700;">S/. @totalSoles.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>

        <!-- Totales -->
        <div style="display:flex; justify-content:flex-end; padding:.4rem 0 .5rem;">
            <div class="totals-table">
                <table>
                    <tr>
                        <td class="t-lbl">P.VENTA:</td>
                        <td class="t-val">S/. @totalSoles.ToString("N2")</td>
                        <td class="t-val" style="padding-left:8px;">US$ @totalDolar.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td class="t-lbl">IGV:</td>
                        <td class="t-val">S/. @igvSoles.ToString("N2")</td>
                        <td class="t-val" style="padding-left:8px;">@(igvDolar > 0 ? $"US$ {igvDolar:N2}" : "—")</td>
                    </tr>
                    <tr class="grand-total">
                        <td class="t-lbl">P.TOTAL:</td>
                        <td class="t-val">S/. @totalFinal.ToString("N2")</td>
                        <td class="t-val" style="padding-left:8px;">US$ @totalFinalDolar.ToString("N2")</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <!-- FIRMAS -->
    @{
        string? firmaHechoSrc = firmaHecho?.Firma != null && firmaHecho.Firma.Length > 0
            ? FabricaHilos.Services.Logistica.OrdenCompraService.DetectImageMimeType(firmaHecho.Firma) is string mimeH
                ? $"data:{mimeH};base64,{Convert.ToBase64String(firmaHecho.Firma)}"
                : null
            : null;
        string? firmaAprobadoSrc = firmaAprobado?.Firma != null && firmaAprobado.Firma.Length > 0
            ? FabricaHilos.Services.Logistica.OrdenCompraService.DetectImageMimeType(firmaAprobado.Firma) is string mimeA
                ? $"data:{mimeA};base64,{Convert.ToBase64String(firmaAprobado.Firma)}"
                : null
            : null;
        string? firmaRecibidoSrc = firmaRecibido?.Firma != null && firmaRecibido.Firma.Length > 0
            ? FabricaHilos.Services.Logistica.OrdenCompraService.DetectImageMimeType(firmaRecibido.Firma) is string mimeR
                ? $"data:{mimeR};base64,{Convert.ToBase64String(firmaRecibido.Firma)}"
                : null
            : null;
    }
    <div class="firma-section">
        <div class="firma-box">
            @if (firmaHechoSrc != null)
            {
                <img class="firma-img" src="@firmaHechoSrc" alt="Firma" />
            }
            else
            {
                <div class="firma-img-placeholder"></div>
            }
            <div class="firma-line"></div>
            @if (!string.IsNullOrWhiteSpace(firmaHecho?.NombreCompleto))
            {
                <div class="firma-nombre">@firmaHecho!.NombreCompleto</div>
            }
            <div class="firma-label">@(firmaHecho?.RolEtiqueta ?? "HECHO POR")</div>
            <div class="firma-sublabel">@(firmaHecho?.Cargo ?? "")</div>
        </div>
        <div class="firma-box">
            @if (firmaAprobadoSrc != null)
            {
                <img class="firma-img" src="@firmaAprobadoSrc" alt="Firma" />
            }
            else
            {
                <div class="firma-img-placeholder"></div>
            }
            <div class="firma-line"></div>
            @if (!string.IsNullOrWhiteSpace(firmaAprobado?.NombreCompleto))
            {
                <div class="firma-nombre">@firmaAprobado!.NombreCompleto</div>
            }
            <div class="firma-label">@(firmaAprobado?.RolEtiqueta ?? "APROBADO POR")</div>
            <div class="firma-sublabel">@(firmaAprobado?.Cargo ?? "")</div>
        </div>
        <div class="firma-box">
            @if (firmaRecibidoSrc != null)
            {
                <img class="firma-img" src="@firmaRecibidoSrc" alt="Firma" />
            }
            else
            {
                <div class="firma-img-placeholder"></div>
            }
            <div class="firma-line"></div>
            @if (!string.IsNullOrWhiteSpace(firmaRecibido?.NombreCompleto))
            {
                <div class="firma-nombre">@firmaRecibido!.NombreCompleto</div>
            }
            <div class="firma-label">@(firmaRecibido?.RolEtiqueta ?? "RECIBIDO POR")</div>
            <div class="firma-sublabel">@(firmaRecibido?.Cargo ?? "")</div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(cab.Observacion))
    {
        <div style="padding: 3mm 7mm; border-bottom: 1px solid #d0dce8;">
            <span class="section-title">Observaciones</span>
            <p style="font-size:8pt; color:#444; margin-top:3px; line-height:1.4;">@cab.Observacion</p>
        </div>
    }

    <!-- FOOTER -->
    <div class="doc-footer">
        <div class="footer-left">
            @empresaNombre
            @if (!string.IsNullOrWhiteSpace(empresaRuc)) { <text> · RUC: @empresaRuc</text> }
            <br />
            Documento generado el @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
        </div>
        <div class="footer-right">
            <span style="color:#2e86c1;font-weight:700;">Este documento NO tiene validez como comprobante de pago</span>
        </div>
    </div>

    <div class="bottom-stripe"></div>

</div><!-- /page -->

<script>
    if (new URLSearchParams(window.location.search).get('print') === '1') {
        window.addEventListener('load', function () { window.print(); });
    }
</script>
</body>
</html>
