@model dynamic
@using FabricaHilos.Sire.Models
@{
    ViewData["Title"] = "SIRE - Propuesta RVIE";

    var periodo = Model?.Periodo as string ?? string.Empty;
    var registros = Model?.Registros as IReadOnlyList<RegistroVenta> ?? Array.Empty<RegistroVenta>();

    decimal totalBase = registros.Sum(r => r.BaseImponibleGravada);
    decimal totalIgv = registros.Sum(r => r.Igv);
    decimal totalMonto = registros.Sum(r => r.ImporteTotal);
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Contabilidad" asp-action="Index">Contabilidad</a></li>
    <li class="breadcrumb-item"><a asp-controller="Sire" asp-action="Index">SIRE</a></li>
    <li class="breadcrumb-item"><a asp-controller="Sire" asp-action="Ventas">RVIE</a></li>
    <li class="breadcrumb-item active">Detalle</li>
}

<!-- Header -->
<div class="d-flex align-items-center gap-3 mb-4">
    <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center p-2" style="width:48px;height:48px">
        <i class="bi bi-file-text fs-4 text-white"></i>
    </div>
    <div class="flex-grow-1">
        <h4 class="mb-0 fw-semibold">Detalle de Propuesta RVIE</h4>
        <small class="text-muted">Período: @(periodo.Length == 6 ? $"{periodo[..4]}/{periodo[4..]}" : periodo)</small>
    </div>
    <a asp-controller="Sire" asp-action="Ventas" asp-route-periodo="@periodo" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
</div>

<!-- Summary -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small mb-1">Total Comprobantes</div>
                <div class="fs-5 fw-bold text-primary">@registros.Count</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small mb-1">Base Imponible</div>
                <div class="fs-5 fw-bold text-primary">S/ @totalBase.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small mb-1">Monto Total</div>
                <div class="fs-5 fw-bold text-success">S/ @totalMonto.ToString("N2")</div>
            </div>
        </div>
    </div>
</div>

<!-- Registros -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-light">
        <h6 class="mb-0 fw-semibold">Registros incluidos (@registros.Count)</h6>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Moneda</th>
                    <th class="text-end">T/C SUNAT</th>
                    <th>Tipo</th>
                    <th>Comprobante</th>
                    <th>Cliente</th>
                    <th class="text-end">Base</th>
                    <th class="text-end">IGV</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reg in registros)
                {
                    <tr>
                        <td><span class="badge bg-secondary">@reg.CodigoMoneda</span></td>
                        <td class="text-end">@(reg.TipoCambio > 0 ? reg.TipoCambio.ToString("N3") : "—")</td>
                        <td><span class="badge bg-primary">@reg.TipoComprobante</span></td>
                        <td><code>@reg.SerieComprobante-@reg.NumeroComprobante</code></td>
                        <td>@reg.RazonSocialCliente</td>
                        <td class="text-end">S/ @reg.BaseImponibleGravada.ToString("N2")</td>
                        <td class="text-end">S/ @reg.Igv.ToString("N2")</td>
                        <td class="text-end fw-semibold">S/ @reg.ImporteTotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

