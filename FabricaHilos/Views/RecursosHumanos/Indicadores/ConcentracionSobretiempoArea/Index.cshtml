@{
    ViewData["Title"] = "KPI Concentración de Sobretiempo por Área";
    int anoIni = ViewBag.AnoIni;
    int mesIni = ViewBag.MesIni;
    int anoFin = ViewBag.AnoFin;
    int mesFin = ViewBag.MesFin;
}

@section Styles {
<style>
    .chart-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 10px rgba(0,0,0,.08);
        height: 100%;
        background: #f5f5f2;
    }
    .chart-card .card-body  { background: #f0f0ec; border-radius: 0 0 12px 12px; }
    .chart-card .card-header {
        background: transparent;
        color: #1B4D3E;
        font-weight: 600;
        border-bottom: 1px solid #e0e0e0;
        border-radius: 12px 12px 0 0 !important;
    }
    .filter-bar {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,.07);
        padding: .85rem 1.25rem;
        margin-bottom: 1.4rem;
    }
    .kpi-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 10px rgba(0,0,0,.08);
        background: #fff;
        text-align: center;
        padding: 1.1rem .75rem;
    }
    .kpi-card .kpi-icon  { font-size: 2rem; line-height: 1; margin-bottom: .35rem; }
    .kpi-card .kpi-label { font-size: .72rem; color: #637381; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }
    .kpi-card .kpi-value { font-size: 1.75rem; font-weight: 700; color: #1B4D3E; line-height: 1.1; }
    .kpi-card .kpi-sub   { font-size: .72rem; color: #9ca3af; margin-top: .15rem; }
    .section-title {
        font-size: 1rem;
        font-weight: 700;
        color: #1B4D3E;
        margin: 1.4rem 0 .4rem;
        border-left: 4px solid #1B4D3E;
        padding-left: .5rem;
    }
    #kpi-container { min-height: 200px; }
</style>
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a href="/RecursosHumanos">Recursos Humanos</a></li>
    <li class="breadcrumb-item active">KPI Concentración Sobretiempo por Área</li>
}

<!-- ── Filtros ─────────────────────────────────────────────── -->
<div class="filter-bar">
    <form id="frmFiltro" class="d-flex flex-wrap align-items-end gap-3" data-no-loading>
        <div>
            <label class="form-label mb-1 small fw-semibold">Año Inicio</label>
            <input type="number" id="anoIni" name="anoIni" class="form-control form-control-sm" style="width:90px"
                   value="@anoIni" min="2000" max="2099" />
        </div>
        <div>
            <label class="form-label mb-1 small fw-semibold">Mes Inicio</label>
            <select id="mesIni" name="mesIni" class="form-select form-select-sm" style="width:120px">
                @for (int m = 1; m <= 12; m++)
                {
                    if (m == mesIni)
                    { <option value="@m" selected>@System.Globalization.CultureInfo.GetCultureInfo("es-PE").DateTimeFormat.GetMonthName(m)</option> }
                    else
                    { <option value="@m">@System.Globalization.CultureInfo.GetCultureInfo("es-PE").DateTimeFormat.GetMonthName(m)</option> }
                }
            </select>
        </div>
        <div>
            <label class="form-label mb-1 small fw-semibold">Año Fin</label>
            <input type="number" id="anoFin" name="anoFin" class="form-control form-control-sm" style="width:90px"
                   value="@anoFin" min="2000" max="2099" />
        </div>
        <div>
            <label class="form-label mb-1 small fw-semibold">Mes Fin</label>
            <select id="mesFin" name="mesFin" class="form-select form-select-sm" style="width:120px">
                @for (int m = 1; m <= 12; m++)
                {
                    if (m == mesFin)
                    { <option value="@m" selected>@System.Globalization.CultureInfo.GetCultureInfo("es-PE").DateTimeFormat.GetMonthName(m)</option> }
                    else
                    { <option value="@m">@System.Globalization.CultureInfo.GetCultureInfo("es-PE").DateTimeFormat.GetMonthName(m)</option> }
                }
            </select>
        </div>
        <button type="submit" class="btn btn-sm btn-success">
            <i class="bi bi-arrow-clockwise me-1"></i>Consultar
        </button>
    </form>
</div>

<div id="kpi-container">
    <div class="text-center py-5 text-muted">
        <i class="bi bi-people display-4 d-block mb-2"></i>
        Seleccione el período y presione <strong>Consultar</strong> para ver el dashboard.
    </div>
</div>

<!-- ── Ficha Técnica ────────────────────────────────────────── -->
<div class="accordion mt-4" id="accordionFicha">
    <div class="accordion-item border-0 shadow-sm">
        <h2 class="accordion-header" id="headingFicha">
            <button class="accordion-button collapsed fw-semibold" type="button"
                    data-bs-toggle="collapse" data-bs-target="#collapseFicha"
                    aria-expanded="false" aria-controls="collapseFicha"
                    style="background:#f8f9fa; color:#1B4D3E; border-radius:8px;">
                <i class="bi bi-info-circle me-2"></i> Ficha Técnica del Indicador — <span class="ms-1 text-muted fw-normal">ConcentraciónSobretiempoArea</span>
            </button>
        </h2>
        <div id="collapseFicha" class="accordion-collapse collapse" aria-labelledby="headingFicha">
            <div class="accordion-body pt-3" style="background:#fff; border-radius:0 0 8px 8px;">

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <p class="mb-1"><span class="fw-semibold">Nombre:</span> Concentración de Sobretiempo por Área</p>
                        <p class="mb-1"><span class="fw-semibold">Tipo:</span> KPI de Gestión de Personal — Eficiencia Laboral</p>
                        <p class="mb-1"><span class="fw-semibold">Periodicidad:</span> Mensual</p>
                        <p class="mb-1"><span class="fw-semibold">Dimensiones de análisis:</span> Área / Mes / Año</p>
                        <p class="mb-0"><span class="fw-semibold">Fuente de datos:</span> Planilla mensual — conceptos RTPS <code>0105</code> (25%), <code>0106</code> (35%), <code>0107</code> (100%)</p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-1 fw-semibold">Definición:</p>
                        <p class="mb-0 text-secondary small">Mide qué proporción de los trabajadores de cada área generó horas de sobretiempo en el período, permitiendo identificar si la carga extra está distribuida uniformemente o concentrada en pocos colaboradores.</p>
                    </div>
                </div>

                <hr class="my-3">

                <p class="fw-semibold mb-2">Fórmula:</p>
                <div class="text-center mb-4">
                    <div class="p-3 d-inline-block rounded" style="background:#f5f5f2;">
                        <div class="small text-muted fw-semibold mb-2">PCT CON HE</div>
                        <div style="font-size:1rem;">
                            <span style="display:inline-block; text-align:center; line-height:1.6;">
                                <span style="display:block; border-bottom:1.5px solid #374151; padding-bottom:3px;">Trabajadores con sobretiempo &gt; 0</span>
                                <span style="display:block; padding-top:3px;">Total trabajadores</span>
                            </span>
                            &nbsp;× 100
                        </div>
                    </div>
                </div>

                <hr class="my-3">

                <div class="row g-3 mb-4">
                    <div class="col-md-5">
                        <p class="fw-semibold mb-2">Indicadores que expone:</p>
                        <ul class="list-unstyled small mb-0">
                            <li class="mb-1"><code>TOTAL_TRAB</code> — Headcount del área en planilla</li>
                            <li class="mb-1"><code>CON_HE</code> — Trabajadores que cobraron sobretiempo</li>
                            <li class="mb-1"><code>SIN_HE</code> — Trabajadores que no cobraron sobretiempo</li>
                            <li class="mb-1"><code>PCT_CON_HE</code> — Indicador principal (%)</li>
                            <li class="mb-0"><code>PCT_SIN_HE</code> — Complemento (siempre suma 100%)</li>
                        </ul>
                    </div>
                    <div class="col-md-7">
                        <p class="fw-semibold mb-2">Escala de semáforo:</p>
                        <table class="table table-sm table-bordered small mb-0">
                            <thead class="table-dark"><tr><th>Rango %</th><th>Semáforo</th><th>Lectura</th></tr></thead>
                            <tbody>
                                <tr class="table-success"><td>0 – 30%</td><td>🟢 Verde</td><td>HE puntual, controlada</td></tr>
                                <tr class="table-warning"><td>31 – 60%</td><td>🟡 Amarillo</td><td>HE frecuente, revisar carga</td></tr>
                                <tr class="table-danger" ><td>61 – 100%</td><td>🔴 Rojo</td><td>HE sistémica, posible déficit de personal</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <hr class="my-3">

                <p class="fw-semibold mb-2"><i class="bi bi-bar-chart-fill me-1 text-success"></i> Cómo leer los gráficos:</p>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 rounded border small h-100" style="background:#f8fffe;">
                            <p class="fw-semibold mb-1" style="color:#1B4D3E;"><i class="bi bi-bar-chart me-1"></i> Gráfico izquierdo — Barras (% Con HE por área)</p>
                            <ul class="mb-0 ps-3">
                                <li>Las áreas están ordenadas de <strong>mayor a menor % con HE</strong>.</li>
                                <li>Las líneas de referencia muestran los umbrales 30% y 60% del semáforo.</li>
                                <li>El panel <em>"Análisis Automático"</em> clasifica cada área según su semáforo con los datos reales del período.</li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded border small h-100" style="background:#f8fffe;">
                            <p class="fw-semibold mb-1" style="color:#1B4D3E;"><i class="bi bi-bar-chart-steps me-1"></i> Gráfico derecho — Barras apiladas (Con HE vs Sin HE)</p>
                            <ul class="mb-0 ps-3">
                                <li>Cada barra representa el <strong>100% de trabajadores</strong> del área.</li>
                                <li>El segmento rojo = Con HE; el verde = Sin HE.</li>
                                <li>Permite ver de un vistazo qué áreas tienen más trabajadores con HE en proporción.</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <p class="fw-semibold mb-2"><i class="bi bi-intersect me-1 text-success"></i> Cómo combinar el semáforo con el análisis de HE Total:</p>
                <table class="table table-sm table-bordered small mb-0">
                    <thead style="background:#1B4D3E; color:#fff;">
                        <tr><th>% Con HE (semáforo)</th><th>HE Total (alto/bajo)</th><th>Diagnóstico</th><th>Acción sugerida</th></tr>
                    </thead>
                    <tbody>
                        <tr class="table-danger">
                            <td>🔴 &gt;60%</td><td>Alto</td>
                            <td><strong>Área crítica</strong> — muchos trabajan HE y el monto es alto</td>
                            <td>Evaluar contratación urgente</td>
                        </tr>
                        <tr class="table-warning">
                            <td>🔴 &gt;60%</td><td>Bajo</td>
                            <td><strong>Carga repartida pero extendida</strong> — muchos hacen poco HE</td>
                            <td>Revisar si es operativo o estructural</td>
                        </tr>
                        <tr class="table-warning">
                            <td>🟡 31–60%</td><td>Alto</td>
                            <td><strong>Dependencia de pocos</strong> — pocos hacen mucho HE</td>
                            <td>Identificar personas clave, evaluar riesgo</td>
                        </tr>
                        <tr class="table-success">
                            <td>🟢 0–30%</td><td>Bajo</td>
                            <td><strong>Sin problema</strong></td>
                            <td>Mantener seguimiento periódico</td>
                        </tr>
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/lib/chartjs-plugin-datalabels/dist/chartjs-plugin-datalabels.min.js" asp-append-version="true"></script>
<script>
    if (typeof ChartDataLabels !== 'undefined') Chart.register(ChartDataLabels);

    Chart.defaults.font.family = "'Segoe UI', 'Helvetica Neue', Arial, sans-serif";
    Chart.defaults.font.size   = 12;
    Chart.defaults.color       = '#374151';

    document.getElementById('frmFiltro').addEventListener('submit', function (e) {
        e.preventDefault();
        cargarKpi();
    });

    function cargarKpi() {
        const anoIni = document.getElementById('anoIni').value;
        const mesIni = document.getElementById('mesIni').value;
        const anoFin = document.getElementById('anoFin').value;
        const mesFin = document.getElementById('mesFin').value;

        const container = document.getElementById('kpi-container');
        container.innerHTML = `
            <div class="text-center py-5">
                <div class="spinner-border text-success" style="width:2.5rem;height:2.5rem;"></div>
                <p class="mt-3 text-muted small fw-semibold">Cargando datos...</p>
            </div>`;

        fetch(`/RecursosHumanos/ConcentracionSobretiempoArea/Kpi?anoIni=${anoIni}&mesIni=${mesIni}&anoFin=${anoFin}&mesFin=${mesFin}`, { noLoading: true })
            .then(r => {
                if (!r.ok) throw new Error('Error ' + r.status);
                return r.text();
            })
            .then(html => {
                container.innerHTML = html;
                inicializarGraficos();
            })
            .catch(err => {
                container.innerHTML = `<div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>${err.message}</div>`;
            });
    }

    function inicializarGraficos() {
        const rawData = document.getElementById('chartRawData');
        if (!rawData) return;

        const rows = JSON.parse(rawData.value);
        if (!rows || rows.length === 0) return;

        const periodos = [...new Map(rows.map(r => [`${r.ano}-${r.mes}`, r])).keys()];
        const areas    = [...new Set(rows.map(r => r.area))];

        const COLORS = [
            '#1B4D3E','#1565C0','#2e7d32','#e65100','#6a1b9a',
            '#00838f','#c62828','#4e342e','#37474f','#f9a825'
        ];
        const meses = ['','Enero','Febrero','Marzo','Abril','Mayo','Junio',
                       'Julio','Agosto','Setiembre','Octubre','Noviembre','Diciembre'];
        const labelP = k => { const [a, m] = k.split('-'); return `${meses[+m]} ${a}`; };

        const baseOpts = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: true, position: 'top', labels: { boxWidth: 14, font: { size: 11 } } },
                datalabels: { display: false }
            },
            scales: {
                x: { ticks: { maxRotation: 40, minRotation: 20, font: { size: 10 } }, grid: { display: false } },
                y: { beginAtZero: true, max: 100, grid: { color: 'rgba(0,0,0,.06)' },
                     ticks: { callback: v => v + '%' } }
            }
        };

        // ── Gráfico 1: Barras % Con HE con líneas de umbral ─────────────
        const ctxBar = document.getElementById('chartBarPct');
        if (ctxBar) {
            new Chart(ctxBar.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: areas,
                    datasets: periodos.map((p, i) => ({
                        label: labelP(p),
                        data: areas.map(a => { const r = rows.find(x => `${x.ano}-${x.mes}` === p && x.area === a); return r ? r.pctCon : 0; }),
                        backgroundColor: COLORS[i % COLORS.length],
                        borderRadius: 4,
                        borderSkipped: false
                    }))
                },
                options: {
                    ...baseOpts,
                    plugins: {
                        ...baseOpts.plugins,
                        annotation: undefined,
                        tooltip: { callbacks: { label: c => ` ${c.dataset.label}: ${c.parsed.y.toFixed(1)}%` } }
                    }
                }
            });
        }

        // ── Gráfico 2: Barras apiladas 100% Con HE vs Sin HE ────────────
        const ctxStacked = document.getElementById('chartStackedBar');
        if (ctxStacked) {
            // Acumular por área
            const conHe  = areas.map(a => { const r = rows.filter(x => x.area === a); return r.length ? r.reduce((s,x) => s+x.conHe, 0) : 0; });
            const sinHe  = areas.map(a => { const r = rows.filter(x => x.area === a); return r.length ? r.reduce((s,x) => s+x.sinHe, 0) : 0; });
            const totals = areas.map((_, i) => conHe[i] + sinHe[i]);
            const pctCon = areas.map((_, i) => totals[i] > 0 ? Math.round(conHe[i] / totals[i] * 100 * 10) / 10 : 0);
            const pctSin = areas.map((_, i) => totals[i] > 0 ? Math.round(sinHe[i] / totals[i] * 100 * 10) / 10 : 0);

            new Chart(ctxStacked.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: areas,
                    datasets: [
                        { label: 'Con HE (%)', data: pctCon, backgroundColor: '#c0392b', borderRadius: 0 },
                        { label: 'Sin HE (%)', data: pctSin, backgroundColor: '#1B4D3E', borderRadius: 0 }
                    ]
                },
                options: {
                    ...baseOpts,
                    scales: {
                        x: { stacked: true, ticks: { maxRotation: 40, minRotation: 20, font: { size: 10 } }, grid: { display: false } },
                        y: { stacked: true, beginAtZero: true, max: 100, ticks: { callback: v => v + '%' } }
                    },
                    plugins: {
                        ...baseOpts.plugins,
                        tooltip: { callbacks: { label: c => ` ${c.dataset.label}: ${c.parsed.y.toFixed(1)}%` } }
                    }
                }
            });
        }
    }
</script>
}
