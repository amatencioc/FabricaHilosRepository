@model IEnumerable<FabricaHilos.Models.Produccion.Planeamiento.PlnReporteProduccion>

@{
    ViewData["Title"] = "Seguimiento de Programación de Tintorería";

    var items    = Model.ToList();
    var opc      = (string?)ViewBag.StOpc      ?? "POR FECHA DE ENTREGA";
    var iniHtml  = (string?)ViewBag.StIniHtml  ?? DateTime.Today.ToString("yyyy-MM-dd");
    var finHtml  = (string?)ViewBag.StFinHtml  ?? DateTime.Today.AddDays(30).ToString("yyyy-MM-dd");
    var fchIni   = (string?)ViewBag.StFchIni   ?? DateTime.Today.ToString("dd/MM/yyyy");
    var fchFin   = (string?)ViewBag.StFchFin   ?? DateTime.Today.AddDays(30).ToString("dd/MM/yyyy");
    long? numPed = (long?)ViewBag.StNumPed;
    var cliente  = (string?)ViewBag.StCliente;
    var asesor   = (string?)ViewBag.StAsesor;
    var titulo   = (string?)ViewBag.StTitulo;
    var fibra    = (string?)ViewBag.StFibra;
    var proceso  = (string?)ViewBag.StProceso;

    var filtroClientes = (List<FabricaHilos.Models.Produccion.Planeamiento.PlnFiltroCliente>?)ViewBag.FiltroClientes ?? new();
    var filtroAsesores = (List<FabricaHilos.Models.Produccion.Planeamiento.PlnFiltroAsesor>?)ViewBag.FiltroAsesores   ?? new();
    var filtroTitulos  = (List<FabricaHilos.Models.Produccion.Planeamiento.PlnFiltroTitulo>?)ViewBag.FiltroTitulos     ?? new();
    var filtroFibras   = (List<FabricaHilos.Models.Produccion.Planeamiento.PlnFiltroFibra>?)ViewBag.FiltroFibras       ?? new();
    var filtroProcesos = (List<FabricaHilos.Models.Produccion.Planeamiento.PlnFiltroProceso>?)ViewBag.FiltroProcesos   ?? new();

    // Filtro principal Mes / Año
    int? stMes = (int?)ViewBag.StMes;
    int? stAno = (int?)ViewBag.StAno;
    int anoActual = DateTime.Today.Year;
    var nombresMes = new[] { "", "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
                             "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
    bool hayMesAno = stMes.HasValue && stAno.HasValue;

    var opciones = new[]
    {
        "POR FECHA DE ENTREGA",
        "POR PEDIDO",
        "POR FECHA DE PROGRAMA",
        "POR FECHA DE TEÑIDO",
        "POR FECHA APROB PEDIDO"
    };

    bool buscado = Context.Request.Query.Count > 0;

    var conTenido   = buscado ? items.Count(x => x.EntregTenido.HasValue) : 0;
    var conCc       = buscado ? items.Count(x => x.FchAprobCal.HasValue) : 0;
    var despachados = buscado ? items.Count(x => x.KgDespa.HasValue && x.KgDespa > 0) : 0;
    var retrasados  = buscado ? items.Count(x => x.EstaRetrasado) : 0;

    bool hayCliente = !string.IsNullOrEmpty(cliente);
    bool hayAsesor  = !string.IsNullOrEmpty(asesor);
    bool hayTitulo  = !string.IsNullOrEmpty(titulo);
    bool hayFibra   = !string.IsNullOrEmpty(fibra);
    bool hayProceso = !string.IsNullOrEmpty(proceso);

    var nombreCliente = hayCliente ? filtroClientes.FirstOrDefault(x => x.CodCliente == cliente)?.Nombre ?? cliente : null;
    var nombreAsesor  = hayAsesor  ? filtroAsesores.FirstOrDefault(x => x.CodVende   == asesor )?.Nombre ?? asesor  : null;
    var nombreTitulo  = hayTitulo  ? filtroTitulos .FirstOrDefault(x => x.Titulo     == titulo )?.Descripcion ?? titulo : null;
    var nombreFibra   = hayFibra   ? filtroFibras  .FirstOrDefault(x => x.TipoFibra  == fibra  )?.Descripcion ?? fibra  : null;
    var nombreProceso = hayProceso ? filtroProcesos.FirstOrDefault(x => x.Proceso    == proceso)?.Descripcion ?? proceso : null;

    // ── KPIs: equivalentes C# de las fórmulas Excel del DT ───────────────
    // PROMEDIO.SI(<0): promedio solo de los valores negativos (retrasos)
    static double? PromedioSiNeg(IEnumerable<decimal?> vals)
    {
        var neg = vals.Where(v => v.HasValue && v.Value < 0).Select(v => (double)v!.Value).ToList();
        return neg.Count > 0 ? neg.Average() : null;
    }
    // SUBTOTALES(1): promedio simple de todas las filas
    static double? Promedio(IEnumerable<decimal?> vals)
    {
        var nums = vals.Where(v => v.HasValue).Select(v => (double)v!.Value).ToList();
        return nums.Count > 0 ? nums.Average() : null;
    }

    double? kpiRod    = buscado ? PromedioSiNeg(items.Select(r => r.DiasRod))    : null;
    double? kpiMh     = buscado ? PromedioSiNeg(items.Select(r => r.DiasMh))     : null;
    double? kpiRec    = buscado ? Promedio(items.Select(r => r.DiasRec))          : null;
    double? kpiDiasT  = buscado ? Promedio(items.Select(r => r.DiasTenido))      : null;
    // KpiTimeAprov = KpiDiasT (la fórmula Excel usa DIAS T en ambas celdas)
    double? kpiTimeAprov = kpiDiasT;

    // ── Valores únicos para pre-cargar los filtros client-side ────────────
    // Solo se calculan cuando hay data cargada
    static IEnumerable<string> Unicos(IEnumerable<string?> src) =>
        src.Where(v => !string.IsNullOrWhiteSpace(v))
           .Select(v => v!.Trim())
           .Distinct(StringComparer.OrdinalIgnoreCase)
           .OrderBy(v => v);

    var cfMesesDisp  = buscado ? items.Select(r => r.Mes).Where(v => int.TryParse(v, out _))
                                      .Select(v => int.Parse(v!)).Distinct().OrderBy(v => v).ToList()
                               : new List<int>();
    var cfAnosDisp   = buscado ? items.Select(r => r.Ano).Where(v => int.TryParse(v, out _))
                                      .Select(v => int.Parse(v!)).Distinct().OrderBy(v => v).ToList()
                               : new List<int>();
    var cfEstOpts    = buscado ? Unicos(items.Select(r => r.Est)).ToList()           : new List<string>();
    var cfMaqOpts    = buscado ? Unicos(items.Select(r => r.MaqTen)).ToList()        : new List<string>();
    var cfFlujoOpts  = buscado ? Unicos(items.Select(r => r.EstadoFlujo)).ToList()   : new List<string>();
    var cfDespOpts   = buscado ? Unicos(items.Select(r => r.EstadoDespacho)).ToList(): new List<string>();
    var cfAreaOpts   = buscado ? Unicos(items.Select(r => r.AreaResponsable)).ToList(): new List<string>();
    var cfTipoAcOpts = buscado ? Unicos(items.Select(r => r.TipoAcabado)).ToList()   : new List<string>();

    // Datalist para búsqueda por texto libre con sugerencias
    var cfPartidaOpts  = buscado ? Unicos(items.Select(r => r.Partida)).ToList()   : new List<string>();
    var cfClienteOpts  = buscado ? Unicos(items.Select(r => r.Cliente)).ToList()   : new List<string>();
    var cfMaterialOpts = buscado ? Unicos(items.Select(r => r.Material)).ToList()  : new List<string>();
}

@functions {
    // ── Helpers de color para celdas de días (equivalentes al formato condicional Excel) ──

    // Regla general: valor > 0 → fondo rosa #FEA8B4 (retraso)
    static string BgRetraso(decimal? v) => v > 0 ? "background-color:#FEA8B4;" : "";

    // DIAS T usa rosa ligeramente diferente #FE9CB1
    static string BgDiasT(decimal? v) => v > 0 ? "background-color:#FE9CB1;" : "";

    // D.E (signed): solo > 0 es retraso
    static string BgDE(decimal? v) => v > 0 ? "background-color:#FEA8B4;" : "";

    // Columna X — iconSet 3-íconos reverso, showValue=0 (sin número)
    static string IconX(decimal? v)
    {
        return v switch
        {
            null or 0 => "<i class=\"bi bi-circle-fill text-success\" title=\"A tiempo\"></i>",
            1         => "<i class=\"bi bi-circle-fill text-warning\" title=\"1 día retraso\"></i>",
            _         => "<i class=\"bi bi-circle-fill text-danger\"  title=\"Retraso crítico\"></i>"
        };
    }

    // Columna DE — iconSet idéntico a X
    static string IconDE(decimal? v)
    {
        return v switch
        {
            null or 0 => "<i class=\"bi bi-circle-fill text-success\" title=\"Sin espera\"></i>",
            1         => "<i class=\"bi bi-circle-fill text-warning\" title=\"1 día espera\"></i>",
            _         => "<i class=\"bi bi-circle-fill text-danger\"  title=\"En espera crítica\"></i>"
        };
    }

    // Formatea un KPI double? con 1 decimal o guión
    static string Kpi(double? v) => v.HasValue ? v.Value.ToString("F1") : "—";
}

@section Styles {
