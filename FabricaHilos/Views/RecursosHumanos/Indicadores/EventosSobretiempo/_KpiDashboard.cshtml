<script type="application/json" id="dataEmpleadosSobretiempo">@Html.Raw(empleadosJson)</script>
<script type="application/json" id="dataPeriodosSobretiempo">@Html.Raw(periodosJson)</script>
<script type="application/json" id="dataCentrosCostoSobretiempo">@Html.Raw(centrosCostoJson)</script>
