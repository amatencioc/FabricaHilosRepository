@model FabricaHilos.Models.SaludOcupacional.SoDetalleInspeccionViewModel
@{
    ViewData["Title"] = $"Inspección #{Model.Inspeccion.IdInsp} — {Model.Inspeccion.NombreComedor}";    ViewData["IdInsp"] = Model.Inspeccion.IdInsp;
    string CalifCss(string? c) => c switch
    {
        "ACEPTABLE"       => "so-semaforo-ok",
        "CON OBSERVACION" => "so-semaforo-warn",
        "NO ACEPTABLE"    => "so-semaforo-danger",
        _                 => ""
    };
    string PuntajeCss(int p) => p switch { 4 => "so-pts-ok", 2 => "so-pts-warn", _ => "so-pts-ko" };
    var insp = Model.Inspeccion;
    var rubros = Model.Rubros;
    var acciones = Model.Acciones;
}

@section Breadcrumb {
    <li class="breadcrumb-item">
        <a asp-controller="InspeccionCom" asp-action="Historial">Historial</a>
    </li>
    <li class="breadcrumb-item active">Inspección #@insp.IdInsp</li>
}

@section Styles {
    <link rel="stylesheet" href="~/css/so-inspeccion.css" asp-append-version="true" />
}

@section Scripts {
<script>
(function () {
    // Rotar chevron según estado collapse de Bootstrap
    document.querySelectorAll('.so-rubro-toggle').forEach(function (btn) {
        var target = document.querySelector(btn.dataset.bsTarget);
        if (!target) return;
        var chevron = btn.querySelector('.so-chevron');
        target.addEventListener('hide.bs.collapse', function () {
            if (chevron) chevron.style.transform = 'rotate(-90deg)';
        });
        target.addEventListener('show.bs.collapse', function () {
            if (chevron) chevron.style.transform = 'rotate(0deg)';
        });
    });

    // Expandir todos
    document.getElementById('btnExpandAll').addEventListener('click', function () {
        document.querySelectorAll('.so-rubro-toggle').forEach(function (btn) {
            var target = document.querySelector(btn.dataset.bsTarget);
            if (target) bootstrap.Collapse.getOrCreateInstance(target).show();
        });
    });

    // Contraer todos
    document.getElementById('btnCollapseAll').addEventListener('click', function () {
        document.querySelectorAll('.so-rubro-toggle').forEach(function (btn) {
            var target = document.querySelector(btn.dataset.bsTarget);
            if (target) bootstrap.Collapse.getOrCreateInstance(target).hide();
        });
    });
})();
</script>
}

@await Html.PartialAsync("~/Views/SaludOcupacional/InspeccionCom/_SoNavBar.cshtml")

@* ── Strip ──────────────────────────────────────────────────────────────────── *@
<div class="so-strip">
    <i class="bi bi-clipboard2-check" style="color:var(--so-accent-green);font-size:.95rem;flex-shrink:0;"></i>
    <span class="so-strip-title">
        @insp.NombreComedor
        <span class="text-muted fw-normal" style="font-size:.75rem;margin-left:.4rem;">
            @insp.FechaInsp.ToString("dd/MM/yyyy")
        </span>
    </span>
    <span class="so-strip-sep"></span>

    @if (!string.IsNullOrEmpty(insp.Calificacion))
    {
        <span class="so-semaforo @CalifCss(insp.Calificacion)"
              style="font-size:.8rem;padding:.3rem .8rem;font-weight:700;">
            @insp.Calificacion &nbsp;@insp.PctCumpl?.ToString("0.0")%
        </span>
    }

    <span class="so-kpi">
        <i class="bi bi-award" style="color:#fbd38d;"></i>
        <span class="so-kpi-val">@insp.PtsObtenidos.ToString("0") / @insp.PtsMaximo?.ToString("0")</span>
        <span style="opacity:.75">puntos</span>
    </span>

    <span class="ms-auto d-flex gap-2">
        <a asp-controller="InspeccionCom" asp-action="Historial"
           class="btn btn-sm btn-outline-secondary" style="font-size:.75rem;">
            <i class="bi bi-arrow-left"></i> Historial
        </a>
        <a asp-controller="InspeccionCom" asp-action="Hallazgos"
           asp-route-id="@insp.IdInsp"
           class="btn btn-sm btn-outline-warning" style="font-size:.75rem;font-weight:600;"
           title="Ver y gestionar hallazgos de esta inspecci\u00f3n">
            <i class="bi bi-search"></i> Hallazgos
        </a>
        <a asp-controller="InspeccionCom" asp-action="ExportarPdf"
           asp-route-id="@insp.IdInsp"
           class="btn btn-sm" target="_blank" data-no-loading
           style="background:var(--so-teal);color:#fff;font-size:.75rem;font-weight:600;"
           title="Ver PDF en nueva pestaña">
            <i class="bi bi-file-earmark-pdf"></i> PDF
        </a>
    </span>
</div>

<div class="row g-3 mt-0">
    @* ── Col izquierda: datos generales ──────────────────────────────────────── *@
    <div class="col-md-4">
        <div class="so-card mb-3">
            <div class="so-card-header">
                <i class="bi bi-info-circle" style="color:var(--so-teal-mid);"></i>
                <span>Datos generales</span>
            </div>
            <div class="so-card-body">
                <dl class="row mb-0" style="row-gap:.42rem;">
                    <dt class="col-5" style="font-weight:500;color:#6c757d;font-size:.74rem;">Comedor</dt>
                    <dd class="col-7 fw-semibold mb-0" style="font-size:.82rem;">@insp.NombreComedor</dd>

                    <dt class="col-5" style="font-weight:500;color:#6c757d;font-size:.74rem;">Concesionaria</dt>
                    <dd class="col-7 mb-0" style="font-size:.82rem;font-weight:600;">@(insp.NombreConc ?? "—")</dd>

                    <dt class="col-5" style="font-weight:500;color:#6c757d;font-size:.74rem;">Encargada</dt>
                    <dd class="col-7 mb-0" style="font-size:.82rem;font-weight:600;">@(insp.ContactoConc ?? insp.Encargada ?? "—")</dd>

                    <dt class="col-5" style="font-weight:500;color:#6c757d;font-size:.74rem;">Inspector</dt>
                    <dd class="col-7 mb-0" style="font-size:.82rem;">@(insp.Inspector ?? "—")</dd>

                    <dt class="col-5" style="font-weight:500;color:#6c757d;font-size:.74rem;">Médico SSO</dt>
                    <dd class="col-7 mb-0" style="font-size:.82rem;">@(insp.Medico ?? "—")</dd>

                    <dt class="col-5" style="font-weight:500;color:#6c757d;font-size:.74rem;">Hora inicio</dt>
                    <dd class="col-7 mb-0" style="font-size:.82rem;font-weight:600;">@(insp.HoraInsp ?? "—")</dd>

                    <dt class="col-5" style="font-weight:500;color:#6c757d;font-size:.74rem;">Registrado por</dt>
                    <dd class="col-7 mb-0" style="font-size:.76rem;color:#6c757d;">@(insp.UsrCrea ?? "—")</dd>

                    @if (!string.IsNullOrEmpty(insp.Observaciones))
                    {
                        <dt class="col-5" style="font-weight:500;color:#6c757d;font-size:.74rem;">Observación</dt>
                        <dd class="col-7 mb-0" style="font-size:.8rem;">@insp.Observaciones</dd>
                    }
                </dl>
            </div>
        </div>

        @* Resumen por rubro *@
        <div class="so-card">
            <div class="so-card-header">
                <i class="bi bi-bar-chart-line" style="color:var(--so-teal-mid);"></i>
                <span>Resumen por rubro</span>
            </div>
            <div class="so-card-body p-0">
                <table class="so-table w-100 mb-0">
                    <thead>
                        <tr>
                            <th>Rubro</th>
                            <th class="text-center">Pts</th>
                            <th style="width:35%">%</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in rubros)
                        {
                            var pct = r.PtsMaximoRubro > 0
                                      ? r.PtsObtenidosRubro * 100.0 / r.PtsMaximoRubro
                                      : 0;
                            string barCss   = pct >= 75 ? "so-pct-bar-ok"   : pct >= 51 ? "so-pct-bar-warn"   : "so-pct-bar-ko";
                            string badgeCss = pct >= 75 ? "so-pct-badge-ok" : pct >= 51 ? "so-pct-badge-warn" : "so-pct-badge-ko";
                            <tr>
                                <td style="font-size:.78rem;">@r.Rubro.Nombre</td>
                                <td class="text-center" style="font-size:.78rem;white-space:nowrap;font-weight:700;">
                                    @r.PtsObtenidosRubro / @r.PtsMaximoRubro
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="so-pct-badge @badgeCss">
                                            @pct.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%
                                        </span>
                                        <div class="so-pct-bar-track flex-grow-1">
                                            <div class="so-pct-bar @barCss"
                                                 style="width:@(pct.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ── Col derecha: checklist + evidencias + acciones ─────────────────────────────────────── *@
    <div class="col-md-8">

        @* Botones expandir / contraer todos *@
        <div class="d-flex gap-2 mb-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnExpandAll"
                    style="font-size:.72rem;">
                <i class="bi bi-chevron-double-down"></i> Expandir todos
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnCollapseAll"
                    style="font-size:.72rem;">
                <i class="bi bi-chevron-double-up"></i> Contraer todos
            </button>
        </div>

        @* Encabezado de columnas compartido *@
        <div class="so-rubros-colheader">
            <span class="so-col-item">ÍTEM</span>
            <span class="so-col-pts">PTS</span>
            <span class="so-col-hal">HALLAZGO / EVIDENCIAS</span>
        </div>

        @{ int rubroIdx = 0; }
        @foreach (var r in rubros)
        {
            var collapseId = $"rubro-collapse-{rubroIdx}";
            <div class="so-card mb-2">
                <button type="button"
                        class="so-rubro-toggle w-100 text-start border-0"
                        data-bs-toggle="collapse"
                        data-bs-target="#@collapseId"
                        aria-expanded="true"
                        aria-controls="@collapseId">
                    <i class="bi bi-check2-square" style="color:var(--so-teal-mid);"></i>
                    <span>@r.Rubro.Nombre</span>
                    <span class="ms-auto so-kpi" style="padding:.15rem .5rem;">
                        <span style="font-size:.72rem;font-weight:700;">
                            @r.PtsObtenidosRubro / @r.PtsMaximoRubro
                        </span>
                    </span>
                    <i class="bi bi-chevron-down so-chevron ms-2" style="font-size:.7rem;transition:transform .2s;"></i>
                </button>
                <div class="collapse show" id="@collapseId">
                    <div class="so-card-body p-0">
                        <table class="so-table w-100 mb-0 so-rubro-table">
                            <colgroup>
                                <col class="col-item" />
                                <col class="col-pts" />
                                <col class="col-hal" />
                            </colgroup>
                            <thead class="visually-hidden">
                                <tr>
                                    <th>Ítem</th>
                                    <th class="text-center" style="width:60px;">Pts</th>
                                    <th>Hallazgo / Evidencias</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var det in r.Items)
                                {
                                    var hayHallazgo = !string.IsNullOrEmpty(det.Hallazgo);
                                    var evsDetalle  = Model.Evidencias
                                        .Where(e => e.IdDetalle == det.IdDetalle).ToList();
                                    <tr>
                                        <td class="so-col-item" style="font-size:.78rem;line-height:1.4;">
                                            @det.Descripcion
                                        </td>
                                        <td class="so-col-pts text-center">
                                            <span class="so-pts-display @PuntajeCss(det.Puntaje)">
                                                @det.Puntaje
                                            </span>
                                        </td>
                                        <td class="so-col-hal">
                                            @if (hayHallazgo)
                                            {
                                                <div style="font-size:.75rem;color:var(--so-danger-text);
                                                            border-left:3px solid var(--so-danger-border);
                                                            padding-left:.4rem;margin-bottom:.35rem;">
                                                    <i class="bi bi-exclamation-triangle-fill" style="font-size:.65rem;"></i>
                                                    @det.Hallazgo
                                                </div>
                                            }
                                            @if (evsDetalle.Any())
                                            {
                                                <div class="so-evidencias-thumb">
                                                    @foreach (var ev in evsDetalle)
                                                    {
                                                        var urlEv = Url.Action("ServirImagen", "InspeccionCom", new { idInsp = insp.IdInsp, nombreArch = System.IO.Path.GetFileName(ev.RutaArch), tipo = "evi" });
                                                        <a href="@urlEv" target="_blank" class="so-ev-thumb-link"
                                                           title="@ev.Descripcion">
                                                            <img src="@urlEv"
                                                                 alt="@(ev.Descripcion ?? "Evidencia")"
                                                                 class="so-ev-thumb" loading="lazy" />
                                                        </a>
                                                    }
                                                </div>
                                            }
                                            @if (!hayHallazgo && !evsDetalle.Any())
                                            {
                                                <span class="text-muted" style="font-size:.72rem;">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            rubroIdx++;
        }

        @* ── Acciones correctivas ─────────────────────────────────────────────── *@
        @if (acciones.Any())
        {
            <div class="so-card">
                <div class="so-card-header">
                    <i class="bi bi-tools" style="color:var(--so-accent-yellow);"></i>
                    <span>Acciones correctivas (@acciones.Count)</span>
                </div>
                <div class="so-card-body p-0">
                    <table class="so-table w-100 mb-0">
                        <thead>
                            <tr>
                                <th>Descripción</th>
                                <th>Responsable</th>
                                <th class="text-center">Plazo</th>
                                <th class="text-center">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ac in acciones)
                            {
                                <tr class="@(ac.EsVencida ? "so-row-danger" : "")">
                                    <td style="font-size:.78rem;">
                                        @ac.Descripcion
                                        @if (!string.IsNullOrEmpty(ac.Observacion))
                                        {
                                            <div class="text-muted" style="font-size:.7rem;font-style:italic;">
                                                @ac.Observacion
                                            </div>
                                        }
                                    </td>
                                    <td style="font-size:.75rem;">@(ac.Responsable ?? "—")</td>
                                    <td class="text-center text-nowrap" style="font-size:.75rem;">
                                        @if (ac.FchLimite.HasValue)
                                        {
                                            <span class="@(ac.EsVencida ? "text-danger fw-bold" : "")">
                                                @ac.FchLimite.Value.ToString("dd/MM/yyyy")
                                            </span>
                                        }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                    <td class="text-center">
                                        <span class="so-badge @ac.EstadoBadgeCss">
                                            @ac.EstadoLabel
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
