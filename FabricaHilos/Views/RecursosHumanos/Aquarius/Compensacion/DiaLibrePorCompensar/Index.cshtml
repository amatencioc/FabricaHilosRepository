        <div class="d-flex justify-content-between mb-1">
          <span class="text-muted">Fecha:</span>
          <span class="fw-semibold">${r.fechaDestinoStr ?? '—'}</span>
        </div>
        <div class="d-flex justify-content-between mb-1">
          <span class="text-muted">Falta restante:</span>
          <span>${r.destFaltaActual ?? '—'}</span>
        </div>
        <div class="d-flex justify-content-between">
          <span class="text-muted">Hora efectiva:</span>
          <span>${r.destHefecActual ?? '—'}</span>
        </div>
        <div class="mt-2">${desEst}</div>
      </div>
    </div>
  </div>
</div>`;
        document.getElementById('modalEstadoBody').innerHTML = html;
    } catch (e) {
        document.getElementById('modalEstadoBody').innerHTML =
            `<div class="alert alert-danger">Error: ${e.message}</div>`;
    }
}

