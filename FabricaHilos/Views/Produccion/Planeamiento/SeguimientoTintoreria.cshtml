<script>
// ── Ajusta el alto del contenedor de la grilla y compensa la scrollbar horizontal ──
// scrollbar-gutter:stable reserva el espacio de la scrollbar FUERA del contenido,
// pero el frozen-panel (sin scrollbar horizontal) no tiene ese espacio reservado.
// Se mide la scrollbar real del panel derecho y se aplica como padding-bottom al
// frozen-panel para que ambos paneles expongan exactamente la misma altura de filas.
(function ajustarAlturaGrilla() {
    var outer       = document.querySelector('.spt-outer-wrap');
    var footer      = document.querySelector('.spt-footer');
    var scrollPanel = document.querySelector('.spt-scroll-panel');
    var frozenPanel = document.querySelector('.spt-frozen-panel');

    function getHScrollbarHeight(el) {
        // offsetHeight incluye la scrollbar; clientHeight no la incluye
        return el ? (el.offsetHeight - el.clientHeight) : 0;
    }

    function recalc() {
        if (!outer) return;
        var offsetTop = outer.getBoundingClientRect().top + window.scrollY;
        var footerH   = footer ? footer.offsetHeight : 0;
        var available = window.innerHeight - offsetTop - footerH - 8;
        outer.style.maxHeight = Math.max(available, 200) + 'px';

        // Compensar en frozen-panel el espacio de la scrollbar horizontal del derecho
        if (frozenPanel && scrollPanel) {
            var sbH = getHScrollbarHeight(scrollPanel);
            frozenPanel.style.paddingBottom = sbH > 0 ? sbH + 'px' : '';
        }
    }

    recalc();
    window.addEventListener('resize', recalc);
    // Re-calcular tras render de filas (la scrollbar puede aparecer/desaparecer)
    var tbodyEl = document.getElementById('stTbody');
    if (tbodyEl) {
        new MutationObserver(function() { requestAnimationFrame(recalc); })
            .observe(tbodyEl, { childList: true });
    }
})();
</script>
