@{
    ViewData["Title"] = "KPI Incidencias - Sistemas";
}

@section Styles {
<style>
    /* ── layout general ─────────────────────────── */
    .filter-bar {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,.07);
        padding: .85rem 1.25rem;
        margin-bottom: 1.4rem;
    }
    .chart-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 10px rgba(0,0,0,.08);
        background: #f5f5f2;
    }
    .chart-card .card-header {
        background: transparent;
        color: #1B4D3E;
        font-weight: 700;
        border-bottom: 1px solid #e0e0e0;
        border-radius: 12px 12px 0 0 !important;
        font-size: .9rem;
        padding: .65rem 1rem;
    }
    .chart-card .card-body {
        background: #f0f0ec;
        border-radius: 0 0 12px 12px;
    }
    .chart-spinner {
        position: absolute; inset: 0;
        background: rgba(255,255,255,.78);
        display: flex; align-items: center; justify-content: center;
        border-radius: 12px; z-index: 10;
    }
    /* ── sección ─────────────────────────────────── */
    .section-title {
        font-size: 1rem;
        font-weight: 700;
        color: #1B4D3E;
        margin: 1.6rem 0 .25rem;
        border-left: 4px solid #c8a84b;
        padding-left: .55rem;
    }
    .report-desc {
        font-size: .78rem;
        color: #637381;
        margin: 0 0 .85rem .65rem;
        line-height: 1.55;
    }
    /* ── KPI cards ───────────────────────────────── */
    .kpi-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 10px rgba(0,0,0,.08);
        text-align: center;
        padding: 1.1rem .8rem;
        background: #fff;
    }
    .kpi-card .kpi-icon  { font-size: 1.8rem; }
    .kpi-card .kpi-label { font-size: .67rem; color: #637381; font-weight: 700; text-transform: uppercase; margin: .15rem 0; }
    .kpi-card .kpi-value { font-size: 2rem; font-weight: 700; }
    /* ── tabla pivot ─────────────────────────────── */
    .tabla-pivot           { font-size: .79rem; }
    .tabla-pivot th,
    .tabla-pivot td        { vertical-align: middle !important; }
    .tabla-pivot thead th  { text-align: center; }
    .tabla-pivot td.area   { font-weight: 600; padding-left: .75rem; }
    .tabla-pivot td.num    { text-align: center; }
    .tabla-pivot tfoot td  { font-weight: bold; text-align: center; background: #e8f5e9; }
    /* ── tabla mensual ───────────────────────────── */
    .tabla-mes th,
    .tabla-mes td          { vertical-align: middle !important; text-align: center; font-size: .79rem; }
    .tabla-mes td:first-child { text-align: left; font-weight: 600; padding-left: .75rem; }
    .tabla-mes tfoot td    { font-weight: bold; background: #e8f5e9; }
</style>
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a href="/Sistemas">Sistemas</a></li>
    <li class="breadcrumb-item active">KPI Incidencias</li>
}

<!-- ══ DESCRIPCIÓN GENERAL ══════════════════════════════════ -->
<div class="alert mb-3 border-0 rounded-3 shadow-sm" style="background:#fff3e0; border-left:5px solid #e65100 !important; padding:1rem 1.25rem">
    <div class="d-flex align-items-start gap-2">
        <span style="font-size:1.6rem; line-height:1">🔔</span>
        <div>
            <div class="fw-bold" style="color:#e65100; font-size:.95rem">¿Qué mide este indicador?</div>
            <div class="mt-1" style="font-size:.8rem; color:#374151; line-height:1.65">
                El indicador <strong>KPI Incidencias</strong> centraliza el seguimiento de todos los tickets de soporte e incidencias
                gestionados por el equipo de Sistemas. Muestra <strong>cuántas incidencias se crearon</strong> por área y año,
                <strong>cuántas ya fueron resueltas</strong> y <strong>cuántas siguen pendientes</strong>.
                Además incluye el <strong>promedio de minutos de atención</strong> por mes, que mide la agilidad del equipo para cerrar tickets.<br>
                Los tickets con motivo 11 o 16 (Desarrollo) y los anulados (ESTADO = 9) son excluidos del cálculo de tiempos.<br>
                El filtro de <strong>Fecha Inicio / Fin</strong> delimita el período de análisis según la fecha de creación de la incidencia.
                Todos los gráficos y tablas se actualizan al presionar <em>Actualizar</em>.
            </div>
        </div>
    </div>
</div>

<!-- ══ FILTROS ════════════════════════════════════════════ -->
<div class="filter-bar">
    <div class="d-flex flex-wrap align-items-end gap-3">
        <div>
            <label class="form-label mb-1 small fw-semibold">Fecha Inicio</label>
            <input type="date" id="fechaInicio" class="form-control form-control-sm" style="min-width:140px">
        </div>
        <div>
            <label class="form-label mb-1 small fw-semibold">Fecha Fin</label>
            <input type="date" id="fechaFin" class="form-control form-control-sm" style="min-width:140px">
        </div>
        <button class="btn btn-sm btn-success" onclick="loadAll()">
            <i class="bi bi-arrow-clockwise me-1"></i>Actualizar
        </button>
    </div>
</div>

<!-- ══ KPI CARDS ══════════════════════════════════════════ -->
<p class="report-desc mt-1 mb-2" style="font-size:.78rem; color:#637381">
    <i class="bi bi-info-circle me-1"></i>
    Resumen numérico del período consultado. <strong>Total Incidencias</strong> = todos los tickets creados en el rango.
    <strong>Resueltas</strong> = las ya cerradas. <strong>Pendientes</strong> = las que aún están abiertas.
    <strong>Prom. Min.</strong> = promedio de minutos de atención de los tickets cerrados (excluye motivos 11/16 y anulados).
    <strong>Áreas</strong> indica cuántos centros de costo generaron incidencias. Cambian al modificar las fechas y pulsar Actualizar.
</p>
<div class="row g-3 mb-4" id="kpiCards"></div>

<!-- ══════════════════════════════════════════════════════
     SECCIÓN 1 — Incidencias por Área (tabla pivot)
════════════════════════════════════════════════════════ -->
<div class="section-title"><i class="bi bi-table me-1"></i>Incidencias por Área</div>
<p class="report-desc">
    Tabla dinámica que cruza <strong>áreas (filas)</strong> con <strong>años (columnas)</strong>. Por cada celda se muestran dos valores:
    <strong>PEND</strong> (total de incidencias recibidas) y <strong>RESU</strong> (las ya resueltas).
    La diferencia PEND − RESU indica las incidencias que siguen abiertas en ese área y año.<br>
    La columna <em>Total PEND / RESU</em> acumula todos los años visibles. La fila <em>Total general</em> suma todas las áreas.<br>
    <strong>Filtro Fechas:</strong> define qué años aparecen como columnas según la fecha de creación de la incidencia.
</p>
<div class="card chart-card position-relative mb-4">
    <div id="spinnerPivot" class="chart-spinner"><div class="spinner-border text-success"></div></div>
    <div class="card-header"><i class="bi bi-grid-3x2-gap me-1"></i>Detalle por Área y Año</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-bordered tabla-pivot mb-0" id="tablaPivot">
                <thead></thead><tbody></tbody><tfoot></tfoot>
            </table>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════
     SECCIÓN 2 — Atención mensual (tabla + gráfico)
════════════════════════════════════════════════════════ -->
<div class="section-title"><i class="bi bi-calendar3 me-1"></i>Atención mensual <span id="lblAnoAt"></span></div>
<p class="report-desc">
    Detalle mes a mes de las incidencias del <strong>año más reciente</strong> del rango seleccionado.
    Permite detectar meses de alta carga, cuellos de botella o mejoras en la velocidad de respuesta del equipo.<br>
    Cada mes muestra tres categorías: <strong>mismo mes</strong> (resueltas en el mes que se crearon),
    <strong>mes posterior</strong> (cerradas después del mes de creación) y <strong>pendientes</strong> (aún sin cerrar).
    El <strong>%</strong> indica la tasa de resolución inmediata: cuanto mayor, mayor es la agilidad del equipo.<br>
    La columna <strong>Prom. Min.</strong> muestra el tiempo promedio de atención de las incidencias cerradas de ese mes; permite identificar si ciertos meses son más lentos que otros.<br>
    <strong>Filtro Fechas:</strong> al ampliar el rango, el gráfico siempre muestra el año más reciente incluido.
</p>
<div class="row g-3 mb-4">
    <div class="col-lg-5">
        <div class="card chart-card">
            <div class="card-header"><i class="bi bi-table me-1"></i>Tabla de atención mensual</div>
            <div class="px-3 pt-2 pb-0" style="font-size:.74rem; color:#637381; line-height:1.5">
                Incidencias creadas cada mes, clasificadas por momento de cierre: mismo mes (resolución rápida), mes posterior (atención diferida) o pendientes (aún abiertas).
                El <strong>%</strong> muestra qué proporción fue resuelta de forma inmediata. <strong>Prom. Min.</strong> es el tiempo promedio de resolución ese mes.
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-bordered tabla-mes mb-0" id="tablaMes">
                        <thead></thead><tbody></tbody><tfoot></tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card chart-card">
            <div class="card-header"><i class="bi bi-bar-chart-steps me-1"></i>Evolución mensual: resueltos, pendientes y % de resolución inmediata</div>
            <div class="px-3 pt-2 pb-0" style="font-size:.74rem; color:#637381; line-height:1.5">
                Barras apiladas por mes: <strong>azul</strong> = resuelta en el mismo mes, <strong>verde</strong> = resuelta en mes posterior, <strong>naranja</strong> = pendiente.
                La <strong>línea</strong> superpuesta muestra el <strong>% de resolución inmediata</strong> de ese mes (escala derecha).
                Un mes con barra muy naranja indica incidencias acumuladas sin cerrar.
            </div>
            <div class="card-body" style="height:370px">
                <canvas id="chartMes"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════
     SECCIÓN 2b — Promedio de minutos de atención por mes
════════════════════════════════════════════════════════ -->
<div class="section-title"><i class="bi bi-stopwatch me-1"></i>Promedio de minutos de atención mensual <span id="lblAnoMin"></span></div>
<p class="report-desc">
    Mide la <strong>agilidad de respuesta</strong> del equipo: promedio de minutos que tomó resolver cada incidencia en el mes consultado.
    Valores altos indican meses con incidencias complejas o carga elevada; valores bajos reflejan mayor eficiencia operativa.<br>
    <strong>Exclusiones:</strong> se excluyen las incidencias con motivo 11 o 16 (clasificadas como Desarrollo en el indicador de Seguimiento) y las anuladas (ESTADO = 9), ya que no representan tiempos de atención reales.<br>
    <strong>Filtro Fechas:</strong> al ampliar el rango, el gráfico siempre muestra el año más reciente del rango.
</p>
<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="card chart-card">
            <div class="card-header"><i class="bi bi-clock-history me-1"></i>Promedio de minutos de atención por mes</div>
            <div class="card-body" style="height:320px">
                <canvas id="chartMinutos"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════
     SECCIÓN 3 — Recibidos por Año  |  Dona de estado
════════════════════════════════════════════════════════ -->
<div class="section-title"><i class="bi bi-bar-chart-line me-1"></i>Análisis comparativo</div>
<p class="report-desc">
    Visión macro del período: volumen de incidencias por año y proporción global entre resueltas y pendientes.
    Permite identificar tendencias de crecimiento o reducción de la carga de soporte, y evaluar el porcentaje de cumplimiento acumulado.<br>
    <strong>Filtro Fechas:</strong> al ampliar el rango se agregan nuevos años en el gráfico de barras y el cálculo de la dona se recalcula con el total del período.
</p>
<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="card chart-card">
            <div class="card-header"><i class="bi bi-calendar4-range me-1"></i>¿Cuántas incidencias se crearon cada año?</div>
            <div class="px-3 pt-2 pb-0" style="font-size:.74rem; color:#637381; line-height:1.5">
                Cada grupo de barras representa un año. La barra <strong>naranja</strong> = total de incidencias registradas; la <strong>azul</strong> = ya resueltas.
                Si ambas barras son iguales, todas las incidencias de ese año están cerradas. Si la naranja supera a la azul, hay incidencias pendientes de ese año.
            </div>
            <div class="card-body" style="height:360px">
                <canvas id="chartAno"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card chart-card">
            <div class="card-header"><i class="bi bi-pie-chart-fill me-1"></i>¿Cuánto del total está resuelto?</div>
            <div class="px-3 pt-2 pb-0" style="font-size:.74rem; color:#637381; line-height:1.5">
                Proporción global del período completo: <strong>azul</strong> = resueltas, <strong>naranja</strong> = pendientes.
                El porcentaje dentro de cada segmento indica su peso sobre el total de incidencias registradas en el rango consultado.
                Un segmento azul mayoritario indica un alto nivel de resolución del equipo de soporte.
            </div>
            <div class="card-body" style="height:310px; display:flex; align-items:center; justify-content:center;">
                <canvas id="chartDona"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════
     SECCIÓN 4 — Áreas: incidencias y resueltas
════════════════════════════════════════════════════════ -->
<div class="section-title"><i class="bi bi-diagram-3 me-1"></i>Incidencias por Área</div>
<p class="report-desc">
    Ranking horizontal que permite ver, para cada área, cuántas incidencias recibieron y cuántas ya fueron cerradas.
    Identifica las áreas con mayor volumen de soporte y las que tienen mayor cantidad de tickets pendientes.<br>
    <strong>Filtro Fechas:</strong> restringe el análisis a las incidencias creadas en el período indicado.
</p>
<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="card chart-card">
            <div class="card-header"><i class="bi bi-diagram-3 me-1"></i>¿Qué áreas tienen más incidencias y cuántas ya están cerradas?</div>
            <div class="px-3 pt-2 pb-0" style="font-size:.74rem; color:#637381; line-height:1.5">
                Cada fila es un área. La barra <strong>naranja</strong> = total recibido; la <strong>azul</strong> = ya resuelto.
                Si la barra azul alcanza la naranja, el área no tiene incidencias pendientes. Una gran diferencia entre ambas indica tickets sin atender.
                Las áreas sin incidencias no aparecen. Ordenadas alfabéticamente para facilitar la búsqueda.
            </div>
            <div class="card-body p-2">
                <div id="wrapperArea" style="position:relative">
                    <canvas id="chartArea"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════
     SECCIÓN 5 — Avance por Área
════════════════════════════════════════════════════════ -->
<div class="section-title"><i class="bi bi-speedometer2 me-1"></i>Avance de Resolución por Área</div>
<p class="report-desc">
    Mide el <strong>porcentaje de cumplimiento</strong> de cada área: cuántas de sus incidencias ya fueron resueltas respecto al total que ingresó.
    Un valor alto indica que el área está prácticamente al día en soporte; un valor bajo señala una cola de tickets pendientes significativa.<br>
    <strong>Semaforizado:</strong> <span style="color:#2e7d32; font-weight:700">■ Verde ≥ 80 %</span> (buen avance),
    <span style="color:#e65100; font-weight:700">■ Naranja ≥ 50 %</span> (en progreso),
    <span style="color:#c62828; font-weight:700">■ Rojo &lt; 50 %</span> (rezago crítico).
    El número al final de cada barra muestra el porcentaje exacto.
</p>
<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="card chart-card">
            <div class="card-header"><i class="bi bi-speedometer2 me-1"></i>% de avance por área — ¿qué tan adelantada está cada área?</div>
            <div class="px-3 pt-2 pb-0" style="font-size:.74rem; color:#637381; line-height:1.5">
                Cada barra representa el porcentaje de incidencias ya resueltas por área. El color cambia según el umbral:
                <strong style="color:#2e7d32">verde</strong> ≥ 80 %, <strong style="color:#e65100">naranja</strong> ≥ 50 %, <strong style="color:#c62828">rojo</strong> &lt; 50 %.
                El número al extremo de cada barra indica el porcentaje exacto. Áreas ordenadas alfabéticamente.
            </div>
            <div class="card-body p-2">
                <div id="wrapperAvance" style="position:relative">
                    <canvas id="chartAvance"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de error -->
<div class="modal fade" id="modalErrorInc" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger">
            <div class="modal-header bg-danger text-white py-2">
                <h6 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Error al cargar el dashboard</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1 text-muted small">Se produjo un error al obtener los datos desde el servidor. Detalle:</p>
                <pre id="modalErrorDetalle" class="bg-light border rounded p-2 small mb-0" style="white-space:pre-wrap; max-height:260px; overflow:auto"></pre>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/lib/chartjs-plugin-datalabels/dist/chartjs-plugin-datalabels.min.js" asp-append-version="true"></script>
<script>
(function () {
    'use strict';

    if (typeof ChartDataLabels !== 'undefined') Chart.register(ChartDataLabels);
    Chart.defaults.font.family = "'Segoe UI','Helvetica Neue',Arial,sans-serif";
    Chart.defaults.font.size   = 12;
    Chart.defaults.color       = '#374151';

    /* ── Paleta ───────────────────────────────── */
    const COLORS = [
        '#1B4D3E','#1565C0','#e65100','#6a1b9a','#00838f',
        '#c62828','#4e342e','#37474f','#f9a825','#ad1457',
        '#283593','#ef6c00','#2e7d5e','#00695c','#558b2f'
    ];
    const AÑO_BG      = ['#d1e9ff','#d4edda','#fff3cd','#f8d7da','#e2d9f3'];
    const AÑO_ENTR_BG = ['#1565C0','#28a745','#e65100','#dc3545','#7c4dff'];

    const charts = {};
    const destroy = k => { if (charts[k]) { charts[k].destroy(); delete charts[k]; } };

    /* ── Fechas por defecto ───────────────────── */
    function setDefaultDates() {
        const hoy = new Date(), ini = new Date(hoy.getFullYear(), 0, 1);
        const iso = d => d.toISOString().slice(0, 10);
        document.getElementById('fechaInicio').value = iso(ini);
        document.getElementById('fechaFin').value    = iso(hoy);
    }

    function buildParams() {
        const p = new URLSearchParams();
        const fi = document.getElementById('fechaInicio').value;
        const ff = document.getElementById('fechaFin').value;
        if (fi) p.set('fechaInicio', fi);
        if (ff) p.set('fechaFin',    ff);
        return p;
    }

    /* ══════════════════════════════════════════
       KPI CARDS
    ══════════════════════════════════════════ */
    function renderKpis(d) {
        const cards = [
            { icon: '🔔', label: 'Total Recibidas',      value: d.totalRecibidos,  color: '#1B4D3E' },
            { icon: '⏳', label: 'Pendientes Abiertas',  value: d.totalPendientes, color: '#e65100' },
            { icon: '✅', label: 'Total Resueltas',       value: d.totalEntregados, color: '#1565C0' },
            { icon: '📊', label: '% Atención ' + d.anoAtencion, value: d.pctAtencionAno + '%', color: '#2e7d32' },
        ];
        document.getElementById('kpiCards').innerHTML = cards.map(c => `
            <div class="col-6 col-xl-3">
                <div class="kpi-card" style="border-top:4px solid ${c.color}">
                    <div class="kpi-icon">${c.icon}</div>
                    <div class="kpi-label">${c.label}</div>
                    <div class="kpi-value" style="color:${c.color}">${c.value}</div>
                </div>
            </div>`).join('');
    }

    /* ══════════════════════════════════════════
       SECCIÓN 1 — Tabla pivot (colores por año)
    ══════════════════════════════════════════ */
    function renderPivot(d) {
        const t = document.getElementById('tablaPivot');
        const a = d.anos || [];

        let h1 = `<tr>
            <th rowspan="2" class="text-start align-middle ps-3"
                style="background:#e8eaf6; min-width:190px;">ÁREA</th>`;
        a.forEach((an, i) => {
            h1 += `<th colspan="2" class="text-center"
                       style="background:${AÑO_BG[i % AÑO_BG.length]};
                              border-bottom:3px solid ${AÑO_ENTR_BG[i % AÑO_ENTR_BG.length]};">
                       <strong>${an}</strong></th>`;
        });
        h1 += `<th rowspan="2" class="text-center align-middle"
                   style="background:#c8e6da; color:#1B4D3E; min-width:72px;">Total<br>PEND</th>
               <th rowspan="2" class="text-center align-middle"
                   style="background:#bbdefb; color:#1565C0; min-width:72px;">Total<br>RESU</th></tr>`;

        let h2 = '<tr>';
        a.forEach((_, i) => {
            const bg = AÑO_BG[i % AÑO_BG.length];
            h2 += `<th class="text-center" style="background:${bg}; font-size:.74rem; min-width:52px;">PEND</th>
                   <th class="text-center" style="background:${bg}; font-size:.74rem; min-width:52px;">RESU</th>`;
        });
        h2 += '</tr>';
        t.tHead.innerHTML = h1 + h2;

        t.tBodies[0].innerHTML = (d.filas || []).map(f => {
            let row = `<tr><td class="area">${f.area}</td>`;
            f.anos.forEach((c, i) => {
                const bg = AÑO_BG[i % AÑO_BG.length];
                const ec = AÑO_ENTR_BG[i % AÑO_ENTR_BG.length];
                row += `<td class="num" style="background:${bg}44">${c.pendiente || ''}</td>`;
                row += `<td class="num" style="background:${bg}44; color:${ec}; font-weight:600">${c.entregado || ''}</td>`;
            });
            row += `<td class="num" style="background:#eafaf1; color:#1B4D3E; font-weight:700">${f.totalPendiente || ''}</td>
                    <td class="num" style="background:#e3f2fd; color:#1565C0; font-weight:700">${f.totalEntregado || ''}</td>`;
            return row + '</tr>';
        }).join('');

        let foot = '<tr><td class="text-center fw-bold">Total general</td>';
        (d.totalesAno || []).forEach((c, i) => {
            const bg = AÑO_BG[i % AÑO_BG.length];
            const ec = AÑO_ENTR_BG[i % AÑO_ENTR_BG.length];
            foot += `<td style="background:${bg}66">${c.pendiente || ''}</td>
                     <td style="background:${bg}66; color:${ec}; font-weight:700">${c.entregado || ''}</td>`;
        });
        foot += `<td style="color:#1B4D3E; font-weight:700">${d.gtPendiente || ''}</td>
                 <td style="color:#1565C0; font-weight:700">${d.gtEntregado || ''}</td></tr>`;
        t.tFoot.innerHTML = foot;
    }

    /* ══════════════════════════════════════════
       SECCIÓN 2 — Tabla mensual + Chart mixto
    ══════════════════════════════════════════ */
    function renderMes(d) {
        document.getElementById('lblAnoAt').textContent  = d.anoAtencion;
        document.getElementById('lblAnoMin').textContent = d.anoAtencion;
        const data = d.atencionMes || [];

        const tab = document.getElementById('tablaMes');
        tab.tHead.innerHTML = `
            <tr style="background:#c5d9f7">
                <th rowspan="2" class="text-start align-middle ps-2" style="min-width:88px">MES</th>
                <th rowspan="2" class="align-middle">REQ</th>
                <th colspan="2" class="text-center" style="background:#9fbef0">ATENCIÓN</th>
                <th rowspan="2" class="align-middle" style="background:#fde8c8">PEND</th>
                <th rowspan="2" class="align-middle">%</th>
            </tr>
            <tr style="background:#bcd1f0">
                <th>MES</th><th>SIG.MES</th>
            </tr>`;

        tab.tBodies[0].innerHTML = data.map(r => {
            const color = r.pctMismoMes >= 80 ? '#2e7d32' : r.pctMismoMes >= 50 ? '#e65100' : '#c62828';
            return `<tr>
                <td class="text-start">${r.etiqueta}</td>
                <td>${r.recibidos}</td>
                <td style="color:#1565C0; font-weight:700">${r.atMismoMes || ''}</td>
                <td style="color:#1B4D3E">${r.atSigMes || ''}</td>
                <td style="color:#e65100; font-weight:700">${r.pendientes || ''}</td>
                <td><span class="badge" style="background:${color}; font-size:.72rem">${r.pctMismoMes}%</span></td>
            </tr>`;
        }).join('');

        const tot = data.reduce((s, r) => ({
            rec: s.rec + r.recibidos, mismo: s.mismo + r.atMismoMes,
            sig: s.sig + r.atSigMes,  pend: s.pend + r.pendientes
        }), { rec: 0, mismo: 0, sig: 0, pend: 0 });
        const totColor = d.pctAtencionAno >= 80 ? '#2e7d32' : d.pctAtencionAno >= 50 ? '#e65100' : '#c62828';
        tab.tFoot.innerHTML = `
            <tr>
                <td class="text-start">TOTAL</td>
                <td>${tot.rec}</td>
                <td style="color:#1565C0; font-weight:700">${tot.mismo}</td>
                <td style="color:#1B4D3E">${tot.sig}</td>
                <td style="color:#e65100; font-weight:700">${tot.pend || ''}</td>
                <td><span class="badge" style="background:${totColor}; font-size:.78rem">${d.pctAtencionAno}%</span></td>
            </tr>`;

        // Chart mixto barras apiladas + línea %
        destroy('mes');
        if (!data.length) return;
        charts.mes = new Chart(document.getElementById('chartMes').getContext('2d'), {
            data: {
                labels: data.map(r => r.etiqueta),
                datasets: [
                    {
                        type: 'bar', label: 'Resueltas mismo mes',
                        data: data.map(r => r.atMismoMes),
                        backgroundColor: 'rgba(21,101,192,0.82)',
                        borderColor: '#1565C0', borderWidth: 1,
                        stack: 'a', yAxisID: 'y',
                        datalabels: {
                            display: ctx => ctx.dataset.data[ctx.dataIndex] > 0,
                            anchor: 'center', align: 'center',
                            color: '#fff', font: { size: 11, weight: '700' },
                            textStrokeColor: 'rgba(0,0,0,.4)', textStrokeWidth: 2,
                            formatter: v => v
                        }
                    },
                    {
                        type: 'bar', label: 'Resueltas mes siguiente',
                        data: data.map(r => r.atSigMes),
                        backgroundColor: 'rgba(27,77,62,0.72)',
                        borderColor: '#1B4D3E', borderWidth: 1,
                        stack: 'a', yAxisID: 'y',
                        datalabels: {
                            display: ctx => ctx.dataset.data[ctx.dataIndex] > 0,
                            anchor: 'center', align: 'center',
                            color: '#fff', font: { size: 11, weight: '700' },
                            textStrokeColor: 'rgba(0,0,0,.4)', textStrokeWidth: 2,
                            formatter: v => v
                        }
                    },
                    {
                        type: 'bar', label: 'Pendientes',
                        data: data.map(r => r.pendientes),
                        backgroundColor: 'rgba(230,81,0,0.82)',
                        borderColor: '#e65100', borderWidth: 1,
                        stack: 'a', yAxisID: 'y',
                        datalabels: {
                            display: ctx => ctx.dataset.data[ctx.dataIndex] > 0,
                            anchor: 'center', align: 'center',
                            color: '#fff', font: { size: 11, weight: '700' },
                            textStrokeColor: 'rgba(0,0,0,.4)', textStrokeWidth: 2,
                            formatter: v => v
                        }
                    },
                    {
                        type: 'line', label: '% Resueltas en el mismo mes',
                        data: data.map(r => r.pctMismoMes),
                        borderColor: '#111', backgroundColor: 'rgba(0,0,0,0.06)',
                        borderWidth: 2.5, pointRadius: 6,
                        pointBackgroundColor: '#111', pointBorderColor: '#fff', pointBorderWidth: 2,
                        tension: 0.3, yAxisID: 'y1',
                        datalabels: {
                            display: true, anchor: 'top', align: 'top',
                            color: '#000', font: { size: 11, weight: '700' },
                            borderColor: '#fff', borderWidth: 1, borderRadius: 3,
                            backgroundColor: 'rgba(255,255,255,0.75)',
                            padding: { top: 1, bottom: 1, left: 3, right: 3 },
                            formatter: v => v + '%'
                        }
                    }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { position: 'top', labels: { boxWidth: 13, padding: 12 } },
                    datalabels: {}
                },
                layout: { padding: { top: 30 } },
                scales: {
                    y:  { beginAtZero: true, stacked: true, ticks: { stepSize: 3 },
                          title: { display: true, text: 'Cantidad', font: { size: 11 } },
                          grid: { color: 'rgba(0,0,0,.06)' } },
                    y1: { beginAtZero: true, max: 100, position: 'right',
                          grid: { drawOnChartArea: false },
                          ticks: { callback: v => v + '%', stepSize: 10 },
                          title: { display: true, text: '% Atención', font: { size: 11 } } },
                    x:  { grid: { display: false } }
                }
            }
        });

        // Chart promedio de minutos — usa d.minutosMes (query 2 independiente)
        destroy('minutos');
        const datMin = (d.minutosMes || []).filter(r => r.promedioMinutos > 0);
        if (!datMin.length) return;
        charts.minutos = new Chart(document.getElementById('chartMinutos').getContext('2d'), {
            type: 'bar',
            data: {
                labels: datMin.map(r => r.etiqueta),
                datasets: [{
                    label: 'Promedio minutos de atención',
                    data: datMin.map(r => r.promedioMinutos),
                    backgroundColor: 'rgba(27,77,62,0.75)',
                    borderColor: '#1B4D3E', borderWidth: 1, borderRadius: 5,
                    datalabels: {
                        display: true, anchor: 'end', align: 'top',
                        color: '#374151', font: { size: 11, weight: '700' },
                        textStrokeColor: 'rgba(255,255,255,.9)', textStrokeWidth: 3,
                        formatter: v => v.toLocaleString('es-PE')
                    }
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { position: 'top', labels: { boxWidth: 13, padding: 12 } } },
                layout: { padding: { top: 30 } },
                scales: {
                    y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,.06)' },
                         title: { display: true, text: 'Minutos', font: { size: 11 } } },
                    x: { grid: { display: false } }
                }
            }
        });
    }

    /* ══════════════════════════════════════════
       SECCIÓN 3a — Recibidos por Año
    ══════════════════════════════════════════ */
    function renderChartAno(d) {
        destroy('ano');
        const data = (d.porAno || []).filter(x => x.pendiente > 0 || x.entregado > 0);
        if (!data.length) return;
        charts.ano = new Chart(document.getElementById('chartAno').getContext('2d'), {
            type: 'bar',
            data: {
                labels: data.map(r => String(r.ano)),
                datasets: [
                    {
                        label: 'Recibidas (total)',
                        data: data.map(r => r.pendiente),
                        backgroundColor: data.map((_, i) => COLORS[i % COLORS.length] + 'CC'),
                        borderColor:     data.map((_, i) => COLORS[i % COLORS.length]),
                        borderWidth: 1, borderRadius: 5,
                        datalabels: {
                            display: true, anchor: 'end', align: 'top',
                            color: '#374151', font: { size: 12, weight: '700' },
                            textStrokeColor: 'rgba(255,255,255,.9)', textStrokeWidth: 3,
                            formatter: v => v
                        }
                    },
                    {
                        label: 'Resueltas',
                        data: data.map(r => r.entregado),
                        backgroundColor: 'rgba(21,101,192,0.75)',
                        borderColor: '#1565C0', borderWidth: 1, borderRadius: 5,
                        datalabels: {
                            display: true, anchor: 'end', align: 'top',
                            color: '#1565C0', font: { size: 12, weight: '700' },
                            textStrokeColor: 'rgba(255,255,255,.9)', textStrokeWidth: 3,
                            formatter: v => v
                        }
                    }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { position: 'top', labels: { boxWidth: 13, padding: 12 } } },
                layout: { padding: { top: 30 } },
                scales: {
                    y: { beginAtZero: true, ticks: { stepSize: 7 }, grid: { color: 'rgba(0,0,0,.06)' } },
                    x: { grid: { display: false } }
                }
            }
        });
    }

    /* ══════════════════════════════════════════
       SECCIÓN 3b — Pendientes vs Resueltas x Área
    ══════════════════════════════════════════ */
    function renderChartArea(d) {
        destroy('area');
        const data = [...(d.porArea || [])].sort((a, b) => a.area.localeCompare(b.area, 'es')).slice(0, 50);
        if (!data.length) return;

        const rowH   = 38;
        const minH   = 220;
        const height = Math.max(minH, data.length * rowH + 60);
        const wrapper = document.getElementById('wrapperArea');
        wrapper.style.height = height + 'px';

        charts.area = new Chart(document.getElementById('chartArea').getContext('2d'), {
            type: 'bar',
            data: {
                labels: data.map(r => r.area),
                datasets: [
                    {
                        label: 'Recibidas (total)',
                        data: data.map(r => r.totalPendiente),
                        backgroundColor: 'rgba(230,81,0,0.82)',
                        borderColor: '#e65100', borderWidth: 1, borderRadius: 3,
                        datalabels: {
                            display: ctx => ctx.dataset.data[ctx.dataIndex] > 0,
                            anchor: 'end', align: 'right',
                            color: '#374151', font: { size: 11, weight: '700' },
                            textStrokeColor: 'rgba(255,255,255,.8)', textStrokeWidth: 3,
                            formatter: v => v
                        }
                    },
                    {
                        label: 'Resueltas',
                        data: data.map(r => r.totalEntregado),
                        backgroundColor: 'rgba(21,101,192,0.82)',
                        borderColor: '#1565C0', borderWidth: 1, borderRadius: 3,
                        datalabels: {
                            display: ctx => ctx.dataset.data[ctx.dataIndex] > 0,
                            anchor: 'end', align: 'right',
                            color: '#1565C0', font: { size: 11, weight: '700' },
                            textStrokeColor: 'rgba(255,255,255,.8)', textStrokeWidth: 3,
                            formatter: v => v
                        }
                    }
                ]
            },
            options: {
                indexAxis: 'y', responsive: true, maintainAspectRatio: false,
                plugins: { legend: { position: 'top', labels: { boxWidth: 13, padding: 12 } },
                           tooltip: { mode: 'nearest', intersect: true } },
                layout: { padding: { right: 40 } },
                scales: {
                    x: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: 'rgba(0,0,0,.06)' } },
                    y: { ticks: { font: { size: 11 } } }
                }
            }
        });
    }

    /* ══════════════════════════════════════════
       SECCIÓN 3b — Dona: estado global
    ══════════════════════════════════════════ */
    function renderChartDona(d) {
        destroy('dona');
        const entr  = d.totalEntregados || 0;
        const pend  = d.totalPendientes || 0;
        if (entr + pend === 0) return;

        const gran = entr + pend;
        charts.dona = new Chart(document.getElementById('chartDona').getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: ['Resueltas', 'Pendientes abiertas'],
                datasets: [{
                    data: [entr, pend],
                    backgroundColor: ['rgba(21,101,192,0.82)', 'rgba(230,81,0,0.82)'],
                    borderColor:     ['#1565C0', '#e65100'],
                    borderWidth: 2, hoverOffset: 8
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                cutout: '60%',
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 13, padding: 14 } },
                    tooltip: {
                        callbacks: {
                            label: ctx => `${ctx.label}: ${ctx.raw} (${(ctx.raw / gran * 100).toFixed(1)}%)`
                        }
                    },
                    datalabels: {
                        display: true, color: '#fff',
                        font: { size: 13, weight: '700' },
                        textStrokeColor: 'rgba(0,0,0,.4)', textStrokeWidth: 2,
                        formatter: (v, ctx) => {
                            const pct = gran > 0 ? (v / gran * 100).toFixed(0) : 0;
                            return pct >= 8 ? pct + '%' : '';
                        }
                    }
                }
            }
        });
    }

    /* ══════════════════════════════════════════
       SECCIÓN 5 — Barras horizontales: % avance x área
    ══════════════════════════════════════════ */
    function renderChartAvance(d) {
        destroy('avance');
        const data = [...(d.porArea || [])]
            .filter(r => r.totalPendiente > 0)
            .map(r => ({
                area: r.area,
                pct:  r.totalPendiente > 0
                    ? Math.round(r.totalEntregado / r.totalPendiente * 100)
                    : 0
            }))
            .sort((a, b) => a.area.localeCompare(b.area, 'es'));
        if (!data.length) return;

        const rowH    = 38;
        const minH    = 220;
        const height  = Math.max(minH, data.length * rowH + 60);
        const wrapper = document.getElementById('wrapperAvance');
        wrapper.style.height = height + 'px';

        charts.avance = new Chart(document.getElementById('chartAvance').getContext('2d'), {
            type: 'bar',
            data: {
                labels: data.map(r => r.area),
                datasets: [{
                    label: '% Resuelto',
                    data: data.map(r => r.pct),
                    backgroundColor: data.map(r =>
                        r.pct >= 80 ? 'rgba(46,125,50,0.82)'
                       : r.pct >= 50 ? 'rgba(230,81,0,0.78)'
                       :               'rgba(198,40,40,0.78)'),
                    borderColor: data.map(r =>
                        r.pct >= 80 ? '#2e7d32' : r.pct >= 50 ? '#e65100' : '#c62828'),
                    borderWidth: 1, borderRadius: 4,
                    datalabels: {
                        display: true, anchor: 'end', align: 'right',
                        color: '#374151', font: { size: 11, weight: '700' },
                        textStrokeColor: 'rgba(255,255,255,.8)', textStrokeWidth: 3,
                        formatter: v => v + '%'
                    }
                }]
            },
            options: {
                indexAxis: 'y', responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: ctx => `Avance: ${ctx.raw}%` } }
                },
                layout: { padding: { right: 50 } },
                scales: {
                    x: { beginAtZero: true, max: 100, ticks: { callback: v => v + '%' },
                         grid: { color: 'rgba(0,0,0,.06)' } },
                    y: { ticks: { font: { size: 11 } } }
                }
            }
        });
    }

    /* ══════════════════════════════════════════
       Carga global
    ══════════════════════════════════════════ */
    async function loadAll() {
        document.getElementById('spinnerPivot').style.display = 'flex';
        try {
            const url = '/Sistemas/Incidencia/DatosDashboard?' + buildParams().toString();
            const r   = await fetch(url, { cache: 'no-store' });
            if (!r.ok) throw new Error(await r.text());
            const d = await r.json();

            renderKpis(d);
            renderPivot(d);       // Sección 1
            renderMes(d);         // Sección 2 + promedio minutos
            renderChartAno(d);    // Sección 3a
            renderChartArea(d);   // Sección 3b
            renderChartDona(d);   // Sección 3c
            renderChartAvance(d); // Sección 5
        } catch (e) {
            console.error(e);
            document.getElementById('modalErrorDetalle').textContent = e.message || String(e);
            new bootstrap.Modal(document.getElementById('modalErrorInc')).show();
        } finally {
            document.getElementById('spinnerPivot').style.display = 'none';
        }
    }
    window.loadAll = loadAll;

    setDefaultDates();
    loadAll();
})();
</script>
}
