@model FabricaHilos.Models.Produccion.Planeamiento.PlnPedidoViewModel
@using FabricaHilos.Models.Produccion.Planeamiento

@{
    ViewData["Title"] = $"Pedido {Model.Serie}-{Model.NumPed}";
    var primerItem = Model.Items.FirstOrDefault();
    var pasoMap    = Model.Pasos.ToDictionary(p => p.CodPaso);
    // Un ítem por NRO: mayor NroCiclo (reprocesos) y, en empate, peor avance (el que más atención necesita)
    var itemsActivos = Model.Items
        .GroupBy(x => x.Nro)
        .Select(g => g
            .OrderByDescending(x => x.NroCiclo)
            .ThenBy(x => x.PctAvance)          // peor estado primero cuando mismo ciclo
            .First())
        .ToList();

    // ── Timeline ApexCharts: estimado vs. real (primer sublote) ──────────
    var tlEstData  = new System.Collections.Generic.List<object>();
    var tlRealData = new System.Collections.Generic.List<object>();
    Func<DateTime, string> tlFmt = d => d.Date.ToString("yyyy-MM-dd");

    // ── Máquinas TT ─────────────────────────────────────────────────────────────────
    var maqStepsTT = new HashSet<string> { "06", "07", "08", "09", "09B", "9R" };
    // Devuelve nombre completo p.ej. "Rodete Nº5 · THIES" o "Madejas Nº3 · HANK"
    Func<string?, string> maqNombre = cod => {
        if (string.IsNullOrEmpty(cod)) return "";
        int ii = 0;
        while (ii < cod.Length && char.IsLetter(cod[ii])) ii++;
        var pref = cod[..ii].ToUpper();
        var numS = cod[ii..];
        var tipo  = pref switch { "R" => "Rodete", "M" => "Madejas", "MR" => "Mad.Rodete", _ => pref };
        var marca = pref switch { "R" => "THIES",  "M" => "HANK",    _ => "" };
        if (string.IsNullOrEmpty(numS)) return tipo + (marca != "" ? $" · {marca}" : "");
        var num = int.TryParse(numS, out var nn) ? nn.ToString() : numS;
        return marca != "" ? $"{tipo} Nº{num} · {marca}" : $"{tipo} Nº{num}";
    };

    if (primerItem != null)
    {
        var s = primerItem;
        // Estimados
        if (s.FchEstHilanderia.HasValue && s.FchEstPartida.HasValue)
            tlEstData.Add(new { x = "Hilandería", y = new[] { tlFmt(s.FchEstHilanderia.Value), tlFmt(s.FchEstPartida.Value) }, fillColor = "#0891b266" });
        if (s.FchEstTinIni.HasValue && s.FchEstTinFin.HasValue)
            tlEstData.Add(new { x = "Tintorería", y = new[] { tlFmt(s.FchEstTinIni.Value), tlFmt(s.FchEstTinFin.Value) }, fillColor = "#7e22ce66" });
        if (s.FchEstTinFin.HasValue && s.FchEstSecado.HasValue)
            tlEstData.Add(new { x = "Secado/CC", y = new[] { tlFmt(s.FchEstTinFin.Value), tlFmt(s.FchEstSecado.Value) }, fillColor = "#05996966" });
        if (s.FchEstSecado.HasValue && s.FchEstCalidad.HasValue)
            tlEstData.Add(new { x = "Calidad", y = new[] { tlFmt(s.FchEstSecado.Value), tlFmt(s.FchEstCalidad.Value) }, fillColor = "#dc262666" });
        if (s.FchEstCalidad.HasValue && s.FchEstDespacho.HasValue)
            tlEstData.Add(new { x = "Despacho", y = new[] { tlFmt(s.FchEstCalidad.Value), tlFmt(s.FchEstDespacho.Value) }, fillColor = "#06543666" });
        // Reales
        if (s.FchRealProduccion.HasValue && s.FchRealPartida.HasValue)
            tlRealData.Add(new { x = "Hilandería", y = new[] { tlFmt(s.FchRealProduccion.Value), tlFmt(s.FchRealPartida.Value) }, fillColor = "#0891b2" });
        if (s.FchRealTinIni.HasValue && s.FchRealTinFin.HasValue)
            tlRealData.Add(new { x = "Tintorería", y = new[] { tlFmt(s.FchRealTinIni.Value), tlFmt(s.FchRealTinFin.Value) }, fillColor = "#7e22ce" });
        if (s.FchRealTinFin.HasValue && s.FchRealSecado.HasValue)
            tlRealData.Add(new { x = "Secado/CC", y = new[] { tlFmt(s.FchRealTinFin.Value), tlFmt(s.FchRealSecado.Value) }, fillColor = "#059669" });
        if (s.FchRealSecado.HasValue && (s.FchRealCcTinto.HasValue || s.FchRealCalidad.HasValue))
        {
            var ccEnd = s.FchRealCcTinto ?? s.FchRealCalidad;
            tlRealData.Add(new { x = "Calidad", y = new[] { tlFmt(s.FchRealSecado.Value), tlFmt(ccEnd!.Value) }, fillColor = "#dc2626" });
        }
        if (s.FchRealAlmPt.HasValue && s.FchRealDespacho.HasValue)
            tlRealData.Add(new { x = "Despacho", y = new[] { tlFmt(s.FchRealAlmPt.Value), tlFmt(s.FchRealDespacho.Value) }, fillColor = "#065f46" });
    }

    var tlSeriesJson  = System.Text.Json.JsonSerializer.Serialize(new object[] {
        new { name = "Estimado", data = (object)tlEstData },
        new { name = "Real",     data = (object)tlRealData }
    });
    var showTimeline  = tlEstData.Count > 0 || tlRealData.Count > 0;
    var tlSubtitle    = primerItem != null
        ? $"Det.{primerItem.NumDet} — {primerItem.CodArt} {primerItem.Color} {primerItem.Titulo}"
        : "";
}

@section Styles {
<link rel="stylesheet" href="~/css/planeamiento.css" asp-append-version="true" />
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Produccion" asp-action="Index">Producción</a></li>
    <li class="breadcrumb-item"><a asp-action="Dashboard">Seguimiento de Pedidos</a></li>
    <li class="breadcrumb-item active">Pedido @Model.Serie-@Model.NumPed</li>
}

@* ── Modales de acción POST (fuera de cualquier grid) ──────── *@

@* Modal: Reprogramar despacho *@
<div class="modal fade" id="modalReprogramar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Reprogramar" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="serie"  value="@Model.Serie" />
                <input type="hidden" name="numPed" value="@Model.NumPed" />
                <div class="modal-header py-2">
                    <h6 class="modal-title"><i class="bi bi-calendar-event me-2 text-warning"></i>Reprogramar fecha de despacho</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Sublote (Det.)</label>
                        <select name="nro" class="form-select form-select-sm" required>
                            @foreach (var s in Model.Items.OrderBy(x => x.NumDet))
                            {
                                <option value="@s.Nro" data-det="@s.NumDet">Det.@s.NumDet — @s.Titulo (@s.Color)</option>
                            }
                        </select>
                    </div>
                    <input type="hidden" name="numDet" id="reprNumDet" value="@(Model.Items.FirstOrDefault()?.NumDet ?? 0)" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Nueva fecha de despacho</label>
                        <input type="date" name="nuevaFchDesp" class="form-control form-control-sm" required
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Motivo</label>
                        <input type="text" name="motivo" class="form-control form-control-sm" maxlength="200"
                               placeholder="Ej: Cliente solicitó extensión de plazo" required />
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning btn-sm"><i class="bi bi-save me-1"></i>Reprogramar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Modal: Recalcular fechas *@
<div class="modal fade" id="modalRecalcular" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <form asp-action="RecalcularFechas" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="serie"  value="@Model.Serie" />
                <input type="hidden" name="numPed" value="@Model.NumPed" />
                <input type="hidden" name="nro"    value="@(Model.Items.FirstOrDefault()?.Nro ?? 0)" />
                <input type="hidden" name="numDet" value="@(Model.Items.FirstOrDefault()?.NumDet ?? 0)" />
                <div class="modal-header py-2">
                    <h6 class="modal-title"><i class="bi bi-calculator me-2 text-info"></i>Recalcular fechas estimadas</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Motivo del recálculo</label>
                        <select name="motivo" class="form-select form-select-sm">
                            <option value="REP">REP — Reprogramado</option>
                            <option value="PED">PED — Pedido</option>
                            <option value="PLA">PLA — Planificado</option>
                            <option value="MAQ">MAQ — Cambio máquina</option>
                        </select>
                    </div>
                    <div class="alert alert-info small py-1 mb-0">
                        Recalcula todas las fechas estimadas del primer sublote y guarda historial.
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-info btn-sm text-white"><i class="bi bi-arrow-repeat me-1"></i>Recalcular</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Modal: Cerrar ítem *@
<div class="modal fade" id="modalCerrar" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content border-danger">
            <form asp-action="CerrarItem" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="numPed" value="@Model.NumPed" />
                <input type="hidden" name="serie"  value="@Model.Serie" />
                <div class="modal-header bg-danger text-white py-2">
                    <h6 class="modal-title"><i class="bi bi-x-circle me-2"></i>Cerrar ítem manualmente</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Sublote a cerrar</label>
                        <select name="idSeguim" class="form-select form-select-sm" required>
                            @foreach (var s in Model.Items.OrderBy(x => x.NumDet))
                            {
                                <option value="@s.IdSeguim">Det.@s.NumDet — @s.Titulo (ID @s.IdSeguim)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Motivo del cierre</label>
                        <input type="text" name="motivo" class="form-control form-control-sm" maxlength="200"
                               placeholder="Ej: Cierre manual por ajuste" value="CIERRE_MANUAL" required />
                    </div>
                    <div class="alert alert-danger small py-1 mb-0">
                        <i class="bi bi-exclamation-triangle me-1"></i>Esta acción es irreversible.
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-x-circle me-1"></i>Cerrar ítem</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── Encabezado de página ────────────────────────────── *@
<div class="pln-page-hdr mb-2">
    <i class="bi bi-clipboard2-data pln-page-hdr-icon"></i>
    <div class="pln-page-hdr-body">
        <div class="pln-page-hdr-title">Detalle del Pedido <strong>@Model.Serie-@Model.NumPed</strong></div>
        <div class="pln-page-hdr-sub">Estado de cada sublote, fechas planificadas vs. reales &nbsp;·&nbsp; Use <strong>Trazabilidad</strong> o <strong>Gantt</strong> para la línea de tiempo</div>
    </div>
    <div class="pln-page-hdr-actions">
        <a asp-action="PedidoGantt"
           asp-route-numPed="@Model.NumPed"
           asp-route-serie="@Model.Serie"
           class="btn btn-outline-light btn-sm">
            <i class="bi bi-bar-chart-steps me-1"></i>Gantt
        </a>
        <a asp-action="Dashboard" class="btn btn-outline-light btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>

@* ── ZONA A: Strip industrial de información del pedido ─────── *@
@if (primerItem != null)
{
    <div class="pln-info-strip mb-3">
        <div class="d-flex align-items-stretch flex-wrap">
            <div class="pln-strip-cell">
                <div class="pln-strip-lbl">Cliente</div>
                <div class="pln-strip-val">@primerItem.NombreCliente</div>
                <div class="pln-strip-sub">@primerItem.CodCliente</div>
            </div>
            <div class="pln-strip-cell">
                <div class="pln-strip-lbl">Fecha pedido</div>
                <div class="pln-strip-val">@primerItem.FchPedido.ToString("dd/MM/yyyy")</div>
            </div>
            @if (primerItem.FchPlanif.HasValue)
            {
                <div class="pln-strip-cell">
                    <div class="pln-strip-lbl">Fecha planificación</div>
                    <div class="pln-strip-val">@primerItem.FchPlanif.Value.ToString("dd/MM/yyyy")</div>
                </div>
            }
            @* Entrega Compromiso: FchEntregaComp si existe, sino FchEntregaOri *@
            @{
                var fchCompromiso = primerItem.FchEntregaComp ?? primerItem.FchEntregaOri;
            }
            <div class="pln-strip-cell">
                <div class="pln-strip-lbl">Entrega Compromiso</div>
                <div class="pln-strip-val @(primerItem.EstaRetrasado ? "text-warning" : "")">
                    @(fchCompromiso?.ToString("dd/MM/yyyy") ?? "—")
                    @if (primerItem.EstaRetrasado)
                    {
                        <span class="badge bg-danger ms-1" style="font-size:.68rem;">+@primerItem.DiasRetraso d</span>
                    }
                </div>
            </div>
            <div class="pln-strip-cell">
                <div class="pln-strip-lbl">Sublotes</div>
                <div class="pln-strip-val">@itemsActivos.Count</div>
                <div class="pln-strip-sub">@itemsActivos.Sum(x => x.CantidadOrig).ToString("N0") kg en total</div>
            </div>
            <div class="pln-strip-cell">
                <div class="pln-strip-lbl">Días para entrega</div>
                @{
                    var fchComp = Model.Items.Select(x => x.FchEntregaComp).Where(f => f.HasValue).Min();
                    var diasRest = fchComp.HasValue ? (fchComp.Value - DateTime.Today).Days : (int?)null;
                }
                @if (diasRest.HasValue)
                {
                    var colorDias = diasRest.Value < 0 ? "#fc8181" : diasRest.Value <= 5 ? "#f6ad55" : "#e2e8f0";
                    <div class="pln-strip-val" style="color:@colorDias;">
                        @(diasRest.Value < 0 ? $"{Math.Abs(diasRest.Value)}d vencido" : $"{diasRest.Value}d restantes")
                    </div>
                    <div class="pln-strip-sub">@fchComp!.Value.ToString("dd/MM/yyyy")</div>
                }
                else
                {
                    <div class="pln-strip-val">—</div>
                }
            </div>
            @if (Model.Items.Any(x => x.EsUrgente))
            {
                <div class="pln-strip-cell" style="background:rgba(229,62,62,.15);">
                    <div class="pln-strip-lbl" style="color:#fc8181;">Estado</div>
                    <div class="pln-strip-val"><span class="badge bg-danger">⚡ URGENTE</span></div>
                </div>
            }
            else if (Model.Items.Any(x => x.EstaRetrasado))
            {
                <div class="pln-strip-cell" style="background:rgba(253,126,20,.12);">
                    <div class="pln-strip-lbl" style="color:#f6ad55;">Estado</div>
                    <div class="pln-strip-val" style="font-size:.82rem;color:#fed7aa;">⚠ Con retraso</div>
                </div>
            }
        </div>
        @* ── Fila de actores (Registró / Aprobó / Planificó) ── *@
        @{
            var actorItem = Model.Items.FirstOrDefault(x =>
                !string.IsNullOrEmpty(x.NombreRegistro) ||
                !string.IsNullOrEmpty(x.NombreAprobacion) ||
                !string.IsNullOrEmpty(x.NombrePlanif));
        }
        @if (actorItem != null)
        {
            <div class="d-flex gap-3 flex-wrap px-2 py-1 border-top" style="font-size:.72rem; color:#a0aec0; background:rgba(255,255,255,.07);">
                @if (!string.IsNullOrEmpty(actorItem.NombreRegistro))
                {
                    <span><i class="bi bi-person me-1"></i><strong>Registró:</strong> @actorItem.NombreRegistro</span>
                }
                @if (!string.IsNullOrEmpty(actorItem.NombreAprobacion))
                {
                    <span><i class="bi bi-patch-check me-1"></i><strong>Aprobó:</strong> @actorItem.NombreAprobacion
                        @if (actorItem.FchAprobacion.HasValue)
                        {
                            <span class="opacity-75 ms-1">(@actorItem.FchAprobacion.Value.ToString("dd/MM/yy"))</span>
                        }
                    </span>
                }
                @if (!string.IsNullOrEmpty(actorItem.NombrePlanif))
                {
                    <span><i class="bi bi-calendar2-check me-1"></i><strong>Planificó:</strong> @actorItem.NombrePlanif
                        @if (actorItem.FchPlanif.HasValue)
                        {
                            <span class="opacity-75 ms-1">(@actorItem.FchPlanif.Value.ToString("dd/MM/yy"))</span>
                        }
                    </span>
                }
            </div>
        }

    </div>
}

@* ── SEGMENTO 2: Alertas activas — solo aviso resumen + modal *@
@if (Model.Alertas.Any())
{
    var cntCrit = Model.Alertas.Count(a => a.Nivel == "C");
    var bannerColor = cntCrit > 0 ? "danger" : "warning";
    <div class="alert alert-@bannerColor d-flex align-items-center justify-content-between gap-2 py-2 mb-3">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-bell-fill flex-shrink-0"></i>
            <span style="font-size:.85rem;">
                <strong>Alertas por revisar:</strong>
                <span class="badge bg-@bannerColor border border-light ms-1">@Model.Alertas.Count()</span>
                — hay sublotes con alertas activas en este pedido.
            </span>
        </div>
        <button type="button" class="btn btn-sm btn-outline-@bannerColor text-nowrap"
                onclick="abrirModalAlertas(null)">
            <i class="bi bi-eye me-1"></i>Ver alertas
        </button>
    </div>
}

@* ── ZONA C: Sublotes del pedido (cards) ──────────────────── *@
<div class="section-sep"><i class="bi bi-list-check"></i> Sublotes del pedido</div>
<div class="mb-3">
    @{
        int subIdx = 0;
    }
    @foreach (var s in itemsActivos.OrderBy(x => x.Nro))
    {
        subIdx++;
        var urgClase     = s.EsUrgente ? "urgente" : s.EstaRetrasado ? "retraso" : "";
        var panelId      = $"subpanel-{subIdx}";
        var tabFlujoId   = $"tab-flujo-{subIdx}";
        var tabEventosId = $"tab-eventos-{subIdx}";
        var ordenActSub  = pasoMap.ContainsKey(s.CodPasoAct) ? pasoMap[s.CodPasoAct].OrdenPaso : 0;
        var eventosSub   = Model.Eventos.Where(e => e.IdSeguim == s.IdSeguim).ToList();

        <div class="sublote-card @urgClase" data-codartt="@s.CodArt">
            <div class="sublote-head">
                <span class="badge bg-dark" style="font-size:.65rem;letter-spacing:.04em;border-radius:1px;">
                    @s.Nro@(s.NroCiclo > 1 ? $"·C{s.NroCiclo}" : "")
                </span>
                <span class="sublote-art">@s.CodArt</span>
                <span class="art-desc-info text-muted" style="font-size:.72rem;"></span>
                <span class="sublote-meta">
                    <strong><span class="text-muted" style="font-size:.7rem;font-weight:400;">Tít.:</span> @s.Titulo</strong>
                    @if (!string.IsNullOrEmpty(s.Color)) { <text> / @s.Color</text> }
                </span>
                <span class="sublote-meta text-muted ms-1">@s.CantidadOrig.ToString("N0") kg orig.</span>
                @if (s.KgPendientes > 0)
                {
                    <span class="kg-pend sublote-meta">@s.KgPendientes.ToString("N0") kg pend.</span>
                }
                @if (s.EstaEnReproceso)
                {
                    <span class="badge bg-danger ms-1" style="font-size:.65rem;border-radius:1px;">Rep.@s.NroCiclo</span>
                }
                @{
                    var alertasSub = Model.Alertas.Where(a => a.Nro == s.Nro).ToList();
                }
                @if (alertasSub.Any())
                {
                    var peorNivelSub = alertasSub.Any(a => a.Nivel == "C") ? "danger" : alertasSub.Any(a => a.Nivel == "A") ? "warning" : "info";
                    <button type="button" class="badge bg-@peorNivelSub ms-1 border-0" style="font-size:.65rem;border-radius:2px;cursor:pointer;"
                            title="@alertasSub.Count alerta(s) activa(s)"
                            onclick="abrirModalAlertas(@s.Nro)">
                        <i class="bi bi-bell-fill me-1"></i>@alertasSub.Count alerta@(alertasSub.Count == 1 ? "" : "s")
                    </button>
                }
            </div>
            <div class="sublote-body">
                <div>
                    <span class="paso-badge text-white" style="background-color:@s.ColorUi;">
                        @s.CodPasoAct — @s.NombrePaso
                    </span>
                    @if (s.CodPasoAct == "01")
                    {
                        <i class="bi bi-hourglass-split ms-1 text-muted" style="font-size:.7rem;" title="Sin planificar"></i>
                    }
                </div>
                <div class="sublote-avance">
                    <div class="progress progress-thin" style="width:90px;">
                        <div class="progress-bar" role="progressbar"
                             style="width:@s.PctAvance%;background-color:@s.ColorUi;"
                             aria-valuenow="@s.PctAvance" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <span class="avance-pct" style="color:@s.ColorUi;" title="@s.NombrePaso — @s.PctAvance% completado">@s.PctAvance%</span>
                </div>
                <div class="sublote-fecha">
                    <span class="slbl">Est. despacho</span>
                    <span class="sval">@(s.FchEstDespacho?.ToString("dd/MM/yy") ?? "—")</span>
                </div>
                <div>
                    <span class="badge bg-secondary" style="font-size:.68rem;border-radius:1px;" title="Ciclo de reproceso">C.@s.NroCiclo</span>
                </div>
            </div>

            @* ── Panel colapsable: Flujo + Eventos por sublote ── *@
            <div class="sublote-panel">
                <button class="sublote-panel-toggle" type="button"
                        data-bs-toggle="collapse" data-bs-target="#@panelId"
                        aria-expanded="false" aria-controls="@panelId">
                    <i class="bi bi-chevron-down toggle-ico"></i>
                    <i class="bi bi-calendar2-range me-1"></i>Línea de tiempo y eventos del sublote
                    @if (eventosSub.Any())
                    {
                        <span class="badge bg-secondary ms-1" style="font-size:.6rem;">@eventosSub.Count ev.</span>
                    }
                </button>
                <div class="collapse" id="@panelId">
                    <div class="sublote-panel-body">
                        @* mini-tabs *@
                        <ul class="nav sub-tabs" id="tabs-@subIdx" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" data-bs-toggle="tab"
                                        data-bs-target="#@tabFlujoId" type="button" role="tab">
                                    <i class="bi bi-calendar2-range me-1"></i>Línea de tiempo
                                </button>
                            </li>
                            @{
                                var tabTtId   = $"tab-tt-{subIdx}";
                                    var hayttData = s.NumPartida > 0 && Model.DetalleTt.TryGetValue(s.NumPartida, out var detTtBut) && (detTtBut.TieneBanos || detTtBut.Calidad != null || detTtBut.RectificacionesReceta.Count > 0);
                            }
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" data-bs-toggle="tab"
                                        data-bs-target="#@tabTtId" type="button" role="tab">
                                    <i class="bi bi-gear-fill me-1" style="color:#6f42c1;"></i>Detalle de producción
                                    @if (hayttData)
                                    {
                                        <span class="badge ms-1" style="background:#6f42c1;font-size:.6rem;">@(Model.DetalleTt[s.NumPartida].Banos.Count) baños</span>
                                    }
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" data-bs-toggle="tab"
                                        data-bs-target="#@tabEventosId" type="button" role="tab">
                                    <i class="bi bi-journal-text me-1"></i>Historial de eventos
                                    @if (eventosSub.Any())
                                    {
                                        <span class="badge bg-secondary ms-1" style="font-size:.6rem;">@eventosSub.Count</span>
                                    }
                                </button>
                            </li>
                        </ul>
                        <div class="tab-content sub-tab-panel">

                            @* Tab Flujo *@
                            <div class="tab-pane fade show active" id="@tabFlujoId" role="tabpanel">
                                @{
                                    var maqEfectiva = s.MaqTtEfectiva;
                                    var maqSrc = !string.IsNullOrEmpty(s.CodMaqTt) || !string.IsNullOrEmpty(s.MaqPartida) ? "real" : "prog";
                                    // Fechas reales TT desde DetalleTt (fallback para partidas sistema nuevo donde FchRealTin* = NULL)
                                    PlnDetalleTt? _dtFb = null;
                                    if (s.NumPartida > 0) Model.DetalleTt.TryGetValue(s.NumPartida, out _dtFb);
                                    // ── Corrección de fechas retroactivas ──────────────────────────────────────
                                    // FUENTE ÚNICA: DetalleTt (mismas tablas legacy que la pestaña Tintorería)
                                    // FUENTE ÚNICA: DetalleTt (mismas tablas legacy que la pestaña Tintorería).
                                    // PLN_SEGUIMIENTO.FCH_REAL_* solo como respaldo cuando no hay DetalleTt.
                                    // v3.0: PASO '03' (En Hilandería): usa FechaPartida (PARTIDA.FECHA)
                                    // v3.0: PASO '04' (Laboratorio):   usa FchValidacion de L_VALIDA_RECETA.F_ESTADO_TRES
                                    // PASO '05' (Lote Disp.):   usa s.FchRealPartida (FCH_REAL_PARTIDA, set por PASO '05')
                                    // PASO '10': usa REVISADO_G.A_ADFECHA (FchRegistro)
                                    // PASO '11': usa REVISADO_D.FECHA (primer detalle con aprobado>0)
                                    var _labFchReg   = _dtFb?.ValidacionReceta?.FchRegistro;
                                    var _tinIniEfect = _dtFb?.InicioTt ?? s.FchRealTinIni;
                                    var _fch02 = s.FchRealProgramado;
                                    if (_fch02.HasValue && _labFchReg.HasValue && _fch02.Value.Date > _labFchReg.Value.Date)
                                        _fch02 = _labFchReg;
                                    // v3.0 PASO '03' (En Hilandería): PARTIDA.FECHA = cuando se insertó el lote en hilandería
                                    // SP_PLN_AVANZA_PASO guarda FCH_REAL_PRODUCCION en PASO '03', así que ambas fuentes coinciden.
                                    var _fch03 = _dtFb?.FechaPartida ?? s.FchRealProduccion;
                                    // _fch04 reservado; PASO '05' usa s.FchRealPartida directamente en el switch fReal.
                                    DateTime? _fch04 = _dtFb?.Devanados.Count > 0
                                        ? _dtFb!.Devanados.Min(d => (DateTime?)d.FechaIni)
                                        : s.FchRealPartida;
                                    // PASO '10': REVISADO_G.A_ADFECHA
                                    DateTime? _fch10 = _dtFb?.Revisados.Count > 0
                                        ? _dtFb!.Revisados.Min(r => (DateTime?)r.FchRegistro)
                                        : s.FchRealDevanado;
                                    // PASO '11': REVISADO_D.FECHA (primer detalle aprobado)
                                    DateTime? _fch11 = (_dtFb?.Revisados.Count > 0 && _dtFb!.Revisados[0].Detalle.Count > 0)
                                        ? (DateTime?)_dtFb.Revisados[0].Detalle[0].Fecha
                                        : s.FchRealCalidad;
                                }
                                <div class="tl-grid">
                                    @foreach (var ec in Model.Pasos.OrderBy(p => p.OrdenPaso))
                                    {
                                        var esActivo    = s.CodPasoAct == ec.CodPaso;
                                        var completado  = ec.OrdenPaso < ordenActSub;

                                        // Etapas condicionales: ocultar si no aplican Y el lote nunca pasó por ellas
                                        bool omitirPaso = (ec.CodPaso == "09B" && s.Proceso != "24" && !esActivo && s.FchRealGaseado == null)
                                                       || (ec.CodPaso == "9R"  && s.FchRealCcRechazo == null && !esActivo);
                                        if (omitirPaso) continue;

                                        var clase       = esActivo ? "activo" : completado ? "completado" : "pendiente";
                                        var colorPaso   = completado ? "#2f855a" : esActivo ? ec.ColorUi : "#ced4da";
                                        var esOrient =
                                            ec.CodPaso == "05" ||   // Lote Disp.: siempre proxy (no tiene timestamp propio)
                                            (ec.CodPaso == "07" && _dtFb?.FinTt == null && !s.FchRealTinFin.HasValue) ||  // Teñido Comp.: solo si no hay FinTt real
                                            (ec.CodPaso == "11" && (_dtFb == null || _dtFb.Revisados.Count == 0 || _dtFb.Revisados[0].Detalle.Count == 0)) ||  // Revisado: solo sin REVISADO_D
                                            (ec.CodPaso == "12" && !s.FchRealAlmPt.HasValue);  // AlmPT: solo sin fecha real
                                        // Para '08' (Secado): usar máquina real de la secadora (TT_RSECADO.COD_MAQ), no la máquina TT
                                        var maqStep = maqEfectiva;
                                        if (ec.CodPaso == "08" && Model.DetalleTt.TryGetValue(s.NumPartida, out var _dts08)
                                            && !string.IsNullOrEmpty(_dts08?.Secado?.CodMaq))
                                            maqStep = _dts08!.Secado!.CodMaq;
                                        bool mostrarMaq = maqStepsTT.Contains(ec.CodPaso) && !string.IsNullOrEmpty(maqStep)
                                                          && !(ec.CodPaso == "09B" && s.Proceso != "24")
                                                          && !(ec.CodPaso == "9R"  && s.FchRealCcRechazo == null)
                                                          // Para pasos TT PENDIENTES (ni activo ni completado): mostrar máquina solo
                                                          // en el primero del área TT ('06'). Los demás (07/08/09) son redundantes
                                                          // hasta que ese paso sea el activo.
                                                          && (esActivo || completado || ec.CodPaso == "06");

                                        string? fEst = ec.CodPaso switch {
                                            "01" => s.FchPedido.ToString("dd/MM/yy"),
                                            "02" => s.FchRealProgramado?.ToString("dd/MM/yy"),
                                            "03" => s.FchEstHilanderia?.ToString("dd/MM/yy"),
                                            "04" => s.FchEstPartida?.ToString("dd/MM/yy"),
                                            "05" => s.FchEstPartida?.ToString("dd/MM/yy"),
                                            "06" => s.FchEstTinIni?.ToString("dd/MM/yy"),
                                            "07" => s.FchEstTinFin?.ToString("dd/MM/yy"),
                                            "08" => s.FchEstSecado?.ToString("dd/MM/yy"),
                                            "09" => s.FchEstCalidad?.ToString("dd/MM/yy"),
                                            "10" => s.FchEstCalidad?.ToString("dd/MM/yy"),
                                            "11" => s.FchEstCalidad?.ToString("dd/MM/yy"),
                                            "12" => s.FchEstCalidad?.ToString("dd/MM/yy"),
                                            "13" => s.FchEstDespacho?.ToString("dd/MM/yy"),
                                            "14" => s.FchEstDespacho?.ToString("dd/MM/yy"),
                                            _    => null
                                        };
                                        string? fReal = ec.CodPaso switch {
                                            "01" => s.FchPedido.ToString("dd/MM/yy"),
                                            "02" => _fch02?.ToString("dd/MM/yy"),
                                            "03" => _fch03?.ToString("dd/MM/yy"),                                    // v3.0 En Hilandería: PARTIDA.FECHA
                                            "04" => _dtFb?.ValidacionReceta?.FchValidacion?.ToString("dd/MM/yy")    // v3.0 Laboratorio: L_VALIDA_RECETA.F_ESTADO_TRES
                                                    ?? s.FchRealPartida?.ToString("dd/MM/yy"),                       // fallback: FCH_REAL_PARTIDA (set por migración)
                                            "05" => s.FchRealPartida?.ToString("dd/MM/yy"),                   // Lote Disponible: H_RPRODUC date
                                            "06" => (_dtFb?.InicioTt ?? s.FchRealTinIni)?.ToString("dd/MM/yy"),
                                            "07" => (_dtFb?.FinTt ?? s.FchRealTinFin)?.ToString("dd/MM/yy"),
                                            "08" => (_dtFb?.Secado?.FechaFin ?? s.FchRealSecado)?.ToString("dd/MM/yy"),
                                            "09"  => (_dtFb?.Calidad != null ? (DateTime?)_dtFb.Calidad.Fecha : s.FchRealCcTinto)?.ToString("dd/MM/yy"),
                                            "09B" => s.FchRealGaseado?.ToString("dd/MM/yy"),
                                            "9R"  => s.FchRealCcRechazo?.ToString("dd/MM/yy"),
                                            "10" => _fch10?.ToString("dd/MM/yy"),
                                            "11" => _fch11?.ToString("dd/MM/yy"),
                                            "12" => s.FchRealAlmPt?.ToString("dd/MM/yy"),
                                            "13" => s.FchRealAlmPt?.ToString("dd/MM/yy"),
                                            "14" => s.FchRealDespacho?.ToString("dd/MM/yy"),
                                            _    => null
                                        };

                                        <div class="tl-step @clase" style="@(esActivo ? $"border-left-color:{colorPaso};" : null)">
                                            <div class="tl-dot" style="background:@colorPaso;"></div>
                                            <div class="tl-cod">
                                                <span class="badge" style="background:@colorPaso;color:#fff;font-size:.63rem;min-width:24px;text-align:center;border-radius:1px;">@ec.CodPaso</span>
                                            </div>
                                            <div class="tl-nombre @clase">
                                                @ec.NombrePaso
                                                @if (!string.IsNullOrEmpty(ec.Area))
                                                {
                                                    <span class="badge bg-light text-secondary border ms-1" style="font-size:.58rem;font-weight:500;">@ec.Area</span>
                                                }
                                                @if (ec.CodPaso == "03")
                                                {
                                                    @* v3.0: PASO '03' = En Hilandería — lote físico creado antes de la aprobación de Lab *@
                                                }
                                                @* v2.3: flujo dual — indica cuál llegó primero entre Lab (PASO 04) e Hilandería (PASO 03) *@
                                                @if (ec.CodPaso == "04" && s.IndFlujo == "H")
                                                {
                                                    <span class="badge bg-light border text-secondary ms-1"
                                                          style="font-size:.58rem;"
                                                          title="Lote físico creado en Hilandería ANTES de que Lab aprobara la receta (flujo especial, ~3% de ítems)">
                                                        <i class="bi bi-shuffle"></i> Lote creado primero
                                                    </span>
                                                }
                                                @if (ec.CodPaso == "04" && s.IndFlujo == "L")
                                                {
                                                    <span class="badge bg-light border text-secondary ms-1"
                                                          style="font-size:.58rem;"
                                                          title="Lab aprobó la receta ANTES de que se creara el lote formal en Hilandería (flujo normal, ~81% de ítems)">
                                                        <i class="bi bi-check2-circle"></i> Lab aprobó primero
                                                    </span>
                                                }
                                                @if (esActivo)
                                                {
                                                    <span class="badge ms-1" style="background:@colorPaso;font-size:.6rem;color:#fff;border-radius:1px;">● Activo</span>
                                                }
                                                @if (esOrient)
                                                {
                                                    <i class="bi bi-pin-angle ms-1 text-warning" style="font-size:.68rem;" title="Fecha orientativa"></i>
                                                }
                                                @if (mostrarMaq)
                                                {
                                                    // Paso '09' activo + TT/Secado ya completados → la máquina terminó su trabajo con ESTE lote.
                                                    // Mostrar live-load confunde: la carga visible es de OTRO lote distinto.
                                                    var ttMaqTerminada  = (ec.CodPaso == "09" && esActivo
                                                                          && (s.FchRealSecado.HasValue || s.FchRealTinFin.HasValue))
                                                                       || (ec.CodPaso == "08" && esActivo && s.FchRealSecado.HasValue); // secado físico completado, CC pendiente
                                                    var loteCerrado     = s.EstaCerrado || completado || ttMaqTerminada;
                                                    // Paso TT pendiente: el lote aún no llegó a TT. La máquina está asignada
                                                    // pero NO está procesando este lote ahora mismo.
                                                    var esPendienteTT   = !esActivo && !completado && !s.EstaCerrado;
                                                    var hayConflicto    = !loteCerrado && !esPendienteTT && s.HayConflictoMaquina;
                                                    var maqLabel    = esPendienteTT        ? "Máquina planificada para TT"
                                                                    : loteCerrado          ? "Máquina utilizada en este lote"
                                                                    : maqSrc == "real"     ? "Máquina asignada a este lote"
                                                                                           : "Máquina planificada";
                                                    var maqBadge    = ttMaqTerminada                      ? "TT completado ✓"
                                                                    : loteCerrado                         ? "Lote procesado ✓"
                                                                    : esPendienteTT && maqSrc == "real"   ? "Confirmada para TT"
                                                                    : esPendienteTT                       ? "Pendiente de confirmar"
                                                                    : hayConflicto                        ? "Asignada · no en uso ahora"
                                                                    : maqSrc == "real"                    ? "Asignación confirmada"
                                                                                                          : "Pendiente de confirmar";
                                                    var maqBadgeCss = loteCerrado      ? "maq-src-done"
                                                                    : hayConflicto     ? "maq-src-conflicto"
                                                                    : maqSrc == "real" ? "maq-src-real"
                                                                                       : "maq-src-prog";
                                                    var maqBoxCss   = loteCerrado      ? "maq-cerrado"
                                                                    : maqSrc == "real" ? "maq-real"
                                                                                       : "maq-prog";
                                                    <div class="maq-box @maqBoxCss" data-maq="@maqStep" data-cerrado="@(loteCerrado || hayConflicto || esPendienteTT ? "true" : "false")" data-propio="@(_dtFb != null && _dtFb.Banos.Any(b => b.CodMaq == maqStep && !b.FechaFin.HasValue) ? "true" : "false")">
                                                        <div class="maq-header-row">
                                                            <i class="bi bi-gear-fill" style="font-size:.6rem;color:#718096;"></i>
                                                            <span class="maq-header-lbl">@maqLabel</span>
                                                            <span class="maq-src-badge @maqBadgeCss">@maqBadge</span>
                                                        </div>
                                                        <div class="maq-id-row">
                                                            <span class="maq-cod">@maqStep</span>
                                                            <span class="maq-nombre">@maqNombre(maqStep)</span>
                                                        </div>
                                                        @{
                                                            var _crCnt    = _dtFb?.CalculoRecetas.Count ?? 0;
                                                            var _bnDone   = _dtFb?.Banos.Count(b => b.FechaFin.HasValue) ?? 0;
                                                            var _bnTotal  = Math.Max(_crCnt, _dtFb?.Banos.Count ?? 0);
                                                        }
                                                        @if (_dtFb != null && _bnTotal > 0 && maqStepsTT.Contains(ec.CodPaso) && ec.CodPaso != "08")
                                                        {
                                                            var _pctBanos = _bnTotal > 0 ? (int)Math.Round(_bnDone * 100.0 / _bnTotal) : 0;
                                                            var _banosCss = _bnDone == _bnTotal ? "maq-banos-completo" : _bnDone > 0 ? "maq-banos-parcial" : "maq-banos-pendiente";
                                                            <div class="maq-banos-row @_banosCss">
                                                                <i class="bi bi-layers-fill" style="font-size:.6rem;opacity:.65;"></i>
                                                                <span>@_bnDone de @_bnTotal baño@(_bnTotal != 1 ? "s" : "") completado@(_bnDone != 1 ? "s" : "")</span>
                                                                @if (_bnDone > 0 && _bnDone < _bnTotal)
                                                                {
                                                                    <span class="badge ms-1" style="background:#d97706;color:#fff;font-size:.57rem;">@(_bnTotal - _bnDone) pendiente@((_bnTotal - _bnDone) != 1 ? "s" : "")</span>
                                                                }
                                                            </div>
                                                        }
                                                        @if (ec.CodPaso == "08" && _dtFb != null)
                                                        {
                                                            var _nSecMaq = _dtFb.Secados.Count(x => x.CodMaq == maqStep);
                                                            if (_nSecMaq > 1)
                                                            {
                                                                <div class="maq-banos-row maq-banos-completo">
                                                                    <i class="bi bi-arrow-repeat" style="font-size:.6rem;opacity:.65;"></i>
                                                                    <span>Secado en @_nSecMaq sesiones en esta máquina</span>
                                                                </div>
                                                            }
                                                        }
                                                        @if (loteCerrado)
                                                        {
                                                            // Para paso '09' terminado: mostrar la fecha de Secado real
                                                            // Misma fuente que pestaña Tintorería: DetalleTt primero
                                                            var _secFin    = _dtFb?.Secado?.FechaFin ?? s.FchRealSecado;
                                                            var fechaProc  = ttMaqTerminada && _secFin.HasValue
                                                                ? _secFin!.Value.ToString("dd/MM/yy")
                                                                : fReal ?? fEst;
                                                            var procLabel  = ttMaqTerminada ? "Tenido/Secado el" : "Procesado el";
                                                            var esEstimada = !ttMaqTerminada && fReal == null && fEst != null;
                                                            if (fechaProc != null)
                                                            {
                                                                <div class="maq-proc-row">
                                                                    @if (!esEstimada)
                                                                    {
                                                                        <i class="bi bi-check-circle-fill text-success" style="font-size:.65rem;"></i>
                                                                        <span class="maq-proc-date">@procLabel @fechaProc</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <i class="bi bi-calendar2-check" style="font-size:.65rem;color:#9ca3af;"></i>
                                                                        <span class="maq-proc-date" style="color:#9ca3af;font-style:italic;">Est. @fechaProc</span>
                                                                    }
                                                                </div>
                                                            }
                                                        }
                                                        @if (!loteCerrado)
                                                        {
                                                            var tieneEnProceso  = _dtFb != null && _dtFb.Banos.Any(b => b.CodMaq == maqStep && !b.FechaFin.HasValue);
                                                            var sepLabel = esPendienteTT || !tieneEnProceso
                                                                ? "Estado actual de la máquina asignada"
                                                                : "Actividad actual en esta máquina";
                                                            <div class="maq-sep-label"><i class="bi bi-activity" style="font-size:.55rem;"></i>@sepLabel</div>
                                                            <div class="maq-status-row">
                                                                <span class="maq-live loading"><span class="dot-live"></span><span class="live-txt">consultando…</span></span>
                                                                <span class="maq-carga-lbl">Carga:</span>
                                                                <div class="maq-carga-bar"><div class="maq-carga-fill"></div></div>
                                                                <span class="maq-carga-pct">consultando…</span>
                                                            </div>
                                                        }
                                                    </div>
                                                    @if (hayConflicto)
                                                    {
                                                        <div class="maq-box maq-real-tt" data-maq="@s.MaqRealTt" data-cerrado="false">
                                                            <div class="maq-header-row">
                                                                <i class="bi bi-activity" style="font-size:.6rem;color:#e65c00;"></i>
                                                                <span class="maq-header-lbl">Máquina real en TT ahora</span>
                                                                <span class="maq-src-badge maq-src-real-tt">En proceso · TT</span>
                                                            </div>
                                                            <div class="maq-id-row">
                                                                <span class="maq-cod">@s.MaqRealTt</span>
                                                                <span class="maq-nombre">@maqNombre(s.MaqRealTt)</span>
                                                            </div>
                                                            <div class="maq-status-row">
                                                                <span class="maq-live loading"><span class="dot-live"></span><span class="live-txt">consultando…</span></span>
                                                                <span class="maq-carga-lbl">Carga:</span>
                                                                <div class="maq-carga-bar"><div class="maq-carga-fill"></div></div>
                                                                <span class="maq-carga-pct">consultando…</span>
                                                            </div>
                                                        </div>
                                                    }
                                                    @* ── Otras máquinas planificadas (esPendienteTT — lote aún no en TT) ────── *@
                                                    @if (esPendienteTT && _dtFb != null && _dtFb.CalculoRecetas.Count > 1)
                                                    {
                                                        @foreach (var xCr in _dtFb.CalculoRecetas
                                                            .Where(r => !string.IsNullOrEmpty(r.CodMaqPlanif) && r.CodMaqPlanif != maqStep)
                                                            .GroupBy(r => r.CodMaqPlanif))
                                                        {
                                                            var xMaqP  = xCr.Key!;
                                                            var xDescP = xCr.OrderBy(r => r.Proceso).First().DescProceso;
                                                            var xKgP   = xCr.Sum(r => r.PesoNeto);
                                                            <div class="maq-box maq-prog mt-1" data-maq="@xMaqP" data-cerrado="true">
                                                                <div class="maq-header-row">
                                                                    <i class="bi bi-gear" style="font-size:.6rem;color:#718096;"></i>
                                                                    <span class="maq-header-lbl">Otra máquina planificada para TT</span>
                                                                    <span class="maq-src-badge maq-src-prog">Planificada</span>
                                                                </div>
                                                                <div class="maq-id-row">
                                                                    <span class="maq-cod">@xMaqP</span>
                                                                    <span class="maq-nombre">@maqNombre(xMaqP)</span>
                                                                </div>
                                                                <div class="maq-proc-row">
                                                                    <i class="bi bi-layers" style="font-size:.65rem;color:#718096;"></i>
                                                                    <span class="maq-proc-date" style="color:#718096;">@xDescP · @string.Format("{0:N2}", xKgP) kg planif.</span>
                                                                </div>
                                                                <div class="maq-status-row">
                                                                    <span class="maq-live loading"><span class="dot-live"></span><span class="live-txt">consultando…</span></span>
                                                                    <span class="maq-carga-lbl">Carga:</span>
                                                                    <div class="maq-carga-bar"><div class="maq-carga-fill"></div></div>
                                                                    <span class="maq-carga-pct">consultando…</span>
                                                                </div>
                                                            </div>
                                                        }
                                                    }
                                                    @* ── Baños ya completados en otra máquina (paso aún activo) ─────────────── *@
                                                    @if (!loteCerrado && _dtFb != null && ec.CodPaso != "08"
                                                         && _dtFb.Banos.Any(b => b.FechaFin.HasValue
                                                                               && !string.IsNullOrEmpty(b.CodMaq)
                                                                               && b.CodMaq != maqStep))
                                                    {
                                                        @foreach (var xBg in _dtFb.Banos
                                                            .Where(b => b.FechaFin.HasValue && !string.IsNullOrEmpty(b.CodMaq) && b.CodMaq != maqStep)
                                                            .GroupBy(b => b.CodMaq))
                                                        {
                                                            var xMaq  = xBg.Key!;
                                                            var xFin  = xBg.OrderByDescending(b => b.FechaFin).First().FechaFin!.Value;
                                                            var xDesc = xBg.OrderBy(b => b.FechaIni).First().DescProceso;
                                                            <div class="maq-box maq-cerrado mt-1">
                                                                <div class="maq-header-row">
                                                                    <i class="bi bi-check2-circle" style="font-size:.6rem;color:#2f855a;"></i>
                                                                    <span class="maq-header-lbl">Baño completado en otra máquina</span>
                                                                    <span class="maq-src-badge maq-src-done">Completado ✓</span>
                                                                </div>
                                                                <div class="maq-id-row">
                                                                    <span class="maq-cod">@xMaq</span>
                                                                    <span class="maq-nombre">@maqNombre(xMaq)</span>
                                                                </div>
                                                                <div class="maq-proc-row">
                                                                    <i class="bi bi-check-circle-fill text-success" style="font-size:.65rem;"></i>
                                                                    <span class="maq-proc-date">@xDesc · @xFin.ToString("dd/MM/yy HH:mm")</span>
                                                                </div>
                                                            </div>
                                                        }
                                                    }
                                                    @* ── Máquinas adicionales del lote (cuando >1 máquina fue usada) ─────────── *@
                                                    @if (loteCerrado && _dtFb != null)
                                                    {
                                                        @if (maqStepsTT.Contains(ec.CodPaso) && ec.CodPaso != "08" && _dtFb.Banos.Count > 0)
                                                        {
                                                            @* Baños de TT con CodMaq diferente al principal (maqStep) *@
                                                            @foreach (var xBg in _dtFb.Banos
                                                                .Where(b => !string.IsNullOrEmpty(b.CodMaq) && b.CodMaq != maqStep)
                                                                .GroupBy(b => b.CodMaq))
                                                            {
                                                                var xMaq  = xBg.Key!;
                                                                var xFin  = xBg.Where(b => b.FechaFin.HasValue).OrderByDescending(b => b.FechaFin).Select(b => b.FechaFin).FirstOrDefault();
                                                                var xIni  = xBg.OrderBy(b => b.FechaIni).First().FechaIni;
                                                                var xProc = ec.CodPaso == "06" ? (DateTime?)xIni : xFin;
                                                                <div class="maq-box maq-cerrado mt-1">
                                                                    <div class="maq-header-row">
                                                                        <i class="bi bi-gear-fill" style="font-size:.6rem;color:#718096;"></i>
                                                                        <span class="maq-header-lbl">Máquina utilizada en este lote</span>
                                                                        <span class="maq-src-badge maq-src-done">Lote procesado ✓</span>
                                                                    </div>
                                                                    <div class="maq-id-row">
                                                                        <span class="maq-cod">@xMaq</span>
                                                                        <span class="maq-nombre">@maqNombre(xMaq)</span>
                                                                    </div>
                                                                    @if (xProc.HasValue)
                                                                    {
                                                                        <div class="maq-proc-row">
                                                                            <i class="bi bi-check-circle-fill text-success" style="font-size:.65rem;"></i>
                                                                            <span class="maq-proc-date">Procesado el @xProc.Value.ToString("dd/MM/yy")</span>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        }
                                                        @if (ec.CodPaso == "08" && _dtFb != null && _dtFb.Secados.Count > 1)
                                                        {
                                                            @* Secadoras adicionales: solo las de máquina DIFERENTE a la principal *@
                                                            @foreach (var xSec in _dtFb.Secados.SkipLast(1).Where(x => x.CodMaq != maqStep))
                                                            {
                                                                <div class="maq-box maq-cerrado mt-1">
                                                                    <div class="maq-header-row">
                                                                        <i class="bi bi-gear-fill" style="font-size:.6rem;color:#718096;"></i>
                                                                        <span class="maq-header-lbl">Secadora utilizada en este lote</span>
                                                                        <span class="maq-src-badge maq-src-done">Lote procesado ✓</span>
                                                                    </div>
                                                                    <div class="maq-id-row">
                                                                        <span class="maq-cod">@xSec.CodMaq</span>
                                                                        <span class="maq-nombre">@maqNombre(xSec.CodMaq)</span>
                                                                    </div>
                                                                    @if (xSec.FechaFin.HasValue)
                                                                    {
                                                                        <div class="maq-proc-row">
                                                                            <i class="bi bi-check-circle-fill text-success" style="font-size:.65rem;"></i>
                                                                            <span class="maq-proc-date">Procesado el @xSec.FechaFin.Value.ToString("dd/MM/yy")</span>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        }
                                                    }
                                                }
                                            </div>
                                            @{
                                                bool _tieneActor =
                                                    (ec.CodPaso == "01" && (!string.IsNullOrEmpty(s.NombreRegistro) || !string.IsNullOrEmpty(s.NombreAprobacion)))
                                                 || (ec.CodPaso == "02" && !string.IsNullOrEmpty(s.NombrePlanif));
                                            }
                                            @if ((fEst != null || fReal != null) && !mostrarMaq && !_tieneActor)
                                            {
                                                <div class="tl-fechas">
                                                    @if (fEst != null) { <span><i class="bi bi-calendar2 me-1"></i>@fEst</span> }
                                                    @if (fReal != null) { <span class="tl-fech-real"><i class="bi bi-check2 me-1"></i>@fReal</span> }
                                                </div>
                                            }
                                            @if (ec.CodPaso == "9R" && _dtFb?.RectificacionesReceta.Count > 0)
                                            {
                                                var _r = _dtFb!.RectificacionActiva ?? _dtFb!.RectificacionAprobada;
                                                if (_r != null)
                                                {
                                                    <div class="d-flex align-items-center gap-1 mt-1" style="font-size:.68rem;padding-left:2px;">
                                                        <i class="bi bi-flask" style="color:#dc3545;opacity:.8;"></i>
                                                        <span class="text-secondary">Rectificación:</span>
                                                        <span class="badge bg-@_r.EstadoBadge" style="font-size:.58rem;">@_r.EstadoLabel</span>
                                                        @if (_r.FchAprobado.HasValue)
                                                        {
                                                            <span class="tl-fech-real tt-mono">@_r.FchAprobado.Value.ToString("dd/MM/yy")</span>
                                                        }
                                                    </div>
                                                }
                                            }
                                            @* ── Actores: quien registró y aprobó el pedido (PASO 01) ── *@
                                            @if (ec.CodPaso == "01" && (!string.IsNullOrEmpty(s.NombreRegistro) || !string.IsNullOrEmpty(s.NombreAprobacion)))
                                            {
                                                <div class="tl-actor">
                                                    @if (!string.IsNullOrEmpty(s.NombreRegistro))
                                                    {
                                                        <span class="tl-actor-pill">
                                                            <i class="bi bi-person"></i><strong>Registró:</strong> @s.NombreRegistro
                                                            <span class="ap-fch">(@s.FchPedido.ToString("dd/MM/yy"))</span>
                                                        </span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(s.NombreAprobacion))
                                                    {
                                                        <span class="tl-actor-pill">
                                                            <i class="bi bi-patch-check"></i><strong>Aprobó:</strong> @s.NombreAprobacion
                                                            @if (s.FchAprobacion.HasValue)
                                                            {
                                                                <span class="ap-fch">(@s.FchAprobacion.Value.ToString("dd/MM/yy"))</span>
                                                            }
                                                        </span>
                                                    }
                                                </div>
                                            }
                                            @* ── Actor: quien planificó (PASO 02) ── *@
                                            @if (ec.CodPaso == "02" && !string.IsNullOrEmpty(s.NombrePlanif))
                                            {
                                                <div class="tl-actor">
                                                    <span class="tl-actor-pill">
                                                        <i class="bi bi-calendar2-check"></i><strong>Planificó:</strong> @s.NombrePlanif
                                                        @if (_fch02.HasValue)
                                                        {
                                                            <span class="ap-fch">(@_fch02.Value.ToString("dd/MM/yy"))</span>
                                                        }
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            @* Tab Tintorería — datos completos del formulario Logix *@
                            @{
                                var tabTtPaneId = $"tab-tt-{subIdx}";
                                Model.DetalleTt.TryGetValue(s.NumPartida, out var detTt);
                            }
                            <div class="tab-pane fade" id="@tabTtPaneId" role="tabpanel">
                              @if (s.NumPartida <= 0 || detTt == null || (!detTt.TieneBanos && !detTt.TieneCalculoRecetas && detTt.Secado == null && detTt.Calidad == null && detTt.ValidacionReceta == null && detTt.RectificacionesReceta.Count == 0))
                              {
                                <div class="p-3 text-muted small">
                                    <i class="bi bi-info-circle me-1"></i>
                                    @(s.NumPartida <= 0 ? "Sin partida de tintorería asignada a este sublote." : "Sin datos de tintorería registrados para esta partida.")
                                </div>
                              }
                              else
                              {
                                <div class="p-2" style="font-size:.8rem;">
                                  <div class="accordion accordion-flush" id="acc-tt-@(subIdx)">

                                  @* ── GRUPO: Planificación — Proceso ──────────────────────── *@
                                  @if (detTt!.ValidacionReceta != null || detTt.TieneCalculoRecetas)
                                  {
                                    <div class="tt-grupo-sep"><span>Planificación — Proceso</span></div>
                                  }
                                  @* ── Validación de Laboratorio ─────────────────────────────── *@
                                  @if (detTt!.ValidacionReceta != null)
                                  {
                                    var vr = detTt.ValidacionReceta;
                                    <div class="accordion-item tt-acc-item">
                                      <h2 class="accordion-header">
                                        <button class="accordion-button collapsed tt-acc-btn" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#acc-tt-@(subIdx)-lab"
                                                aria-expanded="false">
                                          <span class="tt-sdot @(vr.FchValidacion.HasValue ? "tt-sdot-ok" : "tt-sdot-run")"></span>
                                          <i class="bi bi-flask me-2"></i>Validación de Laboratorio
                                          <span class="tt-acc-preview">@vr.DescEstado@(vr.FchValidacion.HasValue ? $" · {vr.FchValidacion.Value.ToString("dd/MM/yy")}" : "")</span>
                                        </button>
                                      </h2>
                                      <div id="acc-tt-@(subIdx)-lab" class="accordion-collapse collapse">
                                        <div class="accordion-body p-2">
                                          <div class="tt-data-grid" style="background:#f8f6ff;border:1px solid #e0d8f5;">
                                            <div><span class="tt-lbl">N° Registro</span><span class="tt-val">@vr.Numero</span></div>
                                            <div><span class="tt-lbl">Tipo</span><span class="tt-val">@vr.DescTipo</span></div>
                                            <div><span class="tt-lbl">Laboratorista</span><span class="tt-val fw-semibold">@(string.IsNullOrEmpty(vr.Laboratorista) ? "—" : vr.Laboratorista)</span></div>
                                            <div><span class="tt-lbl">F. Registro</span><span class="tt-val">@vr.FchRegistro.ToString("dd/MM/yy HH:mm")</span></div>
                                            <div><span class="tt-lbl">F. Validación</span><span class="tt-val">@(vr.FchValidacion?.ToString("dd/MM/yy HH:mm") ?? "—")</span></div>
                                            <div>
                                              <span class="tt-lbl">Estado</span>
                                              <span class="badge bg-@vr.EstadoBadge" style="font-size:.65rem;">@vr.DescEstado</span>
                                              @if (vr.DiasValidacion.HasValue)
                                              {
                                                <span class="text-muted ms-1" style="font-size:.68rem;">(@vr.DiasValidacion.Value d.)</span>
                                              }
                                            </div>
                                          </div>
                                        </div>
                                      </div>
                                    </div>
                                  }

                                  @* ── Cálculo de Recetas planificadas ───────────────────────── *@
                                  @if (detTt!.TieneCalculoRecetas)
                                  {
                                    <div class="accordion-item tt-acc-item">
                                      <h2 class="accordion-header">
                                        <button class="accordion-button collapsed tt-acc-btn" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#acc-tt-@(subIdx)-rec"
                                                aria-expanded="false">
                                          <span class="tt-sdot tt-sdot-plan"></span>
                                          <i class="bi bi-calculator me-2"></i>Cálculo de Recetas (planificado)
                                          <span class="tt-acc-preview">@detTt.CalculoRecetas.Count receta@(detTt.CalculoRecetas.Count != 1 ? "s" : "")</span>
                                        </button>
                                      </h2>
                                      <div id="acc-tt-@(subIdx)-rec" class="accordion-collapse collapse">
                                        <div class="accordion-body p-2">
                                          <div class="table-responsive">
                                            <table class="table table-sm tt-table mb-0">
                                              <thead><tr>
                                                <th>Guía</th><th>Proceso</th><th>Máq. planif.</th><th style="text-align:right">Peso neto (kg)</th><th>Estado receta</th>
                                              </tr></thead>
                                              <tbody>
                                              @foreach (var cr in detTt.CalculoRecetas)
                                              {
                                                <tr>
                                                  <td class="tt-mono">@cr.Guia</td>
                                                  <td><span class="badge bg-secondary" style="font-size:.65rem;">@cr.Proceso</span> @cr.DescProceso</td>
                                                  <td>
                                                    @if (!string.IsNullOrEmpty(cr.CodMaqPlanif))
                                                    {
                                                      <span class="maq-cod-inline">@cr.CodMaqPlanif</span>
                                                      <span class="text-muted ms-1">@cr.NombreMaqPlanif</span>
                                                    }
                                                    else { <text>—</text> }
                                                  </td>
                                                  <td style="text-align:right">@(cr.PesoNeto.HasValue ? cr.PesoNeto.Value.ToString("N2") : "—")</td>
                                                  <td><span class="text-muted">@cr.DescEstReceta</span></td>
                                                </tr>
                                              }
                                              </tbody>
                                            </table>
                                          </div>
                                        </div>
                                      </div>
                                    </div>
                                  }

                                  @* ── GRUPO: Tintorería — Producción ─────────────────────── *@
                                  @if (detTt!.TieneBanos || detTt.Secados.Count > 0 || detTt.Calidad != null || s.FchRealCcRechazo.HasValue || detTt.RectificacionesReceta.Count > 0)
                                  {
                                    <div class="tt-grupo-sep"><span>Tintorería — Producción</span></div>
                                  }
                                  @* ── Registro de Producción TT (baños) ─────────────────────── *@
                                  @if (detTt!.TieneBanos)
                                  {
                                    <div class="accordion-item tt-acc-item">
                                      <h2 class="accordion-header">
                                        <button class="accordion-button collapsed tt-acc-btn" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#acc-tt-@(subIdx)-ban"
                                                aria-expanded="false">
                                          <span class="tt-sdot @(detTt.Banos.Count(b => b.FechaFin.HasValue) == detTt.Banos.Count ? "tt-sdot-ok" : "tt-sdot-run")"></span>
                                          <i class="bi bi-thermometer-half me-2"></i>Registro de Producción — Tintorería
                                          <span class="badge ms-2" style="background:#6f42c1;font-size:.6rem;">@detTt.Banos.Count baño@(detTt.Banos.Count != 1 ? "s" : "")</span>
                                          <span class="tt-acc-preview">@detTt.Banos.Count(b => b.FechaFin.HasValue)/@detTt.Banos.Count completado@(detTt.Banos.Count != 1 ? "s" : "")@(!string.IsNullOrEmpty(detTt.Banos.FirstOrDefault()?.CodMaq) ? $" · {detTt.Banos[0].CodMaq}" : "")</span>
                                        </button>
                                      </h2>
                                      <div id="acc-tt-@(subIdx)-ban" class="accordion-collapse collapse">
                                        <div class="accordion-body p-2">
                                          <div class="table-responsive">
                                            <table class="table table-sm tt-table mb-0">
                                              <thead><tr>
                                                <th>Guía</th><th>Proceso</th><th>Máquina real</th><th>Máq. planif.</th><th>F/Hora inicio</th><th>F/Hora fin</th><th style="text-align:right">Horas</th><th>Calificación</th>
                                              </tr></thead>
                                              <tbody>
                                              @foreach (var bn in detTt.Banos)
                                              {
                                                var bRowCss = bn.HayCambioMaquina ? "table-warning" : "";
                                                <tr class="@bRowCss">
                                                  <td class="tt-mono">@bn.Guia</td>
                                                  <td><span class="badge bg-secondary" style="font-size:.65rem;">@bn.Proceso</span> @bn.DescProceso</td>
                                                  <td>
                                                    <span class="maq-cod-inline @(bn.HayCambioMaquina ? "text-danger fw-bold" : "")">@bn.CodMaq</span>
                                                    <span class="text-muted ms-1">@bn.NombreMaq</span>
                                                    @if (bn.HayCambioMaquina)
                                                    {
                                                      <i class="bi bi-exclamation-triangle-fill text-warning ms-1" title="Máquina diferente a la planificada"></i>
                                                    }
                                                  </td>
                                                  <td>
                                                    @if (!string.IsNullOrEmpty(bn.CodMaqPlanif))
                                                    {
                                                      <span class="maq-cod-inline text-secondary">@bn.CodMaqPlanif</span>
                                                      <span class="text-muted ms-1" style="font-size:.72rem;">@bn.NombreMaqPlanif</span>
                                                    }
                                                    else { <text>—</text> }
                                                  </td>
                                                  <td class="tt-mono">@bn.FechaIni.ToString("dd/MM/yy HH:mm")</td>
                                                  <td class="tt-mono">@(bn.FechaFin?.ToString("dd/MM/yy HH:mm") ?? "—")</td>
                                                  <td style="text-align:right" class="tt-mono">@(string.IsNullOrEmpty(bn.HorasFormateado) ? "—" : bn.HorasFormateado)</td>
                                                  <td>
                                                    @if (!string.IsNullOrEmpty(bn.Calificacion))
                                                    {
                                                      <span class="badge" style="background:#6f42c1;font-size:.63rem;">@bn.DescCalif</span>
                                                    }
                                                    else { <span class="text-muted">—</span> }
                                                  </td>
                                                </tr>
                                              }
                                              </tbody>
                                            </table>
                                          </div>
                                          @if (detTt.HayCambioMaquina)
                                          {
                                            <div class="text-warning small mt-1"><i class="bi bi-exclamation-triangle-fill me-1"></i>Se ejecutó en una máquina diferente a la planificada.</div>
                                          }
                                        </div>
                                      </div>
                                    </div>
                                  }

                                  @* ── Registro de Secado ─────────────────────────────────────── *@
                                  @if (detTt!.Secados.Count > 0)
                                  {
                                    <div class="accordion-item tt-acc-item">
                                      <h2 class="accordion-header">
                                        <button class="accordion-button collapsed tt-acc-btn" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#acc-tt-@(subIdx)-sec"
                                                aria-expanded="false">
                                          <span class="tt-sdot @(detTt.Secados.All(x => x.FechaFin.HasValue) ? "tt-sdot-ok" : "tt-sdot-run")"></span>
                                          <i class="bi bi-wind me-2"></i>Registro de Secado
                                          <span class="tt-acc-preview">@detTt.Secados.Count sesión@(detTt.Secados.Count != 1 ? "es" : "")@(detTt.Secados.Any(x => x.PesoNeto.HasValue) ? $" · {detTt.Secados.Where(x => x.PesoNeto.HasValue).Sum(x => x.PesoNeto!.Value):N0} kg" : "")</span>
                                        </button>
                                      </h2>
                                      <div id="acc-tt-@(subIdx)-sec" class="accordion-collapse collapse">
                                        <div class="accordion-body p-2">
                                          @foreach (var sec in detTt.Secados)
                                          {
                                            <div class="tt-data-grid mb-1" style="background:#f0fdf4;border:1px solid #c6f6d5;">
                                              <div><span class="tt-lbl">Máquina</span>
                                                <span class="maq-cod-inline">@sec.CodMaq</span>
                                                <span class="text-muted ms-1">@sec.NombreMaq</span>
                                              </div>
                                              <div><span class="tt-lbl">Inicio</span><span class="tt-val tt-mono">@sec.FechaIni.ToString("dd/MM/yy HH:mm")</span></div>
                                              <div><span class="tt-lbl">Fin</span><span class="tt-val tt-mono">@(sec.FechaFin?.ToString("dd/MM/yy HH:mm") ?? "—")</span></div>
                                              <div><span class="tt-lbl">Duración</span><span class="tt-val">@(sec.DuracionHoras.HasValue ? $"{sec.DuracionHoras.Value:N1} h" : "—")</span></div>
                                              <div><span class="tt-lbl">Min. secado</span><span class="tt-val">@(sec.MinSecado.HasValue ? $"{sec.MinSecado.Value:N0} min" : "—")</span></div>
                                              @if (sec.MinResecado.HasValue && sec.MinResecado.Value > 0)
                                              {
                                                <div><span class="tt-lbl">Min. re-secado</span><span class="tt-val text-warning">@sec.MinResecado.Value.ToString("N0") min</span></div>
                                              }
                                              <div><span class="tt-lbl">Peso neto</span><span class="tt-val fw-semibold">@(sec.PesoNeto.HasValue ? $"{sec.PesoNeto.Value:N2} kg" : "—")</span></div>
                                              <div><span class="tt-lbl">Estado</span><span class="text-muted">@sec.DescEstado</span></div>
                                            </div>
                                          }
                                        </div>
                                      </div>
                                    </div>
                                  }

                                  @* ── Control de Calidad TT ──────────────────────────────────── *@
                                  @if (detTt!.Calidad != null)
                                  {
                                    var cc = detTt.Calidad;
                                    <div class="accordion-item tt-acc-item">
                                      <h2 class="accordion-header">
                                        <button class="accordion-button collapsed tt-acc-btn" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#acc-tt-@(subIdx)-cc"
                                                aria-expanded="false">
                                          <span class="tt-sdot @(cc.ResultadoBadge == "success" ? "tt-sdot-ok" : "tt-sdot-run")"></span>
                                          <i class="bi bi-patch-check me-2"></i>Control de Calidad — Tintorería
                                          <span class="tt-acc-preview">@cc.DescResultado · @cc.Fecha.ToString("dd/MM/yy")</span>
                                        </button>
                                      </h2>
                                      <div id="acc-tt-@(subIdx)-cc" class="accordion-collapse collapse">
                                        <div class="accordion-body p-2">
                                          <div class="p-2" style="background:#fff8f0;border-radius:6px;border:1px solid #fed7aa;">
                                            <div class="d-flex flex-wrap gap-3 align-items-start mb-2">
                                          <div><span class="tt-lbl">Fecha</span><span class="tt-val tt-mono">@cc.Fecha.ToString("dd/MM/yy HH:mm")</span></div>
                                          <div>
                                            <span class="tt-lbl">Evaluación</span>
                                            <span class="badge bg-secondary" style="font-size:.65rem;">@cc.EstEvaluacion</span>
                                            <span class="ms-1 text-muted">@cc.DescEstEval</span>
