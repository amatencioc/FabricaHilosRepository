@model FabricaHilos.Models.Contabilidad.ActivoFijoDto

@{
    ViewData["Title"] = $"Editar Activo — {Model.Codigo}";
    var archivos        = ViewBag.Archivos        as List<FabricaHilos.Models.Contabilidad.ArchivoAfDto> ?? new();
    string? navToken    = ViewBag.NavToken        as string;
    string? nomAlta      = ViewBag.NombreUserAlta  as string;
    string? nomBaja      = ViewBag.NombreUserBaja  as string;
    string? nomUsuario   = ViewBag.UsuarioLogueado as string;
    string? nomJefatura  = ViewBag.NombreJefatura  as string;

    var archivosAlta = archivos.Where(a => a.Tipo == "alta").ToList();
    var archivosBaja = archivos.Where(a => a.Tipo == "baja").ToList();

    // Estado del visado de alta
    var visadoAlta  = Model.VisadoAlta ?? "N";
    var visadoFecha = Model.VisadoAltaFecha;
    var visadoObs   = Model.VisadoAltaObs;
    // Badge CSS: N=secondary, P=warning, A=success, R=danger
    string visadoCss  = visadoAlta switch { "P"=>"warning","A"=>"success","R"=>"danger",_=>"secondary" };
    string visadoText = visadoAlta switch { "P"=>"Pendiente","A"=>"Aprobado","R"=>"Devuelto",_=>"Sin visar" };
    bool   puedeEnviarVisado = !string.IsNullOrWhiteSpace(Model.UserAlta) && visadoAlta != "A";
    bool   altaBloqueada     = visadoAlta == "A";   // impide editar observaciones, archivos y eliminar

    // Lookups resueltos para Identificacion
    var proveedores = ViewBag.Proveedores as Dictionary<string, string> ?? new();
    var ccostos     = ViewBag.CCostos     as Dictionary<string, string> ?? new();
    _ = proveedores.TryGetValue(Model.CodProveed ?? "", out var nomProv);
    _ = ccostos.TryGetValue(Model.CCosto ?? "", out var nomCC);

    // Campos de Identificacion: readonly si ya tienen data (evitar borrado accidental)
    bool roModelo   = !string.IsNullOrWhiteSpace(Model.Modelo);
    bool roMarca    = !string.IsNullOrWhiteSpace(Model.Marca);
    bool roSerie    = !string.IsNullOrWhiteSpace(Model.Serie);
    bool roColor    = !string.IsNullOrWhiteSpace(Model.Color);
    bool roCodProv  = !string.IsNullOrWhiteSpace(Model.CodProveed);
    bool roTipoDoc  = !string.IsNullOrWhiteSpace(Model.TipoDoc);
    bool roSerieDoc = !string.IsNullOrWhiteSpace(Model.SerieDoc);
    bool roNumDoc   = !string.IsNullOrWhiteSpace(Model.NumDoc);
    bool roDesc     = !string.IsNullOrWhiteSpace(Model.Descripcion);
    bool roFIngreso = Model.FIngreso.HasValue;
    bool roCCosto   = !string.IsNullOrWhiteSpace(Model.CCosto);
    bool roFFabrica = Model.FFabrica.HasValue;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Contabilidad" asp-action="Index">Contabilidad</a></li>
    <li class="breadcrumb-item">
        <a asp-action="Index" asp-route-t="@navToken">Activos Fijos</a>
    </li>
    <li class="breadcrumb-item active">@Model.Codigo</li>
}

@section Styles {
    <link rel="stylesheet" href="~/css/sire.css" asp-append-version="true" />
}

@await Html.PartialAsync("~/Views/Contabilidad/ActivoFijo/_ActivoFijoNavBar.cshtml")

<div class="sire-page-header flex-wrap gap-2">
    <div class="sire-page-icon af flex-shrink-0">
        <i class="bi bi-pencil-square"></i>
    </div>
    <div class="flex-grow-1 min-w-0">
        <h4 class="sire-page-title mb-0">Activo Fijo &#8212; <span class="sire-code">@Model.Codigo</span></h4>
        <div class="sire-page-sub">@Model.ClaseDescripcion</div>
    </div>
    <div class="sire-page-actions flex-wrap">
        <!-- Dropdown Fichas: Alta / Baja -->
        <div class="btn-group">
            <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle"
                    data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-printer me-1"></i><span class="d-none d-sm-inline">Imprimir</span> Ficha
            </button>
            <ul class="dropdown-menu">
                <li>
                    <a class="dropdown-item"
                       asp-action="Ficha"
                       asp-route-clase="@Model.Clase"
                       asp-route-codigo="@Model.Codigo"
                       asp-route-numero="@Model.Numero"
                       asp-route-tipo="alta"
                       target="_blank">
                        <i class="bi bi-arrow-up-circle text-success me-2"></i>Ficha de Alta
                    </a>
                </li>
                <li>
                    <a class="dropdown-item"
                       asp-action="Ficha"
                       asp-route-clase="@Model.Clase"
                       asp-route-codigo="@Model.Codigo"
                       asp-route-numero="@Model.Numero"
                       asp-route-tipo="baja"
                       target="_blank">
                        <i class="bi bi-arrow-down-circle text-danger me-2"></i>Ficha de Baja
                    </a>
                </li>
            </ul>
        </div>
        <a asp-action="Index" asp-route-t="@navToken" class="btn btn-sm btn-outline-dark">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>

<!-- Formulario principal: Identificacion -->
<form method="post" asp-action="Editar" asp-route-t="@navToken">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Clase"  />
    <input type="hidden" asp-for="Codigo" />
    <input type="hidden" asp-for="Numero" />

    <!-- Identificacion -->
    <div class="sire-card mb-3">
        <div class="sire-card-header">
            <i class="bi bi-tag"></i>Identificacion
        </div>
        <div class="sire-card-body">
            <div class="row g-3">
                <!-- Fila 1: Descripcion -->
                <div class="col-12">
                    <label class="form-label form-label-sm">Descripci&#243;n</label>
                    @if (roDesc)
                    {
                        <input asp-for="Descripcion" class="form-control form-control-sm" maxlength="120" disabled />
                        <input type="hidden" asp-for="Descripcion" />
                    }
                    else
                    {
                        <input asp-for="Descripcion" class="form-control form-control-sm" maxlength="120" />
                    }
                </div>
                <!-- Fila 2: Modelo / Marca / Serie -->
                <div class="col-12 col-md-4">
                    <label class="form-label form-label-sm">Modelo</label>
                    @if (roModelo)
                    {
                        <input asp-for="Modelo" class="form-control form-control-sm" maxlength="60" disabled />
                        <input type="hidden" asp-for="Modelo" />
                    }
                    else
                    {
                        <input asp-for="Modelo" class="form-control form-control-sm" maxlength="60" />
                    }
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label form-label-sm">Marca</label>
                    @if (roMarca)
                    {
                        <input asp-for="Marca" class="form-control form-control-sm" maxlength="60" disabled />
                        <input type="hidden" asp-for="Marca" />
                    }
                    else
                    {
                        <input asp-for="Marca" class="form-control form-control-sm" maxlength="60" />
                    }
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label form-label-sm">N&#176; de Serie</label>
                    @if (roSerie)
                    {
                        <input asp-for="Serie" class="form-control form-control-sm" maxlength="40" disabled />
                        <input type="hidden" asp-for="Serie" />
                    }
                    else
                    {
                        <input asp-for="Serie" class="form-control form-control-sm" maxlength="40" />
                    }
                </div>
                <!-- Fila 3: Color / Proveedor / Año Fabricacion -->
                <div class="col-12 col-md-4">
                    <label class="form-label form-label-sm">Color</label>
                    @if (roColor)
                    {
                        <input asp-for="Color" class="form-control form-control-sm" maxlength="40" disabled />
                        <input type="hidden" asp-for="Color" />
                    }
                    else
                    {
                        <input asp-for="Color" class="form-control form-control-sm" maxlength="40" />
                    }
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label form-label-sm">C&#243;d. Proveedor</label>
                    @if (roCodProv)
                    {
                        <input asp-for="CodProveed" class="form-control form-control-sm" maxlength="15" disabled />
                        <input type="hidden" asp-for="CodProveed" />
                    }
                    else
                    {
                        <input asp-for="CodProveed" class="form-control form-control-sm" maxlength="15" />
                    }
                    @if (!string.IsNullOrWhiteSpace(nomProv))
                    {
                        <div class="form-text text-success small">@nomProv</div>
                    }
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label form-label-sm">A&#241;o de Fabricaci&#243;n</label>
                    @if (roFFabrica)
                    {
                        <input asp-for="FFabrica" type="date" class="form-control form-control-sm"
                               value="@(Model.FFabrica?.ToString("yyyy-MM-dd") ?? "")" disabled />
                        <input type="hidden" asp-for="FFabrica" value="@(Model.FFabrica?.ToString("yyyy-MM-dd") ?? "")" />
                    }
                    else
                    {
                        <input asp-for="FFabrica" type="date" class="form-control form-control-sm"
                               value="@(Model.FFabrica?.ToString("yyyy-MM-dd") ?? "")" />
                    }
                </div>
                <!-- Fila 4: Fecha Recepcion / Centro Costo -->
                <div class="col-12 col-md-4">
                    <label class="form-label form-label-sm">Fecha de Recepci&#243;n</label>
                    @if (roFIngreso)
                    {
                        <input asp-for="FIngreso" type="date" class="form-control form-control-sm"
                               value="@(Model.FIngreso?.ToString("yyyy-MM-dd") ?? "")" disabled />
                        <input type="hidden" asp-for="FIngreso" value="@(Model.FIngreso?.ToString("yyyy-MM-dd") ?? "")" />
                    }
                    else
                    {
                        <input asp-for="FIngreso" type="date" class="form-control form-control-sm"
                               value="@(Model.FIngreso?.ToString("yyyy-MM-dd") ?? "")" />
                    }
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label form-label-sm">Centro de Costo</label>
                    @if (roCCosto)
                    {
                        <input asp-for="CCosto" class="form-control form-control-sm" maxlength="15" disabled />
                        <input type="hidden" asp-for="CCosto" />
                    }
                    else
                    {
                        <input asp-for="CCosto" class="form-control form-control-sm" maxlength="15" />
                    }
                    @if (!string.IsNullOrWhiteSpace(nomCC))
                    {
                        <div class="form-text text-success small">@nomCC</div>
                    }
                </div>
                <!-- Fila 5: Comprobante -->
                <div class="col-6 col-md-2">
                    <label class="form-label form-label-sm">Tipo Doc.</label>
                    @if (roTipoDoc)
                    {
                        <input asp-for="TipoDoc" class="form-control form-control-sm" maxlength="2" placeholder="ej: 01" disabled />
                        <input type="hidden" asp-for="TipoDoc" />
                    }
                    else
                    {
                        <input asp-for="TipoDoc" class="form-control form-control-sm" maxlength="2" placeholder="ej: 01" />
                    }
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label form-label-sm">Serie Doc.</label>
                    @if (roSerieDoc)
                    {
                        <input asp-for="SerieDoc" class="form-control form-control-sm" maxlength="4" placeholder="F001" disabled />
                        <input type="hidden" asp-for="SerieDoc" />
                    }
                    else
                    {
                        <input asp-for="SerieDoc" class="form-control form-control-sm" maxlength="4" placeholder="F001" />
                    }
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label form-label-sm">N&#176; Comprobante de Recepci&#243;n</label>
                    @if (roNumDoc)
                    {
                        <input asp-for="NumDoc" class="form-control form-control-sm" maxlength="15" disabled />
                        <input type="hidden" asp-for="NumDoc" />
                    }
                    else
                    {
                        <input asp-for="NumDoc" class="form-control form-control-sm" maxlength="15" />
                    }
                </div>
                <!-- Fila 6: Valores -->
                <div class="col-6 col-md-2">
                    <label class="form-label form-label-sm">Valor Residual (S/)</label>
                    <input asp-for="ValResidS" type="number" step="0.01" class="form-control form-control-sm text-end" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label form-label-sm">Vida &#218;til (a&#241;os)</label>
                    <input asp-for="VidaUtil" type="number" min="0" max="100" class="form-control form-control-sm text-end" />
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mb-4">
        <button type="submit" class="btn btn-sm btn-primary">
            <i class="bi bi-floppy me-1"></i>Guardar Identificacion
        </button>
        <a asp-action="Index" asp-route-t="@navToken" class="btn btn-sm btn-outline-secondary">
            Cancelar
        </a>
    </div>
</form>

<!-- Form externo para EnviarVisado (HTML no permite forms anidados) -->
@if (puedeEnviarVisado)
{
    <form id="frmEnviarVisado" method="post"
          asp-action="EnviarVisado" asp-route-t="@navToken"
          asp-route-clase="@Model.Clase" asp-route-codigo="@Model.Codigo"
          asp-route-numero="@Model.Numero"
          style="display:none;">
        @Html.AntiForgeryToken()
    </form>
}

<!-- Paneles Alta y Baja -->
<div class="row g-3 mb-4">

    <!-- Alta -->
    <div class="col-12 col-md-6">
        <form method="post" asp-action="GuardarYSubirAlta" asp-route-t="@navToken"
              enctype="multipart/form-data" id="formAlta">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Clase"       value="@Model.Clase" />
            <input type="hidden" name="Codigo"      value="@Model.Codigo" />
            <input type="hidden" name="Numero"      value="@Model.Numero" />
            <input type="hidden" name="ReturnToken" value="@navToken" />

            <div class="sire-card">
                <div class="sire-card-header bg-success bg-opacity-10 border-success">
                    <i class="bi bi-person-check text-success"></i>
                    <span class="text-success fw-semibold">Responsable del Alta</span>
                    @{
                        var mostrarAltaUser = !string.IsNullOrWhiteSpace(nomAlta) ? nomAlta : nomUsuario;
                    }
                    @if (!string.IsNullOrWhiteSpace(mostrarAltaUser))
                    {
                        <span class="ms-2 badge bg-success bg-opacity-25 text-success fw-normal">
                            <i class="bi bi-person-circle me-1"></i>@mostrarAltaUser
                        </span>
                    }
                    <span class="ms-auto sire-badge sire-badge-ok">@archivosAlta.Count docs</span>
                </div>
                <div class="sire-card-body">
                    <div class="mb-3">
                        <label class="form-label form-label-sm">Fecha de Inicio de Operaciones</label>
                        <input type="hidden" name="FOperaEnviada" value="true" />
                        <input type="date" name="FOpera" id="fOpera"
                               class="form-control form-control-sm"
                               value="@(Model.FOpera.HasValue ? Model.FOpera.Value.ToString("yyyy-MM-dd") : "")"
                               @(altaBloqueada ? "readonly" : "") />
                    </div>
                    <label class="form-label form-label-sm">Observaciones de Alta</label>
                    <textarea name="ObsAlta" id="obsAlta" class="form-control form-control-sm mb-1"
                              rows="3" maxlength="1000"
                              @(altaBloqueada ? "readonly" : "")>@Model.ObsAlta</textarea>
                    <div class="d-flex justify-content-end mb-3">
                        <small class="text-muted"><span id="obsAltaCount">0</span> / 1000</small>
                    </div>

                    @if (archivosAlta.Any())
                    {
                        var altaIdx = 0;
                        <div class="list-group list-group-flush mb-3">
                            @foreach (var arch in archivosAlta)
                            {
                                var frmIdAlta = $"frmDelAlta{altaIdx++}";
                                var esPdfAlta = arch.NombreArchivo.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
                                var labelAlta = $"{(esPdfAlta ? "PDF" : "Imagen")} {altaIdx} de Alta — {arch.FechaCarga:dd/MM/yy}";
                                <div class="list-group-item d-flex align-items-center gap-2 px-0">
                                    <i class="bi @(esPdfAlta ? "bi-file-pdf text-danger" : "bi-image text-primary")"></i>
                                    <span class="small flex-grow-1 text-truncate" title="@arch.NombreArchivo">@arch.NombreArchivo</span>
                                    <span class="text-muted" style="font-size:.7rem;">@arch.FechaCarga.ToString("dd/MM/yy")</span>
                                    <button type="button" class="btn btn-xs btn-outline-primary" title="Ver"
                                            onclick="verArchivo('@Html.Raw(Url.Action("Ver","ActivoFijo",new{area="",carpetaKey=Model.CarpetaKey,tipo="alta",nombreArchivo=arch.NombreArchivo}))' + '?v=@arch.FechaCarga.Ticks', '@Html.Raw(arch.NombreArchivo)')">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <a asp-action="Descargar" asp-route-carpetaKey="@Model.CarpetaKey"
                                       asp-route-tipo="alta" asp-route-nombreArchivo="@arch.NombreArchivo"
                                       class="btn btn-xs btn-outline-secondary" title="Descargar">
                                        <i class="bi bi-download"></i>
                                    </a>
                                    @if (!altaBloqueada)
                                    {
                                        <button type="submit" form="@frmIdAlta"
                                                class="btn btn-xs btn-outline-danger"
                                                title="Eliminar"
                                                data-modal-confirm
                                                data-confirm-msg="&#191;Eliminar @labelAlta?"
                                                data-form-id="@frmIdAlta">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (!altaBloqueada)
                    {
                        <div class="mb-1">
                            <input type="file" name="Archivos" id="inputArchivoAlta"
                                   class="form-control form-control-sm"
                                   multiple accept=".jpg,.jpeg,.png,.pdf" />
                            <div class="form-text">JPG, PNG, PDF &#8212; Formato de alta y acta de entrega</div>
                        </div>
                        <div class="d-flex gap-2 mt-2 flex-wrap align-items-center">
                            <button type="submit" class="btn btn-sm btn-success" id="btnGuardarAlta">
                                <i class="bi bi-floppy me-1"></i>Guardar
                            </button>
                        </div>
                    }
                </div>
            </div>
            @if (altaBloqueada)
            {
                <div class="alert alert-success d-flex align-items-center gap-2 mt-2 py-2 px-3" data-no-autoclose style="font-size:.84rem;">
                    <i class="bi bi-lock-fill"></i>
                    <span>El alta fue <strong>aprobada por jefatura</strong>. No se pueden realizar modificaciones.</span>
                </div>
            }
        </form>
    </div>

    <!-- Baja -->
    <div class="col-12 col-md-6">
        <form method="post" asp-action="GuardarYSubirBaja" asp-route-t="@navToken"
              enctype="multipart/form-data" id="formBaja">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Clase"         value="@Model.Clase" />
            <input type="hidden" name="Codigo"        value="@Model.Codigo" />
            <input type="hidden" name="Numero"        value="@Model.Numero" />
            <input type="hidden" name="ReturnToken"   value="@navToken" />
            <input type="hidden" name="FBajaEnviada"  value="true" />

            <div class="sire-card">
                <div class="sire-card-header bg-danger bg-opacity-10 border-danger">
                    <i class="bi bi-person-dash text-danger"></i>
                    <span class="text-danger fw-semibold">Responsable de la Baja</span>
                    @{
                        var mostrarBajaUser = !string.IsNullOrWhiteSpace(nomBaja) ? nomBaja : nomUsuario;
                    }
                    @if (!string.IsNullOrWhiteSpace(mostrarBajaUser))
                    {
                        <span class="ms-2 badge bg-danger bg-opacity-25 text-danger fw-normal">
                            <i class="bi bi-person-circle me-1"></i>@mostrarBajaUser
                        </span>
                    }
                    <span class="ms-auto sire-badge sire-badge-danger">@archivosBaja.Count docs</span>
                </div>
                <div class="sire-card-body">
                    <!-- CAMPOS DE BAJA: Estado, F_Baja, Estado SUNAT -->
                    <div class="row g-2 mb-3">
                        <div class="col-md-5">
                            <label class="form-label form-label-sm">Estado</label>
                            <select name="EstadoBaja" class="form-select form-select-sm">
                                <option value="">— Sin especificar —</option>
                                <option value="0"  selected="@(Model.Estado == "0" )">ALTA</option>
                                <option value="6"  selected="@(Model.Estado == "6" )">BAJA X VENTA</option>
                                <option value="7"  selected="@(Model.Estado == "7" )">BAJA X VENTA (DEPRECIADO)</option>
                                <option value="8"  selected="@(Model.Estado == "8" )">BAJA X DETERIORO</option>
                                <option value="9"  selected="@(Model.Estado == "9" )">BAJA X DESHUSO</option>
                                <option value="5"  selected="@(Model.Estado == "5" )">OTROS</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label form-label-sm">Fecha de Baja</label>
                            <input type="date" name="FBaja" class="form-control form-control-sm"
                                   value="@(Model.FBaja?.ToString("yyyy-MM-dd") ?? "")" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label form-label-sm">Estado SUNAT</label>
                            <select name="CSestado" class="form-select form-select-sm">
                                <option value="">— Sin especificar —</option>
                                <option value="1" selected="@(Model.CSestado == "1")">1 — Activos en Desuso</option>
                                <option value="2" selected="@(Model.CSestado == "2")">2 — Activos Obsoletos</option>
                                <option value="9" selected="@(Model.CSestado == "9")">9 — Resto de Activos</option>
                            </select>
                        </div>
                    </div>
                    <label class="form-label form-label-sm">Observaciones de Baja</label>
                    <textarea name="ObsBaja" id="obsBaja" class="form-control form-control-sm mb-1"
                              rows="3" maxlength="1000">@Model.ObsBaja</textarea>
                    <div class="d-flex justify-content-end mb-3">
                        <small class="text-muted"><span id="obsBajaCount">0</span> / 1000</small>
                    </div>

                    @if (archivosBaja.Any())
                    {
                        var bajaIdx = 0;
                        <div class="list-group list-group-flush mb-3">
                            @foreach (var arch in archivosBaja)
                            {
                                var frmIdBaja    = $"frmDelBaja{bajaIdx++}";
                                var esPdfBaja    = arch.NombreArchivo.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
                                var labelBaja    = $"{(esPdfBaja ? "PDF" : "Imagen")} {bajaIdx} de Baja — {arch.FechaCarga:dd/MM/yy}";
                                <div class="list-group-item d-flex align-items-center gap-2 px-0">
                                    <i class="bi @(esPdfBaja ? "bi-file-pdf text-danger" : "bi-image text-primary")"></i>
                                    <span class="small flex-grow-1 text-truncate" title="@arch.NombreArchivo">@arch.NombreArchivo</span>
                                    <span class="text-muted" style="font-size:.7rem;">@arch.FechaCarga.ToString("dd/MM/yy")</span>
                                    <button type="button" class="btn btn-xs btn-outline-primary" title="Ver"
                                            onclick="verArchivo('@Html.Raw(Url.Action("Ver","ActivoFijo",new{area="",carpetaKey=Model.CarpetaKey,tipo="baja",nombreArchivo=arch.NombreArchivo}))' + '?v=@arch.FechaCarga.Ticks', '@Html.Raw(arch.NombreArchivo)')">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <a asp-action="Descargar" asp-route-carpetaKey="@Model.CarpetaKey"
                                       asp-route-tipo="baja" asp-route-nombreArchivo="@arch.NombreArchivo"
                                       class="btn btn-xs btn-outline-secondary" title="Descargar">
                                        <i class="bi bi-download"></i>
                                    </a>
                                    <button type="submit" form="@frmIdBaja"
                                            class="btn btn-xs btn-outline-danger"
                                            title="Eliminar"
                                            data-modal-confirm
                                            data-confirm-msg="&#191;Eliminar @labelBaja?"
                                            data-form-id="@frmIdBaja">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    }

                    <div class="mb-1">
                        <input type="file" name="Archivos" id="inputArchivoBaja"
                               class="form-control form-control-sm"
                               multiple accept=".jpg,.jpeg,.png,.pdf" />
                        <div class="form-text">JPG, PNG, PDF &#8212; Memorando o resolucion de baja</div>
                    </div>
                    <div class="d-flex gap-2 mt-2">
                        <button type="submit" class="btn btn-sm btn-danger" id="btnGuardarBaja">
                            <i class="bi bi-floppy me-1"></i>Guardar
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@* ─── PANEL DE VISADO DE ALTA (solo visible si el alta ya tiene documentos adjuntos) *@
@if (archivosAlta.Any())
{
    string visadoBorderCss = visadoAlta switch { "P" => "border-warning", "A" => "border-success", "R" => "border-danger", _ => "border-secondary" };
    string visadoHeaderCss = visadoAlta switch { "P" => "bg-warning bg-opacity-10", "A" => "bg-success bg-opacity-10", "R" => "bg-danger bg-opacity-10", _ => "bg-secondary bg-opacity-10" };
    string visadoIconCss   = visadoAlta switch { "P" => "bi-hourglass-split text-warning", "A" => "bi-patch-check-fill text-success", "R" => "bi-arrow-counterclockwise text-danger", _ => "bi-patch-exclamation text-secondary" };
    string visadoTitleCss  = visadoAlta switch { "P" => "text-warning", "A" => "text-success", "R" => "text-danger", _ => "text-secondary" };
    <div class="sire-card mb-4">
    <div class="sire-card-header @visadoHeaderCss @visadoBorderCss">
        <i class="bi @visadoIconCss"></i>
        <span class="@visadoTitleCss fw-semibold">Visado de Alta</span>
        <span class="ms-2 badge bg-@visadoCss" style="font-size:.72rem; padding:3px 10px;">
            @visadoText@(visadoFecha.HasValue ? $" · {visadoFecha.Value:dd/MM/yyyy}" : "")
        </span>
        @if (!string.IsNullOrWhiteSpace(Model.VisadoAltaPor))
        {
            <span class="ms-2 text-muted" style="font-size:.8rem;">
                por @(string.IsNullOrWhiteSpace(nomJefatura) ? Model.VisadoAltaPor : nomJefatura)
            </span>
        }
    </div>
    <div class="sire-card-body">
        @if (visadoAlta == "R" && !string.IsNullOrWhiteSpace(visadoObs))
        {
            <div class="alert alert-danger py-2 px-3 mb-3" style="font-size:.85rem;">
                <i class="bi bi-exclamation-circle me-1"></i><strong>Observación del jefe:</strong> @visadoObs
            </div>
        }
        @if (visadoAlta == "A")
        {
            <p class="text-success mb-0" style="font-size:.88rem;">
                <i class="bi bi-check-circle-fill me-1"></i>El alta fue aprobada por jefatura. La firma digital aparecerá en la ficha de impresión.
            </p>
        }
        else if (visadoAlta == "P")
        {
            <p class="text-warning-emphasis mb-0" style="font-size:.88rem;">
                <i class="bi bi-send-check me-1"></i>Solicitud enviada. En espera de aprobación del responsable del área.
            </p>
        }
        else
        {
            <p class="text-muted mb-@(puedeEnviarVisado ? "3" : "0")" style="font-size:.88rem;">
                <i class="bi bi-info-circle me-1"></i>El alta aún no ha sido enviada a visado. Una vez guardado el alta, envíe la solicitud al jefe del área.
            </p>
        }
        @if (puedeEnviarVisado)
        {
            <button type="button" id="btnEnviarVisado"
                    class="btn btn-sm @(visadoAlta == "R" ? "btn-warning" : "btn-primary")"
                    title="Enviar email al responsable del área para que apruebe el alta">
                <i class="bi bi-send me-1"></i>@(visadoAlta == "R" ? "Reenviar Visado" : "Enviar Visado")
            </button>
        }
    </div>
</div>
} @* fin @if archivosAlta.Any() && ObsAlta *@

@* Forms de EliminarArchivo fuera de los forms padre (HTML no permite formularios anidados) *@
@* Los de ALTA solo se renderizan si el visado NO está aprobado *@
@{ var _delAI = 0; var _delBI = 0; }
@if (!altaBloqueada)
{
    @foreach (var _da in archivosAlta)
    {
    <form id="frmDelAlta@(_delAI++)" method="post" asp-action="EliminarArchivo" style="display:none;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="carpetaKey"    value="@Model.CarpetaKey" />
        <input type="hidden" name="tipo"          value="alta" />
        <input type="hidden" name="nombreArchivo" value="@_da.NombreArchivo" />
        <input type="hidden" name="clase"         value="@Model.Clase" />
        <input type="hidden" name="codigo"        value="@Model.Codigo" />
        <input type="hidden" name="numero"        value="@Model.Numero" />
        <input type="hidden" name="t"             value="@navToken" />
    </form>
    }
}
@foreach (var _db in archivosBaja)
{
    <form id="frmDelBaja@(_delBI++)" method="post" asp-action="EliminarArchivo" style="display:none;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="carpetaKey"    value="@Model.CarpetaKey" />
        <input type="hidden" name="tipo"          value="baja" />
        <input type="hidden" name="nombreArchivo" value="@_db.NombreArchivo" />
        <input type="hidden" name="clase"         value="@Model.Clase" />
        <input type="hidden" name="codigo"        value="@Model.Codigo" />
        <input type="hidden" name="numero"        value="@Model.Numero" />
        <input type="hidden" name="t"             value="@navToken" />
    </form>
}

<!-- Auditoria -->
<div class="sire-alert sire-alert-info mb-4" style="font-size:.78rem;">
    <i class="bi bi-clock-history"></i>
    <div>
        Creado por <strong>@(Model.AAduser ?? "—")</strong>
        @(Model.AAdfecha.HasValue ? $"el {Model.AAdfecha.Value:dd/MM/yyyy}" : "")
        @if (!string.IsNullOrWhiteSpace(Model.AMduser))
        {
            <text> &#183; Modificado por <strong>@Model.AMduser</strong>
            @(Model.AMdfecha.HasValue ? $"el {Model.AMdfecha.Value:dd/MM/yyyy HH:mm}" : "")</text>
        }
    </div>
</div>

@section Scripts {
<style>
    .btn-xs { padding: .15rem .4rem; font-size: .7rem; }
    .form-label-sm { font-size: .78rem; font-weight: 500; margin-bottom: .2rem; }
    .sire-card-header { display: flex; align-items: center; gap: .4rem; flex-wrap: wrap; }
</style>
<style>
@@media (max-width: 575.98px) {
    .sire-page-header  { flex-wrap: wrap !important; }
    .sire-page-actions { flex-wrap: wrap !important; width: 100%; justify-content: flex-start; }
    .sire-page-icon    { display: none; }
    .list-group-item   { font-size: .78rem; }
}
</style>

<div class="modal fade" id="modalConfirmar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title"><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Confirmar</h6>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalConfirmarMsg"></div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-sm btn-danger" id="btnConfirmarOk">Eliminar</button>
            </div>
        </div>
    </div>
</div>

<script>
    function initCounter(id, cid) {
        var ta = document.getElementById(id), sp = document.getElementById(cid);
        if (!ta || !sp) return;
        sp.textContent = ta.value.length;
        ta.addEventListener('input', function () {
            sp.textContent = ta.value.length;
            sp.style.color = ta.value.length >= ta.maxLength ? '#dc3545' : '';
        });
    }
    initCounter('obsAlta', 'obsAltaCount');
    initCounter('obsBaja', 'obsBajaCount');

    var _extPermitidas = ['.jpg', '.jpeg', '.png', '.pdf'];

    function validarArchivosSeleccionados(input) {
        var invalidos = [];
        for (var i = 0; i < input.files.length; i++) {
            var nombre = input.files[i].name.toLowerCase();
            var ext = nombre.substring(nombre.lastIndexOf('.'));
            if (!_extPermitidas.includes(ext)) invalidos.push(input.files[i].name);
        }
        if (invalidos.length > 0) {
            AppAlert('Formato no permitido: <strong>' + invalidos.join(', ') + '</strong>.<br>Solo se aceptan <strong>JPG, PNG o PDF</strong>.', 'Archivo no válido');
            input.value = '';
            return false;
        }
        return true;
    }

    function actualizarBoton(inputId, btnId) {
        var inp = document.getElementById(inputId), btn = document.getElementById(btnId);
        if (!inp || !btn) return;
        inp.addEventListener('change', function () {
            if (!validarArchivosSeleccionados(this)) {
                btn.innerHTML = '<i class="bi bi-floppy me-1"></i>Guardar';
                return;
            }
            btn.innerHTML = this.files.length > 0
                ? '<i class="bi bi-upload me-1"></i>Guardar y Subir (' + this.files.length + ')'
                : '<i class="bi bi-floppy me-1"></i>Guardar';
        });
    }
    actualizarBoton('inputArchivoAlta', 'btnGuardarAlta');
    actualizarBoton('inputArchivoBaja', 'btnGuardarBaja');

    (function () {
        var formIdPendiente = null;
        document.addEventListener('click', function (e) {
            var btn = e.target.closest('[data-modal-confirm]');
            if (!btn) return;
            e.preventDefault();
            formIdPendiente = btn.dataset.formId;
            document.getElementById('modalConfirmarMsg').textContent =
                btn.dataset.confirmMsg || '&#191;Desea continuar?';
            var modal = new bootstrap.Modal(document.getElementById('modalConfirmar'));
            modal.show();
            document.getElementById('btnConfirmarOk').onclick = function () {
                modal.hide();
                if (formIdPendiente) document.getElementById(formIdPendiente).submit();
            };
        });
    })();

    var _modalVer = null;
    function verArchivo(url, nombre) {
        var esPdf = nombre.toLowerCase().endsWith('.pdf');
        var body  = document.getElementById('modalVerBody');
        var title = document.getElementById('modalVerLabel');
        title.textContent = nombre;
        body.innerHTML = esPdf
            ? '<iframe src="' + url + '" style="width:100%;height:70vh;border:0;"></iframe>'
            : '<img src="' + url + '" alt="' + nombre + '" style="max-width:100%;max-height:75vh;display:block;margin:0 auto;" />';
        if (!_modalVer) {
            _modalVer = new bootstrap.Modal(document.getElementById('modalVer'),
                        { backdrop: true, keyboard: true });
            document.getElementById('modalVer').addEventListener('hidden.bs.modal', function () {
                body.innerHTML = '';
            });
        }
        _modalVer.show();
    }

    // Validación del formAlta: FOpera obligatorio + ObsAlta obligatorio + al menos 1 archivo (nuevo o ya guardado)
    var formAlta = document.getElementById('formAlta');
    if (formAlta) {
        formAlta.addEventListener('submit', function (e) {
            var fOpera     = (document.getElementById('fOpera')?.value ?? '').trim();
            var obs        = (document.getElementById('obsAlta')?.value ?? '').trim();
            var inputFile  = document.getElementById('inputArchivoAlta');
            var hayNuevo   = inputFile && inputFile.files && inputFile.files.length > 0;
            var hayGuardado = @(archivosAlta.Any() ? "true" : "false");

            var errores = [];
            if (!fOpera) {
                errores.push('Debe ingresar la <strong>Fecha de Inicio de Operaciones</strong>.');
            }
            if (!obs) {
                errores.push('Debe ingresar las <strong>Observaciones de Alta</strong>.');
            }
            if (!hayNuevo && !hayGuardado) {
                errores.push('Debe adjuntar al menos un <strong>archivo</strong> (JPG, PNG o PDF).');
            }

            if (errores.length > 0) {
                e.preventDefault();
                e.stopImmediatePropagation();
                AppAlert(errores.map(function (m) { return '&bull; ' + m; }).join('<br>'), 'Campos requeridos');
            }
        });
    }

    // Validación del formBaja: ObsBaja obligatorio + al menos 1 archivo (nuevo o ya guardado)
    var formBaja = document.getElementById('formBaja');
    if (formBaja) {
        formBaja.addEventListener('submit', function (e) {
            var obs         = (document.getElementById('obsBaja')?.value ?? '').trim();
            var inputFile   = document.getElementById('inputArchivoBaja');
            var hayNuevo    = inputFile && inputFile.files && inputFile.files.length > 0;
            var hayGuardado = @(archivosBaja.Any() ? "true" : "false");

            var errores = [];
            if (!obs) {
                errores.push('Debe ingresar las <strong>Observaciones de Baja</strong>.');
            }
            if (!hayNuevo && !hayGuardado) {
                errores.push('Debe adjuntar al menos un <strong>archivo</strong> (JPG, PNG o PDF).');
            }

            if (errores.length > 0) {
                e.preventDefault();
                e.stopImmediatePropagation();
                AppAlert(errores.map(function (m) { return '&bull; ' + m; }).join('<br>'), 'Campos requeridos');
            }
        });
    }

    // Enviar Visado: usa modal Bootstrap (AppConfirm) en lugar de confirm() nativo.
    // Usamos requestSubmit() en vez de submit() para que el evento 'submit' del DOM
    // se dispare correctamente y el interceptor de site.js active el overlay de carga.
    var btnEnviarVisado = document.getElementById('btnEnviarVisado');
    if (btnEnviarVisado) {
        btnEnviarVisado.addEventListener('click', function () {
            AppConfirm('¿Enviar solicitud de visado al responsable del área?', 'Confirmar Visado', 'Enviar', 'Cancelar')
                .then(function (confirmado) {
                    if (confirmado) {
                        var frm = document.getElementById('frmEnviarVisado');
                        // requestSubmit() dispara el evento submit (activa el overlay global)
                        // submit() nativo lo omite y el overlay nunca aparece
                        if (frm.requestSubmit) {
                            frm.requestSubmit();
                        } else {
                            frm.submit(); // fallback IE/Safari antiguos
                        }
                    }
                });
        });
    }
</script>

<div class="modal fade" id="modalVer" tabindex="-1" aria-labelledby="modalVerLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title text-truncate" id="modalVerLabel" style="max-width:80%;"></h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-2 text-center bg-dark" id="modalVerBody"></div>
        </div>
    </div>
</div>

}
