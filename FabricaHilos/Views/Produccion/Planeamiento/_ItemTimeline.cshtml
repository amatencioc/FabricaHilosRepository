@model FabricaHilos.Models.Produccion.Planeamiento.PlnPedidoViewModel
@using FabricaHilos.Models.Produccion.Planeamiento

@{
    var item  = Model.Items.First();
    var pasos = Model.Pasos.OrderBy(p => p.OrdenPaso).ToList();

    // Mapa paso -> fecha real
    var fechaReal = new Dictionary<string, DateTime?> {
        ["01"]  = item.FchPedido,
        ["02"]  = item.FchRealProgramado,
        ["03"]  = item.FchRealProduccion,
        ["04"]  = item.FchRealPartida,
        ["06"]  = item.FchRealTinIni,
        ["07"]  = item.FchRealTinFin,
        ["08"]  = item.FchRealSecado,
        ["09"]  = item.FchRealCcTinto,
        ["09B"] = item.FchRealGaseado,
        ["10"]  = item.FchRealDevanado,
        ["11"]  = item.FchRealCalidad,
        ["12"]  = item.FchRealAlmPt,
        ["13"]  = item.FchRealAlmPt,
        ["14"]  = item.FchRealDespacho,
    };

    // Mapa paso -> fecha estimada
    var fechaEst = new Dictionary<string, DateTime?> {
        ["02"]  = item.FchEstHilanderia,
        ["04"]  = item.FchEstPartida,
        ["06"]  = item.FchEstTinIni,
        ["07"]  = item.FchEstTinFin,
        ["08"]  = item.FchEstSecado,
        ["11"]  = item.FchEstCalidad,
        ["14"]  = item.FchEstDespacho,
    };

    int ordenActual = pasos.FirstOrDefault(p => p.CodPaso == item.CodPasoAct)?.OrdenPaso ?? 0;
    var fchCompromiso = item.FchEntregaComp ?? item.FchEntregaOri;
    var diasRest = fchCompromiso.HasValue ? (fchCompromiso.Value - DateTime.Today).Days : (int?)null;
}

@* ── Cabecera del ítem (estilo pln-info-strip) ── *@
<div class="pln-info-strip mb-0" style="border-radius:0;border-left:none;border-right:none;">
    <div class="d-flex align-items-stretch flex-wrap">
        <div class="pln-strip-cell" style="min-width:160px;">
            <div class="pln-strip-lbl">Ítem</div>
            <div class="pln-strip-val d-flex align-items-center gap-2">
                <span class="badge bg-dark" style="font-size:.72rem;border-radius:2px;font-weight:800;">
                    #@item.Nro
                </span>
                <span style="color:var(--pln-accent-blue);font-weight:700;font-size:.88rem;">@item.CodArt</span>
                @if (!string.IsNullOrEmpty(item.Titulo))
                {
                    <span style="font-size:.72rem;color:var(--pln-light-muted);">@item.Titulo</span>
                }
            </div>
            @if (!string.IsNullOrEmpty(item.Color))
            {
                <div class="pln-strip-sub">@item.Color</div>
            }
        </div>
        <div class="pln-strip-cell">
            <div class="pln-strip-lbl">Etapa actual</div>
            <div class="mt-1">
                <span class="paso-badge text-white" style="background-color:@item.ColorUi;">
                    @item.CodPasoAct — @item.NombrePaso
                </span>
            </div>
        </div>
        @if (fchCompromiso.HasValue)
        {
            <div class="pln-strip-cell">
                <div class="pln-strip-lbl">Entrega compromiso</div>
                <div class="pln-strip-val @(item.EstaRetrasado ? "text-warning" : "")">
                    @fchCompromiso.Value.ToString("dd/MM/yyyy")
                    @if (item.EstaRetrasado)
                    {
                        <span class="badge bg-danger ms-1" style="font-size:.6rem;">+@item.DiasRetraso d</span>
                    }
                </div>
                @if (diasRest.HasValue)
                {
                    var colorDias = diasRest.Value < 0 ? "#fc8181" : diasRest.Value <= 5 ? "#f6ad55" : "var(--pln-light-muted)";
                    <div class="pln-strip-sub" style="color:@colorDias;">
                        @(diasRest.Value < 0 ? $"{Math.Abs(diasRest.Value)}d vencido" : $"{diasRest.Value}d restantes")
                    </div>
                }
            </div>
        }
        <div class="pln-strip-cell">
            <div class="pln-strip-lbl">Kg pendientes</div>
            <div class="pln-strip-val" style="color:var(--pln-accent-blue);">@item.KgPendientes.ToString("N0")</div>
        </div>
    </div>
    @* ── Actores ── *@
    @{
        bool tieneActores = !string.IsNullOrEmpty(item.NombreRegistro) ||
                            !string.IsNullOrEmpty(item.NombreAprobacion) ||
                            !string.IsNullOrEmpty(item.NombrePlanif);
    }
    @if (tieneActores)
    {
        <div class="d-flex gap-3 flex-wrap px-2 py-1 border-top" style="font-size:.7rem;color:var(--pln-light-muted);background:rgba(255,255,255,.06);">
            @if (!string.IsNullOrEmpty(item.NombreRegistro))
            {
                <span><i class="bi bi-person me-1"></i><strong>Registró:</strong> @item.NombreRegistro</span>
            }
            @if (!string.IsNullOrEmpty(item.NombreAprobacion))
            {
                <span>
                    <i class="bi bi-patch-check me-1"></i><strong>Aprobó:</strong> @item.NombreAprobacion
                    @if (item.FchAprobacion.HasValue)
                    {
                        <span class="opacity-75 ms-1">(@item.FchAprobacion.Value.ToString("dd/MM/yy"))</span>
                    }
                </span>
            }
            @if (!string.IsNullOrEmpty(item.NombrePlanif))
            {
                <span>
                    <i class="bi bi-calendar2-check me-1"></i><strong>Planificó:</strong> @item.NombrePlanif
                    @if (item.FchPlanif.HasValue)
                    {
                        <span class="opacity-75 ms-1">(@item.FchPlanif.Value.ToString("dd/MM/yy"))</span>
                    }
                </span>
            }
        </div>
    }
</div>

@* ── Línea de tiempo (lista vertical con clases tl-step) ── *@
<div class="px-0 py-0" style="background:#fff;">
    @{ bool _nowDivShown = false; }
    @foreach (var paso in pasos.Where(p => p.CodPaso != "9R"))
    {
        int ordenPaso  = paso.OrdenPaso;
        bool esPasado  = ordenPaso < ordenActual;
        bool esActual  = paso.CodPaso == item.CodPasoAct;

        fechaReal.TryGetValue(paso.CodPaso, out var fReal);
        fechaEst.TryGetValue(paso.CodPaso, out var fEst);

        if (!_nowDivShown && esActual && ordenActual > 0)
        {
            _nowDivShown = true;
            <div class="tl-now-divider mx-3 my-1"><span>Ahora</span></div>
        }

        string stepCls   = esActual ? "activo" : esPasado ? "completado" : "pendiente";
        string dotBg     = esActual ? paso.ColorUi : esPasado ? "var(--pln-success-dk)" : "var(--pln-gray-300)";
        string nombreCls = esActual ? "tl-nombre activo" : esPasado ? "tl-nombre completado" : "tl-nombre pendiente";

        <div class="tl-step @stepCls">
            <div class="tl-dot" style="background:@dotBg;@(esActual ? $"box-shadow:0 0 0 3px {paso.ColorUi}33;" : "")"></div>
            <div class="tl-cod">
                @if (esPasado)
                {
                    <i class="bi bi-check-circle-fill text-success" style="font-size:.78rem;"></i>
                }
                else if (esActual)
                {
                    <i class="bi bi-play-circle-fill" style="font-size:.78rem;color:@paso.ColorUi;"></i>
                }
                else
                {
                    <span class="tl-step-cod-tag">@paso.CodPaso</span>
                }
            </div>
            <div class="flex-grow-1">
                <div class="d-flex align-items-center gap-1 flex-wrap">
                    <span class="@nombreCls">@paso.NombrePaso</span>
                </div>
                @if (paso.CodPaso == "01" && (!string.IsNullOrEmpty(item.NombreRegistro) || !string.IsNullOrEmpty(item.NombreAprobacion)))
                {
                    <div class="tl-actor">
                        @if (!string.IsNullOrEmpty(item.NombreRegistro))
                        {
                            <span class="tl-actor-pill"><i class="bi bi-person-check"></i><strong>Registró</strong> @item.NombreRegistro</span>
                        }
                        @if (!string.IsNullOrEmpty(item.NombreAprobacion))
                        {
                            <span class="tl-actor-pill">
                                <i class="bi bi-patch-check"></i><strong>Aprobó</strong> @item.NombreAprobacion
                                @if (item.FchAprobacion.HasValue) { <span class="ap-fch">@item.FchAprobacion.Value.ToString("dd/MM/yy")</span> }
                            </span>
                        }
                    </div>
                }
                @if (paso.CodPaso == "02" && !string.IsNullOrEmpty(item.NombrePlanif))
                {
                    <div class="tl-actor">
                        <span class="tl-actor-pill">
                            <i class="bi bi-calendar2-check"></i><strong>Planificó</strong> @item.NombrePlanif
                            @if (item.FchPlanif.HasValue) { <span class="ap-fch">@item.FchPlanif.Value.ToString("dd/MM/yy")</span> }
                        </span>
                    </div>
                }
            </div>
            <div class="tl-fechas">
                @if (fReal.HasValue)
                {
                    <span class="tl-fech-real"><i class="bi bi-check2 me-1"></i>@fReal.Value.ToString("dd/MM/yy")</span>
                }
                else if (fEst.HasValue && !esPasado)
                {
                    <span style="color:var(--pln-gray-500);">est. @fEst.Value.ToString("dd/MM/yy")</span>
                }
            </div>
        </div>
    }
</div>
