                                    </td>
                                    <td class="text-center"><span class="badge @r.ConcilBadge" style="font-size:.62rem;" title="@(r.FchConcil.HasValue ? $"{r.ConcilLabel} — {r.FchConcil:dd/MM HH:mm}" : r.ConcilDiffs ?? r.ConcilLabel)">@r.ConcilLabel</span></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="6" class="text-end fw-semibold" style="font-size:.75rem;color:var(--sire-gray-600);">TOTALES</td>
                                <td class="text-end fw-bold">@propuesta.Sum(x => x.BiGravDg).ToString("N2")</td>
                                <td class="text-end fw-bold text-muted d-none d-xxl-table-cell">@propuesta.Sum(x => x.BiGravDgng).ToString("N2")</td>
                                <td class="text-end fw-bold text-muted d-none d-xxl-table-cell">@propuesta.Sum(x => x.BiGravDng).ToString("N2")</td>
                                <td class="text-end fw-bold text-muted d-none d-xl-table-cell">@propuesta.Sum(x => x.ValAdqNg).ToString("N2")</td>
                                <td class="text-end fw-bold">@propuesta.Sum(x => x.IgvIpmDg).ToString("N2")</td>
                                <td class="text-end fw-bold text-muted d-none d-xl-table-cell">@propuesta.Sum(x => x.Isc).ToString("N2")</td>
                                <td class="text-end fw-bold" style="color:var(--sire-rce);">@propuesta.Sum(x => x.TotalCp).ToString("N2")</td>
