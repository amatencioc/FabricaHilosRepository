                                                    }
                                                    else { <text>—</text> }
                                                  </td>
                                                  <td class="tt-mono">@bn.FechaIni.ToString("dd/MM/yy HH:mm")</td>
                                                  <td class="tt-mono">@(bn.FechaFin?.ToString("dd/MM/yy HH:mm") ?? "—")</td>
