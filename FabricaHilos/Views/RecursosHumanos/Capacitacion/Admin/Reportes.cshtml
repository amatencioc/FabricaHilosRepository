@model List<FabricaHilos.Models.Capacitacion.CapInscripcion>
@{
    ViewData["Title"] = "Reportes de Capacitación";
    var cursos = ViewBag.Cursos as List<FabricaHilos.Models.Capacitacion.CapCurso> ?? new List<FabricaHilos.Models.Capacitacion.CapCurso>();
    int? idCursoActivo = ViewBag.IdCursoActivo;
    var cursoActivo = cursos.FirstOrDefault(c => c.IdCurso == idCursoActivo);
    var categorias  = ViewBag.Categorias   as List<FabricaHilos.Models.Capacitacion.CapCategoria>       ?? new();
    var areas       = ViewBag.Areas        as List<FabricaHilos.Models.Capacitacion.CapAreaOption>      ?? new();
    // Jerarquía Área → Centro de Costo (ver 12_CAP_JERARQUIA_CCOSTO.sql)
    var centrosCosto = ViewBag.CentrosCosto as List<FabricaHilos.Models.Capacitacion.CapCcostoOption>    ?? new();
    var supervisores = ViewBag.Supervisores as List<FabricaHilos.Models.Capacitacion.CapSupervisorOption> ?? new();
    int?   idCategoriaActiva = ViewBag.FiltroCategoria;
    string? areaActiva       = ViewBag.FiltroArea;
    string? supervisorActivo = ViewBag.FiltroSupervisor;
    string? ccostoActivo     = ViewBag.FiltroCentroCosto;

    // Headcount por jefaturas, unificado en la pestaña "Jefaturas"
    var headcount = ViewBag.HeadcountJefaturas as List<FabricaHilos.Models.Capacitacion.CapHeadcountDetalle> ?? new();
    var sinJefatura = headcount.Where(d => string.IsNullOrEmpty(d.NombreJefatura)).ToList();
    var areasSinJefe = sinJefatura.Select(d => d.DescArea).Distinct().OrderBy(a => a).ToList();
    var porCcosto = headcount
        .GroupBy(d => string.IsNullOrEmpty(d.DescCcosto) ? "Sin centro de costo" : d.DescCcosto)
        .OrderBy(g => g.Key)
        .ToList();
}

@section Styles {
<style>
/* ── LMS · Reportes ─────────────────────────────── */
body { background:#f0f4f8; }
.lms-stat { background:#fff; border:1px solid #dde3ec; border-radius:10px; padding:.85rem 1rem; display:flex; align-items:center; gap:.85rem; }
.lms-stat-icon { width:38px; height:38px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:1.1rem; flex-shrink:0; }
.lms-stat-val { font-size:1.5rem; font-weight:700; color:#0f172a; line-height:1; font-variant-numeric:tabular-nums; }
.lms-stat-lbl { font-size:.68rem; color:#64748b; margin-top:3px; text-transform:uppercase; letter-spacing:.06em; }
.lms-card { background:#fff; border:1px solid #dde3ec; border-radius:10px; box-shadow:0 1px 4px rgba(15,23,42,.04); }
