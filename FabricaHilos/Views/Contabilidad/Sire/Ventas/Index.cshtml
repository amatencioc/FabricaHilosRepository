                    <i class="bi bi-eye me-1"></i>Ir al proceso activo
                </button>
                <button class="btn btn-sm btn-danger" onclick="cancelarJob('${result.jobId}', '${result.periodoActivo}', '${tipo}')">
                    <i class="bi bi-x-circle me-1"></i>Cancelar y reiniciar
                </button>
                <button class="btn btn-sm btn-outline-secondary" onclick="cancelarJobSolo('${result.jobId}')">
