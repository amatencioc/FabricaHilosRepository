    function mostrarAvisoHuerfano(minutos, jobId, periodo, tipo) {
        const estadoDiv = document.getElementById('estadoExportacion');
        estadoDiv.innerHTML = `<div class="text-center">
            <div class="mb-2"><i class="bi bi-exclamation-triangle-fill fs-1 text-warning"></i></div>
            <p class="fw-semibold text-warning">Job en cola sin procesar</p>
            <p class="small text-muted mb-3">El proceso lleva <strong>${minutos} min</strong> en cola sin iniciar.
            Esto ocurre cuando el servidor se reinició después de crear el job.<br>
            El sistema lo recuperará automáticamente en los próximos 2 minutos.</p>
            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <button class="btn btn-sm btn-warning" onclick="forzarReencolar('${jobId}','${periodo}','${tipo}')">
                    <i class="bi bi-arrow-clockwise me-1"></i>Reencolar ahora
                </button>
                <button class="btn btn-sm btn-outline-secondary" onclick="cancelarJobSolo('${jobId}')">
                    <i class="bi bi-x me-1"></i>Cancelar
                </button>
            </div>
        </div>`;
    }

    async function forzarReencolar(jobId, periodo, tipo) {
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : '';
        try {
            const resp = await fetch('@Url.Action("ReencolarJobHuerfano", "Sire")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(jobId)
            });
            const data = await resp.json();
            if (data.exitoso) {
                _pollingJobId = jobId;
                actualizarModalExportacion('Pendiente', 'Job reencolado. El servidor lo procesará en breve…', jobId, 0);
                consultarEstadoJob(jobId, periodo, tipo);
            } else {
                mostrarErrorExportacion(data.error || 'No se pudo reencolar.');
            }
        } catch (e) { mostrarErrorExportacion('Error al reencolar: ' + e.message); }
    }

    function mostrarExitoExportacion(mensaje, rutaArchivo, nombreArchivo) {
        const estadoDiv = document.getElementById('estadoExportacion');
        const infoArchivo = rutaArchivo ? `<small class="text-muted d-block mt-1"><i class="bi bi-folder2"></i> ${rutaArchivo}</small>` : '';
        estadoDiv.innerHTML = `<div class="text-center">
            <div class="mb-3"><i class="bi bi-check-circle fs-1" style="color:#27ae60;"></i></div>
            <p class="fw-semibold text-success">${mensaje}</p>${infoArchivo}</div>`;
        // Mostrar botón ZIP solo si el archivo NO fue guardado en servidor
        document.getElementById('btnDescargarZip').style.display = rutaArchivo ? 'none' : '';

        // Al cerrar el modal (botón Cerrar, X o clic fuera) recargar la página para reflejar los nuevos datos
        const modalEl = document.getElementById('modalExportacion');
        modalEl.addEventListener('hidden.bs.modal', () => location.reload(), { once: true });
    }

    function mostrarErrorExportacion(error) {
        const estadoDiv = document.getElementById('estadoExportacion');
