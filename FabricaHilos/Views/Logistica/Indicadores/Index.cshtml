@{
    ViewData["Title"] = "Indicadores de Logística";
    string fechaDesde = ViewBag.FechaDesde;
    string fechaHasta = ViewBag.FechaHasta;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Logistica" asp-action="Index">Logística</a></li>
    <li class="breadcrumb-item active">Indicadores</li>
}

@section Styles {
<style>
    .filter-bar {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,.08);
        padding: .9rem 1.4rem;
        margin-bottom: 1.2rem;
    }
    .kpi-card {
        border: none; border-radius: 14px; text-align: center;
        padding: 1.4rem 1rem 1.1rem; position: relative; overflow: hidden;
        transition: transform .18s, box-shadow .18s;
    }
    .kpi-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,.13) !important; }
    .kpi-card::before { content:''; position:absolute; top:0; left:0; right:0; height:4px; border-radius:14px 14px 0 0; }
    .kpi-card.accent-green  { box-shadow:0 3px 14px rgba(27,77,62,.14); }
    .kpi-card.accent-green::before  { background:linear-gradient(90deg,#1B4D3E,#2e8b6a); }
    .kpi-card.accent-blue   { box-shadow:0 3px 14px rgba(21,101,192,.14); }
    .kpi-card.accent-blue::before   { background:linear-gradient(90deg,#1565C0,#42a5f5); }
    .kpi-card.accent-orange { box-shadow:0 3px 14px rgba(230,81,0,.14); }
    .kpi-card.accent-orange::before { background:linear-gradient(90deg,#e65100,#ffa726); }
    .kpi-card.accent-purple { box-shadow:0 3px 14px rgba(74,20,140,.14); }
    .kpi-card.accent-purple::before { background:linear-gradient(90deg,#4A148C,#9c4dcc); }
    .kpi-card .kpi-icon  { font-size:2.1rem; line-height:1; margin-bottom:.4rem; }
    .kpi-card .kpi-label { font-size:.68rem; color:#6b7280; font-weight:700; text-transform:uppercase; letter-spacing:.06em; margin-bottom:.2rem; }
    .kpi-card .kpi-value { font-size:2rem; font-weight:800; color:#111827; line-height:1.1; }
    .kpi-card .kpi-sub   { font-size:.7rem; color:#9ca3af; margin-top:.2rem; }
    .section-title { font-size:1rem; font-weight:700; color:#1B4D3E; text-transform:uppercase;
                     letter-spacing:.04em; margin:1.4rem 0 .5rem; border-left:4px solid #1B4D3E; padding-left:.5rem; }
    .chart-card { border:none; border-radius:12px; box-shadow:0 2px 10px rgba(0,0,0,.08); height:100%; }
    .chart-card .card-header { background:transparent; color:#1B4D3E; font-weight:600;
                                border-bottom:1px solid #e0e0e0; border-radius:12px 12px 0 0!important; }
    .chart-card .card-body { background:#fafaf8; border-radius:0 0 12px 12px; }
    .tab-content-panel { min-height: 260px; }
    /* Semáforo pendientes */
    .sem-verde   { background:#d4edda !important; }
    .sem-amarillo{ background:#fff3cd !important; }
    .sem-rojo    { background:#f8d7da !important; }

    /* ── Resumen Ejecutivo ── */
    .resumen-ejecutivo {
        background: linear-gradient(135deg,#1B4D3E 0%,#2e6b55 60%,#1565C0 100%);
        border-radius: 14px;
        padding: .7rem 1rem .8rem;
        color: #fff;
        box-shadow: 0 4px 18px rgba(27,77,62,.22);
    }
    .resumen-header {
        font-size: .8rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: .07em; color: #a7f3d0; margin-bottom: .55rem;
    }
    .resumen-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: .5rem;
    }
    @@media (max-width: 991px) { .resumen-grid { grid-template-columns: repeat(3,1fr); } }
    @@media (max-width: 575px) { .resumen-grid { grid-template-columns: 1fr 1fr; } }
    .resumen-item {
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 10px;
        padding: .55rem .65rem .5rem;
        cursor: pointer;
        transition: background .18s, transform .15s;
    }
    .resumen-item:hover {
        background: rgba(255,255,255,.20);
        transform: translateY(-2px);
    }
    .resumen-num {
        font-size: 1.7rem; font-weight: 800; line-height: 1.1;
        color: #fff; letter-spacing: -.01em;
    }
    .resumen-num-danger { color: #fca5a5; }
    .resumen-q  { font-size: .67rem; font-weight: 700; color: #a7f3d0; text-transform: uppercase; letter-spacing: .04em; margin-top: .15rem; }
    .resumen-kpi { font-size: .65rem; color: rgba(255,255,255,.7); margin-bottom: .2rem; }
    .resumen-badge { margin-bottom: .2rem; }
    .resumen-link { font-size: .63rem; color: rgba(255,255,255,.55); }
    .resumen-link:hover { color:#fff; }
</style>
}

<div class="d-flex align-items-center gap-2 mb-3">
    <i class="bi bi-bar-chart-line-fill fs-4" style="color:#8B5E3C;"></i>
    <h4 class="mb-0 fw-bold">Indicadores de Logística</h4>
</div>

<!-- ── Barra de filtros ────────────────────────────────────────────────── -->
<div class="filter-bar">
    <div class="row g-2 align-items-end">
        <div class="col-sm-4 col-md-3">
            <label class="form-label fw-semibold mb-1" style="font-size:.8rem;">Desde</label>
            <input type="date" id="fechaDesde" class="form-control form-control-sm" value="@fechaDesde" />
        </div>
        <div class="col-sm-4 col-md-3">
            <label class="form-label fw-semibold mb-1" style="font-size:.8rem;">Hasta</label>
            <input type="date" id="fechaHasta" class="form-control form-control-sm" value="@fechaHasta" />
        </div>
        <div class="col-sm-4 col-md-2">
            <label class="form-label fw-semibold mb-1" style="font-size:.8rem;">Tendencia (meses)</label>
            <select id="mesesAtras" class="form-select form-select-sm">
                <option value="6">6 meses</option>
                <option value="12" selected>12 meses</option>
                <option value="24">24 meses</option>
            </select>
        </div>
        <div class="col-sm-12 col-md-auto d-flex gap-2 flex-wrap">
            <button id="btnConsultar" class="btn btn-sm btn-primary">
                <i class="bi bi-search"></i> Consultar
            </button>
            <button id="btnExportar" class="btn btn-sm btn-success">
                <i class="bi bi-file-earmark-excel"></i> Exportar Excel
            </button>
        </div>
    </div>
</div>

<!-- ── Resumen Ejecutivo ────────────────────────────────────────────── -->
<div id="resumenEjecutivo" class="resumen-ejecutivo mb-3" style="display:none;">
    <div class="resumen-header">
        <i class="bi bi-clipboard2-pulse-fill me-2"></i>Resumen Ejecutivo
        <span class="resumen-periodo ms-2" id="resumenPeriodo" style="font-weight:400; font-size:.78rem; color:#9ca3af;"></span>
    </div>
    <div class="resumen-grid">

        <!-- 1. ¿El proceso cierra? -->
        <div class="resumen-item" onclick="activarTab('tab-dashboard','ancla-pct-atendido')" title="Ver % Atendido por tipo — porcentaje de requisiciones no anuladas que ya tienen Orden de Compra emitida (ciclo cerrado). Objetivo: ≥ 70%.">
            <div class="resumen-num" id="res-pct-atendido">—</div>
            <div class="resumen-q">¿El proceso cierra?</div>
            <div class="resumen-kpi">% Atendido (objetivo ≥ 70%)</div>
            <div style="font-size:.65rem;color:#6b7280;margin-top:2px;">Requisiciones con OC emitida / total activas</div>
            <div class="resumen-badge" id="res-pct-badge">
                <span class="badge bg-secondary">sin datos</span>
            </div>
            <div class="resumen-link"><i class="bi bi-arrow-right-circle me-1"></i>Ver Dashboard KPI</div>
        </div>

        <!-- 2. ¿Dónde está el cuello HOY? -->
        <div class="resumen-item" onclick="activarTab('tab-dashboard','ancla-bloqueados')" title="Ver Bloqueados por Etapa — ítems con saldo pendiente que llevan más de 7 días sin avanzar de etapa. Indica dónde está el atasco actual del proceso.">
            <div class="resumen-num resumen-num-danger" id="res-bloqueados">—</div>
            <div class="resumen-q">¿Dónde está el cuello HOY?</div>
            <div class="resumen-kpi">Ítems bloqueados &gt;7 días</div>
            <div style="font-size:.65rem;color:#6b7280;margin-top:2px;">Sin avanzar de etapa (Reg / Aut / Log)</div>
            <div class="resumen-badge" id="res-bloq-badge">
                <span class="badge bg-secondary">sin datos</span>
            </div>
            <div class="resumen-link"><i class="bi bi-arrow-right-circle me-1"></i>Ver Bloqueados por Etapa</div>
        </div>

        <!-- 3. ¿Qué tramo es más lento? -->
        <div class="resumen-item" onclick="activarTab('tab-dashboard','ancla-tiempos')" title="Ver Tiempos por Etapa — muestra cuántos días promedio tarda cada etapa del ciclo logístico. T1 = Registro→Autorización, T2 = Autorización→Logística, T3 = Logística→Orden de Compra. Meta: ≤ 15 días en total.">
            <div class="resumen-num" id="res-tramo-lento" style="font-size:1.1rem;">—</div>
            <div class="resumen-q">¿Qué tramo es más lento?</div>
            <div class="resumen-kpi">Ciclo total promedio (meta ≤ 15 días)</div>
            <div style="font-size:.65rem;color:#6b7280;margin-top:2px;">T1 Reg→Aut · T2 Aut→Log · T3 Log→OC</div>
            <div class="resumen-badge" id="res-tramo-badge">
                <span class="badge bg-secondary">sin datos</span>
            </div>
            <div class="resumen-link"><i class="bi bi-arrow-right-circle me-1"></i>Ver Tiempos / Waterfall</div>
        </div>

        <!-- 4. ¿El proceso mejora o empeora? -->
        <div class="resumen-item" onclick="activarTab('tab-tendencia','ancla-tendencia-chart')" title="Ver Tendencia Mensual — compara el ciclo promedio del último mes con el anterior. Si baja = el proceso mejora. Si sube = el proceso se está enlenteciendo.">
            <div class="resumen-num" id="res-tendencia" style="font-size:1.3rem;">—</div>
            <div class="resumen-q">¿El proceso mejora o empeora?</div>
            <div class="resumen-kpi">Tendencia ciclo (últimos 2 meses)</div>
            <div style="font-size:.65rem;color:#6b7280;margin-top:2px;">Comparación mes actual vs mes anterior</div>
            <div class="resumen-badge" id="res-tend-badge">
                <span class="badge bg-secondary">sin datos</span>
            </div>
            <div class="resumen-link"><i class="bi bi-arrow-right-circle me-1"></i>Ver Tendencia Mensual</div>
        </div>

        <!-- 5. ¿Qué ítem atender URGENTE? -->
        <div class="resumen-item" onclick="activarTab('tab-dashboard','ancla-pendientes')" title="Ver Tabla de Ítems Pendientes — lista detallada de ítems con saldo sin despachar que llevan más de 7 días en espera. Estos son los casos que requieren acción inmediata.">
            <div class="resumen-num resumen-num-danger" id="res-urgentes">—</div>
            <div class="resumen-q">¿Qué ítem atender URGENTE?</div>
            <div class="resumen-kpi">Ítems con saldo sin despachar &gt; 7 días</div>
            <div style="font-size:.65rem;color:#6b7280;margin-top:2px;">Con cantidad pendiente &gt; 0 y tiempo de espera crítico</div>
            <div class="resumen-badge" id="res-urg-badge">
                <span class="badge bg-secondary">sin datos</span>
            </div>
            <div class="resumen-link"><i class="bi bi-arrow-right-circle me-1"></i>Ver Tabla Pendientes</div>
        </div>

    </div>
</div>

<!-- ── Pestañas ───────────────────────────────────────────────────────── -->
<ul class="nav nav-tabs mb-0" id="indTabs" role="tablist">
    <li class="nav-item">
        <button class="nav-link active" id="tab-dashboard" data-bs-toggle="tab" data-bs-target="#pane-dashboard" type="button">
            <i class="bi bi-grid-1x2"></i> Dashboard KPI
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" id="tab-ciclo" data-bs-toggle="tab" data-bs-target="#pane-ciclo" type="button">
            <i class="bi bi-diagram-3"></i> Ciclo de Vida
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" id="tab-tendencia" data-bs-toggle="tab" data-bs-target="#pane-tendencia" type="button">
            <i class="bi bi-graph-up"></i> Tendencia Mensual
        </button>
    </li>
</ul>

<div class="tab-content border border-top-0 rounded-bottom bg-white p-3 shadow-sm">

    <div class="tab-pane fade show active tab-content-panel" id="pane-dashboard">
        <div id="kpi-container">
            <div class="text-center py-5 text-muted">
                <i class="bi bi-bar-chart-line fs-1 d-block mb-2" style="color:#8B5E3C;"></i>
                Presione <strong>Consultar</strong> para cargar el dashboard.
            </div>
        </div>
    </div>

    <div class="tab-pane fade tab-content-panel" id="pane-ciclo">
        <div id="ciclo-container">
            <div class="text-center py-5 text-muted">
                <i class="bi bi-diagram-3 fs-1 d-block mb-2" style="color:#1565C0;"></i>
                Presione <strong>Consultar</strong> para cargar el ciclo de vida.
            </div>
        </div>
    </div>

    <div class="tab-pane fade tab-content-panel" id="pane-tendencia">
        <div id="tendencia-container">
            <div class="text-center py-5 text-muted">
                <i class="bi bi-graph-up fs-1 d-block mb-2" style="color:#2e8b6a;"></i>
                Presione <strong>Consultar</strong> para cargar la tendencia mensual.
            </div>
        </div>
    </div>

</div>

@section Scripts {
<script>
    function getParams() {
        return {
            fechaDesde : document.getElementById('fechaDesde').value,
            fechaHasta : document.getElementById('fechaHasta').value,
            mesesAtras : document.getElementById('mesesAtras').value
        };
    }

    // ── Mapa: paneId → nombre de función init pendiente ──────────────────
    const _pendingInit = {};

    // ── Mapa: tabButtonId → anclaId pendiente de scroll ──────────────────
    // Reemplaza los listeners inline de shown.bs.tab en activarTab(), evitando
    // acumulación de handlers huérfanos cuando el tab ya estaba activo.
    const _pendingScroll = {};

    function loadPartial(url, containerId, initFn) {
        const el = document.getElementById(containerId);
        el.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-secondary"></div><p class="mt-2 text-muted">Cargando...</p></div>';
        fetch(url)
            .then(r => r.ok ? r.text() : r.text().then(t => Promise.reject(t)))
            .then(html => {
                // 1. Separar <script> del HTML
                const temp = document.createElement('div');
                temp.innerHTML = html;
                const scripts = [...temp.querySelectorAll('script')];
                scripts.forEach(s => s.parentNode.removeChild(s));

                // 2. Insertar el HTML (canvas ya en el DOM)
                el.innerHTML = temp.innerHTML;

                // 3. Re-ejecutar los scripts en orden
                scripts.forEach(oldScript => {
                    const newScript = document.createElement('script');
                    if (oldScript.src) {
                        newScript.src = oldScript.src;
                    } else {
                        newScript.textContent = oldScript.textContent;
                    }
                    document.body.appendChild(newScript);
                });

                // 4. Si el tab está oculto, diferir el init para cuando se active;
                //    si ya está visible, ejecutarlo con doble rAF para garantizar layout
                requestAnimationFrame(() => {
                    const pane = el.closest('.tab-pane');
                    if (pane && !pane.classList.contains('active')) {
                        _pendingInit[pane.id] = initFn;
                    } else {
                        requestAnimationFrame(() => {
                            if (typeof window[initFn] === 'function') window[initFn]();
                        });
                    }
                });
            })
            .catch(err => {
                el.innerHTML = `<div class="alert alert-danger m-2">Error al cargar los datos.<br><small>${err}</small></div>`;
            });
    }

    // ── Ejecutar init diferido + scroll pendiente cuando el tab se hace visible ─
    document.getElementById('indTabs').addEventListener('shown.bs.tab', function (e) {
        const targetId = (e.target.getAttribute('data-bs-target') || '').replace('#', '');
        if (!targetId) return;

        // init diferido
        const fn = _pendingInit[targetId];
        if (fn && typeof window[fn] === 'function') {
            delete _pendingInit[targetId];
            requestAnimationFrame(() => requestAnimationFrame(() => window[fn]()));
        }

        // scroll pendiente desde activarTab()
        const ancla = _pendingScroll[e.target.id];
        if (ancla) {
            delete _pendingScroll[e.target.id];
            scrollToAncla(ancla);
        }
    });

    document.getElementById('btnConsultar').addEventListener('click', function () {
        const p = getParams();
        if (!p.fechaDesde || !p.fechaHasta) { showIndAlert('Seleccione el rango de fechas antes de consultar.'); return; }

        loadPartial(
            `/Logistica/Indicadores/Dashboard?fechaDesde=${p.fechaDesde}&fechaHasta=${p.fechaHasta}`,
            'kpi-container', 'initIndLogisticaCharts'
        );
        loadPartial(
            `/Logistica/Indicadores/CicloVida?fechaDesde=${p.fechaDesde}&fechaHasta=${p.fechaHasta}`,
            'ciclo-container', 'initCicloVidaCharts'
        );
        loadPartial(
            `/Logistica/Indicadores/TendenciaMensual?mesesAtras=${p.mesesAtras}`,
            'tendencia-container', 'initTendenciaCharts'
        );
    });

    document.getElementById('btnExportar').addEventListener('click', function () {
        const p = getParams();
        if (!p.fechaDesde || !p.fechaHasta) { showIndAlert('Seleccione el rango de fechas antes de exportar.'); return; }
        window.location = `/Logistica/Indicadores/ExportarExcel?fechaDesde=${p.fechaDesde}&fechaHasta=${p.fechaHasta}`;
    });

    function showIndAlert(msg) {
        document.getElementById('indAlertMsg').textContent = msg;
        new bootstrap.Modal(document.getElementById('indAlertModal')).show();
    }

    // ── Navegación rápida desde Resumen Ejecutivo ─────────────────────
    // tabId   : id del botón de pestaña (ej: 'tab-dashboard')
    // anclaId : id del div ancla dentro del contenido (ej: 'ancla-bloqueados')
    function activarTab(tabId, anclaId) {
        const btn = document.getElementById(tabId);
        if (!btn) return;
        const tabInstance = bootstrap.Tab.getOrCreateInstance(btn);

        if (anclaId) {
            const paneId = btn.getAttribute('data-bs-target')?.replace('#','');
            const pane   = paneId ? document.getElementById(paneId) : null;
            if (pane && pane.classList.contains('active')) {
                // Tab ya visible: scroll inmediato
                scrollToAncla(anclaId);
            } else {
                // Registrar scroll en el mapa centralizado; el listener shown.bs.tab lo consume
                _pendingScroll[tabId] = anclaId;
                tabInstance.show();
            }
        } else {
            tabInstance.show();
        }
    }

    function scrollToAncla(anclaId) {
        // Doble rAF para garantizar que el layout del tab ya está pintado
        requestAnimationFrame(() => requestAnimationFrame(() => {
            const el = document.getElementById(anclaId);
            if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }));
    }

    // ── Actualiza el panel Resumen Ejecutivo con los datos cargados ───
    window.updateResumenEjecutivo = function () {
        const p = getParams();

        // ── Fuentes de datos (hidden inputs inyectados por los parciales) ──
        const pctCStr    = document.getElementById('res-data-pct-compra')?.value;
        const pctSStr    = document.getElementById('res-data-pct-servicio')?.value;
        const bloqStr    = document.getElementById('res-data-bloqueados')?.value;
        const t1Str      = document.getElementById('res-data-t1')?.value;
        const t2Str      = document.getElementById('res-data-t2')?.value;
        const t3Str      = document.getElementById('res-data-t3')?.value;
        const cicloStr   = document.getElementById('res-data-ciclo')?.value;
        const urgStr     = document.getElementById('res-data-urgentes')?.value;
        const tendStr    = document.getElementById('res-data-tendencia')?.value;  // JSON [{ciclo,mes}]

        if (!pctCStr && !pctSStr) return; // Dashboard aún no cargado

        const pctC    = parseFloat(pctCStr  || '0');
        const pctS    = parseFloat(pctSStr  || '0');
        const bloq    = parseInt(bloqStr    || '0');
        const t1      = parseFloat(t1Str    || '0');
        const t2      = parseFloat(t2Str    || '0');
        const t3      = parseFloat(t3Str    || '0');
        const ciclo   = parseFloat(cicloStr || '0');
        const urg     = parseInt(urgStr     || '0');

        // ── 1. % Atendido — -1 = tipo sin requisiciones en el período (centinela) ──
        const tiposConDatos = [];
        if (pctC >= 0) tiposConDatos.push({ tipo: 'COMPRA',   v: pctC });
        if (pctS >= 0) tiposConDatos.push({ tipo: 'SERVICIO', v: pctS });
        const badgePct = document.getElementById('res-pct-badge');
        if (!tiposConDatos.length) {
            document.getElementById('res-pct-atendido').textContent = '—';
            badgePct.innerHTML = '<span class="badge bg-secondary">sin datos</span>';
        } else {
            const pctEfect = tiposConDatos.reduce((s, t) => s + t.v, 0) / tiposConDatos.length;
                const pctMin   = Math.min(...tiposConDatos.map(t => t.v));
                // Mostrar el PEOR tipo (mínimo) para que el número sea coherente con el semáforo
                document.getElementById('res-pct-atendido').textContent = pctMin.toFixed(1) + '%';
            if (pctMin >= 70) {
                badgePct.innerHTML = '<span class="badge bg-success">✅ Bueno</span>';
            } else if (pctMin >= 50) {
                badgePct.innerHTML = '<span class="badge bg-warning text-dark">⚠️ Regular</span>';
            } else {
                badgePct.innerHTML = '<span class="badge bg-danger">🔴 Bajo</span>';
            }
        }

        // ── 2. Bloqueados >7d ──────────────────────────────────────────
        document.getElementById('res-bloqueados').textContent = bloq;
        const badgeBloq = document.getElementById('res-bloq-badge');
        if (bloq === 0) {
            badgeBloq.innerHTML = '<span class="badge bg-success">✅ Sin bloqueos</span>';
        } else if (bloq <= 5) {
            badgeBloq.innerHTML = `<span class="badge bg-warning text-dark">⚠️ ${bloq} ítem(s)</span>`;
        } else {
            badgeBloq.innerHTML = `<span class="badge bg-danger">🔴 Crítico: ${bloq} ítems</span>`;
        }

        // ── 3. Tramo más lento ────────────────────────────────────────
        const tramos = [{ n: 'T1 Reg→Aut', v: t1 }, { n: 'T2 Aut→Log', v: t2 }, { n: 'T3 Log→OC', v: t3 }];
        const badgeTramo = document.getElementById('res-tramo-badge');
        if (ciclo <= 0) {
            document.getElementById('res-tramo-lento').textContent = '—';
            badgeTramo.innerHTML = '<span class="badge bg-secondary">sin datos</span>';
        } else {
            const lento = tramos.reduce((a, b) => b.v > a.v ? b : a);
            document.getElementById('res-tramo-lento').textContent = lento.n + ' (' + lento.v.toFixed(1) + 'd)';
            const cicloLabel = 'Ciclo: ' + ciclo.toFixed(1) + 'd';
            if (ciclo <= 15) {
                badgeTramo.innerHTML = `<span class="badge bg-success">✅ ${cicloLabel}</span>`;
            } else if (ciclo <= 25) {
                badgeTramo.innerHTML = `<span class="badge bg-warning text-dark">⚠️ ${cicloLabel}</span>`;
            } else {
                badgeTramo.innerHTML = `<span class="badge bg-danger">🔴 ${cicloLabel}</span>`;
            }
        }

        // ── 4. Tendencia (últimos 2 meses con datos) ───────────────────
        let tendHTML = '—';
        let tendBadge = '<span class="badge bg-secondary">sin datos</span>';
        try {
            const tend = JSON.parse(tendStr || '[]');
            const conDatos = tend.filter(x => x.reqs > 0);
            if (conDatos.length >= 2) {
                const ult  = conDatos[conDatos.length - 1];
                const prev = conDatos[conDatos.length - 2];
                const diff = ult.ciclo - prev.ciclo;
                if (diff < -0.5) {
                    tendHTML  = '📉 Mejora';
                    tendBadge = `<span class="badge bg-success">▼ ${Math.abs(diff).toFixed(1)}d menos</span>`;
                } else if (diff > 0.5) {
                    tendHTML  = '📈 Empeora';
                    tendBadge = `<span class="badge bg-danger">▲ ${diff.toFixed(1)}d más</span>`;
                } else {
                    tendHTML  = '➡️ Estable';
                    tendBadge = '<span class="badge bg-info text-dark">Sin variación</span>';
                }
            }
        } catch (_) {}
        document.getElementById('res-tendencia').innerHTML = tendHTML;
        document.getElementById('res-tend-badge').innerHTML = tendBadge;

        // ── 5. Urgentes (pendientes >7d) ──────────────────────────────
        document.getElementById('res-urgentes').textContent = urg;
        const badgeUrg = document.getElementById('res-urg-badge');
        if (urg === 0) {
            badgeUrg.innerHTML = '<span class="badge bg-success">✅ Sin urgentes</span>';
        } else if (urg <= 3) {
            badgeUrg.innerHTML = `<span class="badge bg-warning text-dark">⚠️ ${urg} ítem(s)</span>`;
        } else {
            badgeUrg.innerHTML = `<span class="badge bg-danger">🔴 ${urg} urgentes</span>`;
        }

        // Mostrar período
        document.getElementById('resumenPeriodo').textContent =
            p.fechaDesde && p.fechaHasta ? `— ${p.fechaDesde} al ${p.fechaHasta}` : '';

        document.getElementById('resumenEjecutivo').style.display = '';
    };

    // Carga automática al abrir (solo si las fechas están presentes)
    document.addEventListener('DOMContentLoaded', () => {
        const p = getParams();
        if (p.fechaDesde && p.fechaHasta) document.getElementById('btnConsultar').click();
    });
</script>

<!-- Modal de avisos -->
<div class="modal fade" id="indAlertModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title"><i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>Atención</h6>
                <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-2" id="indAlertMsg"></div>
            <div class="modal-footer py-1">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
}

