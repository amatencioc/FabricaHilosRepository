@section Scripts {
<script src="~/lib/select2/dist/js/select2.min.js" asp-append-version="true"></script>
<script>
$(function () {
    $('#selectAreas, #selectUsuarios, #selectCcosto, #selectCargo').select2({
        theme: 'bootstrap-5',
        width: '100%',
        placeholder: 'Seleccione...'
    });

    $('#selectUsuarios').select2({
        theme: 'bootstrap-5',
        width: '100%',
        placeholder: 'Busque por nombre, usuario o DNI...',
        minimumInputLength: 2,
        ajax: {
            url: '@Url.Action("BuscarEmpleados", "CapacitacionAdmin")',
            dataType: 'json',
            delay: 300,
            data: params => ({ term: params.term }),
            processResults: data => data
        }
    });

    document.getElementById('cursoPrivado').addEventListener('change', function () {
        document.getElementById('seccionAlcance').style.display = this.checked ? 'block' : 'none';
    });

    document.getElementById('tipoAlcance').addEventListener('change', function () {
        document.getElementById('wrapAreas').style.display     = this.value === 'AREA'     ? 'block' : 'none';
        document.getElementById('wrapCcosto').style.display     = this.value === 'AREA'     ? 'block' : 'none';
        document.getElementById('wrapCargo').style.display      = this.value === 'AREA'     ? 'block' : 'none';
        document.getElementById('wrapUsuarios').style.display  = this.value === 'PERSONAL' ? 'block' : 'none';
    });
});

function cambiarTipo(tipo) {
    document.getElementById('fieldArchivo').classList.toggle('d-none', tipo==='URL'||tipo==='TXT');
    document.getElementById('fieldUrl').classList.toggle('d-none', tipo!=='URL');
    document.getElementById('fieldHtml').classList.toggle('d-none', tipo!=='TXT');
    document.getElementById('fieldDuracion').closest('.col-md-4').classList.toggle('d-none', tipo!=='VID');
}

async function subirContenido() {
    const form = document.getElementById('formContenido');
    const fd   = new FormData(form);
    const btn  = event.target;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Subiendo...';

    try {
        const resp = await fetch('@Url.Action("GuardarContenido","CapacitacionAdmin")', {
            method: 'POST', body: fd
        });
        const data = await resp.json();
        if (data.ok) {
            bootstrap.Modal.getInstance(document.getElementById('modalContenido')).hide();
            form.reset();
            showLmsToast('Contenido guardado. Recargando...', 'success');
            setTimeout(() => location.reload(), 800);
        } else {
            showLmsToast('Error: ' + data.msg, 'error');
        }
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-cloud-upload me-1"></i>Guardar contenido';
    }
}

async function eliminarContenido(idContenido, btnEl) {
    if (!confirm('¿Eliminar este contenido?')) return;
    btnEl.disabled = true;
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    try {
        const resp = await fetch('@Url.Action("EliminarContenido","CapacitacionAdmin")', {
            method: 'POST',
            headers: { 'Content-Type':'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
            body: 'idContenido=' + idContenido
        });
        const data = await resp.json();
        if (data.ok) {
            btnEl.closest('.list-group-item').remove();
            showLmsToast('Contenido eliminado.', 'success');
        }
    } catch { showLmsToast('Error al eliminar.', 'error'); }
}

function cambiarTipoEdit(tipo) {
    document.getElementById('editFieldArchivo').classList.toggle('d-none', tipo==='URL'||tipo==='TXT');
    document.getElementById('editFieldUrl').classList.toggle('d-none', tipo!=='URL');
    document.getElementById('editFieldHtml').classList.toggle('d-none', tipo!=='TXT');
    document.getElementById('editDuracion').closest('.col-md-4').classList.toggle('d-none', tipo!=='VID');
}

async function editarContenido(idContenido) {
    try {
        const resp = await fetch('@Url.Action("ObtenerContenido","CapacitacionAdmin")?idContenido=' + idContenido);
        const data = await resp.json();
        if (!data.ok) { showLmsToast('Error: ' + data.msg, 'error'); return; }

        document.getElementById('editIdContenido').value = data.idContenido;
        document.getElementById('editTitulo').value = data.titulo;
        document.getElementById('editTipoContenido').value = data.tipo;
        document.getElementById('editOrden').value = data.orden;
        document.getElementById('editDuracion').value = data.duracionSeg;
        document.getElementById('editObligatorio').value = data.obligatorio;
        document.getElementById('editUrlExterna').value = data.urlExterna || '';
        document.getElementById('editContenidoHtml').value = data.contenidoHtml || '';

        cambiarTipoEdit(data.tipo);
        new bootstrap.Modal(document.getElementById('modalEditarContenido')).show();
    } catch { showLmsToast('Error al cargar datos del contenido.', 'error'); }
}

async function actualizarContenido() {
    const form = document.getElementById('formEditarContenido');
    const fd = new FormData(form);
    const btn = event.target;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Actualizando...';

    try {
        const resp = await fetch('@Url.Action("ActualizarContenido","CapacitacionAdmin")', {
            method: 'POST', body: fd
        });
        const data = await resp.json();
        if (data.ok) {
            bootstrap.Modal.getInstance(document.getElementById('modalEditarContenido')).hide();
            showLmsToast('Contenido actualizado. Recargando...', 'success');
            setTimeout(() => location.reload(), 800);
        } else {
            showLmsToast('Error: ' + data.msg, 'error');
        }
    } catch { showLmsToast('Error de conexión.', 'error'); }
    finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Actualizar contenido';
    }
}

function toggleNroAleatorias() {
    document.getElementById('fieldNroAleatorias').classList.toggle('d-none', document.getElementById('exModo').value !== 'R');
}

async function crearExamen() {
    const titulo = document.getElementById('exTitulo').value.trim();
    if (!titulo) { showLmsToast('El título del examen es obligatorio.', 'error'); return; }
    const tiempo = document.getElementById('exTiempo').value;
    if (!tiempo || tiempo < 1) { showLmsToast('Indique un tiempo válido.', 'error'); return; }

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    const body = new URLSearchParams({
        idCurso: '@Model.IdCurso',
        titulo,
        tiempoMin: tiempo,
        instrucciones: document.getElementById('exInstrucciones').value,
        mezclarPreg: document.getElementById('exMezclarPreg').value,
        mezclarOpc: document.getElementById('exMezclarOpc').value,
        modoPreguntas: document.getElementById('exModo').value,
        nroPregAleatorias: document.getElementById('exNroAl').value || ''
    });

    try {
        const resp = await fetch('@Url.Action("CrearExamen","CapacitacionAdmin")', {
            method: 'POST',
            headers: { 'Content-Type':'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
            body: body.toString()
        });
        const data = await resp.json();
        if (data.ok) {
            bootstrap.Modal.getInstance(document.getElementById('modalCrearExamen')).hide();
            showLmsToast('Examen creado. Recargando...', 'success');
            setTimeout(() => location.reload(), 800);
        } else {
            showLmsToast('Error: ' + data.msg, 'error');
        }
    } catch { showLmsToast('Error de conexión.', 'error'); }
}

// --- Preguntas ---
const idExamenActual = @(examen?.IdExamen ?? 0);

function toggleOpcionesPanel() {
    const tipo = document.getElementById('pregTipo').value;
    const mostrar = (tipo === 'OM' || tipo === 'OV' || tipo === 'VF');
    document.getElementById('panelOpciones').classList.toggle('d-none', !mostrar);
}

function agregarOpcion() {
    const html = `<div class="input-group mb-2 opcion-row">
        <div class="input-group-text"><input type="checkbox" class="form-check-input opc-correcta" title="Marcar como correcta"></div>
        <input type="text" class="form-control opc-texto" placeholder="Texto de la opción...">
        <button class="btn btn-outline-danger btn-sm" type="button" onclick="this.closest('.opcion-row').remove()"><i class="bi bi-x"></i></button>
    </div>`;
    document.getElementById('listaOpciones').insertAdjacentHTML('beforeend', html);
}

async function guardarPregunta() {
    const enunciado = document.getElementById('pregEnunciado').value.trim();
    if (!enunciado) { showLmsToast('El enunciado es obligatorio.', 'error'); return; }
    if (idExamenActual === 0) { showLmsToast('Primero cree el examen.', 'error'); return; }

    const tipoPreg = document.getElementById('pregTipo').value;
    const puntaje = document.getElementById('pregPuntaje').value || '1';
    const orden = document.getElementById('pregOrden').value || '';

    // Recopilar opciones
    let opciones = [];
    if (tipoPreg === 'OM' || tipoPreg === 'OV' || tipoPreg === 'VF') {
        const rows = document.querySelectorAll('#listaOpciones .opcion-row');
        rows.forEach((row, idx) => {
            const texto = row.querySelector('.opc-texto').value.trim();
            if (texto) {
                opciones.push({
                    Texto: texto,
                    EsCorrecta: row.querySelector('.opc-correcta').checked,
                    Orden: idx + 1
                });
            }
        });
        if (opciones.length < 2) { showLmsToast('Agregue al menos 2 opciones.', 'error'); return; }
        if (!opciones.some(o => o.EsCorrecta)) { showLmsToast('Marque al menos una opción correcta.', 'error'); return; }
    }

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    const body = new URLSearchParams({
        idExamen: idExamenActual,
        enunciado,
        tipoPreg,
        puntaje,
        orden,
        opcionesJson: JSON.stringify(opciones)
    });

    try {
        const resp = await fetch('@Url.Action("GuardarPregunta","CapacitacionAdmin")', {
            method: 'POST',
            headers: { 'Content-Type':'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
            body: body.toString()
        });
        const data = await resp.json();
        if (data.ok) {
            bootstrap.Modal.getInstance(document.getElementById('modalPregunta')).hide();
            document.getElementById('pregEnunciado').value = '';
            document.getElementById('listaOpciones').innerHTML = `
                <div class="input-group mb-2 opcion-row"><div class="input-group-text"><input type="checkbox" class="form-check-input opc-correcta"></div><input type="text" class="form-control opc-texto" placeholder="Texto de la opción..."><button class="btn btn-outline-danger btn-sm" type="button" onclick="this.closest('.opcion-row').remove()"><i class="bi bi-x"></i></button></div>
                <div class="input-group mb-2 opcion-row"><div class="input-group-text"><input type="checkbox" class="form-check-input opc-correcta"></div><input type="text" class="form-control opc-texto" placeholder="Texto de la opción..."><button class="btn btn-outline-danger btn-sm" type="button" onclick="this.closest('.opcion-row').remove()"><i class="bi bi-x"></i></button></div>`;
            showLmsToast('Pregunta guardada.', 'success');
            cargarPreguntas();
        } else {
            showLmsToast('Error: ' + data.msg, 'error');
        }
    } catch { showLmsToast('Error de conexión.', 'error'); }
}

async function eliminarPregunta(idPregunta) {
    if (!confirm('¿Eliminar esta pregunta?')) return;
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    try {
        const resp = await fetch('@Url.Action("EliminarPregunta","CapacitacionAdmin")', {
            method: 'POST',
            headers: { 'Content-Type':'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
            body: 'idPregunta=' + idPregunta
        });
        const data = await resp.json();
        if (data.ok) { showLmsToast('Pregunta eliminada.', 'success'); cargarPreguntas(); }
    } catch { showLmsToast('Error al eliminar.', 'error'); }
}

async function cargarPreguntas() {
    if (idExamenActual === 0) return;
    const container = document.getElementById('listaPreguntas');
    if (!container) return;
    try {
        const resp = await fetch('@Url.Action("ListarPreguntas","CapacitacionAdmin")?idExamen=' + idExamenActual);
        const preguntas = await resp.json();
        if (!preguntas.length) {
            container.innerHTML = '<div class="text-muted small text-center py-2"><i class="bi bi-info-circle me-1"></i>No hay preguntas. Usa "+ Agregar pregunta".</div>';
            return;
        }
        const tipoIconos = { OM:'bi-ui-radios', OV:'bi-check2-square', VF:'bi-toggle-on', EMP:'bi-arrow-left-right', RC:'bi-input-cursor-text', ENS:'bi-journal-text' };
        const tipoTextos = { OM:'Opción múltiple', OV:'Varias correctas', VF:'V/F', EMP:'Emparejamiento', RC:'Resp. corta', ENS:'Ensayo' };
        let html = '<div class="list-group list-group-flush">';
        preguntas.forEach((p, i) => {
            const icon = tipoIconos[p.tipoPreg] || 'bi-question';
            html += `<div class="list-group-item px-0 py-2" style="border-color:#f1f5f9">
                <div class="d-flex align-items-start gap-2">
                    <span style="width:24px;height:24px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#eff6ff;flex-shrink:0;font-size:.7rem;font-weight:600;color:#1d4ed8">${i+1}</span>
                    <div class="flex-grow-1">
                        <div style="font-size:.82rem;color:#0f172a;font-weight:500">${p.enunciado}</div>
                        <div style="font-size:.7rem;color:#94a3b8;margin-top:.15rem">
                            <i class="bi ${icon} me-1"></i>${tipoTextos[p.tipoPreg]||p.tipoPreg} · ${p.puntaje} pts
                        </div>`;
            if (p.opciones && p.opciones.length) {
                html += '<div class="mt-1" style="font-size:.72rem;color:#64748b">';
                p.opciones.forEach(o => {
                    const mark = o.esCorrecta === 'S' ? '✓' : '○';
                    const color = o.esCorrecta === 'S' ? '#166534' : '#64748b';
                    html += `<div style="color:${color}">${mark} ${o.texto}</div>`;
                });
                html += '</div>';
            }
            html += `</div>
                    <button class="btn btn-sm btn-link text-danger p-0" title="Eliminar" onclick="eliminarPregunta(${p.idPregunta})"><i class="bi bi-trash"></i></button>
                </div>
            </div>`;
        });
        html += '</div>';
        html += `<div class="mt-2" style="font-size:.72rem;color:#64748b"><i class="bi bi-info-circle me-1"></i>${preguntas.length} pregunta(s) registrada(s)</div>`;
        container.innerHTML = html;
    } catch { container.innerHTML = '<div class="text-danger small">Error al cargar preguntas.</div>'; }
}

// Cargar preguntas al iniciar
document.addEventListener('DOMContentLoaded', () => { if (idExamenActual > 0) cargarPreguntas(); });

function guardarCurso() {
    const titulo = document.getElementById('titulo').value.trim();
    if (!titulo) {
        showLmsToast('El título es obligatorio.', 'error');
        return;
    }
    const categoria = document.getElementById('categoria').value;
    if (!categoria) {
        showLmsToast('Seleccione una categoría.', 'error');
        return;
    }

    const btn = event.target.closest('button');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Guardando...';

    const body = new URLSearchParams({
        idCurso: '@Model.IdCurso',
        titulo,
        idCategoria: categoria,
        nivel: document.getElementById('nivel').value,
        duracionMin: document.getElementById('duracion').value || '',
        descripcion: document.getElementById('descripcion').value,
        objetivo: document.getElementById('objetivo').value,
        notaAprobacion: document.getElementById('notaAprob').value || '70',
        maxIntentos: document.getElementById('maxIntentos').value || '3',
        certValidezDias: document.getElementById('certValidez').value || '',
        estado: document.getElementById('estadoCurso').value,
        obligatorio: document.getElementById('obligatorio').checked,
        tieneExamen: document.getElementById('tieneExamen').checked,
        tieneCertificado: document.getElementById('tieneCert').checked,
        visibilidad: document.getElementById('cursoPrivado').checked ? 'PRI' : 'PUB',
        alcance: document.getElementById('tipoAlcance').value,
        areasJson: JSON.stringify($('#selectAreas').val() || []),
        ccostosJson: JSON.stringify($('#selectCcosto').val() || []),
        cargosJson: JSON.stringify($('#selectCargo').val() || []),
        usuariosJson: JSON.stringify($('#selectUsuarios').val() || [])
    });

    fetch('@Url.Action("GuardarCurso","CapacitacionAdmin")', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ''
        },
        body: body.toString()
    })
    .then(r => r.json())
    .then(data => {
        if (data.ok) {
            showLmsToast(data.msg, 'success');
            if (@(esNuevo ? "true" : "false") && data.idCurso > 0) {
                setTimeout(() => { window.location = '/RecursosHumanos/CapacitacionAdmin/CursoForm?id=' + data.idCurso; }, 800);
            }
        } else {
            document.getElementById('modalCursoInfoMsg').textContent = data.msg || 'Error al guardar el curso.';
            new bootstrap.Modal(document.getElementById('modalCursoInfo')).show();
        }
    })
    .catch(() => {
        showLmsToast('Error de conexión al guardar.', 'error');
    })
    .finally(() => {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-save me-1"></i>Guardar curso';
    });
}

function showLmsToast(msg, type) {
    const t = document.getElementById('lmsToast');
    const icon = document.getElementById('lmsToastIcon');
    const msgEl = document.getElementById('lmsToastMsg');
    const colors = { success: '#0f766e', error: '#9f1239', info: '#1d4ed8' };
    const icons  = { success: 'bi-check-circle-fill', error: 'bi-x-circle-fill', info: 'bi-info-circle-fill' };
    const c = colors[type] || colors.info;
    t.style.borderLeftColor = c;
    icon.className = 'bi ' + (icons[type] || icons.info);
    icon.style.color = c;
    msgEl.textContent = msg;
    t.style.display = 'flex';
    clearTimeout(t._to);
    t._to = setTimeout(hideLmsToast, 4000);
}
function hideLmsToast() {
    document.getElementById('lmsToast').style.display = 'none';
}
</script>
}
