    estimaRod  = r.EstimaRod.HasValue   ? r.EstimaRod.Value.ToString("dd/MM/yy")    : (string?)null,
    entregRod  = r.EntregRod.HasValue   ? r.EntregRod.Value.ToString("dd/MM/yy")    : (string?)null,
    diasRod    = r.DiasRod,
    estimaMat  = r.EstimaMat.HasValue   ? r.EstimaMat.Value.ToString("dd/MM/yy")    : (string?)null,
    entregMat  = r.EntregMat.HasValue   ? r.EntregMat.Value.ToString("dd/MM/yy")    : (string?)null,
    diasMh     = r.DiasMh,
    fchaGuia   = r.FchaGuia.HasValue    ? r.FchaGuia.Value.ToString("dd/MM/yy")     : (string?)null,
    estimaRec  = r.EstimaReceta.HasValue  ? r.EstimaReceta.Value.ToString("dd/MM/yy")  : (string?)null,
    entregRec  = r.EntregReceta.HasValue  ? r.EntregReceta.Value.ToString("dd/MM/yy")  : (string?)null,
    diasRec    = r.DiasRec,
