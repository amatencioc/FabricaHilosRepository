@model IEnumerable<FabricaHilos.Models.Logistica.OrdenCompraDto>
@inject FabricaHilos.Services.INavTokenService NavTokenSvc

@{
    ViewData["Title"] = "Órdenes de Compra";
    string? buscar      = ViewBag.Buscar      as string;
    string? fechaInicio = ViewBag.FechaInicio as string;
    string? fechaFin    = ViewBag.FechaFin    as string;
    string? estado      = ViewBag.Estado      as string;
    string? navToken    = ViewBag.NavToken    as string;
    bool    hayFiltros  = !string.IsNullOrEmpty(buscar) || !string.IsNullOrEmpty(estado)
                       || !string.IsNullOrEmpty(fechaInicio) || !string.IsNullOrEmpty(fechaFin);
    bool    noNuevaOC     = ViewBag.NoNuevaOC    is bool b && b;
    string? estadoForzado = ViewBag.EstadoForzado as string;
    int currentPage = ViewBag.Page       != null ? Convert.ToInt32(ViewBag.Page)       : 1;
    int totalPages  = ViewBag.TotalPages  != null ? Convert.ToInt32(ViewBag.TotalPages)  : 1;
    int totalCount  = ViewBag.TotalCount  != null ? Convert.ToInt32(ViewBag.TotalCount)  : 0;
    int pgSize      = ViewBag.PageSize    != null ? Convert.ToInt32(ViewBag.PageSize)    : 20;
    int startItem   = totalCount == 0 ? 0 : (currentPage - 1) * pgSize + 1;
    int endItem     = Math.Min(currentPage * pgSize, totalCount);
    var proveedores = ViewBag.Proveedores  as Dictionary<string, string> ?? new Dictionary<string, string>();
    var centrosCosto = ViewBag.CentrosCosto as Dictionary<string, string> ?? new Dictionary<string, string>();
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Logistica" asp-action="Index">Logística</a></li>
    <li class="breadcrumb-item active">Órdenes de Compra</li>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="section-title mb-0"><i class="bi bi-cart-check me-2"></i>Órdenes de Compra</h4>
    <div class="d-flex align-items-center gap-2">
        <span class="text-muted small">@totalCount registro(s) encontrado(s)</span>
        @if (!noNuevaOC)
        {
            <a asp-action="Nueva" asp-route-t="@navToken"
               class="btn btn-sm btn-success">
                <i class="bi bi-plus-circle me-1"></i>Nueva Orden de Compra
            </a>
        }
    </div>
</div>

<!-- Filtros -->
<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" asp-action="Index" class="d-flex gap-2 flex-wrap align-items-center">
            @if (!string.IsNullOrEmpty(estadoForzado))
            {
                <input type="hidden" name="estado" value="@estadoForzado" />
            }
            <input type="text" name="buscar" value="@buscar"
                   class="form-control form-control-sm"
                   placeholder="Buscar por proveedor o N° pedido..."
                   style="max-width:260px;" />

            <div class="d-flex align-items-center gap-1">
                <label class="form-label mb-0 text-nowrap small text-muted">Desde:</label>
                <input type="date" name="fechaInicio" value="@fechaInicio"
                       class="form-control form-control-sm" style="max-width:155px;" />
            </div>
            <div class="d-flex align-items-center gap-1">
                <label class="form-label mb-0 text-nowrap small text-muted">hasta:</label>
                <input type="date" name="fechaFin" value="@fechaFin"
                       class="form-control form-control-sm" style="max-width:155px;" />
            </div>

            <button type="submit" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-search"></i> Buscar
            </button>
            @if (hayFiltros)
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Limpiar</a>
            }
        </form>
    </div>
</div>

<!-- Tabla -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive" style="overflow-y: clip;">
            <table class="table table-corporate table-hover mb-0" style="min-width:1200px;">
                <thead>
                    <tr>
                        <th class="text-center">Tipo</th>
                        <th class="text-center">N° Pedido</th>
                        <th>Proveedor</th>
                        <th>C. Costo</th>
                        <th class="text-center">Fecha</th>
                        <th class="text-center">F. Entrega</th>
                        <th>Detalle</th>
                        <th class="text-center">Moneda</th>
                        <th class="text-end">Val. Venta</th>
                        <th class="text-end">IGV</th>
                        <th class="text-end">Total</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var oc in Model)
                    {
                        var nomProv = !string.IsNullOrEmpty(oc.CodProveed) && proveedores.TryGetValue(oc.CodProveed, out var np) ? np : oc.CodProveed;
                        var ccDesc  = !string.IsNullOrEmpty(oc.CCosto) && centrosCosto.TryGetValue(oc.CCosto, out var ccd) ? ccd : oc.CCosto;
                        var dtToken = NavTokenSvc.Protect(new Dictionary<string, string?> {
                            ["tipoDocto"] = oc.TipoDocto,
                            ["serie"]     = oc.Serie.ToString(),
                            ["numPed"]    = oc.NumPed.ToString()
                        });
                        <tr>
                            <td class="text-center">@(oc.TipoDocto ?? "-")</td>
                            <td class="text-center fw-semibold">@oc.NumPed</td>
                            <td title="@oc.CodProveed">@(nomProv ?? "-")</td>
                            <td title="@oc.CCosto">@(ccDesc ?? "-")</td>
                            <td class="text-center">@(oc.Fecha?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td class="text-center">@(oc.FEntrega?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td class="small text-muted">@(oc.Detalle ?? "-")</td>
                            @{ var sim = oc.Moneda?.ToUpper() == "D" ? "$" : "S/"; }
                            <td class="text-center">
                                @if (oc.Moneda?.ToUpper() == "D")
                                {
                                    <span class="badge bg-success">$</span>
                                }
                                else if (oc.Moneda?.ToUpper() == "S")
                                {
                                    <span class="badge bg-primary">S/</span>
                                }
                                else
                                {
                                    <span class="text-muted">@(oc.Moneda ?? "-")</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">@sim&nbsp;@oc.ValVenta.ToString("N2")</td>
                            <td class="text-end text-nowrap">@sim&nbsp;@oc.ImpIgv.ToString("N2")</td>
                            <td class="text-end text-nowrap fw-semibold">@sim&nbsp;@oc.PrecioVta.ToString("N2")</td>
                            <td class="text-center">
                                @{
                                    var (badgeClass, estadoLabel) = (oc.Estado ?? "", oc.AprobGerencia) switch {
                                        ("2", "S") => ("bg-success", "Aprobado Gerencia"),
                                        ("0", _)   => ("bg-secondary", "Emitida"),
                                        ("2", _)   => ("bg-warning text-dark", "En Aprobación"),
                                        ("3", "N") => ("bg-danger", "No Aprob. Gerencia"),
                                        ("5", _)   => ("bg-info text-dark", "Parc. Cerrada"),
                                        ("6", _)   => ("bg-success", "Cerrada"),
                                        ("9", _)   => ("bg-danger", "Anulada"),
                                        _          => ("bg-light text-dark", oc.Estado ?? "-")
                                    };
                                }
                                <span class="badge @badgeClass">@estadoLabel</span>
                            </td>
                            <td class="text-center">
                                <div class="d-flex gap-1 justify-content-center">
                                    <a asp-action="Detalle"
                                       asp-route-dt="@dtToken"
                                       asp-route-t="@navToken"
                                       asp-route-page="@currentPage"
                                       class="btn btn-sm btn-outline-primary" title="Ver detalle">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <div class="btn-group">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-success dropdown-toggle"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false"
                                                title="Imprimir">
                                            <i class="bi bi-printer"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-action="Imprimir"
                                                   asp-route-dt="@dtToken"
                                                   asp-route-t="@navToken"
                                                   target="_blank">
                                                    <i class="bi bi-person me-2"></i>Para Proveedor
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-action="ImprimirContabilidad"
                                                   asp-route-dt="@dtToken"
                                                   asp-route-t="@navToken"
                                                   target="_blank">
                                                    <i class="bi bi-file-earmark-spreadsheet me-2"></i>Para Contabilidad
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                    @if (oc.Estado != "6" && oc.Estado != "9")
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-dark btn-cerrar-oc"
                                                data-tipo="@oc.TipoDocto"
                                                data-serie="@oc.Serie"
                                                data-numpd="@oc.NumPed"
                                                title="Cerrar O/C">
                                            <i class="bi bi-lock"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="13" class="text-center text-muted py-4">No se encontraron órdenes de compra.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center py-2">
            <small class="text-muted">Mostrando @startItem–@endItem de @totalCount</small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-t="@navToken"
                           asp-route-page="@(currentPage - 1)">«</a>
                    </li>
                    @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-t="@navToken"
                               asp-route-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-t="@navToken"
                           asp-route-page="@(currentPage + 1)">»</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

@section Scripts {
<!-- Modal confirmación cerrar O/C -->
<div class="modal fade" id="modalCerrarOc" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title">Cerrar Orden de Compra</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalCerrarMensaje"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-dark" id="modalCerrarOk">Cerrar O/C</button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    // Inicializar dropdowns con strategy fixed para que salgan del overflow de la tabla
    document.querySelectorAll('.dropdown-toggle').forEach(function (btn) {
        new bootstrap.Dropdown(btn, {
            popperConfig: function (defaultConfig) {
                defaultConfig.strategy = 'fixed';
                return defaultConfig;
            }
        });
    });

    var modalCerrar  = new bootstrap.Modal(document.getElementById('modalCerrarOc'));
    var modalMensaje = document.getElementById('modalCerrarMensaje');
    var modalOk      = document.getElementById('modalCerrarOk');
    var _btnActual   = null;

    document.querySelectorAll('.btn-cerrar-oc').forEach(function (btn) {
        btn.addEventListener('click', function () {
            _btnActual = btn;
            modalMensaje.innerHTML = '¿Está seguro de cerrar la O/C <strong>N° ' + btn.dataset.numpd + '</strong>? El estado cambiará a <strong>Cerrada</strong>.';
            modalCerrar.show();
        });
    });

    modalOk.addEventListener('click', function () {
        if (!_btnActual) return;
        modalCerrar.hide();
        fetch('@Url.Action("CerrarOc", "OrdenCompra")', {
            method:  'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ''
            },
            body: JSON.stringify({
                tipoDocto: _btnActual.dataset.tipo,
                serie:     parseInt(_btnActual.dataset.serie),
                numPed:    parseInt(_btnActual.dataset.numpd)
            })
        })
        .then(function (r) { return r.json(); })
        .then(function (d) {
            if (d.ok) { window.location.reload(); }
            else { alert('Error: ' + d.error); }
        })
        .catch(function () { alert('Error de comunicación con el servidor.'); });
    });
})();
</script>
@Html.AntiForgeryToken()
}
