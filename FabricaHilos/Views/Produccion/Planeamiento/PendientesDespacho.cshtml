@section Styles {
<link rel="stylesheet" href="~/css/planeamiento.css" asp-append-version="true" />
}

@using FabricaHilos.Models.Produccion.Planeamiento
@model IEnumerable<PlnPendienteDespacho>
@{
    ViewData["Title"] = "Pendientes de Despacho";
    var lista    = Model.ToList();
    var proximos = (ViewBag.Proximos as List<PlnPendienteDespacho>) ?? new List<PlnPendienteDespacho>();

    var nVencidos  = lista.Count(x => x.EstaVencido);
    var nUrgentes  = lista.Count(x => x.EsUrgente);
    var kgTotal    = lista.Sum(x => x.KgPendientes);
    var kgDesp     = lista.Sum(x => x.KgADespachar);
    var stockCubre = lista.All(x => x.StockDisponible >= x.KgPendientes);

    // helper local: clase de fila según urgencia/retraso
    string RowCss(PlnPendienteDespacho p) =>
        p.EsUrgente     ? "table-danger"  :
        p.EstaVencido   ? "table-warning" :
        p.DiasVencido >= -2 ? "table-info table-info-soft" : "";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Produccion" asp-action="Index">Producción</a></li>
    <li class="breadcrumb-item active">Pendientes de Despacho</li>
}

@await Html.PartialAsync("_PlnNavBar")

<div class="container-fluid py-3">

    @* ── Encabezado ─────────────────────────────────────────────────── *@
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0"><i class="bi bi-truck me-2 text-primary"></i>Pendientes de Despacho</h4>
            <small class="text-muted">Ítems en Almacén PT listos para despachar · @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</small>
        </div>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            @if (nUrgentes > 0)
            {
                <span class="badge bg-danger fs-6"><i class="bi bi-exclamation-triangle me-1"></i>@nUrgentes urgente@(nUrgentes != 1 ? "s" : "")</span>
            }
            @if (nVencidos > 0)
            {
                <span class="badge bg-warning text-dark fs-6"><i class="bi bi-clock-history me-1"></i>@nVencidos vencido@(nVencidos != 1 ? "s" : "")</span>
            }
            <span class="badge bg-secondary fs-6">@lista.Count ítem@(lista.Count != 1 ? "s" : "")</span>
            <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Seguimiento
            </a>
        </div>
    </div>

    @* ── KPI Cards ───────────────────────────────────────────────────── *@
    <div class="row g-2 mb-3">
        <div class="col-6 col-md-3">
            <div class="card border-primary text-center py-2">
                <div class="fw-bold fs-4 text-primary">@lista.Count</div>
                <small class="text-muted">Ítems pendientes</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 bg-light text-center py-2">
                <div class="fw-bold fs-4">@kgTotal.ToString("N0") kg</div>
                <small class="text-muted">Total kg pedidos</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 bg-light text-center py-2">
                <div class="fw-bold fs-4 @(stockCubre ? "text-success" : "text-warning")">@kgDesp.ToString("N0") kg</div>
                <small class="text-muted">Kg listos a despachar</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card @(proximos.Any(p => p.EstaVencido || p.DiasVencido >= -3) ? "border-warning" : "border-0 bg-light") text-center py-2">
                <div class="fw-bold fs-4 @(proximos.Any(p => p.EstaVencido) ? "text-warning" : "")">@proximos.Count</div>
                <small class="text-muted">Próximos a llegar</small>
            </div>
        </div>
    </div>

    @* ── Tabla: Listos para despachar (PASO 12 / 13) ────────────────── *@
    @if (!lista.Any())
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i>No hay ítems pendientes de despacho en este momento.
        </div>
    }
    else
    {
        <div class="mb-4">
            <button class="pln-area-hdr" type="button"
                    data-bs-toggle="collapse" data-bs-target="#collapseListos"
                    aria-expanded="true">
                <i class="bi bi-box-seam me-2"></i>En Almacén PT — Listos para despachar
                <span class="badge bg-light text-dark border ms-2" style="font-size:.65rem;">PASO 12 / 13</span>
                <span class="pln-area-chevron"><i class="bi bi-chevron-down"></i></span>
            </button>
            <div id="collapseListos" class="collapse show" style="border:1px solid var(--pln-steel); border-top:none; border-radius:0 0 4px 4px; background:#fff;">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0" style="font-size:.82rem;">
                        <thead class="table-light" style="font-size:.72rem;text-transform:uppercase;letter-spacing:.03em;color:#6c757d;">
                            <tr>
                                <th>Pedido</th>
                                <th>Ítem</th>
                                <th>Cliente</th>
                                <th>Artículo / Color</th>
                                <th class="text-center">Conos</th>
                                <th class="text-center">Kg Pend.</th>
                                <th class="text-center">Stock PT</th>
                                <th class="text-center fw-bold">Kg a Desp.</th>
                                <th class="text-center">F. Entrega</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Paso</th>
                                <th class="text-center" title="Días en almacén PT sin despachar">Días PT</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in lista)
                            {
                                <tr class="@RowCss(item)">
                                    <td>
                                        <a asp-action="Pedido"
                                           asp-route-numPed="@item.NumPed"
                                           asp-route-serie="@item.Serie"
                                           class="fw-bold text-decoration-none"
                                           title="Ver trazabilidad del pedido @item.NumPed">
                                            @item.NumPed
                                        </a>
                                        @if (!string.IsNullOrEmpty(item.PrioridadPedido))
                                        {
                                            <br /><small class="badge bg-info text-dark" style="font-size:.65rem;">Prio @item.PrioridadPedido</small>
                                        }
                                    </td>
                                    <td class="text-center text-muted">@item.Nro</td>
                                    <td>
                                        @if (item.EsUrgente)
                                        {
                                            <i class="bi bi-exclamation-triangle-fill text-danger me-1" title="Urgente"></i>
                                        }
                                        <span title="@item.CodCliente" style="max-width:160px;display:inline-block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@item.NomCliente</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold" style="font-size:.78rem;">@item.DescArt</div>
                                        <small class="text-muted">
                                            @if (!string.IsNullOrEmpty(item.Color)) { @item.Color <text>&nbsp;</text> }
                                            @item.Titulo
                                        </small>
                                    </td>
                                    <td class="text-center text-muted">
                                        @if (item.NroRmc > 0)
                                        {
                                            @item.NroRmc.ToString("N0")
                                        }
                                        else { @("—") }
                                    </td>
                                    <td class="text-end">
                                        @item.KgPendientes.ToString("N2")
                                    </td>
                                    <td class="text-end @(item.StockDisponible < item.KgPendientes ? "text-warning fw-bold" : "text-success")">
                                        @item.StockDisponible.ToString("N2")
                                        @if (item.StockDisponible < item.KgPendientes)
                                        {
                                            <i class="bi bi-exclamation-circle ms-1" title="Stock insuficiente"></i>
                                        }
                                    </td>
                                    <td class="text-end fw-bold text-primary">@item.KgADespachar.ToString("N2")</td>
                                    <td class="text-center">
                                        @if (item.FchEntregaComp.HasValue)
                                        {
                                            <span class="text-@item.SemaforoCss fw-semibold" title="@item.SemaforoTexto">
                                                @item.FchEntregaComp.Value.ToString("dd/MM/yy")
                                            </span>
                                        }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                    <td class="text-center">
                                        @if (item.DiasVencido > 0)
                                        {
                                            <span class="badge bg-@item.SemaforoCss" title="@item.SemaforoTexto">+@item.DiasVencido d</span>
                                        }
                                        else if (item.DiasVencido == 0)
                                        {
                                            <span class="badge bg-secondary">Hoy</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success" title="@(-item.DiasVencido) días restantes">@(-item.DiasVencido) d</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge" style="background-color:@item.ColorUi;font-size:.7rem;" title="@item.CodPasoAct">
                                            @item.NombrePaso
                                        </span>
                                    </td>
                                    <td class="text-center @(item.DiasEnPaso >= 3 ? "text-warning fw-bold" : "text-muted")">
                                        @item.DiasEnPaso d
                                    </td>
                                    <td style="white-space:nowrap;">
                                        <button type="button"
                                                class="btn btn-outline-secondary btn-sm py-0 px-1"
                                                style="font-size:.65rem;"
                                                onclick="abrirModalItem('timeline',@item.NumPed,@item.Serie,@item.Nro,@item.NumDet,'@item.CodArt')"
                                                title="Línea de Tiempo — @item.CodArt">
                                            <i class="bi bi-clipboard2-pulse me-1"></i>L. Tiempo
                                        </button>
                                        <button type="button"
                                                class="btn btn-outline-success btn-sm py-0 px-1 ms-1"
                                                style="font-size:.65rem;"
                                                onclick="abrirModalItem('gantt',@item.NumPed,@item.Serie,@item.Nro,@item.NumDet,'@item.CodArt')"
                                                title="Gantt — @item.CodArt">
                                            <i class="bi bi-bar-chart-steps me-1"></i>Gantt
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-semibold" style="font-size:.78rem;">
                            <tr>
                                <td colspan="4" class="text-end text-muted">Totales:</td>
                                <td class="text-center">—</td>
                                <td class="text-end">@lista.Sum(x => x.KgPendientes).ToString("N2")</td>
                                <td class="text-end">@lista.Sum(x => x.StockDisponible).ToString("N2")</td>
                                <td class="text-end text-primary">@lista.Sum(x => x.KgADespachar).ToString("N2")</td>
                                <td colspan="5"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }

    @* ── Panel: Próximos a llegar (PASO 08–11) ─────────────────────── *@
    @if (proximos.Any())
    {
        var proxVencidos = proximos.Count(x => x.EstaVencido);
        <div class="card shadow-sm">
            <button class="pln-area-hdr" type="button"
                    data-bs-toggle="collapse" data-bs-target="#collapseProximos"
                    aria-expanded="true">
                <i class="bi bi-hourglass-split me-2"></i>
                Próximos a llegar a Almacén PT
                @if (proxVencidos > 0)
                {
                    <span class="badge bg-danger ms-2">@proxVencidos con fecha vencida</span>
                }
                <span class="badge bg-light text-dark border ms-2" style="font-size:.65rem;">PASO 08–11 &nbsp;·&nbsp; @proximos.Count ítem@(proximos.Count != 1 ? "s" : "") &nbsp;·&nbsp; @proximos.Sum(x => x.KgPendientes).ToString("N0") kg</span>
                <span class="pln-area-chevron"><i class="bi bi-chevron-down"></i></span>
            </button>
            <div id="collapseProximos" class="collapse show">
                <div class="card-body p-0">
                    <table class="table table-sm table-hover align-middle mb-0" style="font-size:.81rem;">
                        <thead class="table-light" style="font-size:.72rem;text-transform:uppercase;letter-spacing:.03em;color:#6c757d;">
                            <tr>
                                <th>Pedido</th>
                                <th>Ítem</th>
                                <th>Cliente</th>
                                <th>Artículo / Color</th>
                                <th class="text-center">Paso actual</th>
                                <th class="text-center" title="Días acumulados en el paso actual">Días paso</th>
                                <th class="text-center">Conos</th>
                                <th class="text-center">Kg Pend.</th>
                                <th class="text-center" title="Kg producidos vs Kg pedidos">% Avance</th>
                                <th class="text-center">F. Entrega</th>
                                <th class="text-center" title="Fecha estimada de llegada a Almacén PT">F. Est. Desp.</th>
                                <th class="text-center">Tiempo</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in proximos)
                            {
                                <tr class="@RowCss(item)">
                                    <td>
                                        <a asp-action="Pedido"
                                           asp-route-numPed="@item.NumPed"
                                           asp-route-serie="@item.Serie"
                                           class="fw-bold text-decoration-none">
                                            @item.NumPed
                                        </a>
                                        @if (!string.IsNullOrEmpty(item.PrioridadPedido))
                                        {
                                            <br /><small class="badge bg-info text-dark" style="font-size:.65rem;">Prio @item.PrioridadPedido</small>
                                        }
                                    </td>
                                    <td class="text-center text-muted">@item.Nro</td>
                                    <td>
                                        @if (item.EsUrgente)
                                        {
                                            <i class="bi bi-exclamation-triangle-fill text-danger me-1" title="Urgente"></i>
                                        }
                                        <span title="@item.CodCliente" style="max-width:150px;display:inline-block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@item.NomCliente</span>
                                    </td>
                                    <td>
                                        <div style="font-size:.78rem;" class="fw-semibold">@item.DescArt</div>
                                        <small class="text-muted">
                                            @if (!string.IsNullOrEmpty(item.Color)) { @item.Color <text>&nbsp;</text> }
                                            @item.Titulo &mdash; @item.NombreProceso
                                        </small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge" style="background-color:@item.ColorUi;font-size:.7rem;">@item.NombrePaso</span>
                                    </td>
                                    <td class="text-center @(item.DiasEnPaso >= 3 ? "text-warning fw-bold" : "text-muted")">
                                        @item.DiasEnPaso&nbsp;d
                                    </td>
                                    <td class="text-center text-muted">
                                        @if (item.NroRmc > 0)
                                        {
                                            @item.NroRmc.ToString("N0")
                                        }
                                        else { @("—") }
                                    </td>
                                    <td class="text-end">@item.KgPendientes.ToString("N2")</td>
                                    <td class="text-center">
                                        @{
                                            var pct = item.PctCumplimiento;
                                            var pctCss = pct >= 100 ? "success" : pct >= 75 ? "info" : pct >= 50 ? "warning" : "secondary";
                                        }
                                        <span class="badge bg-@pctCss" title="@item.KgProducidos.ToString("N2") kg producidos">@pct%</span>
                                    </td>
                                    <td class="text-center">
                                        @if (item.FchEntregaComp.HasValue)
                                        {
                                            <span class="text-@item.SemaforoCss fw-semibold" title="@item.SemaforoTexto">
                                                @item.FchEntregaComp.Value.ToString("dd/MM/yy")
                                            </span>
                                        }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                    <td class="text-center text-muted" style="font-size:.78rem;">
                                        @if (item.FchEstDespacho.HasValue)
                                        {
                                            var diff = (int)(item.FchEstDespacho.Value.Date - DateTime.Today).TotalDays;
                                            var estCss = diff < 0 ? "danger" : diff <= 3 ? "warning" : "secondary";
                                            <span class="text-@estCss" title="Estimado de llegada a Almacén PT">
                                                @item.FchEstDespacho.Value.ToString("dd/MM/yy")
                                            </span>
                                        }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                    <td class="text-center">
                                        @if (item.DiasVencido > 0)
                                        {
                                            <span class="badge bg-@item.SemaforoCss">+@item.DiasVencido d vencido</span>
                                        }
                                        else if (item.DiasVencido == 0)
                                        {
                                            <span class="badge bg-secondary">Hoy</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-@item.SemaforoCss">@(-item.DiasVencido) d restantes</span>
                                        }
                                    </td>
                                    <td style="white-space:nowrap;">
                                        <button type="button"
                                                class="btn btn-outline-secondary btn-sm py-0 px-1"
                                                style="font-size:.65rem;"
                                                onclick="abrirModalItem('timeline',@item.NumPed,@item.Serie,@item.Nro,@item.NumDet,'@item.CodArt')"
                                                title="Línea de Tiempo — @item.CodArt">
                                            <i class="bi bi-clipboard2-pulse me-1"></i>L. Tiempo
                                        </button>
                                        <button type="button"
                                                class="btn btn-outline-success btn-sm py-0 px-1 ms-1"
                                                style="font-size:.65rem;"
                                                onclick="abrirModalItem('gantt',@item.NumPed,@item.Serie,@item.Nro,@item.NumDet,'@item.CodArt')"
                                                title="Gantt — @item.CodArt">
                                            <i class="bi bi-bar-chart-steps me-1"></i>Gantt
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer text-muted small">
                    Total kg en tránsito: <strong>@proximos.Sum(x => x.KgPendientes).ToString("N2")</strong>
                    &nbsp;&mdash;&nbsp;
                    Ítems retrasados en tránsito: <strong class="@(proximos.Count(x=>x.EstaVencido)>0?"text-danger":"")">@proximos.Count(x => x.EstaVencido)</strong>
                </div>
            </div>
        </div>
    }

@* ─── Modal L.Tiempo / Gantt por ítem ────────────────────────────────────── *@
<div class="modal fade" id="modalItemVista" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title mb-0">
                    <i id="modalItemIcon" class="bi bi-clipboard2-pulse me-2 text-secondary"></i>
                    <span id="modalItemTitulo">Línea de Tiempo</span>
                </h6>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0" id="modalItemBody" style="min-height:300px;">
                <div class="text-center py-4 text-muted">Seleccione un ítem para cargar.</div>
            </div>
        </div>
    </div>
</div>

</div>

@section Scripts {
<script>
// ── Modal L.Tiempo / Gantt por ítem ──────────────────────────────────────────
function abrirModalItem(tipo, numPed, serie, nro, numDet, codArt) {
    const modal   = new bootstrap.Modal(document.getElementById('modalItemVista'));
    const body    = document.getElementById('modalItemBody');
    const titulo  = document.getElementById('modalItemTitulo');
    const icon    = document.getElementById('modalItemIcon');
    const isTimeline = tipo === 'timeline';
    titulo.textContent = (isTimeline ? 'Línea de Tiempo' : 'Gantt') + ' — ' + codArt + ' (Ítem ' + nro + ')';
    icon.className = isTimeline
        ? 'bi bi-clipboard2-pulse me-2 text-secondary'
        : 'bi bi-bar-chart-steps me-2 text-success';
    body.innerHTML = '<div class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm me-2"></div>Cargando…</div>';
    modal.show();
    const action = isTimeline ? 'ItemTimeline' : 'ItemGantt';
    fetch(`/Planeamiento/${action}?numPed=${numPed}&serie=${serie}&nro=${nro}&numDet=${numDet}`)
        .then(r => r.ok ? r.text() : Promise.reject(r.status))
        .then(html => { body.innerHTML = html; })
        .catch(() => { body.innerHTML = '<div class="alert alert-danger m-2">No se pudo cargar la información del ítem.</div>'; });
}
</script>
}
