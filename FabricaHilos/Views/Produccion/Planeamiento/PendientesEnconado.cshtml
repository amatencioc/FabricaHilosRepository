@section Styles {
<link rel="stylesheet" href="~/css/planeamiento.css" asp-append-version="true" />
}

@using FabricaHilos.Models.Produccion.Planeamiento
@model IEnumerable<PlnPendienteEnconado>
@{
    ViewData["Title"] = "Pendientes de Enconado";
    var lista       = Model.ToList();
    var nTintoreria = lista.Count(x => x.Origen == "TINTORERIA");
    var nHilanderia = lista.Count(x => x.Origen == "HILANDERIA");
    var nVencidos   = lista.Count(x => x.EstaVencido);
    var kgTotal     = lista.Sum(x => x.Peso);
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Produccion" asp-action="Index">Producción</a></li>
    <li class="breadcrumb-item active">Pendientes de Enconado</li>
}

@await Html.PartialAsync("_PlnNavBar")

<div class="container-fluid py-3">

    @* ── Strip de cabecera ─────────────────────────────────────────────── *@
    <div class="pend-strip">
        <i class="bi bi-arrow-repeat" style="color:#f6ad55;font-size:.95rem;flex-shrink:0;"></i>
        <span class="pend-strip-title">Enconado / Devanado</span>
        <span class="pend-strip-sep"></span>

        <span class="pend-kpi" title="Total de partidas pendientes de enconado o devanado.">
            <i class="bi bi-boxes" style="color:#90cdf4;"></i>
            <span class="pend-kpi-val">@lista.Count</span>
            <span style="opacity:.75">partidas</span>
        </span>
        <span class="pend-kpi" style="@(nVencidos > 0 ? "" : "opacity:.45")"
              title="Partidas cuya fecha de entrega ya venció.">
            <i class="bi bi-clock-history" style="color:#fc8181;"></i>
            <span class="pend-kpi-val" style="@(nVencidos > 0 ? "color:#fc8181;" : "")">@nVencidos</span>
            <span style="opacity:.75">vencidas</span>
        </span>
        <span class="pend-kpi" title="Tintorería / Hilandería">
            <i class="bi bi-grid-1x2" style="color:#68d391;"></i>
            <span class="pend-kpi-val">@nTintoreria</span>
            <span style="opacity:.75">/ @nHilanderia</span>
            <span style="opacity:.6;font-size:.65rem;">Tint./Hil.</span>
        </span>
        <span class="pend-kpi" title="Total de kg pendientes.">
            <i class="bi bi-bag-fill" style="color:#fbd38d;"></i>
            <span class="pend-kpi-val">@kgTotal.ToString("N0")</span>
            <span style="opacity:.75">kg</span>
        </span>

        <span class="pend-strip-actions">
            <a asp-action="Dashboard" class="btn btn-sm btn-outline-light py-0 px-2" style="font-size:.72rem;">
                <i class="bi bi-arrow-left me-1"></i>Seguimiento
            </a>
        </span>
    </div>

    @* ── Filtros ───────────────────────────────────────────────────────── *@
    <div class="pend-filter">
        @await Html.PartialAsync("_PlnFiltrosPendientes", (object)"PendientesEnconado")
    </div>

    @* ── Tabla ─────────────────────────────────────────────────────────── *@
    @if (!lista.Any())
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i>No hay partidas pendientes de enconado en este momento.
        </div>
    }
    else
    {
        @* ── Filtro de estado de vencimiento ────────────────────────── *@
        <div class="d-flex align-items-end gap-2 mb-2 flex-wrap">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-funnel text-muted" style="font-size:.85rem;"></i>
                <label class="text-muted small mb-0" for="filtro-estado-enc">Estado:</label>
                <select id="filtro-estado-enc" class="form-select form-select-sm" style="width:auto;">
                    <option value="">Todos</option>
                    <option value="vencido">🔴 Vencidas</option>
                    <option value="porvencer">🟡 Por vencer</option>
                    <option value="atiempo">🟢 A tiempo</option>
                    <option value="sinfecha">— Sin fecha</option>
                </select>
                <span class="text-muted small" id="enc-count-label"></span>
            </div>
            <div style="position:relative;">
                <label class="form-label form-label-sm mb-0">RMC</label>
                <button type="button" id="btnFiltroRmc" class="form-control form-control-sm d-flex justify-content-between align-items-center"
                        style="width:220px;" autocomplete="off">
                    <span id="filtroRmcLabel" class="text-truncate">Todos</span>
                    <i class="bi bi-chevron-down small text-muted ms-1"></i>
                </button>
                <div id="dropdownRmc" class="pln-autocomplete-dropdown" style="display:none;width:260px;">
                    <div class="p-2 border-bottom">
                        <input type="text" id="filtroRmcSearch" class="form-control form-control-sm"
                               placeholder="Buscar RMC…" autocomplete="off" />
                    </div>
                    <div class="p-2 border-bottom d-flex justify-content-between">
                        <a href="#" id="filtroRmcTodos" class="small">Marcar todos</a>
                        <a href="#" id="filtroRmcLimpiar" class="small">Limpiar</a>
                    </div>
                    <div id="rmcCheckList" style="max-height:220px;overflow-y:auto;"></div>
                </div>
            </div>
            <span class="text-muted small" id="filtroRmcCount"></span>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0 pend-tbl" id="tbl-enconado">
                <thead>
                    <tr>
                        <th>Partida</th>
                        <th>Material</th>
                        <th>Cliente</th>
                        <th class="text-center">Origen</th>
                        <th class="text-center">#RMC</th>
                        <th>RMC</th>
                        <th class="text-end">Kg</th>
                        <th>Lote</th>
                        <th>Presentacion</th>
                        <th class="text-center pend-th-sort" data-col="feval" data-dir="" style="cursor:pointer;user-select:none;" title="Ordenar por F. Evaluación">
                            F. Evaluación <i class="bi bi-arrow-down-up sort-icon ms-1"></i>
                        </th>
                        <th class="text-center pend-th-sort" data-col="fprogenc" data-dir="" style="cursor:pointer;user-select:none;" title="Ordenar por Fecha Prog. Enconado">
                            Fecha Prog Enconado <i class="bi bi-arrow-down-up sort-icon ms-1"></i>
                        </th>
                        <th class="text-center pend-th-sort" data-col="fentrega" data-dir="" style="cursor:pointer;user-select:none;" title="Ordenar por F. Entrega">
                            F. Entrega <i class="bi bi-arrow-down-up sort-icon ms-1"></i>
                        </th>
                        <th class="text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in lista)
                    {
                        var rowCss = item.EstaVencido ? "table-danger" :
                                     item.DiasRetraso >= -2 ? "table-warning" : "";
                        var estadoEnc = !item.FchEntrega.HasValue ? "sinfecha" :
                                         item.EstaVencido       ? "vencido"   :
                                         item.DiasRetraso >= -2 ? "porvencer" : "atiempo";
                        <tr class="@rowCss"
                            data-estado="@estadoEnc"
                            data-feval="@(item.Fecha.HasValue ? item.Fecha.Value.ToString("yyyyMMdd") : "99999999")"
                            data-fentrega="@(item.FchEntrega.HasValue ? item.FchEntrega.Value.ToString("yyyyMMdd") : "99999999")"
                            data-fprogenc="@(item.FchProgEnconado.HasValue ? item.FchProgEnconado.Value.ToString("yyyyMMdd") : "99999999")"
                            data-rmc="@item.Rmc">
                            <td class="fw-bold">@item.Partida</td>
                            <td>@item.Material</td>
                            <td>
                                <span style="max-width:160px;display:inline-block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
                                      title="@item.Cliente">@item.Cliente</span>
                            </td>
                            <td class="text-center">
                                @if (item.Origen == "TINTORERIA")
                                {
                                    <span class="badge bg-info text-dark" style="font-size:.68rem;">Tintorería</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary" style="font-size:.68rem;">Hilandería</span>
                                }
                            </td>
                            <td class="text-center text-muted">
                                @(item.NroRmc > 0 ? item.NroRmc.ToString("N0") : "—")
                            </td>
                            <td class="text-muted" style="font-size:.78rem;">
                                @(!string.IsNullOrWhiteSpace(item.Rmc) ? item.Rmc : "—")
                            </td>
                            <td class="text-end fw-semibold">@item.Peso.ToString("N2")</td>
                            <td style="font-size:.78rem;">@item.Lote</td>
                            <td style="font-size:.78rem;" class="text-muted">@item.ColoSer</td>
                            <td class="text-center text-muted">
                                @(item.Fecha.HasValue ? item.Fecha.Value.ToString("dd/MM/yy") : "—")
                            </td>
                            <td class="text-center text-muted">
                                @(item.FchProgEnconado.HasValue ? item.FchProgEnconado.Value.ToString("dd/MM/yy") : "—")
                            </td>
                            <td class="text-center">
                                @if (item.FchEntrega.HasValue)
                                {
                                    <span class="fw-semibold @(item.EstaVencido ? "text-danger" : item.DiasRetraso >= -2 ? "text-warning" : "text-success")">
                                        @item.FchEntrega.Value.ToString("dd/MM/yy")
                                    </span>
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td class="text-center">
                                @if (item.EstaVencido)
                                {
                                    <span class="badge bg-danger">+@item.DiasRetraso d</span>
                                }
                                else if (item.DiasRetraso >= -2)
                                {
                                    <span class="badge bg-warning text-dark">@(-item.DiasRetraso) d</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@(-item.DiasRetraso) d</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>

@section Scripts {
<script>
(function () {
    var tbl = document.getElementById('tbl-enconado');
    if (!tbl) return;
    var tbody      = tbl.querySelector('tbody');
    var selEstado  = document.getElementById('filtro-estado-enc');
    var lblCount   = document.getElementById('enc-count-label');
    var selectedRmc = new Set(); // vacío = "Todos"

    var sortState = { col: 'fentrega', dir: 'asc' };

    function updateIcons() {
        tbl.querySelectorAll('.pend-th-sort').forEach(function (th) {
            var icon = th.querySelector('.sort-icon');
            if (!icon) return;
            icon.className = 'bi sort-icon ms-1 ' + (th.dataset.col === sortState.col
                ? (sortState.dir === 'asc' ? 'bi-sort-up' : 'bi-sort-down')
                : 'bi-arrow-down-up');
        });
    }

    function applyFilter() {
        var filtro = selEstado ? selEstado.value : '';
        var visible = 0;
        tbody.querySelectorAll('tr').forEach(function (r) {
            var show = (!filtro || r.dataset.estado === filtro) &&
                       (selectedRmc.size === 0 || selectedRmc.has(r.dataset.rmc || ''));
            r.style.display = show ? '' : 'none';
            if (show) visible++;
        });
        if (lblCount) {
            lblCount.textContent = filtro
                ? visible + ' de @lista.Count partida@(lista.Count == 1 ? "" : "s")'
                : '';
        }
        if (rmcCount) {
            rmcCount.textContent = selectedRmc.size === 0
                ? ''
                : visible + ' de @lista.Count partida@(lista.Count == 1 ? "" : "s")';
        }
    }

    function sortTable(col, dir) {
        var NODATE = '99999999';
        var rows = Array.from(tbody.querySelectorAll('tr'));
        rows.sort(function (a, b) {
            var va = a.dataset[col] || NODATE;
            var vb = b.dataset[col] || NODATE;
            // filas sin fecha siempre al final, independientemente de la dirección
            var aNoDate = va === NODATE;
            var bNoDate = vb === NODATE;
            if (aNoDate && bNoDate) return 0;
            if (aNoDate) return 1;
            if (bNoDate) return -1;
            if (va === vb) return 0;
            return dir === 'asc' ? (va < vb ? -1 : 1) : (va > vb ? -1 : 1);
        });
        rows.forEach(function (r) { tbody.appendChild(r); });
        sortState.col = col; sortState.dir = dir;
        updateIcons();
    }

    tbl.querySelectorAll('.pend-th-sort').forEach(function (th) {
        th.addEventListener('click', function () {
            var col = this.dataset.col;
            var dir = (sortState.col === col && sortState.dir === 'asc') ? 'desc' : 'asc';
            sortTable(col, dir);
        });
    });

    if (selEstado) selEstado.addEventListener('change', applyFilter);

    // ── Filtro de RMC multi-selección (client-side, sobre la data ya cargada) ──
    var btnRmc      = document.getElementById('btnFiltroRmc');
    var dropdownRmc = document.getElementById('dropdownRmc');
    var searchRmc   = document.getElementById('filtroRmcSearch');
    var checkListRmc= document.getElementById('rmcCheckList');
    var labelRmc    = document.getElementById('filtroRmcLabel');
    var rmcCount    = document.getElementById('filtroRmcCount');
    var btnRmcTodos = document.getElementById('filtroRmcTodos');
    var btnRmcLimpiar = document.getElementById('filtroRmcLimpiar');

    var rowsAll = Array.from(tbody.querySelectorAll('tr'));
    var valoresRmc = Array.from(new Set(rowsAll.map(function (r) { return r.dataset.rmc || ''; })))
        .filter(function (v) { return v.length > 0; })
        .sort(function (a, b) { return a.localeCompare(b); });

    function renderRmcCheckList(filter) {
        var q = (filter || '').trim().toLowerCase();
        var items = q.length === 0
            ? valoresRmc
            : valoresRmc.filter(function (v) { return v.toLowerCase().includes(q); });

        checkListRmc.innerHTML = items.map(function (v) {
            var isChecked = selectedRmc.has(v);
            return '<div class="rmc-item d-flex align-items-center px-2 py-2' + (isChecked ? ' rmc-item-selected' : '') + '" data-val="' + v.replace(/"/g, '&quot;') + '">' +
                   '<i class="bi ' + (isChecked ? 'bi-check-square-fill text-primary' : 'bi-square text-muted') + ' me-2"></i>' +
                   '<span class="small">' + v + '</span>' +
                   '</div>';
        }).join('') || '<div class="p-2 text-muted small">Sin coincidencias</div>';

        checkListRmc.querySelectorAll('.rmc-item').forEach(function (item) {
            item.addEventListener('click', function () {
                var v = item.dataset.val;
                if (selectedRmc.has(v)) selectedRmc.delete(v); else selectedRmc.add(v);
                renderRmcCheckList(searchRmc.value);
                updateRmcLabel();
                applyFilter();
            });
        });
    }

    function updateRmcLabel() {
        if (selectedRmc.size === 0) {
            labelRmc.textContent = 'Todos';
        } else if (selectedRmc.size === 1) {
            labelRmc.textContent = Array.from(selectedRmc)[0];
        } else {
            labelRmc.textContent = selectedRmc.size + ' seleccionados';
        }
    }

    function toggleRmcDropdown(show) {
        dropdownRmc.style.display = show ? 'block' : 'none';
        if (show) { renderRmcCheckList(searchRmc.value); searchRmc.focus(); }
    }

    if (btnRmc) {
        btnRmc.addEventListener('click', function (e) {
            e.preventDefault();
            toggleRmcDropdown(dropdownRmc.style.display !== 'block');
        });

        document.addEventListener('click', function (e) {
            if (!dropdownRmc.contains(e.target) && e.target !== btnRmc && !btnRmc.contains(e.target)) {
                toggleRmcDropdown(false);
            }
        });

        searchRmc.addEventListener('input', function () { renderRmcCheckList(searchRmc.value); });

        btnRmcTodos.addEventListener('click', function (e) {
            e.preventDefault();
            valoresRmc.forEach(function (v) { selectedRmc.add(v); });
            renderRmcCheckList(searchRmc.value);
            updateRmcLabel();
            applyFilter();
        });

        btnRmcLimpiar.addEventListener('click', function (e) {
            e.preventDefault();
            selectedRmc.clear();
            renderRmcCheckList(searchRmc.value);
            updateRmcLabel();
            applyFilter();
        });
    }

    // Orden inicial: F. Entrega ASC
    sortTable('fentrega', 'asc');
})();
</script>
<style>
    .rmc-item { cursor: pointer; user-select: none; }
    .rmc-item:hover { background: #f0f4ff; }
    .rmc-item-selected { background: #eaf1ff; }
</style>
}
