                                  @if (detTt!.ProgramasConera.Count > 0)
                                  {
                                    <div class="accordion-item tt-acc-item">
                                      <h2 class="accordion-header">
                                        <button class="accordion-button collapsed tt-acc-btn" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#acc-tt-@(subIdx)-con"
                                                aria-expanded="false">
                                          <span class="tt-sdot @(detTt.ProgramasConera.All(x => x.Estado == "3") ? "tt-sdot-ok" : "tt-sdot-run")"></span>
                                          <i class="bi bi-circle-half me-2"></i>Programa Conera
                                          <span class="tt-acc-preview">@detTt.ProgramasConera.Count programa@(detTt.ProgramasConera.Count != 1 ? "s" : "")</span>
                                        </button>
                                      </h2>
                                      <div id="acc-tt-@(subIdx)-con" class="accordion-collapse collapse">
                                        <div class="accordion-body p-2">
                                          @foreach (var pc in detTt.ProgramasConera)
                                          {
                                            <div class="p-0 mb-1" style="background:#f0f9ff;border-radius:6px;border:1px solid #bae6fd;">
                                              <div class="tt-data-grid">
                                                <div><span class="tt-lbl">F/Inicio en máq.</span><span class="tt-val tt-mono">@pc.FechaIni.ToString("dd/MM/yy HH:mm")</span></div>
