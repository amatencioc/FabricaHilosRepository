            @if (Model.ConsolidadoEventos.Count == 0)
            {
                <tr><td colspan="3" class="text-center text-muted">Sin eventos en el rango consultado</td></tr>
            }
            else
            {
                @foreach (var c in Model.ConsolidadoEventos)
                {
                    <tr>
                        <td class="fw-semibold">@c.TipoEvento</td>
