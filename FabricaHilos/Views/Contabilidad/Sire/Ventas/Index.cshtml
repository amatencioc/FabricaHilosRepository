                                    <td class="text-center"><span class="badge @r.ConcilBadge" style="font-size:.62rem;" title="@(r.FchConcil.HasValue ? $"{r.ConcilLabel} — {r.FchConcil:dd/MM HH:mm}" : r.ConcilDiffs ?? r.ConcilLabel)">@r.ConcilLabel</span></td>
