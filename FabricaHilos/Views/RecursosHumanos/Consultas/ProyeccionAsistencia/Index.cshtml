@{
    ViewData["Title"] = "Proyección de Asistencia — Aquarius";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="RecursosHumanos" asp-action="Index">Recursos Humanos</a></li>
    <li class="breadcrumb-item">Aquarius</li>
    <li class="breadcrumb-item active">Proyección de Asistencia</li>
}

@section Styles {
<style>
    :root {
        --aq:       #C0622B;
        --aq-dk:    #9E4D20;
        --aq-lt:    #FEF3EB;
        --aq-ok:    #4E7E58;
        --aq-ok-lt: #EAF4EC;
        --aq-warn:  #B8772C;
        --aq-wlt:   #FEF5E3;
        --aq-err:   #AE3F3C;
        --aq-elt:   #FDECEA;
        --aq-info:  #7A6E9E;
        --aq-ilt:   #F2EDF7;
    }

    .rh-header {
        background: linear-gradient(135deg, var(--aq) 0%, var(--aq-dk) 100%);
        color: #fff;
        border-radius: .5rem .5rem 0 0;
        padding: 1.1rem 1.4rem;
    }
    .rh-header h5 { margin: 0; font-weight: 600; letter-spacing: .3px; }
    .rh-header p  { margin: 0; opacity: .8; font-size: .82rem; }

    .search-bar { background: #f8f9fa; border-bottom: 1px solid #dee2e6; padding: .95rem 1.4rem; }
    .search-bar .form-control,
    .search-bar .form-select { border-radius: .4rem; }
    .search-bar .btn-search { border-radius: .4rem; background: var(--aq); border: none; color: #fff; min-width: 110px; }
    .search-bar .btn-search:hover { background: var(--aq-dk); }
    .form-control:focus, .form-select:focus {
        border-color: var(--aq);
        box-shadow: 0 0 0 .2rem rgba(192,98,43,.15);
    }

    .kpi-card {
        border-radius: .5rem;
        padding: 1rem 1.1rem;
        text-align: center;
        height: 100%;
    }
    .kpi-card .kpi-num  { font-size: 1.8rem; font-weight: 700; line-height: 1; }
    .kpi-card .kpi-lbl  { font-size: .78rem; text-transform: uppercase; letter-spacing: .4px; margin-top: .3rem; }
    .kpi-total     { background: #f8f9fa; color: #212529; }
    .kpi-trabajaria{ background: var(--aq-ok-lt); color: var(--aq-ok); }
    .kpi-descanso  { background: #e9ecef;         color: #6c757d; }
    .kpi-evento    { background: var(--aq-wlt);   color: var(--aq-warn); }
    .kpi-sinhorario{ background: var(--aq-elt);   color: var(--aq-err); }

    .badge-trabajaria { background: var(--aq-ok-lt); color: var(--aq-ok);  font-size: .78rem; }
    .badge-descanso   { background: #e9ecef;         color: #6c757d;      font-size: .78rem; }
    .badge-evento     { background: var(--aq-wlt);   color: var(--aq-warn); font-size: .78rem; }
    .badge-sinhorario { background: var(--aq-elt);   color: var(--aq-err); font-size: .78rem; }

    .empty-state { padding: 3rem 1rem; text-align: center; color: #adb5bd; }
    .empty-state i { font-size: 2.5rem; display: block; margin-bottom: .6rem; }

    .table-detalle { font-size: .78rem; margin-bottom: 0; table-layout: fixed; width: 100%; }
    .table-detalle thead th {
        background: var(--aq-lt);
        color: var(--aq-dk);
        white-space: nowrap;
        position: sticky;
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .3px;
        font-weight: 700;
        border-bottom: 2px solid var(--aq-mid);
        padding: .5rem .6rem;
        height: 2.05rem;
        box-sizing: border-box;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    /* thead tiene 2 filas (grupo "Horario Asignado"/"Horario Trabajado" + subcolumnas):
       cada fila necesita su propio offset "top", si no la 2da se superpone/tapa a la 1ra al hacer scroll. */
    .table-detalle thead tr:first-child th { top: 0; }
    .table-detalle thead tr:last-child th  { top: 2.05rem; }
    .table-detalle td { padding: .45rem .6rem; vertical-align: middle; overflow: hidden; }
    .table-detalle tbody tr:nth-child(even) { background: #fafbfc; }
    .table-detalle tbody tr:hover { background: var(--aq-lt); }
    .table-detalle-wrap { max-height: 420px; overflow: auto; border: 1px solid #eee; border-radius: .5rem; box-shadow: 0 1px 3px rgba(0,0,0,.04); }

    .table-detalle .celda-truncada {
        display: block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
    }
    /* Anchos via colgroup (no nth-child): el thead tiene 2 filas agrupando
       "Horario Asignado" (teórico) vs "Horario Trabajado" (real). */
    .table-detalle th.grupo { text-align: center; }
    .table-detalle thead tr:nth-child(2) th { font-size: .68rem; }

    /* Diferenciar visualmente el grupo "Horario Asignado" (teórico) del grupo
       "Horario Trabajado" (real, marcaciones) tanto en el encabezado como en las celdas. */
    .table-detalle th.grupo-asignado,
    .table-detalle td.col-asignado {
        background: var(--aq-lt);
        color: var(--aq-dk);
    }
    .table-detalle th.grupo-trabajado,
    .table-detalle td.col-trabajado {
        background: var(--aq-ilt);
        color: var(--aq-info);
    }
    .table-detalle tbody tr:nth-child(even) td.col-asignado  { background: #fdece0; }
    .table-detalle tbody tr:nth-child(even) td.col-trabajado { background: #ece6f5; }
    .table-detalle tbody tr:hover td.col-asignado  { background: var(--aq-lt); }
    .table-detalle tbody tr:hover td.col-trabajado { background: var(--aq-ilt); }

    .filtros-detalle { border: 1px solid #e3e7eb; border-radius: .5rem; background: #fbfcfd; padding: .75rem; }
    .filtro-seccion { border-left: 3px solid var(--aq); padding-left: .7rem; }
    .filtro-seccion.trabajado { border-left-color: var(--aq-info); }
    .filtro-seccion h6 { color: var(--aq-dk); font-size: .76rem; letter-spacing: .3px; margin: 0 0 .5rem; text-transform: uppercase; }
    .filtro-seccion.trabajado h6 { color: var(--aq-info); }
    .filtro-seccion .form-label { font-size: .72rem; margin-bottom: .2rem; }

    #spinnerCarga { display: none; }
</style>
}

<div class="card shadow-sm">
    <div class="rh-header">
        <h5><i class="bi bi-calendar-week me-2"></i>Proyección de Asistencia</h5>
        <p>¿Cuántos y qué empleados vendrían a trabajar en una fecha específica? — según su horario/turno vigente, descontando eventos activos (vacaciones, descanso médico, permisos, etc.)</p>
    </div>

    <div class="search-bar">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Fecha a consultar</label>
                <input type="date" id="txtFecha" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Empresa</label>
                <select id="selEmpresa" class="form-select form-select-sm" disabled>
                    <option value="0003" selected>0003 — La Colonial</option>
                </select>
            </div>
            <div class="col-md-2">
                <button id="btnConsultar" class="btn btn-search btn-sm w-100" onclick="consultar()">
                    <i class="bi bi-search me-1"></i>Consultar
                </button>
            </div>
            <div class="col-md-4 text-md-end">
                <div id="spinnerCarga" class="text-muted small">
                    <span class="spinner-border spinner-border-sm me-1"></span>Consultando…
                </div>
            </div>
        </div>
    </div>

    <div id="divEmptyState" class="empty-state">
        <i class="bi bi-calendar-check"></i>
        Seleccione una fecha y presione Consultar.
    </div>

    <div id="divMensaje" class="alert alert-danger m-4" style="display:none;"></div>

    <div id="divResultado" class="p-4" style="display:none;">

        <!-- KPIs resumen -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-2">
                <div class="kpi-card kpi-total">
                    <div class="kpi-num" id="kpiTotal">0</div>
                    <div class="kpi-lbl">Activos</div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="kpi-card kpi-trabajaria">
                    <div class="kpi-num" id="kpiTrabajaria">0</div>
                    <div class="kpi-lbl">Vendrían</div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="kpi-card kpi-descanso">
                    <div class="kpi-num" id="kpiDescanso">0</div>
                    <div class="kpi-lbl">Descanso</div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="kpi-card kpi-evento">
                    <div class="kpi-num" id="kpiEvento">0</div>
                    <div class="kpi-lbl">Con Evento</div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="kpi-card kpi-sinhorario">
                    <div class="kpi-num" id="kpiSinHorario">0</div>
                    <div class="kpi-lbl">Sin Horario</div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="kpi-card kpi-trabajaria">
                    <div class="kpi-num" id="kpiHorasTotal">0</div>
                    <div class="kpi-lbl">Horas a Trabajar</div>
                </div>
            </div>
        </div>

        <div class="filtros-detalle mb-3">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-xl-3 filtro-seccion">
                    <h6>Buscar</h6>
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label text-muted" for="txtFiltroDetalle">Empleado</label>
                            <input type="text" id="txtFiltroDetalle" class="form-control form-control-sm"
                                   placeholder="Buscar por nombre" onkeyup="renderDetalle()" />
                        </div>
                        <div class="col-12">
                            <label class="form-label text-muted" for="selFiltroEstado">Estado</label>
                            <select id="selFiltroEstado" class="form-select form-select-sm" onchange="renderDetalle()">
                                <option value="">Todos los estados</option>
                                <option value="TRABAJARIA">Vendrían</option>
                                <option value="DESCANSO">Descanso</option>
                                <option value="EVENTO">Con evento</option>
                                <option value="SIN_HORARIO">Sin horario</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-3 filtro-seccion">
                    <h6>Centro de Costo</h6>
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label text-muted" for="selFiltroGranCcosto">Gran Centro de Costo</label>
                            <select id="selFiltroGranCcosto" class="form-select form-select-sm" onchange="poblarFiltroCentroCosto(); renderDetalle()">
                                <option value="">Todos los grandes centros</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label text-muted" for="selFiltroCcosto">Centro de Costo</label>
                            <select id="selFiltroCcosto" class="form-select form-select-sm" onchange="renderDetalle()">
                                <option value="">Todos los centros de costo</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-4 filtro-seccion">
                    <h6>Horario Asignado</h6>
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label text-muted" for="selFiltroTurno">Turno y horario</label>
                            <select id="selFiltroTurno" class="form-select form-select-sm" onchange="renderDetalle()">
                                <option value="">Todos los turnos y horarios</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label text-muted" for="txtHoraDesde">Ingreso desde</label>
                            <input type="time" id="txtHoraDesde" class="form-control form-control-sm" onchange="renderDetalle()" />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-muted" for="txtHoraHasta">Ingreso hasta</label>
                            <input type="time" id="txtHoraHasta" class="form-control form-control-sm" onchange="renderDetalle()" />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-muted" for="txtHorasDesde">Horas programadas desde</label>
                            <input type="number" step="0.25" min="0" id="txtHorasDesde" class="form-control form-control-sm" onchange="renderDetalle()" />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-muted" for="txtHorasHasta">Horas programadas hasta</label>
                            <input type="number" step="0.25" min="0" id="txtHorasHasta" class="form-control form-control-sm" onchange="renderDetalle()" />
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-4 filtro-seccion trabajado">
                    <h6>Horario Trabajado</h6>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label text-muted" for="txtHorasRealDesde">Horas trabajadas desde</label>
                            <input type="number" step="0.25" min="0" id="txtHorasRealDesde" class="form-control form-control-sm" onchange="renderDetalle()" />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-muted" for="txtHorasRealHasta">Horas trabajadas hasta</label>
                            <input type="number" step="0.25" min="0" id="txtHorasRealHasta" class="form-control form-control-sm" onchange="renderDetalle()" />
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-1 d-flex align-items-end">
                    <button type="button" id="btnLimpiarHorario" class="btn btn-sm btn-outline-secondary w-100" onclick="limpiarFiltroHorario()" title="Limpiar todos los filtros">
                        <i class="bi bi-x-circle me-1"></i>Limpiar
                    </button>
                </div>
            </div>
        </div>
        <div class="alert alert-light border small py-2 px-3 mb-3" role="note">
            <i class="bi bi-info-circle me-1"></i>
            <strong>Horario asignado:</strong> turno planificado y horas programadas. <strong>Horario trabajado:</strong> marcaciones reales y horas entre entrada y salida. Este último solo está disponible para fechas ya transcurridas.
        </div>

        <div class="table-detalle-wrap">
            <table class="table table-sm table-hover table-detalle mb-0">
                <colgroup>
                    <col style="width:19%"> <!-- Nombre -->
                    <col style="width:8%">  <!-- Gran C. Costo -->
                    <col style="width:8%">  <!-- Centro de Costo -->
                    <col style="width:9%">  <!-- Encargado -->
                    <col style="width:10%"> <!-- Turno - Horario -->
                    <col style="width:5%">  <!-- Ingreso asignado -->
                    <col style="width:5%">  <!-- Salida asignado -->
                    <col style="width:5%">  <!-- Horas asignadas (teórico) -->
                    <col style="width:5%">  <!-- Entrada real -->
                    <col style="width:5%">  <!-- Salida real -->
                    <col style="width:5%">  <!-- Horas trabajadas (real) -->
                    <col style="width:5%">  <!-- Estado -->
                    <col style="width:8%">  <!-- Detalle Evento -->
                    <col style="width:4%">  <!-- Feriado -->
                </colgroup>
                <thead>
                    <tr>
                        <th rowspan="2">Nombre</th>
                        <th rowspan="2">Gran C. Costo</th>
                        <th rowspan="2">Centro de Costo</th>
                        <th rowspan="2">Encargado</th>
                        <th rowspan="2">Turno - Horario</th>
                        <th  class="grupo grupo-asignado" colspan="3" title="Lo planificado según el horario/turno asignado">Horario Asignado</th>
                        <th  class="grupo grupo-trabajado" colspan="3" title="Lo realmente marcado ese día (solo fechas pasadas)">Horario Trabajado</th>
                        <th rowspan="2">Estado</th>
                        <th rowspan="2">Detalle Evento</th>
                        <th rowspan="2">Feriado</th>
                    </tr>
                    <tr>
                        <th class="grupo-asignado">Ingreso</th><th class="grupo-asignado">Salida</th><th class="grupo-asignado">Horas</th>
                        <th class="grupo-trabajado">Entrada</th><th class="grupo-trabajado">Salida</th><th class="grupo-trabajado">Horas</th>
                    </tr>
                </thead>
                <tbody id="tbodyDetalle"></tbody>
            </table>
        </div>
        <div id="divSinResultadosDetalle" class="text-center text-muted small py-3" style="display:none;">
            No hay empleados que coincidan con el filtro.
        </div>
    </div>
</div>

@section Scripts {
<script>
    let _detalleActual = [];

    // Fecha por defecto: mañana
    (function initFecha() {
        const manana = new Date();
        manana.setDate(manana.getDate() + 1);
        const iso = manana.toISOString().split('T')[0];
        document.getElementById('txtFecha').value = iso;
    })();

    function escapeHtml(v) {
        if (v === null || v === undefined) return '';
        return String(v)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    // Genera una celda con texto truncado (ellipsis) y tooltip con el texto completo cuando se corta.
    function celdaTruncada(valor) {
        const texto = (valor === null || valor === undefined) ? '' : String(valor);
        if (!texto) return '';
        const seguro = escapeHtml(texto);
        return `<span class="celda-truncada" data-bs-toggle="tooltip" data-bs-placement="top" title="${seguro}">${seguro}</span>`;
    }

    function badgeEstado(estado) {
        switch (estado) {
            case 'TRABAJARIA':  return '<span class="badge badge-trabajaria">Vendría</span>';
            case 'DESCANSO':    return '<span class="badge badge-descanso">Descanso</span>';
            case 'EVENTO':      return '<span class="badge badge-evento">Evento</span>';
            case 'SIN_HORARIO': return '<span class="badge badge-sinhorario">Sin Horario</span>';
            default:            return '<span class="badge bg-secondary">' + escapeHtml(estado) + '</span>';
        }
    }

    async function consultar() {
        const fecha   = document.getElementById('txtFecha').value;
        const empresa = document.getElementById('selEmpresa').value;

        if (!fecha) {
            alert('Seleccione una fecha.');
            return;
        }

        document.getElementById('divMensaje').style.display   = 'none';
        document.getElementById('divResultado').style.display  = 'none';
        document.getElementById('divEmptyState').style.display = 'none';
        document.getElementById('spinnerCarga').style.display  = 'inline-block';
        document.getElementById('btnConsultar').disabled = true;

        try {
            const resp = await fetch(`/RecursosHumanos/ProyeccionAsistencia/Consultar?fecha=${encodeURIComponent(fecha)}&empresa=${encodeURIComponent(empresa)}`);
            const json = await resp.json();

            if (!json.ok) {
                document.getElementById('divMensaje').textContent = json.mensaje || 'No se pudo consultar la proyección.';
                document.getElementById('divMensaje').style.display = 'block';
                return;
            }

            renderResumen(json.resumen || []);
            _detalleActual = json.detalle || [];
            // Se preservan los filtros ya seleccionados por el usuario entre consultas
            // (por ejemplo, al cambiar solo la fecha o la empresa). poblarFiltroTurno()
            // ya conserva la opci\u00f3n de turno/horario elegida si sigue existiendo en la nueva data.
            poblarFiltroTurno();
            poblarFiltroGranCcosto();
            poblarFiltroCentroCosto();
            renderDetalle();

            document.getElementById('divResultado').style.display = 'block';
        } catch (err) {
            document.getElementById('divMensaje').textContent = 'Error de conexión al consultar la proyección.';
            document.getElementById('divMensaje').style.display = 'block';
        } finally {
            document.getElementById('spinnerCarga').style.display = 'none';
            document.getElementById('btnConsultar').disabled = false;
        }
    }

    function renderResumen(resumen) {
        const cant = { TRABAJARIA: 0, DESCANSO: 0, EVENTO: 0, SIN_HORARIO: 0 };
        resumen.forEach(r => { if (r.estado in cant) cant[r.estado] = r.cantidad; });

        const total = cant.TRABAJARIA + cant.DESCANSO + cant.EVENTO + cant.SIN_HORARIO;

        document.getElementById('kpiTotal').textContent      = total;
        document.getElementById('kpiTrabajaria').textContent = cant.TRABAJARIA;
        document.getElementById('kpiDescanso').textContent   = cant.DESCANSO;
        document.getElementById('kpiEvento').textContent     = cant.EVENTO;
        document.getElementById('kpiSinHorario').textContent = cant.SIN_HORARIO;
    }

    // Suma HorasTrabajoNum solo de quienes SÍ vendrían a trabajar (TRABAJARIA).
    function sumaHorasTrabajo(filas) {
        return filas.reduce((acc, e) => acc + (e.estado === 'TRABAJARIA' ? (Number(e.horasTrabajoNum) || 0) : 0), 0);
    }

    function poblarFiltroTurno() {
        const sel = document.getElementById('selFiltroTurno');
        const valorActual = sel.value;

        const combos = new Map();
        _detalleActual.forEach(e => {
            const horario = e.horarioDescripcion || '(Sin horario)';
            const turno   = e.turno || '(Sin turno)';
            const clave   = horario + '||' + turno;
            if (!combos.has(clave)) combos.set(clave, { horario, turno, clave });
        });

        const lista = Array.from(combos.values()).sort((a, b) => {
            const cmp = a.horario.localeCompare(b.horario);
            return cmp !== 0 ? cmp : a.turno.localeCompare(b.turno);
        });

        sel.innerHTML = '<option value="">Todos los horarios/turnos</option>';
        lista.forEach(c => {
            const opt = document.createElement('option');
            opt.value = c.clave;
            opt.textContent = c.horario + ' — ' + c.turno;
            sel.appendChild(opt);
        });

        if (lista.some(c => c.clave === valorActual)) sel.value = valorActual;
    }

    function poblarFiltroGranCcosto() {
        const sel = document.getElementById('selFiltroGranCcosto');
        const valorActual = sel.value;
        const centros = new Map();

        _detalleActual.forEach(e => {
            const codigo = e.granCcosto || '';
            const nombre = e.granCcostoNombre || '(Sin gran centro)';
            if (!centros.has(codigo)) centros.set(codigo, { codigo, nombre });
        });

        sel.innerHTML = '<option value="">Todos los grandes centros</option>';
        Array.from(centros.values()).sort((a, b) => a.nombre.localeCompare(b.nombre)).forEach(c => {
            const opt = document.createElement('option');
            opt.value = c.codigo;
            opt.textContent = c.nombre;
            sel.appendChild(opt);
        });

        if (centros.has(valorActual)) sel.value = valorActual;
    }

    function poblarFiltroCentroCosto() {
        const selGran = document.getElementById('selFiltroGranCcosto');
        const sel = document.getElementById('selFiltroCcosto');
        const granSeleccionado = selGran.value;
        const valorActual = sel.value;
        const centros = new Map();

        _detalleActual
            .filter(e => !granSeleccionado || (e.granCcosto || '') === granSeleccionado)
            .forEach(e => {
                const codigo = e.ccosto || '';
                const nombre = e.ccostoNombre || '(Sin centro de costo)';
                if (!centros.has(codigo)) centros.set(codigo, { codigo, nombre });
            });

        sel.innerHTML = '<option value="">Todos los centros de costo</option>';
        Array.from(centros.values()).sort((a, b) => a.nombre.localeCompare(b.nombre)).forEach(c => {
            const opt = document.createElement('option');
            opt.value = c.codigo;
            opt.textContent = c.nombre;
            sel.appendChild(opt);
        });

        if (centros.has(valorActual)) sel.value = valorActual;
    }

    function limpiarFiltroHorario() {
        document.getElementById('txtFiltroDetalle').value = '';
        document.getElementById('selFiltroEstado').value = '';
        document.getElementById('selFiltroTurno').value = '';
        document.getElementById('selFiltroGranCcosto').value = '';
        poblarFiltroCentroCosto();
        document.getElementById('selFiltroCcosto').value = '';
        document.getElementById('txtHoraDesde').value = '';
        document.getElementById('txtHoraHasta').value = '';
        document.getElementById('txtHorasDesde').value = '';
        document.getElementById('txtHorasHasta').value = '';
        document.getElementById('txtHorasRealDesde').value = '';
        document.getElementById('txtHorasRealHasta').value = '';
        renderDetalle();
    }

    // Convierte "HH:mm" o "HH:mm:ss" a minutos desde medianoche. Retorna null si no es válido.
    function horaAMinutos(hora) {
        if (!hora) return null;
        const partes = String(hora).split(':');
        if (partes.length < 2) return null;
        const h = parseInt(partes[0], 10);
        const m = parseInt(partes[1], 10);
        if (isNaN(h) || isNaN(m)) return null;
        return (h * 60) + m;
    }

    // Verifica si la hora de ingreso del empleado cae dentro del rango [desde, hasta].
    // Soporta rangos que cruzan la medianoche (ej. turnos de madrugada, hasta < desde).
    function horarioEnRango(horaIngreso, desde, hasta) {
        const minIngreso = horaAMinutos(horaIngreso);
        const minDesde    = horaAMinutos(desde);
        const minHasta    = horaAMinutos(hasta);

        if (minDesde === null && minHasta === null) return true;
        if (minIngreso === null) return false;

        if (minDesde !== null && minHasta !== null) {
            if (minHasta < minDesde) {
                // Rango cruza medianoche, ej. 19:00 - 03:00
                return minIngreso >= minDesde || minIngreso <= minHasta;
            }
            return minIngreso >= minDesde && minIngreso <= minHasta;
        }
        if (minDesde !== null) return minIngreso >= minDesde;
        return minIngreso <= minHasta;
    }

    // Convierte un texto "HH:MM" (u "HH:MM:SS") de horas trabajadas/programadas en horas decimales
    // (ej. "09:18" -> 9.3). Se usa para filtrar exactamente por el mismo valor que se muestra en la
    // tabla, en vez del campo numérico que devuelve el backend (que puede quedar desincronizado del texto).
    function horasTextoADecimal(texto) {
        if (!texto) return null;
        const partes = String(texto).split(':');
        if (partes.length < 2) return null;
        const h = parseInt(partes[0], 10);
        const m = parseInt(partes[1], 10);
        if (isNaN(h) || isNaN(m)) return null;
        return h + (m / 60);
    }

    function renderDetalle() {
        const filtroTexto  = (document.getElementById('txtFiltroDetalle').value || '').trim().toUpperCase();
        const filtroEstado = document.getElementById('selFiltroEstado').value;
        const filtroTurno  = document.getElementById('selFiltroTurno').value;
        const filtroGranCcosto = document.getElementById('selFiltroGranCcosto').value;
        const filtroCcosto = document.getElementById('selFiltroCcosto').value;
        const horaDesde    = document.getElementById('txtHoraDesde').value;
        const horaHasta    = document.getElementById('txtHoraHasta').value;
        const horasDesde   = document.getElementById('txtHorasDesde').value;
        const horasHasta   = document.getElementById('txtHorasHasta').value;
        const horasRealDesde = document.getElementById('txtHorasRealDesde').value;
        const horasRealHasta = document.getElementById('txtHorasRealHasta').value;

        const filas = _detalleActual.filter(e => {
            if (filtroEstado && e.estado !== filtroEstado) return false;
            if (filtroTurno) {
                const clave = (e.horarioDescripcion || '(Sin horario)') + '||' + (e.turno || '(Sin turno)');
                if (clave !== filtroTurno) return false;
            }
            if (filtroGranCcosto && (e.granCcosto || '') !== filtroGranCcosto) return false;
            if (filtroCcosto && (e.ccosto || '') !== filtroCcosto) return false;
            if (filtroTexto) {
                const hay = (e.nombreCompleto || '').toUpperCase();
                if (!hay.includes(filtroTexto)) return false;
            }
            if ((horaDesde || horaHasta) && !horarioEnRango(e.horaIngresoTeorica, horaDesde, horaHasta)) return false;
            const horasProgramadas = horasTextoADecimal(e.horasTrabajo);
            if (horasDesde !== '' && (horasProgramadas === null || horasProgramadas < Number(horasDesde))) return false;
            if (horasHasta !== '' && (horasProgramadas === null || horasProgramadas > Number(horasHasta))) return false;
            const horasReales = horasTextoADecimal(e.horasTrabajadasReal);
            if (horasRealDesde !== '' && (horasReales === null || horasReales < Number(horasRealDesde))) return false;
            if (horasRealHasta !== '' && (horasReales === null || horasReales > Number(horasRealHasta))) return false;
            return true;
        });

        const tbody = document.getElementById('tbodyDetalle');
        tbody.innerHTML = '';

        document.getElementById('divSinResultadosDetalle').style.display = filas.length === 0 ? 'block' : 'none';

        const cant = { TRABAJARIA: 0, DESCANSO: 0, EVENTO: 0, SIN_HORARIO: 0 };

        filas.forEach(e => {
            if (e.estado in cant) cant[e.estado]++;

            const turnoHorario = `${e.turno || ''} - ${e.horarioDescripcion || ''}`;

            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>${celdaTruncada(e.nombreCompleto)}</td>
                <td>${celdaTruncada(e.granCcostoNombre)}</td>
                <td>${celdaTruncada(e.ccostoNombre)}</td>
                <td>${celdaTruncada(e.encargadoNombre)}</td>
                <td>${celdaTruncada(turnoHorario)}</td>
                <td class="col-asignado">${escapeHtml(e.horaIngresoTeorica)}</td>
                <td class="col-asignado">${escapeHtml(e.horaSalidaTeorica)}</td>
                <td class="col-asignado">${escapeHtml(e.horasTrabajo)}</td>
                <td class="col-trabajado">${e.horaIngresoReal ? escapeHtml(e.horaIngresoReal) : '<span class="text-muted">—</span>'}</td>
                <td class="col-trabajado">${e.horaSalidaReal ? escapeHtml(e.horaSalidaReal) : '<span class="text-muted">—</span>'}</td>
                <td class="col-trabajado">${e.horasTrabajadasReal ? escapeHtml(e.horasTrabajadasReal) : '<span class="text-muted">—</span>'}</td>
                <td>${badgeEstado(e.estado)}</td>
                <td>${celdaTruncada(e.eventoDescripcion)}</td>
                <td>${e.feriado === 'F' ? '<span class="badge bg-info-subtle text-info">Feriado</span>' : ''}</td>
            `;
            tbody.appendChild(tr);
        });

        tbody.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => {
            bootstrap.Tooltip.getOrCreateInstance(el);
        });

        const totalFiltrado = cant.TRABAJARIA + cant.DESCANSO + cant.EVENTO + cant.SIN_HORARIO;
        document.getElementById('kpiTotal').textContent      = totalFiltrado;
        document.getElementById('kpiTrabajaria').textContent = cant.TRABAJARIA;
        document.getElementById('kpiDescanso').textContent   = cant.DESCANSO;
        document.getElementById('kpiEvento').textContent     = cant.EVENTO;
        document.getElementById('kpiSinHorario').textContent = cant.SIN_HORARIO;
        document.getElementById('kpiHorasTotal').textContent = sumaHorasTrabajo(filas).toLocaleString('es-PE', { maximumFractionDigits: 2 });
    }
</script>
}
