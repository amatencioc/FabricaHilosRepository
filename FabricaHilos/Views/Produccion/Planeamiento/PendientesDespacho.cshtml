@model IEnumerable<FabricaHilos.Models.Produccion.Planeamiento.PlnPendienteDespacho>
@{
    ViewData["Title"] = "Pendientes de Despacho";
    var lista = Model.ToList();
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0"><i class="bi bi-truck me-2 text-primary"></i>Pendientes de Despacho</h4>
            <small class="text-muted">V_PLN_PENDIENTES_DESP &mdash; ítems en almacén PT listos para despachar</small>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-danger fs-6">@lista.Count(x => x.EsUrgente) urgentes</span>
            <span class="badge bg-secondary fs-6">@lista.Count total</span>
            <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Dashboard
            </a>
        </div>
    </div>

    @if (!lista.Any())
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i>No hay ítems pendientes de despacho en este momento.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Pedido</th>
                                <th>Ítem</th>
                                <th>Cliente</th>
                                <th>Artículo</th>
                                <th class="text-center">Kg Pend.</th>
                                <th class="text-center">Stock Disp.</th>
                                <th class="text-center">Kg a Desp.</th>
                                <th class="text-center">F. Entrega</th>
                                <th class="text-center">Días Venc.</th>
                                <th class="text-center">Paso</th>
                                <th class="text-center">Prioridad</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in lista)
                            {
                                <tr class="@(item.EsUrgente ? "table-warning" : "")">
                                    <td>
                                        <a asp-action="Pedido"
                                           asp-route-numPed="@item.NumPed"
                                           asp-route-serie="0"
                                           class="fw-bold text-decoration-none">
                                            @item.NumPed
                                        </a>
                                    </td>
                                    <td class="text-center">@item.Nro</td>
                                    <td>
                                        @if (item.EsUrgente)
                                        {
                                            <i class="bi bi-exclamation-triangle-fill text-danger me-1"
                                               title="Urgente"></i>
                                        }
                                        <span title="@item.CodCliente">@item.NomCliente</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@item.CodArt</div>
                                        <small class="text-muted">@item.Color &mdash; @item.Titulo</small>
                                    </td>
                                    <td class="text-end">@item.KgPendientes.ToString("N2")</td>
                                    <td class="text-end">@item.StockDisponible.ToString("N2")</td>
                                    <td class="text-end fw-bold">@item.KgADespachar.ToString("N2")</td>
                                    <td class="text-center">
                                        @if (item.FchEntregaComp.HasValue)
                                        {
                                            <span class="text-@item.SemaforoCss">
                                                @item.FchEntregaComp.Value.ToString("dd/MM/yyyy")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.DiasVencido > 0)
                                        {
                                            <span class="badge bg-@item.SemaforoCss">+@item.DiasVencido d</span>
                                        }
                                        else if (item.DiasVencido < 0)
                                        {
                                            <span class="badge bg-success">@item.DiasVencido d</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Hoy</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary">@item.NombrePaso</span>
                                    </td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(item.PrioridadPedido))
                                        {
                                            <span class="badge bg-info text-dark">@item.PrioridadPedido</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer text-muted small">
                Total kg pendientes: <strong>@lista.Sum(x => x.KgPendientes).ToString("N2")</strong> &nbsp;|&nbsp;
                Total kg a despachar: <strong>@lista.Sum(x => x.KgADespachar).ToString("N2")</strong>
            </div>
        </div>
    }
</div>
