// frozen-panel usa overflow-y:scroll (scrollbar invisible) para que scrollTop
// funcione desde JS. Si el usuario scrollea en el panel fijo (trackpad/rueda),
// se redirige al panel derecho para mantenerlos siempre sincronizados.
var scrollPanel = document.querySelector('.spt-scroll-panel');
var frozenPanel = document.querySelector('.spt-frozen-panel');
if (scrollPanel && frozenPanel) {
    var _syncR = false, _syncL = false;
    scrollPanel.addEventListener('scroll', function() {
        if (_syncR) return;
        _syncL = true;
        frozenPanel.scrollTop = this.scrollTop;
        _syncL = false;
    });
    frozenPanel.addEventListener('scroll', function() {
        if (_syncL) return;
        _syncR = true;
        scrollPanel.scrollTop = this.scrollTop;
        _syncR = false;
    });
}

// ── Exportar Excel ──────────────────────────────────────────────────────────
var btnExportXlsx = document.getElementById('btnExportXlsx');
if(btnExportXlsx) btnExportXlsx.addEventListener('click', function(){
    if(!filtered || !filtered.length){ showToast('No hay registros filtrados para exportar.','#6c757d'); return; }

    // Sincronizar valores actuales de los textarea "Area Resp." del DOM antes de exportar.
    // Garantiza que ediciones en curso (pagina actual) se reflejen aunque el evento
    // input no haya propagado aun (p.ej. foco activo al momento de hacer clic en Exportar).
    if(tbody){
        tbody.querySelectorAll('.area-input').forEach(function(ta){
            var idx = parseInt(ta.dataset.idx);
            if(!isNaN(idx) && idx >= 0 && idx < filtered.length){
                filtered[idx]._area = ta.value;
            }
        });
    }

    var headers = [
        'Mes','Mes.Tex','Año','Sem','Partida','Cliente','Material','Est',
        'Lote','F.Pedido',
        'Estima.Rod','Entreg.Rod','D.Rod',
        'Estima.Mat','Entreg.Mat','D.MH',
        'Estima.Rec','Entreg.Rec','D.Rec',
        'F.Prog','F.Guia','Maq',
        'Est.Ten','Entr.Ten','D.Tenido','Time.Aprov',
        'Tipo.Acab',
        'F.Sec.Rod','F.Sec.Mad',
        'CC.Aprobado',
        'F.Revisado','Ev.Encon','Calif.','Acabado','F.Enconado',
        'F.Entrega','Ing.AlmPT','Dias.Esp',
        'KG.Pedido','KG.Prog','KG.Despa','GAP','%Tol',
        'Est.Flujo','Est.Desp',
        'Área Resp.'
    ];
    var rows = filtered.map(function(r){
        return [
            r.mes, r.mesTex, r.ano, r.sem, r.partida, r.cliente, r.material, r.est,
            r.lote, r.fchPedido,
            r.estimaRod, r.entregRod, r.diasRod    != null ? +r.diasRod    : null,
            r.estimaMat, r.entregMat, r.diasMh     != null ? +r.diasMh     : null,
            r.estimaRec, r.entregRec, r.diasRec    != null ? +r.diasRec    : null,
            r.fchProg, r.fchaGuia, r.maqTen,
            r.estimaTen, r.entregTen,
            r.diasT     != null ? +r.diasT     : null,
            r.timeAprov != null ? +r.timeAprov : null,
            r.tipoAc,
            r.fchSecRod, r.fchSecMad,
            r.fchAprobCal,
            r.fchRev, r.evEncon, r.calificacion, r.acabado, r.fchEncon,
            r.fchEntrega, r.ingAlmpt, r.diasEsp != null ? +r.diasEsp : null,
            r.kgPedido != null ? +r.kgPedido : null,
            r.kgProg   != null ? +r.kgProg   : null,
            r.kgDespa  != null ? +r.kgDespa  : null,
            r.gap      != null ? +r.gap      : null,
            r.pctTol   != null ? +r.pctTol   : null,
            r.estFlujo, r.estDesp,
            // _area refleja ediciones vivas; != null respeta strings vacios deliberados
            r._area != null ? r._area : (r.area || '')
        ];
    });
    var wsData = [headers].concat(rows);
    if(typeof XLSX === 'undefined'){ showToast('Cargando librería, intente en un momento…','#6c757d'); return; }
    var wb = XLSX.utils.book_new();
    var ws = XLSX.utils.aoa_to_sheet(wsData);
    ws['!cols'] = headers.map(function(h){ return { wch: Math.max(h.length + 2, 12) }; });
    XLSX.utils.book_append_sheet(wb, ws, 'SeguimientoTT');
    var now = new Date();
    var ts  = now.getFullYear()+''+String(now.getMonth()+1).padStart(2,'0')+''+String(now.getDate()).padStart(2,'0');
    XLSX.writeFile(wb, 'SeguimientoTT_' + ts + '.xlsx');
    showToast('Exportando ' + filtered.length + ' registros filtrados…', '#1d6f3b');
});

// ── Año default 2026 ──────────────────────────────────────────────────────────
