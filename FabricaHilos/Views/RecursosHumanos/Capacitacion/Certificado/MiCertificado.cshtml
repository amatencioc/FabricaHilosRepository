@model FabricaHilos.Models.Capacitacion.CapCertificado
@{
    ViewData["Title"] = "Mi Certificado";
}

@section Styles {
<style>
/* ── LMS · Certificado ─────────────────────────── */
body { background:#f0f4f8; }
.cert-wrapper { background:#fffdf0; border:2px solid #c9a227; border-radius:12px; padding:3rem;
                max-width:700px; margin:2rem auto; text-align:center; position:relative; }
.cert-wrapper::before { content:''; position:absolute; inset:10px; border:1px solid #e8c85a;
                        border-radius:8px; pointer-events:none; }
.cert-title { font-size:2rem; color:#8B6914; font-weight:700; letter-spacing:.05em; }
.cert-name  { font-size:2.2rem; color:#1a1a1a; font-weight:700; border-bottom:2px solid #c9a227; display:inline-block; padding-bottom:.25rem; }
.cert-course { font-size:1.4rem; color:#1d4ed8; font-style:italic; }
.cert-seal { color:#c9a227; font-size:3rem; }
.cert-footer { font-size:.8rem; color:#999; }
.lms-btn { display:inline-flex; align-items:center; gap:.35rem; border-radius:7px; padding:.42rem 1rem; font-size:.84rem; font-weight:500; text-decoration:none; transition:all .12s; cursor:pointer; border:none; }
.lms-btn-primary { background:#1d4ed8; color:#fff; }
.lms-btn-primary:hover { background:#1e40af; color:#fff; }
.lms-btn-outline { background:#fff; border:1px solid #dde3ec !important; color:#334155; }
.lms-btn-outline:hover { background:#f8fafc; border-color:#94a3b8 !important; color:#0f172a; }
</style>
}

<!-- Acciones -->
<div class="d-flex gap-2 justify-content-center mb-4">
    <a asp-controller="Certificado" asp-action="Descargar" asp-route-id="@Model.IdCertificado"
       class="lms-btn lms-btn-primary">
        <i class="bi bi-download"></i> Descargar PDF
    </a>
    <a asp-controller="Capacitacion" asp-action="MiPanel" class="lms-btn lms-btn-outline">
        <i class="bi bi-arrow-left"></i> Mi Panel
    </a>
</div>

<!-- Vista previa del certificado -->
<div class="cert-wrapper" id="certPreview">
    <div class="cert-seal mb-3">
        <i class="bi bi-patch-check-fill"></i>
    </div>

    <div class="cert-title mb-1">CERTIFICADO DE CAPACITACIÓN</div>
    <div class="text-muted small mb-4">Otorgado por La Colonial S.A.</div>

    <p class="text-muted mb-1">Se certifica que:</p>
    <div class="cert-name mb-3">@Model.NombreUsuario</div>

    <p class="text-muted mb-1">ha completado satisfactoriamente el curso:</p>
    <div class="cert-course mb-4">"@Model.TituloCurso"</div>

    <div class="d-flex justify-content-center gap-5 mb-4">
        <div>
            <div class="fw-bold fs-4" style="color:#0f766e">@Model.PuntajeObt.ToString("F1")</div>
            <div class="text-muted small">Nota obtenida</div>
        </div>
        <div>
            <div class="fw-bold fs-4 text-muted">@Model.FchEmision.ToString("dd/MM/yyyy")</div>
            <div class="text-muted small">Fecha de emisión</div>
        </div>
        @if (Model.FchVencimiento.HasValue)
        {
            <div>
                <div class="fw-bold fs-4" style="color:@(Model.EsVigente ? "#0f766e" : "#9f1239")">
                    @Model.FchVencimiento.Value.ToString("dd/MM/yyyy")
                </div>
                <div class="text-muted small">Vence el</div>
            </div>
        }
    </div>

    @if (!Model.EsVigente)
    {
        <div style="background:#fff7ed;border:1px solid #fde68a;border-radius:8px;padding:.75rem 1rem;font-size:.84rem;color:#92400e;margin-bottom:.75rem">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Este certificado está @(Model.Estado == "R" ? "renovado" : "vencido").
        </div>
    }

    <div class="cert-footer">
        <i class="bi bi-shield-check me-1"></i>
        Código de verificación: <strong>@Model.CodigoVerif</strong>
        <br>
        <a asp-controller="Certificado" asp-action="Verificar"
           asp-route-c="@Model.CodigoVerif"
           target="_blank" class="text-muted">Verificar en línea →</a>
    </div>
</div>
