@model FabricaHilos.Controllers.Contabilidad.SireRegistrosViewModel
@using FabricaHilos.Sire.Models
@{
    ViewData["Title"] = "SIRE - RVIE (Registro de Ventas)";

    var periodos = Model?.Periodos ?? Array.Empty<PropuestaDto>();
    var periodoSeleccionado = Model?.PeriodoSeleccionado ?? string.Empty;
    var registros = Model?.RegistrosVentas ?? Array.Empty<RegistroVenta>();
    var esMock = Model?.EsMock ?? false;

    var yyyyMm = periodoSeleccionado.Length == 6 
        ? $"{periodoSeleccionado[..4]}/{periodoSeleccionado[4..]}" 
        : periodoSeleccionado;

    decimal totalBase = registros.Sum(r => r.BaseImponibleGravada);
    decimal totalIgv = registros.Sum(r => r.Igv);
    decimal totalMonto = registros.Sum(r => r.ImporteTotal);

    static (string Desc, string Css) TipoComprobante(string cod) => cod switch
    {
        "01" => ("Factura", "bg-primary"),
        "03" => ("Boleta", "bg-info text-dark"),
        "07" => ("Nota de Crédito", "bg-warning text-dark"),
        "08" => ("Nota de Débito", "bg-orange text-dark"),
        "09" => ("Guía Remisión", "bg-secondary"),
        "20" => ("Ret. 2da Cat.", "bg-secondary"),
        _ => (cod, "bg-secondary")
    };
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Contabilidad" asp-action="Index">Contabilidad</a></li>
    <li class="breadcrumb-item"><a asp-controller="Sire" asp-action="Index">SIRE</a></li>
    <li class="breadcrumb-item active">RVIE - Ventas</li>
}

@section Styles {
<link rel="stylesheet" href="~/css/sire.css" asp-append-version="true" />
}

@if (esMock)
{
    <div class="sire-alert sire-alert-mock" role="alert">
        <i class="bi bi-cone-striped"></i>
        <div><strong>MODO MOCK ACTIVO</strong> — Los datos mostrados son de prueba. No se realizan llamadas reales a SUNAT.</div>
    </div>
}
@if (TempData["Error"] is string err)
{
    <div class="sire-alert sire-alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i><div>@err</div>
    </div>
}
@if (TempData["Success"] is string ok)
{
    <div class="sire-alert sire-alert-success" role="alert">
        <i class="bi bi-check-circle-fill"></i><div>@ok</div>
    </div>
}

@await Html.PartialAsync("~/Views/Contabilidad/Sire/_SireNavBar.cshtml")

<div class="sire-strip">
    <i class="bi bi-receipt-cutoff" style="color:#90cdf4;font-size:.95rem;flex-shrink:0;"></i>
    <span class="sire-strip-title">RVIE — Registro de Ventas e Ingresos</span>
    @if (!string.IsNullOrWhiteSpace(periodoSeleccionado))
    {
        <span class="sire-strip-sep"></span>
        <span class="sire-kpi"><i class="bi bi-calendar3"></i><span class="sire-kpi-val">@yyyyMm</span></span>
        <span class="sire-kpi"><i class="bi bi-file-earmark-text" style="color:#90cdf4;"></i><span class="sire-kpi-val">@registros.Count</span><span style="opacity:.75">registros</span></span>
        <span class="sire-kpi"><i class="bi bi-calculator" style="color:#fbd38d;"></i><span class="sire-kpi-val">S/ @totalBase.ToString("N0")</span><span style="opacity:.75">base</span></span>
        <span class="sire-kpi"><i class="bi bi-percent" style="color:#76e4f7;"></i><span class="sire-kpi-val">S/ @totalIgv.ToString("N0")</span><span style="opacity:.75">IGV</span></span>
        <span class="sire-kpi"><i class="bi bi-credit-card" style="color:#68d391;"></i><span class="sire-kpi-val">S/ @totalMonto.ToString("N0")</span><span style="opacity:.75">total</span></span>
    }
</div>

<!-- Anti-forgery token para POST -->
@Html.AntiForgeryToken()

<!-- Period Selector -->
<div class="filter-bar">
    <label class="form-label fw-semibold mb-2">Seleccionar Período</label>
    <div class="input-group">
        <select class="form-select form-select-sm" id="periodoSelect" onchange="cambiarPeriodo()">
            <option value="">--- Seleccionar período ---</option>
            @foreach (var p in periodos)
            {
                <option value="@p.Periodo" selected="@(p.Periodo == periodoSeleccionado)">
                    @($"{p.Periodo[..4]}/{p.Periodo[4..]}"): @p.Descripcion
                </option>
            }
        </select>
        <button class="btn btn-contab btn-contab-primary btn-sm" type="button" onclick="recargarPeriodo()">
            <i class="bi bi-arrow-clockwise me-1"></i>Recargar
        </button>
    </div>
</div>

@if (string.IsNullOrWhiteSpace(periodoSeleccionado))
{
    <div class="sire-alert sire-alert-info">
        <i class="bi bi-info-circle"></i>
        <span>Seleccione un período para ver los registros de ventas disponibles.</span>
    </div>
}
else
{
    <!-- Summary KPIs -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="sire-kpi-card rvie">
                <div class="sire-kpi-card-icon rvie"><i class="bi bi-file-earmark-text"></i></div>
                <div><div class="sire-kpi-card-label">Total Registros</div><div class="sire-kpi-card-value">@registros.Count</div></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="sire-kpi-card rvie">
                <div class="sire-kpi-card-icon rvie"><i class="bi bi-calculator"></i></div>
                <div><div class="sire-kpi-card-label">Base Imponible</div><div class="sire-kpi-card-value" style="font-size:1.2rem;">S/ @totalBase.ToString("N0")</div></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="sire-kpi-card rce">
                <div class="sire-kpi-card-icon rce"><i class="bi bi-percent"></i></div>
                <div><div class="sire-kpi-card-label">IGV</div><div class="sire-kpi-card-value" style="font-size:1.2rem;">S/ @totalIgv.ToString("N0")</div></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="sire-kpi-card ok">
                <div class="sire-kpi-card-icon ok"><i class="bi bi-credit-card"></i></div>
                <div><div class="sire-kpi-card-label">Total</div><div class="sire-kpi-card-value" style="font-size:1.2rem;">S/ @totalMonto.ToString("N0")</div></div>
            </div>
        </div>
    </div>

    <!-- Flujo de Exportación -->
    @if (!string.IsNullOrWhiteSpace(periodoSeleccionado))
    {
        <div class="sire-alert sire-alert-info mb-3">
            <i class="bi bi-info-circle"></i>
            <span><strong>Nuevo flujo de exportación:</strong> Haga clic en <strong>“Exportar Propuesta”</strong> para iniciar el procesamiento en SUNAT. Una vez completado podrá descargar el archivo ZIP.</span>
        </div>
        <div class="mb-4 d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    onclick="iniciarExportacion('@periodoSeleccionado', 'ventas')">
                <i class="bi bi-upload me-1"></i>Exportar Propuesta
            </button>
            <a href="@Url.Action("DescargarConstancia", "Sire", new { periodo = periodoSeleccionado, tipo = "ventas" })"
               class="btn btn-sm btn-outline-danger">
                <i class="bi bi-file-pdf me-1"></i>Descargar Constancia PDF
            </a>
            <a asp-action="Monitoreo" asp-route-operacion="EXPORTAR" asp-route-tab="log"
               class="btn btn-sm btn-outline-info" title="Ver log de auditoría HTTP para RVIE">
                <i class="bi bi-journal-code me-1"></i>Ver Log SUNAT
            </a>
        </div>
    }

    <!-- Modal de Progreso de Exportación -->
    <div class="modal fade" id="modalExportacion" tabindex="-1" aria-labelledby="modalExportacionLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header sire-modal-header-rvie py-2">
                    <h6 class="modal-title" id="modalExportacionLabel">
                        <i class="bi bi-cloud-upload me-2"></i>Exportación de Propuesta RVIE
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div id="estadoExportacion">
                        <div class="text-center">
                            <div class="spinner-border text-success mb-3" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p class="fw-semibold">Iniciando exportación...</p>
                        </div>
                    </div>
                    <!-- Log del job activo -->
                    <div id="logsJobContainer" style="display:none;max-height:180px;overflow-y:auto;font-size:.8rem;border-top:1px solid #dee2e6;margin-top:.75rem;padding-top:.5rem">
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                    <button type="button" id="btnDescargarZip" class="btn btn-success btn-sm"
                            style="display: none;" onclick="descargarArchivoExportado('@periodoSeleccionado', 'ventas')">
                        <i class="bi bi-download me-1"></i>Descargar ZIP
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de Confirmación (reemplaza confirm() nativo) -->
    <div class="modal fade" id="modalConfirmar" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white py-2">
                    <h6 class="modal-title"><i class="bi bi-exclamation-triangle me-1"></i>Confirmar cancelación</h6>
                </div>
                <div class="modal-body" id="modalConfirmarMensaje" style="font-size:.9rem"></div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">No, volver</button>
                    <button type="button" class="btn btn-danger btn-sm" id="btnConfirmarSi">Sí, cancelar</button>
                </div>
            </div>
        </div>
    </div>

    @if (registros.Count == 0)
    {
        <div class="sire-alert sire-alert-warn">
            <i class="bi bi-exclamation-circle"></i>
            <span>No hay registros de ventas para el período <strong>@yyyyMm</strong>.</span>
        </div>
    }
    else
    {
        <div class="sire-card">
            <div class="sire-card-header">
                <i class="bi bi-table"></i>
                <span>Registros de Ventas — @yyyyMm</span>
                <span class="ms-auto sire-badge sire-badge-rvie">@registros.Count</span>
            </div>
            <div class="table-responsive">
                <table class="table sire-table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th>Serie</th>
                            <th>Número</th>
                            <th>Doc. Cliente</th>
                            <th>Razón Social</th>
                            <th class="text-end">Base</th>
                            <th class="text-end">IGV</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reg in registros)
                        {
                            var (tipoDesc, tipoCss) = TipoComprobante(reg.TipoComprobante);
                            var badgeCls = tipoCss switch
                            {
                                "bg-primary"          => "sire-badge-rvie",
                                "bg-info text-dark"   => "sire-badge-info",
                                "bg-warning text-dark"=> "sire-badge-warn",
                                "bg-orange text-dark" => "sire-badge-warn",
                                _                     => "sire-badge-secondary"
                            };
                            <tr>
                                <td><span class="sire-badge @badgeCls">@tipoDesc</span></td>
                                <td><span class="sire-code">@reg.SerieComprobante</span></td>
                                <td><span class="sire-code">@reg.NumeroComprobante</span></td>
                                <td class="text-muted small">@reg.TipoDocIdentidadCliente @reg.NumeroDocIdentidadCliente</td>
                                <td>@reg.RazonSocialCliente</td>
                                <td class="text-end">S/ @reg.BaseImponibleGravada.ToString("N2")</td>
                                <td class="text-end">S/ @reg.Igv.ToString("N2")</td>
                                <td class="text-end fw-bold" style="color:var(--sire-rvie);">S/ @reg.ImporteTotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="5" class="text-end text-muted small">Totales</td>
                            <td class="text-end fw-bold">S/ @totalBase.ToString("N2")</td>
                            <td class="text-end fw-bold">S/ @totalIgv.ToString("N2")</td>
                            <td class="text-end fw-bold" style="color:var(--sire-rvie);">S/ @totalMonto.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
}

<script>
    function cambiarPeriodo() {
        const periodo = document.getElementById('periodoSelect').value;
        if (periodo) {
            window.location.href = '@Url.Action("Ventas", new { })' + '?periodo=' + periodo;
        }
    }

    function recargarPeriodo() {
        location.reload();
    }

    // ── Control de polling activo ─────────────────────────────────────────────
    // Solo un poll puede estar activo a la vez. Al iniciar nuevo job o cancelar,
    // se cambia _pollingJobId y el loop anterior se auto-detiene.
    let _pollingJobId = null;

    // ── Modal de confirmación (reemplaza confirm() nativo) ────────────────────
    function confirmarAccion(mensaje, callbackSi) {
        document.getElementById('modalConfirmarMensaje').textContent = mensaje;
        const btn = document.getElementById('btnConfirmarSi');
        const clone = btn.cloneNode(true);
        btn.parentNode.replaceChild(clone, btn);
        clone.addEventListener('click', () => {
            bootstrap.Modal.getInstance(document.getElementById('modalConfirmar'))?.hide();
            callbackSi();
        });
        new bootstrap.Modal(document.getElementById('modalConfirmar')).show();
    }

    // Si venimos del Index con un job a reconectar, abrimos el modal automáticamente
    document.addEventListener('DOMContentLoaded', () => {
        if (sessionStorage.getItem('sireReconectar') === '1') {
            sessionStorage.removeItem('sireReconectar');
            const jobId  = sessionStorage.getItem('sireJobId');
            const period = sessionStorage.getItem('periodoExportacion');
            const tipo   = sessionStorage.getItem('tipoExportacion');
            if (jobId && period && tipo === 'ventas') {
                _pollingJobId = jobId;
                const modal = new bootstrap.Modal(document.getElementById('modalExportacion'));
                modal.show();
                actualizarModalExportacion('EnProceso', 'Reconectando al proceso en curso…', jobId, 0);
                consultarEstadoJob(jobId, period, tipo);
            }
        }
    });

    // Inicia la exportación en segundo plano (BackgroundService) y muestra modal de progreso
    async function iniciarExportacion(periodo, tipo) {
        const modal = new bootstrap.Modal(document.getElementById('modalExportacion'));
        modal.show();

        document.getElementById('estadoExportacion').innerHTML = `
            <div class="text-center">
                <div class="spinner-border text-success mb-3" role="status"><span class="visually-hidden">Cargando...</span></div>
                <p class="fw-semibold">Verificando si existe proceso previo…</p>
            </div>`;
        document.getElementById('btnDescargarZip').style.display = 'none';

        try {
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';

            const response = await fetch('@Url.Action("IniciarExportacion", "Sire")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({ periodo, tipo })
            });

            const result = await response.json();

            // ── Job activo detectado (mismo período o período diferente) ─────────
            if (result.bloqueadoPorOtro || (result.yaExiste && result.mismoPeriodo)) {
                mostrarModalProcesoActivo(result, periodo, tipo);
                return;
            }

            if (!result.exitoso) { mostrarErrorExportacion(result.error || result.mensaje); return; }

            sessionStorage.setItem('sireJobId', result.jobId);
            sessionStorage.setItem('periodoExportacion', periodo);
            sessionStorage.setItem('tipoExportacion', tipo);

            // Registrar el job activo ANTES de iniciar el poll
            _pollingJobId = result.jobId;
            actualizarModalExportacion('Pendiente', 'Solicitud enviada. El proceso corre en segundo plano…', result.jobId, 0);
            consultarEstadoJob(result.jobId, periodo, tipo);
        }
        catch (error) { mostrarErrorExportacion('Error al iniciar exportación: ' + error.message); }
    }

    async function consultarEstadoJob(jobId, periodo, tipo, intentos = 0) {
        // Si _pollingJobId cambió (cancel o nuevo job), este loop ya no es el activo
        if (jobId !== _pollingJobId) return;

        const maxIntentos = 1440;
        const intervalo   = 5000;
        const segundosTranscurridos = Math.round((intentos * intervalo) / 1000);

        if (intentos >= maxIntentos) {
            mostrarErrorExportacion('Tiempo de espera agotado. Recargue la página más tarde.');
            return;
        }

        try {
            const response = await fetch(
                `@Url.Action("EstadoExportacion", "Sire")?jobId=${encodeURIComponent(jobId)}`,
                { method: 'GET' }
            );
            const result = await response.json();
            if (!result.exitoso) { mostrarErrorExportacion(result.error || 'Error al consultar estado.'); return; }

            const estado = result.estado || 'EnProceso';
            actualizarModalExportacion(estado, estadoAMensaje(estado, result), jobId, segundosTranscurridos);

            // Actualizar ticket en sesión para que reconexión lo muestre
            if (result.numTicket) sessionStorage.setItem('sireNumTicket', result.numTicket);

            if (intentos % 3 === 0) cargarLogsJob(jobId);

            if (result.esFinal === true) {
                await cargarLogsJob(jobId);
                if (result.estado === 'Error') {
                    if (result.puedeReintentar) {
                        mostrarErrorConReintentar(result.mensajeError || 'Error en el proceso.', jobId, periodo, tipo);
                    } else {
                        mostrarErrorConCancel(result.mensajeError || 'Error en el proceso.', jobId, periodo, tipo);
                    }
                } else {
                    sessionStorage.setItem('sireJobIdCompletado', jobId);
                    mostrarExitoExportacion(
                        `Propuesta lista. ${result.registrosInsertados ?? 0} registros cargados en Oracle.`,
                        result.rutaArchivo, result.nombreArchivo
                    );
                }
                sessionStorage.removeItem('sireJobId');
                return;
            }

            // Job huérfano: lleva más de 2 min en Pendiente sin log = se perdió del Channel
            if (result.posibleHuerfano) {
                mostrarAvisoHuerfano(result.minutosParado, jobId, periodo, tipo);
                return; // detener polling, el watchdog del worker lo recuperará en ~2 min
            }

            if (result.minutosParado > 10 && (estado === 'Pendiente' || estado === 'EnProceso')) {
                mostrarAdvertenciaParado(estado, result.minutosParado, result.fechaCreacion, jobId, periodo, tipo, result.numTicket);
            } else if (estado === 'EsperandoTicket') {
                // EsperandoTicket: WatcherWorker lo retoma a las ProximaConsulta.
                // No tiene sentido seguir preguntando cada 5s; el usuario ve la hora de próxima consulta.
                actualizarModalExportacion('EsperandoTicket', estadoAMensaje('EsperandoTicket', result), jobId, segundosTranscurridos);
                return; // detener polling — el Watcher avisará cuando retome
            }

            setTimeout(() => consultarEstadoJob(jobId, periodo, tipo, intentos + 1), intervalo);
        }
        catch (error) { mostrarErrorExportacion('Error al consultar estado: ' + error.message); }
    }

    async function cargarLogsJob(jobId) {
        try {
            const resp = await fetch(`@Url.Action("LogsJob", "Sire")?jobId=${encodeURIComponent(jobId)}`);
            const data = await resp.json();
            if (!data.exitoso || !data.logs?.length) return;
            const cont = document.getElementById('logsJobContainer');
            if (!cont) return;
            cont.style.display = 'block';

            const etiquetas = {
                AUTH:      { icon: '🔑', label: 'Autenticación con SUNAT' },
                INICIAR:   { icon: '▶️',  label: 'Job iniciado' },
                EXPORTAR:  { icon: '📤', label: 'Exportación solicitada a SUNAT' },
                TICKET:    { icon: '🔄', label: 'Verificando respuesta de SUNAT' },
                DESCARGAR: { icon: '⬇️', label: 'Descargando archivo' },
                GUARDAR:   { icon: '💾', label: 'Guardando archivo' },
                CARGAR:    { icon: '📥', label: 'Cargando registros al sistema' },
                COMPLETAR: { icon: '✅', label: 'Proceso completado' },
                CANCEL:    { icon: '🚫', label: 'Cancelado' },
                ERROR:     { icon: '❌', label: 'Error' },
            };
            cont.innerHTML = `<div class="fw-semibold mb-1 text-muted" style="font-size:.75rem">ACTIVIDAD RECIENTE</div>` +
                data.logs.map(l => {
                    const e = etiquetas[l.operacion] || { icon: l.exito ? '✅' : '❌', label: l.operacion };
                    const css = l.exito ? 'text-success-emphasis' : 'text-danger-emphasis';
                    const hora = l.fecha.slice(11, 19);
                    const durHtml = l.duracionMs > 0
                        ? `<span class="badge bg-secondary ms-1" style="font-size:.65rem;font-weight:400">${l.duracionMs}ms</span>` : '';
                    const httpHtml = l.httpStatus
                        ? `<span class="badge ms-1" style="font-size:.65rem;font-weight:400;background:#6c757d">${l.metodo || ''} ${l.httpStatus}</span>` : '';
                    const msgHtml = l.mensaje
                        ? `<div class="text-muted" style="font-size:.78rem;word-break:break-word">${l.mensaje}</div>` : '';
                    return `<div class="d-flex gap-2 border-bottom py-1 align-items-start small">
                        <span>${e.icon}</span>
                        <div style="flex:1">
                            <span class="${css} fw-semibold">${e.label}</span>${durHtml}${httpHtml}
                            ${msgHtml}
                        </div>
                        <span class="text-muted text-nowrap" style="font-size:.75rem">${hora}</span>
                    </div>`;
                }).join('');
        } catch { }
    }

    function estadoAMensaje(estado, result) {
        if (estado === 'Pendiente') {
            if (result.bloqueadorTipo) {
                const tipo = result.bloqueadorTipo === 'compras' ? 'compras' : 'ventas';
                return `Su solicitud está en cola. Hay un proceso de <strong>${tipo} ${result.bloqueadorPeriodo}</strong> en ejecución. Se iniciará automáticamente al finalizar.`;
            }
            return 'Su solicitud fue recibida. El servidor la procesará en breve…';
        }
        if (estado === 'EnProceso') return 'Procesando en SUNAT. Esto puede tomar algunos minutos…';
        if (estado === 'EsperandoTicket') {
            const prox = result.proximaConsulta
                ? ` Próxima consulta automática: <strong>${result.proximaConsulta}</strong>.`
                : '';
            return `SUNAT está generando el archivo. El sistema consultará automáticamente cada 15 min.${prox}`;
        }
        if (estado === 'Completado') return `Proceso completado. ${result.registrosInsertados ?? 0} registros cargados.`;
        if (estado === 'Error') return result.mensajeError || 'Ocurrió un error en el proceso.';
        return 'Procesando…';
    }

    function actualizarModalExportacion(estado, mensaje, ref, segundos = 0) {
        const estadoDiv = document.getElementById('estadoExportacion');
        const badgeColor = estado === 'EnProceso' ? 'info'
            : estado === 'EsperandoTicket' ? 'warning'
            : estado === 'Completado' ? 'success'
            : estado === 'Error' ? 'danger' : 'secondary';
        const spinner = (estado === 'EnProceso' || estado === 'Pendiente' || estado === 'EsperandoTicket')
            ? `<span class="spinner-border spinner-border-sm me-1" style="width:.7rem;height:.7rem;"></span>` : '';
        const estadoLabel = {
            Pendiente: 'En cola',
            EnProceso: 'En proceso',
            EsperandoTicket: '⏳ Esperando SUNAT',
            Completado: 'Completado',
            Error: 'Error'
        }[estado] || estado;
        const tiempoTexto = segundos > 30 ? `<small class="text-muted d-block mt-2">\u23f1 ${segundos}s esperando</small>` : '';
        estadoDiv.innerHTML = `<div class="text-center">
            <div class="mb-2"><span class="badge bg-${badgeColor} text-dark p-2" style="font-size:.9rem;">${spinner}${estadoLabel}</span></div>
            <p class="mb-1" style="font-size:.9rem;">${mensaje}</p>${tiempoTexto}</div>`;
    }

    // Bloqueado porque hay un job activo de OTRO período para el mismo tipo
    // Muestra los 3 botones dentro del modalExportacion cuando se detecta un job activo.
    // Cubre ambos casos: mismo período (yaExiste) o período diferente (bloqueadoPorOtro).
    function mostrarModalProcesoActivo(result, periodo, tipo) {
        const estadoDiv  = document.getElementById('estadoExportacion');
        const logsCont   = document.getElementById('logsJobContainer');
        if (logsCont) { logsCont.innerHTML = ''; logsCont.style.display = 'none'; }
        document.getElementById('btnDescargarZip').style.display = 'none';

        const jobId         = result.jobId;
        const periodoActivo = result.periodoActivo || periodo;
        const esDiferente   = result.bloqueadoPorOtro === true;
        const mins          = result.minutosParado || 0;
        const estadoLabel   = { Pendiente:'En cola', EnProceso:'En proceso', EsperandoTicket:'⏳ Esperando SUNAT' }[result.estado] || result.estado || '—';

        const alertMsg = esDiferente
            ? `<strong>No se puede iniciar:</strong> hay un proceso de <strong>RVIE</strong> activo para el período <strong>${periodoActivo}</strong>.`
            : `<strong>Ya existe un proceso activo</strong> para el período <strong>${periodoActivo}</strong>. No se inició uno nuevo.`;

        const ticketFila  = result.numTicket
            ? `<tr><td class="text-muted small py-1">Ticket SUNAT</td><td class="small py-1"><code>${result.numTicket}</code></td></tr>` : '';
        const proximaFila = result.proximaConsulta
            ? `<tr><td class="text-muted small py-1">Próx. consulta</td><td class="small py-1 fw-semibold">${result.proximaConsulta}</td></tr>` : '';
        const minFila = result.estado !== 'EsperandoTicket'
            ? `<tr><td class="text-muted small py-1">Sin avanzar</td><td class="small py-1 ${mins > 30 ? 'text-danger fw-bold' : ''}">${mins} min</td></tr>` : '';

        estadoDiv.innerHTML = `
            <div class="alert ${esDiferente ? 'alert-danger' : 'alert-warning'} py-2 mb-3" style="font-size:.84rem">
                <i class="bi bi-activity me-1"></i>${alertMsg}
            </div>
            <table class="table table-sm table-borderless mb-3" style="font-size:.83rem">
                <tr><td class="text-muted small py-1">Estado actual</td>
                    <td class="py-1"><span class="badge bg-warning text-dark">${estadoLabel}</span></td></tr>
                <tr><td class="text-muted small py-1">Iniciado</td>
                    <td class="small py-1">${result.fechaCreacion || '—'}</td></tr>
                ${minFila}${ticketFila}${proximaFila}
            </table>
            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <button class="btn btn-outline-secondary btn-sm" onclick="cancelarJobSolo('${jobId}')">
                    <i class="bi bi-x me-1"></i>Solo Cancelar
                </button>
                <button class="btn btn-danger btn-sm" onclick="cancelarJob('${jobId}','${periodoActivo}','${tipo}')">
                    <i class="bi bi-x-circle me-1"></i>Cancelar y Reiniciar
                </button>
                <button class="btn btn-primary btn-sm" onclick="verProcesoActivoEnModal('${jobId}','${periodoActivo}','${tipo}')">
                    <i class="bi bi-eye me-1"></i>Ver Proceso Activo
                </button>
            </div>`;
    }

    // Ver Proceso Activo: carga logs y activa polling dentro del mismo modalExportacion
    function verProcesoActivoEnModal(jobId, periodo, tipo) {
        _pollingJobId = jobId;
        sessionStorage.setItem('sireJobId', jobId);
        sessionStorage.setItem('periodoExportacion', periodo);
        sessionStorage.setItem('tipoExportacion', tipo);
        const logsCont = document.getElementById('logsJobContainer');
        if (logsCont) { logsCont.innerHTML = ''; logsCont.style.display = 'none'; }
        actualizarModalExportacion('EnProceso', 'Conectando al proceso activo…', jobId, 0);
        cargarLogsJob(jobId);
        consultarEstadoJob(jobId, periodo, tipo);
    }

    function mostrarBloqueadoPorOtro(result, tipo) {
        const estadoDiv = document.getElementById('estadoExportacion');
        const mins = result.minutosParado || 0;
        const ticketFila = result.numTicket
            ? `<tr><td class="text-muted">Ticket SUNAT</td><td><code>${result.numTicket}</code></td></tr>`
            : '';
        estadoDiv.innerHTML = `
            <div class="alert alert-danger py-2 mb-2 text-start" style="font-size:.85rem">
                <i class="bi bi-lock-fill me-1"></i>
                <strong>No se puede iniciar: ya hay un proceso de ${tipo} activo</strong>
            </div>
            <table class="table table-sm table-borderless mb-2" style="font-size:.82rem">
                <tr><td class="text-muted">Período activo</td><td><strong>${result.periodoActivo}</strong></td></tr>
                <tr><td class="text-muted">Estado</td><td><span class="badge bg-warning text-dark">${result.estado}</span></td></tr>
                <tr><td class="text-muted">Iniciado</td><td>${result.fechaCreacion}</td></tr>
                <tr><td class="text-muted">Sin avanzar</td><td class="${mins > 30 ? 'text-danger fw-bold' : ''}">${mins} min</td></tr>
                ${ticketFila}
            </table>
            <p class="small text-muted">Solo puede haber <strong>un proceso de ${tipo}</strong> activo a la vez.
               Espere que termine o cáncelo para iniciar uno nuevo.</p>
            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <button class="btn btn-sm btn-info" onclick="verProcesoActivo('${result.jobId}', '${result.periodoActivo}', '${tipo}')">
                    <i class="bi bi-eye me-1"></i>Ir al proceso activo
                </button>
                <button class="btn btn-sm btn-danger" onclick="cancelarJob('${result.jobId}', '${result.periodoActivo}', '${tipo}')">
                    <i class="bi bi-x-circle me-1"></i>Cancelar y reiniciar
                </button>
                <button class="btn btn-sm btn-outline-secondary" onclick="cancelarJobSolo('${result.jobId}')">
                    <i class="bi bi-x me-1"></i>Solo cancelar
                </button>
            </div>`;
        // Ocultar logs hasta que el usuario haga clic en "Ir al proceso activo"
        const logsCont = document.getElementById('logsJobContainer');
        if (logsCont) logsCont.style.display = 'none';
    }

    // Ir al proceso activo: limpia el modal de bloqueo y muestra el progreso real con logs
    function verProcesoActivo(jobId, periodo, tipo) {
        _pollingJobId = jobId;
        sessionStorage.setItem('sireJobId', jobId);
        sessionStorage.setItem('periodoExportacion', periodo);
        sessionStorage.setItem('tipoExportacion', tipo);
        // Limpiar panel de logs antes de la transición
        const logsCont = document.getElementById('logsJobContainer');
        if (logsCont) { logsCont.innerHTML = ''; logsCont.style.display = 'none'; }
        // Mostrar estado de carga y lanzar polling
        actualizarModalExportacion('EnProceso', 'Conectando al proceso activo…', jobId, 0);
        cargarLogsJob(jobId);
        consultarEstadoJob(jobId, periodo, tipo);
    }

    function mostrarInfoReconexion(estado, fechaCreacion, minutos, jobId, periodo, tipo, extraHtml = '', proximaConsulta = null) {
        const estadoDiv = document.getElementById('estadoExportacion');
        // EsperandoTicket nunca se considera "parado": es comportamiento normal
        const esEsperando = estado === 'EsperandoTicket';
        const esViejo = !esEsperando && minutos > 30;
        const estadoLabel = {
            Pendiente: 'En cola',
            EnProceso: 'En proceso',
            EsperandoTicket: '⏳ Esperando SUNAT'
        }[estado] || estado;

        const proximaFila = esEsperando && proximaConsulta
            ? `<tr><td class="text-muted">Próx. consulta</td><td><strong>${proximaConsulta}</strong></td></tr>`
            : '';
        const notaEsperando = esEsperando
            ? `<div class="alert alert-info py-2 mb-2" style="font-size:.82rem">
                <i class="bi bi-hourglass-split me-1"></i>
                SUNAT aún está generando el archivo. El sistema verificará automáticamente cada 15 min. No es necesario hacer nada.
               </div>`
            : '';

        estadoDiv.innerHTML = `
            <div class="alert alert-warning py-2 mb-2 text-start" style="font-size:.85rem">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                <strong>Hay un proceso activo para este período</strong> — No se inició uno nuevo.
            </div>
            <table class="table table-sm table-borderless mb-2" style="font-size:.85rem">
                <tr><td class="text-muted">Estado</td><td><span class="badge bg-warning text-dark">${estadoLabel}</span></td></tr>
                <tr><td class="text-muted">Iniciado</td><td>${fechaCreacion}</td></tr>
                ${!esEsperando ? `<tr><td class="text-muted fw-semibold">Sin avanzar</td><td class="${esViejo ? 'text-danger fw-bold' : ''}">${minutos} min</td></tr>` : ''}
                ${proximaFila}
            </table>
            ${notaEsperando}
            ${extraHtml}
            ${esViejo ? `
            <div class="alert alert-danger py-2 mb-2" style="font-size:.82rem">
                <i class="bi bi-clock-history me-1"></i>
                Este proceso lleva <strong>${minutos} minutos</strong> sin avanzar. Puede cancelarlo y reiniciar.
            </div>
            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <button class="btn btn-sm btn-danger" onclick="cancelarJob('${jobId}','${periodo}','${tipo}')">
                    <i class="bi bi-x-circle me-1"></i>Cancelar y reiniciar
                </button>
                <button class="btn btn-sm btn-outline-secondary" onclick="cancelarJobSolo('${jobId}')">
                    <i class="bi bi-x me-1"></i>Solo cancelar
                </button>
            </div>` : ''}`;
        cargarLogsJob(jobId);
    }

    function mostrarAdvertenciaParado(estado, minutos, fechaCreacion, jobId, periodo, tipo, ticket) {
        const estadoDiv = document.getElementById('estadoExportacion');
        const estadoLabel = estado === 'Pendiente' ? 'En cola' : 'En proceso';
        estadoDiv.innerHTML = `
            <div class="alert alert-warning py-2 mb-2" style="font-size:.85rem">
                <i class="bi bi-clock-history me-1"></i>
                <strong>${estadoLabel}</strong> \u2014 Sin avanzar por <strong>${minutos} min</strong>
            </div>
            <p class="small text-center text-muted mb-2">El servidor est\u00e1 procesando. Si no avanza, puede cancelar y reiniciar.</p>
            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <button class="btn btn-sm btn-danger" onclick="cancelarJob('${jobId}','${periodo}','${tipo}')">
                    <i class="bi bi-x-circle me-1"></i>Cancelar y reiniciar
                </button>
                <button class="btn btn-sm btn-outline-secondary" onclick="cancelarJobSolo('${jobId}')">
                    <i class="bi bi-x me-1"></i>Solo cancelar
                </button>
            </div>`;
        cargarLogsJob(jobId);
    }

    function mostrarAvisoHuerfano(minutos, jobId, periodo, tipo) {
        const estadoDiv = document.getElementById('estadoExportacion');
        estadoDiv.innerHTML = `<div class="text-center">
            <div class="mb-2"><i class="bi bi-exclamation-triangle-fill fs-1 text-warning"></i></div>
            <p class="fw-semibold text-warning">Job en cola sin procesar</p>
            <p class="small text-muted mb-3">El proceso lleva <strong>${minutos} min</strong> en cola sin iniciar.
            Esto ocurre cuando el servidor se reinció después de crear el job.<br>
            El sistema lo recuperará automáticamente en los próximos 2 minutos.</p>
            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <button class="btn btn-sm btn-warning" onclick="forzarReencolar('${jobId}','${periodo}','${tipo}')">
                    <i class="bi bi-arrow-clockwise me-1"></i>Reencolar ahora
                </button>
                <button class="btn btn-sm btn-outline-secondary" onclick="cancelarJobSolo('${jobId}')">
                    <i class="bi bi-x me-1"></i>Cancelar
                </button>
            </div>
        </div>`;
    }

    async function forzarReencolar(jobId, periodo, tipo) {
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : '';
        try {
            const resp = await fetch('@Url.Action("ReencolarJobHuerfano", "Sire")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(jobId)
            });
            const data = await resp.json();
            if (data.exitoso) {
                _pollingJobId = jobId;
                actualizarModalExportacion('Pendiente', 'Job reencolado. El servidor lo procesará en breve…', jobId, 0);
                consultarEstadoJob(jobId, periodo, tipo);
            } else {
                mostrarErrorExportacion(data.error || 'No se pudo reencolar.');
            }
        } catch (e) { mostrarErrorExportacion('Error al reencolar: ' + e.message); }
    }

    function mostrarExitoExportacion(mensaje, rutaArchivo, nombreArchivo) {
        const estadoDiv = document.getElementById('estadoExportacion');
        const infoArchivo = rutaArchivo ? `<small class="text-muted d-block mt-1"><i class="bi bi-folder2"></i> ${rutaArchivo}</small>` : '';
        estadoDiv.innerHTML = `<div class="text-center">
            <div class="mb-3"><i class="bi bi-check-circle fs-1" style="color:#27ae60;"></i></div>
            <p class="fw-semibold text-success">${mensaje}</p>${infoArchivo}</div>`;
        // Mostrar botón ZIP solo si el archivo NO fue guardado en servidor
        document.getElementById('btnDescargarZip').style.display = rutaArchivo ? 'none' : '';
    }

    function mostrarErrorExportacion(error) {
        const estadoDiv = document.getElementById('estadoExportacion');
        estadoDiv.innerHTML = `<div class="text-center">
            <div class="mb-3"><i class="bi bi-exclamation-circle fs-1" style="color:#e74c3c;"></i></div>
            <p class="fw-semibold text-danger">Error en la exportación</p>
            <small class="text-muted">${error}</small></div>`;
        document.getElementById('btnDescargarZip').style.display = 'none';
    }

    function mostrarErrorConCancel(error, jobId, periodo, tipo) {
        const estadoDiv = document.getElementById('estadoExportacion');
        estadoDiv.innerHTML = `<div class="text-center">
            <div class="mb-2"><i class="bi bi-exclamation-circle fs-1 text-danger"></i></div>
            <p class="fw-semibold text-danger mb-1">Error</p>
            <small class="text-muted d-block mb-3">${error}</small>
            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <button class="btn btn-sm btn-danger" onclick="cancelarJob('${jobId}','${periodo}','${tipo}')">
                    <i class="bi bi-x-circle me-1"></i>Cancelar y reiniciar
                </button>
                <button class="btn btn-sm btn-outline-secondary" onclick="cancelarJobSolo('${jobId}')">
                    <i class="bi bi-x me-1"></i>Solo cancelar
                </button>
            </div></div>`;
        cargarLogsJob(jobId);
    }

    function mostrarErrorConReintentar(error, jobId, periodo, tipo) {
        const estadoDiv = document.getElementById('estadoExportacion');
        estadoDiv.innerHTML = `<div class="text-center">
            <div class="mb-2"><i class="bi bi-exclamation-circle fs-1 text-danger"></i></div>
            <p class="fw-semibold text-danger">Error transitorio (SUNAT 504)</p>
            <small class="text-muted d-block mb-3">${error}</small>
            <div class="d-flex gap-2 justify-content-center">
                <button class="btn btn-sm btn-warning" onclick="reintentarJob('${jobId}','${periodo}','${tipo}')">
                    <i class="bi bi-arrow-clockwise me-1"></i>Reintentar polling
                </button>
                <button class="btn btn-sm btn-danger" onclick="cancelarJob('${jobId}','${periodo}','${tipo}')">
                    <i class="bi bi-x-circle me-1"></i>Cancelar y reiniciar
                </button>
                <button class="btn btn-sm btn-outline-secondary" onclick="cancelarJobSolo('${jobId}')">
                    <i class="bi bi-x me-1"></i>Solo cancelar
                </button>
            </div></div>`;
        cargarLogsJob(jobId);
    }

    async function cancelarJob(jobId, periodo, tipo) {
        confirmarAccion(
            '¿Cancelar este proceso? Podrá iniciar una nueva exportación para el mismo período.',
            async () => {
                // Detener el poll activo inmediatamente
                _pollingJobId = null;

                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : '';
                try {
                    const resp = await fetch('@Url.Action("CancelarJob", "Sire")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                        body: JSON.stringify(jobId)
                    });
                    const data = await resp.json();
                    if (data.exitoso) {
                        sessionStorage.removeItem('sireJobId');
                        bootstrap.Modal.getInstance(document.getElementById('modalExportacion'))?.hide();
                        setTimeout(() => iniciarExportacion(periodo, tipo), 400);
                    } else {
                        mostrarErrorExportacion(data.error || 'No se pudo cancelar.');
                    }
                } catch (e) { mostrarErrorExportacion('Error al cancelar: ' + e.message); }
            }
        );
    }

    // Cancela el job sin iniciar una nueva exportación
    async function cancelarJobSolo(jobId) {
        confirmarAccion(
            '¿Cancelar este proceso? No se iniciará una nueva exportación automáticamente.',
            async () => {
                _pollingJobId = null;
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : '';
                try {
                    const resp = await fetch('@Url.Action("CancelarJob", "Sire")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                        body: JSON.stringify(jobId)
                    });
                    const data = await resp.json();
                    if (data.exitoso) {
                        sessionStorage.removeItem('sireJobId');
                        bootstrap.Modal.getInstance(document.getElementById('modalExportacion'))?.hide();
                    } else {
                        mostrarErrorExportacion(data.error || 'No se pudo cancelar.');
                    }
                } catch (e) { mostrarErrorExportacion('Error al cancelar: ' + e.message); }
            }
        );
    }

    async function reintentarJob(jobId, periodo, tipo) {
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : '';
        try {
            const response = await fetch('@Url.Action("ReintentarJob", "Sire")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(jobId)
            });
            const result = await response.json();
            if (!result.exitoso) { mostrarErrorExportacion(result.error || 'No se pudo reencolar.'); return; }
            actualizarModalExportacion('EnProceso', `Job reencolado. ${result.mensaje}`, jobId, 0);
            consultarEstadoJob(jobId, periodo, tipo);
        } catch (error) { mostrarErrorExportacion('Error al reintentar: ' + error.message); }
    }

    async function descargarArchivoExportado(periodo, tipo) {
        const ruc = '@(Model?.Ruc ?? "")';
        const codLibro = tipo === 'ventas' ? '140000' : '080000';
        const nomArchivo = `PP${ruc}${periodo}${codLibro}001111110.ZIP`;
        window.location.href = `@Url.Action("DescargarArchivoExportado", "Sire")?periodo=${encodeURIComponent(periodo)}&tipo=${encodeURIComponent(tipo)}&nomArchivo=${encodeURIComponent(nomArchivo)}`;
    }
</script>
