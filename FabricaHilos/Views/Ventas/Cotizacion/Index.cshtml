@model FabricaHilos.Models.Ventas.Cotizacion.CotizacionIndexViewModel
@{
    ViewData["Title"] = "Cotizaciones";
    int startItem = Model.TotalCount == 0 ? 0 : (Model.Page - 1) * Model.PageSize + 1;
    int endItem = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Ventas" asp-action="Index">Ventas</a></li>
    <li class="breadcrumb-item active">Cotizaciones</li>
}

@section Styles {
<link rel="stylesheet" href="~/css/sire.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/cotizacion.css" asp-append-version="true" />
}

<div class="sire-page-header">
    <div class="sire-page-icon sire"><i class="bi bi-calculator"></i></div>
    <div>
        <h1 class="sire-page-title">Cotizaciones</h1>
        <div class="sire-page-sub">Gestión de cotizaciones y simulaciones de costeo comercial</div>
    </div>
    <div class="sire-page-actions">
        <a asp-action="Simular" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Nueva simulación
        </a>
    </div>
</div>

<div class="sire-filter">
    <form method="get" asp-action="Index" class="d-flex gap-2 flex-wrap align-items-center w-100">
        <i class="bi bi-search small" style="color:var(--sire-gray-600);"></i>
        <input type="text" name="buscar" value="@Model.Buscar"
               class="form-control form-control-sm"
               placeholder="Buscar por N° o cliente..." style="max-width:280px;" />
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="incluirEliminadas" name="incluirEliminadas"
                   value="true" checked="@Model.IncluirEliminadas" />
            <label class="form-check-label small text-muted" for="incluirEliminadas">Incluir eliminadas</label>
        </div>
        <button type="submit" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-search"></i> Buscar
        </button>
        @if (!string.IsNullOrEmpty(Model.Buscar) || Model.IncluirEliminadas)
        {
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Limpiar</a>
        }
    </form>
</div>

<div class="sire-card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="sire-table w-100 mb-0">
                <thead>
                    <tr>
                        <th class="text-center">Tipo</th>
                        <th class="text-center">N°</th>
                        <th>Cliente / Título</th>
                        <th class="text-center">Fecha</th>
                        <th class="text-center">Últ. modificación</th>
                        <th class="text-center">Ítems</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Cotizaciones)
                    {
                        <tr class="@(c.Eliminada ? "sire-row-excluido" : "")">
                            <td class="text-center">
                                @if (c.EsSimulacion)
                                {
                                    <span class="sire-badge sire-badge-info">Simulación</span>
                                }
                                else
                                {
                                    <span class="sire-badge sire-badge-rce">Real</span>
                                }
                            </td>
                            <td class="text-center fw-semibold">
                                @(c.EsSimulacion ? $"SM-{c.Numero}" : $"{c.Numero}")
                            </td>
                            <td>
                                @if (c.EsSimulacion)
                                {
                                    <span>@(c.Titulo ?? "(sin título)")</span>
                                }
                                else
                                {
                                    <span>@(c.NombreCliente ?? c.CodCliente ?? "-")</span>
                                }
                                @if (c.Eliminada)
                                {
                                    <span class="sire-badge sire-badge-danger ms-1">Eliminada</span>
                                }
                            </td>
                            <td class="text-center">@(c.Fecha?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td class="text-center">@(c.UltimaModificacion?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            <td class="text-center">@c.TotalItems</td>
                            <td class="text-center">
                                @if (c.Eliminada)
                                {
                                    <span class="sire-badge sire-badge-secondary">Eliminada</span>
                                }
                                else
                                {
                                    <span class="sire-badge sire-badge-ok">Activa</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Detalle"
                                   asp-route-tipoDoc="@c.TipoDoc" asp-route-serie="@c.Serie" asp-route-numero="@c.Numero"
                                   class="btn btn-sm btn-outline-primary" title="Ver detalle">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (c.Eliminada)
                                {
                                    <form method="post" asp-action="Restaurar" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="tipoDoc" value="@c.TipoDoc" />
                                        <input type="hidden" name="serie" value="@c.Serie" />
                                        <input type="hidden" name="numero" value="@c.Numero" />
                                        <button type="submit" class="btn btn-sm btn-outline-success ms-1" title="Restaurar">
                                            <i class="bi bi-arrow-counterclockwise"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger ms-1 btn-eliminar"
                                            data-tipodoc="@c.TipoDoc" data-serie="@c.Serie" data-numero="@c.Numero"
                                            title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Cotizaciones.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-4 d-block mb-1"></i>No se encontraron cotizaciones.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mt-2 px-1">
    <small class="text-muted">
        @(Model.TotalCount == 0 ? "Sin registros" : $"Mostrando {startItem}–{endItem} de {Model.TotalCount} cotizaciones")
    </small>
    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination pagination-sm mb-0">
                @for (int pg = Math.Max(1, Model.Page - 2); pg <= Math.Min(Model.TotalPages, Model.Page + 2); pg++)
                {
                    <li class="page-item @(pg == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-buscar="@Model.Buscar"
                           asp-route-incluirEliminadas="@Model.IncluirEliminadas" asp-route-page="@pg">@pg</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<!-- Formulario oculto para eliminar (confirmación) -->
<form id="frmEliminar" method="post" asp-action="Eliminar" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="tipoDoc" id="elimTipoDoc" />
    <input type="hidden" name="serie" id="elimSerie" />
    <input type="hidden" name="numero" id="elimNumero" />
    <input type="hidden" name="observacion" id="elimObservacion" />
</form>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-eliminar').forEach(btn => {
            btn.addEventListener('click', async () => {
                const ok = await AppConfirm('¿Eliminar esta cotización? Podrá restaurarla luego desde el listado.', 'Confirmar eliminación');
                if (!ok) return;
                document.getElementById('elimTipoDoc').value = btn.dataset.tipodoc;
                document.getElementById('elimSerie').value = btn.dataset.serie;
                document.getElementById('elimNumero').value = btn.dataset.numero;
                document.getElementById('frmEliminar').submit();
            });
        });
    </script>
}
