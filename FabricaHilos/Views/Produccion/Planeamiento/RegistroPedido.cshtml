@model FabricaHilos.Models.Produccion.Planeamiento.RegistroPedidosViewModel
@using FabricaHilos.Models.Produccion.Planeamiento
@using System.Text.Json

@{
    ViewData["Title"] = "Registro de Pedidos";

    // Serializar items a JSON para manipulación 100% client-side
    var jsonItems = JsonSerializer.Serialize(Model.Items.Select(x => new {
        serie         = x.Serie,
        numPed        = x.NumPed,
        fchPedido     = x.FchPedido.ToString("yyyy-MM-dd"),
        fchPedidoDisp = x.FchPedido.ToString("dd/MM/yyyy"),
        fchAprobacion = x.FchAprobacion?.ToString("dd/MM/yyyy") ?? "",
        estadoPed     = x.EstadoPedTexto,
        estadoItem    = x.EstadoItem,
        codCliente    = x.CodCliente,
        nombreCliente = x.NombreCliente,
        codVende      = x.CodVende,
        nombreVende   = x.NombreVende,
        giro          = x.Giro,
        nro           = x.Nro,
        codArt        = x.CodArt,
        descArt       = x.DescArt,
        titulo        = x.Titulo,
        tipoFibra     = x.TipoFibra,
        descFibra     = x.DescTfibra,
        proceso       = x.Proceso,
        nombreProceso = x.NombreProceso,
        codServ       = x.CodServ,
        areaServicio  = x.AreaServicio,
        areaBadge     = x.AreaBadgeClass,
        cantidad      = x.Cantidad,
        precio        = x.Precio,
        color         = x.Color,
        colorDet      = x.ColorDet,
        intensidad    = x.Intensidad,
        intensidadAbrev = x.IntensidadAbrev,
        presentacion  = x.Presentacion,
        fMaxPed       = x.FMaxPed?.ToString("dd/MM/yyyy") ?? "",
        fMaxPedIso    = x.FMaxPed?.ToString("yyyy-MM-dd") ?? "",
        soloDespacho  = x.SoloDespacho,
        detalle       = x.Detalle,
        codFam        = x.CodFam,
        codLin        = x.CodLin,
        descFamilia   = x.DescFamilia,
        descLinea     = x.DescLinea,
        // ── Hilandería (ITEMPED_DET) ──────────────────────────────
        nroRmc        = x.NroRmc,
        rmc           = x.Rmc,
        descRmc       = x.DescRmc,
        lote          = x.Lote,
        fhcEntrega    = x.FhcEntrega?.ToString("dd/MM/yyyy") ?? "",
        fhcEntregaIso = x.FhcEntrega?.ToString("yyyy-MM-dd") ?? "",
        nroprog       = x.Nroprog,
        estadoProg    = x.EstadoProg,
        urgente       = x.Urgente,
        // ── PLN Seguimiento ─────────────────────────────────────
        pasoActual        = x.PasoActual,
        codPasoAct        = x.CodPasoAct,
        pasoColor         = x.PasoActualColor,
        fchEntregaComp    = x.FchEntregaComp?.ToString("dd/MM/yyyy") ?? "",
        fchEntregaCompIso = x.FchEntregaComp?.ToString("yyyy-MM-dd") ?? "",
        diasRetraso   = x.DiasRetraso,
        indRetraso    = x.IndRetraso,
        indUrgente    = x.IndUrgente,
        numPartida    = x.NumPartida,
        kgPendientes  = x.KgPendientes,
        // ── Computed ───────────────────────────────────────────
        esVencido     = x.EsVencido,
    }));

    // Combos dinámicos únicos
    var servicios = Model.Items.Select(x => x.CodServ).Distinct().OrderBy(x => x).ToList();
    // Fibras: usa TipoFibra (ITEMPED_DET.TIPO_FIBRA, código 8-char) con desc de H_FIBRA
    var tfibras   = Model.Items
        .Select(x => new { cod = x.TipoFibra, desc = x.DescTfibra })
        .Where(x => !string.IsNullOrEmpty(x.cod) && x.cod != "0" && x.cod != "000")
        .DistinctBy(x => x.cod).OrderBy(x => x.cod).ToList();
    // Pasos PLN: usa CodPasoAct (código BD) como value para que el SP filtre correctamente
    var pasoOrderMap = new Dictionary<string,int> {
        {"01",1},{"02",2},{"03",3},{"04",4},{"05",5},{"06",6},{"07",7},{"08",8},
        {"09",9},{"09B",10},{"9R",11},{"10",12},{"11",13},{"12",14},{"13",15},{"14",16}
    };
    var pasosActivos = Model.Items
        .Where(x => !string.IsNullOrEmpty(x.CodPasoAct))
        .Select(x => new { cod = x.CodPasoAct, name = x.PasoActual })
        .DistinctBy(x => x.cod)
        .OrderBy(x => pasoOrderMap.TryGetValue(x.cod, out var o) ? o : 99)
        .ToList();
}

@section Styles {
<link rel="stylesheet" href="~/css/planeamiento.css" asp-append-version="true" />
<style>
/* ── Registro de Pedidos — estilos exclusivos ─────────────────────── */

/* KPI strip principal */
.reg-strip {
    background: linear-gradient(135deg, #1a202c 0%, #2d3748 100%);
    color: #f7fafc;
    border-radius: .5rem .5rem 0 0;
    padding: .6rem 1rem;
    display: flex; align-items: center; flex-wrap: wrap; gap: .5rem;
    border-bottom: 3px solid #0d6efd;
    box-shadow: 0 2px 8px rgba(0,0,0,.25);
}
.reg-strip-title {
    font-size: .83rem; font-weight: 800; letter-spacing: .08em;
    text-transform: uppercase; white-space: nowrap; margin-right: .3rem;
}
.reg-kpi {
    display: inline-flex; align-items: center; gap: .22rem;
    background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.18);
    border-radius: 999px; padding: .18rem .65rem;
    font-size: .7rem; white-space: nowrap;
}
.reg-kpi-val { font-weight: 700; font-size: .84rem; }
.reg-kpi-hil  { border-color: #0dcaf0 !important; color: #0dcaf0; }
.reg-kpi-tint { border-color: #6f42c1 !important; color: #b794f4; }
.reg-kpi-warn { border-color: #ffc107 !important; color: #ffc107; }

/* Toolbar de controles — 2 columnas: Fechas (izq) + Filtros/Acciones (der) */
.reg-toolbar {
    background: #f8fafc;
    border: 1px solid #dee2e6; border-top: none;
    border-radius: 0 0 .35rem .35rem;
    padding: .5rem .9rem;
    margin-bottom: .9rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 1.2rem;
    align-items: start;
    box-shadow: 0 1px 4px rgba(0,0,0,.06);
}
/* Columna izquierda: Fechas */
.reg-col-izq {
    border-right: 1px solid #e2e8f0;
    padding-right: 1.1rem;
    padding-top: .15rem;
    display: flex;
    flex-direction: column;
    gap: .45rem;
}
/* Columna derecha: Filtros + Acciones apilados */
.reg-col-der {
    display: flex;
    flex-direction: column;
    gap: 0;
}
.reg-toolbar-sep {
    width: 1px; height: 1.5rem;
    background: #dee2e6; flex-shrink: 0;
    align-self: center; margin: 0 .15rem;
}

/* Selector de modo de agrupamiento — Bootstrap estándar */
#groupBtns .btn { font-size: .72rem; padding: .22rem .65rem; white-space: nowrap; }

/* Tabla de ítems */
.reg-table-wrap {
    overflow-x: auto;
    border-radius: .4rem;
    border: 1px solid #dee2e6;
    box-shadow: 0 1px 4px rgba(0,0,0,.06);
}
.reg-table {
    font-size: .775rem; border-collapse: collapse; width: 100%; min-width: 900px;
}
.reg-table thead th {
    background: #e9ecef; font-size: .68rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: .04em;
    color: #495057; padding: .35rem .5rem;
    border-bottom: 2px solid #ced4da; white-space: nowrap;
    cursor: pointer; user-select: none; position: sticky; top: 0; z-index: 1;
}
.reg-table thead th:hover { background: #d0d6dd; }
.reg-table thead th .sort-icon { font-size: .65rem; opacity: .5; }
.reg-table tbody td { padding: .28rem .5rem; border-bottom: 1px solid #edf2f7; }
.reg-table tbody tr:hover td { background: #eef3ff; }

/* Tarjeta de grupo — estilo Dashboard */
.reg-grp-card {
    border: 1px solid #e2e8f0;
    border-radius: .4rem;
    margin-bottom: .4rem;
    box-shadow: 0 1px 3px rgba(0,0,0,.06);
    overflow: hidden;
    background: #fff;
}
.reg-grp-head {
    display: flex; align-items: center; gap: .5rem;
    padding: .42rem .75rem; cursor: pointer; user-select: none;
    background: #fafbfd; transition: background .12s;
}
.reg-grp-head:hover { background: #edf2ff; }
.reg-grp-num  { font-weight: 700; font-size: .84rem; color: #2d3748; white-space: nowrap; }
.reg-grp-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .2rem .4rem; margin-left: auto; }
.reg-grp-meta-item { font-size: .72rem; color: #718096; white-space: nowrap; }
.reg-grp-meta-kg   { font-weight: 700; color: #38a169; }

/* Sub-tabla de ítems dentro de la tarjeta */
.reg-subtbl { font-size: .775rem; background: #eef1f6; }
.reg-subtbl thead th {
    background: #e2e7f0; font-size: .68rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: .04em;
    color: #495057; padding: .3rem .5rem;
    border-bottom: 2px solid #cdd4e0; white-space: nowrap;
    cursor: pointer; user-select: none; position: sticky; top: 0; z-index: 1;
}
.reg-subtbl thead th:hover { background: #d0d6dd; }
.reg-subtbl thead th .sort-icon { font-size: .65rem; opacity: .5; }
.reg-subtbl tbody td { padding: .27rem .5rem; border-bottom: 1px solid #dde3ed; vertical-align: middle; }
.reg-subtbl tbody tr:hover td { background: #dde4f0; }

/* Badges de estado, servicio, etc. */
.badge-serv {
    font-size: .65rem; padding: .15rem .45rem; border-radius: .25rem;
    font-weight: 700; white-space: nowrap;
}
.bg-purple { background-color: #6f42c1 !important; }

/* ── Secciones del toolbar ───────────────────────────────────────── */
.reg-sect {
    display:flex; align-items:center; gap:.4rem; flex-wrap:wrap;
    padding:.32rem 0;
}
.reg-sect:not(:last-child) { border-bottom:1px solid #e9ecef; padding-bottom:.4rem; }
.reg-sect-lbl {
    font-size:.59rem; font-weight:800; letter-spacing:.1em;
    text-transform:uppercase; white-space:nowrap;
    padding:.17rem .4rem; border-radius:.2rem; flex-shrink:0;
}
.reg-sect-lbl.lbl-fecha { background:#eff6ff; color:#1d4ed8; border:1px solid #bfdbfe; }
.reg-sect-lbl.lbl-filt  { background:#f0fdf4; color:#15803d; border:1px solid #bbf7d0; }
.reg-sect-lbl.lbl-acc   { background:#faf5ff; color:#7c3aed; border:1px solid #ddd6fe; }
/* Grupo de fechas */
.reg-f-grp {
    display:flex; align-items:center; gap:.22rem;
    background:#f8faff; border:1px solid #c7d2fe;
    border-radius:.3rem; padding:.2rem .5rem; flex-shrink:0;
}
.reg-f-grp.grp-entrega { background:#f0fdf9; border-color:#a7f3d0; }
.reg-f-lbl { font-size:.61rem; font-weight:700; white-space:nowrap; color:#4338ca; }
.reg-f-grp.grp-entrega .reg-f-lbl { color:#065f46; }
/* Grupos de filtro */
.reg-filt-grp {
    display:flex; align-items:center; gap:.28rem;
    background:#f8fdf8; border:1px solid #d1fae5;
    border-radius:.3rem; padding:.2rem .5rem; flex-shrink:0;
}
.reg-filt-grp.grp-prod { background:#fdf4ff; border-color:#e9d5ff; }
.reg-filt-lbl {
    font-size:.58rem; font-weight:800; white-space:nowrap;
    color:#166534; text-transform:uppercase; letter-spacing:.06em;
}
.reg-filt-grp.grp-prod .reg-filt-lbl { color:#6b21a8; }
/* Separador vertical */
.reg-vsep { width:1px; height:1.4rem; background:#dee2e6; flex-shrink:0; align-self:center; }

/* Columna oculta via toggle */
.col-hidden { display: none !important; }

/* Celda de kg */
.td-kg { font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }

/* Celda de fecha vencida */
.date-venc { color: #e53e3e; font-weight: 600; }

/* Resaltar búsqueda */
.search-hl { background: #fff3cd; border-radius: 2px; }

/* Panel sin resultados */
.reg-empty {
    text-align: center; padding: 3rem 1rem;
    color: #a0aec0; font-size: .9rem;
}

/* Spinner overlay */
#regLoadingOverlay {
    position: fixed; inset: 0; z-index: 9999;
    background: rgba(26,32,44,.7);
    display: flex; align-items: center; justify-content: center;
}
</style>
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Produccion" asp-action="Index">Producción</a></li>
    <li class="breadcrumb-item active">Registro de Pedidos</li>
}

@await Html.PartialAsync("_PlnNavBar")

@* ── Spinner de carga ───────────────────────────────────────────────── *@
<div id="regLoadingOverlay" style="display:none;">
    <div class="text-center text-white">
        <div class="spinner-border text-light mb-2" style="width:2.5rem;height:2.5rem;"></div>
        <div class="fw-bold">Cargando pedidos…</div>
    </div>
</div>

@* ── STRIP KPIs ─────────────────────────────────────────────────────── *@
<div class="reg-strip">
    <span class="reg-strip-title"><i class="bi bi-journal-text me-1"></i>Registro de Pedidos</span>
    <span class="reg-strip-sep" style="width:1px;height:1.2rem;background:rgba(255,255,255,.25);flex-shrink:0;"></span>
    <span class="reg-kpi"><i class="bi bi-box-seam-fill"></i><span class="reg-kpi-val" id="kpiPedidos">@Model.TotalPedidos</span>&nbsp;ped.</span>
    <span class="reg-kpi"><i class="bi bi-list-ul"></i><span class="reg-kpi-val" id="kpiItems">@Model.TotalItems</span>&nbsp;ítems</span>
    <span class="reg-kpi"><i class="bi bi-bag-fill"></i><span class="reg-kpi-val" id="kpiKg">@Model.TotalKg.ToString("N0")</span>&nbsp;kg</span>
    <span class="reg-kpi reg-kpi-hil"><i class="bi bi-wind"></i><span class="reg-kpi-val" id="kpiHil">@Model.KgHilanderia.ToString("N0")</span>&nbsp;kg Hil.</span>
    <span class="reg-kpi reg-kpi-tint"><i class="bi bi-droplet-half"></i><span class="reg-kpi-val" id="kpiTint">@Model.KgTintoreria.ToString("N0")</span>&nbsp;kg Tint.</span>
    @if (Model.ItemsConVencido > 0)
    {
    <span class="reg-kpi reg-kpi-warn"><i class="bi bi-exclamation-triangle-fill"></i><span class="reg-kpi-val">@Model.ItemsConVencido</span>&nbsp;vencidos</span>
    }
    <span class="ms-auto" style="font-size:.68rem;color:#a0aec0;">@(Model.FchDesde?.ToString("dd/MM/yy") ?? "—") – @(Model.FchHasta?.ToString("dd/MM/yy") ?? "—") &nbsp;|&nbsp; <a asp-action="Dashboard" style="color:#90cdf4;">→ Seguimiento de Pedidos</a></span>
</div>

@* ── TOOLBAR ─────────────────────────────────────────────────────── *@
<form method="get" asp-action="RegistroPedido" id="regForm">
<input type="hidden" name="grupo" id="inpGrupo" value="@Model.FiltroGrupo" />
<div class="reg-toolbar">

  @* ── COL IZQ: FECHAS ────────────────────────────────────────────── *@
  <div class="reg-col-izq">
    <div>
      <span class="reg-sect-lbl lbl-fecha" style="display:inline-flex;"><i class="bi bi-calendar3 me-1"></i>Fechas</span>
    </div>

    @* F.Registro (servidor) *@
    <div>
      <div class="reg-f-grp">
        <span class="reg-f-lbl">Registro</span>
        <input type="date" name="fchDesde" id="inpDesde" value="@(Model.FchDesde?.ToString("yyyy-MM-dd") ?? "")"
               class="form-control form-control-sm" style="width:108px;font-size:.74rem;" />
        <span style="font-size:.65rem;color:#9ca3af;">–</span>
        <input type="date" name="fchHasta" id="inpHasta" value="@(Model.FchHasta?.ToString("yyyy-MM-dd") ?? "")"
               class="form-control form-control-sm" style="width:108px;font-size:.74rem;" />
        <button type="submit" class="btn btn-sm btn-primary ms-1" style="font-size:.72rem;padding:.18rem .55rem;" title="Consultar Oracle con este rango de F. Registro">
          <i class="bi bi-arrow-clockwise"></i>
        </button>
      </div>
      <div class="d-flex gap-1 mt-1 ms-1" style="align-items:center;">
        <button type="button" class="btn btn-sm btn-outline-secondary" style="font-size:.63rem;padding:.1rem .3rem;" onclick="setRango(0)">Hoy</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" style="font-size:.63rem;padding:.1rem .3rem;" onclick="setRango(7)">7d</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" style="font-size:.63rem;padding:.1rem .3rem;" onclick="setRango(30)">30d</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" style="font-size:.63rem;padding:.1rem .3rem;" onclick="setRango(90)">3m</button>
        <span style="font-size:.58rem;color:#6366f1;margin-left:.2rem;" title="Consulta Oracle — requiere recargar">🗄️ Oracle</span>
      </div>
    </div>

    @* F.Entrega (servidor — va a Oracle) *@
    <div>
      <div class="reg-f-grp grp-entrega">
        <span class="reg-f-lbl"><i class="bi bi-truck me-1"></i>Entrega</span>
        <input type="date" name="fchEntDesde" id="inpEntDesde"
               value="@(Model.FchEntDesde?.ToString("yyyy-MM-dd") ?? "")"
               class="form-control form-control-sm" style="width:108px;font-size:.74rem;" />
        <span style="font-size:.65rem;color:#9ca3af;">–</span>
        <input type="date" name="fchEntHasta" id="inpEntHasta"
               value="@(Model.FchEntHasta?.ToString("yyyy-MM-dd") ?? "")"
               class="form-control form-control-sm" style="width:108px;font-size:.74rem;" />
        <button type="submit" class="btn btn-sm btn-primary ms-1" style="font-size:.72rem;padding:.18rem .55rem;" title="Consultar Oracle con este rango de F. Entrega">
          <i class="bi bi-arrow-clockwise"></i>
        </button>
      </div>
      <div class="ms-1 mt-1" style="font-size:.58rem;color:#6366f1;">🗄️ Oracle</div>
    </div>
  </div>

  @* ── COL DER: FILTROS + ACCIONES ────────────────────────────────── *@
  <div class="reg-col-der">

  @* ── FILTROS ─────────────────────────────────────────────────────── *@
  <div class="reg-sect">
    <span class="reg-sect-lbl lbl-filt"><i class="bi bi-funnel me-1"></i>Filtros</span>
    <span style="font-size:.59rem;color:#6c757d;align-self:center;">⚡ instantáneo</span>

    @* Búsqueda libre + Estado + Cliente *@
    <div class="reg-filt-grp">
      <span class="reg-filt-lbl">Buscar</span>
      <input type="text" id="regSearch" placeholder="&#128269; texto libre&hellip;"
             class="form-control form-control-sm" style="width:160px;font-size:.73rem;"
             autocomplete="off" />
      <span class="reg-filt-lbl" style="margin-left:.3rem;">Pedido</span>
      <select id="selEstado" class="form-select form-select-sm" style="width:130px;font-size:.73rem;" title="Estado del pedido">
        <option value="">Estado</option>
        @foreach (var est in new[] { ("0","Sin Aprobar"), ("5","Aprobado"), ("6","Cerrado"), ("9","Anulado") })
        {
          if (Model.FiltroEstado == est.Item1)
          { <option value="@est.Item1" selected>@est.Item2</option> }
          else
          { <option value="@est.Item1">@est.Item2</option> }
        }
      </select>
      <input type="text" id="inpCliente" placeholder="Cliente…" autocomplete="off"
             value="@Model.FiltroCliente"
             class="form-control form-control-sm" style="width:138px;font-size:.73rem;" />
    </div>

    <div class="reg-vsep"></div>

    @* Material *@
    <div class="reg-filt-grp">
      <span class="reg-filt-lbl">Material</span>
      <select id="selServ" class="form-select form-select-sm" style="width:138px;font-size:.73rem;" title="Tipo de servicio">
        <option value="">Servicio</option>
        @foreach (var svc in new[] {
            ("C",   "C — Hilandería"),
            ("CT",  "CT — Hil. + Tint."),
            ("ST",  "ST — Solo Tint."),
            ("RT",  "RT — Retorcedora") }
          .Concat(servicios.Where(x => x != "C" && x != "CT" && x != "ST" && x != "RT" && x != "Z").Select(x => (x, x))))
        {
          if (Model.FiltroServ == svc.Item1)
          { <option value="@svc.Item1" selected>@svc.Item2</option> }
          else
          { <option value="@svc.Item1">@svc.Item2</option> }
        }
      </select>
      <select id="selProceso" class="form-select form-select-sm" style="width:132px;font-size:.73rem;" title="Proceso productivo">
        <option value="">Proceso</option>
        @foreach (var pr in new[] { ("01","01 — Cardado"), ("20","20 — Peinado"), ("24","24 — P.Gaseado") })
        {
          if (Model.FiltroProceso == pr.Item1)
          { <option value="@pr.Item1" selected>@pr.Item2</option> }
          else
          { <option value="@pr.Item1">@pr.Item2</option> }
        }
      </select>
      <select id="selFibra" class="form-select form-select-sm" style="width:140px;font-size:.73rem;" title="Tipo de fibra (código ITEMPED_DET)">
        <option value="">Fibra</option>
        @foreach (var tf in tfibras)
        {
          if (Model.FiltroTfibra == tf.cod)
          { <option value="@tf.cod" selected>@tf.cod — @tf.desc</option> }
          else
          { <option value="@tf.cod">@tf.cod — @tf.desc</option> }
        }
      </select>
    </div>

    <div class="reg-vsep"></div>

    @* Producción / PLN *@
    <div class="reg-filt-grp grp-prod">
      <span class="reg-filt-lbl">Producc.</span>
      <select id="selPaso" class="form-select form-select-sm" style="width:170px;font-size:.73rem;" title="Paso activo en PLN (código de etapa)">
        <option value="">Estado PLN</option>
        @foreach (var p in pasosActivos)
        {
          if (Model.FiltroPasoActual == p.cod)
          { <option value="@p.cod" selected>@p.name</option> }
          else
          { <option value="@p.cod">@p.name</option> }
        }
      </select>
    </div>
  </div>

  @* ── SECCIÓN: ACCIONES ───────────────────────────────────────────── *@
  <div class="reg-sect">
    <span class="reg-sect-lbl lbl-acc"><i class="bi bi-gear me-1"></i>Acciones</span>

    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="resetForm()" style="font-size:.74rem;" title="Limpiar todos los filtros">
      <i class="bi bi-x-circle me-1"></i>Limpiar
    </button>

    <div class="reg-vsep"></div>

    @* Agrupamiento *@
    <div class="btn-group btn-group-sm" id="groupBtns" role="group" aria-label="Agrupar por">
      <button type="button" class="btn btn-primary"         data-group="dia">&#128197;&nbsp;Día</button>
      <button type="button" class="btn btn-outline-primary" data-group="servicio">&#127981;&nbsp;Serv.</button>
      <button type="button" class="btn btn-outline-primary" data-group="familia">&#9725;&nbsp;Línea</button>
      <button type="button" class="btn btn-outline-primary" data-group="cliente">&#128100;&nbsp;Cliente</button>
      <button type="button" class="btn btn-outline-primary" data-group="proceso">&#9881;&#65039;&nbsp;Proceso</button>
      <button type="button" class="btn btn-outline-primary" data-group="paso">&#128260;&nbsp;PLN</button>
      <button type="button" class="btn btn-outline-primary" data-group="none">&#128203;&nbsp;Plano</button>
    </div>

    <div class="reg-vsep"></div>

    @* Toggle columnas *@
    <div class="dropdown">
      <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
              data-bs-toggle="dropdown" style="font-size:.71rem;">
        <i class="bi bi-layout-three-columns"></i>&nbsp;Cols
      </button>
      <ul class="dropdown-menu dropdown-menu-end p-2" style="min-width:185px;font-size:.77rem;" id="colToggleMenu">
        <li class="dropdown-item py-0 px-1 text-muted" style="font-size:.62rem;font-weight:700;letter-spacing:.05em;">ACTIVAS POR DEFECTO</li>
        <li><label class="dropdown-item d-flex gap-2 py-1"><input type="checkbox" class="col-chk" data-col="colTfibra"  checked> T.Fibra</label></li>
        <li><label class="dropdown-item d-flex gap-2 py-1"><input type="checkbox" class="col-chk" data-col="colColor"   checked> Color / Intens.</label></li>
        <li><label class="dropdown-item d-flex gap-2 py-1"><input type="checkbox" class="col-chk" data-col="colLinea"   checked> Familia / Línea</label></li>
        <li><label class="dropdown-item d-flex gap-2 py-1"><input type="checkbox" class="col-chk" data-col="colPaso"    checked> Estado PLN</label></li>
        <li><label class="dropdown-item d-flex gap-2 py-1"><input type="checkbox" class="col-chk" data-col="colRetraso" checked> Retraso</label></li>
        <li class="dropdown-divider"></li>
        <li class="dropdown-item py-0 px-1 text-muted" style="font-size:.62rem;font-weight:700;letter-spacing:.05em;">OPCIONALES</li>
        <li><label class="dropdown-item d-flex gap-2 py-1"><input type="checkbox" class="col-chk" data-col="colRmc"           > RMC / Lote</label></li>
        <li><label class="dropdown-item d-flex gap-2 py-1"><input type="checkbox" class="col-chk" data-col="colKgPend"        > Kg Pendiente</label></li>
        <li><label class="dropdown-item d-flex gap-2 py-1"><input type="checkbox" class="col-chk" data-col="colVende"         > Vendedor</label></li>
        <li><label class="dropdown-item d-flex gap-2 py-1"><input type="checkbox" class="col-chk" data-col="colFechAprob"     > F. Aprobación</label></li>
        <li><label class="dropdown-item d-flex gap-2 py-1"><input type="checkbox" class="col-chk" data-col="colDetalle"       > Observación</label></li>
      </ul>
    </div>

    <button type="button" id="btnCollapseAll" class="btn btn-sm btn-outline-secondary" onclick="collapseAll()" style="font-size:.71rem;" title="Colapsar todos">
      <i class="bi bi-arrows-collapse"></i>
    </button>
    <button type="button" id="btnExpandAll"   class="btn btn-sm btn-outline-secondary" onclick="expandAll()"  style="font-size:.71rem;" title="Expandir todos">
      <i class="bi bi-arrows-expand"></i>
    </button>

    <div class="reg-vsep"></div>

    <button type="button" class="btn btn-sm btn-outline-success" onclick="exportCSV()" style="font-size:.71rem;">
      <i class="bi bi-download me-1"></i>CSV
    </button>
  </div>

  </div>@* /reg-col-der *@

</div>
</form>

@* ── TABLA DINÁMICA (eliminando restos del form anterior) ──────────── *@
<div id="regTableContainer">

@* Modo agrupado: tarjetas estilo Dashboard *@
<div id="regGrpContainer"></div>

@* Modo plano: tabla sin agrupamiento *@
<div class="reg-table-wrap" id="regPlanoWrap" style="display:none;">
<table class="reg-table" id="regTable">
    <thead>
        <tr>
            <th data-sort="numPed"        style="min-width:92px;">N°&nbsp;Ped <span class="sort-icon">⇅</span></th>
            <th data-sort="fchPedido"     style="min-width:80px;">Fecha <span class="sort-icon">⇅</span></th>
            <th data-sort="nombreCliente" style="min-width:155px;">Cliente <span class="sort-icon">⇅</span></th>
            <th data-sort="nro"           style="width:36px;text-align:center;">Ítem</th>
            <th data-sort="descArt"       style="min-width:135px;">Artículo <span class="sort-icon">⇅</span></th>
            <th data-sort="descFibra"     class="colTfibra" style="min-width:80px;">T.Fibra <span class="sort-icon">⇅</span></th>
            <th data-sort="nombreProceso" style="min-width:80px;">Proceso <span class="sort-icon">⇅</span></th>
            <th data-sort="areaServicio"  style="min-width:80px;">Servicio <span class="sort-icon">⇅</span></th>
            <th                           class="colRmc"    style="min-width:120px;">RMC / Lote</th>
            <th data-sort="cantidad"      class="td-kg"     style="min-width:65px;">Kg <span class="sort-icon">⇅</span></th>
            <th data-sort="color"         class="colColor"  style="min-width:70px;">Color <span class="sort-icon">⇅</span></th>
            <th                           class="colColor"  style="min-width:48px;">Intens.</th>
            <th data-sort="descFamilia"   class="colLinea"  style="min-width:90px;">Familia <span class="sort-icon">⇅</span></th>
            <th data-sort="descLinea"     class="colLinea"  style="min-width:90px;">Línea <span class="sort-icon">⇅</span></th>
            <th data-sort="fchEntregaCompIso" style="min-width:82px;">F.Entrega <span class="sort-icon">⇅</span></th>
            <th                           class="colRetraso" style="min-width:62px;">Retraso</th>
            <th                           class="colKgPend"  style="min-width:65px;">KgPend</th>
            <th data-sort="estadoPed"     style="min-width:75px;">Estado <span class="sort-icon">⇅</span></th>
            <th data-sort="pasoActual"    class="colPaso"   style="min-width:115px;">Estado PLN <span class="sort-icon">⇅</span></th>
            <th                           class="colVende"   style="min-width:95px;">Vendedor</th>
            <th                           class="colFechAprob" style="min-width:82px;">F.Aprobac.</th>
            <th                           class="colDetalle" style="min-width:140px;">Observación</th>
        </tr>
    </thead>
    <tbody id="regTbody">
    </tbody>
</table>
</div>@* /regPlanoWrap *@
<div id="regEmpty" class="reg-empty" style="display:none;">
    <i class="bi bi-inbox display-5 d-block mb-2"></i>
    Sin resultados para los filtros seleccionados.
</div>
<div class="mt-2 d-flex justify-content-between align-items-center" style="font-size:.72rem;color:#718096;">
    <span id="regCount">@Model.TotalItems ítems | @Model.TotalPedidos pedidos | @Model.TotalKg.ToString("N0") kg</span>
    <span>Fábrica Hilos &nbsp;·&nbsp; Registro de Pedidos</span>
</div>
</div>

@section Scripts {
<script>
// ═══════════════════════════════════════════════════════════════════════
// REGISTRO DE PEDIDOS — motor client-side completo
// ═══════════════════════════════════════════════════════════════════════

const ALL_ITEMS = @Html.Raw(jsonItems);

// ── Estado ──────────────────────────────────────────────────────────────
let activeGroup  = 'dia';
let sortField    = 'fchPedido';
let sortAsc      = false;
let searchTerm   = '';
let filtEstado   = '@Model.FiltroEstado';
let filtCliente  = '@Model.FiltroCliente';
let filtServ     = '@Model.FiltroServ';
let filtProceso  = '@Model.FiltroProceso';
let filtFibra    = '@Model.FiltroTfibra';
let filtPaso     = '@Model.FiltroPasoActual';

// ── Columnas opcionales ────────────────────────────────────────────────
function applyColVisibility() {
    document.querySelectorAll('.col-chk').forEach(chk => {
        const cls = chk.dataset.col;
        const show = chk.checked;
        document.querySelectorAll('.' + cls).forEach(el => {
            el.classList.toggle('col-hidden', !show);
        });
    });
}

// ── Filtrado live (búsqueda) ───────────────────────────────────────────
function filterItems(items) {
    let res = items;
    if (searchTerm) {
        const q = searchTerm.toLowerCase();
        res = res.filter(r =>
            (r.numPed + '').includes(q) ||
            r.nombreCliente.toLowerCase().includes(q) ||
            r.codArt.toLowerCase().includes(q) ||
            r.descArt.toLowerCase().includes(q) ||
            (r.descFibra || '').toLowerCase().includes(q) ||
            r.color.toLowerCase().includes(q) ||
            r.colorDet.toLowerCase().includes(q) ||
            r.areaServicio.toLowerCase().includes(q) ||
            r.codServ.toLowerCase().includes(q) ||
            r.nombreProceso.toLowerCase().includes(q) ||
            r.descFamilia.toLowerCase().includes(q) ||
            r.descLinea.toLowerCase().includes(q) ||
            (r.pasoActual || '').toLowerCase().includes(q) ||
            (r.nombreVende || r.codVende).toLowerCase().includes(q) ||
            r.detalle.toLowerCase().includes(q) ||
            (r.rmc || '').toLowerCase().includes(q) ||
            (r.descRmc || '').toLowerCase().includes(q) ||
            (r.lote || '').toLowerCase().includes(q) ||
            (r.nroRmc != null && ('' + r.nroRmc).includes(q))
        );
    }
    // Filtros client-side instantáneos
    if (filtEstado) {
        const estadoMap = {'0':'Sin Aprobar','5':'Aprobado','6':'Cerrado','9':'Anulado'};
        const estadoTxt = estadoMap[filtEstado] ?? filtEstado;
        res = res.filter(r => r.estadoPed === estadoTxt);
    }
    if (filtCliente) {
        const qc = filtCliente.toLowerCase();
        res = res.filter(r => r.nombreCliente.toLowerCase().includes(qc) || r.codCliente.toLowerCase().includes(qc));
    }
    if (filtServ)    res = res.filter(r => r.codServ    === filtServ);
    if (filtProceso) res = res.filter(r => r.proceso    === filtProceso);
    if (filtFibra)   res = res.filter(r => r.tipoFibra  === filtFibra);
    if (filtPaso)    res = res.filter(r => r.codPasoAct === filtPaso);
    return res;
}

// ── Agrupamiento ───────────────────────────────────────────────────────
function getGroupKey(r) {
    switch (activeGroup) {
        case 'dia':      return r.fchPedido;
        case 'servicio': return r.codServ + ' — ' + r.areaServicio;
        case 'familia':  return r.codFam  + ' — ' + (r.descFamilia || r.codFam || '—');
        case 'cliente':  return r.codCliente + ' — ' + r.nombreCliente;
        case 'proceso':  return r.proceso + ' — ' + r.nombreProceso;
        case 'paso':     return r.pasoActual || '(Sin proceso PLN)';
        default:         return '__all__';
    }
}

function getGroupLabel(key) {
    if (activeGroup === 'dia') {
        const [y,m,d] = key.split('-');
        const dt = new Date(+y, +m-1, +d);
        const dias = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];
        return `${dias[dt.getDay()]}  ${d}/${m}/${y}`;
    }
    return key;
}

// ── Ordenamiento ───────────────────────────────────────────────────────
function sortItems(items) {
    return [...items].sort((a, b) => {
        let va = a[sortField], vb = b[sortField];
        if (typeof va === 'number' && typeof vb === 'number') {
            return sortAsc ? va - vb : vb - va;
        }
        va = (va ?? '').toString().toLowerCase();
        vb = (vb ?? '').toString().toLowerCase();
        return sortAsc ? va.localeCompare(vb) : vb.localeCompare(va);
    });
}

// ── Formatear número ───────────────────────────────────────────────────
const _fmt2 = new Intl.NumberFormat('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const _fmt0 = new Intl.NumberFormat('es-PE', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
function fmtN(n, dec=2) { return dec === 0 ? _fmt0.format(+n) : _fmt2.format(+n); }

// ── Renderizar badge servicio ──────────────────────────────────────────
function badgeServ(r) {
    return `<span class="badge-serv ${r.areaBadge}" title="${r.areaServicio}">${r.codServ}</span>`;
}

// ── Renderizar fila de ítem ────────────────────────────────────────────
function renderRow(r) {
    const ganttUrl = `/Planeamiento/PedidoGantt?numPed=${r.numPed}&serie=${r.serie}`;
    // Fecha entrega: prioridad PLN > ITEMPED_DET > ITEMPED
    const entDisp  = r.fchEntregaComp || r.fhcEntrega || r.fMaxPed;
    const entIso   = r.fchEntregaCompIso || r.fhcEntregaIso || r.fMaxPedIso;
    const isVenc   = r.indRetraso === 'S' || (r.esVencido && !r.fchEntregaComp);
    const entCls   = isVenc ? ' date-venc' : '';
    const entIco   = isVenc ? ' <i class="bi bi-exclamation-circle-fill text-danger" title="Vencido/Retrasado"></i>' : '';
    // Urgente
    const urgIco   = (r.indUrgente === 'S' || r.urgente === 'S')
        ? '<i class="bi bi-lightning-charge-fill text-warning me-1" title="Urgente"></i>' : '';
    // Retraso badge
    const retBadge = r.indRetraso === 'S' && r.diasRetraso > 0
        ? `<span class="badge bg-danger" style="font-size:.6rem;">-${r.diasRetraso}d</span>`
        : r.esVencido
        ? '<span class="badge bg-warning text-dark" style="font-size:.6rem;" title="Vencido"><i class="bi bi-exclamation-triangle-fill"></i></span>'
        : '<span class="text-muted" style="font-size:.7rem;">—</span>';
    // KgPendiente
    const kgPend   = r.kgPendientes > 0
        ? `<span class="td-kg" style="color:#c05621;">${fmtN(r.kgPendientes)}</span>`
        : '<span class="text-muted">—</span>';
    // RMC + Lote
    const rmcDisp  = r.nroRmc
        ? `<span class="fw-bold text-secondary">#${r.nroRmc}</span> ${r.rmc}${r.descRmc ? ' <small class="text-muted">' + r.descRmc + '</small>' : ''}`
        : '';
    const loteDisp = r.lote ? `<small class="text-muted d-block">Lote: ${r.lote}</small>` : '';
    const estadoBadge = r.estadoPed === 'Sin Aprobar'
        ? '<span class="badge bg-warning text-dark" style="font-size:.6rem;">Sin Aprob.</span>'
        : r.estadoPed === 'Aprobado'
        ? '<span class="badge bg-success" style="font-size:.6rem;">Aprobado</span>'
        : r.estadoPed === 'Cerrado'
        ? '<span class="badge bg-secondary" style="font-size:.6rem;">Cerrado</span>'
        : r.estadoPed === 'Anulado'
        ? '<span class="badge bg-danger" style="font-size:.6rem;">Anulado</span>'
        : `<span class="badge bg-secondary" style="font-size:.6rem;">${r.estadoPed}</span>`;
    const pasoBadge  = r.pasoActual
        ? `<span class="badge" style="background-color:${r.pasoColor};font-size:.6rem;">${r.pasoActual}</span>`
        : '<span class="text-muted">—</span>';
    const tfibDisp   = (r.descFibra && r.descFibra !== '.') ? r.descFibra : r.tipoFibra || '';
    const vendDisp   = r.nombreVende || r.codVende;
    const intensDisp = r.intensidadAbrev || r.intensidad;
    return `<tr>
  <td>${urgIco}<a href="${ganttUrl}" class="fw-bold text-primary text-decoration-none">${r.numPed}</a></td>
  <td>${r.fchPedidoDisp}</td>
  <td title="${r.codCliente}: ${r.nombreCliente}">${r.nombreCliente.length>28 ? r.nombreCliente.slice(0,28)+'…' : r.nombreCliente}</td>
  <td class="text-center">${r.nro}</td>
  <td title="${r.codArt}  ${r.titulo}">${r.descArt.length>24?r.descArt.slice(0,24)+'…':r.descArt}</td>
  <td class="colTfibra" title="${r.tipoFibra}">${tfibDisp}</td>
  <td><span class="badge bg-secondary" style="font-size:.6rem;">${r.nombreProceso||r.proceso}</span></td>
  <td>${badgeServ(r)}</td>
  <td class="colRmc">${rmcDisp}${loteDisp}</td>
  <td class="td-kg fw-bold">${fmtN(r.cantidad)}</td>
  <td class="colColor">${r.color}${r.colorDet?' / '+r.colorDet:''}</td>
  <td class="colColor">${intensDisp}</td>
  <td class="colLinea">${r.descFamilia}</td>
  <td class="colLinea">${r.descLinea}</td>
  <td class="${entCls}">${entDisp}${entIco}</td>
  <td class="colRetraso">${retBadge}</td>
  <td class="colKgPend">${kgPend}</td>
  <td>${estadoBadge}</td>
  <td class="colPaso">${pasoBadge}</td>
  <td class="colVende">${vendDisp}</td>
  <td class="colFechAprob">${r.fchAprobacion}</td>
  <td class="colDetalle" title="${r.detalle}" style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${r.detalle}</td>
</tr>`;
}

/// ── Render principal ──────────────────────────────────────────────
function render() {
    const items   = sortItems(filterItems(ALL_ITEMS));
    const grpCont = document.getElementById('regGrpContainer');
    const plano   = document.getElementById('regPlanoWrap');
    const tbody   = document.getElementById('regTbody');
    const empty   = document.getElementById('regEmpty');
    const countEl = document.getElementById('regCount');

    if (items.length === 0) {
        grpCont.innerHTML = '';
        if (tbody) tbody.innerHTML = '';
        plano.style.display = 'none';
        empty.style.display = '';
        countEl.textContent = '0 ítems';
        updateKpis([]);
        return;
    }
    empty.style.display = 'none';

    // ── Modo plano (sin agrupamiento) ────────────────────────────
    if (activeGroup === 'none') {
        grpCont.innerHTML = '';
        plano.style.display = '';
        if (tbody) tbody.innerHTML = items.map(renderRow).join('');
        updateKpis(items);
        countEl.textContent = `${items.length} ítems | ${new Set(items.map(x=>x.numPed)).size} pedidos | ${fmtN(items.reduce((s,x)=>s+x.cantidad,0))} kg`;
        applyColVisibility();
        return;
    }

    // ── Modo agrupado: tarjetas estilo Dashboard ─────────────────
    plano.style.display = 'none';

    const groups = {};
    items.forEach(r => {
        if (activeGroup === 'servicio' && r.codServ === 'Z') return;
        if (activeGroup === 'familia'  && r.codFam  === 'ZVA') return;
        const k = getGroupKey(r);
        if (!groups[k]) groups[k] = [];
        groups[k].push(r);
    });

    const totalKg   = items.reduce((s,x) => s+x.cantidad, 0);
    let   html      = '';

    Object.entries(groups).sort((a,b) => {
        if (activeGroup === 'dia') return b[0].localeCompare(a[0]);
        // Para paso: '(Sin proceso PLN)' siempre al final
        if (activeGroup === 'paso') {
            if (a[0] === '(Sin proceso PLN)') return 1;
            if (b[0] === '(Sin proceso PLN)') return -1;
        }
        return a[0].localeCompare(b[0]);
    }).forEach(([key, gItems]) => {
        const grpId = 'grp_' + key.split('').reduce((h,c) => (Math.imul(31,h) + c.charCodeAt(0)) | 0, 0).toString(16).replace('-','m');
        const gKg   = gItems.reduce((s,x) => s+x.cantidad, 0);
        const gPed  = new Set(gItems.map(x=>x.numPed)).size;
        const rows  = gItems.map(renderRow).join('');
        // Indicador de color para grupos de tipo "paso"
        const pasoColorSample = (activeGroup === 'paso' && gItems[0]?.pasoColor && key !== '(Sin proceso PLN)')
            ? gItems[0].pasoColor : '';
        const pasoIndicator = pasoColorSample
            ? `<span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:${pasoColorSample};flex-shrink:0;margin-right:4px;"></span>`
            : '';

        html += `
<div class="reg-grp-card">
  <div class="reg-grp-head" data-collapse-target="${grpId}"
       onclick="toggleGrpCard(event,'${grpId}')">
    <i class="bi bi-chevron-right toggle-icon" style="font-size:.75rem;flex-shrink:0;color:#718096;"></i>
    ${pasoIndicator}<span class="reg-grp-num">${getGroupLabel(key)}</span>
    <span class="reg-grp-meta ms-auto">
      <span class="reg-grp-meta-item reg-grp-meta-kg">
        <i class="bi bi-box2 me-1 text-secondary"></i>${fmtN(gKg,0)} kg
      </span>
      <span class="reg-grp-meta-item">
        <i class="bi bi-list-ul me-1 text-secondary"></i>${gItems.length} ítems
      </span>
      <span class="reg-grp-meta-item">
        <i class="bi bi-file-earmark me-1 text-secondary"></i>${gPed} ped.
      </span>
    </span>
  </div>
  <div class="collapse" id="${grpId}">
    <div style="overflow-x:auto;">
      ${_subThead}
        ${rows}
      </tbody></table>
    </div>
  </div>
</div>`;
    });

    grpCont.innerHTML = html;

    // Registrar eventos Bootstrap Collapse para rotar chevron
    grpCont.querySelectorAll('.collapse').forEach(el => {
        el.addEventListener('show.bs.collapse', function() {
            const head = document.querySelector(`[data-collapse-target="${this.id}"]`);
            if (head) head.querySelector('.toggle-icon')?.classList.add('rotated');
        });
        el.addEventListener('hide.bs.collapse', function() {
            const head = document.querySelector(`[data-collapse-target="${this.id}"]`);
            if (head) head.querySelector('.toggle-icon')?.classList.remove('rotated');
        });
    });

    updateKpis(items);
    countEl.textContent = `${items.length} ítems | ${new Set(items.map(x=>x.numPed)).size} pedidos | ${fmtN(totalKg)} kg`;
    applyColVisibility();
}

// ── Thead reutilizable para sub-tablas ────────────────────────────
// ── Thead estático cacheado: se evalúa una sola vez en toda la vida del módulo ──
const _subThead = `<table class="reg-subtbl" style="width:100%;border-collapse:collapse;">
  <thead><tr>
    <th style="min-width:90px;">N° Ped</th>
