@model FabricaHilos.Models.Sire.SireMonitoreoViewModel
@{
    ViewData["Title"] = "SIRE — Monitoreo";

    string IconLog(bool exito) => exito
        ? "bi-check-circle-fill text-success"
        : "bi-x-circle-fill text-danger";

    string BadgeOp(string? op) => op switch
    {
        "AUTH"       => "bg-primary",
        "EXPORTAR"   => "bg-info text-dark",
        "TICKET"     => "bg-secondary",
        "DESCARGAR"  => "bg-warning text-dark",
        "CARGAR"     => "bg-primary bg-opacity-75",
        "COMPLETAR"  => "bg-success",
        "GUARDAR"    => "bg-info text-dark",
        "INICIAR"    => "bg-secondary",
        "REPROCESAR" => "bg-warning text-dark",
        "CANCEL"     => "bg-danger",
        _            => "bg-light text-dark border"
    };

    string BadgeHttp(int? status) => status switch
    {
        >= 200 and < 300 => "bg-success",
        >= 400 and < 500 => "bg-warning text-dark",
        >= 500           => "bg-danger",
        _                => "bg-secondary"
    };
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Contabilidad" asp-action="Index">Contabilidad</a></li>
    <li class="breadcrumb-item"><a asp-controller="Sire" asp-action="Index">SIRE</a></li>
    <li class="breadcrumb-item active">Monitoreo</li>
}

@section Styles {
    <link rel="stylesheet" href="~/css/sire.css" asp-append-version="true" />
}

@await Html.PartialAsync("~/Views/Contabilidad/Sire/_SireNavBar.cshtml")

<div class="sire-strip">
    <i class="bi bi-activity" style="color:#90cdf4;font-size:.95rem;flex-shrink:0;"></i>
    <span class="sire-strip-title">Monitoreo SIRE</span>
    <span class="sire-strip-sep"></span>
    <span class="sire-kpi">
        <i class="bi bi-send-fill" style="color:#90cdf4;"></i>
        <span class="sire-kpi-val">@Model.ApiTotal</span><span style="opacity:.75">llamadas</span>
    </span>
    <span class="sire-kpi">
        <i class="bi bi-check2-all" style="color:#68d391;"></i>
        <span class="sire-kpi-val">@Model.ApiExitosos</span><span style="opacity:.75">ok</span>
    </span>
    <span class="sire-kpi">
        <i class="bi bi-x-lg" style="color:#fc8181;"></i>
        <span class="sire-kpi-val">@Model.ApiFallidos</span><span style="opacity:.75">error</span>
    </span>
    @if (Model.ApiDuracionPromMs.HasValue)
    {
        <span class="sire-kpi" title="Duración promedio de llamadas HTTP">
            <i class="bi bi-stopwatch" style="color:#b794f4;"></i>
            <span class="sire-kpi-val">@Model.ApiDuracionPromMs ms</span>
            <span style="opacity:.75">prom.</span>
        </span>
    }
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-4">
        <div class="sire-kpi-card">
            <div class="sire-kpi-card-icon"><i class="bi bi-send-fill" style="color:var(--sire-accent);"></i></div>
            <div>
                <div class="sire-kpi-card-label">Llamadas HTTP</div>
                <div class="sire-kpi-card-value">@Model.ApiTotal</div>
                <div class="sire-kpi-card-sub">@Model.ApiExitosos ok · @Model.ApiFallidos error</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="sire-kpi-card rce">
            <div class="sire-kpi-card-icon rce"><i class="bi bi-stopwatch-fill"></i></div>
            <div>
                <div class="sire-kpi-card-label">Duración prom.</div>
                <div class="sire-kpi-card-value">@(Model.ApiDuracionPromMs.HasValue ? $"{Model.ApiDuracionPromMs} ms" : "—")</div>
                <div class="sire-kpi-card-sub">Llamadas con datos</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="sire-kpi-card @(Model.ApiFallidos > 0 ? "warn" : "ok")">
            <div class="sire-kpi-card-icon @(Model.ApiFallidos > 0 ? "warn" : "ok")"><i class="bi bi-@(Model.ApiFallidos > 0 ? "exclamation-triangle-fill" : "check-all")"></i></div>
            <div>
                <div class="sire-kpi-card-label">Tasa de éxito</div>
                <div class="sire-kpi-card-value">@(Model.ApiTotal > 0 ? $"{Math.Round((double)Model.ApiExitosos / Model.ApiTotal * 100, 1)}%" : "—")</div>
                <div class="sire-kpi-card-sub">@Model.ApiLogsVentas.Count RVIE · @Model.ApiLogsCompras.Count RCE</div>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.FiltroJobId) || !string.IsNullOrWhiteSpace(Model.FiltroOperacion))
{
    <div class="alert alert-info d-flex align-items-center gap-2 py-2 mb-3" role="alert">
        <i class="bi bi-funnel-fill"></i>
        <span>Filtro activo:</span>
        @if (!string.IsNullOrWhiteSpace(Model.FiltroJobId))
        {
            <span class="badge bg-primary">JobId: @Model.FiltroJobId</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.FiltroOperacion))
        {
            <span class="badge bg-secondary">Operación: @Model.FiltroOperacion</span>
        }
        <a asp-action="Monitoreo" asp-route-tab="log" class="btn btn-sm btn-outline-secondary ms-auto">
            <i class="bi bi-x-circle me-1"></i>Quitar filtro
        </a>
    </div>
}

<ul class="nav nav-tabs mb-0" id="monitoreoTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active"
                id="tab-log" data-bs-toggle="tab" data-bs-target="#pane-log"
                type="button" role="tab">
            <i class="bi bi-journal-code me-1"></i>
            Log HTTP (SUNAT)
            <span class="badge @(Model.ApiFallidos > 0 ? "bg-warning text-dark" : "bg-secondary") ms-1">@Model.ApiTotal</span>
        </button>
    </li>
</ul>

<div class="tab-content sire-card border-top-0" style="border-radius:0 0 8px 8px;">

    <div class="tab-pane fade show active" id="pane-log" role="tabpanel">
        <div class="sire-card-header border-bottom-0 pb-2">
            <i class="bi bi-journal-code"></i>
            <span>Auditoría de llamadas HTTP a SUNAT</span>
            <span class="ms-auto me-2 sire-badge sire-badge-rvie" title="RVIE — Ventas">
                <i class="bi bi-receipt-cutoff me-1"></i>@Model.ApiLogsVentas.Count RVIE
            </span>
            <span class="sire-badge sire-badge-rce" title="RCE — Compras">
                <i class="bi bi-cart-check me-1"></i>@Model.ApiLogsCompras.Count RCE
            </span>
        </div>

        <!-- Filtros -->
        <div class="px-3 pb-2 pt-1 border-bottom">
            <form method="get" asp-action="Monitoreo" class="row g-2 align-items-end">
                <input type="hidden" name="tab" value="log" />
                <div class="col-auto">
                    <label class="form-label small mb-1">JobId</label>
                    <input type="text" name="jobId" value="@Model.FiltroJobId"
                           class="form-control form-control-sm" placeholder="Todos" style="width:230px" />
                </div>
                <div class="col-auto">
                    <label class="form-label small mb-1">Operación</label>
                    <select name="operacion" class="form-select form-select-sm" style="width:150px">
                        <option value="">Todas</option>
                        @foreach (var op in new[] { "AUTH", "EXPORTAR", "TICKET", "DESCARGAR", "GUARDAR", "CARGAR", "COMPLETAR", "REPROCESAR", "CANCEL", "ERROR" })
                        {
                            <option value="@op" selected="@(Model.FiltroOperacion == op)">@op</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-funnel me-1"></i>Filtrar
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.FiltroJobId) || !string.IsNullOrWhiteSpace(Model.FiltroOperacion))
                    {
                        <a asp-action="Monitoreo" asp-route-tab="log" class="btn btn-sm btn-outline-secondary ms-1">
                            <i class="bi bi-x-circle"></i>
                        </a>
                    }
                </div>
            </form>
        </div>

        @{
            // Helper local para renderizar una mini-tabla de logs de auditoría
            async Task RenderLogTable(IReadOnlyList<FabricaHilos.Models.Sire.SireApiLog> logs)
            {
                if (!logs.Any())
                {
                    <div class="text-muted text-center py-4">
                        <i class="bi bi-inbox fs-3 d-block mb-2"></i>Sin registros.
                    </div>
                }
                else
                {
                    <div class="table-responsive" style="max-height:420px;overflow-y:auto;">
                        <table class="table sire-table table-hover align-middle mb-0 small">
                            <thead style="position:sticky;top:0;z-index:1;background:#f8f9fa;">
                                <tr>
                                    <th style="width:140px">Fecha</th>
                                    <th style="width:90px">Operación</th>
                                    <th style="width:55px" class="text-center">HTTP</th>
                                    <th style="width:70px" class="text-center">Dur.</th>
                                    <th style="width:40px" class="text-center">OK</th>
                                    <th>Mensaje</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in logs)
                                {
                                    <tr>
                                        <td class="text-nowrap small text-muted">@log.Fecha.ToLocalTime().ToString("dd/MM HH:mm:ss")</td>
                                        <td><span class="badge @BadgeOp(log.Operacion)" style="font-size:.65rem">@log.Operacion</span></td>
                                        <td class="text-center">
                                            @if (log.HttpStatus.HasValue)
                                            {
                                                <span class="badge @BadgeHttp(log.HttpStatus)" style="font-size:.65rem">@log.HttpStatus</span>
                                            }
                                            else { <span class="text-muted">—</span> }
                                        </td>
                                        <td class="text-center small text-muted">
                                            @(log.DuracionMs.HasValue ? $"{log.DuracionMs}ms" : "—")
                                        </td>
                                        <td class="text-center">
                                            <i class="bi @IconLog(log.Exito)" style="font-size:.85rem"></i>
                                        </td>
                                        <td class="small text-muted"
                                            style="max-width:280px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"
                                            title="@log.Mensaje">
                                            @if (!string.IsNullOrWhiteSpace(log.JobId) && string.IsNullOrWhiteSpace(Model.FiltroJobId))
                                            {
                                                <a asp-action="Monitoreo" asp-route-jobId="@log.JobId" asp-route-tab="log"
                                                   class="font-monospace text-muted text-decoration-none me-1"
                                                   title="Filtrar por este JobId" style="font-size:.7rem">
                                                    [@log.JobId[..Math.Min(log.JobId.Length, 8)]…]
                                                </a>
                                            }
                                            @log.Mensaje
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        }

        <!-- Vista split RVIE / RCE (2 columnas) o tabla única si hay filtro por JobId -->
        @if (!string.IsNullOrWhiteSpace(Model.FiltroJobId))
        {
            <!-- Con filtro JobId: tabla completa unificada (ya sabes cuál job es) -->
            <div class="card-body p-0">
                @{ await RenderLogTable(Model.ApiLogs); }
            </div>
        }
        else
        {
            <!-- Sin filtro: 2 columnas RVIE | RCE -->
            <div class="row g-0">
                <!-- Columna RVIE -->
                <div class="col-md-6 border-end">
                    <div class="px-3 pt-2 pb-1 border-bottom d-flex align-items-center gap-2"
                         style="background:rgba(144,205,244,.08);">
                        <span class="sire-badge sire-badge-rvie">
                            <i class="bi bi-receipt-cutoff me-1"></i>RVIE — Ventas
                        </span>
                        <span class="ms-auto sire-badge sire-badge-secondary">@Model.ApiLogsVentas.Count</span>
                    </div>
                    @{ await RenderLogTable(Model.ApiLogsVentas); }
                </div>
                <!-- Columna RCE -->
                <div class="col-md-6">
                    <div class="px-3 pt-2 pb-1 border-bottom d-flex align-items-center gap-2"
                         style="background:rgba(13,202,240,.08);">
                        <span class="sire-badge sire-badge-rce">
                            <i class="bi bi-cart-check me-1"></i>RCE — Compras
                        </span>
                        <span class="ms-auto sire-badge sire-badge-secondary">@Model.ApiLogsCompras.Count</span>
                    </div>
                    @{ await RenderLogTable(Model.ApiLogsCompras); }
                </div>
            </div>
            <!-- Sistema (AUTH/HEALTH sin job) — fila completa debajo si hay registros -->
            @if (Model.ApiLogsSistema.Any())
            {
                <div class="border-top">
                    <div class="px-3 pt-2 pb-1 border-bottom d-flex align-items-center gap-2"
                         style="background:rgba(100,100,100,.05);">
                        <span class="sire-badge sire-badge-secondary">
                            <i class="bi bi-shield-lock me-1"></i>Sistema (Auth · Health)
                        </span>
                        <span class="ms-auto sire-badge sire-badge-secondary">@Model.ApiLogsSistema.Count</span>
                    </div>
                    @{ await RenderLogTable(Model.ApiLogsSistema); }
                </div>
            }
        }

    </div>

</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const tabParam = new URLSearchParams(window.location.search).get('tab');
        if (tabParam === 'log') {
            const btn = document.getElementById('tab-log');
            if (btn) bootstrap.Tab.getOrCreateInstance(btn).show();
        }
    });
</script>
}
