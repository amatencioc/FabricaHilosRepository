@{
    ViewData["Title"] = "Resumen de Tareo — Planilla Mensual";
}

@section Styles {
<style>
    :root {
        --aq:       #C0622B;
        --aq-dk:    #9E4D20;
        --aq-lt:    #FEF3EB;
        --aq-mid:   #F5D5BC;
        --aq-ok:    #4E7E58;
        --aq-ok-lt: #EAF4EC;
        --aq-info:  #7A6E9E;
        --aq-ilt:   #F2EDF7;
        --aq-err:   #AE3F3C;
    }
    .filter-bar { background:#f8f9fa; border-bottom:1px solid #dee2e6; padding:.85rem 1.2rem; }
    .filter-bar .form-label { font-size:.78rem; font-weight:600; margin-bottom:.2rem; }
    .filter-bar .form-select, .filter-bar .form-control { font-size:.83rem; }
    .form-control:focus, .form-select:focus { border-color:var(--aq); box-shadow:0 0 0 .2rem rgba(192,98,43,.15); }

    .res-table { font-size:.78rem; }
    .res-table thead th {
        background:#f1f3f5; color:#495057;
        font-size:.7rem; font-weight:600; text-transform:uppercase; letter-spacing:.4px;
        white-space:nowrap; padding:.5rem .45rem;
        border-bottom:2px solid var(--aq-mid);
        position:sticky; z-index:1;
    }
    /* Cabecera de 2 filas: cada fila debe "apilarse" en su propio offset vertical,
       no ambas en top:0 (eso hacia que la 2da fila se superpusiera sobre la 1ra
       al hacer scroll, perdiendo la coherencia visual de las columnas).
       El offset de la 2da fila se calcula por JS (altura real de la 1ra fila),
       ya que forzar un "height" fijo rompería las celdas con rowspan="2" (Cód./Nombre). */
    .res-table thead tr:first-child  th { top:0; z-index:2; }
    .res-table thead tr:nth-child(2) th { top: var(--thead-row1-h, 2.05rem); }
    .res-table tbody tr:hover { background:var(--aq-lt); }
    .res-table tbody td { padding:.38rem .45rem; vertical-align:middle; white-space:nowrap; }
    .res-table .col-sep { border-left:2px solid rgba(0,0,0,.10) !important; }

    /* grupos de columnas (encabezados) */
    .th-grp-ef   { background:var(--aq-lt)  !important; color:var(--aq)      !important; }
    .th-grp-perm { background:#f0f4e8       !important; color:#4E7E58        !important; }
    .th-grp-he   { background:var(--aq-mid) !important; color:var(--aq-dk)   !important; }
    .th-grp-info { background:var(--aq-ilt) !important; color:var(--aq-info) !important; }

    /* filas del cuerpo: tinte más suave que el encabezado, para diferenciar
       las columnas de "Bonificación H.E." y "Horas Extras" del resto sin
       competir visualmente con el color fuerte del título de grupo. */
    .res-table tbody td.th-grp-ef { background:#FBF1E7 !important; }
    .res-table tbody td.th-grp-he { background:#F8E2CB !important; }

    /* Nombre del empleado: alineado a la izquierda (el título de columna no cambia) */
    .res-table tbody td.td-nombre { text-align:left; }

    .badge-0 { opacity:.35; }
    .exportar-btn { background:var(--aq); color:#fff; border:none; }
    .exportar-btn:hover { background:var(--aq-dk); }
    #spinner { display:none; }
    .res-table thead th[data-sort]:hover { background:var(--aq-mid) !important; }
    .res-table thead th .sort-icon { font-size:.65rem; margin-left:2px; }
</style>
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a href="/RecursosHumanos">Recursos Humanos</a></li>
    <li class="breadcrumb-item"><a href="/RecursosHumanos/Aquarius/PlanillaMensual/Dashboard">Planilla Mensual</a></li>
    <li class="breadcrumb-item active">Resumen de Tareo</li>
}

<!-- Título -->
<div class="d-flex justify-content-between align-items-center mb-2">
    <h4 class="mb-0"><i class="bi bi-table me-2" style="color:var(--aq)"></i>Resumen de Tareo por Período</h4>
    <div class="d-flex gap-2">
        <button class="btn btn-sm exportar-btn" id="btnExportar" disabled>
            <i class="bi bi-file-earmark-excel me-1"></i>Excel
        </button>
        <a href="/RecursosHumanos/Aquarius/PlanillaMensual/Dashboard" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>
<hr class="mt-1 mb-3" />

<!-- FILTROS SIMPLIFICADOS: Solo Tipo Empleado (EMPLEADO/OBRERO) y Período -->
<div class="filter-bar rounded mb-3">
    <div class="row g-2 align-items-end">
        <!-- Tipo Empleado (EMPLEADO / OBRERO) -->
        <div class="col-auto">
            <label class="form-label">Tipo Empleado</label>
            <div class="btn-group btn-group-sm" role="group">
                <input type="radio" class="btn-check" name="rdoTipo" id="rdoEmpleado" value="02" checked />
                <label class="btn btn-outline-secondary" for="rdoEmpleado">EMPLEADO</label>
                
                <input type="radio" class="btn-check" name="rdoTipo" id="rdoObrero" value="05" />
                <label class="btn btn-outline-secondary" for="rdoObrero">OBRERO</label>
            </div>
        </div>
        <!-- Período Del / Al -->
        <div class="col-auto ms-4">
            <label class="form-label">Del</label>
            <input type="date" id="dtDesde" class="form-control form-control-sm" style="width:145px" />
        </div>
        <div class="col-auto">
            <label class="form-label">Al</label>
            <input type="date" id="dtHasta" class="form-control form-control-sm" style="width:145px" />
        </div>
        <!-- Buscar -->
        <div class="col-auto">
            <button id="btnBuscar" class="btn btn-sm text-white" style="background:var(--aq);border-color:var(--aq)">
                <i class="bi bi-search me-1"></i>Consultar
            </button>
        </div>
        <!-- Spinner -->
        <div class="col-auto" id="spinner">
            <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
        </div>
        <!-- Filtro rápido -->
        <div class="col-auto ms-auto">
            <input type="search" id="inpFiltro" class="form-control form-control-sm"
                   placeholder="Filtrar por nombre o código…" style="min-width:200px" />
        </div>
    </div>
</div>

<!-- Información período -->
<div id="divInfo" class="d-none mb-2 text-muted" style="font-size:.82rem">
    <i class="bi bi-info-circle me-1"></i>
    <span id="lblInfo"></span>
</div>

<!-- TABLA RESUMEN -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0" style="overflow-x:auto; max-height:70vh">
        <table class="table table-sm res-table mb-0" id="tblResumen">
            <thead>
                <tr>
                    <th rowspan="2" style="min-width:40px;cursor:pointer;user-select:none" id="thCod" data-sort="codPersonal">Cód. <i class="bi sort-icon"></i></th>
                    <th rowspan="2" style="min-width:180px;cursor:pointer;user-select:none" id="thNombre" data-sort="nomTrabajador">Apellidos y Nombres <i class="bi sort-icon"></i></th>
                    <!-- Días -->
                    <th colspan="1" class="text-center th-grp-info col-sep">Días</th>
                    <!-- Horas efectivas -->
                    <th colspan="2" class="text-center th-grp-ef col-sep">Bonificación H.E.</th>
                    <!-- HE -->
                    <th colspan="3" class="text-center th-grp-he col-sep">Horas Extras</th>
                    <!-- Ausencias -->
                    <th colspan="1" class="text-center col-sep" style="background:#f8f8f8">Ausen.</th>
                    <!-- Permisos días -->
                    <th colspan="15" class="text-center th-grp-perm col-sep">Permisos (días)</th>
                    <!-- Permisos horas -->
                    <th colspan="2" class="text-center th-grp-perm col-sep d-none">Perm. (hrs)</th>
                    <!-- Tardanzas -->
                    <th colspan="1" class="text-center col-sep" style="background:#f8f8f8">Tard.</th>
                </tr>
                <tr>
                    <th class="text-center col-sep" title="Días Efectivos">D.Efe</th>
                    <th class="text-center d-none" title="Días Turno Día">D.T.D</th>
                    <th class="text-center d-none" title="Días Turno Noche">D.T.N</th>
                    <th class="text-center d-none" title="H.Efectivas Total">H.Ef</th>
                    <th class="text-center d-none" title="H.Efectivas T1">H.Ef1</th>
                    <th class="text-center col-sep th-grp-ef" id="thHEf2" title="Días T2 (corregido)">H. Efe2<br/><small id="thHEf2Sub" style="font-weight:normal;opacity:.75">días</small></th>
                    <th class="text-center th-grp-ef" id="thHEf3" title="Días T3 (corregido)">H. Efe3<br/><small id="thHEf3Sub" style="font-weight:normal;opacity:.75">días</small></th>
                    <th class="text-center col-sep th-grp-he" title="H25% redondeada">H25%</th>
                    <th class="text-center th-grp-he" title="H35% redondeada">H35%</th>
                    <th class="text-center th-grp-he" title="Horas Dobles redondeada + mín.1h">Hor.D</th>
                    <th class="text-center col-sep" title="Faltas">Faltas</th>
                    <th class="text-center col-sep" title="Venta de Vacaciones (incluida en Vaca)">V.Vaca</th>
                    <th class="text-center" title="Vacaciones Gozadas (Vaca - V.Vaca)">G.Vaca</th>
                    <th class="text-center" title="Vacaciones (total)">T.Vaca</th>
                    <th class="text-center" title="Descanso Médico">D.Med</th>
                    <th class="text-center" title="Subsidios">Subs</th>
                    <th class="text-center" title="Licencias Sindicales">L.Sin</th>
                    <th class="text-center" title="Suspensiones">Susp</th>
                    <th class="text-center" title="Permiso Goce Físico">P.G.F</th>
                    <th class="text-center" title="Licencia Paternidad">L.Pat</th>
                    <th class="text-center" title="Licencia Fallecimiento">L.Fac</th>
                    <th class="text-center" title="Accidente de Trabajo">ACCI</th>
                    <th class="text-center" title="Subsidio Incapacidad Temporal Accidente de Trabajo">Sub.ACC</th>
                    <th class="text-center" title="Subsidio Maternidad">Sub.Mat</th>
                    <th class="text-center" title="Días Permiso Sin Goce (SIG)">D.P.S.G</th>
                    <th class="text-center" title="Días Permiso Con Goce (SIG)">D.P.Goc</th>
                    <th class="text-center col-sep d-none" title="Permisos Con Goce">P.Goc</th>
                    <th class="text-center d-none" title="Permisos Sin Goce">P.S.G</th>
                    <th class="text-center col-sep" title="Tardanzas">Tard</th>
                </tr>
            </thead>
            <tbody id="tbodyRes">
                <tr><td colspan="31" class="text-center text-muted py-4">
                    <i class="bi bi-search me-2"></i>Seleccione el tipo de empleado y el período, luego pulse Consultar.
                </td></tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
const BASE = '/RecursosHumanos/Aquarius/PlanillaMensual';
let allRows = [];
let currentRows = [];
let sortCol = null;
let sortDir = 1;

// Valores por defecto (fijos)
const CFG = {
    codEmpresa:      '0003',      // LA COLONIAL
    codSucursal:     '0',         // TODOS
    cCostos:         'TODOS',
    codTipoPlanillaEmpleado: '02', // EMPLEADO
    codTipoPlanillaObrero:   '05'  // OBRERO
};

// Tipo de planilla REALMENTE consultado (no el del radio en vivo): evita que
// H.Efe2/H.Efe3 se muestren en el formato equivocado (días vs HH:MM) si el
// usuario cambia EMPLEADO/OBRERO sin volver a pulsar Consultar (ej. al usar
// el filtro rápido o al ordenar columnas sobre datos ya cargados).
let tipoConsultado = CFG.codTipoPlanillaEmpleado;

function getTipoPlanillaSeleccionado() {
    const rdo = document.querySelector('input[name="rdoTipo"]:checked');
    return rdo ? rdo.value : CFG.codTipoPlanillaEmpleado;
}

// ── Período predeterminado (mes anterior completo ≈ período planilla) ─────────
function setPeriodoDefault() {
    const hoy  = new Date();
    const ini  = new Date(hoy.getFullYear(), hoy.getMonth() - 1, 24);
    const fin  = new Date(hoy.getFullYear(), hoy.getMonth(),     23);
    document.getElementById('dtDesde').value = ini.toISOString().slice(0,10);
    document.getElementById('dtHasta').value = fin.toISOString().slice(0,10);
}

// ── Consultar ────────────────────────────────────────────────────────────────
async function consultar() {
    const plan  = getTipoPlanillaSeleccionado();
    const desde = document.getElementById('dtDesde').value;
    const hasta = document.getElementById('dtHasta').value;

    if (!desde || !hasta) { alert('Seleccione el período.'); return; }

    tipoConsultado = plan;
    const fi = formatFecha(desde);
    const ff = formatFecha(hasta);

    document.getElementById('spinner').style.display = '';
    document.getElementById('btnBuscar').disabled    = true;
    document.getElementById('tblResumen').querySelector('tbody').innerHTML =
            `<tr><td colspan="31" class="text-center text-muted py-3"><span class="spinner-border spinner-border-sm me-2"></span>Consultando…</td></tr>`

    try {
        const resp = await fetch(`${BASE}/api/Resumen`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                codEmpresa:      CFG.codEmpresa,
                codSucursal:     CFG.codSucursal,
                codTipoPlanilla: plan,
                cCostos:         CFG.cCostos,
                fechaInicio:     fi,
                fechaFinal:      ff
            })
        });
        if (!resp.ok) { const e = await resp.json(); throw new Error(e.error || resp.statusText); }
        allRows = await resp.json();
        currentRows = allRows;
        renderTabla(currentRows);
        ajustarOffsetCabecera();
        document.getElementById('divInfo').classList.remove('d-none');
        document.getElementById('lblInfo').textContent =
            `${allRows.length} empleados — Período: ${desde} al ${hasta}`;
        document.getElementById('btnExportar').disabled = allRows.length === 0;
    } catch(ex) {
        document.getElementById('tblResumen').querySelector('tbody').innerHTML =
            `<tr><td colspan="31" class="text-center text-danger py-3"><i class="bi bi-exclamation-triangle me-2"></i>${ex.message}</td></tr>`;
    } finally {
        document.getElementById('spinner').style.display = 'none';
        document.getElementById('btnBuscar').disabled    = false;
    }
}

// ── Render tabla ─────────────────────────────────────────────────────────────
function sortRows(rows) {
    if (!sortCol) return rows;
    return [...rows].sort((a, b) => {
        const va = (a[sortCol] ?? '').toString();
        const vb = (b[sortCol] ?? '').toString();
        return va.localeCompare(vb, 'es', { numeric: true, sensitivity: 'base' }) * sortDir;
    });
}

function actualizarIconosOrden() {
    document.querySelectorAll('#tblResumen th[data-sort]').forEach(th => {
        const icon = th.querySelector('.sort-icon');
        if (!icon) return;
        if (th.dataset.sort === sortCol) {
            icon.className = 'bi sort-icon ' + (sortDir === 1 ? 'bi-caret-up-fill' : 'bi-caret-down-fill');
        } else {
            icon.className = 'bi sort-icon';
        }
    });
}

function renderTabla(rows) {
    rows = sortRows(rows);
    const esObrero = tipoConsultado === CFG.codTipoPlanillaObrero;
    const subLbl = esObrero ? 'horas' : 'días';
    const thHEf2Sub = document.getElementById('thHEf2Sub');
    const thHEf3Sub = document.getElementById('thHEf3Sub');
    if (thHEf2Sub) thHEf2Sub.textContent = subLbl;
    if (thHEf3Sub) thHEf3Sub.textContent = subLbl;
    const tbody = document.getElementById('tbodyRes');
    if (!rows.length) {
            tbody.innerHTML = '<tr><td colspan="31" class="text-center text-muted py-4">Sin resultados para el período y filtros seleccionados.</td></tr>';
        return;
    }
    const html = rows.map(r => `
    <tr>
        <td class="text-muted">${r.codPersonal ?? ''}</td>
        <td class="td-nombre">${r.nomTrabajador ?? ''}</td>
        <td class="text-center col-sep">${r.diasEfectivos  || '<span class="badge-0">0</span>'}</td>
        <td class="text-center d-none">${r.diasTurnoDia          || '<span class="badge-0">0</span>'}</td>
        <td class="text-center d-none">${r.diasTurnoNoche        || '<span class="badge-0">0</span>'}</td>
        <td class="text-center d-none">${r.horasEfectivas  ?? '0:00'}</td>
        <td class="text-center d-none">${r.horasEfectivas1 ?? '0:00'}</td>
        <td class="text-center col-sep th-grp-ef">${(esObrero ? r.horasT2 : r.diasT2)  || (esObrero ? '0:00' : '<span class="badge-0">0</span>')}</td>
        <td class="text-center th-grp-ef">${(esObrero ? r.horasT3 : r.diasT3)  || (esObrero ? '0:00' : '<span class="badge-0">0</span>')}</td>
        <td class="text-center col-sep th-grp-he ${r.horas25MinRnd > 0 ? 'fw-semibold' : ''}">${r.horas25 ?? '0:00'}</td>
        <td class="text-center th-grp-he ${r.horas35MinRnd > 0 ? 'fw-semibold' : ''}">${r.horas35 ?? '0:00'}</td>
        <td class="text-center th-grp-he ${r.horas100MinRnd > 0 ? 'fw-semibold' : ''}">${r.horas100 ?? '0:00'}</td>
        <td class="text-center col-sep ${r.diasFalta > 0 ? 'text-danger fw-semibold' : ''}">${r.diasFalta || '<span class="badge-0">0</span>'}</td>
        <td class="text-center col-sep">${r.ventaVacaciones       || '<span class="badge-0">0</span>'}</td>
        <td class="text-center">${r.gVaca                        || '<span class="badge-0">0</span>'}</td>
        <td class="text-center">${r.vacaciones                   || '<span class="badge-0">0</span>'}</td>
        <td class="text-center">${r.descansosMedicos        || '<span class="badge-0">0</span>'}</td>
        <td class="text-center">${r.subsidios               || '<span class="badge-0">0</span>'}</td>
        <td class="text-center">${r.licenciasSindicales     || '<span class="badge-0">0</span>'}</td>
        <td class="text-center">${r.suspensiones            || '<span class="badge-0">0</span>'}</td>
        <td class="text-center">${r.permisoGoceFisico       || '<span class="badge-0">0</span>'}</td>
        <td class="text-center">${r.licenciaPaternidad      || '<span class="badge-0">0</span>'}</td>
        <td class="text-center">${r.licenciaFallecimiento   || '<span class="badge-0">0</span>'}</td>
        <td class="text-center">${r.accidenteTrabajo        || '<span class="badge-0">0</span>'}</td>
        <td class="text-center">${r.subsidioIncapacidadAccidente || '<span class="badge-0">0</span>'}</td>
        <td class="text-center">${r.subsidioMaternidad      || '<span class="badge-0">0</span>'}</td>
        <td class="text-center">${r.diasPermisoSinGoce      || '<span class="badge-0">0</span>'}</td>
        <td class="text-center">${r.diasPermisoConGoce      || '<span class="badge-0">0</span>'}</td>
        <td class="text-center col-sep d-none">${r.permisosConGoce ?? '0:00'}</td>
        <td class="text-center d-none">${r.permisosSinGoce         ?? '0:00'}</td>
        <td class="text-center col-sep ${r.tardanzas !== '0:00' ? 'text-warning' : ''}">${r.tardanzas ?? '0:00'}</td>
    </tr>`).join('');
    tbody.innerHTML = html;
}

// ── Filtro rápido ─────────────────────────────────────────────────────────────
document.getElementById('inpFiltro').addEventListener('input', function() {
    const q = this.value.toLowerCase();
    const fil = allRows.filter(r =>
        (r.nomTrabajador ?? '').toLowerCase().includes(q) ||
        (r.codPersonal   ?? '').toLowerCase().includes(q));
    currentRows = fil;
    renderTabla(currentRows);
});

// ── Ordenar por columna ──────────────────────────────────────────
document.querySelectorAll('#tblResumen th[data-sort]').forEach(th => {
    th.addEventListener('click', () => {
        const col = th.dataset.sort;
        if (sortCol === col) {
            sortDir *= -1;
        } else {
            sortCol = col;
            sortDir = 1;
        }
        actualizarIconosOrden();
        renderTabla(currentRows);
    });
});

// ── Exportar Excel (CSV) ──────────────────────────────────────────────────────
// ── Exportar Excel (tabla HTML agrupada, con color alternado por fila) ──
function construirTablaExcelResumen() {
    const original = document.getElementById('tblResumen');
    const clone = original.cloneNode(true);

    clone.querySelectorAll('.d-none').forEach(el => el.remove());
    clone.querySelectorAll('.sort-icon').forEach(el => el.remove());
    clone.querySelectorAll('th').forEach(th => {
        th.style.position = '';
        th.style.top = '';
        th.setAttribute('style', (th.getAttribute('style') || '') + ';background:#f4a462;color:#222;border:1px solid #ccc;padding:4px');
    });

    const coloresEmp = ['#ffffff', '#eaf1f8'];
    clone.querySelectorAll('tbody tr').forEach((tr, idx) => {
        tr.setAttribute('style', 'background:' + coloresEmp[idx % 2]);
        tr.querySelectorAll('td').forEach(td => { td.style.textAlign = 'center'; });
    });

    // Nombre del empleado: alineado a la izquierda (los estilos CSS por
    // clase no se conservan en el .xls exportado, por lo que se fuerza
    // el estilo inline).
    clone.querySelectorAll('td.td-nombre').forEach(td => {
        td.setAttribute('style', (td.getAttribute('style') || '') + ';text-align:left');
    });

    // "Bonificación H.E." (grupo th-grp-ef) y "Horas Extras" (grupo
    // th-grp-he): se pintan con un tinte distintivo (igual que en la
    // vista) para diferenciarlas del resto de columnas, ya que las
    // clases CSS no viajan al .xls y deben fijarse como estilo inline.
    clone.querySelectorAll('td.th-grp-ef').forEach(td => {
        td.setAttribute('style', (td.getAttribute('style') || '') + ';background:#FBF1E7');
    });
    clone.querySelectorAll('td.th-grp-he').forEach(td => {
        td.setAttribute('style', (td.getAttribute('style') || '') + ';background:#F8E2CB');
    });

    // Horas Extras (H25% / H35% / Hor.D): siempre son horas enteras (sin
    // minutos), por lo que se exportan como número entero real (no texto
    // "8:00") y con formato de celda numérico "0" para que Excel las
    // reconozca y muestre correctamente como enteros.
    clone.querySelectorAll('td.th-grp-he').forEach(td => {
        const txt = (td.textContent || '').trim();
        const horas = parseInt(txt.split(':')[0], 10) || 0;
        td.textContent = String(horas);
        td.setAttribute('style', (td.getAttribute('style') || '') + ';mso-number-format:"0"');
    });

    return '<table border="1" style="border-collapse:collapse;font-family:Calibri,Arial;font-size:11px">' +
        clone.innerHTML +
        '</table>';
}

document.getElementById('btnExportar').addEventListener('click', () => {
    if (!allRows.length) return;
    const tabla = construirTablaExcelResumen();
    const html = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">' +
        '<head><meta charset="UTF-8">' +
        '<!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet>' +
        '<x:Name>ResumenTareo</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions>' +
        '</x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]-->' +
        '<\/head><body>' + tabla + '<\/body><\/html>';
    const blob = new Blob(['\uFEFF' + html], { type: 'application/vnd.ms-excel;charset=utf-8;' });
    const url  = URL.createObjectURL(blob);
    Object.assign(document.createElement('a'), { href: url, download: 'ResumenTareo.xls' }).click();
    URL.revokeObjectURL(url);
});

// ── Helpers ────────────────────────────────────────────────────────────────────
function formatFecha(iso) {
    const [y, m, d] = iso.split('-');
    return `${d}/${m}/${y}`;
}

// ── Init ───────────────────────────────────────────────────────────────────────
function ajustarOffsetCabecera() {
    const tabla = document.getElementById('tblResumen');
    if (!tabla) return;
    // Usar una celda de la 1ra fila SIN rowspan (los th con rowspan="2"
    // como Cód./Apellidos miden el alto de ambas filas y falsean el cálculo).
    const filaTh = tabla.querySelector('thead tr:first-child th[colspan]');
    if (!filaTh) return;
    const alto = filaTh.getBoundingClientRect().height;
    if (alto > 0) tabla.style.setProperty('--thead-row1-h', alto + 'px');
}

document.addEventListener('DOMContentLoaded', () => {
    setPeriodoDefault();
    document.getElementById('btnBuscar').addEventListener('click', consultar);
    ajustarOffsetCabecera();
    window.addEventListener('resize', ajustarOffsetCabecera);
});
</script>
}
