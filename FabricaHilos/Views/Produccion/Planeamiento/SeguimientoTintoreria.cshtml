// Sincroniza la altura de la fila de cabeceras individuales (thead-cols) entre ambas tablas.
// La tabla izquierda tiene esa fila vacía (los th tienen rowspan=2); se le da la misma
// altura que la fila equivalente de la tabla derecha para que los cuerpos arranquen igual.
function syncTheadHeights() {
    if (!tbl) return;
    var rightColsRow = tbl.querySelector('thead tr.thead-cols');
    var tblL = document.getElementById('stTableL');
    var leftColsRow = tblL ? tblL.querySelector('thead tr.thead-cols') : null;
    if (!rightColsRow || !leftColsRow) return;
    var h = rightColsRow.getBoundingClientRect().height || rightColsRow.offsetHeight || 0;
    leftColsRow.style.height = h + 'px';
}

// Sincroniza alturas de filas entre panel izquierdo (stTbodyL) y panel derecho (stTbody).
// Se ejecuta tras dos requestAnimationFrame para garantizar que el browser haya
// completado el reflow despues del innerHTML y los offsetHeight sean correctos.
function syncRowHeights() {
    if (!tbodyL || !tbody) return;
    requestAnimationFrame(function() {
        requestAnimationFrame(function() {
            var rRows = tbody.rows;
            var lRows = tbodyL.rows;
            var len = Math.min(lRows.length, rRows.length);
            for (var i = 0; i < len; i++) {
                // Limpiar altura forzada para leer la natural de cada panel
                lRows[i].style.height = '';
                rRows[i].style.height = '';
            }
            for (var i = 0; i < len; i++) {
                // Usar el maximo entre ambas filas para que nunca haya desalineacion
                var hL = lRows[i].offsetHeight;
                var hR = rRows[i].offsetHeight;
                var h  = Math.max(hL, hR);
                if (h > 0) {
                    lRows[i].style.height = h + 'px';
                    rRows[i].style.height = h + 'px';
                }
            }
            syncTheadHeights();
        });
    });
}

