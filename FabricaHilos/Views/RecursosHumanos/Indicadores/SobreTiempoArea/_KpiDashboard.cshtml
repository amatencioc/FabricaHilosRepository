@model FabricaHilos.Models.RecursosHumanos.HorasExtrasKpiViewModel
@using System.Globalization
@using FabricaHilos.Models.RecursosHumanos

@{
    var culture  = CultureInfo.GetCultureInfo("es-PE");
    string NombreMes(int m) => culture.DateTimeFormat.GetMonthName(m);

    string periodo = Model.AnoIni == Model.AnoFin && Model.MesIni == Model.MesFin
        ? $"01 al {DateTime.DaysInMonth(Model.AnoFin, Model.MesFin):D2} de {NombreMes(Model.MesFin)} de {Model.AnoFin}"
        : $"{NombreMes(Model.MesIni)} {Model.AnoIni} — {NombreMes(Model.MesFin)} {Model.AnoFin}";

    // Períodos únicos ordenados
    var periodos = Model.Resumen.OrderBy(r => r.Ano).ThenBy(r => r.Mes).ToList();
    // Áreas únicas ordenadas alfabéticamente
    var areas = Model.Areas
        .GroupBy(a => a.Area)
        .OrderBy(g => g.Key)
        .Select(g => g.Key)
        .ToList();

    // Totales globales (suma de todos los períodos)
    decimal gTotalHE      = periodos.Sum(r => r.TotalHorasExtras);
    int     gTotalTrabSum = periodos.Sum(r => r.TotalTrabajadores);   // para cálculos internos
    int     gPromTrab     = periodos.Count > 0
                            ? (int)Math.Round(periodos.Average(r => (double)r.TotalTrabajadores))
                            : 0;
    decimal gPromHE    = gTotalTrabSum > 0 ? Math.Round(gTotalHE / gTotalTrabSum, 2) : 0m;
    int     gTrabConHE = periodos.Sum(r => r.TrabajadoresConHe);
    decimal gPctConHE  = gTotalTrabSum > 0 ? Math.Round((decimal)gTrabConHE / gTotalTrabSum * 100, 1) : 0m;

    // Helper: buscar fila de área en período
    HorasExtrasAreaDto? GetArea(int ano, int mes, string area) =>
        Model.Areas.FirstOrDefault(a => a.Ano == ano && a.Mes == mes && a.Area == area);

    // Paleta suave por año (hasta 5 años) — diccionarios para acceso en todo el archivo
    var anosUnicos = periodos.Select(p => p.Ano).Distinct().OrderBy(a => a).ToList();
    string[] _bgRow    = new[] {"#eaf4f0","#eaf0fb","#fdf3e7","#fce8e8","#f3eafd"};
    string[] _bgHeader = new[] {"#c8e6da","#c5d9f7","#fde8c8","#fac5c5","#dfc8f7"};
    string[] _border   = new[] {"#1B4D3E","#1565C0","#e65100","#c62828","#6a1b9a"};
    var yearBgRowMap    = anosUnicos.Select((ano,i) => (ano, c:_bgRow[i%_bgRow.Length])).ToDictionary(x=>x.ano, x=>x.c);
    var yearBgHeaderMap = anosUnicos.Select((ano,i) => (ano, c:_bgHeader[i%_bgHeader.Length])).ToDictionary(x=>x.ano, x=>x.c);
    var yearBorderMap   = anosUnicos.Select((ano,i) => (ano, c:_border[i%_border.Length])).ToDictionary(x=>x.ano, x=>x.c);

    // JSON para gráficos comparativos
    var chartRows = Model.Areas.Select(a => new {
        ano   = a.Ano,
        mes   = a.Mes,
        area  = a.Area,
        total = Math.Round(a.TotalHorasExtras, 1),
        prom  = Math.Round(a.PromHorasExtrasTrab, 2),
        trab  = a.TotalTrabajadores
    });
    var rawJson = System.Text.Json.JsonSerializer.Serialize(chartRows);
}

<!-- Datos para Chart.js comparativo (value="..." para que Razor escape automáticamente comillas y caracteres especiales del JSON) -->
<input type="hidden" id="chartRawData" value="@rawJson" />

<!-- ── Título y período ─────────────────────────────────── -->
<div class="text-center mb-4">
    <h5 class="fw-bold text-uppercase mb-1" style="color:#1B4D3E; letter-spacing:.06em; font-size:.95rem;">
        KPI Horas Extras por Área
    </h5>
    <p class="text-muted mb-0" style="font-size:.8rem;">Periodo: @periodo</p>
</div>

<!-- ── KPI Cards (totales acumulados) ───────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="kpi-card accent-green">
            <div class="kpi-icon">⏱️</div>
            <div class="kpi-label">Total Horas Extras</div>
            <div class="kpi-value" style="color:#1B4D3E;">@gTotalHE.ToString("N1")</div>
            <div class="kpi-sub">horas acumuladas</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card accent-blue">
            <div class="kpi-icon">👥</div>
            <div class="kpi-label">Promedio Trabajadores</div>
            <div class="kpi-value" style="color:#1565C0;">@gPromTrab</div>
            <div class="kpi-sub">colaboradores / mes</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card accent-purple">
            <div class="kpi-icon">📊</div>
            <div class="kpi-label">Promedio HE / Colaborador</div>
            <div class="kpi-value" style="color:#4A148C;">@gPromHE.ToString("N2")</div>
            <div class="kpi-sub">horas por colaborador</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card accent-orange">
            <div class="kpi-icon">📈</div>
            <div class="kpi-label">% Colaboradores con HE</div>
            <div class="kpi-value" style="color:#e65100;">@gPctConHE.ToString("N1")%</div>
            <div class="kpi-sub">del total del período</div>
        </div>
    </div>
</div>

<!-- ── Tabla comparativa por período (solo si hay más de uno) ────────── -->
@if (periodos.Count > 1)
{
    <div class="section-title"><i class="bi bi-calendar-range me-1"></i>Resumen Comparativo por Período</div>
    <div class="table-responsive mb-4">
        <table class="table table-sm table-hover table-corporate align-middle mb-0">
            <thead>
                <tr>
                    <th>Período</th>
                    <th class="text-end">Total HE (h)</th>
                    <th class="text-center">Trabajadores</th>
                    <th class="text-end">Prom. HE/Trab.</th>
                    <th class="text-center">Con HE</th>
                    <th class="text-end">% Con HE</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in periodos)
                {
                    <tr style="background:@yearBgRowMap[p.Ano]; border-left:3px solid @yearBorderMap[p.Ano];">
                        <td class="fw-semibold">@NombreMes(p.Mes) @p.Ano</td>
                        <td class="text-end">@p.TotalHorasExtras.ToString("N1")</td>
                        <td class="text-center">@p.TotalTrabajadores</td>
                        <td class="text-end">@p.PromHorasExtrasTrab.ToString("N2")</td>
                        <td class="text-center">@p.TrabajadoresConHe</td>
                        <td class="text-end">@p.PctColaboradoresConHe.ToString("N1")%</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr style="background:#e8f0e9; font-weight:700; border-top:2px solid #1B4D3E;">
                    <td>Total acumulado</td>
                    <td class="text-end">@gTotalHE.ToString("N1")</td>
                    <td class="text-center">@gPromTrab <small class="text-muted fw-normal">(prom.)</small></td>
                    <td class="text-end">@gPromHE.ToString("N2")</td>
                    <td class="text-center">@gTrabConHE</td>
                    <td class="text-end">@gPctConHE.ToString("N1")%</td>
                </tr>
            </tfoot>
        </table>
    </div>
}

<!-- ── Tabla de áreas ────────────────────────────────────── -->
<div class="section-title"><i class="bi bi-table me-1"></i>Detalle por Área</div>
<div class="table-responsive mb-4">
    <table class="table table-sm table-hover table-corporate align-middle mb-0">
        <thead>
            @{
                // Agrupar períodos por año para la cabecera de año
                var periodosPorAno = periodos.GroupBy(p => p.Ano).OrderBy(g => g.Key).ToList();
            }
            <!-- Fila 1: Año -->
            <tr>
                <th rowspan="3" class="align-middle" style="min-width:160px;">Área</th>
                @foreach (var grp in periodosPorAno)
                {
                    var bgH = yearBgHeaderMap[grp.Key];
                    var bdr = yearBorderMap[grp.Key];
                    <th colspan="@(grp.Count() * 3)" class="text-center"
                        style="background:@bgH; border-left:3px solid @bdr; font-size:.8rem; font-weight:700; letter-spacing:.04em;">
                        @grp.Key
                    </th>
                }
                @if (periodos.Count > 1)
                {
                    <th colspan="2" class="text-center" style="background:#e8f0e9; border-left:2px solid #1B4D3E;">Acumulado</th>
                }
            </tr>
            <!-- Fila 2: Mes -->
            <tr>
                @foreach (var p in periodos)
                {
                    var bgH = yearBgHeaderMap[p.Ano];
                    var bdr = yearBorderMap[p.Ano];
                    <th colspan="3" class="text-center"
                        style="background:@bgH; border-left:2px solid @bdr; font-size:.74rem; font-weight:600;">
                        @NombreMes(p.Mes)
                    </th>
                }
                @if (periodos.Count > 1)
                {
                    <th colspan="2" class="text-center" style="background:#e8f0e9;"></th>
                }
            </tr>
            <!-- Fila 3: Columnas -->
            <tr>
                @foreach (var p in periodos)
                {
                    var bgH = yearBgHeaderMap[p.Ano];
                    var bdr = yearBorderMap[p.Ano];
                    <th class="text-center" style="font-size:.72rem; white-space:nowrap; background:@bgH; border-left:2px solid @bdr;">Trabajadores</th>
                    <th class="text-end" style="font-size:.72rem; white-space:nowrap; background:@bgH;">HE (h)</th>
                    <th class="text-end" style="font-size:.72rem; white-space:nowrap; background:@bgH;">% HE</th>
                }
                @if (periodos.Count > 1)
                {
                    <th class="text-end" style="font-size:.72rem; background:#e8f0e9; border-left:2px solid #1B4D3E; white-space:nowrap;">HE (h)</th>
                    <th class="text-end" style="font-size:.72rem; background:#e8f0e9; white-space:nowrap;">% Total</th>
                }
            </tr>
        </thead>
        <tbody>
            @{
                decimal totalGlobal = Model.Areas.Sum(a => a.TotalHorasExtras);
            }
            @foreach (var areaName in areas)
            {
                decimal sumHE   = 0m;
                <tr>
                    <td class="fw-semibold">@areaName</td>
                    @foreach (var p in periodos)
                    {
                        var cell = GetArea(p.Ano, p.Mes, areaName);
                        sumHE += cell?.TotalHorasExtras ?? 0m;
                        var bgR = yearBgRowMap[p.Ano];
                        var bdr = yearBorderMap[p.Ano];
                        <td class="text-center" style="background:@bgR; border-left:2px solid @bdr;">@(cell?.TotalTrabajadores.ToString() ?? "—")</td>
                        <td class="text-end" style="background:@bgR;">@(cell?.TotalHorasExtras.ToString("N1") ?? "—")</td>
                        <td class="text-end" style="background:@bgR;">@(cell is not null ? cell.PctTotalHorasExtras.ToString("N1") + "%" : "—")</td>
                    }
                    @if (periodos.Count > 1)
                    {
                        decimal pctGlobal = totalGlobal > 0 ? Math.Round(sumHE / totalGlobal * 100, 1) : 0m;
                        <td class="text-end fw-semibold" style="background:#edf7f2; border-left:2px solid #1B4D3E;">@sumHE.ToString("N1")</td>
                        <td class="text-end" style="background:#edf7f2;">@pctGlobal.ToString("N1")%</td>
                    }
                </tr>
            }
        </tbody>
        <tfoot>
            <tr style="font-weight:700; border-top:2px solid #1B4D3E;">
                <td style="background:#e8f0e9;">Total</td>
                @foreach (var p in periodos)
                {
                    var rowTotal = Model.Areas.Where(a => a.Ano == p.Ano && a.Mes == p.Mes).ToList();
                    decimal sumHEp = rowTotal.Sum(a => a.TotalHorasExtras);
                    int     sumTrp = rowTotal.Sum(a => a.TotalTrabajadores);
                    decimal promP  = sumTrp > 0 ? Math.Round(sumHEp / sumTrp, 2) : 0m;
                    var bgF = yearBgHeaderMap[p.Ano];
                    var bdF = yearBorderMap[p.Ano];
                    <td class="text-center" style="background:@bgF; border-left:2px solid @bdF;">@sumTrp</td>
                    <td class="text-end" style="background:@bgF;">@sumHEp.ToString("N1")</td>
                    <td class="text-end" style="background:@bgF;">100%</td>
                }
                @if (periodos.Count > 1)
                {
                    <td class="text-end border-start">@gTotalHE.ToString("N1")</td>
                    <td class="text-end">100%</td>
                }
            </tr>
        </tfoot>
    </table>
</div>

<!-- ── Gráficos comparativos ─────────────────────────────── -->
<div class="section-title"><i class="bi bi-bar-chart-line me-1"></i>Análisis Gráfico Comparativo</div>
<!-- Fila superior: Comparativo mensual + Top áreas por sobretiempo -->
<div class="row g-3 mb-2">
    <div class="col-lg-6">
        <div class="card chart-card position-relative">
            <div class="card-header">
                <div class="fw-semibold" style="font-size:.82rem;">📊 Total de Sobretiempo Empresa — Comparativo por Mes</div>
                <div class="text-muted" style="font-size:.72rem;">Muestra el <strong>total de horas extras de toda la empresa</strong> (suma de todas las áreas) agrupado por mes. Cada color representa un año. Úsalo para detectar si el sobretiempo global sube o baja respecto al año anterior en cada mes.</div>
            </div>
            <div class="card-body" style="height:420px;">
                <canvas id="chartBarComparativo"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card chart-card position-relative">
            <div class="card-header">
                <div class="fw-semibold" style="font-size:.82rem;">🏆 Área con Mayor Sobretiempo — Por Mes y Año</div>
                <div class="text-muted" style="font-size:.72rem;">Muestra <strong>solo el área que registró más horas extras</strong> en cada mes (no la suma de todas). La etiqueta sobre cada barra indica el nombre del área. Úsalo para identificar qué área lidera consistentemente el sobretiempo y si ese liderazgo cambia entre años.</div>
            </div>
            <div class="card-body" style="height:420px;">
                <canvas id="chartTopAreas"></canvas>
            </div>
        </div>
    </div>
</div>
<!-- Fila inferior: Total por área + Promedio por trabajador -->
<div class="row g-3 mb-3">
    <div class="col-lg-6">
        <div class="card chart-card position-relative">
            <div class="card-header">
                <div class="fw-semibold" style="font-size:.82rem;">📦 Sobretiempo por Área — Detalle por Período</div>
                <div class="text-muted" style="font-size:.72rem;">Muestra el total de horas extras de <strong>cada área individual</strong> en cada período seleccionado. A diferencia del gráfico superior (que suma todo), aquí se ve el aporte de cada área por separado. Úsalo para comparar el peso relativo de cada área dentro de un mismo mes o entre años.</div>
            </div>
            <div class="card-body" style="height:360px;">
                <canvas id="chartBarTotal"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card chart-card position-relative">
            <div class="card-header">
                <div class="fw-semibold" style="font-size:.82rem;">👤 Intensidad de Sobretiempo por Trabajador y Área</div>
                <div class="text-muted" style="font-size:.72rem;">Muestra el <strong>promedio de horas extras por colaborador</strong> en cada área. Un área puede tener pocas horas totales pero un promedio alto (carga concentrada en pocas personas) o muchas horas pero promedio bajo (bien repartidas). Complementa al gráfico de totales para entender si el sobretiempo es masivo o recae en un grupo reducido.</div>
            </div>
            <div class="card-body" style="height:360px;">
                <canvas id="chartLineProm"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- ── Análisis automático del período ─────────────────────────────── -->
@{
    // Acumulado por área (suma de todos los períodos)
    var areasAcum = Model.Areas
        .GroupBy(a => a.Area)
        .Select(g => new {
            Area          = g.Key,
            TotalHE       = g.Sum(x => x.TotalHorasExtras),
            PromHE        = g.Sum(x => x.TotalTrabajadores) > 0
                            ? Math.Round(g.Sum(x => x.TotalHorasExtras) / g.Sum(x => x.TotalTrabajadores), 2)
                            : 0m
        })
        .OrderByDescending(x => x.TotalHE)
        .ToList();

    decimal totalEmpresa = areasAcum.Sum(x => x.TotalHE);
    decimal avgTotal     = areasAcum.Count > 0 ? totalEmpresa / areasAcum.Count : 0m;
    decimal avgProm      = areasAcum.Count > 0 ? areasAcum.Average(x => x.PromHE) : 0m;

    // Pareto: primeras N áreas que acumulan ≥ 50 %
    decimal acum = 0m; int paretoN = 0;
    foreach (var a in areasAcum)
    {
        acum += a.TotalHE; paretoN++;
        if (totalEmpresa > 0 && acum / totalEmpresa * 100 >= 50m) break;
    }
    decimal paretoAcumPct = totalEmpresa > 0 ? Math.Round(acum / totalEmpresa * 100, 1) : 0m;
    var paretoAreas = areasAcum.Take(paretoN).Select(x => x.Area).ToList();

    // Matriz 2×2 por área
    string Diagnostico(decimal tot, decimal prom) =>
        tot >= avgTotal && prom >= avgProm ? "sobrecargada" :
        tot >= avgTotal && prom <  avgProm ? "carga-distribuida" :
        tot <  avgTotal && prom >= avgProm ? "dependencia-personas" : "sin-problema";

    string BadgeColor(string diag) => diag switch {
        "sobrecargada"        => "danger",
        "carga-distribuida"   => "warning",
        "dependencia-personas"=> "warning",
        _                     => "success"
    };
    string BadgeLabel(string diag) => diag switch {
        "sobrecargada"        => "Área sobrecargada",
        "carga-distribuida"   => "Carga distribuida",
        "dependencia-personas"=> "Dependencia de personas",
        _                     => "Sin problema"
    };
    string BadgeIcon(string diag) => diag switch {
        "sobrecargada"        => "🔴",
        "carga-distribuida"   => "🟠",
        "dependencia-personas"=> "🟠",
        _                     => "🟢"
    };
}

<div class="section-title mt-3"><i class="bi bi-cpu me-1"></i>Análisis Automático del Período</div>
<div class="row g-3 mb-4">

    <!-- Pareto -->
    <div class="col-md-5">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-header fw-semibold small" style="background:#f0f4f0; color:#1B4D3E;">
                <i class="bi bi-bar-chart-steps me-1"></i> Concentración de HE — Análisis de Pareto (80/20)
            </div>
            <div class="card-body small">
                @if (areasAcum.Count == 0)
                {
                    <p class="text-muted mb-0">Sin datos para el período seleccionado.</p>
                }
                else
                {
                    <p class="mb-1 text-muted" style="font-size:.74rem;">
                        <strong>¿Qué es el análisis de Pareto?</strong> Identifica las pocas áreas que concentran la mayor parte del sobretiempo total.
                        Si pocas áreas absorben más del 50% del costo, la empresa tiene un riesgo operativo concentrado que requiere atención inmediata.
                        El sobretiempo total acumulado del período es <strong>@totalEmpresa.ToString("N1") h</strong>.
                    </p>
                    <p class="mb-2">
                        Las <strong>@paretoN área@(paretoN != 1 ? "s" : "")</strong> con mayor sobretiempo
                        (<em>@string.Join(", ", paretoAreas)</em>) acumulan el
                        <strong class="@(paretoAcumPct >= 50 ? "text-danger" : "text-success")">@paretoAcumPct%</strong>
                        del total de horas extras de la empresa en el período.
                        @if (paretoN <= 2) { <text>Esto indica una concentración <strong>extrema</strong>: con solo @paretoN área@(paretoN != 1 ? "s" : "") se explica más de la mitad del costo.</text> }
                        else { <text>El resto de las áreas distribuye el <strong>@((100 - paretoAcumPct).ToString("N1"))%</strong> restante entre @(areasAcum.Count - paretoN) área@(areasAcum.Count - paretoN != 1 ? "s" : "").</text> }
                    </p>
                    @if (paretoAcumPct >= 50 && paretoN <= 3)
                    {
                        <div class="alert alert-danger py-1 px-2 mb-2 small">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            <strong>Alta concentración detectada:</strong> Solo @paretoN área@(paretoN != 1 ? "s" : "") (@string.Join(", ", paretoAreas)) absorben más del 50% del sobretiempo.
                            Se recomienda revisar causas raíz: dotación insuficiente, picos de producción, ausentismo o procesos sin automatizar.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success py-1 px-2 mb-2 small">
                            <i class="bi bi-check-circle-fill me-1"></i>
                            <strong>Carga bien distribuida:</strong> El sobretiempo se reparte entre varias áreas, lo que reduce el riesgo operativo concentrado.
                            Aun así, se recomienda monitorear las áreas del top 5 para detectar tendencias al alza.
                        </div>
                    }
                    <table class="table table-sm table-bordered mb-0" style="font-size:.78rem;">
                        <thead class="table-dark"><tr><th>#</th><th>Área</th><th class="text-end">HE (h)</th><th class="text-end">% Total</th><th class="text-end">% Acum.</th></tr></thead>
                        <tbody>
                            @{ decimal acumTabla = 0m; int rank = 0; }
                            @foreach (var a in areasAcum.Take(5))
                            {
                                rank++;
                                decimal pct = totalEmpresa > 0 ? Math.Round(a.TotalHE / totalEmpresa * 100, 1) : 0m;
                                acumTabla += pct;
                                <tr>
                                    <td>@rank</td>
                                    <td>@a.Area</td>
                                    <td class="text-end">@a.TotalHE.ToString("N1")</td>
                                    <td class="text-end">@pct.ToString("N1")%</td>
                                    <td class="text-end fw-semibold">@acumTabla.ToString("N1")%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <!-- Matriz de diagnóstico -->
    <div class="col-md-7">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-header fw-semibold small" style="background:#f0f4f0; color:#1B4D3E;">
                <i class="bi bi-grid-3x3-gap me-1"></i> Diagnóstico por Área — Matriz HE Total vs. Promedio por Trabajador
            </div>
            <div class="card-body small p-2">
                <p class="mb-1" style="font-size:.74rem; color:#374151;">
                    <strong>¿Cómo funciona esta matriz?</strong> Compara cada área contra el umbral promedio de la empresa
                    en dos dimensiones: <em>HE Total</em> (volumen de sobretiempo del área) y <em>HE Promedio por trabajador</em>
                    (intensidad individual). La combinación de ambas define 4 categorías de diagnóstico:
                </p>
                <ul class="mb-2" style="font-size:.73rem; padding-left:1.1rem; color:#374151;">
                    <li><span class="badge bg-danger">🔴 Área sobrecargada</span> — HE Total <em>y</em> Promedio por encima del umbral: el área genera mucho sobretiempo <em>y</em> cada trabajador trabaja horas extras en exceso. Prioridad alta de intervención.</li>
                    <li><span class="badge bg-warning text-dark">🟠 Carga distribuida</span> — HE Total alta pero Promedio bajo: el área genera mucho sobretiempo pero repartido entre muchos trabajadores. Revisar si se puede optimizar procesos o turnos.</li>
                    <li><span class="badge bg-warning text-dark">🟠 Dependencia de personas</span> — HE Total baja pero Promedio alto: pocos trabajadores cargan con todo el sobretiempo del área. Riesgo de fatiga y rotación; revisar concentración.</li>
                    <li><span class="badge bg-success">🟢 Sin problema</span> — Ambos indicadores bajo el umbral: el área opera dentro de los parámetros normales. Mantener seguimiento preventivo.</li>
                </ul>
                <p class="text-muted mb-2" style="font-size:.74rem;">
                    <strong>Umbral empresa (promedio entre todas las áreas):</strong>
                    HE Total = <strong>@avgTotal.ToString("N1") h</strong> &nbsp;|&nbsp;
                    HE Prom./Trab. = <strong>@avgProm.ToString("N2") h</strong>.
                    Áreas que superan <em>cualquiera</em> de estos valores aparecen resaltadas en rojo.
                </p>
                <div style="max-height:280px; overflow-y:auto;">
                    <table class="table table-sm table-hover mb-0" style="font-size:.78rem;">
                        <thead class="table-dark sticky-top">
                            <tr>
                                <th>Área</th>
                                <th class="text-end">HE (h)</th>
                                <th class="text-end">Prom.</th>
                                <th>Diagnóstico</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in areasAcum)
                            {
                                var diag  = Diagnostico(a.TotalHE, a.PromHE);
                                var color = BadgeColor(diag);
                                var label = BadgeLabel(diag);
                                var icon  = BadgeIcon(diag);
                                string accion = diag switch {
                                    "sobrecargada"         => "Revisar dotación, redistribuir carga o evaluar contratación urgente",
                                    "carga-distribuida"    => "Optimizar turnos o procesos; analizar si el volumen es estructural",
                                    "dependencia-personas" => "Identificar trabajadores críticos; redistribuir o capacitar relevo",
                                    _                      => "Mantener seguimiento mensual; vigilar si supera el umbral"
                                };
                                <tr>
                                    <td class="fw-semibold">@a.Area</td>
                                    <td class="text-end @(a.TotalHE >= avgTotal ? "text-danger fw-semibold" : "")">@a.TotalHE.ToString("N1")</td>
                                    <td class="text-end @(a.PromHE >= avgProm ? "text-danger fw-semibold" : "")">@a.PromHE.ToString("N2")</td>
                                    <td><span class="badge bg-@color">@icon @label</span></td>
                                    <td class="text-muted" style="font-size:.72rem;">@accion</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

