                <div>
                    <span class="badge bg-secondary" style="font-size:.68rem;border-radius:1px;" title="Ciclo de reproceso">C.@s.NroCiclo</span>
                </div>
            </div>

            @* ── Panel colapsable: Flujo + Eventos por sublote ── *@
            <div class="sublote-panel">
                <button class="sublote-panel-toggle" type="button"
                        data-bs-toggle="collapse" data-bs-target="#@panelId"
                        aria-expanded="false" aria-controls="@panelId">
                    <i class="bi bi-chevron-down toggle-ico"></i>
                    <i class="bi bi-calendar2-range me-1"></i>Línea de tiempo y eventos del sublote
                    @if (eventosSub.Any())
                    {
                        <span class="badge bg-secondary ms-1" style="font-size:.6rem;">@eventosSub.Count ev.</span>
                    }
                </button>
                <div class="collapse" id="@panelId">
                    <div class="sublote-panel-body">
                        @* mini-tabs *@
                        <ul class="nav sub-tabs" id="tabs-@subIdx" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" data-bs-toggle="tab"
                                        data-bs-target="#@tabFlujoId" type="button" role="tab">
                                    <i class="bi bi-calendar2-range me-1"></i>Línea de tiempo
                                </button>
                            </li>
                            @{
                                var tabTtId   = $"tab-tt-{subIdx}";
                                var hayttData = s.NumPartida > 0 && Model.DetalleTt.TryGetValue(s.NumPartida, out var detTtBut) && (detTtBut.TieneBanos || detTtBut.Calidad != null);
                            }
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" data-bs-toggle="tab"
                                        data-bs-target="#@tabTtId" type="button" role="tab">
                                    <i class="bi bi-gear-fill me-1" style="color:#6f42c1;"></i>Detalle de producción
                                    @if (hayttData)
                                    {
                                        <span class="badge ms-1" style="background:#6f42c1;font-size:.6rem;">@(Model.DetalleTt[s.NumPartida].Banos.Count) baños</span>
                                    }
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" data-bs-toggle="tab"
                                        data-bs-target="#@tabEventosId" type="button" role="tab">
                                    <i class="bi bi-journal-text me-1"></i>Historial de eventos
                                    @if (eventosSub.Any())
                                    {
                                        <span class="badge bg-secondary ms-1" style="font-size:.6rem;">@eventosSub.Count</span>
                                    }
                                </button>
                            </li>
                        </ul>
                        <div class="tab-content sub-tab-panel">

                            @* Tab Flujo *@
                            <div class="tab-pane fade show active" id="@tabFlujoId" role="tabpanel">
                                @{
                                    var maqEfectiva = s.MaqTtEfectiva;
                                    var maqSrc = !string.IsNullOrEmpty(s.CodMaqTt) || !string.IsNullOrEmpty(s.MaqPartida) ? "real" : "prog";
                                    // Fechas reales TT desde DetalleTt (fallback para partidas sistema nuevo donde FchRealTin* = NULL)
                                    PlnDetalleTt? _dtFb = null;
                                    if (s.NumPartida > 0) Model.DetalleTt.TryGetValue(s.NumPartida, out _dtFb);
                                    // ── Corrección de fechas retroactivas ──────────────────────────────────────
                                    // FUENTE ÚNICA: DetalleTt (mismas tablas legacy que la pestaña Tintorería)
                                    // FUENTE ÚNICA: DetalleTt (mismas tablas legacy que la pestaña Tintorería).
                                    // PLN_SEGUIMIENTO.FCH_REAL_* solo como respaldo cuando no hay DetalleTt.
                                    // PASO '03' (Lab):           usa FchValidacion de L_VALIDA_RECETA.F_ESTADO_TRES
                                    // PASO '04' (En Hilandería): usa PARTIDA.FECHA (FechaPartida)
                                    // PASO '05' (Lote Disp.):   usa s.FchRealPartida (FCH_REAL_PARTIDA, set por PASO '05')
                                    // PASO '10': usa REVISADO_G.A_ADFECHA (FchRegistro)
                                    // PASO '11': usa REVISADO_D.FECHA (primer detalle con aprobado>0)
                                    var _labFchReg   = _dtFb?.ValidacionReceta?.FchRegistro;
                                    var _tinIniEfect = _dtFb?.InicioTt ?? s.FchRealTinIni;
                                    var _fch02 = s.FchRealProgramado;
                                    if (_fch02.HasValue && _labFchReg.HasValue && _fch02.Value.Date > _labFchReg.Value.Date)
                                        _fch02 = _labFchReg;
                                    // PASO '04' (En Hilandería): PARTIDA.FECHA = cuando se insertó el lote en hilandería
                                    // SP_PLN_AVANZA_PASO guarda FCH_REAL_PRODUCCION en PASO '04', así que ambas fuentes coinciden.
                                    var _fch03 = _dtFb?.FechaPartida ?? s.FchRealProduccion;
                                    // _fch04 reservado; PASO '05' usa s.FchRealPartida directamente en el switch fReal.
                                    DateTime? _fch04 = _dtFb?.Devanados.Count > 0
                                        ? _dtFb!.Devanados.Min(d => (DateTime?)d.FechaIni)
                                        : s.FchRealPartida;
                                    // PASO '10': REVISADO_G.A_ADFECHA
                                    DateTime? _fch10 = _dtFb?.Revisados.Count > 0
                                        ? _dtFb!.Revisados.Min(r => (DateTime?)r.FchRegistro)
                                        : s.FchRealDevanado;
                                    // PASO '11': REVISADO_D.FECHA (primer detalle aprobado)
                                    DateTime? _fch11 = (_dtFb?.Revisados.Count > 0 && _dtFb!.Revisados[0].Detalle.Count > 0)
                                        ? (DateTime?)_dtFb.Revisados[0].Detalle[0].Fecha
                                        : s.FchRealCalidad;
                                }
                                <div class="tl-grid">
                                    @foreach (var ec in Model.Pasos.OrderBy(p => p.OrdenPaso))
                                    {
                                        var esActivo    = s.CodPasoAct == ec.CodPaso;
                                        var completado  = ec.OrdenPaso < ordenActSub;

                                        // Etapas condicionales: ocultar si no aplican Y el lote nunca pasó por ellas
                                        bool omitirPaso = (ec.CodPaso == "09B" && s.Proceso != "24" && !esActivo && s.FchRealGaseado == null)
                                                       || (ec.CodPaso == "9R"  && s.FchRealCcRechazo == null && !esActivo);
                                        if (omitirPaso) continue;

                                        var clase       = esActivo ? "activo" : completado ? "completado" : "pendiente";
                                        var colorPaso   = completado ? "#2f855a" : esActivo ? ec.ColorUi : "#ced4da";
                                        var esOrient    = pasosOrientativos.Contains(ec.CodPaso);
                                        // Para '08' (Secado): usar máquina real de la secadora (TT_RSECADO.COD_MAQ), no la máquina TT
                                        var maqStep = maqEfectiva;
                                        if (ec.CodPaso == "08" && Model.DetalleTt.TryGetValue(s.NumPartida, out var _dts08)
                                            && !string.IsNullOrEmpty(_dts08?.Secado?.CodMaq))
                                            maqStep = _dts08!.Secado!.CodMaq;
                                        bool mostrarMaq = maqStepsTT.Contains(ec.CodPaso) && !string.IsNullOrEmpty(maqStep)
                                                          && !(ec.CodPaso == "09B" && s.Proceso != "24")
                                                          && !(ec.CodPaso == "9R"  && s.FchRealCcRechazo == null)
                                                          // Para pasos TT PENDIENTES (ni activo ni completado): mostrar máquina solo
                                                          // en el primero del área TT ('06'). Los demás (07/08/09) son redundantes
                                                          // hasta que ese paso sea el activo.
                                                          && (esActivo || completado || ec.CodPaso == "06");

                                        string? fEst = ec.CodPaso switch {
                                            "01" => s.FchPedido.ToString("dd/MM/yy"),
                                            "02" => s.FchRealProgramado?.ToString("dd/MM/yy"),
                                            "03" => s.FchEstHilanderia?.ToString("dd/MM/yy"),
                                            "04" => s.FchEstPartida?.ToString("dd/MM/yy"),
                                            "05" => s.FchEstPartida?.ToString("dd/MM/yy"),
                                            "06" => s.FchEstTinIni?.ToString("dd/MM/yy"),
                                            "07" => s.FchEstTinFin?.ToString("dd/MM/yy"),
                                            "08" => s.FchEstSecado?.ToString("dd/MM/yy"),
                                            "09" => s.FchEstCalidad?.ToString("dd/MM/yy"),
                                            "10" => s.FchEstCalidad?.ToString("dd/MM/yy"),
                                            "11" => s.FchEstCalidad?.ToString("dd/MM/yy"),
                                            "12" => s.FchEstCalidad?.ToString("dd/MM/yy"),
                                            "13" => s.FchEstDespacho?.ToString("dd/MM/yy"),
                                            "14" => s.FchEstDespacho?.ToString("dd/MM/yy"),
                                            _    => null
                                        };
                                        string? fReal = ec.CodPaso switch {
                                            "01" => s.FchPedido.ToString("dd/MM/yy"),
                                            "02" => _fch02?.ToString("dd/MM/yy"),
                                            "03" => _dtFb?.ValidacionReceta?.FchValidacion?.ToString("dd/MM/yy")  // Lab: L_VALIDA_RECETA.F_ESTADO_TRES
                                                    ?? s.FchRealProduccion?.ToString("dd/MM/yy"),              // fallback: FCH_REAL_PRODUCCION
                                            "04" => _fch03?.ToString("dd/MM/yy"),                              // En Hilandería: PARTIDA.FECHA
                                            "05" => s.FchRealPartida?.ToString("dd/MM/yy"),                   // Lote Disponible: H_RPRODUC date
                                            "06" => (_dtFb?.InicioTt ?? s.FchRealTinIni)?.ToString("dd/MM/yy"),
                                            "07" => (_dtFb?.FinTt ?? s.FchRealTinFin)?.ToString("dd/MM/yy"),
                                            "08" => (_dtFb?.Secado?.FechaFin ?? s.FchRealSecado)?.ToString("dd/MM/yy"),
                                            "09"  => (_dtFb?.Calidad != null ? (DateTime?)_dtFb.Calidad.Fecha : s.FchRealCcTinto)?.ToString("dd/MM/yy"),
                                            "09B" => s.FchRealGaseado?.ToString("dd/MM/yy"),
                                            "9R"  => s.FchRealCcRechazo?.ToString("dd/MM/yy"),
                                            "10" => _fch10?.ToString("dd/MM/yy"),
                                            "11" => _fch11?.ToString("dd/MM/yy"),
                                            "12" => s.FchRealAlmPt?.ToString("dd/MM/yy"),
                                            "13" => s.FchRealAlmPt?.ToString("dd/MM/yy"),
                                            "14" => s.FchRealDespacho?.ToString("dd/MM/yy"),
                                            _    => null
                                        };

                                        <div class="tl-step @clase">
                                            <div class="tl-dot" style="background:@colorPaso;"></div>
                                            <div class="tl-cod">
                                                <span class="badge" style="background:@colorPaso;color:#fff;font-size:.63rem;min-width:24px;text-align:center;border-radius:1px;">@ec.CodPaso</span>
                                            </div>
                                            <div class="tl-nombre @clase">
                                                @ec.NombrePaso
                                                @if (!string.IsNullOrEmpty(ec.Area))
                                                {
                                                    <span class="badge bg-light text-secondary border ms-1" style="font-size:.58rem;font-weight:500;">@ec.Area</span>
                                                }
                                                @if (ec.CodPaso == "03")
                                                {
                                                    <i class="bi bi-info-circle ms-1 text-secondary"
                                                       style="font-size:.7rem;cursor:help;"
                                                       title="El laboratorio valida la receta de tintorería antes de que el lote físico se cree en hilandería. Por eso su fecha es anterior a 'En Hilandería'."></i>
                                                }
                                                @if (esActivo)
                                                {
                                                    <span class="badge ms-1" style="background:@colorPaso;font-size:.6rem;color:#fff;border-radius:1px;">● Activo</span>
                                                }
                                                @if (esOrient)
                                                {
                                                    <i class="bi bi-pin-angle ms-1 text-warning" style="font-size:.68rem;" title="Fecha orientativa"></i>
                                                }
                                                @if (mostrarMaq)
                                                {
                                                    // Paso '09' activo + TT/Secado ya completados → la máquina terminó su trabajo con ESTE lote.
                                                    // Mostrar live-load confunde: la carga visible es de OTRO lote distinto.
                                                    var ttMaqTerminada  = (ec.CodPaso == "09" && esActivo
                                                                          && (s.FchRealSecado.HasValue || s.FchRealTinFin.HasValue))
                                                                       || (ec.CodPaso == "08" && esActivo && s.FchRealSecado.HasValue); // secado físico completado, CC pendiente
                                                    var loteCerrado     = s.EstaCerrado || completado || ttMaqTerminada;
                                                    // Paso TT pendiente: el lote aún no llegó a TT. La máquina está asignada
                                                    // pero NO está procesando este lote ahora mismo.
                                                    var esPendienteTT   = !esActivo && !completado && !s.EstaCerrado;
                                                    var hayConflicto    = !loteCerrado && !esPendienteTT && s.HayConflictoMaquina;
                                                    var maqLabel    = esPendienteTT        ? "Máquina planificada para TT"
                                                                    : loteCerrado          ? "Máquina utilizada en este lote"
                                                                    : maqSrc == "real"     ? "Máquina asignada a este lote"
                                                                                           : "Máquina planificada";
                                                    var maqBadge    = ttMaqTerminada                      ? "TT completado ✓"
                                                                    : loteCerrado                         ? "Lote procesado ✓"
                                                                    : esPendienteTT && maqSrc == "real"   ? "Confirmada para TT"
                                                                    : esPendienteTT                       ? "Pendiente de confirmar"
                                                                    : hayConflicto                        ? "Asignada · no en uso ahora"
                                                                    : maqSrc == "real"                    ? "Asignación confirmada"
                                                                                                          : "Pendiente de confirmar";
                                                    var maqBadgeCss = loteCerrado      ? "maq-src-done"
                                                                    : hayConflicto     ? "maq-src-conflicto"
                                                                    : maqSrc == "real" ? "maq-src-real"
                                                                                       : "maq-src-prog";
                                                    var maqBoxCss   = loteCerrado      ? "maq-cerrado"
                                                                    : maqSrc == "real" ? "maq-real"
                                                                                       : "maq-prog";
                                                    <div class="maq-box @maqBoxCss" data-maq="@maqStep" data-cerrado="@(loteCerrado || hayConflicto || esPendienteTT ? "true" : "false")" data-propio="@(_dtFb != null && _dtFb.Banos.Any(b => b.CodMaq == maqStep && !b.FechaFin.HasValue) ? "true" : "false")">
                                                        <div class="maq-header-row">
                                                            <i class="bi bi-gear-fill" style="font-size:.6rem;color:#718096;"></i>
                                                            <span class="maq-header-lbl">@maqLabel</span>
                                                            <span class="maq-src-badge @maqBadgeCss">@maqBadge</span>
                                                        </div>
                                                        <div class="maq-id-row">
                                                            <span class="maq-cod">@maqStep</span>
                                                            <span class="maq-nombre">@maqNombre(maqStep)</span>
                                                        </div>
                                                        @{
                                                            var _crCnt    = _dtFb?.CalculoRecetas.Count ?? 0;
                                                            var _bnDone   = _dtFb?.Banos.Count(b => b.FechaFin.HasValue) ?? 0;
                                                            var _bnTotal  = Math.Max(_crCnt, _dtFb?.Banos.Count ?? 0);
                                                        }
                                                        @if (_dtFb != null && _bnTotal > 0 && maqStepsTT.Contains(ec.CodPaso) && ec.CodPaso != "08")
                                                        {
                                                            var _pctBanos = _bnTotal > 0 ? (int)Math.Round(_bnDone * 100.0 / _bnTotal) : 0;
                                                            var _banosCss = _bnDone == _bnTotal ? "maq-banos-completo" : _bnDone > 0 ? "maq-banos-parcial" : "maq-banos-pendiente";
                                                            <div class="maq-banos-row @_banosCss">
                                                                <i class="bi bi-layers-fill" style="font-size:.6rem;opacity:.65;"></i>
                                                                <span>@_bnDone de @_bnTotal baño@(_bnTotal != 1 ? "s" : "") completado@(_bnDone != 1 ? "s" : "")</span>
                                                                @if (_bnDone > 0 && _bnDone < _bnTotal)
                                                                {
                                                                    <span class="badge ms-1" style="background:#d97706;color:#fff;font-size:.57rem;">@(_bnTotal - _bnDone) pendiente@((_bnTotal - _bnDone) != 1 ? "s" : "")</span>
                                                                }
                                                            </div>
                                                        }
                                                        @if (ec.CodPaso == "08" && _dtFb != null)
                                                        {
                                                            var _nSecMaq = _dtFb.Secados.Count(x => x.CodMaq == maqStep);
                                                            if (_nSecMaq > 1)
                                                            {
                                                                <div class="maq-banos-row maq-banos-completo">
                                                                    <i class="bi bi-arrow-repeat" style="font-size:.6rem;opacity:.65;"></i>
                                                                    <span>Secado en @_nSecMaq sesiones en esta máquina</span>
                                                                </div>
                                                            }
                                                        }
                                                        @if (loteCerrado)
                                                        {
                                                            // Para paso '09' terminado: mostrar la fecha de Secado real
                                                            // Misma fuente que pestaña Tintorería: DetalleTt primero
                                                            var _secFin    = _dtFb?.Secado?.FechaFin ?? s.FchRealSecado;
                                                            var fechaProc  = ttMaqTerminada && _secFin.HasValue
                                                                ? _secFin!.Value.ToString("dd/MM/yy")
                                                                : fReal ?? fEst;
                                                            var procLabel  = ttMaqTerminada ? "Tenido/Secado el" : "Procesado el";
                                                            var esEstimada = !ttMaqTerminada && fReal == null && fEst != null;
                                                            if (fechaProc != null)
                                                            {
                                                                <div class="maq-proc-row">
                                                                    @if (!esEstimada)
                                                                    {
                                                                        <i class="bi bi-check-circle-fill text-success" style="font-size:.65rem;"></i>
                                                                        <span class="maq-proc-date">@procLabel @fechaProc</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <i class="bi bi-calendar2-check" style="font-size:.65rem;color:#9ca3af;"></i>
                                                                        <span class="maq-proc-date" style="color:#9ca3af;font-style:italic;">Est. @fechaProc</span>
                                                                    }
                                                                </div>
                                                            }
                                                        }
                                                        @if (!loteCerrado)
                                                        {
                                                            var tieneEnProceso  = _dtFb != null && _dtFb.Banos.Any(b => b.CodMaq == maqStep && !b.FechaFin.HasValue);
                                                            var sepLabel = esPendienteTT || !tieneEnProceso
                                                                ? "Estado actual de la máquina asignada"
                                                                : "Actividad actual en esta máquina";
                                                            <div class="maq-sep-label"><i class="bi bi-activity" style="font-size:.55rem;"></i>@sepLabel</div>
                                                            <div class="maq-status-row">
                                                                <span class="maq-live loading"><span class="dot-live"></span><span class="live-txt">consultando…</span></span>
                                                                <span class="maq-carga-lbl">Carga:</span>
                                                                <div class="maq-carga-bar"><div class="maq-carga-fill"></div></div>
                                                                <span class="maq-carga-pct">consultando…</span>
                                                            </div>
                                                        }
                                                    </div>
                                                    @if (hayConflicto)
                                                    {
                                                        <div class="maq-box maq-real-tt" data-maq="@s.MaqRealTt" data-cerrado="false">
                                                            <div class="maq-header-row">
                                                                <i class="bi bi-activity" style="font-size:.6rem;color:#e65c00;"></i>
                                                                <span class="maq-header-lbl">Máquina real en TT ahora</span>
                                                                <span class="maq-src-badge maq-src-real-tt">En proceso · TT</span>
                                                            </div>
                                                            <div class="maq-id-row">
                                                                <span class="maq-cod">@s.MaqRealTt</span>
                                                                <span class="maq-nombre">@maqNombre(s.MaqRealTt)</span>
                                                            </div>
                                                            <div class="maq-status-row">
                                                                <span class="maq-live loading"><span class="dot-live"></span><span class="live-txt">consultando…</span></span>
                                                                <span class="maq-carga-lbl">Carga:</span>
                                                                <div class="maq-carga-bar"><div class="maq-carga-fill"></div></div>
                                                                <span class="maq-carga-pct">consultando…</span>
                                                            </div>
                                                        </div>
                                                    }
                                                    @* ── Otras máquinas planificadas (esPendienteTT — lote aún no en TT) ────── *@
                                                    @if (esPendienteTT && _dtFb != null && _dtFb.CalculoRecetas.Count > 1)
                                                    {
                                                        @foreach (var xCr in _dtFb.CalculoRecetas
                                                            .Where(r => !string.IsNullOrEmpty(r.CodMaqPlanif) && r.CodMaqPlanif != maqStep)
                                                            .GroupBy(r => r.CodMaqPlanif))
                                                        {
                                                            var xMaqP  = xCr.Key!;
                                                            var xDescP = xCr.OrderBy(r => r.Proceso).First().DescProceso;
                                                            var xKgP   = xCr.Sum(r => r.PesoNeto);
                                                            <div class="maq-box maq-prog mt-1" data-maq="@xMaqP" data-cerrado="true">
                                                                <div class="maq-header-row">
                                                                    <i class="bi bi-gear" style="font-size:.6rem;color:#718096;"></i>
                                                                    <span class="maq-header-lbl">Otra máquina planificada para TT</span>
                                                                    <span class="maq-src-badge maq-src-prog">Planificada</span>
                                                                </div>
                                                                <div class="maq-id-row">
                                                                    <span class="maq-cod">@xMaqP</span>
                                                                    <span class="maq-nombre">@maqNombre(xMaqP)</span>
                                                                </div>
                                                                <div class="maq-proc-row">
                                                                    <i class="bi bi-layers" style="font-size:.65rem;color:#718096;"></i>
                                                                    <span class="maq-proc-date" style="color:#718096;">@xDescP · @string.Format("{0:N2}", xKgP) kg planif.</span>
                                                                </div>
                                                                <div class="maq-status-row">
                                                                    <span class="maq-live loading"><span class="dot-live"></span><span class="live-txt">consultando…</span></span>
                                                                    <span class="maq-carga-lbl">Carga:</span>
                                                                    <div class="maq-carga-bar"><div class="maq-carga-fill"></div></div>
                                                                    <span class="maq-carga-pct">consultando…</span>
                                                                </div>
                                                            </div>
                                                        }
                                                    }
                                                    @* ── Baños ya completados en otra máquina (paso aún activo) ─────────────── *@
                                                    @if (!loteCerrado && _dtFb != null && ec.CodPaso != "08"
                                                         && _dtFb.Banos.Any(b => b.FechaFin.HasValue
                                                                               && !string.IsNullOrEmpty(b.CodMaq)
                                                                               && b.CodMaq != maqStep))
                                                    {
                                                        @foreach (var xBg in _dtFb.Banos
                                                            .Where(b => b.FechaFin.HasValue && !string.IsNullOrEmpty(b.CodMaq) && b.CodMaq != maqStep)
                                                            .GroupBy(b => b.CodMaq))
                                                        {
                                                            var xMaq  = xBg.Key!;
                                                            var xFin  = xBg.OrderByDescending(b => b.FechaFin).First().FechaFin!.Value;
                                                            var xDesc = xBg.OrderBy(b => b.FechaIni).First().DescProceso;
                                                            <div class="maq-box maq-cerrado mt-1">
                                                                <div class="maq-header-row">
                                                                    <i class="bi bi-check2-circle" style="font-size:.6rem;color:#2f855a;"></i>
                                                                    <span class="maq-header-lbl">Baño completado en otra máquina</span>
                                                                    <span class="maq-src-badge maq-src-done">Completado ✓</span>
                                                                </div>
                                                                <div class="maq-id-row">
                                                                    <span class="maq-cod">@xMaq</span>
                                                                    <span class="maq-nombre">@maqNombre(xMaq)</span>
                                                                </div>
                                                                <div class="maq-proc-row">
                                                                    <i class="bi bi-check-circle-fill text-success" style="font-size:.65rem;"></i>
                                                                    <span class="maq-proc-date">@xDesc · @xFin.ToString("dd/MM/yy HH:mm")</span>
                                                                </div>
                                                            </div>
                                                        }
                                                    }
                                                    @* ── Máquinas adicionales del lote (cuando >1 máquina fue usada) ─────────── *@
                                                    @if (loteCerrado && _dtFb != null)
                                                    {
                                                        @if (maqStepsTT.Contains(ec.CodPaso) && ec.CodPaso != "08" && _dtFb.Banos.Count > 0)
                                                        {
                                                            @* Baños de TT con CodMaq diferente al principal (maqStep) *@
                                                            @foreach (var xBg in _dtFb.Banos
                                                                .Where(b => !string.IsNullOrEmpty(b.CodMaq) && b.CodMaq != maqStep)
                                                                .GroupBy(b => b.CodMaq))
                                                            {
                                                                var xMaq  = xBg.Key!;
                                                                var xFin  = xBg.Where(b => b.FechaFin.HasValue).OrderByDescending(b => b.FechaFin).Select(b => b.FechaFin).FirstOrDefault();
                                                                var xIni  = xBg.OrderBy(b => b.FechaIni).First().FechaIni;
                                                                var xProc = ec.CodPaso == "06" ? (DateTime?)xIni : xFin;
                                                                <div class="maq-box maq-cerrado mt-1">
                                                                    <div class="maq-header-row">
                                                                        <i class="bi bi-gear-fill" style="font-size:.6rem;color:#718096;"></i>
                                                                        <span class="maq-header-lbl">Máquina utilizada en este lote</span>
                                                                        <span class="maq-src-badge maq-src-done">Lote procesado ✓</span>
                                                                    </div>
                                                                    <div class="maq-id-row">
                                                                        <span class="maq-cod">@xMaq</span>
                                                                        <span class="maq-nombre">@maqNombre(xMaq)</span>
                                                                    </div>
                                                                    @if (xProc.HasValue)
                                                                    {
                                                                        <div class="maq-proc-row">
                                                                            <i class="bi bi-check-circle-fill text-success" style="font-size:.65rem;"></i>
                                                                            <span class="maq-proc-date">Procesado el @xProc.Value.ToString("dd/MM/yy")</span>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        }
                                                        @if (ec.CodPaso == "08" && _dtFb != null && _dtFb.Secados.Count > 1)
                                                        {
                                                            @* Secadoras adicionales: solo las de máquina DIFERENTE a la principal *@
                                                            @foreach (var xSec in _dtFb.Secados.SkipLast(1).Where(x => x.CodMaq != maqStep))
                                                            {
                                                                <div class="maq-box maq-cerrado mt-1">
                                                                    <div class="maq-header-row">
                                                                        <i class="bi bi-gear-fill" style="font-size:.6rem;color:#718096;"></i>
                                                                        <span class="maq-header-lbl">Secadora utilizada en este lote</span>
                                                                        <span class="maq-src-badge maq-src-done">Lote procesado ✓</span>
                                                                    </div>
                                                                    <div class="maq-id-row">
                                                                        <span class="maq-cod">@xSec.CodMaq</span>
                                                                        <span class="maq-nombre">@maqNombre(xSec.CodMaq)</span>
                                                                    </div>
                                                                    @if (xSec.FechaFin.HasValue)
                                                                    {
                                                                        <div class="maq-proc-row">
                                                                            <i class="bi bi-check-circle-fill text-success" style="font-size:.65rem;"></i>
                                                                            <span class="maq-proc-date">Procesado el @xSec.FechaFin.Value.ToString("dd/MM/yy")</span>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        }
                                                    }
                                                }
                                            </div>
                                            @if ((fEst != null || fReal != null) && !mostrarMaq)
                                            {
                                                <div class="tl-fechas">
                                                    @if (fEst != null) { <span><i class="bi bi-calendar2 me-1"></i>@fEst</span> }
                                                    @if (fReal != null) { <span class="tl-fech-real"><i class="bi bi-check2 me-1"></i>@fReal</span> }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            @* Tab Tintorería — datos completos del formulario Logix *@
                            @{
                                var tabTtPaneId = $"tab-tt-{subIdx}";
                                Model.DetalleTt.TryGetValue(s.NumPartida, out var detTt);
                            }
                            <div class="tab-pane fade" id="@tabTtPaneId" role="tabpanel">
                              @if (s.NumPartida <= 0 || detTt == null || (!detTt.TieneBanos && !detTt.TieneCalculoRecetas && detTt.Secado == null && detTt.Calidad == null && detTt.ValidacionReceta == null))
                              {
                                <div class="p-3 text-muted small">
                                    <i class="bi bi-info-circle me-1"></i>
                                    @(s.NumPartida <= 0 ? "Sin partida de tintorería asignada a este sublote." : "Sin datos de tintorería registrados para esta partida.")
                                </div>
                              }
                              else
                              {
                                <div class="p-2" style="font-size:.8rem;">
                                  <div class="accordion accordion-flush" id="acc-tt-@(subIdx)">

                                  @* ── Validación de Laboratorio ─────────────────────────────── *@
                                  @if (detTt!.ValidacionReceta != null)
                                  {
                                    var vr = detTt.ValidacionReceta;
                                    <div class="accordion-item tt-acc-item">
                                      <h2 class="accordion-header">
                                        <button class="accordion-button collapsed tt-acc-btn" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#acc-tt-@(subIdx)-lab"
                                                aria-expanded="false">
                                          <i class="bi bi-flask me-2"></i>Validación de Laboratorio
                                        </button>
                                      </h2>
                                      <div id="acc-tt-@(subIdx)-lab" class="accordion-collapse collapse">
                                        <div class="accordion-body p-2">
                                          <div class="d-flex flex-wrap gap-3 align-items-start p-2" style="background:#f8f6ff;border-radius:6px;border:1px solid #e0d8f5;">
                                            <div><span class="tt-lbl">N° Registro</span><span class="tt-val">@vr.Numero</span></div>
                                            <div><span class="tt-lbl">Tipo</span><span class="tt-val">@vr.DescTipo</span></div>
                                            <div><span class="tt-lbl">Laboratorista</span><span class="tt-val fw-semibold">@(string.IsNullOrEmpty(vr.Laboratorista) ? "—" : vr.Laboratorista)</span></div>
                                            <div><span class="tt-lbl">F. Registro</span><span class="tt-val">@vr.FchRegistro.ToString("dd/MM/yy HH:mm")</span></div>
                                            <div><span class="tt-lbl">F. Validación</span><span class="tt-val">@(vr.FchValidacion?.ToString("dd/MM/yy HH:mm") ?? "—")</span></div>
                                            <div>
                                              <span class="tt-lbl">Estado</span>
                                              <span class="badge bg-@vr.EstadoBadge" style="font-size:.65rem;">@vr.DescEstado</span>
                                              @if (vr.DiasValidacion.HasValue)
                                              {
                                                <span class="text-muted ms-1" style="font-size:.68rem;">(@vr.DiasValidacion.Value d.)</span>
                                              }
                                            </div>
                                          </div>
                                        </div>
                                      </div>
                                    </div>
                                  }

                                  @* ── Cálculo de Recetas planificadas ───────────────────────── *@
                                  @if (detTt!.TieneCalculoRecetas)
                                  {
                                    <div class="accordion-item tt-acc-item">
                                      <h2 class="accordion-header">
                                        <button class="accordion-button collapsed tt-acc-btn" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#acc-tt-@(subIdx)-rec"
                                                aria-expanded="false">
                                          <i class="bi bi-calculator me-2"></i>Cálculo de Recetas (planificado)
                                        </button>
                                      </h2>
                                      <div id="acc-tt-@(subIdx)-rec" class="accordion-collapse collapse">
                                        <div class="accordion-body p-2">
                                          <div class="table-responsive">
                                            <table class="table table-sm tt-table mb-0">
                                              <thead><tr>
                                                <th>Guía</th><th>Proceso</th><th>Máq. planif.</th><th style="text-align:right">Peso neto (kg)</th><th>Estado receta</th>
                                              </tr></thead>
                                              <tbody>
                                              @foreach (var cr in detTt.CalculoRecetas)
                                              {
                                                <tr>
                                                  <td class="tt-mono">@cr.Guia</td>
                                                  <td><span class="badge bg-secondary" style="font-size:.65rem;">@cr.Proceso</span> @cr.DescProceso</td>
                                                  <td>
                                                    @if (!string.IsNullOrEmpty(cr.CodMaqPlanif))
                                                    {
                                                      <span class="maq-cod-inline">@cr.CodMaqPlanif</span>
                                                      <span class="text-muted ms-1">@cr.NombreMaqPlanif</span>
                                                    }
                                                    else { <text>—</text> }
                                                  </td>
                                                  <td style="text-align:right">@(cr.PesoNeto.HasValue ? cr.PesoNeto.Value.ToString("N2") : "—")</td>
                                                  <td><span class="text-muted">@cr.DescEstReceta</span></td>
                                                </tr>
                                              }
                                              </tbody>
                                            </table>
                                          </div>
                                        </div>
                                      </div>
                                    </div>
                                  }

                                  @* ── Registro de Producción TT (baños) ─────────────────────── *@
                                  @if (detTt!.TieneBanos)
                                  {
                                    <div class="accordion-item tt-acc-item">
                                      <h2 class="accordion-header">
                                        <button class="accordion-button collapsed tt-acc-btn" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#acc-tt-@(subIdx)-ban"
                                                aria-expanded="false">
                                          <i class="bi bi-thermometer-half me-2"></i>Registro de Producción — Tintorería
                                          <span class="badge ms-2" style="background:#6f42c1;font-size:.6rem;">@detTt.Banos.Count baños</span>
                                        </button>
                                      </h2>
                                      <div id="acc-tt-@(subIdx)-ban" class="accordion-collapse collapse">
                                        <div class="accordion-body p-2">
                                          <div class="table-responsive">
                                            <table class="table table-sm tt-table mb-0">
                                              <thead><tr>
                                                <th>Guía</th><th>Proceso</th><th>Máquina real</th><th>Máq. planif.</th><th>F/Hora inicio</th><th>F/Hora fin</th><th style="text-align:right">Horas</th><th>Calificación</th>
                                              </tr></thead>
                                              <tbody>
                                              @foreach (var bn in detTt.Banos)
                                              {
                                                var bRowCss = bn.HayCambioMaquina ? "table-warning" : "";
                                                <tr class="@bRowCss">
                                                  <td class="tt-mono">@bn.Guia</td>
                                                  <td><span class="badge bg-secondary" style="font-size:.65rem;">@bn.Proceso</span> @bn.DescProceso</td>
                                                  <td>
                                                    <span class="maq-cod-inline @(bn.HayCambioMaquina ? "text-danger fw-bold" : "")">@bn.CodMaq</span>
                                                    <span class="text-muted ms-1">@bn.NombreMaq</span>
                                                    @if (bn.HayCambioMaquina)
                                                    {
                                                      <i class="bi bi-exclamation-triangle-fill text-warning ms-1" title="Máquina diferente a la planificada"></i>
                                                    }
                                                  </td>
                                                  <td>
                                                    @if (!string.IsNullOrEmpty(bn.CodMaqPlanif))
                                                    {
                                                      <span class="maq-cod-inline text-secondary">@bn.CodMaqPlanif</span>
