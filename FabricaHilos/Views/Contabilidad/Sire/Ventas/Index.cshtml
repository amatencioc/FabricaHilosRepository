                                <td class="text-end fw-bold">@propuesta.Sum(x => x.IgvIpmDg).ToString("N2")</td>
                                <td class="text-end fw-bold text-muted">@propuesta.Sum(x => x.Isc).ToString("N2")</td>
                                <td class="text-end fw-bold" style="color:var(--sire-rvie);">@propuesta.Sum(x => x.TotalCp).ToString("N2")</td>
