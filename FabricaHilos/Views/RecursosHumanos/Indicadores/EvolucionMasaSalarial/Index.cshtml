@{
    ViewData["Title"] = "KPI Evolución Mensual de Masa Salarial";
    int anoIni = ViewBag.AnoIni;
    int mesIni = ViewBag.MesIni;
    int anoFin = ViewBag.AnoFin;
    int mesFin = ViewBag.MesFin;
}

@section Styles {
<style>
    .chart-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 10px rgba(0,0,0,.08);
        height: 100%;
        background: #f5f5f2;
    }
    .chart-card .card-body  { background: #f0f0ec; border-radius: 0 0 12px 12px; }
    .chart-card .card-header {
        background: transparent;
        color: #1B4D3E;
        font-weight: 600;
        border-bottom: 1px solid #e0e0e0;
        border-radius: 12px 12px 0 0 !important;
    }
    .filter-bar {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,.07);
        padding: .85rem 1.25rem;
        margin-bottom: 1.4rem;
    }
    .kpi-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 10px rgba(0,0,0,.08);
        background: #fff;
        text-align: center;
        padding: 1.1rem .75rem;
    }
    .kpi-card .kpi-icon  { font-size: 2rem; line-height: 1; margin-bottom: .35rem; }
    .kpi-card .kpi-label { font-size: .72rem; color: #637381; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }
    .kpi-card .kpi-value { font-size: 1.75rem; font-weight: 700; color: #1B4D3E; line-height: 1.1; }
    .kpi-card .kpi-sub   { font-size: .72rem; color: #9ca3af; margin-top: .15rem; }
    .section-title {
        font-size: 1rem;
        font-weight: 700;
        color: #1B4D3E;
        margin: 1.4rem 0 .4rem;
        border-left: 4px solid #1B4D3E;
        padding-left: .5rem;
    }
    #kpi-container { min-height: 200px; }
</style>
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a href="/RecursosHumanos">Recursos Humanos</a></li>
    <li class="breadcrumb-item active">KPI Evolución Mensual de Masa Salarial</li>
}

<!-- ── Filtros ─────────────────────────────────────────────── -->
<div class="filter-bar">
    <form id="frmFiltro" class="d-flex flex-wrap align-items-end gap-3" data-no-loading>
        <div>
            <label class="form-label mb-1 small fw-semibold">Año Inicio</label>
            <input type="number" id="anoIni" name="anoIni" class="form-control form-control-sm" style="width:90px"
                   value="@anoIni" min="2000" max="2099" />
        </div>
        <div>
            <label class="form-label mb-1 small fw-semibold">Mes Inicio</label>
            <select id="mesIni" name="mesIni" class="form-select form-select-sm" style="width:120px">
                @for (int m = 1; m <= 12; m++)
                {
                    if (m == mesIni)
                    { <option value="@m" selected>@System.Globalization.CultureInfo.GetCultureInfo("es-PE").DateTimeFormat.GetMonthName(m)</option> }
                    else
                    { <option value="@m">@System.Globalization.CultureInfo.GetCultureInfo("es-PE").DateTimeFormat.GetMonthName(m)</option> }
                }
            </select>
        </div>
        <div>
            <label class="form-label mb-1 small fw-semibold">Año Fin</label>
            <input type="number" id="anoFin" name="anoFin" class="form-control form-control-sm" style="width:90px"
                   value="@anoFin" min="2000" max="2099" />
        </div>
        <div>
            <label class="form-label mb-1 small fw-semibold">Mes Fin</label>
            <select id="mesFin" name="mesFin" class="form-select form-select-sm" style="width:120px">
                @for (int m = 1; m <= 12; m++)
                {
                    if (m == mesFin)
                    { <option value="@m" selected>@System.Globalization.CultureInfo.GetCultureInfo("es-PE").DateTimeFormat.GetMonthName(m)</option> }
                    else
                    { <option value="@m">@System.Globalization.CultureInfo.GetCultureInfo("es-PE").DateTimeFormat.GetMonthName(m)</option> }
                }
            </select>
        </div>
        <button type="submit" class="btn btn-sm btn-success">
            <i class="bi bi-arrow-clockwise me-1"></i>Consultar
        </button>
    </form>
</div>

<div id="kpi-container">
    <div class="text-center py-5 text-muted">
        <i class="bi bi-currency-dollar display-4 d-block mb-2"></i>
        Seleccione el período y presione <strong>Consultar</strong> para ver el dashboard.
    </div>
</div>

<!-- ── Ficha Técnica ────────────────────────────────────────── -->
<div class="accordion mt-4" id="accordionFicha">
    <div class="accordion-item border-0 shadow-sm">
        <h2 class="accordion-header" id="headingFicha">
            <button class="accordion-button collapsed fw-semibold" type="button"
                    data-bs-toggle="collapse" data-bs-target="#collapseFicha"
                    aria-expanded="false" aria-controls="collapseFicha"
                    style="background:#f8f9fa; color:#1B4D3E; border-radius:8px;">
                <i class="bi bi-info-circle me-2"></i> Ficha Técnica del Indicador — <span class="ms-1 text-muted fw-normal">EvoluciónMensualMasaSalarial</span>
            </button>
        </h2>
        <div id="collapseFicha" class="accordion-collapse collapse" aria-labelledby="headingFicha">
            <div class="accordion-body pt-3" style="background:#fff; border-radius:0 0 8px 8px;">

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <p class="mb-1"><span class="fw-semibold">Nombre:</span> Evolución Mensual de Masa Salarial</p>
                        <p class="mb-1"><span class="fw-semibold">Tipo:</span> KPI de Gestión de Personal — Costo Laboral</p>
                        <p class="mb-1"><span class="fw-semibold">Periodicidad:</span> Mensual</p>
                        <p class="mb-1"><span class="fw-semibold">Dimensiones de análisis:</span> Área / Mes / Año</p>
                        <p class="mb-0"><span class="fw-semibold">Fuente de datos:</span> Planilla mensual — Masa salarial: RTPS <code>0121</code> · Sobretiempo: RTPS <code>0105</code> (25%), <code>0106</code> (35%), <code>0107</code> (100%)</p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-1 fw-semibold">Definición:</p>
                        <p class="mb-0 text-secondary small">Mide la evolución mensual del gasto total en remuneraciones (masa salarial) por área, incorporando el sobretiempo pagado y el ratio HE/Masa para evaluar el peso relativo del costo extraordinario sobre el costo laboral total.</p>
                    </div>
                </div>

                <hr class="my-3">

                <p class="fw-semibold mb-2">Fórmulas:</p>
                <div class="row g-3 mb-4">
                    <div class="col-md-4 text-center">
                        <div class="p-3 rounded" style="background:#f5f5f2;">
                            <div class="small text-muted fw-semibold mb-2">Ratio HE / Masa Salarial</div>
                            <div style="font-size:.95rem;">
                                <span style="display:inline-block; text-align:center; line-height:1.4;">
                                    <span style="display:block; border-bottom:1.5px solid #374151; padding-bottom:2px;">Sobretiempo (S/.)</span>
                                    <span style="display:block; padding-top:2px;">Masa Salarial (S/.)</span>
                                </span>
                                &nbsp;× 100
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 text-center">
                        <div class="p-3 rounded" style="background:#f5f5f2;">
                            <div class="small text-muted fw-semibold mb-2">Variación vs Mes Anterior (S/.)</div>
                            <div style="font-size:.95rem; line-height:1.6;">
                                Masa Salarial Mes <em>N</em><br>
                                <span style="font-size:.85rem;">−</span><br>
                                Masa Salarial Mes <em>N−1</em>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 text-center">
                        <div class="p-3 rounded" style="background:#f5f5f2;">
                            <div class="small text-muted fw-semibold mb-2">Variación % vs Mes Anterior</div>
                            <div style="font-size:.95rem;">
                                <span style="display:inline-block; text-align:center; line-height:1.4;">
                                    <span style="display:block; border-bottom:1.5px solid #374151; padding-bottom:2px;">Masa <em>N</em> − Masa <em>N−1</em></span>
                                    <span style="display:block; padding-top:2px;">Masa <em>N−1</em></span>
                                </span>
                                &nbsp;× 100
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="my-3">

                <div class="row g-3 mb-4">
                    <div class="col-md-5">
                        <p class="fw-semibold mb-2">Indicadores que expone:</p>
                        <ul class="list-unstyled small mb-0">
                            <li class="mb-1"><code>MASA_SALARIAL</code> — Gasto total en remuneraciones (S/.)</li>
                            <li class="mb-1"><code>SOBRETIEMPO</code> — Costo de horas extras (S/.)</li>
                            <li class="mb-1"><code>RATIO_HE_PCT</code> — % que representa el sobretiempo sobre la masa</li>
                            <li class="mb-1"><code>VAR_VS_MES_ANT</code> — Diferencia absoluta vs mes anterior (S/.)</li>
                            <li class="mb-1"><code>VAR_PCT</code> — Variación porcentual vs mes anterior</li>
                            <li class="mb-0"><code>NRO_TRAB</code> — Headcount del área en planilla</li>
                        </ul>
                    </div>
                    <div class="col-md-7">
                        <p class="fw-semibold mb-2">Alertas por umbral del Ratio HE:</p>
                        <table class="table table-sm table-bordered small mb-0">
                            <thead class="table-dark"><tr><th>Ratio HE %</th><th>Semáforo</th><th>Lectura</th></tr></thead>
                            <tbody>
                                <tr class="table-success"><td>0 – 5%</td><td>🟢 Normal</td><td>Sobretiempo controlado dentro del costo laboral</td></tr>
                                <tr class="table-warning"><td>5 – 10%</td><td>🟡 Moderado</td><td>Sobretiempo relevante — monitorear tendencia</td></tr>
                                <tr class="table-danger" ><td>&gt; 10%</td><td>🔴 Alto</td><td>Sobretiempo sistémico — revisar estructura de horas</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <hr class="my-3">

                <p class="fw-semibold mb-2"><i class="bi bi-bar-chart-fill me-1 text-success"></i> Cómo leer los gráficos:</p>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="p-3 rounded border small h-100" style="background:#f8fffe;">
                            <p class="fw-semibold mb-1" style="color:#1B4D3E;"><i class="bi bi-graph-up me-1"></i> Gráfico línea — Evolución empresa</p>
                            <ul class="mb-0 ps-3">
                                <li>Muestra la <strong>tendencia mes a mes</strong> de la masa salarial y el sobretiempo total empresa.</li>
                                <li>Una línea ascendente sostenida indica crecimiento del costo laboral.</li>
                                <li>Separación creciente entre ambas líneas = sobretiempo escalando más rápido que la masa.</li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 rounded border small h-100" style="background:#f8fffe;">
                            <p class="fw-semibold mb-1" style="color:#1B4D3E;"><i class="bi bi-bar-chart me-1"></i> Gráfico barras — Ratio HE %</p>
                            <ul class="mb-0 ps-3">
                                <li>Muestra el <strong>% del sobretiempo sobre la masa salarial</strong> por período.</li>
                                <li>Umbrales: 🟢 ≤5% · 🟡 5–10% · 🔴 &gt;10%</li>
                                <li>Un ratio estable o decreciente es una señal positiva de control del costo extraordinario.</li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 rounded border small h-100" style="background:#f8fffe;">
                            <p class="fw-semibold mb-1" style="color:#1B4D3E;"><i class="bi bi-bar-chart-fill me-1"></i> Gráfico barras — Masa por área</p>
                            <ul class="mb-0 ps-3">
                                <li>Muestra el <strong>peso relativo de cada área</strong> en la masa salarial total.</li>
                                <li>Las áreas con mayor masa y mayor ratio HE son las de mayor impacto en el costo laboral.</li>
                                <li>El panel <em>"Análisis Automático"</em> calcula el Pareto y el diagnóstico por área automáticamente.</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <p class="fw-semibold mb-2"><i class="bi bi-intersect me-1 text-success"></i> Cómo combinar masa salarial y ratio HE para tomar decisiones:</p>
                <table class="table table-sm table-bordered small mb-0">
                    <thead style="background:#1B4D3E; color:#fff;">
                        <tr><th>Masa Salarial</th><th>Ratio HE %</th><th>Diagnóstico</th><th>Acción sugerida</th></tr>
                    </thead>
                    <tbody>
                        <tr class="table-danger">
                            <td>🔴 Alta</td><td>🔴 &gt;10%</td>
                            <td><strong>Área de alto costo total</strong> — masa grande y con mucho sobretiempo</td>
                            <td>Revisar dotación y turnos urgentemente</td>
                        </tr>
                        <tr class="table-warning">
                            <td>🔴 Alta</td><td>🟢 ≤5%</td>
                            <td><strong>Área grande pero controlada</strong></td>
                            <td>Monitorear variación mensual</td>
                        </tr>
                        <tr class="table-warning">
                            <td>🟢 Baja</td><td>🔴 &gt;10%</td>
                            <td><strong>Área pequeña con sobretiempo desproporcionado</strong></td>
                            <td>Evaluar causas operativas o de dotación</td>
                        </tr>
                        <tr class="table-success">
                            <td>🟢 Baja</td><td>🟢 ≤5%</td>
                            <td><strong>Sin problema</strong></td>
                            <td>Mantener seguimiento periódico</td>
                        </tr>
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/lib/chartjs-plugin-datalabels/dist/chartjs-plugin-datalabels.min.js" asp-append-version="true"></script>
<script>
    if (typeof ChartDataLabels !== 'undefined') Chart.register(ChartDataLabels);

    Chart.defaults.font.family = "'Segoe UI', 'Helvetica Neue', Arial, sans-serif";
    Chart.defaults.font.size   = 12;
    Chart.defaults.color       = '#374151';

    document.getElementById('frmFiltro').addEventListener('submit', function (e) {
        e.preventDefault();
        cargarKpi();
    });

    function cargarKpi() {
        const anoIni = document.getElementById('anoIni').value;
        const mesIni = document.getElementById('mesIni').value;
        const anoFin = document.getElementById('anoFin').value;
        const mesFin = document.getElementById('mesFin').value;

        const container = document.getElementById('kpi-container');
        container.innerHTML = `
            <div class="text-center py-5">
                <div class="spinner-border text-success" style="width:2.5rem;height:2.5rem;"></div>
                <p class="mt-3 text-muted small fw-semibold">Cargando datos...</p>
            </div>`;

        fetch(`/RecursosHumanos/EvolucionMasaSalarial/Kpi?anoIni=${anoIni}&mesIni=${mesIni}&anoFin=${anoFin}&mesFin=${mesFin}`, { noLoading: true })
            .then(r => {
                if (!r.ok) throw new Error('Error ' + r.status);
                return r.text();
            })
            .then(html => {
                container.innerHTML = html;
                inicializarGraficos();
            })
            .catch(err => {
                container.innerHTML = `<div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>${err.message}</div>`;
            });
    }

    function inicializarGraficos() {
        const resumenEl = document.getElementById('chartResumenData');
        const areasEl   = document.getElementById('chartAreasData');
        if (!resumenEl || !areasEl) return;

        const resumen = JSON.parse(resumenEl.value);
        const areasRaw = JSON.parse(areasEl.value);
        if (!resumen.length) return;

        const meses = ['','Enero','Febrero','Marzo','Abril','Mayo','Junio',
                       'Julio','Agosto','Setiembre','Octubre','Noviembre','Diciembre'];
        const labelP  = r => `${meses[r.mes]} ${r.ano}`;
        const labelsRes = resumen.map(labelP);

        // ── Gráfico 1: Línea — Masa Salarial vs Sobretiempo empresa ───
        const ctxLine = document.getElementById('chartLineMasa');
        if (ctxLine) {
            new Chart(ctxLine.getContext('2d'), {
                type: 'line',
                data: {
                    labels: labelsRes,
                    datasets: [
                        {
                            label: 'Masa Salarial (S/.)',
                            data: resumen.map(r => r.masa),
                            borderColor: '#1B4D3E',
                            backgroundColor: 'rgba(27,77,62,.08)',
                            pointBackgroundColor: '#1B4D3E',
                            pointRadius: 5, tension: 0.3, fill: true, yAxisID: 'y'
                        },
                        {
                            label: 'Sobretiempo (S/.)',
                            data: resumen.map(r => r.he),
                            borderColor: '#c0392b',
                            backgroundColor: 'rgba(192,57,43,.08)',
                            pointBackgroundColor: '#c0392b',
                            pointRadius: 5, tension: 0.3, fill: true, yAxisID: 'y'
                        }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { display: true, position: 'top', labels: { boxWidth: 14, font: { size: 11 } } },
                        datalabels: { display: false },
                        tooltip: { callbacks: { label: c => ` ${c.dataset.label}: S/ ${c.parsed.y.toLocaleString('es-PE')}` } }
                    },
                    scales: {
                        x: { ticks: { maxRotation: 40, minRotation: 20, font: { size: 10 } }, grid: { display: false } },
                        y: { beginAtZero: false, grid: { color: 'rgba(0,0,0,.06)' },
                             ticks: { callback: v => 'S/ ' + (v/1000).toFixed(0) + 'K' } }
                    }
                }
            });
        }

        // ── Gráfico 2: Barras — Ratio HE % por período ─────────────────
        const ctxRatio = document.getElementById('chartBarRatio');
        if (ctxRatio) {
            new Chart(ctxRatio.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: labelsRes,
                    datasets: [{
                        label: 'Ratio HE %',
                        data: resumen.map(r => r.ratio),
                        backgroundColor: resumen.map(r => r.ratio > 10 ? '#c0392b' : r.ratio > 5 ? '#e67e22' : '#1B4D3E'),
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        datalabels: { display: true, anchor: 'end', align: 'top', formatter: v => v.toFixed(2) + '%', font: { size: 9, weight: 'bold' } },
                        tooltip: { callbacks: { label: c => ` Ratio: ${c.parsed.y.toFixed(2)}%` } }
                    },
                    scales: {
                        x: { ticks: { maxRotation: 40, minRotation: 20, font: { size: 10 } }, grid: { display: false } },
                        y: { beginAtZero: true, ticks: { callback: v => v + '%' } }
                    }
                }
            });
        }

        // ── Gráfico 3: Barras — Masa Salarial por área (acumulado) ─────
        const ctxAreas = document.getElementById('chartBarAreas');
        if (ctxAreas) {
            const areasUnicas = [...new Set(areasRaw.map(r => r.area))];
            const periodos    = [...new Map(areasRaw.map(r => [`${r.ano}-${r.mes}`, r])).keys()];
            const COLORS = ['#1B4D3E','#1565C0','#2e7d32','#e65100','#6a1b9a',
                            '#00838f','#c62828','#4e342e','#37474f','#f9a825'];

            new Chart(ctxAreas.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: areasUnicas,
                    datasets: periodos.map((p, i) => {
                        const [a, m] = p.split('-');
                        return {
                            label: `${meses[+m]} ${a}`,
                            data: areasUnicas.map(ar => {
                                const r = areasRaw.find(x => `${x.ano}-${x.mes}` === p && x.area === ar);
                                return r ? r.masa : 0;
                            }),
                            backgroundColor: COLORS[i % COLORS.length],
                            borderRadius: 3
                        };
                    })
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { display: periodos.length > 1, position: 'top', labels: { boxWidth: 14, font: { size: 11 } } },
                        datalabels: { display: false },
                        tooltip: { callbacks: { label: c => ` ${c.dataset.label}: S/ ${c.parsed.y.toLocaleString('es-PE')}` } }
                    },
                    scales: {
                        x: { ticks: { maxRotation: 40, minRotation: 20, font: { size: 10 } }, grid: { display: false } },
                        y: { beginAtZero: true, ticks: { callback: v => 'S/ ' + (v/1000).toFixed(0) + 'K' } }
                    }
                }
            });
        }
    }
</script>
}
