        </div>
    </div>
</div>

<!-- Toast notificación -->
<div class="position-fixed top-0 end-0 p-3" style="z-index:1090">
    <div id="lmsToast" class="lms-card d-flex align-items-center gap-3 p-3" style="min-width:280px;max-width:360px;display:none!important;border-left:4px solid #1d4ed8">
        <i id="lmsToastIcon" class="bi bi-info-circle-fill" style="font-size:1.2rem;color:#1d4ed8;flex-shrink:0"></i>
        <span id="lmsToastMsg" style="font-size:.84rem;color:#0f172a;flex:1"></span>
        <button type="button" onclick="hideLmsToast()" style="background:none;border:none;color:#94a3b8;cursor:pointer;padding:0"><i class="bi bi-x-lg"></i></button>
    </div>
</div>

<!-- Modal crear examen -->
<div class="modal fade" id="modalCrearExamen" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
