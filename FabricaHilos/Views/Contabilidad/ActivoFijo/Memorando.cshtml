@model FabricaHilos.Models.Contabilidad.MemorandoFormModel

@{
    ViewData["Title"] = "Generar Memorando";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Contabilidad" asp-action="Index">Contabilidad</a></li>
    <li class="breadcrumb-item"><a asp-controller="ActivoFijo" asp-action="Index">Activos Fijos</a></li>
    <li class="breadcrumb-item active">Generar Memorando</li>
}

@section Styles {
    <link rel="stylesheet" href="~/css/sire.css" asp-append-version="true" />
}

@await Html.PartialAsync("~/Views/Contabilidad/ActivoFijo/_ActivoFijoNavBar.cshtml")

<div class="sire-strip af">
    <i class="bi bi-file-earmark-text" style="color:#d7ccc8;font-size:.95rem;flex-shrink:0;"></i>
    <span class="sire-strip-title">Memorando de Baja</span>
    <span class="sire-strip-sep"></span>
    <span style="opacity:.7;font-size:.78rem;">Complete los datos del encabezado</span>
</div>

<div class="sire-card" style="max-width:720px;margin:1.2rem auto;">
    <div class="sire-card-header">
        <i class="bi bi-pencil-square"></i>
        <span>Datos del Memorando</span>
    </div>
    <div class="sire-card-body p-3">

        <form asp-action="Memorando" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Seleccion" />

            <div class="row g-2 mb-3">
                <div class="col-6 col-sm-3">
                    <label class="form-label form-label-sm fw-semibold">N&#176; Memo</label>
                    <input asp-for="NumMemo" class="form-control form-control-sm"
                           placeholder="B001" required />
                    <span asp-validation-for="NumMemo" class="text-danger small"></span>
                </div>
                <div class="col-6 col-sm-3">
                    <label class="form-label form-label-sm fw-semibold">A&#241;o</label>
                    <input asp-for="Anio" type="number" class="form-control form-control-sm" required />
                    <span asp-validation-for="Anio" class="text-danger small"></span>
                </div>
                <div class="col-6 col-sm-3">
                    <label class="form-label form-label-sm fw-semibold">&#193;rea</label>
                    <input asp-for="Area" class="form-control form-control-sm"
                           placeholder="SIST" required />
                    <span asp-validation-for="Area" class="text-danger small"></span>
                </div>
                <div class="col-6 col-sm-3">
                    <label class="form-label form-label-sm fw-semibold">Ciudad</label>
                    <input asp-for="Ciudad" class="form-control form-control-sm" required />
                </div>
            </div>

            <div class="mb-2">
                <label class="form-label form-label-sm fw-semibold">DE</label>
                <input asp-for="De" class="form-control form-control-sm"
                       placeholder="DEPARTAMENTO DE SISTEMAS" required />
                <span asp-validation-for="De" class="text-danger small"></span>
            </div>

            <div class="row g-2 mb-2">
                <div class="col-12 col-sm-6">
                    <label class="form-label form-label-sm fw-semibold">A (nombre)</label>
                    <input asp-for="Para" class="form-control form-control-sm"
                           placeholder="Gisela Tupac" required />
                    <span asp-validation-for="Para" class="text-danger small"></span>
                </div>
                <div class="col-12 col-sm-6">
                    <label class="form-label form-label-sm fw-semibold">Cargo del destinatario</label>
                    <input asp-for="CargoDestino" class="form-control form-control-sm"
                           placeholder="Contador General" />
                </div>
            </div>

            <div class="mb-2">
                <label class="form-label form-label-sm fw-semibold">REF</label>
                <input asp-for="Referencia" class="form-control form-control-sm"
                       placeholder="Baja de computadoras y Radios" required />
                <span asp-validation-for="Referencia" class="text-danger small"></span>
            </div>

            <div class="mb-2">
                <label class="form-label form-label-sm fw-semibold">Texto del cuerpo</label>
                <textarea asp-for="CuerpoTexto" rows="3" class="form-control form-control-sm"
                          placeholder="Mediante la presente se le comunica la baja del siguiente equipo..."></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label form-label-sm fw-semibold">Motivo (entre parentesis, opcional)</label>
                <input asp-for="MotivoEntre" class="form-control form-control-sm"
                       placeholder="Fallo de componentes por desgaste y antiguedad" />
            </div>

            <div class="d-flex gap-2 justify-content-end">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-sm btn-primary">
                    <i class="bi bi-printer me-1"></i>Vista previa e imprimir
                </button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
