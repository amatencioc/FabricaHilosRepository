const tabRankingsBtn = document.getElementById('tab-rankings-btn');
if (tabRankingsBtn && document.getElementById('rankCursos')) {
    tabRankingsBtn.addEventListener('shown.bs.tab', function () {
        renderRankingsExtra();
    });
}

// La pestaña "Análisis organizacional" también vive oculta al cargar la página;
// se construye recién cuando el usuario la abre.
const tabAnalisisBtn = document.getElementById('tab-analisis-btn');
if (tabAnalisisBtn && document.getElementById('analisisEstructura')) {
    tabAnalisisBtn.addEventListener('shown.bs.tab', function () {
