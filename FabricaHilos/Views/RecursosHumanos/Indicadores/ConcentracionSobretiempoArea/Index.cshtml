@section Breadcrumb {
    <li class="breadcrumb-item"><a href="/RecursosHumanos">Recursos Humanos</a></li>
    <li class="breadcrumb-item active">Comparativo Costo Laboral</li>
}

<!-- ── Filtros ─────────────────────────────────────────────────────────────
     Cada período tiene 3 campos:
        • Año             (ej: 2025)
        • Mes "Desde"     (mes inicial del rango)
        • Mes "Hasta"     (mes final del rango)
     Los dos rangos son independientes para poder comparar, por ejemplo,
     ENE–DIC 2025 (año completo) contra ENE–MAY 2026 (año en curso).
──────────────────────────────────────────────────────────────────────── -->
<div class="filter-bar">
    <form id="frmFiltro" class="d-flex flex-wrap align-items-end gap-3" data-no-loading>

        <!-- ── Período 1 (REFERENCIA) ─────────────────────────────── -->
        <div class="filter-period is-ref">
            <div class="period-title">
                <i class="bi bi-bookmark-star-fill me-1"></i>Período 1 — Referencia (base de comparación)
            </div>
            <div class="d-flex flex-wrap align-items-end gap-2">
                <div>
                    <label class="form-label mb-1 small fw-semibold text-secondary" for="ano1">Año</label>
                    <input type="number" id="ano1" name="ano1" class="form-control form-control-sm" style="width:90px"
                           value="@ano1" min="2000" max="2099"
                           title="Año de referencia (ej: 2025)" />
                </div>
                <div>
                    <label class="form-label mb-1 small fw-semibold text-secondary" for="mesIniAno1">
                        <i class="bi bi-calendar-event me-1"></i>Mes desde
                    </label>
                    <select id="mesIniAno1" name="mesIniAno1" class="form-select form-select-sm" style="width:120px"
                            title="Mes inicial del rango del Año 1">
                        @for (int m = 1; m <= 12; m++)
                        {
                            if (m == mesIniAno1)
                            { <option value="@m" selected>@System.Globalization.CultureInfo.GetCultureInfo("es-PE").DateTimeFormat.GetMonthName(m)</option> }
                            else
                            { <option value="@m">@System.Globalization.CultureInfo.GetCultureInfo("es-PE").DateTimeFormat.GetMonthName(m)</option> }
                        }
                    </select>
                </div>
                <span class="mes-sep"><i class="bi bi-arrow-right"></i></span>
                <div>
                    <label class="form-label mb-1 small fw-semibold text-secondary" for="mesFinAno1">
                        <i class="bi bi-calendar-check me-1"></i>Mes hasta
                    </label>
                    <select id="mesFinAno1" name="mesFinAno1" class="form-select form-select-sm" style="width:120px"
                            title="Mes final del rango del Año 1 (debe ser ≥ Mes desde)">
                        @for (int m = 1; m <= 12; m++)
                        {
                            if (m == mesFinAno1)
                            { <option value="@m" selected>@System.Globalization.CultureInfo.GetCultureInfo("es-PE").DateTimeFormat.GetMonthName(m)</option> }
                            else
                            { <option value="@m">@System.Globalization.CultureInfo.GetCultureInfo("es-PE").DateTimeFormat.GetMonthName(m)</option> }
                        }
                    </select>
                </div>
            </div>
        </div>

        <!-- ── Período 2 (COMPARACIÓN) ────────────────────────────── -->
        <div class="filter-period is-cmp">
            <div class="period-title">
                <i class="bi bi-graph-up-arrow me-1"></i>Período 2 — Comparación (vs el período de referencia)
            </div>
            <div class="d-flex flex-wrap align-items-end gap-2">
                <div>
                    <label class="form-label mb-1 small fw-semibold text-secondary" for="ano2">Año</label>
                    <input type="number" id="ano2" name="ano2" class="form-control form-control-sm" style="width:90px"
                           value="@ano2" min="2000" max="2099"
                           title="Año a comparar (ej: 2026)" />
                </div>
                <div>
                    <label class="form-label mb-1 small fw-semibold text-secondary" for="mesIniAno2">
                        <i class="bi bi-calendar-event me-1"></i>Mes desde
                    </label>
                    <select id="mesIniAno2" name="mesIniAno2" class="form-select form-select-sm" style="width:120px"
                            title="Mes inicial del rango del Año 2">
                        @for (int m = 1; m <= 12; m++)
                        {
                            if (m == mesIniAno2)
                            { <option value="@m" selected>@System.Globalization.CultureInfo.GetCultureInfo("es-PE").DateTimeFormat.GetMonthName(m)</option> }
                            else
                            { <option value="@m">@System.Globalization.CultureInfo.GetCultureInfo("es-PE").DateTimeFormat.GetMonthName(m)</option> }
                        }
                    </select>
                </div>
                <span class="mes-sep"><i class="bi bi-arrow-right"></i></span>
                <div>
                    <label class="form-label mb-1 small fw-semibold text-secondary" for="mesFinAno2">
                        <i class="bi bi-calendar-check me-1"></i>Mes hasta
                    </label>
                    <select id="mesFinAno2" name="mesFinAno2" class="form-select form-select-sm" style="width:120px"
                            title="Mes final del rango del Año 2 (debe ser ≥ Mes desde)">
                        @for (int m = 1; m <= 12; m++)
                        {
                            if (m == mesFinAno2)
                            { <option value="@m" selected>@System.Globalization.CultureInfo.GetCultureInfo("es-PE").DateTimeFormat.GetMonthName(m)</option> }
                            else
                            { <option value="@m">@System.Globalization.CultureInfo.GetCultureInfo("es-PE").DateTimeFormat.GetMonthName(m)</option> }
                        }
                    </select>
                </div>
            </div>
        </div>

        <!-- ── Sueldo Básico Manual (opcional) ─────────────────────
             Si el usuario ingresa un valor > 0, ese básico se usa
             como ÚNICO básico global para AMBOS períodos.
             El N° de trabajadores sigue saliendo de planilla.
             Si se deja vacío o 0 → se usa el básico calculado desde
             planilla (concepto RTPS 0121).
        ─────────────────────────────────────────────────────────── -->
        <div class="filter-period is-basic">
            <div class="period-title">
                <i class="bi bi-cash-stack me-1"></i>Sueldo Básico Promedio (opcional)
            </div>
            <div class="d-flex flex-wrap align-items-end gap-2">
                <div>
                    <label class="form-label mb-1 small fw-semibold text-secondary" for="basicoManual">
                        <i class="bi bi-currency-dollar me-1"></i>Básico S/. (mismo para ambos años)
                    </label>
                    <input type="number" id="basicoManual" name="basicoManual"
                           class="form-control form-control-sm" style="width:140px"
                           value="0" min="0" step="0.01"
                           title="Ingresa un sueldo básico promedio único para recalcular el costo laboral de ambos períodos. Deja en 0 para usar el básico real de planilla." />
                </div>
            </div>
        </div>

        <!-- ── Tipo de Empleado ───────────────────────────────────
             Filtra los registros de PARAMPLA.C_EO:
               • T = Todos (por defecto)
               • O = solo Obreros   (C_EO = 'O')
               • E = solo Empleados (C_EO = 'E')
             Se aplica al filtrado de planilla mensual antes del cálculo
             del básico/HE; afecta a Cuadros 1, 2 y 3 por igual.
        ─────────────────────────────────────────────────────────── -->
        <div class="filter-period is-tipo">
            <div class="period-title">
                <i class="bi bi-people-fill me-1"></i>Tipo de Empleado
            </div>
            <div class="d-flex flex-wrap align-items-end gap-2">
                <div>
                    <label class="form-label mb-1 small fw-semibold text-secondary" for="tipo">
                        <i class="bi bi-funnel me-1"></i>Categoría
                    </label>
                    <select id="tipo" name="tipo" class="form-select form-select-sm" style="width:140px"
                            title="Filtra por tipo de personal: Todos / sólo Obreros (C_EO='O') / sólo Empleados (C_EO='E')">
                        <option value="T" selected>Todos</option>
                        <option value="O">Obreros</option>
                        <option value="E">Empleados</option>
                    </select>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-sm btn-success align-self-end" style="height:38px;">
            <i class="bi bi-arrow-clockwise me-1"></i>Consultar
        </button>
    </form>

    <!-- Nota de ayuda visible bajo los filtros -->
    <div class="filter-hint">
        <i class="bi bi-info-circle me-1 text-primary"></i>
        <strong>Cómo leer los filtros:</strong>
        elige un <span class="badge badge-ref">Período 1</span> (referencia, ej. <em>ene–dic 2025</em>)
        y un <span class="badge badge-cmp">Período 2</span> (comparación, ej. <em>ene–may 2026</em>).
        El sistema promedia mes a mes cada rango y muestra la variación %.
        Asegúrate de que <strong>Mes desde ≤ Mes hasta</strong> en cada período.
        <br />
        <i class="bi bi-cash-stack me-1" style="color:#b8860b;"></i>
        <strong>Sueldo Básico Promedio (opcional):</strong> si lo ingresas (&gt; 0), se aplicará
        como básico único a <strong>ambos períodos</strong> para neutralizar la dispersión salarial
        por cargo. Si lo dejas en <code>0</code>, se usa el básico real promediado de planilla.
        <br />
        <i class="bi bi-people-fill me-1" style="color:#6f42c1;"></i>
        <strong>Tipo de Empleado:</strong> deja <em>Todos</em> para incluir obreros y empleados,
        o filtra por <em>Obreros</em> (<code>C_EO='O'</code>) o <em>Empleados</em> (<code>C_EO='E'</code>)
        para comparar el costo laboral solo de esa categoría.
    </div>
</div>

<div id="kpi-container">
    <div class="text-center py-5 text-muted">
        <i class="bi bi-graph-up-arrow display-4 d-block mb-2"></i>
        Seleccione los periodos y presione <strong>Consultar</strong>.
    </div>
</div>

<!-- ── Ficha Técnica ─────────────────────────────────────── -->
<div class="accordion mt-4" id="accordionFichaCL">
    <div class="accordion-item border-0 shadow-sm">
        <h2 class="accordion-header" id="headingFichaCL">
            <button class="accordion-button collapsed fw-semibold" type="button"
                    data-bs-toggle="collapse" data-bs-target="#collapseFichaCL"
                    aria-expanded="false" aria-controls="collapseFichaCL"
                    style="background:#f8f9fa; color:#1B4D3E; border-radius:8px;">
                <i class="bi bi-info-circle me-2"></i> Ficha Técnica — <span class="ms-1 text-muted fw-normal">Comparativo Costo Laboral (Opción C: básico × 1.4232)</span>
            </button>
        </h2>
        <div id="collapseFichaCL" class="accordion-collapse collapse">
            <div class="accordion-body pt-3" style="background:#fff; border-radius:0 0 8px 8px;">

                <p class="fw-semibold mb-2">¿Qué se está midiendo?</p>
                <p class="small text-secondary mb-3">
                    Este KPI compara el <strong>costo laboral total</strong> entre dos años por área.
                    El "costo laboral" incluye el <strong>sueldo básico mensual</strong> más las
                    <strong>cargas sociales devengadas</strong> que la empresa está obligada por Ley
                    a provisionar mes a mes (aunque su desembolso ocurra en planillas especiales —
                    julio y diciembre para gratificaciones, mayo y noviembre para CTS, etc.).
                </p>

                <p class="fw-semibold mb-2">Composición del factor 1.4232 (142.32%):</p>
                <div class="row g-3 mb-3">
                    <div class="col-md-7">
                        <table class="table table-sm table-bordered mb-0" style="font-size:.85rem;">
                            <thead style="background:#f5f5f2;">
                                <tr>
                                    <th>Concepto</th>
                                    <th class="text-end">% sobre básico</th>
                                    <th>Fundamento</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr><td>Sueldo Bruto Básico</td><td class="text-end fw-semibold">100.00%</td><td class="small text-muted">Concepto RTPS <code>0121</code> en planilla mensual</td></tr>
                                <tr><td>EsSalud</td><td class="text-end fw-semibold">9.00%</td><td class="small text-muted">Ley N° 26790 — carga patronal</td></tr>
                                <tr><td>CTS</td><td class="text-end fw-semibold">8.33%</td><td class="small text-muted">1/12 — devengado mensual</td></tr>
                                <tr><td>Gratificaciones</td><td class="text-end fw-semibold">16.66%</td><td class="small text-muted">2/12 — Julio + Diciembre</td></tr>
                                <tr><td>Vacaciones</td><td class="text-end fw-semibold">8.33%</td><td class="small text-muted">1/12 — devengado mensual</td></tr>
                                <tr style="background:#1B4D3E; color:#fff;">
                                    <td class="fw-bold">TOTAL</td>
                                    <td class="text-end fw-bold">142.32%</td>
                                    <td class="fw-bold">Factor 1.4232</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-md-5">
                        <div class="nota-explicativa h-100">
                            <strong>¿Por qué se CALCULA y no se lee de planilla?</strong>
                            <p class="mb-2 mt-1">
                                Validado en BD: en la planilla mensual de mayo 2026, los conceptos
                                <code>0118 Vacaciones</code>, <code>0406 Gratificaciones</code> y
                                <code>0604 EsSalud Vida</code> tienen monto = <strong>0</strong>.
                            </p>
                            <p class="mb-0">
                                Eso significa que <strong>en la planilla mensual sólo se paga el
                                básico</strong>; los demás beneficios se devengan mes a mes y se
                                desembolsan en planillas especiales. Por eso este indicador
                                <strong>estima</strong> el costo real aplicando los porcentajes de
                                Ley sobre el básico.
                            </p>
                        </div>
                    </div>
                </div>

                <hr class="my-3" />

                <p class="fw-semibold mb-2">Estructura del dashboard (3 cuadros):</p>
                <ol class="small">
                    <li class="mb-1">
                        <strong>Cuadro 1 — Comparativo Costo Laboral por Área</strong>: muestra
                        para cada área el promedio mensual de trabajadores y el costo laboral
                        promedio mensual (con factor 1.4232) en Año 1 vs Año 2 con su variación.
                    </li>
                    <li class="mb-1">
                        <strong>Cuadro 2 — Impacto de la variación de personal</strong>: aplica
                        la diferencia de trabajadores (Año2 − Año1) al costo laboral promedio
                        por trabajador del Año 2, mostrando el <em>impacto mensual</em> y
                        anual estimado en S/.
                    </li>
                    <li class="mb-1">
                        <strong>Cuadro 3 — Desglose del costo unitario mensual</strong>: para
                        cada área expone qué representa cada beneficio social sobre el sueldo
                        básico promedio del trabajador (Año 2).
                    </li>
                </ol>

                <hr class="my-3" />

                <p class="fw-semibold mb-2">Fuente de datos:</p>
                <ul class="small mb-0">
                    <li><code>PARAMPLA</code> + <code>PLANILLA</code> + <code>INGRE_PLA</code> + <code>T_CONCEPTO</code> — planilla mensual filtrada por <code>TIPO_PLA='N'</code></li>
                    <li>Conceptos RTPS: <code>0121</code> (básico), <code>0105</code>/<code>0106</code>/<code>0107</code> (HE 25%/35%/100%)</li>
                    <li><code>PLA_COSTO</code> + <code>V_CENTRO_DE_COSTOS</code> — agrupación por área (<code>DESC_GRAN_CCOSTO</code>)</li>
                </ul>

            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ──────────────────────────────────────────────────────────────────
    //  Manejo del formulario de filtros del Comparativo Costo Laboral.
    //
    //  Validación cliente:
    //    • Cada período debe cumplir Mes Desde ≤ Mes Hasta.
    //    • Año 1 puede ser igual o distinto de Año 2 (la lógica de
    //      comparación es independiente — los promedios se calculan
    //      sólo sobre los meses incluidos en cada rango).
    // ──────────────────────────────────────────────────────────────────
    document.getElementById('frmFiltro').addEventListener('submit', function (e) {
        e.preventDefault();
        if (!validarRangos()) return;
        cargarKpi();
    });

    /**
     * Valida que en cada período el "Mes desde" sea menor o igual al "Mes hasta".
     * Si la validación falla, muestra una alerta y devuelve false.
     */
    function validarRangos() {
        const mi1 = +document.getElementById('mesIniAno1').value;
        const mf1 = +document.getElementById('mesFinAno1').value;
        const mi2 = +document.getElementById('mesIniAno2').value;
        const mf2 = +document.getElementById('mesFinAno2').value;

        if (mi1 > mf1) {
            mostrarErrorFiltro('En el Período 1 (Referencia) el "Mes desde" debe ser anterior o igual al "Mes hasta".');
            return false;
        }
        if (mi2 > mf2) {
            mostrarErrorFiltro('En el Período 2 (Comparación) el "Mes desde" debe ser anterior o igual al "Mes hasta".');
            return false;
        }
        return true;
    }

    function mostrarErrorFiltro(msg) {
        const container = document.getElementById('kpi-container');
        container.innerHTML = `
            <div class="alert alert-warning d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <div>${msg}</div>
            </div>`;
    }

    // AbortController compartido para cancelar la request previa de Kpi cuando el usuario
    // presiona Consultar varias veces (evita race condition: respuesta lenta pisando a la rápida).
    let kpiAbortCtrl = null;

    function cargarKpi() {
        const ano1       = document.getElementById('ano1').value;
        const mesIniAno1 = document.getElementById('mesIniAno1').value;
        const mesFinAno1 = document.getElementById('mesFinAno1').value;
        const ano2       = document.getElementById('ano2').value;
        const mesIniAno2 = document.getElementById('mesIniAno2').value;
        const mesFinAno2 = document.getElementById('mesFinAno2').value;
        const tipo       = document.getElementById('tipo').value || 'T';

        // Sueldo básico manual: si está vacío o no es numérico válido → 0 (usa planilla).
        let basicoManual = parseFloat(document.getElementById('basicoManual').value);
        if (isNaN(basicoManual) || basicoManual < 0) basicoManual = 0;

        const container = document.getElementById('kpi-container');
        container.innerHTML = `
            <div class="text-center py-5">
                <div class="spinner-border text-success" style="width:2.5rem;height:2.5rem;"></div>
                <p class="mt-3 text-muted small fw-semibold">Cargando comparativo...</p>
            </div>`;

        const url = `/RecursosHumanos/ComparativoCostoLaboral/Kpi`
                  + `?ano1=${ano1}&mesIniAno1=${mesIniAno1}&mesFinAno1=${mesFinAno1}`
                  + `&ano2=${ano2}&mesIniAno2=${mesIniAno2}&mesFinAno2=${mesFinAno2}`
                  + `&basicoManual=${basicoManual}`
                  + `&tipo=${encodeURIComponent(tipo)}`;

        // Cancela request previa pendiente antes de disparar la nueva.
        if (kpiAbortCtrl) kpiAbortCtrl.abort();
        kpiAbortCtrl = new AbortController();

        fetch(url, { noLoading: true, signal: kpiAbortCtrl.signal })
            .then(r => { if (!r.ok) throw new Error('Error ' + r.status); return r.text(); })
            .then(html => {
                container.innerHTML = html;
                inicializarGraficos();
            })
            .catch(err => {
                if (err.name === 'AbortError') return; // request reemplazada por otra más reciente: ignorar.
                container.innerHTML = `<div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>${err.message}</div>`;
            });
    }

    // ──────────────────────────────────────────────────────────────────
    //  Renderiza los 3 gráficos (uno por cuadro) tras inyectar el partial.
    //  Lee el payload JSON desde #chartRawData (escrito por _KpiDashboard.cshtml).
    //  Cada cuadro tiene un canvas:
    //    chCuadro1 → barras agrupadas Año1 vs Año2 (costo laboral mensual S/.)
    //    chCuadro2 → barras horizontales divergentes (impacto anual S/.)
    //    chCuadro3 → barras horizontales apiladas (composición salarial)
    // ──────────────────────────────────────────────────────────────────
    function inicializarGraficos() {
        const raw = document.getElementById('chartRawData');
        if (!raw || typeof Chart === 'undefined') return;

        let data;
        try { data = JSON.parse(raw.value); } catch { return; }

        const fmtSoles = v => 'S/ ' + Number(v).toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const fmtSolesK = v => {
            const n = Number(v);
            if (Math.abs(n) >= 1_000_000) return 'S/ ' + (n / 1_000_000).toFixed(2) + 'M';
            if (Math.abs(n) >= 1_000)     return 'S/ ' + (n / 1_000).toFixed(1) + 'K';
            return 'S/ ' + n.toFixed(0);
        };

        // ── Cuadro 1: barras agrupadas A1 vs A2 ──────────────────────
        const c1 = data.cuadro1 || [];
        const ctx1 = document.getElementById('chCuadro1');
        if (ctx1 && c1.length) {
            new Chart(ctx1.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: c1.map(x => x.area),
                    datasets: [
                        {
                            label: 'Año ' + data.ano1,
                            data: c1.map(x => x.ano1),
                            backgroundColor: 'rgba(21, 101, 192, .80)',
                            borderColor: '#1565C0',
                            borderWidth: 1,
                            borderRadius: 4
                        },
                        {
                            label: 'Año ' + data.ano2,
                            data: c1.map(x => x.ano2),
                            backgroundColor: 'rgba(27, 77, 62, .85)',
                            borderColor: '#1B4D3E',
                            borderWidth: 1,
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: { position: 'top', labels: { font: { size: 11, weight: '600' } } },
                        tooltip: {
                            callbacks: {
                                label: ctx => `${ctx.dataset.label}: ${fmtSoles(ctx.parsed.y)}`,
                                afterBody: (items) => {
                                    if (items.length < 2) return '';
                                    const a = items[0].parsed.y;
                                    const b = items[1].parsed.y;
                                    if (a === 0) return '';
                                    const pct = ((b - a) / a) * 100;
                                    const flecha = pct > 0 ? '▲' : pct < 0 ? '▼' : '=';
                                    return `Variación: ${flecha} ${pct.toFixed(2)}%`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: { ticks: { font: { size: 10 }, maxRotation: 45, minRotation: 0 }, grid: { display: false } },
                        y: { beginAtZero: true, ticks: { font: { size: 10 }, callback: v => fmtSolesK(v) }, grid: { color: '#eef2ee' } }
                    }
                }
            });
        }

        // ── Cuadro 2: barras horizontales divergentes (impacto anual) ─
        const c2 = data.cuadro2 || [];
        const ctx2 = document.getElementById('chCuadro2');
        if (ctx2 && c2.length) {
            // Convenio de signo (alineado con servicio y tabla):
            //   impacto > 0  → Año 2 tiene MÁS personal que Año 1 → MAYOR costo → SOBRECOSTO (rojo)
            //   impacto < 0  → Año 2 tiene MENOS personal que Año 1 → MENOR costo → AHORRO (verde)
            //   impacto = 0  → SIN VARIACIÓN (gris)
            // Orden: sobrecosto (positivo grande) arriba, ahorro (negativo grande) abajo.
            const sorted = [...c2].sort((a, b) => b.impacto - a.impacto);

            const pickBg = v => v > 0 ? 'rgba(192, 57, 43, .80)'  // rojo  → sobrecosto
                              : v < 0 ? 'rgba(25, 135, 84, .80)'   // verde → ahorro
                              :         'rgba(108, 117, 125, .55)'; // gris  → neutro
            const pickBd = v => v > 0 ? '#c0392b'
                              : v < 0 ? '#198754'
                              :         '#6c757d';
            const tipoLabel = v => v > 0 ? 'SOBRECOSTO'
                                 : v < 0 ? 'AHORRO'
                                 :         'SIN VARIACIÓN';
            const fmtSign = v => v > 0 ? '+' : '';

            new Chart(ctx2.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: sorted.map(x => x.area),
                    datasets: [{
                        label: 'Impacto Anual (S/.)',
                        data: sorted.map(x => x.impacto),
                        backgroundColor: sorted.map(x => pickBg(x.impacto)),
                        borderColor:     sorted.map(x => pickBd(x.impacto)),
                        borderWidth: 1,
                        borderRadius: 4
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                title: ctx => sorted[ctx[0].dataIndex].area,
                                label: ctx => {
                                    const row = sorted[ctx.dataIndex];
                                    return `${tipoLabel(row.impacto)} anual estimado: ${fmtSign(row.impacto)}${fmtSoles(row.impacto)}`;
                                },
                                afterLabel: ctx => {
                                    const row = sorted[ctx.dataIndex];
                                    // Fuente del básico: manual vs planilla
                                    const factor = 1.4232;
                                    const basicoXTrab = factor > 0 ? row.costoXTrab / factor : 0;
                                    const fuenteBasico = (data.basicoManual && data.basicoManual > 0)
                                        ? `Básico (manual): ${fmtSoles(data.basicoManual)} × 1.4232 = ${fmtSoles(row.costoXTrab)}`
                                        : `Básico Año ${data.ano2} (planilla, concepto 0121): ${fmtSoles(basicoXTrab)} × 1.4232 = ${fmtSoles(row.costoXTrab)}`;
                                    // Cálculo real del servicio: impacto = (NroTrab Año2 − NroTrab Año1) × Costo/Trab Año2 × 12.
                                    return [
                                        `Impacto mensual: ${fmtSign(row.impactoMensual)}${fmtSoles(row.impactoMensual)}`,
                                        `Δ Trabajadores (Año ${data.ano2} − Año ${data.ano1}): ${fmtSign(row.difTrab)}${row.difTrab.toFixed(1)}`,
                                        fuenteBasico,
                                        `Cálculo: ${fmtSign(row.difTrab)}${row.difTrab.toFixed(1)} × ${fmtSoles(row.costoXTrab)} × 12`
                                    ];
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            ticks: { font: { size: 10 }, callback: v => fmtSolesK(v) },
                            grid: { color: '#eef2ee', drawTicks: true },
                            // Línea cero más marcada para evidenciar el punto de quiebre.
                            border: { color: '#1B4D3E', width: 2 }
                        },
                        y: { ticks: { font: { size: 10 } }, grid: { display: false } }
                    }
                }
            });
        }

        // ── Cuadro 3: barras horizontales apiladas (composición) ──────
        const c3 = data.cuadro3 || [];
        const ctx3 = document.getElementById('chCuadro3');
        if (ctx3 && c3.length) {
            new Chart(ctx3.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: c3.map(x => x.area),
                    datasets: [
                        { label: 'Básico (100%)',        data: c3.map(x => x.basico),  backgroundColor: '#1B4D3E' },
                        { label: 'EsSalud (9%)',         data: c3.map(x => x.essalud), backgroundColor: '#1565C0' },
                        { label: 'CTS (8.33%)',          data: c3.map(x => x.cts),     backgroundColor: '#b8860b' },
                        { label: 'Gratificaciones (16.66%)', data: c3.map(x => x.gratif), backgroundColor: '#6f42c1' },
                        { label: 'Vacaciones (8.33%)',   data: c3.map(x => x.vacac),   backgroundColor: '#e67e22' }
                    ]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: { position: 'top', labels: { font: { size: 10, weight: '600' }, boxWidth: 12 } },
                        tooltip: {
                            callbacks: {
                                label: ctx => `${ctx.dataset.label}: ${fmtSoles(ctx.parsed.x)}`,
                                footer: items => {
                                    if (!items.length) return '';
                                    const row = c3[items[0].dataIndex];
                                    return 'Total: ' + fmtSoles(row.total);
                                }
                            }
                        }
                    },
                    scales: {
                        x: { stacked: true, beginAtZero: true, ticks: { font: { size: 10 }, callback: v => fmtSolesK(v) }, grid: { color: '#eef2ee' } },
                        y: { stacked: true, ticks: { font: { size: 10 } }, grid: { display: false } }
                    }
                }
            });
        }
    }
</script>
}
