@model FabricaHilos.Controllers.Contabilidad.SireDiagnosticoViewModel
@{
    ViewData["Title"] = "SIRE - Diagnóstico de Conexión";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Contabilidad" asp-action="Index">Contabilidad</a></li>
    <li class="breadcrumb-item"><a asp-controller="Sire" asp-action="Index">SIRE</a></li>
    <li class="breadcrumb-item active">Diagnóstico</li>
}

@section Styles {
<link rel="stylesheet" href="~/css/sire.css" asp-append-version="true" />
}

@await Html.PartialAsync("~/Views/Contabilidad/Sire/_SireNavBar.cshtml")

<div class="sire-strip">
    <i class="bi bi-plug" style="color:#90cdf4;font-size:.95rem;flex-shrink:0;"></i>
    <span class="sire-strip-title">Diagnóstico de Conexión SUNAT</span>
    <span class="sire-strip-sep"></span>
    @if (Model.UseMock)
    {
        <span class="sire-kpi"><i class="bi bi-cone-striped" style="color:#fbd38d;"></i><span style="opacity:.75">MODO MOCK</span></span>
    }
    else
    {
        <span class="sire-kpi"><i class="bi bi-wifi" style="color:#68d391;"></i><span style="opacity:.75">API REAL</span></span>
    }
    @if (Model.TokenOk)
    {
        <span class="sire-kpi"><i class="bi bi-key-fill" style="color:#68d391;"></i><span class="sire-kpi-val">Token OK</span></span>
    }
    else
    {
        <span class="sire-kpi"><i class="bi bi-key" style="color:#fc8181;"></i><span class="sire-kpi-val" style="color:#fc8181;">Sin token</span></span>
    }
</div>

<div class="row g-3 mb-4">
    <!-- Configuración -->
    <div class="col-md-6">
        <div class="sire-card h-100">
            <div class="sire-card-header">
                <i class="bi bi-gear"></i>
                <span>Configuración</span>
                @if (Model.UseMock)
                {
                    <span class="ms-auto sire-badge sire-badge-warn">MODO MOCK</span>
                }
                else
                {
                    <span class="ms-auto sire-badge sire-badge-ok">API REAL</span>
                }
            </div>
            <div class="sire-card-body">
                <table class="table table-sm table-borderless mb-0 small">
                    <tr><td class="text-muted fw-semibold" style="width:130px">RUC</td><td><span class="sire-code">@Model.Ruc</span></td></tr>
                    <tr><td class="text-muted fw-semibold">Usuario SOL</td><td><span class="sire-code">@Model.UsuarioSol</span></td></tr>
                    <tr><td class="text-muted fw-semibold">Client ID</td><td><span class="sire-code">@Model.ClientId</span></td></tr>
                    <tr><td class="text-muted fw-semibold">Auth URL</td><td><span class="sire-code text-break" style="font-size:.72rem;">@Model.AuthUrl</span></td></tr>
                    <tr><td class="text-muted fw-semibold">API Base URL</td><td><span class="sire-code text-break" style="font-size:.72rem;">@Model.ApiBaseUrl</span></td></tr>
                </table>
            </div>
        </div>
    </div>

    <!-- Token OAuth2 -->
    <div class="col-md-6">
        <div class="sire-card h-100" style="border-left:4px solid @(Model.TokenOk ? "var(--sire-success-dk)" : "var(--sire-danger)");">
            <div class="sire-card-header">
                <i class="bi bi-key"></i>
                <span>Autenticación OAuth2 SUNAT</span>
                @if (Model.TokenOk)
                {
                    <span class="ms-auto sire-badge sire-badge-ok"><i class="bi bi-check-circle"></i> OK</span>
                }
                else
                {
                    <span class="ms-auto sire-badge sire-badge-danger"><i class="bi bi-x-circle"></i> Error</span>
                }
            </div>
            <div class="sire-card-body">
                @if (Model.TokenOk)
                {
                    <table class="table table-sm table-borderless mb-0 small">
                        <tr><td class="text-muted fw-semibold" style="width:120px">Tipo</td><td><span class="sire-badge sire-badge-rce">@Model.TokenTipo</span></td></tr>
                        <tr><td class="text-muted fw-semibold">Expira</td><td>@Model.TokenExpira.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td></tr>
                        <tr><td class="text-muted fw-semibold">Token</td><td><span class="sire-code" style="font-size:.7rem;word-break:break-all;">@Model.TokenFragment</span></td></tr>
                    </table>
                }
                else
                {
                    <div class="sire-alert sire-alert-danger mb-2">
                        <i class="bi bi-exclamation-triangle"></i>
                        <div><strong>Error:</strong> @Model.TokenError</div>
                    </div>
                    <ul class="small text-muted mb-0">
                        <li>Usuario SOL o Clave SOL incorrectos</li>
                        <li>La aplicación no está habilitada para el RUC en el portal SUNAT</li>
                        <li>El Client ID / Client Secret no corresponden a la empresa</li>
                        <li>La aplicación está en entorno LOCAL_DEV (no producción)</li>
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.TokenOk)
{
    <div class="row g-3">
        <!-- RVIE -->
        <div class="col-md-6">
            <div class="sire-card h-100" style="border-left:4px solid @(Model.RvieOk ? "var(--sire-success-dk)" : "var(--sire-danger)");">
                <div class="sire-card-header">
                    <i class="bi bi-receipt-cutoff" style="color:var(--sire-rvie);"></i>
                    <span>API RVIE — Períodos</span>
                    @if (Model.RvieOk)
                    {
                        <span class="ms-auto sire-badge sire-badge-ok"><i class="bi bi-check-circle"></i> OK</span>
                    }
                    else
                    {
                        <span class="ms-auto sire-badge sire-badge-danger"><i class="bi bi-x-circle"></i> Error</span>
                    }
                </div>
                <div class="sire-card-body text-center">
                    @if (Model.RvieOk)
                    {
                        <div class="fw-bold" style="font-size:2.5rem;color:var(--sire-rvie);">@Model.RviePeriodos</div>
                        <div class="text-muted small mb-3">períodos disponibles</div>
                        <a asp-action="Ventas" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-arrow-right-circle me-1"></i>Ir a RVIE
                        </a>
                    }
                    else
                    {
                        <div class="sire-alert sire-alert-danger">
                            <i class="bi bi-exclamation-triangle"></i>
                            <div>@Model.RvieError</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- RCE -->
        <div class="col-md-6">
            <div class="sire-card h-100" style="border-left:4px solid @(Model.RceOk ? "var(--sire-success-dk)" : "var(--sire-danger)");">
                <div class="sire-card-header">
                    <i class="bi bi-cart-check" style="color:var(--sire-rce);"></i>
                    <span>API RCE — Períodos</span>
                    @if (Model.RceOk)
                    {
                        <span class="ms-auto sire-badge sire-badge-ok"><i class="bi bi-check-circle"></i> OK</span>
                    }
                    else
                    {
                        <span class="ms-auto sire-badge sire-badge-danger"><i class="bi bi-x-circle"></i> Error</span>
                    }
                </div>
                <div class="sire-card-body text-center">
                    @if (Model.RceOk)
                    {
                        <div class="fw-bold" style="font-size:2.5rem;color:var(--sire-rce);">@Model.RcePeriodos</div>
                        <div class="text-muted small mb-3">períodos disponibles</div>
                        <a asp-action="Compras" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-arrow-right-circle me-1"></i>Ir a RCE
                        </a>
                    }
                    else
                    {
                        <div class="sire-alert sire-alert-danger">
                            <i class="bi bi-exclamation-triangle"></i>
                            <div>@Model.RceError</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (!Model.TokenOk)
{
    <div class="sire-card mt-4">
        <div class="sire-card-header">
            <i class="bi bi-lightbulb" style="color:var(--sire-warning);"></i>
            <span>Pasos para resolver el error de autenticación</span>
        </div>
        <div class="sire-card-body">
            <ol class="mb-0 small text-muted">
                <li class="mb-2">Ingresa al portal <strong>SUNAT SOL</strong> → <em>Empresas → Servicios en Línea → API SUNAT</em></li>
                <li class="mb-2">Verifica que la aplicación con Client ID <span class="sire-code">@Model.ClientId</span> esté <strong>habilitada para producción</strong> y tenga el RUC <span class="sire-code">@Model.Ruc</span> como contribuyente autorizado.</li>
                <li class="mb-2">Confirma que el usuario SOL <span class="sire-code">@Model.UsuarioSol</span> tenga el perfil <strong>«Acceso API SUNAT - SIRE»</strong> asignado.</li>
                <li class="mb-2">Verifica que la Clave SOL sea correcta (puede caducar).</li>
                <li>Si la aplicación muestra <span class="sire-code">X-ServiceEnvironment: LOCAL_DEV</span>, contáctese con SUNAT para migrar la app a producción.</li>
            </ol>
        </div>
    </div>
}
