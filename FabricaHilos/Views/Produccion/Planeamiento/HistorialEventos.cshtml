@model IEnumerable<FabricaHilos.Models.Produccion.Planeamiento.PlnLogEvento>

@{
    ViewData["Title"] = "Historial de Eventos";

    long   idSeguim   = ViewBag.IdSeguim;
    long   numPed     = ViewBag.NumPed;
    int    serie      = ViewBag.Serie;
    string tipoEvento = ViewBag.TipoEvento ?? "";
    int?   nroCiclo   = ViewBag.NroCiclo;
    int    pagina     = ViewBag.Pagina;
    int    tamPagina  = ViewBag.TamPagina;
    int    total      = ViewBag.Total;
    int    totalPags  = ViewBag.TotalPags;

    var ciclosDisponibles = (List<int>)(ViewBag.CiclosDisponibles ?? new List<int>());

    // Tipos de evento conocidos
    var tiposEvento = new[]
    {
        ("",   "Todos los tipos"),
        ("AV", "Avance de paso"),
        ("RE", "Reprogramación"),
        ("AL", "Alerta"),
        ("CI", "Cierre manual"),
    };

    // Helper para construir URL de paginación/filtro manteniendo todos los params
    string BuildUrl(int pag, string tipo = "", int? ciclo = null) =>
        $"/Planeamiento/HistorialEventos?idSeguim={idSeguim}&numPed={numPed}&serie={serie}" +
        $"&pagina={pag}&tamPagina={tamPagina}" +
        (string.IsNullOrEmpty(tipo)  ? "" : $"&tipoEvento={tipo}") +
        (ciclo.HasValue              ? $"&nroCiclo={ciclo}" : "");

    int primerReg = total == 0 ? 0 : (pagina - 1) * tamPagina + 1;
    int ultReg    = Math.Min(pagina * tamPagina, total);
}

@section Styles {
<link rel="stylesheet" href="~/css/planeamiento.css" />
<style>
    /* — Info strip — */
    .hev-strip{background:linear-gradient(135deg,#2d3748 0%,#4a5568 100%);color:#f7fafc;border-radius:.5rem;padding:.9rem 1.1rem;margin-bottom:1rem;display:flex;align-items:center;gap:1rem;flex-wrap:wrap;}
    .hev-strip-cell{display:flex;flex-direction:column;gap:.1rem;}
    .hev-strip-lbl{font-size:.68rem;text-transform:uppercase;letter-spacing:.08em;color:#a0aec0;font-weight:600;}
    .hev-strip-val{font-size:.9rem;font-weight:700;color:#f7fafc;}
    .hev-strip-sub{font-size:.72rem;color:#cbd5e0;}
    .hev-strip-sep{width:1px;height:36px;background:rgba(255,255,255,.2);align-self:center;}
    .hev-strip-actions{margin-left:auto;display:flex;align-items:center;gap:.4rem;}
    /* — Timeline feed — */
    .ev-card{border:none;box-shadow:0 2px 8px rgba(0,0,0,.08);border-radius:.75rem;}
    .ev-feed-row{display:flex;gap:.65rem;padding:.4rem 0;}
    .ev-feed-left{display:flex;flex-direction:column;align-items:center;flex-shrink:0;width:18px;}
    .ev-feed-dot{width:11px;height:11px;border-radius:50%;flex-shrink:0;margin-top:.4rem;}
    .ev-feed-line{flex:1;width:2px;background:#e2e8f0;min-height:8px;margin-top:3px;}
    .ev-feed-row:last-child .ev-feed-line{display:none;}
    .ev-feed-body{flex:1;padding-bottom:.55rem;border-bottom:1px solid #f0f4f8;}
    .ev-feed-row:last-child .ev-feed-body{border-bottom:none;}
    .ev-feed-meta{display:flex;align-items:center;flex-wrap:wrap;gap:.2rem;margin-bottom:.15rem;}
    .ev-feed-date{font-weight:700;font-size:.85rem;color:#2d3748;}
    .ev-feed-time{font-size:.72rem;color:#718096;}
    .ev-feed-detail{font-size:.80rem;display:flex;align-items:baseline;flex-wrap:wrap;gap:.25rem;color:#4a5568;}
    .ev-feed-detail code{font-size:.75rem;background:#edf2f7;padding:.05rem .25rem;border-radius:.2rem;color:#2d3748;font-family:ui-monospace,monospace;}
    .ev-feed-detail .ev-num{font-size:.7rem;color:#a0aec0;margin-left:auto;white-space:nowrap;}
    /* row type highlight */
    .row-repro .ev-feed-body{background:linear-gradient(90deg,#fef9c3 0,#fef9c3 3px,transparent 3px);}
    .row-alerta .ev-feed-body{background:linear-gradient(90deg,#fee2e2 0,#fee2e2 3px,transparent 3px);}
    .row-cierre .ev-feed-body{background:linear-gradient(90deg,#dcfce7 0,#dcfce7 3px,transparent 3px);}
</style>
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Produccion" asp-action="Index">Producción</a></li>
    <li class="breadcrumb-item"><a asp-action="Pedido" asp-route-numPed="@numPed" asp-route-serie="@serie">Pedido @serie-@numPed</a></li>
    <li class="breadcrumb-item active">Historial de Eventos</li>
}

<!-- ── Info strip ───────────────────────────────────────────── -->
<div class="hev-strip">
    <div class="hev-strip-cell">
        <span class="hev-strip-lbl"><i class="bi bi-journal-text me-1"></i>Ítem</span>
        <span class="hev-strip-val">#@idSeguim</span>
    </div>
    <div class="hev-strip-sep"></div>
    <div class="hev-strip-cell">
        <span class="hev-strip-lbl">Pedido</span>
        <span class="hev-strip-val">@serie-@numPed</span>
    </div>
    <div class="hev-strip-sep"></div>
    <div class="hev-strip-cell">
        <span class="hev-strip-lbl">Eventos</span>
        <span class="hev-strip-val">@total</span>
        <span class="hev-strip-sub">en historial</span>
    </div>
    @if (ciclosDisponibles.Count > 1)
    {
        <div class="hev-strip-sep"></div>
        <div class="hev-strip-cell">
            <span class="hev-strip-lbl">Ciclos</span>
            <span class="hev-strip-val">@ciclosDisponibles.Count</span>
            <span class="hev-strip-sub">de reproceso</span>
        </div>
    }
    <div class="hev-strip-actions">
        <a asp-action="Historial" asp-route-idSeguim="@idSeguim"
           class="btn btn-sm" style="background:rgba(255,255,255,.15);color:#f7fafc;border:1px solid rgba(255,255,255,.3);">
            <i class="bi bi-calendar-range me-1"></i>Recálculos
        </a>
        <a asp-action="Pedido" asp-route-numPed="@numPed" asp-route-serie="@serie"
           class="btn btn-sm" style="background:rgba(255,255,255,.15);color:#f7fafc;border:1px solid rgba(255,255,255,.3);">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>

<!-- ── Barra de filtros ──────────────────────────────────────── -->
<div class="filtro-bar mb-3">
    <form method="get" action="/Planeamiento/HistorialEventos" class="row g-2 align-items-end">
        <input type="hidden" name="idSeguim"  value="@idSeguim" />
        <input type="hidden" name="numPed"    value="@numPed" />
        <input type="hidden" name="serie"     value="@serie" />
        <input type="hidden" name="pagina"    value="1" />
        <input type="hidden" name="tamPagina" value="@tamPagina" />

        <div class="col-auto">
            <label class="form-label fw-semibold mb-1" style="font-size:.82rem">Tipo de evento</label>
            <select name="tipoEvento" class="form-select form-select-sm" style="min-width:160px">
                @foreach (var (val, lbl) in tiposEvento)
                {
                    if (tipoEvento == val)
                    {
                        <option value="@val" selected="selected">@lbl</option>
                    }
                    else
                    {
                        <option value="@val">@lbl</option>
                    }
                }
            </select>
        </div>

        @if (ciclosDisponibles.Count > 1)
        {
            <div class="col-auto">
                <label class="form-label fw-semibold mb-1" style="font-size:.82rem">Ciclo</label>
                <select name="nroCiclo" class="form-select form-select-sm" style="min-width:110px">
                    <option value="">Todos</option>
                    @foreach (var c in ciclosDisponibles)
                    {
                        if (nroCiclo == c)
                        {
                            <option value="@c" selected="selected">Ciclo @c</option>
                        }
                        else
                        {
                            <option value="@c">Ciclo @c</option>
                        }
                    }
                </select>
            </div>
        }
        else
        {
            <input type="hidden" name="nroCiclo" value="" />
        }

        <div class="col-auto">
            <label class="form-label fw-semibold mb-1" style="font-size:.82rem">Por página</label>
            <select name="tamPagina" class="form-select form-select-sm" style="min-width:90px">
                @foreach (var tp in new[] { 10, 25, 50, 100 })
                {
                    if (tamPagina == tp)
                    {
                        <option value="@tp" selected="selected">@tp</option>
                    }
                    else
                    {
                        <option value="@tp">@tp</option>
                    }
                }
            </select>
        </div>

        <div class="col-auto">
            <button type="submit" class="btn btn-sm btn-primary">
                <i class="bi bi-funnel me-1"></i>Filtrar
            </button>
            <a href="@BuildUrl(1)" class="btn btn-sm btn-outline-secondary ms-1">
                <i class="bi bi-x-circle me-1"></i>Limpiar
            </a>
        </div>
    </form>
</div>

<!-- ── Resumen / totales ─────────────────────────────────────── -->
<div class="d-flex align-items-center justify-content-between mb-2">
    <span class="pag-info">
        @if (total == 0)
        {
            <span>Sin resultados</span>
        }
        else
        {
            <span>Mostrando <strong>@primerReg–@ultReg</strong> de <strong>@total</strong> eventos</span>
        }
        @if (!string.IsNullOrEmpty(tipoEvento) || nroCiclo.HasValue)
        {
            <span class="ms-2 badge bg-warning text-dark">Filtros activos</span>
        }
    </span>
    @if (ciclosDisponibles.Count > 1)
    {
        <div class="d-flex gap-1 flex-wrap">
            @foreach (var c in ciclosDisponibles)
            {
                <a href="@BuildUrl(1, tipoEvento, c)"
                   class="btn btn-xs btn-@(nroCiclo == c ? "warning" : "outline-secondary") btn-sm py-0 px-2"
                   style="font-size:.75rem">
                    Ciclo @c
                </a>
            }
        </div>
    }
</div>

<!-- ── Tabla de eventos ──────────────────────────────────────── -->
@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        No se encontraron eventos con los filtros seleccionados.
    </div>
}
else
{
    <div class="card ev-card mb-3">
        <div class="card-body px-3 pt-3 pb-1">
            @{
                int rowNum = primerReg;
            }
            @foreach (var ev in Model)
            {
                string rowCss = ev.TipoEvento switch
                {
                    "RE" => "row-repro",
                    "AL" => "row-alerta",
                    "CI" => "row-cierre",
                    _    => ""
                };
                string dotColor = ev.TipoEvento switch
                {
                    "AV" => "#2563eb",
                    "RE" => "#d97706",
                    "AL" => "#dc2626",
                    "CI" => "#6b7280",
                    _    => "#9ca3af"
                };
                <div class="ev-feed-row @rowCss">
                    <div class="ev-feed-left">
                        <span class="ev-feed-dot" style="background:@dotColor"></span>
                        <span class="ev-feed-line"></span>
                    </div>
                    <div class="ev-feed-body">
                        <div class="ev-feed-meta">
                            <span class="ev-feed-date">@ev.FchEvento.ToString("dd/MM/yyyy")</span>
                            <span class="ev-feed-time">@ev.FchEvento.ToString("HH:mm:ss")</span>
                            <span class="badge bg-@ev.TipoEventoCss ms-1">@ev.TipoEventoDesc</span>
                            <span class="badge bg-light text-dark border">C.@ev.NroCiclo</span>
                        </div>
                        <div class="ev-feed-detail">
                            <span class="fw-semibold" style="font-family:ui-monospace,monospace;font-size:.8rem">@ev.CodPaso</span>
                            @if (!string.IsNullOrEmpty(ev.NombrePaso))
                            {
                                <span class="text-muted">— @ev.NombrePaso</span>
                            }
                            @if (!string.IsNullOrEmpty(ev.TablaOrigen))
                            {
                                <code>@ev.TablaOrigen</code>
                            }
                            @if (ev.KgCantidad.HasValue)
                            {
                                <span class="text-primary fw-semibold">· @ev.KgCantidad.Value.ToString("N2") kg</span>
                            }
                            @if (!string.IsNullOrEmpty(ev.Observacion))
                            {
                                <span class="text-secondary">· @ev.Observacion</span>
                            }
                            else if (ev.TipoEvento == "RE" && ev.FchEstimadaAnt.HasValue)
                            {
                                <span class="text-muted">· @ev.FchEstimadaAnt.Value.ToString("dd/MM/yy") → @(ev.FchEstimadaNue?.ToString("dd/MM/yy") ?? "—")</span>
                            }
                            <span class="ev-num">#@rowNum · @(string.IsNullOrEmpty(ev.Usuario) ? "sistema" : ev.Usuario)</span>
                        </div>
                    </div>
                </div>
                rowNum++;
            }
        </div>
    </div>

    <!-- ── Paginación ──────────────────────────────────────────── -->
    @if (totalPags > 1)
    {
        <nav>
            <ul class="pagination pagination-sm justify-content-center flex-wrap">
                <!-- Anterior -->
                <li class="page-item @(pagina == 1 ? "disabled" : "")">
                    <a class="page-link" href="@BuildUrl(pagina - 1, tipoEvento, nroCiclo)">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                @{
                    int pIni = Math.Max(1, pagina - 2);
                    int pFin = Math.Min(totalPags, pIni + 4);
                    if (pFin - pIni < 4) pIni = Math.Max(1, pFin - 4);
                }

                @if (pIni > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@BuildUrl(1, tipoEvento, nroCiclo)">1</a>
                    </li>
                    @if (pIni > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                }

                @for (int p = pIni; p <= pFin; p++)
                {
                    <li class="page-item @(p == pagina ? "active" : "")">
                        <a class="page-link" href="@BuildUrl(p, tipoEvento, nroCiclo)">@p</a>
                    </li>
                }

                @if (pFin < totalPags)
                {
                    @if (pFin < totalPags - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                    <li class="page-item">
                        <a class="page-link" href="@BuildUrl(totalPags, tipoEvento, nroCiclo)">@totalPags</a>
                    </li>
                }

                <!-- Siguiente -->
                <li class="page-item @(pagina == totalPags ? "disabled" : "")">
                    <a class="page-link" href="@BuildUrl(pagina + 1, tipoEvento, nroCiclo)">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
        <p class="text-center pag-info">Página @pagina de @totalPags</p>
    }

    <!-- ── Leyenda de tipos ─────────────────────────────────────── -->
    <div class="alert alert-light mt-2 py-2">
        <small class="text-muted">
            <i class="bi bi-info-circle me-1"></i>
            <span class="badge bg-primary me-1">AV</span> Avance automático de paso (trigger Oracle) ·
            <span class="badge bg-warning text-dark me-1">RE</span> Reprogramación manual ·
            <span class="badge bg-danger me-1">AL</span> Alerta generada ·
            <span class="badge bg-secondary me-1">CI</span> Cierre manual de ítem.
            El campo <strong>Kg</strong> solo se registra en avances de paso '05' (lote disponible) y '14' (despacho).
        </small>
    </div>
}
