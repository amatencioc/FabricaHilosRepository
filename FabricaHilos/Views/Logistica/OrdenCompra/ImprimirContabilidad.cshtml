@model (FabricaHilos.Models.Logistica.OrdenCompraDto Orden, List<FabricaHilos.Models.Logistica.ItemOrdDto> Items)
@{
    Layout = null;

    var oc    = Model.Orden;
    var items = Model.Items;

    var proveedores     = ViewBag.Proveedores              as Dictionary<string, string> ?? new Dictionary<string, string>();
    var centrosCosto    = ViewBag.CentrosCosto             as Dictionary<string, string> ?? new Dictionary<string, string>();
    var descsCondPag    = ViewBag.DescripcionesCondPag      as Dictionary<string, string> ?? new Dictionary<string, string>();
    var descsArt        = ViewBag.DescripcionesArticulos    as Dictionary<string, string> ?? new Dictionary<string, string>();
    var nombresUsuarios = ViewBag.NombresUsuarios           as Dictionary<string, string> ?? new Dictionary<string, string>();

    _ = proveedores.TryGetValue(oc.CodProveed ?? "", out var nomProv);
    _ = centrosCosto.TryGetValue(oc.CCosto ?? "", out var nomCcosto);
    _ = descsCondPag.TryGetValue(oc.CondPag ?? "", out var descCondPag);

    var monedaSimbolo = (oc.Moneda ?? "").ToUpper() == "D" ? "USD $" : "PEN S/";
    var monedaSimb    = (oc.Moneda ?? "").ToUpper() == "D" ? "$" : "S/";
    var tipoLabel     = oc.TipoDocto == "83" ? "ORDEN DE SERVICIO" : "ORDEN DE COMPRA";
    var tipoCorto     = oc.TipoDocto == "83" ? "O/S" : "O/C";
    var numDoc        = $"{oc.NumPed:D8}";

    var empresaNombre    = ViewBag.EmpresaNombre    as string ?? "FÁBRICA DE HILOS S.A.";
    var empresaRuc       = ViewBag.EmpresaRuc       as string ?? "";
    var empresaDireccion = ViewBag.EmpresaDireccion as string ?? "";
    var empresaTelefono  = ViewBag.EmpresaTelefono  as string ?? "";
    var logoPath          = ViewBag.EmpresaLogoPath    as string ?? "";
    var logoAlt           = ViewBag.EmpresaLogoAlt     as string ?? "Logo";
    var empresaNombreCorto = ViewBag.EmpresaNombreCorto as string ?? "";
    var provDetalle      = ViewBag.ProveedorDetalle as FabricaHilos.Models.Logistica.ProveedorDetalleDto;

    var destinosOc = ViewBag.DestinosOc as List<FabricaHilos.Models.Logistica.ItemOrdDestinoDto>
                     ?? new List<FabricaHilos.Models.Logistica.ItemOrdDestinoDto>();

    var estadoTexto = oc.Estado switch {
        "0" => "EMITIDA", "1" => "ATENDIDA PARCIAL",
        "2" => "ATENDIDA TOTAL", "6" => "CERRADA", "9" => "ANULADA", _ => oc.Estado ?? "—"
    };
    var estadoColor = oc.Estado switch {
        "0" => "#1a5276", "6" => "#1e8449", "9" => "#c0392b", "2" => "#1e8449", _ => "#784212"
    };

    Func<string?, string> fmtUsu = cod => {
        if (string.IsNullOrEmpty(cod)) return "—";
        return nombresUsuarios.TryGetValue(cod, out var n) && n != cod ? $"{n} ({cod})" : cod;
    };

    // ImpVvta ya se calcula en tiempo real en ObtenerItemsAsync (CANTIDAD×PRECIO×descuentos),
    // por lo que valVenta es inmune a cambios directos del Legacy en ITEMORD.CANTIDAD.
    // impIgv y total se derivan de valVenta × oc.Impsto para evitar leer columnas
    // almacenadas (IMP_IGV, PRECIO_VTA) que pueden quedar desincronizadas.
    // oc.Impsto preserva la tasa configurada por O/C (18%, -8%, -10%, etc.).
    decimal valVenta = items.Sum(i => i.ImpVvta);
    decimal impIgv   = Math.Round(valVenta * oc.Impsto, 2);
    decimal total    = valVenta + impIgv;

    // Agrupar ítems por NumReq para mostrar secciones desagregadas
    // Ordenar numéricamente (no como string) para que REQ 9 vaya después de REQ 100
    var grupos = items
        .GroupBy(i => i.NumReq.HasValue && i.NumReq > 0 ? i.NumReq.Value.ToString() : "Sin Req.")
        .OrderBy(g => long.TryParse(g.Key, out var n) ? n : long.MaxValue)
        .ToList();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Contabilidad — @tipoCorto @numDoc</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            font-size: 9pt;
            color: #1a1a2e;
            background: #f0f4f8;
        }
        .page {
            width: 210mm;
            min-height: 297mm;
            margin: 10mm auto;
            background: #fff;
            box-shadow: 0 4px 28px rgba(0,0,0,.18);
            border-radius: 3px;
            overflow: hidden;
        }
        .top-stripe {
            height: 7px;
            background: linear-gradient(90deg, #0F2E25 0%, #1B4D3E 55%, #C8A951 100%);
        }
        /* Header */
        .doc-header {
            display: flex;
            align-items: stretch;
            border-bottom: 2px solid #1B4D3E;
        }
        .header-left {
            flex: 1;
            padding: 8mm 8mm 5mm 10mm;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .header-logo img { max-height: 120px; max-width: 260px; object-fit: contain; }
        .header-logo-placeholder {
            width: 260px; height: 120px;
            display: flex; align-items: center; justify-content: center;
            background: #e8f0ec; border: 1px solid #a8c4b8; border-radius: 3px;
            font-size: 8pt; color: #1B4D3E; font-weight: 600;
        }
        .header-company {
            margin-left: 10px;
        }
        .header-company .empresa-marca {
            font-size: 11pt; font-weight: 800; color: #C8A951;
            letter-spacing: .5px; margin-bottom: 2px;
        }
        .header-company h1 { font-size: 13pt; font-weight: 700; color: #1B4D3E; line-height: 1.1; }
        .header-company p  { font-size: 8pt;  color: #555; margin-top: 2px; line-height: 1.5; }
        .header-right {
            width: 62mm;
            background: #1B4D3E; color: #fff;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            padding: 8mm 6mm; gap: 4px;
        }
        .header-right .doc-type  { font-size: 8pt; font-weight: 600; letter-spacing:.06em; opacity:.85; }
        .header-right .doc-num   { font-size: 16pt; font-weight: 800; letter-spacing:.4px; line-height:1.1; }
        .header-right .doc-badge { font-size: 7pt; font-weight: 700; padding: 2px 8px; border-radius: 20px; text-transform:uppercase; }
        .header-right .doc-copy  { margin-top: 3px; font-size: 7.5pt; font-weight: 700; color: #C8A951; letter-spacing:.06em; text-transform:uppercase; }
        /* Info sections */
        .section-grid {
            display: flex; border-bottom: 1px solid #d0dce8;
        }
        .section-col {
            flex: 1; padding: 4mm 6mm 3mm;
            border-right: 1px solid #d0dce8;
        }
        .section-col:last-child { border-right: none; }
        .sec-title {
            font-size: 6.5pt; font-weight: 700; color: #1B4D3E;
            text-transform: uppercase; letter-spacing:.06em;
            border-bottom: 1px solid #a8c4b8; padding-bottom: 2px; margin-bottom: 3px;
        }
        .field-row { display: flex; align-items: baseline; margin-bottom: 2px; }
        .f-lbl { font-size: 6.5pt; color: #6c7a89; font-weight: 600; white-space: nowrap; min-width: 58px; margin-right: 4px; }
        .f-val { font-size: 8pt; color: #1a1a2e; font-weight: 500; }
        .f-val.hl { color: #1B4D3E; font-weight: 700; }
        /* Proveedor */
        .prov-bar {
            padding: 3mm 6mm; background: #eef3f1;
            border-bottom: 1px solid #d0dce8;
            display: flex; gap: 12mm;
        }
        .prov-bar .prov-name { font-size: 10pt; font-weight: 700; color: #1B4D3E; }
        .prov-bar .prov-meta { font-size: 7.5pt; color: #666; }
        /* Centro de costo cabecera */
        .ccosto-bar {
            padding: 2mm 6mm;
            background: #f5f8f5;
            border-bottom: 1px solid #d0dce8;
            font-size: 7.5pt; color: #444;
        }
        .ccosto-bar strong { color: #1B4D3E; }
        /* Grupo/Requisición */
        .req-group { margin: 0 6mm 3mm; page-break-inside: avoid; }
        .req-group-header {
            background: #2D7A5F; color: #fff;
            font-size: 7.5pt; font-weight: 700;
            padding: 3px 8px; border-radius: 3px 3px 0 0;
            letter-spacing:.04em;
        }
        /* Tabla ítems */
        .items-section { padding: 0 6mm 0; }
        .oc-table {
            width: 100%; border-collapse: collapse;
        }
        .oc-table thead tr { background: #1B4D3E; color: #fff; }
        .oc-table thead th {
            padding: 3px 4px; font-size: 6.5pt;
            font-weight: 600; white-space: nowrap;
        }
        .oc-table thead th.r { text-align: right; }
        .oc-table thead th.c { text-align: center; }
        .oc-table tbody tr { border-bottom: 1px solid #e0e8e4; }
        .oc-table tbody tr:nth-child(even) td { background: #f0f5f2; }
        .oc-table tbody td { padding: 3px 4px; font-size: 7.5pt; vertical-align: middle; }
        .oc-table tbody td.r { text-align: right; }
        .oc-table tbody td.c { text-align: center; }
        .oc-table tbody td.art  { font-weight: 700; color: #1B4D3E; font-size: 7pt; }
        .oc-table tbody td.desc { color: #222; line-height: 1.3; }
        .oc-table tbody td.num  { color: #999; font-size: 7pt; text-align: center; }
        .oc-table tfoot td {
            border-top: 1.5px solid #1B4D3E; font-weight: 700;
            padding: 3px 4px; font-size: 7.5pt; background: #eef3f1;
        }
        /* Totales */
        .totals-wrap {
            display: flex; justify-content: space-between; align-items: flex-end;
            padding: 4mm 6mm 3mm; border-bottom: 1px solid #d0dce8;
        }
        .obs-block { flex: 1; padding-right: 12mm; }
        .obs-block .sec-title { margin-bottom: 2px; }
        .obs-block p { font-size: 7.5pt; color: #444; line-height: 1.4; }
        .totals-box { flex: 0 0 auto; min-width: 55mm; }
        .totals-box table { width: 100%; border-collapse: collapse; }
        .totals-box td { padding: 2px 4px; font-size: 7.5pt; }
        .t-lbl { color: #6c7a89; font-size: 7pt; text-align: right; padding-right: 8px; }
        .t-val { text-align: right; font-weight: 600; color: #1a1a2e; white-space: nowrap; }
        .grand-total td { background: #1B4D3E !important; color: #fff !important; font-weight: 700; font-size: 9pt; }
        .grand-total .t-lbl { color: #a8c4b8 !important; }
        /* Firmas */
        .firma-section {
            display: flex; padding: 6mm 6mm 5mm; gap: 5mm;
            border-bottom: 1px solid #d0dce8;
        }
        .firma-box {
            flex: 1; text-align: center; padding: 0 4mm;
            display: flex; flex-direction: column; align-items: center;
        }
        .firma-img { height: 16mm; max-width: 100%; object-fit: contain; margin-bottom: 1mm; }
        .firma-img-placeholder { height: 16mm; }
        .firma-line { border-top: 1.5px solid #1B4D3E; width: 100%; margin-bottom: 3px; }
        .firma-label { font-size: 7pt; font-weight: 600; color: #1B4D3E; text-transform: uppercase; letter-spacing:.05em; }
        .firma-sublabel { font-size: 7pt; color: #888; }
        .firma-nombre { font-size: 7pt; color: #333; font-weight: 500; }
        /* Auditoría */
        .audit-bar {
            padding: 3mm 6mm; border-bottom: 1px solid #d0dce8;
            display: flex; gap: 10mm;
        }
        .audit-bar .a-lbl { font-size: 6.5pt; color: #888; }
        .audit-bar .a-val { font-size: 7.5pt; color: #333; font-weight: 500; }
        /* Footer */
        .doc-footer {
            display: flex; align-items: center;
            justify-content: space-between;
            padding: 3mm 6mm; background: #eef3f1;
            border-top: 1px solid #a8c4b8;
        }
        .doc-footer .fl { font-size: 7pt; color: #888; }
        .doc-footer .fr { font-size: 7pt; color: #888; text-align: right; }
        .bottom-stripe {
            height: 5px;
            background: linear-gradient(90deg, #C8A951 0%, #2D7A5F 55%, #0F2E25 100%);
        }
        /* Detalle destinos */
        .dest-header-row td {
            background: #e8f5e9; font-size: 6.5pt; font-weight: 700;
            color: #1B4D3E; padding: 2px 4px; border-top: 1px dashed #a8c4b8;
        }
        .dest-row td {
            font-size: 7pt; padding: 2px 4px 2px 16px;
            color: #2c3e50; border-bottom: 1px dotted #dde; background: #f8fdf9;
        }
        .dest-row td.r { text-align: right; }
        .dest-row td.dest-name { color: #1B4D3E; font-weight: 600; }
        /* Print bar */
        .print-bar {
            display: flex; justify-content: center;
            gap: 10px; padding: 8px; background: #fff;
        }
        .btn-print {
            background: #1B4D3E; color: #fff; border: none;
            border-radius: 4px; padding: 6px 22px;
            font-size: 9pt; font-weight: 600; cursor: pointer;
        }
        .btn-print:hover { background: #0F2E25; }
        .btn-close-win {
            background: #6c757d; color: #fff; border: none;
            border-radius: 4px; padding: 6px 16px; font-size: 9pt; cursor: pointer;
        }
        @@media print {
            html, body { background: #fff !important; margin: 0; padding: 0; }
            .print-bar { display: none !important; }
            .page { width: 100%; min-height: 0; margin: 0; box-shadow: none; border-radius: 0; }
            @@page { size: A4 portrait; margin: 8mm 10mm 10mm; }
            .oc-table tbody tr { page-break-inside: avoid; }
            .req-group { page-break-inside: avoid; }
        }
    </style>
</head>
<body>

<div class="print-bar">
    <button class="btn-print" onclick="window.print()">🖨 Imprimir / Guardar PDF</button>
    <button class="btn-close-win" onclick="window.close()">✕ Cerrar</button>
</div>

<div class="page">
    <div class="top-stripe"></div>

    <!-- HEADER -->
    <div class="doc-header">
        <div class="header-left">
            <div class="header-logo">
                @if (!string.IsNullOrWhiteSpace(logoPath))
                {
                    <img src="/@logoPath" alt="@logoAlt" />
                }
                else
                {
                    <div class="header-logo-placeholder">@logoAlt</div>
                }
            </div>
            <div class="header-company">
                @if (!string.IsNullOrWhiteSpace(empresaNombreCorto)) { <div class="empresa-marca">@empresaNombreCorto</div> }
                <h1>@empresaNombre</h1>
                <p>
                    @if (!string.IsNullOrWhiteSpace(empresaRuc))   { <text>RUC: <strong>@empresaRuc</strong></text> }
                    @if (!string.IsNullOrWhiteSpace(empresaDireccion)) { <br /><text>@empresaDireccion</text> }
                    @if (!string.IsNullOrWhiteSpace(empresaTelefono))  { <br /><text>Teléfono: @empresaTelefono</text> }
                </p>
            </div>
        </div>
        <div class="header-right">
            <span class="doc-type">@tipoLabel</span>
            <span class="doc-num">@numDoc</span>
            <span class="doc-badge" style="background-color:@estadoColor;">@estadoTexto</span>
            <span class="doc-copy">COPIA CONTABILIDAD</span>
        </div>
    </div>

    <!-- DATOS GENERALES -->
    <div class="section-grid">
        <div class="section-col">
            <div class="sec-title">Datos del Documento</div>
            <div class="field-row"><span class="f-lbl">Tipo:</span><span class="f-val hl">@tipoLabel</span></div>
            <div class="field-row"><span class="f-lbl">Número:</span><span class="f-val hl">@numDoc</span></div>
            <div class="field-row"><span class="f-lbl">Fecha:</span><span class="f-val">@oc.Fecha?.ToString("dd/MM/yyyy")</span></div>
            <div class="field-row"><span class="f-lbl">F. Entrega:</span><span class="f-val">@oc.FEntrega?.ToString("dd/MM/yyyy")</span></div>
        </div>
        <div class="section-col">
            <div class="sec-title">Condiciones Comerciales</div>
            <div class="field-row"><span class="f-lbl">Moneda:</span><span class="f-val hl">@monedaSimbolo</span></div>
            <div class="field-row"><span class="f-lbl">C. Pago:</span><span class="f-val">@(descCondPag ?? oc.CondPag ?? "—")</span></div>
            <div class="field-row"><span class="f-lbl">F. Venc:</span><span class="f-val"></span></div>
        </div>
        <div class="section-col">
            <div class="sec-title">Requerimientos</div>
            <div class="f-val" style="font-size:8pt;color:#2c3e50;">
                @{
                    var reqs = items.Where(i => i.NumReq.HasValue && i.NumReq > 0)
                                    .Select(i => i.NumReq!.Value).Distinct()
                                    .OrderByDescending(n => n)
                                    .Select(n => n.ToString())
                                    .ToList();
                }
                @(reqs.Any() ? string.Join(", ", reqs) : "—")
            </div>
        </div>
    </div>

    <!-- PROVEEDOR -->
    <div class="prov-bar">
        <div>
            <div class="sec-title" style="margin-bottom:2px;">Proveedor</div>
            <div class="prov-name">@(provDetalle?.Nombre ?? nomProv ?? oc.CodProveed ?? "—")</div>
            @if (!string.IsNullOrWhiteSpace(oc.CodProveed))
            { <div class="prov-meta">Código: @oc.CodProveed</div> }
            @if (!string.IsNullOrWhiteSpace(provDetalle?.Ruc))
            { <div class="prov-meta">RUC: @provDetalle!.Ruc</div> }
            @if (!string.IsNullOrWhiteSpace(provDetalle?.Direccion))
            { <div class="prov-meta" style="max-width:260px;white-space:normal;">@provDetalle!.Direccion</div> }
            @if (!string.IsNullOrWhiteSpace(provDetalle?.Telefono))
            { <div class="prov-meta">Tel: @provDetalle!.Telefono</div> }
        </div>
        @if (!string.IsNullOrWhiteSpace(oc.Detalle))
        {
            <div>
                <div class="sec-title" style="margin-bottom:2px;">Observaciones</div>
                <div style="font-size:7.5pt;color:#2c3e50;white-space:pre-wrap;line-height:1.4;max-width:220px;">@oc.Detalle</div>
            </div>
        }
    </div>

    <!-- CENTRO DE COSTO DE CABECERA -->
    @if (!string.IsNullOrWhiteSpace(oc.CCosto))
    {
        <div class="ccosto-bar">
            <strong>Centro de Costo (cabecera):</strong>
            @oc.CCosto — @(nomCcosto ?? "—")
        </div>
    }

    <!-- ÍTEMS DESAGREGADOS POR REQUISICIÓN -->
    <div class="items-section" style="padding-top:3mm;">
        @foreach (var grupo in grupos)
        {
            var ccostoGrupo = grupo.FirstOrDefault(i => !string.IsNullOrWhiteSpace(i.CCosto))?.CCosto;
            var ccostoNombre = !string.IsNullOrWhiteSpace(ccostoGrupo) && centrosCosto.TryGetValue(ccostoGrupo, out var cn) ? cn : null;
            <div class="req-group">
                <div class="req-group-header">
                    Requerimiento N° @grupo.Key
                    <span style="font-weight:400; opacity:.8; margin-left:6px;">(@grupo.Count() ítem@(grupo.Count()==1?"":"s"))</span>
                    @if (!string.IsNullOrWhiteSpace(ccostoGrupo))
                    {
                        <span style="font-weight:400; font-size:7pt; margin-left:10px; color:#e8f5e9;">
                            C.Costo: @ccostoGrupo — @(ccostoNombre ?? "—")
                        </span>
                    }
                </div>
                <table class="oc-table">
                    <thead>
                        <tr>
                            <th class="c" style="width:20px;">#</th>
                            <th style="width:66px;">Artículo</th>
                            <th>Descripción</th>
                            <th class="c" style="width:28px;">Und</th>
                            <th class="r" style="width:52px;">Cantidad</th>
                            <th class="r" style="width:58px;">P. Unit.</th>
                            <th class="r" style="width:62px;">Desc.</th>
                            <th class="r" style="width:64px;">Importe</th>
                            <th class="r" style="width:54px;">Cant. Pend.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rowNum = 0; }
                        @foreach (var it in grupo.OrderBy(i => i.OrdenReq ?? i.Orden))
                        {
                            rowNum++;
                            var desc = descsArt.TryGetValue(it.CodArt ?? "", out var da) && !string.IsNullOrWhiteSpace(da)
                                        ? da : it.Descripcion ?? it.CodArt ?? "—";
                            var tieneDesc = it.PorDesc1 > 0 || it.PorDesc2 > 0;
                            var descTxt = tieneDesc
                                ? (it.PorDesc1 > 0 && it.PorDesc2 > 0
                                    ? $"{it.PorDesc1:N2}%+{it.PorDesc2:N2}%"
                                    : it.PorDesc1 > 0 ? $"{it.PorDesc1:N2}%" : $"{it.PorDesc2:N2}%")
                                : "—";
                            // Sub-filas de destino para este artículo en este req
                            var reqKey = it.NumReq.HasValue && it.NumReq > 0 ? it.NumReq.Value : 0;
                            // Matching exacto por ITEMORD.ORDEN (OrdenRef) para evitar
                            // que ítems repetidos del mismo artículo compartan destinos
                            var destsItem = destinosOc
                                .Where(d => d.OrdenRef == it.Orden)
                                .OrderBy(d => d.OrdenReq)
                                .ToList();
                            <tr>
                                <td class="num">@rowNum</td>
                                <td class="art">
                                    @(it.CodArt ?? "—")
                                    @if (!string.IsNullOrWhiteSpace(it.CodOrig))
                                    {
                                        <br /><span style="font-size:6.5pt;color:#6c7a89;font-weight:400;">Cód. Prov.: @it.CodOrig</span>
                                    }
                                </td>
                                <td class="desc">@desc</td>
                                <td class="c" style="color:#555;">@(it.Unidad ?? "—")</td>
                                <td class="r">@it.Cantidad.ToString("N2")</td>
                                <td class="r">@monedaSimb @it.Precio.ToString("N2")</td>
                                <td class="r" style="color:@(tieneDesc?"#b71c1c":"#888");font-size:7pt;">@descTxt</td>
                                <td class="r" style="font-weight:700;">@monedaSimb @it.ImpVvta.ToString("N2")</td>
                                <td class="r" style="color:#1B4D3E;font-weight:600;">@it.Saldo.ToString("N2") @it.Unidad</td>
                            </tr>
                            @if (destsItem.Count > 0)
                            {
                                <tr class="dest-header-row">
                                    <td colspan="2"></td>
                                    <td colspan="2" style="color:#555;font-weight:600;">↳ Distribución por Destino / Centro de Costo</td>
                                    <td class="r">Cant.</td>
                                    <td class="r">P. Unit.</td>
                                    <td></td>
                                    <td class="r">Importe</td>
                                    <td class="dest-name">Solicitante</td>
                                </tr>
                                @foreach (var dst in destsItem)
                                {
                                    <tr class="dest-row">
                                        <td colspan="2"></td>
                                        <td class="dest-name" colspan="2">@(dst.DestinoDesc ?? dst.Destino ?? "—")</td>
                                        <td class="r">@dst.Cantidad.ToString("N2")</td>
                                        <td class="r">@monedaSimb @dst.Precio.ToString("N2")</td>
                                        <td></td>
                                        <td class="r">@monedaSimb @dst.Importe.ToString("N2")</td>
                                        <td>@(dst.CodSolicita ?? "—")</td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="7" class="r" style="color:#6c7a89;font-weight:600;">Subtotal Req. @grupo.Key</td>
                            <td class="r">@monedaSimb @grupo.Sum(i => i.ImpVvta).ToString("N2")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }

        <!-- Totales globales -->
        <div style="display:flex;justify-content:flex-end;padding:.4rem 0 .5rem;">
            <div class="totals-box">
                <table>
                    <tr>
                        <td class="t-lbl">Valor Venta:</td>
                        <td class="t-val">@monedaSimb @valVenta.ToString("N2")</td>
                    </tr>
                    @if (oc.ImpDescto > 0)
                    {
                        <tr>
                            <td class="t-lbl">Descuento:</td>
                            <td class="t-val">(@monedaSimb @oc.ImpDescto.ToString("N2"))</td>
                        </tr>
                        <tr>
                            <td class="t-lbl">Valor Neto:</td>
                            <td class="t-val">@monedaSimb @oc.ImpNeto.ToString("N2")</td>
                        </tr>
                    }
                    <tr>
                        <td class="t-lbl">@(oc.ImpIgv < 0 ? "RETENCIÓN I.RENTA:" : "I.G.V.:")</td>
                        <td class="t-val">@monedaSimb @impIgv.ToString("N2")</td>
                    </tr>
                    <tr class="grand-total">
                        <td class="t-lbl">TOTAL:</td>
                        <td class="t-val">@monedaSimb @total.ToString("N2")</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>



    <!-- FIRMAS -->
    @{
        var firmaGen = ViewBag.FirmaGenerado as FabricaHilos.Models.Logistica.FirmaOcDto;
        var firmaApr = ViewBag.FirmaAprobado as FabricaHilos.Models.Logistica.FirmaOcDto;

        string? firmaGenSrc = firmaGen?.Firma != null && firmaGen.Firma.Length > 0
            ? FabricaHilos.Services.Logistica.OrdenCompraService.DetectImageMimeType(firmaGen.Firma) is string mimeGen
                ? $"data:{mimeGen};base64,{Convert.ToBase64String(firmaGen.Firma)}"
                : null
            : null;
        string? firmaAprSrc = firmaApr?.Firma != null && firmaApr.Firma.Length > 0
            ? FabricaHilos.Services.Logistica.OrdenCompraService.DetectImageMimeType(firmaApr.Firma) is string mimeApr
                ? $"data:{mimeApr};base64,{Convert.ToBase64String(firmaApr.Firma)}"
                : null
            : null;
    }
    <div class="firma-section">
        <div class="firma-box">
            @if (firmaGenSrc != null)
            {
                <img class="firma-img" src="@firmaGenSrc" alt="Firma" />
            }
            else
            {
                <div class="firma-img-placeholder"></div>
            }
            <div class="firma-line"></div>
            @if (!string.IsNullOrWhiteSpace(firmaGen?.NombreCompleto))
            {
                <div class="firma-nombre">@firmaGen!.NombreCompleto</div>
            }
            <div class="firma-label">@(firmaGen?.RolEtiqueta ?? "Generado por")</div>
            <div class="firma-sublabel">@(firmaGen?.Cargo ?? "Logística")</div>
        </div>
        <div class="firma-box">
            @if (firmaAprSrc != null)
            {
                <img class="firma-img" src="@firmaAprSrc" alt="Firma" />
            }
            else
            {
                <div class="firma-img-placeholder"></div>
            }
            <div class="firma-line"></div>
            @if (!string.IsNullOrWhiteSpace(firmaApr?.NombreCompleto))
            {
                <div class="firma-nombre">@firmaApr!.NombreCompleto</div>
            }
            <div class="firma-label">@(firmaApr?.RolEtiqueta ?? "Aprobado por")</div>
            <div class="firma-sublabel">@(firmaApr?.Cargo ?? "Gerencia")</div>
        </div>
    </div>

    <!-- AUDITORÍA -->
    <div class="audit-bar">
        <div>
            <div class="a-lbl">Creado por</div>
            <div class="a-val">@fmtUsu(oc.AAduser) &nbsp; @oc.AAdfecha?.ToString("dd/MM/yyyy HH:mm")</div>
        </div>
        @if (!string.IsNullOrWhiteSpace(oc.AMduser))
        {
            <div>
                <div class="a-lbl">Modificado por</div>
                <div class="a-val">@fmtUsu(oc.AMduser) &nbsp; @oc.AMdfecha?.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(oc.AprobGerencia) && oc.FAprobGer.HasValue)
        {
            <div>
                <div class="a-lbl">Aprobado por Gerencia</div>
                <div class="a-val">@fmtUsu(oc.AprobGerencia) &nbsp; @oc.FAprobGer.Value.ToString("dd/MM/yyyy")</div>
            </div>
        }
    </div>

    <!-- FOOTER -->
    <div class="doc-footer">
        <div class="fl">
            @empresaNombre
            @if (!string.IsNullOrWhiteSpace(empresaRuc)) { <text> · RUC: @empresaRuc</text> }
            <br />Generado el @DateTime.Now.ToString("dd/MM/yyyy HH:mm") — USO INTERNO / CONTABILIDAD
        </div>
        <div class="fr">
            <span style="color:#c0392b;font-weight:700;">DOCUMENTO INTERNO — NO VÁLIDO COMO COMPROBANTE</span>
        </div>
    </div>

    <div class="bottom-stripe"></div>
</div>
</body>
</html>
