#stTable tfoot td.fc-8  { left: 386px; box-shadow: 3px 0 6px -2px rgba(0,0,0,.18); }


/* ── Separadores de grupo en la tabla ─────────────────────── */
.col-sep { border-left: 2px solid #d1d9e6 !important; }

.th-grupo {
    text-align: center;
    font-size: .58rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #e2f0ff;
    background: #1a4971;
    border-bottom: 2px solid #f59e0b;
    padding: 2px 5px;
    line-height: 1.4;
}
.th-grupo-adicional {
    text-align: center;
    font-size: .63rem;
    font-weight: 700;
    letter-spacing: .06em;
    white-space: nowrap;
    color: #856404;
    background: #fff3cd;
    border-bottom: 2px solid #ffc107;
    padding: 2px 6px;
}

/* ── Badges ───────────────────────────────────────────────── */
.eb {
    display: inline-flex; align-items: center; gap: .2rem;
    border-radius: .22rem; padding: .08rem .3rem;
    font-size: .63rem; font-weight: 600; white-space: nowrap;
}
.eb-ok   { background: #d1fae5; color: #065f46; }
.eb-sin  { background: #f1f5f9; color: #94a3b8; }
.eb-proc { background: #dbeafe; color: #1e40af; }
.eb-est  { background: #e0e7ff; color: #3730a3; }

.dias-ok  { color: #059669; font-weight: 700; }
.dias-ret { color: #dc2626; font-weight: 700; }

/* ── Footer tabla ─────────────────────────────────────────── */
.spt-footer {
    display: flex; align-items: center; justify-content: space-between;
    padding: .45rem .9rem; background: #f4f7fb;
    border-top: 1px solid #d1d9e6; font-size: .71rem; color: #64748b;
    flex-wrap: wrap; gap: .4rem;
}
.spt-legend { display: flex; gap: .6rem; align-items: center; flex-wrap: wrap; }

/* ── Paginación ─────────────────────────────────────────────────────────── */
.pg-bar {
    display: flex; flex-wrap: wrap; align-items: center; gap: .4rem;
    padding: .38rem .9rem;
    background: #f0f4ff; border-bottom: 1px solid #c7d7f9;
    font-size: .72rem;
}
.pg-info {
    font-size: .71rem; color: #2563eb; font-weight: 700;
    background: #dbeafe; border: 1px solid #93c5fd;
    border-radius: .28rem; padding: .12rem .45rem; white-space: nowrap;
    margin-left: auto;
}
.pg-size {
    font-size: .72rem; border: 1px solid #bfcad8; border-radius: .28rem;
    background: #fff; color: #1e2d3d; padding: .18rem .45rem;
    cursor: pointer;
}
.pg-btn {
    border: 1px solid #bfcad8; border-radius: .28rem;
    background: #fff; color: #334155; padding: .18rem .55rem;
    font-size: .72rem; cursor: pointer; display: inline-flex; align-items: center; gap: .2rem;
    transition: background .12s, border-color .12s;
    white-space: nowrap;
}
.pg-btn:hover:not(:disabled) { background: #eff6ff; border-color: #93c5fd; color: #1d4ed8; }
.pg-btn:disabled { opacity: .4; cursor: not-allowed; }
.pg-btn.pg-active { background: #1a4971; color: #fff; border-color: #1a4971; font-weight: 700; }
.pg-nums { display: flex; gap: .2rem; flex-wrap: wrap; }
</style>
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Produccion" asp-action="Index">Producción</a></li>
    <li class="breadcrumb-item active">Seguimiento Tintorería</li>
}

@await Html.PartialAsync("_PlnNavBar")

<div class="container-fluid py-3">
<div class="spt-card">

    @* ── Header ──────────────────────────────────────────────────────── *@
    <div class="spt-header">
        <i class="bi bi-grid-3x3-gap-fill" style="color:#93c5fd;font-size:1rem;flex-shrink:0;"></i>
        <span class="spt-header-title">Seguimiento Programación Tintorería</span>
        <span class="spt-sep"></span>
        @if (buscado && items.Any())
        {
            <span class="spt-kpi"><i class="bi bi-list-check"></i><b>@items.Count</b> registros</span>
            <span class="spt-kpi" style="--c:#6ee7b7"><i class="bi bi-droplet-half" style="color:#6ee7b7"></i><b style="color:#6ee7b7">@conTenido</b> teñidos</span>
            <span class="spt-kpi"><i class="bi bi-patch-check" style="color:#a5f3fc"></i><b style="color:#a5f3fc">@conCc</b> CC ok</span>
            <span class="spt-kpi"><i class="bi bi-truck" style="color:#fcd34d"></i><b style="color:#fcd34d">@despachados</b> desp.</span>
            @if (retrasados > 0)
            {
                <span class="spt-kpi"><i class="bi bi-exclamation-triangle-fill" style="color:#f87171"></i><b style="color:#f87171">@retrasados</b> retraso</span>
            }
            <span class="ms-auto" style="font-size:.68rem;color:rgba(200,225,255,.7);white-space:nowrap;">
                <i class="bi bi-funnel me-1"></i>@opc
                @if (opc == "POR PEDIDO")
                { <span> · Ped. <b style="color:#fff">@numPed</b></span> }
                else
                { <span> · <b style="color:#fff">@fchIni</b> → <b style="color:#fff">@fchFin</b></span> }
            </span>
        }
        else if (!buscado)
        {
            <span style="font-size:.75rem;color:rgba(200,225,255,.7);">Aplica los filtros para consultar los datos.</span>
        }
    </div>


    @* ── Filtros ──────────────────────────────────────────────────────────────────────────────────────────────────────── *@
    <div class="spt-filters">
        <form method="get" asp-action="SeguimientoTintoreria" id="stForm">

            @* Fila 1: modo búsqueda + fechas + acciones *@
            <div class="spt-filters-row1">
                <div class="spt-fld">
                    <label class="spt-label" for="stOpc"><i class="bi bi-search"></i>Buscar por</label>
                    <select class="spt-ctrl" name="opc" id="stOpc" style="min-width:200px;">
                        @foreach (var op in opciones)
                        {
                            <option value="@op" selected="@(opc == op ? "selected" : null)">@op</option>
                        }
                    </select>
                </div>

                <div class="spt-fld" id="stGrpFechas">
                    <label class="spt-label" for="stFchIni"><i class="bi bi-calendar-event"></i>Fecha inicio</label>
                    <input type="date" class="spt-ctrl" name="fchIni" id="stFchIni" value="@iniHtml" style="min-width:135px;" />
                </div>
                <div class="spt-fld" id="stGrpFechaFin">
                    <label class="spt-label" for="stFchFin"><i class="bi bi-calendar-check"></i>Fecha fin</label>
                    <input type="date" class="spt-ctrl" name="fchFin" id="stFchFin" value="@finHtml" style="min-width:135px;" />
                </div>

                <div class="spt-fld" id="stGrpNumPed" style="display:none;">
                    <label class="spt-label" for="stNumPed"><i class="bi bi-hash"></i>N.° Pedido</label>
                    <input type="number" class="spt-ctrl" name="numPed" id="stNumPed"
                           value="@numPed" style="width:125px;" placeholder="Ej. 88797" />
                </div>

                <div class="spt-fld">
                    <label class="spt-label" style="visibility:hidden;">Acción</label>
                    <div style="display:flex;gap:.4rem;align-items:center;">
                        <button type="submit" class="spt-btn-buscar">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                        <a asp-action="SeguimientoTintoreria" class="spt-btn-limpiar">
                            <i class="bi bi-x-circle"></i> Limpiar
                        </a>
                    </div>
                </div>
            </div>

            @* Fila 2: filtros adicionales *@
            <div class="spt-filters-row2">
                <div class="spt-fld">
                    <label class="spt-label" for="stCliente"><i class="bi bi-building"></i>Cliente</label>
                    <select class="spt-ctrl" name="cliente" id="stCliente" style="min-width:260px;">
                        <option value="">— Todos —</option>
                        @foreach (var c in filtroClientes)
                        {
                            <option value="@c.CodCliente" selected="@(cliente == c.CodCliente ? "selected" : null)">@c.Nombre</option>
                        }
                    </select>
                </div>
                <div class="spt-fld">
                    <label class="spt-label" for="stAsesor"><i class="bi bi-person-badge"></i>Asesor</label>
                    <select class="spt-ctrl" name="asesor" id="stAsesor" style="min-width:210px;">
                        <option value="">— Todos —</option>
                        @foreach (var a in filtroAsesores)
                        {
                            <option value="@a.CodVende" selected="@(asesor == a.CodVende ? "selected" : null)">@a.Nombre</option>
                        }
                    </select>
                </div>
                <div class="spt-fld">
                    <label class="spt-label" for="stTitulo"><i class="bi bi-tag"></i>Título</label>
                    <select class="spt-ctrl" name="titulo" id="stTitulo" style="min-width:180px;">
                        <option value="">— Todos —</option>
                        @foreach (var t in filtroTitulos)
                        {
                            <option value="@t.Titulo" selected="@(titulo == t.Titulo ? "selected" : null)">@t.Descripcion</option>
                        }
                    </select>
                </div>
                <div class="spt-fld">
                    <label class="spt-label" for="stFibra"><i class="bi bi-layers"></i>Fibra</label>
                    <select class="spt-ctrl" name="fibra" id="stFibra" style="min-width:190px;">
                        <option value="">— Todas —</option>
                        @foreach (var f in filtroFibras)
                        {
                            <option value="@f.TipoFibra" selected="@(fibra == f.TipoFibra ? "selected" : null)">@f.Descripcion</option>
                        }
                    </select>
                </div>
                <div class="spt-fld">
                    <label class="spt-label" for="stProceso"><i class="bi bi-cpu"></i>Proceso</label>
                    <select class="spt-ctrl" name="proceso" id="stProceso" style="min-width:220px;">
                        <option value="">— Todos —</option>
                        @foreach (var p in filtroProcesos)
                        {
                            <option value="@p.Proceso" selected="@(proceso == p.Proceso ? "selected" : null)">@p.Descripcion</option>
                        }
                    </select>
                </div>
            </div>
        </form>
    </div>

    @* ── Chips de filtros activos ─────────────────────────────────────── *@
    @if (buscado && (hayMesAno || hayCliente || hayAsesor || hayTitulo || hayFibra || hayProceso))
    {
        <div class="spt-chips">
            <span style="font-size:.68rem;color:#64748b;font-weight:600;margin-right:.2rem;">Filtros:</span>
            @if (hayMesAno)  { <span class="spt-chip" style="background:#dbeafe;border-color:#93c5fd;"><span class="spt-chip-label">Mes</span> @nombresMes[stMes!.Value] @stAno</span> }
            @if (hayCliente) { <span class="spt-chip"><span class="spt-chip-label">Cliente</span> @nombreCliente</span> }
            @if (hayAsesor)  { <span class="spt-chip"><span class="spt-chip-label">Asesor</span>  @nombreAsesor</span>  }
            @if (hayTitulo)  { <span class="spt-chip"><span class="spt-chip-label">Título</span>  @nombreTitulo</span>  }
            @if (hayFibra)   { <span class="spt-chip"><span class="spt-chip-label">Fibra</span>   @nombreFibra</span>   }
            @if (hayProceso) { <span class="spt-chip"><span class="spt-chip-label">Proceso</span> @nombreProceso</span> }
        </div>
    }

</div>@* /spt-card filtros *@

<div class="spt-card">
    @* ── Resultados ──────────────────────────────────────────────────── *@
    @if (!buscado)
    {
        <div style="padding:2rem 1.5rem;text-align:center;color:#64748b;">
            <i class="bi bi-funnel" style="font-size:2.2rem;opacity:.35;display:block;margin-bottom:.5rem;"></i>
            <div style="font-size:.88rem;font-weight:600;">Aplica los filtros para consultar los datos</div>
            <div style="font-size:.78rem;opacity:.75;margin-top:.2rem;">Selecciona una opción de búsqueda y pulsa <strong>Buscar</strong>.</div>
        </div>
    }
    else if (!items.Any())
    {
        <div style="padding:2rem 1.5rem;text-align:center;color:#64748b;">
            <i class="bi bi-search" style="font-size:2rem;opacity:.35;display:block;margin-bottom:.5rem;"></i>
            <div style="font-size:.88rem;font-weight:600;">Sin resultados</div>
            <div style="font-size:.78rem;opacity:.75;margin-top:.2rem;">No se encontraron registros para los filtros seleccionados.</div>
        </div>
    }
    else
    {
        @* ── Barra de filtros client-side (filtra sobre la data ya cargada) ── *@
        <div class="cf-bar">
            <span class="cf-badge"><i class="bi bi-funnel-fill"></i> Filtrar datos</span>

            @* ── Mes ── *@
            <div class="spt-fld">
                <label class="spt-label" for="cfMes"><i class="bi bi-calendar-month"></i>Mes</label>
                <select class="spt-ctrl" id="cfMes" data-cf="mes" style="min-width:110px;">
                    <option value="">— Todos —</option>
                    @foreach (var m in cfMesesDisp) {
                        <option value="@m">@nombresMes[m] (@m)</option>
                    }
                </select>
            </div>

            @* ── Año ── *@
            <div class="spt-fld">
                <label class="spt-label" for="cfAno"><i class="bi bi-calendar-check"></i>Año</label>
                <select class="spt-ctrl" id="cfAno" data-cf="ano" style="min-width:72px;">
                    <option value="">——</option>
                    @foreach (var y in cfAnosDisp) {
                        <option value="@y">@y</option>
                    }
                </select>
            </div>

            <div style="align-self:flex-end;padding-bottom:.32rem;">
                <div style="width:1px;height:22px;background:#c7d7f9;"></div>
            </div>

            @* ── Partida (datalist) ── *@
            <div class="spt-fld">
                <label class="spt-label"><i class="bi bi-hash"></i>Partida</label>
                <input type="text" class="spt-ctrl" data-cf="partida" list="dlPartida"
                       placeholder="Buscar…" style="min-width:90px;" autocomplete="off" />
                <datalist id="dlPartida">
                    @foreach (var v in cfPartidaOpts) { <option value="@v"></option> }
                </datalist>
            </div>

            @* ── Cliente (datalist) ── *@
            <div class="spt-fld">
                <label class="spt-label"><i class="bi bi-building"></i>Cliente</label>
                <input type="text" class="spt-ctrl" data-cf="cliente" list="dlCliente"
                       placeholder="Buscar…" style="min-width:120px;" autocomplete="off" />
                <datalist id="dlCliente">
                    @foreach (var v in cfClienteOpts) { <option value="@v"></option> }
                </datalist>
            </div>

            @* ── Material (datalist) ── *@
            <div class="spt-fld">
                <label class="spt-label"><i class="bi bi-box-seam"></i>Material</label>
                <input type="text" class="spt-ctrl" data-cf="material" list="dlMaterial"
                       placeholder="Buscar…" style="min-width:110px;" autocomplete="off" />
                <datalist id="dlMaterial">
                    @foreach (var v in cfMaterialOpts) { <option value="@v"></option> }
                </datalist>
            </div>

            @* ── Est. (select) ── *@
            <div class="spt-fld">
                <label class="spt-label"><i class="bi bi-flag"></i>Est.</label>
                <select class="spt-ctrl" data-cf="est" style="min-width:60px;">
                    <option value="">Todos</option>
                    @foreach (var v in cfEstOpts) { <option value="@v">@v</option> }
                </select>
            </div>

            @* ── Maq. (select) ── *@
            <div class="spt-fld">
                <label class="spt-label"><i class="bi bi-gear"></i>Maq.</label>
                <select class="spt-ctrl" data-cf="maq" style="min-width:65px;">
                    <option value="">Todos</option>
                    @foreach (var v in cfMaqOpts) { <option value="@v">@v</option> }
                </select>
            </div>

            @* ── Flujo (select) ── *@
            <div class="spt-fld">
                <label class="spt-label"><i class="bi bi-activity"></i>Flujo</label>
                <select class="spt-ctrl" data-cf="estflujo" style="min-width:90px;">
                    <option value="">Todos</option>
                    @foreach (var v in cfFlujoOpts) { <option value="@v">@v</option> }
                </select>
            </div>

            @* ── Desp. (select) ── *@
            <div class="spt-fld">
                <label class="spt-label"><i class="bi bi-truck"></i>Desp.</label>
                <select class="spt-ctrl" data-cf="estdesp" style="min-width:90px;">
                    <option value="">Todos</option>
                    @foreach (var v in cfDespOpts) { <option value="@v">@v</option> }
                </select>
            </div>

            @* ── Área (select) ── *@
            <div class="spt-fld">
                <label class="spt-label"><i class="bi bi-people"></i>Área</label>
                <select class="spt-ctrl" data-cf="area" style="min-width:90px;">
                    <option value="">Todos</option>
                    @foreach (var v in cfAreaOpts) { <option value="@v">@v</option> }
                </select>
            </div>

            @* ── Tipo Acabado (select) ── *@
            @if (cfTipoAcOpts.Count > 0) {
            <div class="spt-fld">
                <label class="spt-label"><i class="bi bi-layers"></i>Acabado</label>
                <select class="spt-ctrl" data-cf="tipoac" style="min-width:80px;">
                    <option value="">Todos</option>
                    @foreach (var v in cfTipoAcOpts) { <option value="@v">@v</option> }
                </select>
            </div>
            }

            <div style="align-self:flex-end;padding-bottom:.32rem;">
                <div style="width:1px;height:22px;background:#c7d7f9;"></div>
            </div>

            @* ── Indicadores ── *@
            <div class="spt-fld">
                <label class="spt-label"><i class="bi bi-exclamation-triangle"></i>Estado</label>
                <select class="spt-ctrl" data-cf-ind="retrasado" style="min-width:100px;">
                    <option value="">Todos</option>
                    <option value="1">⚠ Retrasados</option>
                    <option value="0">✔ En plazo</option>
                </select>
            </div>
            <div class="spt-fld">
                <label class="spt-label"><i class="bi bi-check2-circle"></i>Teñido</label>
                <select class="spt-ctrl" data-cf-ind="conten" style="min-width:95px;">
                    <option value="">Todos</option>
                    <option value="1">Con teñido</option>
                    <option value="0">Sin teñido</option>
                </select>
            </div>
            <div class="spt-fld">
                <label class="spt-label"><i class="bi bi-check2-all"></i>C.C.</label>
                <select class="spt-ctrl" data-cf-ind="concc" style="min-width:80px;">
                    <option value="">Todos</option>
                    <option value="1">Con C.C.</option>
                    <option value="0">Sin C.C.</option>
                </select>
            </div>
            <div class="spt-fld">
                <label class="spt-label"><i class="bi bi-box-arrow-right"></i>Despacho</label>
                <select class="spt-ctrl" data-cf-ind="despachado" style="min-width:100px;">
                    <option value="">Todos</option>
                    <option value="1">Despachados</option>
                    <option value="0">Pendientes</option>
                </select>
            </div>
            <div class="spt-fld">
                <label class="spt-label"><i class="bi bi-clock-history"></i>D.Rod</label>
                <select class="spt-ctrl" data-cf-ind="diasrod" style="min-width:85px;">
                    <option value="">Todos</option>
                    <option value="ret">Retrasados</option>
                    <option value="ok">En plazo</option>
                    <option value="sin">Sin valor</option>
                </select>
            </div>
            <div class="spt-fld">
                <label class="spt-label"><i class="bi bi-clock-history"></i>D.MH</label>
                <select class="spt-ctrl" data-cf-ind="diasmh" style="min-width:85px;">
                    <option value="">Todos</option>
                    <option value="ret">Retrasados</option>
                    <option value="ok">En plazo</option>
                    <option value="sin">Sin valor</option>
                </select>
            </div>
            <div class="spt-fld">
                <label class="spt-label"><i class="bi bi-clock-history"></i>D.Rec</label>
                <select class="spt-ctrl" data-cf-ind="diasrec" style="min-width:85px;">
                    <option value="">Todos</option>
                    <option value="ret">Retrasados</option>
                    <option value="ok">En plazo</option>
                    <option value="sin">Sin valor</option>
                </select>
            </div>
            <div class="spt-fld">
                <label class="spt-label"><i class="bi bi-clock-history"></i>Días T</label>
                <select class="spt-ctrl" data-cf-ind="diast" style="min-width:85px;">
                    <option value="">Todos</option>
                    <option value="ret">Retrasados</option>
                    <option value="ok">En plazo</option>
                    <option value="sin">Sin valor</option>
                </select>
            </div>
            <div class="spt-fld">
                <label class="spt-label"><i class="bi bi-clock-history"></i>D.E</label>
                <select class="spt-ctrl" data-cf-ind="de" style="min-width:85px;">
                    <option value="">Todos</option>
                    <option value="ret">Retrasados</option>
                    <option value="ok">En plazo</option>
                    <option value="sin">Sin valor</option>
                </select>
            </div>

            <button id="cfResetBtn" class="cf-reset" type="button">
                <i class="bi bi-x-circle"></i> Limpiar
            </button>
            <span class="cf-count"><span id="cfCount">@items.Count</span> / <span id="cfTotal">@items.Count</span></span>

            @* ── Paginación: selector de tamaño + navegación ── *@
            <div style="display:flex;align-items:center;gap:.35rem;margin-left:auto;flex-wrap:wrap;">
                <label style="font-size:.68rem;color:#4a6080;font-weight:700;white-space:nowrap;">Filas/pág</label>
                <select id="pgSize" class="pg-size">
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="200" selected>200</option>
                    <option value="500">500</option>
                    <option value="0">Todos</option>
                </select>
                <div class="pg-nums" id="pgNums"></div>
                <button class="pg-btn" id="pgPrev" type="button"><i class="bi bi-chevron-left"></i></button>
                <button class="pg-btn" id="pgNext" type="button"><i class="bi bi-chevron-right"></i></button>
                <span class="pg-info" id="pgInfo"></span>
            </div>
        </div>

        <div class="spt-table-wrap">
            <table id="stTable">
                <thead>
                    @* ── Fila 1: Cabeceras de grupo ──────────────────────────────────────── *@
                    <tr>
                        @* Cols 1-8: sin cabecera de grupo (tiempo + identificación) *@
                        <th colspan="8" class="th-grupo"></th>

                        @* Col 13-15: RODETE *@
                        <th colspan="3" class="col-sep th-grupo">RODETE</th>

                        @* Cols 16-18: ENTREGA MATERIAL HILAND *@
                        <th colspan="3" class="col-sep th-grupo">ENTREGA MATERIAL HILAND.</th>

                        @* Col 19: DESPACHO MATERIAL *@
