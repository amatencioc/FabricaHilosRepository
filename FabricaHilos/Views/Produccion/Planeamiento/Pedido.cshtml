                                                  <span class="badge bg-secondary me-1" style="font-size:.65rem;">@pc.CodMaq</span>
                                                  <span class="tt-val">@pc.NombreMaq</span>
                                                </div>
                                                <div>
                                                  <span class="tt-lbl">Estado</span>
                                                  <span class="badge @(pc.Estado == "3" ? "bg-success" : "bg-warning text-dark")" style="font-size:.65rem;">@pc.DescEstado</span>
                                                </div>
                                              </div>
                                            </div>
                                          }
                                        </div>
                                      </div>
                                    </div>
                                  }

                                  @* ── Registro de Devanado ────────────────────────────────────── *@
                                  @if (detTt!.Devanados.Count > 0)
                                  {
                                    <div class="accordion-item tt-acc-item">
                                      <h2 class="accordion-header">
                                        <button class="accordion-button collapsed tt-acc-btn" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#acc-tt-@(subIdx)-dev"
                                                aria-expanded="false">
                                          <span class="tt-sdot @(detTt.Devanados.All(x => x.FechaFin.HasValue) ? "tt-sdot-ok" : "tt-sdot-run")"></span>
                                          <i class="bi bi-arrow-repeat me-2"></i>Registro de Devanado
                                          <span class="tt-acc-preview">@detTt.Devanados.Count registro@(detTt.Devanados.Count != 1 ? "s" : "")@(detTt.Devanados.Any(x => x.PesoNeto.HasValue) ? $" · {detTt.Devanados.Where(x => x.PesoNeto.HasValue).Sum(x => x.PesoNeto!.Value):N0} kg" : "")</span>
                                        </button>
                                      </h2>
                                      <div id="acc-tt-@(subIdx)-dev" class="accordion-collapse collapse">
                                        <div class="accordion-body p-2">
                                          <div class="table-responsive">
                                            <table class="table table-sm tt-table mb-0">
                                              <thead>
                                                <tr>
                                                  <th>Máquina</th>
                                                  <th>F/Hora Inicio</th>
                                                  <th>F/Hora Fin</th>
                                                  <th class="text-end">Duración</th>
                                                  <th class="text-end">Conos</th>
                                                  <th class="text-end">Peso Neto (kg)</th>
                                                  <th>Estado</th>
                                                </tr>
                                              </thead>
                                              <tbody>
                                                @foreach (var dv in detTt.Devanados)
                                                {
                                                  <tr>
                                                    <td><span class="badge bg-secondary me-1" style="font-size:.62rem;">@dv.CodMaq</span> @dv.NombreMaq</td>
                                                    <td class="tt-mono">@dv.FechaIni.ToString("dd/MM/yy HH:mm")</td>
                                                    <td class="tt-mono">@(dv.FechaFin?.ToString("dd/MM/yy HH:mm") ?? "—")</td>
                                                    <td class="text-end">
                                                      @if (dv.DuracionHoras.HasValue)
                                                      {
                                                        var h = (int)dv.DuracionHoras.Value;
                                                        var m = (int)((dv.DuracionHoras.Value - h) * 60);
                                                        @($"{h}h {m:D2}min")
                                                      }
                                                      else { <text>—</text> }
                                                    </td>
                                                    <td class="text-end">@(dv.Unidades?.ToString("N0") ?? "—")</td>
                                                    <td class="text-end">@(dv.PesoNeto?.ToString("N2") ?? "—")</td>
                                                    <td>
                                                      <span class="badge @(dv.Estado == "3" ? "bg-success" : "bg-secondary")" style="font-size:.62rem;">
                                                        @(dv.Estado == "3" ? "Completado" : dv.Estado)
                                                      </span>
                                                    </td>
                                                  </tr>
                                                }
                                              </tbody>
                                            </table>
                                          </div>
                                        </div>
                                      </div>
                                    </div>
                                  }

                                  @* ── Revisado de Productos Acabados ─────────────────────────── *@
                                  @if (detTt!.Revisados.Count > 0)
                                  {
                                    <div class="accordion-item tt-acc-item">
                                      <h2 class="accordion-header">
                                        <button class="accordion-button collapsed tt-acc-btn" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#acc-tt-@(subIdx)-rev"
                                                aria-expanded="false">
                                          <span class="tt-sdot @(detTt.Revisados.All(x => x.FchFinRevisa.HasValue) ? "tt-sdot-ok" : "tt-sdot-run")"></span>
