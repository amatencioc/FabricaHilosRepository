@model FabricaHilos.Models.Ventas.Cotizacion.RutaTecnicaCabDto
@{
    ViewData["Title"] = Model.IdCab > 0 ? $"Editar Ficha Técnica — {Model.TituloRoute}" : "Nueva Ficha Técnica de Ruta";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Ventas" asp-action="Index">Ventas</a></li>
    <li class="breadcrumb-item"><a asp-controller="Cotizacion" asp-action="Index">Cotizaciones</a></li>
    <li class="breadcrumb-item"><a asp-action="Index">Fichas Técnicas de Ruta</a></li>
    <li class="breadcrumb-item active">@(Model.IdCab > 0 ? Model.TituloRoute : "Nueva")</li>
}

@section Styles {
    <link rel="stylesheet" href="~/css/sire.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cotizacion.css" asp-append-version="true" />
}

<div class="sire-page-header">
    <div class="sire-page-icon sire"><i class="bi bi-clipboard-data"></i></div>
    <div>
        <h1 class="sire-page-title">@(Model.IdCab > 0 ? "Editar Ficha Técnica de Ruta" : "Nueva Ficha Técnica de Ruta")</h1>
        <div class="sire-page-sub">Reemplaza el Excel manual "DATOS_BASE" — 1 fila por sección del proceso (Redina, Secado, Tintorería, etc.)</div>
    </div>
    <div class="sire-page-actions">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Volver al listado
        </a>
    </div>
</div>

@Html.AntiForgeryToken()
<input type="hidden" id="idCab" value="@Model.IdCab" />

<div class="cot-seccion-editable">
    <h6><i class="bi bi-card-heading me-1"></i>Datos de cabecera</h6>
    <div class="row g-2">
        <div class="col-md-4">
            <label class="form-label small">Título ERP (H_TITULOS) *</label>
            <div class="autocomplete-wrap">
                <input type="text" class="form-control form-control-sm" id="tituloCod"
                       value="@Model.TituloCod" placeholder="Busque por código o descripción (Ej: 040, 20/2)" autocomplete="off" />
                <div class="autocomplete-list" id="tituloList"></div>
            </div>
            <small class="text-success cot-campo-help" id="tituloSel">
                @if (!string.IsNullOrEmpty(Model.TituloCod))
                {
                    <text>✓ @Model.TituloDesc</text>
                }
            </small>
            <small class="text-muted cot-campo-help">
                Clave real de emparejamiento con Simular.cshtml. Sin esto la ficha nunca aparecerá como "vigente".
            </small>
        </div>
        <div class="col-md-4">
            <label class="form-label small">Nombre / Ruta descriptiva *</label>
            <input type="text" class="form-control form-control-sm" id="tituloRoute" value="@Model.TituloRoute" placeholder="Ej: 20/2 ATP FLAME" />
            <small class="text-muted cot-campo-help">Etiqueta libre de Preparatoria (título + fibra + acabado). Solo informativa.</small>
        </div>
        <div class="col-md-3">
            <label class="form-label small">Tonalidad *</label>
            <select class="form-select form-select-sm" id="tonalidad">
                <option value="TODOS" selected="@(Model.Tonalidad == "TODOS")">Todos (aplica a cualquier tonalidad)</option>
                <option value="CRUDO" selected="@(Model.Tonalidad == "CRUDO")">Crudo</option>
                <option value="BLANCO" selected="@(Model.Tonalidad == "BLANCO")">Blanco</option>
                <option value="CLARO" selected="@(Model.Tonalidad == "CLARO")">Claro</option>
                <option value="MEDIO" selected="@(Model.Tonalidad == "MEDIO")">Medio</option>
                <option value="OSCURO_INTENSO" selected="@(Model.Tonalidad == "OSCURO_INTENSO")">Oscuro / Intenso</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small">Producto (descripción)</label>
            <input type="text" class="form-control form-control-sm" id="productoDesc" value="@Model.ProductoDesc" />
        </div>
        <div class="col-md-3">
            <label class="form-label small">Cliente referencial</label>
            <input type="text" class="form-control form-control-sm" id="clienteRef" value="@Model.ClienteRef" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">Actualizado</label>
            <input type="date" class="form-control form-control-sm" id="fchActualizado" value="@(Model.FchActualizado?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">Pedido mín. (kg)</label>
            <input type="number" step="0.01" class="form-control form-control-sm" id="pedidoMinKg" value="@Model.PedidoMinKg" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">Pedido máx. (kg)</label>
            <input type="number" step="0.01" class="form-control form-control-sm" id="pedidoMaxKg" value="@Model.PedidoMaxKg" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">Línea alim. (%)</label>
            <input type="text" class="form-control form-control-sm" id="lineaAlimPct" value="@Model.LineaAlimPct" placeholder="Ej: 100/0" />
        </div>
        <div class="col-md-4">
            <label class="form-label small">Línea alim. (descripción)</label>
            <input type="text" class="form-control form-control-sm" id="lineaAlimDesc" value="@Model.LineaAlimDesc" placeholder="Ej: 100% Cinta Peinada cruda ATP" />
        </div>
        <div class="col-md-6">
            <label class="form-label small">Nota pedido mínimo</label>
            <input type="text" class="form-control form-control-sm" id="notaPedidoMin" value="@Model.NotaPedidoMin" />
        </div>
        <div class="col-md-6">
            <label class="form-label small">Nota de partidas / acabados</label>
            <input type="text" class="form-control form-control-sm" id="notaPartida" value="@Model.NotaPartida" />
        </div>
    </div>

    <hr class="my-3" />
    <h6><i class="bi bi-flower1 me-1"></i>Composición de fibra y proceso</h6>
    <div class="row g-2">
        <div class="col-md-1">
            <label class="form-label small">Fibra 1</label>
            <input type="text" maxlength="1" class="form-control form-control-sm text-uppercase" id="fibra1" value="@Model.Fibra1" />
        </div>
        <div class="col-md-1">
            <label class="form-label small">Fibra 2</label>
            <input type="text" maxlength="1" class="form-control form-control-sm text-uppercase" id="fibra2" value="@Model.Fibra2" />
        </div>
        <div class="col-md-1">
            <label class="form-label small">Fibra 3</label>
            <input type="text" maxlength="1" class="form-control form-control-sm text-uppercase" id="fibra3" value="@Model.Fibra3" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">Fr/% (VALPF)</label>
            <input type="text" maxlength="4" class="form-control form-control-sm" id="valpf" value="@Model.Valpf" placeholder="Ej: 05%, 10/77/13" />
            <small class="text-muted cot-campo-help">Mismo código de ITEMPED/COTIZACION_D.VALPF (V_VALPF): un solo valor, no uno por fibra.</small>
        </div>
        <div class="col-md-3">
            <label class="form-label small">Proceso</label>
            <select class="form-select form-select-sm" id="proceso">
                <option value="" selected="@(string.IsNullOrEmpty(Model.Proceso))">(sin especificar)</option>
                <option value="01" selected="@(Model.Proceso == "01")">01 - Cardado</option>
                <option value="20" selected="@(Model.Proceso == "20")">20 - Peinado</option>
                <option value="24" selected="@(Model.Proceso == "24")">24 - Peinado Gaseado</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small">Clase de color</label>
            <select class="form-select form-select-sm" id="claseColor">
                <option value="CRUDO" selected="@(Model.ClaseColor == "CRUDO")">C: Crudo (sin tintorería)</option>
                <option value="CRUDO_HEATHER" selected="@(Model.ClaseColor == "CRUDO_HEATHER")">C: Heather (blend pre-teñido, sin TT posterior)</option>
                <option value="TINTORERIA" selected="@(Model.ClaseColor == "TINTORERIA")">Ct: Con Tintorería</option>
            </select>
        </div>
    </div>
</div>

<div class="sire-card mt-3">
    <div class="sire-card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-table"></i> Detalle por sección</span>
        <button type="button" id="btnAgregarFila" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-plus-lg me-1"></i>Agregar sección
        </button>
    </div>
    <div class="sire-card-body">
        <p class="text-muted small">
            <strong>KG/H Máq</strong>, <strong>KG/H Teórico</strong>, <strong>Ne</strong>, <strong>%Efic</strong>, <strong>Oper</strong> y
            <strong>M/Min</strong> son texto libre: para procesos por lote (Secado, Tintorería) anote la duración del ciclo tal cual
            (Ej. <code>8Hrs</code>, <code>Ciclo de Teñido</code>) en vez de forzar un número — así se preserva exactamente lo que indica Preparatoria.
        </p>
        <div class="table-responsive">
            <table class="sire-table w-100" id="tablaDetalle">
                <thead>
                    <tr>
                        <th style="min-width:160px;">Sección</th>
                        <th style="width:90px;">%Merma</th>
                        <th style="width:80px;">N.H.</th>
                        <th style="width:110px;">KG/H Máq</th>
                        <th style="width:120px;">KG/H Teórico</th>
                        <th style="width:90px;">Ne</th>
                        <th style="width:80px;">%Efic</th>
                        <th style="width:80px;">Oper</th>
                        <th style="width:90px;">M/Min</th>
                        <th>Obs.</th>
                        <th style="width:40px;"></th>
                    </tr>
                </thead>
                <tbody id="tbodyDetalle">
                    @for (int i = 0; i < Model.Detalle.Count; i++)
                    {
                        var d = Model.Detalle[i];
                        <tr>
                            <td><input type="text" class="form-control form-control-sm f-seccion" value="@d.Seccion" /></td>
                            <td><input type="number" step="0.001" class="form-control form-control-sm f-merma" value="@d.PctMerma" /></td>
                            <td><input type="number" class="form-control form-control-sm f-nroh" value="@d.NroH" /></td>
                            <td><input type="text" class="form-control form-control-sm f-kgmaq" value="@d.KgHMaq" /></td>
                            <td><input type="text" class="form-control form-control-sm f-kgteo" value="@d.KgHMaqTeorico" /></td>
                            <td><input type="text" class="form-control form-control-sm f-ne" value="@d.Ne" /></td>
                            <td><input type="text" class="form-control form-control-sm f-efic" value="@d.PctEfic" /></td>
                            <td><input type="text" class="form-control form-control-sm f-oper" value="@d.Oper" /></td>
                            <td><input type="text" class="form-control form-control-sm f-mmin" value="@d.MMin" /></td>
                            <td><input type="text" class="form-control form-control-sm f-obs" value="@d.Obs" /></td>
                            <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger btn-quitar-fila"><i class="bi bi-x"></i></button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="d-flex gap-2 mt-3">
    <button type="button" id="btnGuardarFicha" class="btn btn-success">
        <i class="bi bi-save me-1"></i>Guardar ficha técnica
    </button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</div>

@section Scripts {
    <script>
        const filaTemplate = () => `
            <tr>
                <td><input type="text" class="form-control form-control-sm f-seccion" /></td>
                <td><input type="number" step="0.001" class="form-control form-control-sm f-merma" /></td>
                <td><input type="number" class="form-control form-control-sm f-nroh" /></td>
                <td><input type="text" class="form-control form-control-sm f-kgmaq" /></td>
                <td><input type="text" class="form-control form-control-sm f-kgteo" /></td>
                <td><input type="text" class="form-control form-control-sm f-ne" /></td>
                <td><input type="text" class="form-control form-control-sm f-efic" /></td>
                <td><input type="text" class="form-control form-control-sm f-oper" /></td>
                <td><input type="text" class="form-control form-control-sm f-mmin" /></td>
                <td><input type="text" class="form-control form-control-sm f-obs" /></td>
                <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger btn-quitar-fila"><i class="bi bi-x"></i></button></td>
            </tr>`;

        function wireQuitarFila(tr) {
            tr.querySelector('.btn-quitar-fila').addEventListener('click', () => tr.remove());
        }

        document.querySelectorAll('#tbodyDetalle tr').forEach(wireQuitarFila);

        document.getElementById('btnAgregarFila').addEventListener('click', () => {
            const tbody = document.getElementById('tbodyDetalle');
            const div = document.createElement('tbody');
            div.innerHTML = filaTemplate();
            const tr = div.firstElementChild;
            tbody.appendChild(tr);
            wireQuitarFila(tr);
        });

        function numOrNull(v) { const n = parseFloat(v); return isNaN(n) ? null : n; }
        function intOrNull(v) { const n = parseInt(v); return isNaN(n) ? null : n; }
        function strOrNull(v) { const s = (v ?? '').trim(); return s === '' ? null : s; }
        function escapeHtml(s) {
            return (s ?? '').toString().replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        // === Autocomplete de título (H_TITULOS) — reutiliza el buscador de Cotizacion/Simular.cshtml ===
        function wireAutocomplete(inputId, listId, selId, url, onSelect) {
            const input = document.getElementById(inputId);
            const list = document.getElementById(listId);
            const selEl = document.getElementById(selId);
            let timer = null;

            function cerrar() { list.style.display = 'none'; list.innerHTML = ''; }

            async function buscar(q) {
                try {
                    const resp = await fetch(`${url}?texto=${encodeURIComponent(q)}`);
                    const json = await resp.json();
                    if (!json.ok || !json.data?.length) { cerrar(); return; }
                    const items = json.data.slice(0, 8);
                    list.innerHTML = items.map(item =>
                        `<div class="ac-item" data-codigo="${escapeHtml(item.codigo)}" data-descripcion="${escapeHtml(item.descripcion)}" data-extra="${escapeHtml(item.extra)}">`
                        + `<span class="ac-code">${escapeHtml(item.codigo)}</span>`
                        + `<span class="ac-desc">${escapeHtml(item.descripcion)}</span>`
                        + (item.extra ? `<div class="ac-extra small text-muted">${escapeHtml(item.extra)}</div>` : '')
                        + `</div>`
                    ).join('');
                    list.style.display = 'block';
                    list.querySelectorAll('.ac-item').forEach(el => {
                        el.addEventListener('mousedown', (ev) => {
                            ev.preventDefault();
                            input.value = el.dataset.codigo;
                            if (selEl) {
                                selEl.innerHTML = '✓ ' + escapeHtml(el.dataset.descripcion)
                                    + (el.dataset.extra ? `<div class="small text-muted">${escapeHtml(el.dataset.extra)}</div>` : '');
                            }
                            cerrar();
                            if (onSelect) onSelect(el.dataset);
                        });
                    });
                } catch { cerrar(); }
            }

            input.addEventListener('focus', () => buscar(input.value.trim()));
            input.addEventListener('input', () => {
                clearTimeout(timer);
                timer = setTimeout(() => buscar(input.value.trim()), 300);
            });
            document.addEventListener('click', (ev) => {
                if (!input.contains(ev.target) && !list.contains(ev.target)) cerrar();
            });
        }
        wireAutocomplete('tituloCod', 'tituloList', 'tituloSel', '@Url.Action("BuscarTitulos", "Cotizacion")', (datos) => {
            // Solo autocompleta lo que Preparatoria todavía no llenó a mano — nunca pisa datos ya cargados.
            const tituloRoute = document.getElementById('tituloRoute');
            if (!tituloRoute.value.trim()) tituloRoute.value = `${datos.codigo} ${datos.descripcion}`.trim();
            const productoDesc = document.getElementById('productoDesc');
            if (!productoDesc.value.trim()) productoDesc.value = datos.descripcion;
        });

        function leerFicha() {
            const filas = Array.from(document.querySelectorAll('#tbodyDetalle tr')).map((tr, i) => ({
                orden: i + 1,
                seccion: tr.querySelector('.f-seccion').value.trim(),
                pctMerma: numOrNull(tr.querySelector('.f-merma').value),
                nroH: intOrNull(tr.querySelector('.f-nroh').value),
                kgHMaq: strOrNull(tr.querySelector('.f-kgmaq').value),
                kgHMaqTeorico: strOrNull(tr.querySelector('.f-kgteo').value),
                ne: strOrNull(tr.querySelector('.f-ne').value),
                pctEfic: strOrNull(tr.querySelector('.f-efic').value),
                oper: strOrNull(tr.querySelector('.f-oper').value),
                mMin: strOrNull(tr.querySelector('.f-mmin').value),
                obs: strOrNull(tr.querySelector('.f-obs').value),
            })).filter(f => f.seccion !== '');

            return {
                idCab: parseInt(document.getElementById('idCab').value) || 0,
                tituloCod: document.getElementById('tituloCod').value.trim(),
                tituloRoute: document.getElementById('tituloRoute').value.trim(),
                tonalidad: document.getElementById('tonalidad').value,
                clienteRef: strOrNull(document.getElementById('clienteRef').value),
                productoDesc: strOrNull(document.getElementById('productoDesc').value),
                fchActualizado: document.getElementById('fchActualizado').value || null,
                pedidoMinKg: numOrNull(document.getElementById('pedidoMinKg').value),
                pedidoMaxKg: numOrNull(document.getElementById('pedidoMaxKg').value),
                lineaAlimPct: strOrNull(document.getElementById('lineaAlimPct').value),
                lineaAlimDesc: strOrNull(document.getElementById('lineaAlimDesc').value),
                notaPedidoMin: strOrNull(document.getElementById('notaPedidoMin').value),
                notaPartida: strOrNull(document.getElementById('notaPartida').value),
                fibra1: strOrNull(document.getElementById('fibra1').value)?.toUpperCase() ?? null,
                fibra2: strOrNull(document.getElementById('fibra2').value)?.toUpperCase() ?? null,
                fibra3: strOrNull(document.getElementById('fibra3').value)?.toUpperCase() ?? null,
                valpf: strOrNull(document.getElementById('valpf').value),
                proceso: strOrNull(document.getElementById('proceso').value),
                claseColor: document.getElementById('claseColor').value,
                estado: 'A',
                detalle: filas,
            };
        }

        document.getElementById('btnGuardarFicha').addEventListener('click', async () => {
            const ficha = leerFicha();
            if (!ficha.tituloCod) { AppAlert('Debe seleccionar un título válido buscándolo por código o descripción.', 'Datos incompletos', 'warning'); return; }
            if (!ficha.tituloRoute) { AppAlert('El nombre/ruta descriptiva es obligatorio.', 'Datos incompletos', 'warning'); return; }

            const btn = document.getElementById('btnGuardarFicha');
            btn.disabled = true;
            try {
                const resp = await fetch('@Url.Action("Guardar")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify(ficha)
                });
                const data = await resp.json();
                if (data.ok) {
                    window.location.href = '@Url.Action("Index")';
                } else {
                    AppAlert('Error al guardar: ' + data.error, 'Error', 'danger');
                    btn.disabled = false;
                }
            } catch (e) {
                AppAlert('Error de red al guardar: ' + e, 'Error', 'danger');
                btn.disabled = false;
            }
        });
    </script>
}
