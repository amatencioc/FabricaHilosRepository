// ── Toggle individual de tarjeta ──────────────────────────────────
function toggleGrpCard(event, grpId) {
    if (event.target.closest('a, button')) return;
    const el = document.getElementById(grpId);
    if (el) bootstrap.Collapse.getOrCreateInstance(el).toggle();
}

function collapseAll() {
    document.querySelectorAll('#regGrpContainer .collapse').forEach(el => {
        bootstrap.Collapse.getOrCreateInstance(el).hide();
    });
}

function expandAll() {
    document.querySelectorAll('#regGrpContainer .collapse').forEach(el => {
        bootstrap.Collapse.getOrCreateInstance(el).show();
    });
}


// ── KPIs dinámicos — un único pass sobre la colección ────────────────────────
function updateKpis(items) {
    const peds = new Set();
    let kg = 0, khil = 0, ktnt = 0;
    for (const x of items) {
        peds.add(x.numPed);
        kg += x.cantidad;
        if (x.codServ === 'C' || x.codServ === 'CT') khil += x.cantidad;
        if (x.codServ === 'CT' || x.codServ === 'ST' ||
            x.codServ === 'STD' || x.codServ === 'STR' || x.codServ === 'SRT') ktnt += x.cantidad;
    }
    document.getElementById('kpiPedidos').textContent = peds.size;
    document.getElementById('kpiItems').textContent   = items.length;
    document.getElementById('kpiKg').textContent      = _fmt0.format(Math.round(kg));
    document.getElementById('kpiHil').textContent     = _fmt0.format(Math.round(khil));
    document.getElementById('kpiTint').textContent    = _fmt0.format(Math.round(ktnt));
}

// ── Limpiar / Reset completo ─────────────────────────────────────────────────
function resetForm() {
    document.getElementById('inpDesde').value = '';
    document.getElementById('inpHasta').value = '';
    const ed = document.getElementById('inpEntDesde');
    const eh = document.getElementById('inpEntHasta');
    if (ed) ed.value = '';
    if (eh) eh.value = '';
    // Limpiar filtros client-side instantáneos
    ['selEstado','selServ','selProceso','selFibra','selPaso'].forEach(id => {
        const el = document.getElementById(id); if (el) el.value = '';
    });
    const ci = document.getElementById('inpCliente'); if (ci) ci.value = '';
    filtEstado = ''; filtCliente = ''; filtServ = ''; filtProceso = ''; filtFibra = ''; filtPaso = '';
    document.getElementById('regSearch').value = '';
    document.getElementById('inpGrupo').value  = 'dia';
    searchTerm = '';
    document.querySelectorAll('#groupBtns .btn').forEach(b => { b.classList.remove('btn-primary'); b.classList.add('btn-outline-primary'); });
    const btnDia = document.querySelector('#groupBtns [data-group="dia"]');
    if (btnDia) { btnDia.classList.remove('btn-outline-primary'); btnDia.classList.add('btn-primary'); }
    activeGroup = 'dia';
    document.getElementById('btnCollapseAll').style.display = '';
    document.getElementById('btnExpandAll').style.display   = '';
    document.getElementById('regLoadingOverlay').style.display = '';
    document.getElementById('regForm').submit();
}

// ── Atajos de rango ────────────────────────────────────────────────────
function toLocalDate(d) {
    // Formatea yyyy-MM-dd en hora LOCAL, sin conversión UTC
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const dd = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${dd}`;
}
function setRango(dias) {
    const hoy   = new Date();
    const desde = dias === 0
        ? new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate())      // inicio del día hoy
        : new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate() - dias);
    document.getElementById('inpDesde').value = toLocalDate(desde);
    document.getElementById('inpHasta').value = toLocalDate(new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate()));
    document.getElementById('regLoadingOverlay').style.display = '';
    document.getElementById('regForm').submit();
}

// ── Export CSV ─────────────────────────────────────────────────────────
function exportCSV() {
    const items = sortItems(filterItems(ALL_ITEMS));
    const header = ['NumPed','Serie','FchPedido','Cliente','NroItem','CodArt','Articulo',
        'TFibra','DescFibra','Titulo','Proceso','Servicio','Area',
        'NroRmc','Rmc','DescRmc','Lote','KgPedido','Precio','KgPendiente',
        'Color','Intensidad','Presentacion','Familia','Linea',
        'FEntregaPLN','FEntregaHC','FMaxPed','Retraso','DiasRetraso','Urgente',
        'EstadoPed','EstadoPLN','CodPLN','FAprobacion','Observacion'];
    const rows   = items.map(r => [
        r.numPed, r.serie, r.fchPedidoDisp, r.nombreCliente, r.nro,
        r.codArt, r.descArt,
        r.tipoFibra, r.descFibra, r.titulo, r.nombreProceso,
        r.codServ, r.areaServicio,
        r.nroRmc || '', r.rmc, r.descRmc, r.lote,
        r.cantidad.toFixed(2), r.precio.toFixed(4), r.kgPendientes.toFixed(2),
        r.color, r.intensidadAbrev || r.intensidad, r.presentacion,
        r.descFamilia, r.descLinea,
        r.fchEntregaComp, r.fhcEntrega, r.fMaxPed,
        r.indRetraso, r.diasRetraso,
        (r.indUrgente === 'S' || r.urgente === 'S') ? 'S' : 'N',
        r.estadoPed, r.pasoActual, r.codPasoAct,
        r.fchAprobacion, r.detalle
    ].map(v => `"${(v??'').toString().replace(/"/g,'""')}"`).join(','));
    const csv = [header.join(','), ...rows].join('\r\n');
    const link = document.createElement('a');
    link.href = URL.createObjectURL(new Blob(['\ufeff'+csv], { type:'text/csv;charset=utf-8;' }));
    link.download = `registro_pedidos_${new Date().toISOString().slice(0,10)}.csv`;
    link.click();
}

// ── Ordenamiento por columna ───────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
    // Columnas sortables
    document.querySelectorAll('#regTable thead th[data-sort]').forEach(th => {
        th.addEventListener('click', () => {
            const f = th.dataset.sort;
            if (sortField === f) sortAsc = !sortAsc;
            else { sortField = f; sortAsc = true; }
            document.querySelectorAll('.sort-icon').forEach(ic => ic.textContent = '⇅');
            th.querySelector('.sort-icon').textContent = sortAsc ? '↑' : '↓';
            render();
        });
    });

    // Agrupamiento
    document.querySelectorAll('#groupBtns .btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('#groupBtns .btn').forEach(b => { b.classList.remove('btn-primary'); b.classList.add('btn-outline-primary'); });
            btn.classList.remove('btn-outline-primary'); btn.classList.add('btn-primary');
            activeGroup = btn.dataset.group;
            document.getElementById('inpGrupo').value = activeGroup;
            // Ocultar botones colapsar/expandir en modo Plano
            const showCollapseCtrl = activeGroup !== 'none';
            document.getElementById('btnCollapseAll').style.display = showCollapseCtrl ? '' : 'none';
            document.getElementById('btnExpandAll').style.display   = showCollapseCtrl ? '' : 'none';
            render();
        });
    });

    // Búsqueda live con debounce (200 ms) — evita render por cada tecla
    let _searchTimer = 0;
    document.getElementById('regSearch').addEventListener('input', e => {
        clearTimeout(_searchTimer);
        _searchTimer = setTimeout(() => {
            searchTerm = e.target.value.trim();
            render();
        }, 200);
    });

    // Filtros instantáneos — selects y Cliente
    document.getElementById('selEstado') ?.addEventListener('change', e => { filtEstado  = e.target.value; render(); });
    document.getElementById('selServ')   ?.addEventListener('change', e => { filtServ    = e.target.value; render(); });
    document.getElementById('selProceso')?.addEventListener('change', e => { filtProceso = e.target.value; render(); });
    document.getElementById('selFibra')  ?.addEventListener('change', e => { filtFibra   = e.target.value; render(); });
    document.getElementById('selPaso')   ?.addEventListener('change', e => { filtPaso    = e.target.value; render(); });
    let _clienteTimer = 0;
    document.getElementById('inpCliente')?.addEventListener('input', e => {
        clearTimeout(_clienteTimer);
        _clienteTimer = setTimeout(() => { filtCliente = e.target.value.trim(); render(); }, 250);
    });

    // Toggle de columnas
    document.querySelectorAll('.col-chk').forEach(chk => {
        chk.addEventListener('change', applyColVisibility);
    });

    // Restaurar estado de agrupamiento ANTES del primer render (evita doble render)
    const savedGroup = document.getElementById('inpGrupo')?.value || 'dia';
    if (savedGroup !== 'dia') {
        activeGroup = savedGroup;
        document.querySelectorAll('#groupBtns .btn').forEach(b => {
            const isActive = b.dataset.group === activeGroup;
            b.classList.toggle('btn-primary', isActive);
            b.classList.toggle('btn-outline-primary', !isActive);
        });
        const showCollapseCtrl = activeGroup !== 'none';
        document.getElementById('btnCollapseAll').style.display = showCollapseCtrl ? '' : 'none';
        document.getElementById('btnExpandAll').style.display   = showCollapseCtrl ? '' : 'none';
    }

    // Render único inicial
    render();
});
</script>
}

