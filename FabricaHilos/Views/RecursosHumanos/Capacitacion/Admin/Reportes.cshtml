}

// ── La pestaña "Jefaturas" no usa los filtros de Curso/Categoría/Área/Centro de Costo/
// Supervisor (usa CAP_V_HEADCOUNT_JEFATURA, independiente de esos filtros) — se oculta
// la card de filtros al abrir esa pestaña y se restaura al volver a Detalle/Análisis.
// El "Panel interactivo" tampoco usa estos filtros: trabaja siempre sobre dataReporte
// (ya filtrado en servidor por el estado actual de la URL), por lo que la card se oculta
// igual que en Jefaturas para no confundir al usuario.
const filtrosCard      = document.getElementById('filtrosPrincipales');
const tabJefaturasBtn  = document.getElementById('tab-jefaturas-btn');
const tabDetalleBtn2   = document.getElementById('tab-detalle-btn');
const tabPanelBtn2     = document.getElementById('tab-panel-btn');
const tabAnalisisBtn2  = document.getElementById('tab-analisis-btn');
const tabRankingsBtn2  = document.getElementById('tab-rankings-btn');
function toggleFiltrosPrincipales(ocultar) {
    if (filtrosCard) filtrosCard.style.display = ocultar ? 'none' : '';
}
tabJefaturasBtn?.addEventListener('shown.bs.tab', () => toggleFiltrosPrincipales(true));
tabPanelBtn2?.addEventListener('shown.bs.tab',    () => toggleFiltrosPrincipales(true));
tabRankingsBtn2?.addEventListener('shown.bs.tab', () => toggleFiltrosPrincipales(true));
tabDetalleBtn2?.addEventListener('shown.bs.tab',  () => toggleFiltrosPrincipales(false));
tabAnalisisBtn2?.addEventListener('shown.bs.tab', () => toggleFiltrosPrincipales(false));

// ── Análisis por estructura organizacional: árbol Gran Centro de Costo → Centro de
// Costo → Curso → Colaborador (Código, Nombre, Cargo) ──────────────────────────────
let analisisState = {
  filterText: '',       // búsqueda en cualquier campo: área, centro, curso, código, nombre, cargo
  expandedAreas: {},    // {area: true/false}
  expandedCentros: {}   // {"area||centro": true/false}
};

function buildAnalisisEstructura() {
  const cont = document.getElementById('analisisEstructura');
  if (!cont || !dataReporte.length) return;

  const q = (analisisState.filterText || '').trim().toLowerCase();
  const filas = !q ? dataReporte : dataReporte.filter(r =>
    [r.area, r.centroCosto, r.curso, r.codigo, r.persona, r.cargo].some(v => (v || '').toString().toLowerCase().includes(q)));

  let html = `
    <div class="mb-3 d-flex gap-2 align-items-center flex-wrap">
      <input type="text" id="analisisFiltro" class="form-control form-control-sm"
             placeholder="Buscar por Gran Centro de Costo, Centro, Curso, Código, Nombre, Cargo..."
             style="max-width:340px;font-size:.82rem" value="${analisisState.filterText}">
      <small class="text-muted">${filas.length} inscripción(es)</small>
    </div>
  `;

  if (!filas.length) {
    html += `<div class="text-center text-muted small py-4">Sin resultados${q ? ` para "${analisisState.filterText}"` : ''}.</div>`;
    cont.innerHTML = html;
    const fi = cont.querySelector('#analisisFiltro');
    if (fi) fi.addEventListener('input', function () { analisisState.filterText = this.value; buildAnalisisEstructura(); });
    return;
  }

  // Agrupar: Gran Centro de Costo → Centro de Costo → Curso → lista de colaboradores
  const estructura = {};
  filas.forEach(r => {
    (estructura[r.area] ??= {});
    (estructura[r.area][r.centroCosto] ??= {});
    (estructura[r.area][r.centroCosto][r.curso] ??= []).push(r);
  });

  const calcStats = rows => {
    const total = rows.length;
    const completados = rows.filter(r => r.estado === 'C').length;
    // % de avance promedio (mismo criterio que la columna "Progreso" de la pestaña Detalle),
    // para que ambas vistas muestren cifras coherentes sobre el mismo colaborador/curso.
    const avgProgreso = total > 0 ? Math.round(rows.reduce((sum, r) => sum + (r.progreso || 0), 0) / total) : 0;
    return { total, completados, pct: avgProgreso };
  };

  html += '<div class="table-responsive"><table class="table table-sm tbl-lms mb-0" style="font-size:.82rem"><thead>';
  html += `<tr style="background:#f1f5f9;font-weight:600;font-size:.8rem">
    <th>Gran Centro de Costo / Centro de Costo / Curso / Colaborador</th>
    <th>Código</th><th>Cargo</th>
    <th class="text-end">Total</th>
    <th class="text-end">% Comp.</th>
  </tr></thead><tbody>`;

  Object.keys(estructura).sort().forEach(area => {
    const centros = estructura[area];
    const areaRows = filas.filter(r => r.area === area);
    const aStat = calcStats(areaRows);
    const areaExpanded = analisisState.expandedAreas[area] !== false;

    html += `
      <tr class="area-header" data-area="${area}" style="background:#e0f2fe;cursor:pointer">
        <td colspan="3" style="font-weight:700;padding:.5rem .75rem">
          <i class="bi bi-chevron-${areaExpanded ? 'down' : 'right'}" style="margin-right:.5rem"></i>
          <strong>${area}</strong> <span style="color:#64748b;font-size:.8rem">(${aStat.total} inscritos)</span>
        </td>
        <td class="text-end" style="font-weight:600">${aStat.total}</td>
        <td class="text-end"><span style="background:#dbeafe;padding:.2rem .4rem;border-radius:3px;font-weight:600">${aStat.pct}%</span></td>
      </tr>`;

    Object.keys(centros).sort().forEach(centro => {
      const centroKey = `${area}||${centro}`;
      const cursos = centros[centro];
      const centroRows = areaRows.filter(r => r.centroCosto === centro);
      const cStat = calcStats(centroRows);
      const centroExpanded = analisisState.expandedCentros[centroKey] !== false;

      html += `
        <tr class="centro-header" data-area="${area}" data-centro="${centroKey}" style="display:${areaExpanded ? '' : 'none'};background:#f0f9ff;cursor:pointer">
          <td colspan="3" style="padding:.45rem .75rem .45rem 2rem">
            <i class="bi bi-chevron-${centroExpanded ? 'down' : 'right'}" style="margin-right:.5rem"></i>
            ${centro}
          </td>
          <td class="text-end">${cStat.total}</td>
          <td class="text-end">${cStat.pct}%</td>
        </tr>`;

      const rowsVisible = areaExpanded && centroExpanded;

      Object.keys(cursos).sort().forEach(curso => {
        const inscritos = cursos[curso];
        const kStat = calcStats(inscritos);

        html += `
          <tr class="curso-row" data-area="${area}" data-centro="${centroKey}" style="display:${rowsVisible ? '' : 'none'};background:#f8fafc">
            <td colspan="3" style="padding-left:3.25rem;color:#334155;font-weight:600">
              <i class="bi bi-journal-text me-1" style="color:#0891b2"></i>${curso}
            </td>
            <td class="text-end">${kStat.total}</td>
            <td class="text-end"><span style="background:${kStat.pct >= 75 ? '#dcfce7' : kStat.pct >= 50 ? '#fef3c7' : '#fee2e2'};padding:.2rem .4rem;border-radius:3px;font-weight:600">${kStat.pct}%</span></td>
          </tr>`;

        [...inscritos].sort((a, b) => a.persona.localeCompare(b.persona)).forEach(r => {
          const rProg = r.progreso || 0;
          html += `
            <tr class="persona-row" data-area="${area}" data-centro="${centroKey}" style="display:${rowsVisible ? '' : 'none'}">
              <td style="padding-left:4.5rem;color:#0f172a">${r.persona}</td>
              <td style="color:#64748b">${r.codigo}</td>
              <td style="color:#64748b">${r.cargo}</td>
              <td class="text-end">1</td>
              <td class="text-end"><span style="background:${rProg >= 75 ? '#dcfce7' : rProg >= 50 ? '#fef3c7' : '#fee2e2'};padding:.2rem .4rem;border-radius:3px;font-weight:600">${rProg}%</span></td>
            </tr>`;
        });
      });
    });
  });

  html += '</tbody></table></div>';
  cont.innerHTML = html;

  // Eventos: filtro de búsqueda
  const filtroInput = cont.querySelector('#analisisFiltro');
  if (filtroInput) {
    filtroInput.addEventListener('input', function () {
      analisisState.filterText = this.value;
      buildAnalisisEstructura();
    });
  }

  // Eventos: expand/collapse por Gran Centro de Costo
  cont.querySelectorAll('.area-header').forEach(tr => {
    tr.addEventListener('click', function () {
      const area = this.dataset.area;
      analisisState.expandedAreas[area] = !(analisisState.expandedAreas[area] !== false);
      buildAnalisisEstructura();
    });
  });

  // Eventos: expand/collapse por Centro de Costo
  cont.querySelectorAll('.centro-header').forEach(tr => {
    tr.addEventListener('click', function (e) {
      e.stopPropagation();
      const key = this.dataset.centro;
      analisisState.expandedCentros[key] = !(analisisState.expandedCentros[key] !== false);
      buildAnalisisEstructura();
    });
  });
}

// ── Organigrama de Jefaturas ─────────────────────────────────────────
// Centro de Costo → Trabajador (antes eran 2 secciones separadas con la misma data:
// un árbol de conteos y una tabla aparte por tabs de Centro de Costo — se unifican
// aquí en un solo componente jerárquico, con una sola búsqueda que filtra en
// cualquier nivel: jefatura, área, centro de costo, trabajador, DNI o cargo).
const dataHeadcount = @Json.Serialize((ViewBag.HeadcountJefaturas as List<FabricaHilos.Models.Capacitacion.CapHeadcountDetalle> ?? new()).Select(d => new {
    jefatura     = string.IsNullOrEmpty(d.NombreJefatura) ? "Sin jefatura asignada" : d.NombreJefatura,
    codJefatura  = d.CodJefatura ?? "—",
    codUsuarioJefe = d.CodUsuarioJefe ?? "—",
    area         = string.IsNullOrEmpty(d.DescArea) ? "Sin gran centro de costo" : d.DescArea,
    ccosto       = string.IsNullOrEmpty(d.DescCcosto) ? "Sin centro de costo" : d.DescCcosto,
    nombre       = d.NombreTrabajador,
    codigo       = d.CCodigo,
    codUsuario   = d.CodUsuario ?? "—",
    dni          = d.DocId ?? "—",
    cargo        = d.DescCargo ?? "—",
    fchIngreso   = d.FchIngreso?.ToString("dd/MM/yyyy") ?? "—",
    sexo         = d.Sexo ?? "—",
    fchNacimiento = d.FchNacimiento?.ToString("dd/MM/yyyy") ?? "—",
    estadoCivil  = d.EstadoCivil ?? "—",
    nivelEducativo = d.NivelEducativo ?? "—",
    afp          = d.Afp ?? "—"
}));

function buildOrganigramaJefaturas(filtro) {
  const q = (filtro || '').trim().toLowerCase();
  const filas = !q ? dataHeadcount : dataHeadcount.filter(r =>
    [r.jefatura, r.area, r.ccosto, r.nombre, r.codigo, r.codUsuario, r.dni, r.cargo].some(v => (v || '').toLowerCase().includes(q)));

  const cont = document.getElementById('pivotJefaturas');
  if (!filas.length) {
    cont.innerHTML = '<div class="text-center text-muted small py-4">Sin resultados' + (q ? ` para "${filtro}"` : '') + '.</div>';
    return;
  }

  const porJefatura = {};
  filas.forEach(r => {
    porJefatura[r.jefatura] ??= {};
    porJefatura[r.jefatura][r.area] ??= {};
    (porJefatura[r.jefatura][r.area][r.ccosto] ??= []).push(r);
  });

  const jefaturas = Object.keys(porJefatura).sort((a, b) =>
    a === 'Sin jefatura asignada' ? 1 : (b === 'Sin jefatura asignada' ? -1 : a.localeCompare(b)));

  let html = '';
  jefaturas.forEach((jef, idx) => {
    const areas = porJefatura[jef];
    const codJef = filas.find(r => r.jefatura === jef)?.codJefatura;
    const codUsrJef = filas.find(r => r.jefatura === jef)?.codUsuarioJefe;
    let totalJef = 0;
    let filasHtml = '';
    Object.keys(areas).sort().forEach(area => {
      const ccostos = areas[area];
      let totalArea = 0;
      let filasCc = '';
      Object.keys(ccostos).sort().forEach(cc => {
        const trabajadores = [...ccostos[cc]].sort((a, b) => a.nombre.localeCompare(b.nombre));
        totalArea += trabajadores.length;
        filasCc += `<tr class="ccosto-row"><td colspan="10">${cc}</td><td class="text-end">${trabajadores.length}</td></tr>`;
        trabajadores.forEach(t => {
          filasCc += `<tr class="worker-row">
            <td style="padding-left:2.5rem">${t.nombre}</td>
            <td>${t.codigo}</td>
            <td style="color:#94a3b8;font-size:.72rem">${t.codUsuario}</td>
            <td>${t.dni}</td>
            <td>${t.cargo}</td>
            <td>${t.fchIngreso}</td>
            <td>${t.sexo}</td>
            <td>${t.fchNacimiento}</td>
            <td>${t.estadoCivil}</td>
            <td>${t.nivelEducativo}</td>
            <td>${t.afp}</td>
            <td></td>
          </tr>`;
        });
      });
      totalJef += totalArea;
      filasHtml += `<tr class="area-row"><td colspan="10">${area}</td><td colspan="1"></td><td class="text-end">${totalArea}</td></tr>${filasCc}`;
    });

    const collapseId  = 'jef' + idx;
    const badgeColor  = jef === 'Sin jefatura asignada' ? '#9f1239' : '#1d4ed8';
    const badgeBg     = jef === 'Sin jefatura asignada' ? '#fff1f2' : '#eff6ff';
    const expandido   = q ? 'show' : '';
    const chevronDir  = q ? 'bi-chevron-down' : 'bi-chevron-right';
    const codJefTxt   = (codJef && jef !== 'Sin jefatura asignada') ? ` <span style="font-weight:400;color:#94a3b8;font-size:.72rem">(${codJef} · ${codUsrJef || '-'})</span>` : '';
    html += `
      <div class="mb-2">
        <div class="jef-header" data-bs-toggle="collapse" data-bs-target="#${collapseId}" aria-expanded="${q ? 'true' : 'false'}">
          <i class="bi ${chevronDir} me-2" style="color:#94a3b8"></i>
          <span style="font-size:.85rem;font-weight:700;color:${badgeColor}">${jef}</span>${codJefTxt}
          <span class="bdg ms-2" style="background:${badgeBg};color:${badgeColor}">${totalJef} trabajador(es)</span>
        </div>
        <div class="collapse ${expandido} jef-body" id="${collapseId}">
          <div class="table-responsive">
          <table class="table tbl-lms mb-0">
            <thead><tr>
              <th>Gran Centro de Costo / Centro de Costo / Trabajador</th>
              <th>Código</th><th>Usuario</th><th>DNI</th><th>Cargo</th>
              <th>F. Ingreso</th><th>Sexo</th><th>F. Nacimiento</th>
              <th>Estado Civil</th><th>Niv. Educativo</th><th>AFP</th>
              <th class="text-end">Cant.</th>
            </tr></thead>
            <tbody>${filasHtml}</tbody>
          </table>
          </div>
        </div>
      </div>`;
  });

  cont.innerHTML = html;
}

const inpH = document.getElementById('searchHeadcount');
if (inpH) {
    inpH.addEventListener('input', function () { buildOrganigramaJefaturas(this.value); });
}

buildOrganigramaJefaturas('');
</script>
}



