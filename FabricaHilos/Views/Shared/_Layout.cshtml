@using FabricaHilos.Services
@inject IMenuService MenuService
@inject IRedInternaService RedInternaSvc
@inject IEmpresaTemaService EmpresaTemaService
@{ 
    var menus = MenuService.GetMenusFiltradosPorRed(RedInternaSvc.EsAccesoExterno, RedInternaSvc.RutasExternasPermitidas);
    var tema  = EmpresaTemaService.GetTemaActual();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @tema.TituloSistema</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/flatpickr/dist/flatpickr.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/@tema.VariablesCssPath" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <nav id="sidebar" class="bg-corporate text-white">
            <div class="sidebar-header p-3 border-bottom border-secondary">
                <div class="d-flex align-items-center gap-2">
                    <img src="~/@tema.LogoIconPath" alt="@tema.LogoAlt" style="height: 38px; width: auto; flex-shrink: 0;" />
                    <div>
                        <div class="fw-bold">@tema.NombreCorto</div>
                        <small class="text-light opacity-75">@tema.NombreCompleto</small>
                    </div>
                </div>
            </div>
            @{
                var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
                var act  = ViewContext.RouteData.Values["action"]?.ToString();
            }
            <ul class="list-unstyled p-2 sidebar-menu">
                <!-- Dashboard -->
                @if (menus.Dashboard)
                {
                <li>
                    <a asp-controller="Home" asp-action="Index" class="sidebar-link @(ctrl == "Home" ? "active" : "")">
                        <i class="bi bi-grid-1x2-fill"></i> Inicio
                    </a>
                </li>
                }

                @if (menus.Produccion)
                {
                <li class="sidebar-section">OPERACIONES</li>
                }
                @if (menus.Produccion)
                {
                <li>
                    <a asp-controller="Produccion" asp-action="Index" class="sidebar-link @(ctrl == "Produccion" || ctrl == "RegistroPreparatoria" || ctrl == "Autoconer" || ctrl == "Planeamiento" ? "active" : "")">
                        <i class="bi bi-gear-wide-connected"></i> Producción
                    </a>
                    <ul class="list-unstyled ps-3">
                        @if (menus.ProduccionRegistroPreparatoria)
                        {
                        <li>
                            <a asp-controller="RegistroPreparatoria" asp-action="Index" class="sidebar-link sidebar-sublink @(ctrl == "RegistroPreparatoria" ? "active" : "")">
                                <i class="bi bi-clipboard-data"></i> Registro de Preparatoria
                            </a>
                        </li>
                        }
                        @if (menus.ProduccionAutoconer)
                        {
                        <li>
                            <a class="sidebar-link sidebar-sublink @(ctrl == "Autoconer" ? "active" : "")" data-bs-toggle="collapse" href="#submenuAutoconer" role="button" aria-expanded="@(ctrl == "Autoconer" ? "true" : "false")" aria-controls="submenuAutoconer">
                                <i class="bi bi-speedometer2"></i> Control Autoconer
                            </a>
                            <ul class="collapse @(ctrl == "Autoconer" ? "show" : "") list-unstyled ps-3" id="submenuAutoconer">
                                @if (menus.ProduccionAutoconerPorPartida)
                                {
                                <li>
                                    <a asp-controller="Autoconer" asp-action="Index" class="sidebar-link sidebar-sublink @(ctrl == "Autoconer" && (act == "Index" || act == "Crear" || act == "Editar" || act == "Detalle") ? "active" : "")">
                                        <i class="bi bi-folder"></i> por Partida
                                    </a>
                                </li>
                                }
                                @if (menus.ProduccionAutoconerPorCanillas)
                                {
                                <li>
                                    <a asp-controller="Autoconer" asp-action="PorCanillas" class="sidebar-link sidebar-sublink @(ctrl == "Autoconer" && act == "PorCanillas" ? "active" : "")">
                                        <i class="bi bi-list-columns"></i> por Canillas
                                    </a>
                                </li>
                                }
                            </ul>
                        </li>
                        }
                        @if (menus.Planeamiento)
                        {
                        <li>
                            <a class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" ? "active" : "")" data-bs-toggle="collapse" href="#submenuPlaneamiento" role="button" aria-expanded="@(ctrl == "Planeamiento" ? "true" : "false")" aria-controls="submenuPlaneamiento">
                                <i class="bi bi-kanban"></i> Planeamiento
                            </a>
                            <ul class="collapse @(ctrl == "Planeamiento" ? "show" : "") list-unstyled ps-3" id="submenuPlaneamiento">
                                @if (menus.PlaneamientoDashboard)
                                {
                                <li>
                                    <a asp-controller="Planeamiento" asp-action="Dashboard" class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" && act == "Dashboard" ? "active" : "")">
                                        <i class="bi bi-kanban"></i> Seguimiento de Pedidos
                                    </a>
                                </li>
                                }
                                @if (menus.PlaneamientoRegistroPedidos)
                                {
                                <li>
                                    <a asp-controller="Planeamiento" asp-action="RegistroPedido" class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" && act == "RegistroPedido" ? "active" : "")">
                                        <i class="bi bi-journal-text"></i> Registro de Pedidos
                                    </a>
                                </li>
                                }
                                @if (menus.PlaneamientoSeguimientoTintoreria)
                                {
                                <li>
                                    <a asp-controller="Planeamiento" asp-action="SeguimientoTintoreria" class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" && act == "SeguimientoTintoreria" ? "active" : "")">
                                        <i class="bi bi-table"></i> Seg. Programación Tintorería
                                    </a>
                                </li>
                                }
                                @if (menus.PlaneamientoProximosVencer)
                                {
                                <li>
                                    <a asp-controller="Planeamiento" asp-action="ProximosVencer" class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" && act == "ProximosVencer" ? "active" : "")">
                                        <i class="bi bi-calendar-event-fill"></i> Próximos a Vencer
                                    </a>
                                </li>
                                }
                                @if (menus.PlaneamientoPendTenido)
                                {
                                <li>
                                    <a asp-controller="Planeamiento" asp-action="PendientesTenido" class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" && act == "PendientesTenido" ? "active" : "")">
                                        <i class="bi bi-droplet-half"></i> Pend. Teñido
                                    </a>
                                </li>
                                }
                                @if (menus.PlaneamientoPendSecado)
                                {
                                <li>
                                    <a asp-controller="Planeamiento" asp-action="PendientesSecado" class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" && act == "PendientesSecado" ? "active" : "")">
                                        <i class="bi bi-thermometer-half"></i> Pend. Secado
                                    </a>
                                </li>
                                }
                                @if (menus.PlaneamientoPendMadeja)
                                {
                                <li>
                                    <a asp-controller="Planeamiento" asp-action="PendientesMadeja" class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" && act == "PendientesMadeja" ? "active" : "")">
                                        <i class="bi bi-wind"></i> Pend. Acab. Madeja
                                    </a>
                                </li>
                                }
                                @if (menus.PlaneamientoPendEvalCalidad)
                                {
                                <li>
                                    <a asp-controller="Planeamiento" asp-action="PendientesEvalCalidad" class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" && act == "PendientesEvalCalidad" ? "active" : "")">
                                        <i class="bi bi-patch-check"></i> Eval. Calidad
                                    </a>
                                </li>
                                }
                                @if (menus.PlaneamientoPendEnconado)
                                {
                                <li>
                                    <a asp-controller="Planeamiento" asp-action="PendientesEnconado" class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" && act == "PendientesEnconado" ? "active" : "")">
                                        <i class="bi bi-arrow-repeat"></i> Pend. Enconado
                                    </a>
                                </li>
                                }
                                @if (menus.PlaneamientoPendRevisado)
                                {
                                <li>
                                    <a asp-controller="Planeamiento" asp-action="PendientesRevisado" class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" && act == "PendientesRevisado" ? "active" : "")">
                                        <i class="bi bi-clipboard2-check"></i> Pend. Revisado
                                    </a>
                                </li>
                                }
                                @if (menus.PlaneamientoPendientesDespacho)
                                {
                                <li>
                                    <a asp-controller="Planeamiento" asp-action="PendientesDespacho" class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" && act == "PendientesDespacho" ? "active" : "")">
                                        <i class="bi bi-truck"></i> Pendientes de Despacho
                                    </a>
                                </li>
                                }
                                @if (menus.PlaneamientoCargaMaquinas)
                                {
                                <li>
                                    <a asp-controller="Planeamiento" asp-action="CargaMaquinas" class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" && act == "CargaMaquinas" ? "active" : "")">
                                        <i class="bi bi-gear-wide-connected"></i> Carga de Máquinas
                                    </a>
                                </li>
                                }
                                @if (menus.PlaneamientoAlertas)
                                {
                                <li>
                                    <a asp-controller="Planeamiento" asp-action="Alertas" class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" && act == "Alertas" ? "active" : "")">
                                        <i class="bi bi-bell"></i> Alertas
                                    </a>
                                </li>
                                }
                            </ul>
                        </li>
                        }
                    </ul>
                </li>
                }
                @* ── Planeamiento standalone: solo para usuarios SIN token Produccion ─────── *@
                @if (!menus.Produccion && menus.Planeamiento)
                {
                <li class="sidebar-section">PLANEAMIENTO</li>
                <li>
                    <a class="sidebar-link @(ctrl == "Planeamiento" ? "active" : "")" data-bs-toggle="collapse" href="#submenuPlaneamiento" role="button" aria-expanded="@(ctrl == "Planeamiento" ? "true" : "false")" aria-controls="submenuPlaneamiento">
                        <i class="bi bi-kanban"></i> Planeamiento
                    </a>
                    <ul class="collapse @(ctrl == "Planeamiento" ? "show" : "") list-unstyled ps-3" id="submenuPlaneamiento">
                        @if (menus.PlaneamientoDashboard)
                        {
                        <li>
                            <a asp-controller="Planeamiento" asp-action="Dashboard" class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" && act == "Dashboard" ? "active" : "")">
                                <i class="bi bi-kanban"></i> Seguimiento de Pedidos
                            </a>
                        </li>
                        }
                        @if (menus.PlaneamientoSeguimientoTintoreria)
                        {
                        <li>
                            <a asp-controller="Planeamiento" asp-action="SeguimientoTintoreria" class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" && act == "SeguimientoTintoreria" ? "active" : "")">
                                <i class="bi bi-table"></i> Seg. Programación Tintorería
                            </a>
                        </li>
                        }
                        @if (menus.PlaneamientoProximosVencer)
                        {
                        <li>
                            <a asp-controller="Planeamiento" asp-action="ProximosVencer" class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" && act == "ProximosVencer" ? "active" : "")">
                                <i class="bi bi-calendar-event-fill"></i> Próximos a Vencer
                            </a>
                        </li>
                        }
                        @if (menus.PlaneamientoPendTenido)
                        {
                        <li>
                            <a asp-controller="Planeamiento" asp-action="PendientesTenido" class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" && act == "PendientesTenido" ? "active" : "")">
                                <i class="bi bi-droplet-half"></i> Pend. Teñido
                            </a>
                        </li>
                        }
                        @if (menus.PlaneamientoPendSecado)
                        {
                        <li>
                            <a asp-controller="Planeamiento" asp-action="PendientesSecado" class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" && act == "PendientesSecado" ? "active" : "")">
                                <i class="bi bi-thermometer-half"></i> Pend. Secado
                            </a>
                        </li>
                        }
                        @if (menus.PlaneamientoPendMadeja)
                        {
                        <li>
                            <a asp-controller="Planeamiento" asp-action="PendientesMadeja" class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" && act == "PendientesMadeja" ? "active" : "")">
                                <i class="bi bi-wind"></i> Pend. Acab. Madeja
                            </a>
                        </li>
                        }
                        @if (menus.PlaneamientoPendEvalCalidad)
                        {
                        <li>
                            <a asp-controller="Planeamiento" asp-action="PendientesEvalCalidad" class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" && act == "PendientesEvalCalidad" ? "active" : "")">
                                <i class="bi bi-patch-check"></i> Eval. Calidad
                            </a>
                        </li>
                        }
                        @if (menus.PlaneamientoPendEnconado)
                        {
                        <li>
                            <a asp-controller="Planeamiento" asp-action="PendientesEnconado" class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" && act == "PendientesEnconado" ? "active" : "")">
                                <i class="bi bi-arrow-repeat"></i> Pend. Enconado
                            </a>
                        </li>
                        }
                        @if (menus.PlaneamientoPendRevisado)
                        {
                        <li>
                            <a asp-controller="Planeamiento" asp-action="PendientesRevisado" class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" && act == "PendientesRevisado" ? "active" : "")">
                                <i class="bi bi-clipboard2-check"></i> Pend. Revisado
                            </a>
                        </li>
                        }
                        @if (menus.PlaneamientoPendientesDespacho)
                        {
                        <li>
                            <a asp-controller="Planeamiento" asp-action="PendientesDespacho" class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" && act == "PendientesDespacho" ? "active" : "")">
                                <i class="bi bi-truck"></i> Pendientes de Despacho
                            </a>
                        </li>
                        }
                        @if (menus.PlaneamientoCargaMaquinas)
                        {
                        <li>
                            <a asp-controller="Planeamiento" asp-action="CargaMaquinas" class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" && act == "CargaMaquinas" ? "active" : "")">
                                <i class="bi bi-gear-wide-connected"></i> Carga de Máquinas
                            </a>
                        </li>
                        }
                        @if (menus.PlaneamientoAlertas)
                        {
                        <li>
                            <a asp-controller="Planeamiento" asp-action="Alertas" class="sidebar-link sidebar-sublink @(ctrl == "Planeamiento" && act == "Alertas" ? "active" : "")">
                                <i class="bi bi-bell"></i> Alertas
                            </a>
                        </li>
                        }
                    </ul>
                </li>
                }
                @if (menus.Sgc)
                {
                <li class="sidebar-section">GESTIÓN DE CALIDAD</li>
                <li>
                    <a asp-controller="Sgc" asp-action="Index" class="sidebar-link @(ctrl == "Sgc" || ctrl == "RelacionFacCli" || ctrl == "CargaTc" || ctrl == "AnalisisReclamo" ? "active" : "")">
                        <i class="bi bi-file-earmark-text"></i> SGC
                    </a>
                    <ul class="list-unstyled ps-3">
                        @if (menus.SgcPedidos)
                        {
                        <li>
                            <a asp-controller="Sgc" asp-action="Pedidos" class="sidebar-link sidebar-sublink @(ctrl == "Sgc" && act == "Pedidos" ? "active" : "")">
                                <i class="bi bi-cart-check"></i> Pedidos
                            </a>
                        </li>
                        }
                        @if (menus.SgcDespachos)
                        {
                        <li>
                            <a class="sidebar-link sidebar-sublink @(ctrl == "RelacionFacCli" || ctrl == "CargaTc" ? "active" : "")" 
                               data-bs-toggle="collapse" href="#submenuDespachos" role="button" 
                               aria-expanded="@(ctrl == "RelacionFacCli" || ctrl == "CargaTc" ? "true" : "false")" 
                               aria-controls="submenuDespachos">
                                <i class="bi bi-truck"></i> Despachos
                            </a>
                            <ul class="collapse @(ctrl == "RelacionFacCli" || ctrl == "CargaTc" ? "show" : "") list-unstyled ps-3" id="submenuDespachos">
                                @if (menus.SgcDespachosRelacionFacCli)
                                {
                                <li>
                                    <a asp-controller="RelacionFacCli" asp-action="ListadoDespachos" class="sidebar-link sidebar-sublink @(ctrl == "RelacionFacCli" ? "active" : "")">
                                        <i class="bi bi-file-earmark-text"></i> Relación Factura-Cliente
                                    </a>
                                </li>
                                }
                                        @if (menus.SgcDespachosCargarTC)
                                                {
                                                <li>
                                                    <a asp-controller="CargaTc" asp-action="Index" class="sidebar-link sidebar-sublink @(ctrl == "CargaTc" ? "active" : "")">
                                                        <i class="bi bi-file-earmark-arrow-up"></i> Cargar TC
                                                    </a>
                                                </li>
                                                }
                                            </ul>
                                        </li>
                                        }
                                        @if (menus.SgcAnalisisReclamo)
                                        {
                                        <li>
                                            <a asp-controller="AnalisisReclamo" asp-action="Index" class="sidebar-link sidebar-sublink @(ctrl == "AnalisisReclamo" ? "active" : "")">
                                                <i class="bi bi-clipboard2-x"></i> Análisis de Reclamos
                                            </a>
                                        </li>
                                        }
                                    </ul>
                                </li>
                                }
                @if (menus.Facturacion || menus.SireFlag)
                {
                <li class="sidebar-section">FINANZAS</li>
                }
                @if (menus.Facturacion)
                {
                <li>
                    <a asp-controller="Facturacion" asp-action="Index" class="sidebar-link @(ctrl == "Facturacion" ? "active" : "")">
                        <i class="bi bi-receipt"></i> Facturación
                    </a>
                    <ul class="list-unstyled ps-3">
                        @if (menus.FacturacionImportarFacturas)
                        {
                        <li>
                            <a asp-controller="Facturacion" asp-action="ImportarFacturas" class="sidebar-link sidebar-sublink @(ctrl == "Facturacion" && act == "ImportarFacturas" ? "active" : "")">
                                <i class="bi bi-file-earmark-arrow-up"></i> Importar Facturas
                            </a>
                        </li>
                        }
                        @if (menus.FacturacionListaDocumentos)
                        {
                        <li>
                            <a asp-controller="Facturacion" asp-action="ListaDocumentos" class="sidebar-link sidebar-sublink @(ctrl == "Facturacion" && act == "ListaDocumentos" ? "active" : "")">
                                <i class="bi bi-list-ul"></i> Lista de Documentos
                            </a>
                        </li>
                        }
                    </ul>
                </li>
                }
                @if (menus.SireFlag)
                {
                <li>
                    <a asp-controller="Sire" asp-action="Index" class="sidebar-link @(ctrl == "Sire" ? "active" : "")">
                        <i class="bi bi-journal-text"></i> SIRE
                    </a>
                    <ul class="list-unstyled ps-3">
                        <li>
                            <a asp-controller="Sire" asp-action="Ventas" class="sidebar-link sidebar-sublink @(ctrl == "Sire" && act == "Ventas" ? "active" : "")">
                                <i class="bi bi-receipt-cutoff"></i> RVIE
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Sire" asp-action="Compras" class="sidebar-link sidebar-sublink @(ctrl == "Sire" && act == "Compras" ? "active" : "")">
                                <i class="bi bi-cart-check"></i> RCE
                            </a>
                        </li>
                    </ul>
                </li>
                }

                @if (menus.Ventas)
                {
                <li class="sidebar-section">COMERCIAL</li>
                <li>
                    <a asp-controller="Ventas" asp-action="Index" class="sidebar-link @(ctrl == "Ventas" || ctrl == "ConsultaTc" || ctrl == "IndicadorComercialMaestro" || ctrl == "DashboardComercialMaestro" || ctrl == "DashboardGerencial" ? "active" : "")">
                        <i class="bi bi-cash-coin"></i> Ventas
                    </a>
                    <ul class="list-unstyled ps-3">
                        @if (menus.VentasConsultaTC)
                        {
                        <li>
                            <a asp-controller="ConsultaTc" asp-action="Index" class="sidebar-link sidebar-sublink @(ctrl == "ConsultaTc" ? "active" : "")">
                                <i class="bi bi-file-earmark-text"></i> Consulta TC
                            </a>
                        </li>
                        }
                        @if (menus.VentasIndicadorComercialMaestro)
                        {
                        <li>
                            <a asp-controller="IndicadorComercialMaestro" asp-action="Index" class="sidebar-link sidebar-sublink @(ctrl == "IndicadorComercialMaestro" ? "active" : "")">
                                <i class="bi bi-graph-up"></i> Indicador Com. Maestro
                            </a>
                        </li>
                        }
                        @if (menus.VentasDashboardComercialMaestro)
                        {
                        <li>
                            <a asp-controller="DashboardComercialMaestro" asp-action="Index" class="sidebar-link sidebar-sublink @(ctrl == "DashboardComercialMaestro" ? "active" : "")">
                                <i class="bi bi-graph-up-arrow"></i> Dashboard Com. Maestro
                            </a>
                        </li>
                        }
                        @if (menus.VentasDashboardGerencial)
                        {
                        <li>
                            <a asp-controller="DashboardGerencial" asp-action="Index" class="sidebar-link sidebar-sublink @(ctrl == "DashboardGerencial" ? "active" : "")">
                                <i class="bi bi-graph-up-arrow"></i> Dashboard Gerencial
                            </a>
                        </li>
                        }
                    </ul>
                </li>
                }


                @if (menus.Seguridad)
                {
                    <!-- SEGURIDAD -->
                    <li class="sidebar-section">SEGURIDAD</li>
                    <li>
                        <a asp-controller="Seguridad" asp-action="Index" class="sidebar-link @(ctrl == "Seguridad" || ctrl == "Inspeccion" ? "active" : "")">
                            <i class="bi bi-shield-check"></i> Seguridad
                        </a>
                        <ul class="list-unstyled ps-3">
                            @if (menus.SeguridadInspecciones)
                            {
                            <li>
                                <a asp-controller="Inspeccion" asp-action="Index" class="sidebar-link sidebar-sublink @(ctrl == "Inspeccion" ? "active" : "")">
                                    <i class="bi bi-clipboard-check"></i> Inspecciones
                                </a>
                            </li>
                            }
                        </ul>
                    </li>
                }

                @if (menus.SaludOcupacional)
                {
                    <!-- SALUD OCUPACIONAL -->
                    <li class="sidebar-section">SALUD OCUPACIONAL</li>
                    <li>
                        <a asp-controller="InspeccionCom" asp-action="Dashboard"
                           class="sidebar-link @(ctrl == "InspeccionCom" ? "active" : "")">
                            <i class="bi bi-heart-pulse"></i> Salud Ocupacional
                        </a>
                        <ul class="list-unstyled ps-3">
                            @if (menus.SoInspeccionComedor)
                            {
                            <li>
                                <a asp-controller="InspeccionCom" asp-action="Dashboard"
                                   class="sidebar-link sidebar-sublink @(ctrl == "InspeccionCom" && (act == "Dashboard" || act == "Historial") ? "active" : "")">
                                    <i class="bi bi-clipboard2-check"></i> Inspección Comedor
                                </a>
                            </li>
                            <li>
                                <a asp-controller="InspeccionCom" asp-action="Acciones"
                                   class="sidebar-link sidebar-sublink @(ctrl == "InspeccionCom" && act == "Acciones" ? "active" : "")">
                                    <i class="bi bi-clipboard-x"></i> Acc. Correctivas
                                </a>
                            </li>
                            }
                        </ul>
                    </li>
                }

                @if (menus.RecursosHumanos)
                {
                    <!-- RECURSOS HUMANOS -->
                    <li class="sidebar-section">RECURSOS HUMANOS</li>
                    <li>
                        <a asp-controller="RecursosHumanos" asp-action="Index"
                           class="sidebar-link @(ctrl is "RecursosHumanos" or "Marcaciones" or "CompensacionDiaDia" or "CompensacionDdc" or "HorasExtras" or "Capacitacion" or "Curso" or "Examen" or "Certificado" or "CapacitacionAdmin" ? "active" : "")">
                            <i class="bi bi-people"></i> Recursos Humanos
                        </a>
                        <ul class="list-unstyled ps-3">
                             <!-- Aquarius -->
                             @if (menus.RhMarcaciones || menus.RhCompensacionDiaDia || menus.RhCompensacionDdc || menus.RhAutorizacionHoras)
                             {
                             <li>
                                 <a class="sidebar-link sidebar-sublink @(ctrl == "Marcaciones" || ctrl == "CompensacionDiaDia" || ctrl == "CompensacionDdc" || ctrl == "AuthHoras" ? "active" : "")"
                                                    data-bs-toggle="collapse" href="#submenuAquarius" role="button"
                                                    aria-expanded="@(ctrl == "Marcaciones" || ctrl == "CompensacionDiaDia" || ctrl == "CompensacionDdc" || ctrl == "AuthHoras" ? "true" : "false")"
                                                    aria-controls="submenuAquarius">
                                                     <i class="bi bi-people-fill"></i> Aquarius
                                                 </a>
                                                 <ul class="collapse @(ctrl == "Marcaciones" || ctrl == "CompensacionDiaDia" || ctrl == "CompensacionDdc" || ctrl == "AuthHoras" ? "show" : "") list-unstyled ps-3" id="submenuAquarius">
                                     @if (menus.RhMarcaciones)
                                     {
                                     <li>
                                         <a href="/RecursosHumanos/Aquarius/Marcaciones" class="sidebar-link sidebar-sublink @(ctrl == "Marcaciones" ? "active" : "")">
                                             <i class="bi bi-clock-history"></i> Marcaciones
                                         </a>
                                     </li>
                                     }
                                     @if (menus.RhCompensacionDiaDia)
                                     {
                                     <li>
                                         <a href="/RecursosHumanos/Aquarius/CompensacionDiaDia" class="sidebar-link sidebar-sublink @(ctrl == "CompensacionDiaDia" ? "active" : "")">
                                             <i class="bi bi-calendar2-check"></i> Compensación Día x Día
                                         </a>
                                     </li>
                                     }
                                     @if (menus.RhCompensacionDdc)
                                     {
                                     <li>
                                         <a href="/RecursosHumanos/Aquarius/CompensacionDdc" class="sidebar-link sidebar-sublink @(ctrl == "CompensacionDdc" ? "active" : "")">
                                             <i class="bi bi-calendar2-x"></i> Día Libre x Compensar
                                         </a>
                                     </li>
                                     }
                                     @if (menus.RhAutorizacionHoras)
                                     {
                                     <li>
                                         <a href="/RecursosHumanos/Aquarius/AuthHoras" class="sidebar-link sidebar-sublink @(ctrl == "AuthHoras" ? "active" : "")">
                                             <i class="bi bi-pencil-square"></i> Autorización de Horas
                                         </a>
                                     </li>
                                     }
                                 </ul>
                             </li>
                             }
                            <!-- Indicadores -->
                            @if (menus.RhIndicadores)
                            {
                            <li>
                                <a class="sidebar-link sidebar-sublink @(ctrl == "HorasExtras" ? "active" : "")"
                                   data-bs-toggle="collapse" href="#submenuRhIndicadores" role="button"
                                   aria-expanded="@(ctrl == "HorasExtras" || ctrl == "CostoSalarialHorasExtras" ? "true" : "false")"
                                   aria-controls="submenuRhIndicadores">
                                    <i class="bi bi-graph-up-arrow"></i> Indicadores
                                </a>
                                <ul class="collapse @(ctrl == "HorasExtras" || ctrl == "CostoSalarialHorasExtras" ? "show" : "") list-unstyled ps-3" id="submenuRhIndicadores">
                                    @if (menus.RhIndicadoresHorasExtras)
                                    {
                                    <li>
                                        <a href="/RecursosHumanos/HorasExtras" class="sidebar-link sidebar-sublink @(ctrl == "HorasExtras" ? "active" : "")">
                                            <i class="bi bi-clock-fill"></i> KPI Horas Extras
                                        </a>
                                    </li>
                                    }
                                            @if (menus.RhIndicadoresCostoSalarialHorasExtras)
                                            {
                                            <li>
                                                <a href="/RecursosHumanos/CostoSalarialHorasExtras" class="sidebar-link sidebar-sublink @(ctrl == "CostoSalarialHorasExtras" ? "active" : "")">
                                                    <i class="bi bi-coin"></i> Costo Salarial HE
                                                </a>
                                            </li>
                                            }
                                            @if (menus.RhIndicadoresComparativoCostoLaboral)
                                            {
                                            <li>
                                                <a href="/RecursosHumanos/ComparativoCostoLaboral" class="sidebar-link sidebar-sublink @(ctrl == "ComparativoCostoLaboral" ? "active" : "")">
                                                    <i class="bi bi-bar-chart-line-fill"></i> Comparativo Costo Laboral
                                                </a>
                                            </li>
                                            }
                                        </ul>
                                    </li>
                                    }
                        </ul>
                    </li>
                    <!-- CAPACITACIÓN (sub-módulo de Recursos Humanos) -->
                    @if (menus.Capacitacion)
                    {
                    <li>
                        <a asp-controller="Capacitacion" asp-action="MiPanel"
                           class="sidebar-link @(ctrl is "Capacitacion" or "Curso" or "Examen" or "Certificado" or "CapacitacionAdmin" ? "active" : "")">
                            <i class="bi bi-mortarboard-fill"></i>
                            <span>Capacitación</span>
                            <i class="bi bi-chevron-down ms-auto toggle-icon"></i>
                        </a>
                        <ul class="list-unstyled ps-3 submenu @(ctrl is "Capacitacion" or "Curso" or "Examen" or "Certificado" or "CapacitacionAdmin" ? "show" : "")">
                            @if (menus.CapacitacionMisCursos)
                            {
                            <li>
                                <a asp-controller="Capacitacion" asp-action="MiPanel"
                                   class="sidebar-link @(ctrl == "Capacitacion" && act == "MiPanel" ? "active" : "")">
                                    <i class="bi bi-grid-1x2"></i><span>Mi Panel</span>
                                </a>
                            </li>
                            }
                            @if (menus.CapacitacionCatalogo)
                            {
                            <li>
                                <a asp-controller="Capacitacion" asp-action="Catalogo"
                                   class="sidebar-link @((ctrl is "Curso" or "Examen" or "Certificado") || (ctrl == "Capacitacion" && act == "Catalogo") ? "active" : "")">
                                    <i class="bi bi-collection-play"></i><span>Catálogo</span>
                                </a>
                            </li>
                            }
                            @if (menus.CapacitacionAdmin)
                            {
                            <li>
                                <a asp-controller="CapacitacionAdmin" asp-action="Index"
                                   class="sidebar-link @(ctrl == "CapacitacionAdmin" ? "active" : "")">
                                    <i class="bi bi-gear"></i><span>Administración</span>
                                </a>
                            </li>
                            }
                        </ul>
                    </li>
                    }
                }

                @if (menus.Logistica)
                {
                    <!-- LOGÍSTICA -->
                    <li class="sidebar-section">LOGÍSTICA</li>
                    <li>
                        <a href="/Logistica" class="sidebar-link @(ctrl == "Logistica" ? "active" : "")">
                            <i class="bi bi-box-seam"></i> Logística
                        </a>
                        <ul class="list-unstyled ps-3">
                            @if (menus.LogisticaRequerimiento)
                            {
                            <li>
                                <a href="/Logistica/Requerimiento" class="sidebar-link sidebar-sublink @(ctrl == "Requisicion" ? "active" : "")">
                                    <i class="bi bi-clipboard-check"></i> Requerimientos
                                </a>
                            </li>
                            }
                            @if (menus.LogisticaOrdenCompra)
                            {
                            <li>
                                <a href="/Logistica/OrdenCompra" class="sidebar-link sidebar-sublink @(ctrl == "OrdenCompra" ? "active" : "")">
                                    <i class="bi bi-cart-check"></i> Órdenes de Compra
                                </a>
                            </li>
                            }
                            @if (menus.LogisticaIndicadores)
                            {
                            <li>
                                <a href="/Logistica/Indicadores" class="sidebar-link sidebar-sublink @(ctrl == "IndicadoresLogistica" ? "active" : "")">
                                    <i class="bi bi-bar-chart-line"></i> Indicadores
                                </a>
                            </li>
                            }
                        </ul>
                    </li>
                }

                @if (menus.CreditosCobranza)
                {
                    <!-- CRÉDITOS Y COBRANZAS -->
                    <li class="sidebar-section">CRÉDITOS Y COBRANZAS</li>
                    <li>
                        <a asp-controller="CreditosCobranza" asp-action="Index" class="sidebar-link @(ctrl == "CreditosCobranza" ? "active" : "")">
                            <i class="bi bi-graph-down-arrow"></i> Créditos y Cobranzas
                        </a>
                        <ul class="list-unstyled ps-3">
                            @if (menus.CcNivelMorosidad)
                            {
                            <li>
                                <a asp-controller="CreditosCobranza" asp-action="NivelMorosidad" class="sidebar-link sidebar-sublink @(ctrl == "CreditosCobranza" && act == "NivelMorosidad" ? "active" : "")">
                                    <i class="bi bi-bar-chart-line"></i> Nivel de Morosidad
                                </a>
                            </li>
                            }
                            @if (menus.CcNivelTiempo)
                            {
                            <li>
                                <a asp-controller="CreditosCobranza" asp-action="NivelTiempo" class="sidebar-link sidebar-sublink @(ctrl == "CreditosCobranza" && act == "NivelTiempo" ? "active" : "")">
                                    <i class="bi bi-clock-history"></i> Tiempo Promedio CxC
                                </a>
                            </li>
                            }
                        </ul>
                    </li>
                }

                @if (menus.Contabilidad)
                {
                    <!-- CONTABILIDAD -->
                    <li class="sidebar-section">CONTABILIDAD</li>
                    <li>
                        <a asp-controller="Contabilidad" asp-action="Index"
                           class="sidebar-link @(ctrl == "Contabilidad" || ctrl == "Sire" || ctrl == "ActivoFijo" ? "active" : "")">
                            <i class="bi bi-calculator-fill"></i> Contabilidad
                        </a>
                                <ul class="list-unstyled ps-3">
                                    @if (menus.ContabilidadSire)
                                    {
                                    <li>
                                        <a asp-controller="Sire" asp-action="Index"
                                           class="sidebar-link sidebar-sublink @(ctrl == "Sire" ? "active" : "")">
                                            <i class="bi bi-journal-text"></i> SIRE
                                        </a>
                                        <ul class="list-unstyled ps-3">
                                            <li>
                                                <a asp-controller="Sire" asp-action="Ventas"
                                                   class="sidebar-link sidebar-sublink @(ctrl == "Sire" && act == "Ventas" ? "active" : "")">
                                                    <i class="bi bi-receipt-cutoff"></i> RVIE (Ventas)
                                                </a>
                                            </li>
                                            <li>
                                                <a asp-controller="Sire" asp-action="Compras"
                                                   class="sidebar-link sidebar-sublink @(ctrl == "Sire" && act == "Compras" ? "active" : "")">
                                                    <i class="bi bi-cart-check"></i> RCE (Compras)
                                                </a>
                                            </li>
                                        </ul>
                                    </li>
                                    }
                                    @if (menus.ContabilidadActivoFijo)
                                    {
                                    <li>
                                        <a asp-controller="ActivoFijo" asp-action="Index"
                                           class="sidebar-link sidebar-sublink @(ctrl == "ActivoFijo" ? "active" : "")">
                                            <i class="bi bi-buildings"></i> Activos Fijos
                                        </a>
                                    </li>
                                    }
                                </ul>
                            </li>
                        }

                @if (menus.Sistemas)
                {
                    <!-- SISTEMAS -->
                    <li class="sidebar-section">SISTEMAS</li>
                    <li>
                        <a href="/Sistemas" class="sidebar-link @(ctrl == "Sistemas" ? "active" : "")">
                            <i class="bi bi-pc-display"></i> Sistemas
                        </a>
                        <ul class="list-unstyled ps-3">
                            @if (menus.SistemasIndicadores)
                            {
                            <li>
                                <a class="sidebar-link sidebar-sublink @(ctrl == "Desarrollo" || ctrl == "DesarrolloComplejidad" || ctrl == "Incidencia" || ctrl == "SeguimientoDev" ? "active" : "")"
                                   data-bs-toggle="collapse" href="#submenuSistemasInd" role="button"
                                   aria-expanded="@(ctrl == "Desarrollo" || ctrl == "DesarrolloComplejidad" || ctrl == "Incidencia" || ctrl == "SeguimientoDev" ? "true" : "false")"
                                   aria-controls="submenuSistemasInd">
                                    <i class="bi bi-graph-up-arrow"></i> Indicadores
                                </a>
                                <ul class="collapse @(ctrl == "Desarrollo" || ctrl == "DesarrolloComplejidad" || ctrl == "Incidencia" || ctrl == "SeguimientoDev" ? "show" : "") list-unstyled ps-3" id="submenuSistemasInd">
                                    @if (menus.SistemasIndicadoresDesarrollo)
                                    {
                                    <li>
                                        <a href="/Sistemas/Desarrollo" class="sidebar-link sidebar-sublink @(ctrl == "Desarrollo" ? "active" : "")">
                                            <i class="bi bi-kanban-fill"></i> KPI Desarrollo
                                        </a>
                                    </li>
                                    }
                                    @if (menus.SistemasIndicadoresDesarrolloComplejidad)
                                    {
                                    <li>
                                        <a href="/Sistemas/DesarrolloComplejidad" class="sidebar-link sidebar-sublink @(ctrl == "DesarrolloComplejidad" ? "active" : "")">
                                            <i class="bi bi-bar-chart-steps"></i> KPI Desarrollo - Complejidad
                                        </a>
                                    </li>
                                    }
                                    @if (menus.SistemasIndicadoresIncidencia)
                                    {
                                    <li>
                                        <a href="/Sistemas/Incidencia" class="sidebar-link sidebar-sublink @(ctrl == "Incidencia" ? "active" : "")">
                                            <i class="bi bi-bell-fill"></i> KPI Incidencias
                                        </a>
                                    </li>
                                    }
                                        @if (menus.SistemasIndicadoresSeguimientoDev)
                                                        {
                                                        <li>
                                                            <a href="/Sistemas/SeguimientoDev" class="sidebar-link sidebar-sublink @(ctrl == "SeguimientoDev" ? "active" : "")">
                                                                <i class="bi bi-clipboard2-check-fill"></i> Seguimiento Dev
                                                            </a>
                                                        </li>
                                                        }
                                                    </ul>
                                                </li>
                                                }
                                                @if (menus.SistemasRequerimientos)
                                                {
                                                <li>
                                                    <a class="sidebar-link sidebar-sublink @(ctrl == "AnularDocumento" ? "active" : "")"
                                                       data-bs-toggle="collapse" href="#submenuSistemasReq" role="button"
                                                       aria-expanded="@(ctrl == "AnularDocumento" ? "true" : "false")"
                                                       aria-controls="submenuSistemasReq">
                                                        <i class="bi bi-file-earmark-text"></i> Requerimientos
                                                    </a>
                                                    <ul class="collapse @(ctrl == "AnularDocumento" ? "show" : "") list-unstyled ps-3" id="submenuSistemasReq">
                                                        @if (menus.SistemasRequerimientosAnularDocumento)
                                                        {
                                                        <li>
                                                            <a href="/Sistemas/Requerimientos/AnularDocumento" class="sidebar-link sidebar-sublink @(ctrl == "AnularDocumento" ? "active" : "")">
                                                                <i class="bi bi-file-earmark-x-fill"></i> Anular Documento
                                                            </a>
                                                        </li>
                                                        }
                                                    </ul>
                                                </li>
                                                }
                                            </ul>
                                        </li>
                                    }
            </ul>
        </nav>

        <!-- Contenido principal -->
        <div id="content" class="flex-grow-1 d-flex flex-column">
            <!-- Header -->
            <header class="bg-white shadow-sm border-bottom px-4 py-2 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-sm btn-outline-secondary" id="sidebarToggle">
                        <i class="bi bi-list"></i>
                    </button>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0 small">
                            @RenderSection("Breadcrumb", required: false)
                        </ol>
                    </nav>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="text-muted small">
                        <i class="bi bi-person-circle me-1"></i>@User.Identity?.Name
                    </span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-box-arrow-right"></i> Salir
                        </button>
                    </form>
                </div>
            </header>

            <!-- Alertas globales -->
            <div class="px-4 pt-2">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Warning"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Warning"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
            </div>

            <!-- Contenido de la página -->
            <main class="flex-grow-1 p-4">
                @RenderBody()
            </main>

            <footer class="bg-light border-top text-center py-2">
                <small class="text-muted">&copy; @DateTime.Now.Year @tema.TextoFooter — Web Logix</small>
            </footer>
        </div>
    </div>
}
else
{
    @RenderBody()
}

<!-- Overlay de Carga Global -->
<div id="globalLoadingOverlay" class="global-loading-overlay">
    <div class="global-loading-spinner"></div>
    <div class="global-loading-text">
        <i class="bi bi-hourglass-split me-2"></i><span id="loadingMessage">Cargando...</span>
    </div>
    <div class="global-loading-subtext">Por favor espere</div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
<script src="~/lib/chart.js/dist/chart.umd.min.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/lib/flatpickr/dist/flatpickr.min.js" asp-append-version="true"></script>
<script src="~/lib/flatpickr/dist/l10n/es.js" asp-append-version="true"></script>
<script src="~/js/flatpickr-init.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
