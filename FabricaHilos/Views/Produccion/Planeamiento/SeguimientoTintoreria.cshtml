<script>
(function () {
'use strict';

// ── Helpers de formato ──────────────────────────────────────────────────────
function d(v)      { return v != null ? v : '\u2014'; }
function n0(v)     { return v != null ? Number(v).toLocaleString('es-PE',{maximumFractionDigits:0}) : '\u2014'; }
function n2(v)     { return v != null ? Number(v).toLocaleString('es-PE',{minimumFractionDigits:2,maximumFractionDigits:2}) : '\u2014'; }
function bgRet(v)  { return (v!=null&&v>0)?'background-color:#FEA8B4;':''; }
function bgDiasT(v){ return (v!=null&&v>0)?'background-color:#FE9CB1;':''; }
function bgDE(v)   { return (v!=null&&v>0)?'background-color:#FEA8B4;':''; }
function iconX(v) {
    if(v==null||v===0) return '<i class="bi bi-circle-fill text-success" title="A tiempo"></i>';
    if(v===1)          return '<i class="bi bi-circle-fill text-warning" title="1 d\u00eda retraso"></i>';
    return '<i class="bi bi-circle-fill text-danger" title="Retraso cr\u00edtico"></i>';
}
function iconDE(v) {
    if(v==null||v===0) return '<i class="bi bi-circle-fill text-success" title="Sin espera"></i>';
    if(v===1)          return '<i class="bi bi-circle-fill text-warning" title="1 d\u00eda espera"></i>';
    return '<i class="bi bi-circle-fill text-danger" title="En espera cr\u00edtica"></i>';
}
function iconSec(v) {
    // v = timeAprov: null = sin aprobación, 0 = aprobado a tiempo, >0 = días de retraso en aprobación
    if(v==null) return '<i class="bi bi-circle-fill text-secondary" title="Sin aprobaci\u00f3n cal."></i>';
    if(v===0)   return '<i class="bi bi-circle-fill text-success" title="Aprobado a tiempo"></i>';
    if(v===1)   return '<i class="bi bi-circle-fill text-warning" title="1 d\u00eda retraso aprobaci\u00f3n"></i>';
    return '<i class="bi bi-circle-fill text-danger" title="Retraso en aprobaci\u00f3n cr\u00edtico"></i>';
}

// ── buildRow ─────────────────────────────────────────────────────────────────
