                                        {
                                          <div class="mt-2 text-muted" style="font-size:.75rem;"><i class="bi bi-chat-left-text me-1"></i>@cc.Observacion</div>
                                        }
                                          </div>
                                        </div>
                                      </div>
                                    </div>
                                  }

                                  @* ── C.TT Rechazado / Reproceso ────────────────────────────── *@
                                  @if (s.FchRealCcRechazo.HasValue || (detTt!.Calidad != null && detTt.Calidad.DescResultado != null && detTt.Calidad.ResultadoBadge == "danger"))
                                  {
                                    <div class="accordion-item tt-acc-item" style="border-left:3px solid #dc3545;">
                                      <h2 class="accordion-header">
                                        <button class="accordion-button collapsed tt-acc-btn" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#acc-tt-@(subIdx)-rechazo"
                                                aria-expanded="false">
                                          <i class="bi bi-x-circle-fill me-2" style="color:#dc3545;"></i>C.TT Rechazado / Reproceso
                                          @if (s.FchRealCcRechazo.HasValue)
                                          {
                                            <span class="badge bg-danger ms-2" style="font-size:.62rem;">@s.FchRealCcRechazo.Value.ToString("dd/MM/yy")</span>
                                          }
                                        </button>
                                      </h2>
                                      <div id="acc-tt-@(subIdx)-rechazo" class="accordion-collapse collapse">
                                        <div class="accordion-body p-2">
                                          <div class="p-2" style="background:#fff5f5;border-radius:6px;border:1px solid #fed7d7;">
                                            <div class="d-flex flex-wrap gap-3 align-items-start">
                                              @if (s.FchRealCcRechazo.HasValue)
                                              {
                                                <div><span class="tt-lbl">Fecha rechazo</span><span class="tt-val tt-mono text-danger fw-semibold">@s.FchRealCcRechazo.Value.ToString("dd/MM/yy")</span></div>
                                              }
                                              @if (detTt!.Calidad != null)
                                              {
                                                <div>
                                                  <span class="tt-lbl">Resultado CC</span>
                                                  <span class="badge bg-@detTt.Calidad.ResultadoBadge" style="font-size:.65rem;">@detTt.Calidad.DescResultado</span>
                                                </div>
                                                @if (!string.IsNullOrEmpty(detTt.Calidad.Defecto))
                                                {
                                                  <div><span class="tt-lbl text-danger">Defecto</span><span class="tt-val text-danger fw-semibold">@detTt.Calidad.Defecto</span></div>
                                                }
                                                @if (!string.IsNullOrEmpty(detTt.Calidad.Observacion))
                                                {
                                                  <div class="w-100"><span class="tt-lbl">Observación</span><span class="tt-val text-muted">@detTt.Calidad.Observacion</span></div>
                                                }
                                              }
                                              @if (detTt!.RectificacionesReceta.Count > 0)
                                              {
                                                <div class="w-100 mt-1">
                                                  <span class="tt-lbl">Rectificaciones de receta</span>
                                                  <span class="badge bg-warning text-dark ms-1" style="font-size:.62rem;">@detTt.RectificacionesReceta.Count</span>
                                                  <span class="text-muted ms-1" style="font-size:.73rem;">(ver sección «Rectificado de Receta»)</span>
                                                </div>
                                              }
                                            </div>
                                          </div>
                                        </div>
                                      </div>
                                    </div>
                                  }

                                  @* ── Rectificado de Receta ──────────────────────────────────── *@
                                  @if (detTt!.RectificacionesReceta.Count > 0)
                                  {
                                    var _rectAcc = detTt!.RectificacionActiva;
                                    var _rectApr = detTt!.RectificacionAprobada;
                                    var _rectAny = _rectAcc ?? _rectApr;
                                    <div class="accordion-item tt-acc-item">
                                      <h2 class="accordion-header">
                                        <button class="accordion-button @(detTt.TieneRectificacionActiva ? "" : "collapsed") tt-acc-btn" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#acc-tt-@(subIdx)-rect"
                                                aria-expanded="@(detTt.TieneRectificacionActiva ? "true" : "false")">
                                          <i class="bi bi-flask me-2" style="color:#dc3545;"></i>Rectificado de Receta
                                          @if (_rectAcc != null)
                                          {
                                            <span class="badge bg-@_rectAcc.EstadoBadge ms-2" style="font-size:.62rem;">@_rectAcc.EstadoLabel</span>
                                          }
                                          else if (_rectApr != null)
                                          {
                                            <span class="badge bg-success ms-2" style="font-size:.62rem;">Aprobada</span>
                                          }
                                        </button>
                                      </h2>
                                      <div id="acc-tt-@(subIdx)-rect" class="accordion-collapse @(detTt.TieneRectificacionActiva ? "show" : "collapse")">
                                        <div class="accordion-body p-2">
                                          @foreach (var rect in detTt!.RectificacionesReceta)
                                          {
                                            var _rBg  = rect.EstadoBadge switch { "warning" => "#fffbeb", "info" => "#eff6ff", "success" => "#f0fff4", _ => "#f9fafb" };
                                            var _rBd  = rect.EstadoBadge switch { "warning" => "#fcd34d", "info" => "#93c5fd", "success" => "#6ee7b7", _ => "#e5e7eb" };
                                            <div class="p-2 mb-1" style="background:@_rBg;border-radius:6px;border:1px solid @_rBd;">
                                              <div class="d-flex flex-wrap gap-3 align-items-start mb-1">
                                                <div><span class="tt-lbl">Fecha</span><span class="tt-val tt-mono">@rect.FchRegistro.ToString("dd/MM/yyyy")</span></div>
                                                <div><span class="tt-lbl">Área</span><span class="tt-val">@(rect.Area ?? "—")</span></div>
                                                <div>
                                                  <span class="tt-lbl">Estado</span>
                                                  <span class="badge bg-@rect.EstadoBadge" style="font-size:.65rem;">@rect.EstadoLabel</span>
                                                </div>
                                                @if (!string.IsNullOrEmpty(rect.DefectoOrig))
                                                {
                                                  <div><span class="tt-lbl text-danger">Defecto</span><span class="tt-val text-danger fw-semibold">@rect.DefectoOrig</span></div>
                                                }
                                                @if (!string.IsNullOrEmpty(rect.Supervisor))
                                                {
                                                  <div><span class="tt-lbl">Supervisor</span><span class="tt-val">@rect.Supervisor</span></div>
                                                }
                                                @if (!string.IsNullOrEmpty(rect.Laboratorista))
                                                {
                                                  <div><span class="tt-lbl">Laboratorista</span><span class="tt-val">@rect.Laboratorista</span></div>
                                                }
                                              </div>
                                              @if (!string.IsNullOrEmpty(rect.Observacion))
                                              {
                                                <div class="mb-1 text-muted" style="font-size:.73rem;"><i class="bi bi-chat-left-text me-1"></i>@rect.Observacion</div>
                                              }
                                              @if (rect.FchEnProceso.HasValue || rect.FchRectificado.HasValue || rect.FchAprobado.HasValue)
                                              {
                                                <div class="d-flex flex-wrap gap-3" style="font-size:.72rem;">
                                                  @if (rect.FchEnProceso.HasValue)
                                                  {
                                                    <div><span class="tt-lbl">En Proceso</span><span class="tt-val tt-mono">@rect.FchEnProceso.Value.ToString("dd/MM/yyyy")</span></div>
                                                  }
                                                  @if (rect.FchRectificado.HasValue)
                                                  {
                                                    <div><span class="tt-lbl">Rectificado</span><span class="tt-val tt-mono">@rect.FchRectificado.Value.ToString("dd/MM/yyyy")</span></div>
                                                  }
                                                  @if (rect.FchAprobado.HasValue)
                                                  {
                                                    <div><span class="tt-lbl">Aprobado</span><span class="tt-val tt-mono">@rect.FchAprobado.Value.ToString("dd/MM/yyyy")</span></div>
                                                  }
                                                </div>
                                              }
                                            </div>
                                          }
                                        </div>
                                      </div>
                                    </div>
                                  }

                                  @* ── GRUPO: Acabados &amp; Despacho ──────────────────────── *@
                                  @if (detTt!.ProgramasConera.Count > 0 || detTt.Devanados.Count > 0 || detTt.Revisados.Count > 0 || detTt.PesajesAlmacen.Count > 0 || detTt.Despachos.Count > 0)
                                  {
                                    <div class="tt-grupo-sep"><span>Acabados &amp; Despacho</span></div>
                                  }
