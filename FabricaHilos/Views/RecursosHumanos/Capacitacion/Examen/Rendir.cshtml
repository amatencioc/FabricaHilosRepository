@model FabricaHilos.Models.Capacitacion.ExamenRendirVm
@{
    ViewData["Title"] = Model.TituloExamen;
}

@section Styles {
<style>
/* ── LMS · Examen ───────────────────────────────── */
body { background:#f0f4f8; }
.exam-layout { max-width:780px; margin:0 auto; padding:2rem 1rem; }
.lms-card { background:#fff; border:1px solid #dde3ec; border-radius:10px; box-shadow:0 1px 4px rgba(15,23,42,.04); }
.timer-bar { height:5px; background:#e8edf3; border-radius:3px; }
.timer-fill { height:100%; border-radius:3px; transition:width 1s linear; background:#1d4ed8; }
.timer-fill.warning { background:#b45309; }
.timer-fill.danger { background:#9f1239; }
.q-navigator { display:flex; flex-wrap:wrap; gap:6px; }
.q-nav-btn { width:34px; height:34px; border-radius:6px; border:1px solid #dde3ec; background:#fff; font-size:.78rem; font-weight:600; cursor:pointer; transition:all .1s; color:#334155; }
.q-nav-btn:hover { border-color:#94a3b8; background:#f8fafc; }
.q-nav-btn.respondida { border-color:#1d4ed8; background:#1d4ed8; color:#fff; }
.q-nav-btn.actual { border-color:#b45309; box-shadow:0 0 0 2px rgba(180,83,9,.2); }
.option-label { display:block; padding:.7rem 1rem; border:1px solid #dde3ec; border-radius:8px; cursor:pointer; transition:all .15s; color:#334155; font-size:.88rem; }
.option-label:hover { border-color:#94a3b8; background:#f8fafc; }
input[type=radio]:checked + .option-label,
input[type=checkbox]:checked + .option-label { border-color:#1d4ed8; background:rgba(29,78,216,.06); font-weight:600; color:#1e40af; }
input[type=radio], input[type=checkbox] { display:none; }
.progress-lms { height:4px; border-radius:4px; background:#e8edf3; overflow:hidden; }
.progress-lms-bar { height:100%; background:linear-gradient(90deg,#1d4ed8,#0284c7); border-radius:4px; }
.lms-btn { display:inline-flex; align-items:center; gap:.35rem; border-radius:7px; padding:.38rem .9rem; font-size:.82rem; font-weight:500; text-decoration:none; transition:all .12s; cursor:pointer; border:none; }
.lms-btn-primary { background:#1d4ed8; color:#fff; }
.lms-btn-primary:hover { background:#1e40af; color:#fff; }
.lms-btn-teal { background:#0f766e; color:#fff; }
.lms-btn-teal:hover { background:#0d6561; color:#fff; }
.lms-btn-outline { background:#fff; border:1px solid #dde3ec !important; color:#334155; }
.lms-btn-outline:hover { background:#f8fafc; border-color:#94a3b8 !important; color:#0f172a; }
</style>
}

<div class="exam-layout">
    <!-- Cabecera con timer -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <div class="text-muted small mb-0">@Model.TituloCurso</div>
            <h5 class="fw-bold mb-0">@Model.TituloExamen</h5>
        </div>
        <div class="text-center">
            <div id="timerDisplay" class="h4 fw-bold font-monospace mb-0">
                @Model.MinutosRestantes:00
            </div>
            <div class="text-muted small">restantes</div>
            <div id="saveStatus" style="font-size:.7rem;min-height:1em"></div>
        </div>
    </div>

    <!-- Barra de tiempo -->
    <div class="timer-bar mb-3">
        <div id="timerFill" class="timer-fill"
             style="width:@(Model.TiempoMin>0?Model.MinutosRestantes*100/Model.TiempoMin:100)%"></div>
    </div>

    <!-- Progreso de preguntas -->
    <div class="d-flex justify-content-between small text-muted mb-2">
        <span>Pregunta @(Model.PregActual + 1) de @Model.TotalPreguntas</span>
        <span id="spanRespondidas">@Model.Respondidas.Count(r => r) respondidas</span>
    </div>
    <div class="progress-lms mb-4">
        <div class="progress-lms-bar" style="width:@Model.PctPreguntaActual%"></div>
    </div>

    <!-- Navegador de preguntas -->
    <div class="q-navigator mb-4">
        @for (int i = 0; i < Model.TotalPreguntas; i++)
        {
            var css = (i == Model.PregActual ? "actual " : "") + (Model.Respondidas[i] ? "respondida" : "");
            <button type="button" class="q-nav-btn @css"
                    onclick="irA(@i)">@(i+1)</button>
        }
    </div>

    <!-- Tarjeta de pregunta -->
    <div class="lms-card mb-4">
        <div class="p-4">
            <div class="fw-semibold mb-4" style="font-size:1rem;color:#0f172a;line-height:1.45">@Model.PreguntaActual.Enunciado</div>

            @if (Model.PreguntaActual.TipoPreg != "RC" && Model.PreguntaActual.TipoPreg != "ENS")
            {
                <div class="d-flex flex-column gap-2" id="opcionesContainer">
                    @foreach (var op in Model.PreguntaActual.Opciones)
                        {
                            var inputType = Model.PreguntaActual.TipoPreg == "OV" ? "checkbox" : "radio";
                        <div>
                            <input type="@inputType" name="opcion" id="op_@op.IdOpcion"
                                   value="@op.IdOpcion"
                                   @(op.Seleccionada ? "checked" : "")
                                   class="opcion-input">
                            <label for="op_@op.IdOpcion" class="option-label">
                                @op.Texto
                            </label>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Respuesta de texto (RC/ENS) -->
                <textarea id="txtRespuesta" rows="@(Model.PreguntaActual.TipoPreg=="ENS" ? 8 : 3)"
                          class="form-control"
                          placeholder="Escribe tu respuesta aquí...">@Model.PreguntaActual.TextoRespuestaGuardado</textarea>
            }
        </div>
    </div>

    <!-- Navegación -->
    <div class="d-flex justify-content-between">
        @if (!Model.EsPrimeraPregunta)
        {
            <button class="lms-btn lms-btn-outline" onclick="irA(@(Model.PregActual - 1))">
                <i class="bi bi-chevron-left"></i> Anterior
            </button>
        }
        else { <div></div> }

        @if (!Model.EsUltimaPregunta)
        {
            <button class="lms-btn lms-btn-primary" onclick="irA(@(Model.PregActual + 1))">
                Siguiente <i class="bi bi-chevron-right"></i>
            </button>
        }
        else
        {
            <button class="lms-btn lms-btn-teal" onclick="confirmarEnvio()">
                <i class="bi bi-send-fill"></i> Finalizar examen
            </button>
        }
    </div>
</div>

<!-- Modal de confirmación de envío -->
<div class="modal fade" id="modalEnviar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content" style="border:1px solid #dde3ec;border-radius:10px">
            <div class="modal-header border-0 pb-0">
                <span class="fw-semibold" style="font-size:.9rem;color:#0f172a">¿Finalizar examen?</span>
            </div>
            <div class="modal-body" id="modalEnviarBody" style="font-size:.84rem;color:#334155">
                ¿Seguro que deseas enviar el examen?
            </div>
            <div class="modal-footer border-0 pt-0">
                <button class="lms-btn lms-btn-outline" data-bs-dismiss="modal" style="font-size:.8rem">Seguir respondiendo</button>
                <form method="post" asp-controller="Examen" asp-action="Enviar" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idIntento" value="@Model.IdIntento">
                    <input type="hidden" name="idInscripcion" value="@Model.IdInscripcion">
                    <button type="submit" class="lms-btn lms-btn-teal" style="font-size:.8rem">
                        <i class="bi bi-send-fill"></i> Enviar respuestas
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
@Html.AntiForgeryToken()
<script>
const TOKEN   = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
const INTENTO = @Model.IdIntento;
const PREG_ID = @Model.PreguntaActual.IdPregunta;
const TIPO    = '@Model.PreguntaActual.TipoPreg';
const VENCIMIENTO = new Date('@Model.FchVencimientoISO');

// ── Timer ──────────────────────────────────────────────────────────────
const secsFromServer = Math.max(0, Math.floor((VENCIMIENTO.getTime() - Date.now()) / 1000));
let secsLeft = secsFromServer > 0 ? secsFromServer : Math.max(0, @Model.MinutosRestantes * 60);
const timerDisplay = document.getElementById('timerDisplay');
const timerFill    = document.getElementById('timerFill');
const TOTAL_SECS   = @Model.TiempoMin * 60;

function actualizarTimer() {
    if (secsLeft <= 0) {
        timerDisplay.textContent = '0:00';
        enviarForzado();
        return;
    }
    const m = Math.floor(secsLeft / 60);
    const s = secsLeft % 60;
    timerDisplay.textContent = `${m}:${s.toString().padStart(2,'0')}`;
    const pct = (secsLeft / TOTAL_SECS) * 100;
    timerFill.style.width = pct + '%';
    timerFill.className = 'timer-fill' + (pct < 25 ? ' danger' : pct < 50 ? ' warning' : '');
    secsLeft--;
}

setInterval(actualizarTimer, 1000);
actualizarTimer();

let pendingSave = null;
let respondidas = [@Html.Raw(string.Join(",", Model.Respondidas.Select(r => r ? "true" : "false")))];
const PREG_IDX = @Model.PregActual;

function showSaveError() { const el = document.getElementById('saveStatus'); if(el) { el.textContent = 'Error al guardar'; el.style.color = '#9f1239'; setTimeout(()=>{ el.textContent=''; },3000); } }

function marcarRespondida() {
    respondidas[PREG_IDX] = true;
    const btn = document.querySelectorAll('.q-nav-btn')[PREG_IDX];
    if (btn) btn.classList.add('respondida');
    // Actualizar contador de respondidas
    const cnt = respondidas.filter(r => r).length;
    const spanResp = document.getElementById('spanRespondidas');
    if (spanResp) spanResp.textContent = cnt + ' respondidas';
}

function enviarForzado() {
    document.querySelector('#modalEnviar form').submit();
}

// ── Guardar respuesta automáticamente al cambiar ──────────────────────
document.querySelectorAll('.opcion-input').forEach(inp => {
    inp.addEventListener('change', async function() {
        let opciones;
        if (TIPO === 'OV') {
            // Checkbox: enviar todas las opciones marcadas
            opciones = Array.from(document.querySelectorAll('.opcion-input:checked'))
                           .map(c => c.value).join(',');
        } else {
            // Radio: enviar solo la seleccionada
            opciones = this.value;
        }
        pendingSave = fetch('@Url.Action("GuardarRespuesta","Examen")', {
            method:'POST',
            headers:{'Content-Type':'application/x-www-form-urlencoded','RequestVerificationToken':TOKEN},
            body:`idIntento=${INTENTO}&idPregunta=${PREG_ID}&idOpcion=${opciones}`
        }).then(r => { if(r.ok) marcarRespondida(); else showSaveError(); }).catch(() => showSaveError()).finally(() => { pendingSave = null; });
    });
});

const txtResp = document.getElementById('txtRespuesta');
if (txtResp) {
    let debounce;
    txtResp.addEventListener('input', function() {
        clearTimeout(debounce);
        debounce = setTimeout(async () => {
            pendingSave = fetch('@Url.Action("GuardarTexto","Examen")', {
                method:'POST',
                headers:{'Content-Type':'application/x-www-form-urlencoded','RequestVerificationToken':TOKEN},
                body:`idIntento=${INTENTO}&idPregunta=${PREG_ID}&texto=${encodeURIComponent(this.value)}`
            }).then(r => { if(r.ok) marcarRespondida(); else showSaveError(); }).catch(() => showSaveError()).finally(() => { pendingSave = null; });
        }, 800);
    });
}

// ── Navegación ────────────────────────────────────────────────────────
async function irA(n) {
    if (pendingSave) await pendingSave;
    window.location = `@Url.Action("Rendir","Examen")?idIntento=${INTENTO}&nro=${n}`;
}

function confirmarEnvio() {
    const pendientes = respondidas.filter(r => !r).length;
    const body = document.getElementById('modalEnviarBody');
    body.innerHTML = pendientes > 0
        ? `<div style="background:#fff7ed;border:1px solid #fde68a;border-radius:7px;padding:.6rem .9rem;font-size:.84rem;color:#92400e;margin-bottom:.75rem">Tienes <strong>${pendientes}</strong> pregunta(s) sin responder.</div>¿Deseas enviar de todas formas?`
        : '¿Seguro que deseas finalizar y enviar el examen?';
    new bootstrap.Modal(document.getElementById('modalEnviar')).show();
}
</script>
}
