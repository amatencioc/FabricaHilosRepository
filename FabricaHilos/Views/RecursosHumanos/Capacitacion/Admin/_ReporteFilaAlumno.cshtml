@model FabricaHilos.Models.Capacitacion.CapInscripcion
@{
    var bdgE = Model.Estado switch { "C"=>"bdg-comp", "P"=>"bdg-prog", "V"=>"bdg-venc", _=>"bdg-anul" };
    var lblE = Model.Estado switch { "C"=>"Completado", "P"=>"En progreso", "V"=>"Vencido", "X"=>"Anulado", _=>Model.Estado };
}
<tr>
    <td class="fw-semibold" style="color:#0f172a">@Model.CodUsuario</td>
    <td style="color:#334155">@(Model.NombreUsuario ?? "—")</td>
    <td style="color:#64748b">@(string.IsNullOrEmpty(Model.Dni) ? "—" : Model.Dni)</td>
    <td style="color:#64748b">@(Model.DescArea ?? "—")</td>
    <td style="color:#64748b">@(Model.DescCentroCosto ?? "—")</td>
    <td style="color:#64748b">@(Model.DescCargo ?? "—")</td>
    <td style="color:#64748b">@(Model.TituloCurso ?? $"Curso #{Model.IdCurso}")</td>
    <td style="color:#64748b">@(Model.FchIngreso.HasValue ? Model.FchIngreso.Value.ToString("dd/MM/yyyy") : "—")</td>
    <td style="color:#64748b">@Model.FchInscripcion.ToString("dd/MM/yyyy")</td>
    <td>
        <div class="d-flex align-items-center gap-2">
            <div class="progress-lms-inline" style="width:70px">
                <div class="progress-lms-bar" style="width:@Model.PctProgreso%"></div>
            </div>
            <span style="font-size:.78rem;color:#334155">@Model.PctProgreso%</span>
        </div>
    </td>
    <td><span class="bdg @bdgE">@lblE</span></td>
    <td>
        @if (Model.TieneExamen == "S")
        {
            if (Model.ExamenAprobado == "S")
            {
                <span class="bdg bdg-comp"><i class="bi bi-check-lg me-1"></i>Aprobado</span>
            }
            else if (Model.TotalIntentos > 0)
            {
                <span class="bdg bdg-venc"><i class="bi bi-x-lg me-1"></i>Desaprobado</span>
            }
            else
            {
                <span class="bdg" style="background:#fef3c7;color:#92400e"><i class="bi bi-clock me-1"></i>Pendiente</span>
            }
        }
        else
        {
            <span style="font-size:.75rem;color:#94a3b8">Sin examen</span>
        }
    </td>
    <td>
        @if (Model.TieneExamen == "S" && Model.MejorNota.HasValue)
        {
            var notaColor = Model.ExamenAprobado == "S" ? "#0f766e" : "#9f1239";
            <span style="font-size:.82rem;font-weight:600;color:@notaColor">@Model.MejorNota.Value.ToString("0.#")%</span>
        }
        else if (Model.TieneExamen == "S")
        {
            <span style="font-size:.75rem;color:#94a3b8">—</span>
        }
        else
        {
            <span style="font-size:.75rem;color:#94a3b8">N/A</span>
        }
    </td>
    <td>
        @if (Model.TieneExamen == "S")
        {
            if (Model.TotalIntentos > 0)
            {
                <span style="font-size:.82rem;color:#334155">@Model.TotalIntentos</span>
                if (Model.IntentoAprobado.HasValue)
                {
                    <span style="font-size:.68rem;color:#0f766e;display:block">Aprobó #@Model.IntentoAprobado</span>
                }
            }
            else
            {
                <span style="font-size:.75rem;color:#94a3b8">0</span>
            }
        }
        else
        {
            <span style="font-size:.75rem;color:#94a3b8">N/A</span>
        }
    </td>
    <td>
        @if (Model.Obligatorio=="S") { <span class="bdg bdg-obl">Sí</span> } else { <span style="font-size:.8rem;color:#94a3b8">No</span> }
    </td>
    <td>
        @if (Model.FchVencimiento.HasValue)
        {
            var diasFalta = (Model.FchVencimiento.Value - DateTime.Today).Days;
            <span class="@(diasFalta < 7 ? "fw-semibold" : "")" style="font-size:.82rem;color:@(diasFalta < 7 ? "#9f1239" : "#334155")">
                @Model.FchVencimiento.Value.ToString("dd/MM/yyyy")
                @if (diasFalta >= 0 && diasFalta < 30)
                {
                    <span class="bdg bdg-venc ms-1">@diasFalta d</span>
                }
            </span>
        }
        else { <span style="color:#94a3b8">—</span> }
    </td>
</tr>
