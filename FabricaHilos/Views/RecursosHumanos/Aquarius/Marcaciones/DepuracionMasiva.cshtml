@{
    ViewData["Title"] = "Depuración Masiva — Aquarius";

    var hoy    = DateTime.Today;
    var diff   = (int)hoy.DayOfWeek - 1;
    if (diff < 0) diff = 6;
    var lunes   = hoy.AddDays(-diff);
    var domingo = lunes.AddDays(6);
    var fDesde  = lunes.ToString("yyyy-MM-dd");
    var fHasta  = domingo.ToString("yyyy-MM-dd");
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="RecursosHumanos" asp-action="Index">Recursos Humanos</a></li>
    <li class="breadcrumb-item">Aquarius</li>
    <li class="breadcrumb-item"><a href="/RecursosHumanos/Aquarius/Marcaciones">Marcaciones</a></li>
    <li class="breadcrumb-item active">Depuración Masiva</li>
}

@section Styles {
<style>
    :root {
        --aq:       #C0622B;
        --aq-dk:    #9E4D20;
        --aq-lt:    #FEF3EB;
        --aq-mid:   #F5D5BC;
        --aq-ok:    #4E7E58;
        --aq-ok-lt: #EAF4EC;
        --aq-warn:  #B8772C;
        --aq-wlt:   #FEF5E3;
        --aq-err:   #AE3F3C;
        --aq-elt:   #FDECEA;
        --aq-info:  #7A6E9E;
        --aq-ilt:   #F2EDF7;
    }

    .page-header {
        background: linear-gradient(135deg, var(--aq) 0%, var(--aq-dk) 100%);
        color: #fff; border-radius: .5rem; padding: 1rem 1.4rem; margin-bottom: 1.2rem;
        display: flex; align-items: center; gap: .8rem;
    }
    .page-header h5 { margin: 0; font-weight: 700; }
    .page-header small { opacity: .8; font-size: .82rem; }

    .btn-consultar { background: var(--aq); border: none; color: #fff; }
    .btn-consultar:hover { background: var(--aq-dk); color: #fff; }
    .btn-consultar:disabled { opacity: .6; }

    .btn-depurar-all {
        background: var(--aq-err); border: none; color: #fff;
        font-weight: 600;
    }
    .btn-depurar-all:hover { background: #8e2e2c; color: #fff; }
    .btn-depurar-all:disabled { opacity: .55; }

    /* KPIs */
    .kpi-card { border: none; border-radius: .5rem; text-align: center; padding: .7rem .5rem; }
    .kpi-num  { font-size: 1.6rem; font-weight: 700; line-height: 1.1; }
    .kpi-lbl  { font-size: .74rem; color: #6c757d; }

    /* Tabla masiva */
    .tbl-masiva { font-size: .8rem; }
    .tbl-masiva thead th {
        background: #f1f3f5; color: #495057;
        font-size: .72rem; font-weight: 600; text-transform: uppercase;
        letter-spacing: .4px; white-space: nowrap;
        padding: .45rem .6rem; border-bottom: 2px solid var(--aq-mid);
    }
    .tbl-masiva thead th[style*="cursor:pointer"]:hover {
        background: var(--aq-mid); color: var(--aq-dk);
    }
    .tbl-masiva tbody td { padding: .38rem .6rem; vertical-align: middle; }
    .tbl-masiva tbody tr:hover { background: var(--aq-lt); }

    /* Badges de estado por día */
    .day-badge {
        display: inline-flex; align-items: center; justify-content: center;
        width: 22px; height: 22px; border-radius: 50%;
        font-size: .68rem; font-weight: 700;
        cursor: default;
    }
    .day-s    { background: var(--aq-elt);   color: var(--aq-err); }
    .day-n    { background: var(--aq-ok-lt); color: var(--aq-ok); }
    .day-d    { background: var(--aq-lt);    color: var(--aq-dk); }
    .day-none { background: #f1f3f5;          color: #adb5bd; font-weight:400; }

    /* Barra de progreso inline */
    .bar-mini { height: 5px; border-radius: 3px; background: #e9ecef; overflow: hidden; width: 60px; display: inline-block; vertical-align: middle; }
    .bar-fill { height: 100%; background: var(--aq-err); }

    /* Resultado depuración */
    .result-panel { border-radius: .5rem; overflow: hidden; }
    .stat-box { background: #fff; border: 1px solid #e5e7eb; border-radius: .4rem; text-align: center; padding: .6rem .4rem; }
    .stat-num  { font-size: 1.25rem; font-weight: 700; line-height: 1; }
    .stat-lbl  { font-size: .7rem; color: #6b7280; margin-top: .15rem; }

    #divResultado { display: none; }
</style>
}

<!-- Header -->
<div class="page-header">
    <i class="bi bi-people-fill fs-4"></i>
    <div>
        <h5 class="mb-0">Depuración Masiva</h5>
        <small>Consulta y depura las marcaciones de todos los empleados para el período seleccionado.</small>
    </div>
    <a href="/RecursosHumanos/Aquarius/Marcaciones" class="btn btn-sm btn-outline-light ms-auto">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
</div>

<!-- Filtros -->
<div class="card mb-3">
    <div class="card-body py-2 px-3">
        <div class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label fw-semibold mb-1 small">Período</label>
                <div class="input-group input-group-sm">
                    <input type="date" id="dtDesde" class="form-control" value="@fDesde" />
                    <span class="input-group-text">—</span>
                    <input type="date" id="dtHasta" class="form-control" value="@fHasta" />
                </div>
            </div>
            <div class="col-auto">
                <button id="btnConsultar" class="btn btn-sm btn-consultar">
                    <i class="bi bi-search me-1"></i>Consultar
                </button>
            </div>
            <!-- Semana rápida -->
            <div class="col-auto ms-2 d-flex align-items-center gap-1">
                <button id="btnSemAnt" class="btn btn-sm btn-outline-secondary" title="Semana anterior">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <span id="lblSemana" class="small fw-semibold" style="min-width:200px;text-align:center;color:var(--aq)"></span>
                <button id="btnSemSig" class="btn btn-sm btn-outline-secondary" title="Semana siguiente">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
            <!-- Botón depurar seleccionados -->
            <div class="col-auto ms-auto">
                <button id="btnDepurarTodo" class="btn btn-sm btn-depurar-all" style="display:none" disabled>
                    <i class="bi bi-lightning-fill me-1"></i>Depurar seleccionados (<span id="cntSeleccionados">0</span>)
                </button>
            </div>
        </div>
    </div>
</div>

<!-- KPIs -->
<div class="row g-2 mb-3" id="divKpis" style="display:none">
    <div class="col-6 col-sm-3">
        <div class="kpi-card" style="background:var(--aq-lt)">
            <div class="kpi-num" id="kpiTotal" style="color:var(--aq)">0</div>
            <div class="kpi-lbl">Empleados</div>
        </div>
    </div>
    <div class="col-6 col-sm-3">
        <div class="kpi-card" style="background:var(--aq-elt)">
            <div class="kpi-num" id="kpiConProb" style="color:var(--aq-err)">0</div>
            <div class="kpi-lbl">Con problemas</div>
        </div>
    </div>
    <div class="col-6 col-sm-3">
        <div class="kpi-card" style="background:var(--aq-wlt)">
            <div class="kpi-num" id="kpiDiasProb" style="color:var(--aq-warn)">0</div>
            <div class="kpi-lbl">Días a depurar</div>
        </div>
    </div>
    <div class="col-6 col-sm-3">
        <div class="kpi-card" style="background:var(--aq-ok-lt)">
            <div class="kpi-num" id="kpiDiasOk" style="color:var(--aq-ok)">0</div>
            <div class="kpi-lbl">Días OK / Depurados</div>
        </div>
    </div>
</div>

<!-- Tabla de resultados -->
<div class="card" id="divTabla" style="display:none">
    <div class="card-body p-0" style="overflow-x:auto">
        <table class="table table-sm tbl-masiva mb-0" id="tblMasiva">
            <thead>
                <tr id="trHead">
                    <th style="min-width:80px">Fotocheck</th>
                    <th style="min-width:200px">Empleado</th>
                    <!-- Columnas de días generadas dinámicamente -->
                    <th class="text-center" style="min-width:80px">Pendientes</th>
                </tr>
            </thead>
            <tbody id="tbodyMasiva">
                <tr><td colspan="10" class="text-center text-muted p-4">Seleccione un período y presione Consultar.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Panel resultado depuración -->
<div id="divResultado" class="mt-3">
    <div class="result-panel">
        <div class="p-3" id="panelResHeader">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span id="iconResultado"></span>
                <strong id="txtResultadoTitulo"></strong>
            </div>
            <div class="row g-2" id="rowStats"></div>
        </div>
    </div>
</div>

<!-- Modal alerta genérico -->
<div class="modal fade" id="modalAlerta" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" id="modalAlertaHeader">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i><span id="modalAlertaTitulo">Aviso</span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="modalAlertaMensaje" class="mb-0"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal confirmación depuración masiva -->
<div class="modal fade" id="modalConfirmarMasivo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background:var(--aq-err);color:#fff">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Depuración Masiva</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="txtConfirmarMasivo" class="mb-0" style="white-space: pre-wrap"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="btnConfirmarMasivoOk">
                    <i class="bi bi-lightning-fill me-1"></i>Sí, depurar todo
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal progreso depuración -->
<div class="modal fade" id="modalDepurando" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background:var(--aq);color:#fff">
                <h5 class="modal-title"><i class="bi bi-lightning-fill me-2"></i>Depurando marcaciones…</h5>
            </div>
            <div class="modal-body text-center py-4">
                <div class="spinner-border mb-3" style="color:var(--aq);width:3rem;height:3rem" role="status"></div>
                <div class="fw-semibold mb-1" id="txtProgresoMasivo">Procesando todos los empleados…</div>
                <small class="text-muted">La depuración masiva puede tardar varios minutos.<br>No cierre esta ventana.</small>
                <div class="mt-3">
                    <small class="text-muted" id="txtTiempoMasivo"></small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
@Html.AntiForgeryToken()
<script>
let _datos      = [];        // Array de objetos agrupados por empleado
let _fechas     = [];        // Array de fechas ISO en el período consultado
let _jobIds     = [];        // Array de jobIds en curso (masivo)
let _pollTimer  = null;
let _inicioMs   = 0;
let _confirmHandler = null;  // Handler activo del modal de confirmación

// ── Sort state ────────────────────────────────────────────────────────────────
let _sortCol = 'empleado';   // 'fotocheck' | 'empleado'
let _sortDir =  1;           // 1=asc | -1=desc

// ── Helpers modales ───────────────────────────────────────────────────────────
function showAlerta(mensaje, titulo, esError) {
    document.getElementById('modalAlertaTitulo').textContent = titulo || 'Aviso';
    document.getElementById('modalAlertaMensaje').textContent = mensaje;
    const header = document.getElementById('modalAlertaHeader');
    header.style.background   = esError ? 'var(--aq-err)' : 'var(--aq)';
    header.style.color        = '#fff';
    bootstrap.Modal.getOrCreateInstance(document.getElementById('modalAlerta')).show();
}

function showConfirm(mensaje, onConfirm) {
    document.getElementById('txtConfirmarMasivo').textContent = mensaje;
    const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalConfirmarMasivo'));
    const btnOk = document.getElementById('btnConfirmarMasivoOk');
    // Limpiar handler previo para evitar acumulación
    if (_confirmHandler) {
        btnOk.removeEventListener('click', _confirmHandler);
        _confirmHandler = null;
    }
    _confirmHandler = function () {
        btnOk.removeEventListener('click', _confirmHandler);
        _confirmHandler = null;
        modal.hide();
        onConfirm();
    };
    btnOk.addEventListener('click', _confirmHandler);
    modal.show();
}

// ── Semana navigation ────────────────────────────────────────────────────────
let _semOffset = 0;  // 0 = semana actual

function calcSemana(offset) {
    const hoy  = new Date();
    const dow  = hoy.getDay() === 0 ? 6 : hoy.getDay() - 1;  // lunes=0
    const lun  = new Date(hoy); lun.setDate(hoy.getDate() - dow + offset * 7);
    const dom  = new Date(lun); dom.setDate(lun.getDate() + 6);
    return { lun, dom };
}

function toIso(d) {
    const y  = d.getFullYear();
    const m  = String(d.getMonth() + 1).padStart(2, '0');
    const dd = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${dd}`;
}

function fmtLong(d) {
    return d.toLocaleDateString('es-PE', { day: '2-digit', month: 'short', year: 'numeric' });
}

function actualizarNavSemana() {
    const { lun, dom } = calcSemana(_semOffset);
    document.getElementById('dtDesde').value = toIso(lun);
    document.getElementById('dtHasta').value = toIso(dom);
    document.getElementById('lblSemana').textContent =
        fmtLong(lun) + ' — ' + fmtLong(dom);
}

document.getElementById('btnSemAnt').addEventListener('click', () => { _semOffset--; actualizarNavSemana(); });
document.getElementById('btnSemSig').addEventListener('click', () => { _semOffset++; actualizarNavSemana(); });
actualizarNavSemana();

// ── Consultar ────────────────────────────────────────────────────────────────
document.getElementById('btnConsultar').addEventListener('click', consultar);

async function consultar() {
    const desde = document.getElementById('dtDesde').value;
    const hasta = document.getElementById('dtHasta').value;
    if (!desde || !hasta) { showAlerta('Seleccione el período.', 'Aviso', false); return; }
    if (desde > hasta) { showAlerta('La fecha inicial no puede ser mayor que la fecha final.', 'Aviso', false); return; }

    const btn = document.getElementById('btnConsultar');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Consultando…';

    try {
        const r = await fetch(
            `/RecursosHumanos/Aquarius/Marcaciones/ConsultarRangoMasivo?fechaInicio=${desde}&fechaFin=${hasta}`,
            { cache: 'no-store' }
        );
        if (!r.ok) { showAlerta(`Error del servidor (${r.status}).`, 'Error', true); return; }
        const json = await r.json();
        if (!json.ok) { showAlerta('Error: ' + json.mensaje, 'Error', true); return; }
        procesarDatos(json.data ?? [], desde, hasta);
    } catch(e) {
        showAlerta('Error de red al consultar.', 'Error de red', true);
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-search me-1"></i>Consultar';
    }
}

// ── Procesar y agrupar datos ─────────────────────────────────────────────────
function procesarDatos(rows, desde, hasta) {
    // Generar lista de fechas del período
    _fechas = [];
    let d = new Date(desde + 'T00:00:00');
    const fin = new Date(hasta + 'T00:00:00');
    while (d <= fin) { _fechas.push(toIso(d)); d.setDate(d.getDate() + 1); }

    // Agrupar por empleado
    const mapa = {};
    for (const row of rows) {
        const key = row.codPersonal;
        if (!mapa[key]) {
            mapa[key] = {
                codPersonal: row.codPersonal,
                fotocheck:   row.fotocheck,
                empleado:    row.empleado ?? '',
                dias:        {}
            };
        }
        const fiso = fechaRowToIso(row.fechamar);
        if (fiso) mapa[key].dias[fiso] = row;
    }
    _datos = Object.values(mapa);

    renderKpis();
    renderTabla();
    actualizarContadorSeleccionados();

    document.getElementById('divResultado').style.display = 'none';
    document.getElementById('btnDepurarTodo').style.display = '';
}

function fechaRowToIso(fechamar) {
    // fechamar viene como "DD/MM/YYYY" o "YYYY-MM-DD"
    if (!fechamar) return null;
    if (fechamar.includes('/')) {
        const [d, m, y] = fechamar.split('/');
        return `${y}-${m.padStart(2,'0')}-${d.padStart(2,'0')}`;
    }
    return fechamar.substring(0, 10);
}

function esDiaPendiente(dia) {
    if (!dia) return false;
    return dia.pendiente === 'S';   // 'S'=pendiente | 'D'=ya depurado | 'N'=OK/permiso/descanso
}

// ── KPIs ─────────────────────────────────────────────────────────────────────
function renderKpis() {
    const total    = _datos.length;
    let diasProb   = 0;
    let diasOk     = 0;
    let conProb    = 0;

    for (const emp of _datos) {
        let tieneProb = false;
        for (const fiso of _fechas) {
            const dia = emp.dias[fiso];
            if (!dia) continue;
            if (esDiaPendiente(dia)) { diasProb++; tieneProb = true; }
            else { diasOk++; }
        }
        if (tieneProb) conProb++;
    }

    document.getElementById('kpiTotal').textContent    = total;
    document.getElementById('kpiConProb').textContent  = conProb;
    document.getElementById('kpiDiasProb').textContent = diasProb;
    document.getElementById('kpiDiasOk').textContent   = diasOk;
    document.getElementById('divKpis').style.display   = '';
}

// ── Tabla ────────────────────────────────────────────────────────────────────
const DIAS_CORTO = ['LUN','MAR','MIÉ','JUE','VIE','SÁB','DOM'];

function diaSemana(iso) {
    const [y, m, d] = iso.split('-').map(Number);
    const dow = new Date(y, m - 1, d).getDay();
    return dow === 0 ? 6 : dow - 1;  // lunes=0
}

function renderTabla() {
    // Cabecera dinámica
    const trHead = document.getElementById('trHead');

    // Limpiar encabezado completamente y regenerar
    trHead.innerHTML =
        '<th style="width:34px"><input type="checkbox" id="chkAll" title="Seleccionar/deseleccionar todos" style="cursor:pointer"></th>' +
        `<th style="min-width:80px;cursor:pointer;user-select:none" id="thFotocheck" title="Ordenar por Fotocheck">Fotocheck ${_sortCol==='fotocheck'?(_sortDir===1?'▲':'▼'):'⇅'}</th>` +
        `<th style="min-width:190px;cursor:pointer;user-select:none" id="thEmpleado" title="Ordenar por Empleado">Empleado ${_sortCol==='empleado'?(_sortDir===1?'▲':'▼'):'⇅'}</th>`;
    for (const fiso of _fechas) {
        const idx = diaSemana(fiso);
        const [, m, d] = fiso.split('-');
        const th = document.createElement('th');
        th.className = 'text-center';
        th.style.minWidth = '48px';
        th.innerHTML = `<span style="font-size:.68rem">${DIAS_CORTO[idx]}</span><br><span style="font-size:.7rem;font-weight:400">${d}/${m}</span>`;
        trHead.appendChild(th);
    }
    const thPend = document.createElement('th');
    thPend.className = 'text-center';
    thPend.textContent = 'Pendientes';
    thPend.style.minWidth = '85px';
    trHead.appendChild(thPend);

    // Cuerpo
    const tbody = document.getElementById('tbodyMasiva');
    if (!_datos.length) {
        tbody.innerHTML = '<tr><td colspan="20" class="text-center text-muted p-4">Sin datos para el período seleccionado.</td></tr>';
        document.getElementById('divTabla').style.display = 'none';
        return;
    }

    // Solo empleados con al menos 1 día pendiente ('S')
    const sorted = _datos
        .filter(emp => _fechas.some(f => esDiaPendiente(emp.dias[f])))
        .sort((a, b) => {
            let cmp = 0;
            if (_sortCol === 'fotocheck') {
                cmp = (a.fotocheck || '').localeCompare(b.fotocheck || '');
            } else {
                cmp = (a.empleado || '').localeCompare(b.empleado || '');
            }
            return cmp * _sortDir;
        });

    // Registrar click de columnas DESPUÉS de renderizar el thead
    setTimeout(() => {
        const thF = document.getElementById('thFotocheck');
        const thE = document.getElementById('thEmpleado');
        if (thF) thF.addEventListener('click', () => { toggleSort('fotocheck'); });
        if (thE) thE.addEventListener('click', () => { toggleSort('empleado'); });
    }, 0);

    tbody.innerHTML = sorted.map(emp => {
        let pendientes = 0;
        const daysCells = _fechas.map(fiso => {
            const dia = emp.dias[fiso];
            if (!dia) return `<td class="text-center"><span class="day-badge day-none" title="Sin registro">—</span></td>`;

            const p = dia.pendiente;   // 'S' | 'D' | 'N'
            if (p === 'S') pendientes++;

            let cls, lbl, tip;
            if (p === 'S') {
                cls = 'day-s'; lbl = 'S';
                tip = (dia.problema || 'Pendiente');
                if (dia.casoAplica) tip += '\n' + dia.casoAplica;
            } else if (p === 'D') {
                cls = 'day-d'; lbl = 'D';
                tip = 'Depurado: ' + (dia.codDepuracion || '');
            } else {
                cls = 'day-n'; lbl = 'N';
                tip = dia.problema || 'OK';
            }
            return `<td class="text-center"><span class="day-badge ${cls}" title="${escHtml(tip)}">${lbl}</span></td>`;
        }).join('');

        const pctBad = _fechas.length > 0 ? Math.round(pendientes / _fechas.length * 100) : 0;
        const barHtml = pendientes > 0
            ? `<div class="bar-mini ms-1"><div class="bar-fill" style="width:${pctBad}%"></div></div>`
            : '';

        // Checkbox checked por defecto si tiene al menos un día pendiente
        const chkChecked = pendientes > 0 ? 'checked' : '';

        return `<tr>
            <td class="text-center"><input type="checkbox" class="chk-emp" data-personal="${escHtml(emp.codPersonal)}" ${chkChecked} style="cursor:pointer"></td>
            <td><span style="color:var(--aq-dk);font-weight:600;font-size:.8rem">${escHtml(emp.fotocheck) || '—'}</span></td>
            <td style="font-size:.81rem">${escHtml(emp.empleado)}</td>
            ${daysCells}
            <td class="text-center">
                ${pendientes > 0
                    ? `<span class="badge rounded-pill" style="background:var(--aq-elt);color:var(--aq-err)">${pendientes}</span>${barHtml}`
                    : '<span class="text-muted" style="font-size:.75rem">—</span>'}
            </td>
        </tr>`;
    }).join('');

    document.getElementById('divTabla').style.display = '';

    // Sync estado del select-all tras renderizar
    actualizarContadorSeleccionados();
}

// ── Setup único de eventos de checkboxes (delegación en documento) ───────────
document.addEventListener('change', e => {
    if (e.target.classList.contains('chk-emp')) {
        actualizarContadorSeleccionados();
    }
    if (e.target.id === 'chkAll') {
        document.querySelectorAll('.chk-emp').forEach(c => c.checked = e.target.checked);
        actualizarContadorSeleccionados();
    }
});

// Delegación de clicks de ordenamiento (evita acumulación de listeners al re-renderizar)
document.addEventListener('click', e => {
    if (e.target.closest('#thFotocheck')) { toggleSort('fotocheck'); }
    else if (e.target.closest('#thEmpleado')) { toggleSort('empleado'); }
});

// ── Ordenar columnas ────────────────────────────────────────────────────────────────
function toggleSort(col) {
    if (_sortCol === col) {
        _sortDir = _sortDir === 1 ? -1 : 1;
    } else {
        _sortCol = col;
        _sortDir = 1;
    }
    renderTabla();
}

// ── Checkbox counter ─────────────────────────────────────────────────────────
function actualizarContadorSeleccionados() {
    const total = document.querySelectorAll('.chk-emp:checked').length;
    const cnt = document.getElementById('cntSeleccionados');
    if (cnt) cnt.textContent = total;
    document.getElementById('btnDepurarTodo').disabled = total === 0;
    // Sync select-all checkbox state
    const all  = document.querySelectorAll('.chk-emp').length;
    const chkAll = document.getElementById('chkAll');
    if (chkAll) {
        chkAll.checked       = total > 0 && total === all;
        chkAll.indeterminate = total > 0 && total < all;
    }
}

// ── Depurar Seleccionados ────────────────────────────────────────────────────
document.getElementById('btnDepurarTodo').addEventListener('click', depurarSeleccionados);

async function depurarSeleccionados() {
    const desde = document.getElementById('dtDesde').value;
    const hasta = document.getElementById('dtHasta').value;
    if (!desde || !hasta) { showAlerta('Seleccione el período.', 'Aviso', false); return; }
    if (desde > hasta) { showAlerta('La fecha inicial no puede ser mayor que la fecha final.', 'Aviso', false); return; }

    const checkeados = Array.from(document.querySelectorAll('.chk-emp:checked'))
                            .map(c => c.dataset.personal)
                            .filter(p => p !== undefined && p !== '');
    if (!checkeados.length) { showAlerta('Seleccione al menos un empleado.', 'Aviso', false); return; }

    const todos = document.querySelectorAll('.chk-emp').length;
    const textoEmpl = checkeados.length === todos
        ? `TODOS los empleados (${checkeados.length})`
        : `${checkeados.length} empleado(s) seleccionado(s)`;

    // Contar días S totales
    const totalDiasS = checkeados.reduce((acc, personal) => {
        const emp = _datos.find(e => String(e.codPersonal) === personal);
        return acc + (emp ? _fechas.filter(f => esDiaPendiente(emp.dias[f])).length : 0);
    }, 0);

    showConfirm(
        `¿Confirma que desea depurar ${totalDiasS} día(s) pendiente(s) de ${textoEmpl}?\n\n` +
        `Solo se procesarán los días marcados como S (pendiente).\nEsta operación puede tardar varios minutos.`,
        () => ejecutarDepuracionSeleccionados(desde, hasta, checkeados)
    );
}

async function ejecutarDepuracionSeleccionados(desde, hasta, checkeados) {
    const btn = document.getElementById('btnDepurarTodo');
    btn.disabled = true;
    if (_pollTimer) { clearInterval(_pollTimer); _pollTimer = null; }

    const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalDepurando'));
    modal.show();
    _inicioMs = Date.now();
    document.getElementById('txtTiempoMasivo').textContent = '';

    // Construir lista de {personal, fechas:['S-date',...]} usando solo días con pendiente='S'
    const payload = checkeados
        .map(personal => {
            const emp = _datos.find(e => String(e.codPersonal) === personal);
            const fechasS = emp
                ? _fechas.filter(f => esDiaPendiente(emp.dias[f]))
                : [];
            return { personal, fechas: fechasS };
        })
        .filter(pf => pf.fechas.length > 0);

    if (payload.length === 0) {
        modal.hide();
        btn.disabled = false;
        showAlerta('No hay días pendientes para los empleados seleccionados. Vuelva a consultar.', 'Aviso', false);
        return;
    }

    const totalJobs = payload.reduce((acc, pf) => acc + pf.fechas.length, 0);
    document.getElementById('txtProgresoMasivo').textContent =
        `Encolando ${totalJobs} día(s) pendientes de ${payload.length} empleado(s)…`;

    let cronometro = setInterval(() => {
        const sec = Math.floor((Date.now() - _inicioMs) / 1000);
        document.getElementById('txtTiempoMasivo').textContent = `Tiempo transcurrido: ${sec}s`;
    }, 1000);

    try {
        const token = document.querySelector('[name="__RequestVerificationToken"]')?.value ?? '';
        const formData = new FormData();
        formData.append('fechasJson', JSON.stringify(payload));
        formData.append('__RequestVerificationToken', token);

        const r = await fetch('/RecursosHumanos/Aquarius/Marcaciones/DepurarFechasEspecificas', {
            method: 'POST',
            body:   formData
        });
        if (!r.ok) {
            clearInterval(cronometro);
            modal.hide();
            btn.disabled = false;
            showAlerta(`Error del servidor (${r.status}).`, 'Error', true);
            return;
        }
        const json = await r.json();
        if (!json.ok) {
            clearInterval(cronometro);
            modal.hide();
            btn.disabled = false;
            showAlerta('Error al encolar: ' + json.mensaje, 'Error', true);
            return;
        }

        _jobIds = json.jobIds ?? [];
        if (_jobIds.length === 0) {
            clearInterval(cronometro);
            modal.hide();
            btn.disabled = false;
            showAlerta('El servidor no enqoló ningún trabajo. Puede que no haya días pendientes.', 'Aviso', false);
            return;
        }
        const totalJobsEncolados = _jobIds.length;

        let _pollCount = 0;
        const MAX_POLL  = 150;  // 5 min a 2s/ciclo
        _pollTimer = setInterval(async () => {
            _pollCount++;
            if (_pollCount > MAX_POLL) {
                clearInterval(_pollTimer); _pollTimer = null;
                clearInterval(cronometro);
                modal.hide();
                btn.disabled = false;
                showAlerta('La depuración tardó demasiado tiempo. Verifique el resultado manualmente.', 'Tiempo agotado', true);
                return;
            }
            try {
                const estados = await Promise.all(
                    _jobIds.map(id =>
                        fetch(`/RecursosHumanos/Aquarius/Marcaciones/ConsultarDepuracion?jobId=${id}`, { cache: 'no-store' })
                        .then(res => res.json()).catch(() => null)
                    )
                );
                const completados = estados.filter(j => j?.completado).length;
                document.getElementById('txtProgresoMasivo').textContent =
                    `Procesando: ${completados} de ${totalJobsEncolados} día(s) completados…`;

                if (completados === totalJobsEncolados) {
                    clearInterval(_pollTimer); _pollTimer = null;
                    clearInterval(cronometro);
                    modal.hide();
                    btn.disabled = false;

                    const errores  = estados.filter(j => !j?.exito).length;
                    const durSeg   = Math.floor((Date.now() - _inicioMs) / 1000);
                    mostrarResultado(errores === 0,
                        errores === 0
                            ? `Depuración completada: ${payload.length} empleado(s), ${totalJobs} día(s) procesados. (${durSeg}s)`
                            : `Completado con ${errores} error(es) en ${payload.length} empleado(s). (${durSeg}s)`,
                        durSeg);
                    await consultar();
                }
            } catch(e) {
                clearInterval(_pollTimer); _pollTimer = null;
                clearInterval(cronometro);
                modal.hide();
                btn.disabled = false;
                showAlerta('Error inesperado al verificar el estado de la depuración.', 'Error', true);
            }
        }, 2000);
    } catch(e) {
        clearInterval(cronometro);
        modal.hide();
        btn.disabled = false;
        showAlerta('Error de red al iniciar depuración.', 'Error de red', true);
    }
}

function mostrarResultado(ok, mensaje, durSeg) {
    const panel = document.getElementById('divResultado');
    const header = document.getElementById('panelResHeader');
    header.style.background = ok ? 'var(--aq-ok-lt)' : 'var(--aq-elt)';
    header.style.borderRadius = '.5rem';

    document.getElementById('iconResultado').innerHTML = ok
        ? '<i class="bi bi-check-circle-fill text-success fs-5"></i>'
        : '<i class="bi bi-x-circle-fill text-danger fs-5"></i>';
    document.getElementById('txtResultadoTitulo').textContent =
        ok ? `Depuración completada (${durSeg}s)` : 'Error en depuración';

    document.getElementById('rowStats').innerHTML = `
        <div class="col-12"><small class="${ok ? 'text-success' : 'text-danger'}">${escHtml(mensaje)}</small></div>`;
    panel.style.display = '';
    panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

// ── Helpers ───────────────────────────────────────────────────────────────────
function escHtml(s) {
    if (s == null) return '';
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
</script>
}
